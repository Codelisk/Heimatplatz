<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- OpenAPI Build-Time Generation -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <UserSecretsId>aaa2ecab-7438-4296-84cd-793e5dd27c34</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Shiny.Mediator.AspNet" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Heimatplatz.Api.Core.Startup\Heimatplatz.Api.Core.Startup.csproj" />
    <!-- Nur damit die Postgres-Migrations-Assembly zur Laufzeit ladbar ist (MigrationsAssembly-Override) -->
    <ProjectReference Include="..\Core\Heimatplatz.Api.Core.Data.Migrations.Postgres\Heimatplatz.Api.Core.Data.Migrations.Postgres.csproj" />
  </ItemGroup>

  <!-- Server credentials for push notifications (files are gitignored and optional) -->
  <ItemGroup>
    <None Include="apns-auth-key.p8" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('apns-auth-key.p8')" />
    <None Update="firebase-service-account.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('firebase-service-account.json')" />
  </ItemGroup>

</Project>
