{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "OpenTelemetry": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Telemetry": {
    "Enabled": true,
    "SlowRequestThresholdMs": 3000,
    "SampleHealthyTracePercent": 2,
    "RetentionDays": {
      "Logs": 30,
      "Spans": 14
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "EnableSeeding": false,
    "AutoMigrate": false
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Heimatplatz",
      "Audience": "Heimatplatz.App",
      "TokenValidityMinutes": 60,
      "RefreshValidityHours": 720
    }
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "FromAddress": "info@heimatplatz.at",
    "FromName": "Heimatplatz",
    "FrontendBaseUrl": "https://heimatplatz.at"
  },
  "ImageProxy": {
    "AllowedHosts": [
      "picsum.photos",
      ".picsum.photos",
      ".justiz.gv.at"
    ]
  },
  "AiListing": {
    "Provider": "Mock",
    "MaxImages": 20,
    "MaxVideos": 3,
    "MaxVideoSizeMb": 60,
    "AiConnector": {
      "WorkspaceId": "projects/heimatplatz"
    },
    "Description": {
      "MinWords": 100,
      "MaxWords": 160,
      "MockDelaySeconds": 8
    }
  },
  "AiConnector": {
    "ApiKey": ""
  },
  "Mediator": {
    "Http": {
      "Heimatplatz.Api.Core.AiConnectorClient.Generated.*": "https://ai.danielhufnagl.at"
    }
  },
  "PushNotifications": {
    "Firebase": {
      "ServiceAccountPath": "firebase-service-account.json"
    },
    "Apns": {
      "TeamId": "456S4AK378",
      "KeyId": "965VPT8XY8",
      "BundleId": "at.heimatplatz.app",
      "PrivateKeyPath": "apns-auth-key.p8"
    },
    "WebPush": {
      "PublicKey": "",
      "PrivateKey": "",
      "Subject": "mailto:info@heimatplatz.at"
    }
  }
}
