{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "EnableSeeding": false,
    "AutoMigrate": false
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Heimatplatz",
      "Audience": "Heimatplatz.App",
      "TokenValidityMinutes": 60,
      "RefreshValidityHours": 720
    }
  },
  "ImageProxy": {
    "AllowedHosts": [
      "picsum.photos",
      ".picsum.photos",
      ".justiz.gv.at"
    ]
  },
  "AiListing": {
    "Provider": "Mock",
    "CliCommand": "claude",
    "CliArguments": "-p --output-format text",
    "TimeoutSeconds": 300,
    "MaxImages": 20,
    "MaxVideos": 3,
    "MaxVideoSizeMb": 60,
    "AiConnector": {
      "WorkspaceId": "projects/heimatplatz"
    }
  },
  "AiConnector": {
    "ApiKey": ""
  },
  "Mediator": {
    "Http": {
      "Heimatplatz.Api.Core.AiConnectorClient.Generated.*": "https://ai.danielhufnagl.at"
    }
  },
  "PushNotifications": {
    "Firebase": {
      "ServiceAccountPath": "firebase-service-account.json"
    },
    "Apns": {
      "TeamId": "456S4AK378",
      "KeyId": "965VPT8XY8",
      "BundleId": "at.heimatplatz.app",
      "PrivateKeyPath": "apns-auth-key.p8"
    }
  }
}
