<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Warnungen aus generiertem OpenAPI-Client-Code (wie Heimatplatz.Maui.ApiClient) -->
    <WarningsNotAsErrors>CS8669;CS9107</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS8669;CS9107</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Mediator" />
  </ItemGroup>

  <!-- OpenAPI HTTP Contract Generation aus dem AiConnector-Backend (Shiny.Mediator Source Generator) -->
  <ItemGroup>
    <MediatorHttp Include="..\..\..\openapi\AiConnector.json"
                  Namespace="Heimatplatz.Api.Core.AiConnectorClient.Generated"
                  ContractPostfix="HttpRequest"
                  GenerateJsonConverters="false"
                  Visible="false" />
  </ItemGroup>

</Project>
