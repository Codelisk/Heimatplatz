<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Suppress warnings from source generated code -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heimatplatz.Api.Features.Dashboards.Contracts\Heimatplatz.Api.Features.Dashboards.Contracts.csproj" />
    <!-- GetProperties/MapPins/Stats-Requests (in-process Mediator-Requests der Widget-Resolver) -->
    <ProjectReference Include="..\..\Properties\Heimatplatz.Api.Features.Properties.Contracts\Heimatplatz.Api.Features.Properties.Contracts.csproj" />
    <!-- GetLocationsRequest (serverseitige Orts-Aufloesung im Validator) -->
    <ProjectReference Include="..\..\Locations\Heimatplatz.Api.Features.Locations.Contracts\Heimatplatz.Api.Features.Locations.Contracts.csproj" />
    <!-- RunPromptHttpRequest (AiConnector-Designer) -->
    <ProjectReference Include="..\..\..\Core\Heimatplatz.Api.Core.AiConnectorClient\Heimatplatz.Api.Core.AiConnectorClient.csproj" />
    <ProjectReference Include="..\..\..\Core\Heimatplatz.Api.Core.Data\Heimatplatz.Api.Core.Data.csproj" />
    <ProjectReference Include="..\..\..\Shared\Heimatplatz.Api.Shared\Heimatplatz.Api.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Mediator" />
    <PackageReference Include="Shiny.Mediator.AspNet" />
    <!-- Server-gerenderte Diagramme (price-chart-Widget); Linux-Natives kommen vom Host-Projekt -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!-- Generierungs-Hintergrund-Job (MapTicker-Registrierung + ITimeTickerManager) -->
    <PackageReference Include="TickerQ" />
  </ItemGroup>

  <ItemGroup>
    <!-- Diagramm-Schrift (Roboto, Apache License 2.0) - die Linux-Container haben keine Systemschriften -->
    <EmbeddedResource Include="Resources\Roboto-Regular.ttf" />
  </ItemGroup>

</Project>
