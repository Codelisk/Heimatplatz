<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Suppress warnings from source generated code -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heimatplatz.Api.Features.Marketing.Contracts\Heimatplatz.Api.Features.Marketing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Shared\Heimatplatz.Api.Shared\Heimatplatz.Api.Shared.csproj" />
    <ProjectReference Include="..\..\..\Core\Heimatplatz.Api.Core.Email\Heimatplatz.Api.Core.Email.csproj" />
    <ProjectReference Include="..\..\..\Core\Heimatplatz.Api.Core.AiConnectorClient\Heimatplatz.Api.Core.AiConnectorClient.csproj" />
    <!-- AdminAccessGuard (X-Admin-Key) wird mitgenutzt - gleiches Schutzmuster wie /api/admin -->
    <ProjectReference Include="..\..\Admin\Heimatplatz.Api.Features.Admin\Heimatplatz.Api.Features.Admin.csproj" />
    <!-- Impressum-Daten als Quelle der E-Mail-Signatur (GetImprintRequest) -->
    <ProjectReference Include="..\..\Legal\Heimatplatz.Api.Features.Legal.Contracts\Heimatplatz.Api.Features.Legal.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Mediator" />
    <PackageReference Include="Shiny.Mediator.AspNet" />
  </ItemGroup>

</Project>
