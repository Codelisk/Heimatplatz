<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Suppress warnings from source generated code -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Heimatplatz.Api.Features.Feedback.Contracts\Heimatplatz.Api.Features.Feedback.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Shared\Heimatplatz.Api.Shared\Heimatplatz.Api.Shared.csproj" />
    <ProjectReference Include="..\..\..\Core\Heimatplatz.Api.Core.Data\Heimatplatz.Api.Core.Data.csproj" />
    <ProjectReference Include="..\..\..\Core\Heimatplatz.Api.Core.Data.Seeding\Heimatplatz.Api.Core.Data.Seeding.csproj" />
    <!-- AdminAccessGuard (X-Admin-Key) wird mitgenutzt - gleiches Schutzmuster wie /api/admin -->
    <ProjectReference Include="..\..\Admin\Heimatplatz.Api.Features.Admin\Heimatplatz.Api.Features.Admin.csproj" />
    <!-- User-Entity fuer Nutzer-Infos (Name/E-Mail) in der Intern-Liste -->
    <ProjectReference Include="..\..\Auth\Heimatplatz.Api.Features.Auth\Heimatplatz.Api.Features.Auth.csproj" />
    <!-- FeedbackTeamRepliedEvent - der Push-Versand haengt im Notifications-Feature -->
    <ProjectReference Include="..\..\Notifications\Heimatplatz.Api.Features.Notifications.Contracts\Heimatplatz.Api.Features.Notifications.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Mediator" />
    <PackageReference Include="Shiny.Mediator.AspNet" />
  </ItemGroup>

</Project>
