---
import BaseLayout from "@/layouts/BaseLayout.astro";
import OrtPicker from "@/components/properties/OrtPicker.astro";
import { fetchOrtRegions } from "@/features/locations/live-api";
import { t } from "@/i18n";

// Gleiche API-basierte Ortsliste wie die Suche auf der Startseite (cached);
// bei leerem Ergebnis greift der statische Fallback im OrtPicker
const ortRegions = await fetchOrtRegions();
---

<BaseLayout
  title={t("notifications.title")}
  description={t("notifications.metaDescription")}
  canonicalPath="/benachrichtigungen/"
  noindex
>
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold">{t("notifications.title")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">
      {t("notifications.intro")}
    </p>
    <div class="mt-8 rounded-lg border border-border bg-card p-4" data-web-push hidden>
      <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
        <span>
          <strong>{t("notifications.webPushTitle")}</strong><br />
          <span class="text-muted-foreground" data-web-push-status>{t("notifications.webPushChecking")}</span>
        </span>
        <button
          type="button"
          class="inline-flex h-9 shrink-0 items-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
          data-web-push-toggle
          hidden
        >
          {t("notifications.webPushEnable")}
        </button>
      </div>
    </div>
    <form class="mt-4 space-y-4" data-preferences-form="notifications">
      <label class="flex items-center justify-between gap-3 rounded-lg border border-border bg-card p-4 text-sm">
        <span><strong>{t("notifications.title")}</strong><br /><span class="text-muted-foreground">{t("notifications.enableHint")}</span></span>
        <!-- Serverseitiger Default = API-Default (IsEnabled: false). Ein "checked"
             hier laesst Benachrichtigungen bis zum Hydrieren faelschlich aktiv wirken. -->
        <input type="checkbox" name="isEnabled" />
      </label>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-filter-settings>
        <h2 class="text-base font-semibold">{t("notifications.filterTitle")}</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          {t("notifications.filterIntro")}
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-center gap-2">
              <input type="radio" name="filterMode" value="SameAsSearch" checked />
              <span class="font-semibold">{t("notifications.filterModeSameTitle")}</span>
            </span>
            <span class="pl-6 text-xs text-muted-foreground">{t("notifications.filterModeSameHint")}</span>
          </label>
          <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-center gap-2">
              <input type="radio" name="filterMode" value="Custom" />
              <span class="font-semibold">{t("notifications.filterModeCustomTitle")}</span>
            </span>
            <span class="pl-6 text-xs text-muted-foreground">{t("notifications.filterModeCustomHint")}</span>
          </label>
          <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-center gap-2">
              <input type="radio" name="filterMode" value="All" />
              <span class="font-semibold">{t("notifications.filterModeAllTitle")}</span>
            </span>
            <span class="pl-6 text-xs text-muted-foreground">{t("notifications.filterModeAllHint")}</span>
          </label>
        </div>
        <a href="/filter-einstellungen/" class="mt-3 inline-block text-sm font-medium text-primary underline-offset-4 hover:underline" data-notification-samesearch>
          {t("notifications.adjustFilters")}
        </a>
      </div>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-custom hidden>
        <h2 class="text-base font-semibold">{t("notifications.propertyTypeTitle")}</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="house" checked /> {t("notifications.typeHouse")}</label>
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="land" checked /> {t("notifications.typeLand")}</label>
          <!-- Zwangsversteigerungen wie in der Suche standardmaessig aus -->
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="foreclosure" /> {t("notifications.typeForeclosure")}</label>
        </div>
      </div>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-custom hidden>
        <h2 class="text-base font-semibold">{t("notifications.sellerTypeTitle")}</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="private" checked /> {t("notifications.sellerPrivate")}</label>
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="broker" checked /> {t("notifications.sellerBroker")}</label>
        </div>
      </div>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-custom hidden>
        <h2 class="text-base font-semibold">{t("notifications.locationsTitle")}</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          {t("notifications.locationsHint")}
        </p>
        <div class="mt-4">
          <OrtPicker name="locations" placeholder={t("notifications.locationsPlaceholder")} regions={ortRegions.length > 0 ? ortRegions : undefined} />
        </div>
      </div>
      <p class="hidden text-sm" data-form-status></p>
      <button type="submit" class="inline-flex h-10 items-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-accent">
        {t("notifications.save")}
      </button>
    </form>
  </section>
</BaseLayout>
