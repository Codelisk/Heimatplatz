---
import BaseLayout from "@/layouts/BaseLayout.astro";
import OrtPicker from "@/components/properties/OrtPicker.astro";
---

<BaseLayout
  title="Benachrichtigungen"
  description="Benachrichtigungen für neue Immobilien in Oberösterreich konfigurieren."
  canonicalPath="/benachrichtigungen/"
  noindex
>
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold">Benachrichtigungen</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">
      Suchbenachrichtigungen für neue Objekte in Linz, Wels, Steyr und weiteren Regionen
      speichern und mit dem Benutzerkonto synchronisieren.
    </p>
    <div class="mt-8 rounded-lg border border-border bg-card p-4" data-web-push hidden>
      <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
        <span>
          <strong>Push in diesem Browser</strong><br />
          <span class="text-muted-foreground" data-web-push-status>Status wird geprüft...</span>
        </span>
        <button
          type="button"
          class="inline-flex h-9 shrink-0 items-center rounded-md border border-border bg-background px-4 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
          data-web-push-toggle
          hidden
        >
          Aktivieren
        </button>
      </div>
    </div>
    <form class="mt-4 space-y-4" data-preferences-form="notifications">
      <label class="flex items-center justify-between gap-3 rounded-lg border border-border bg-card p-4 text-sm">
        <span><strong>Benachrichtigungen</strong><br /><span class="text-muted-foreground">Push- oder E-Mail-Hinweise für neue passende Immobilien</span></span>
        <input type="checkbox" name="isEnabled" checked />
      </label>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-filter-settings>
        <h2 class="text-base font-semibold">Filter für Benachrichtigungen</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Legt fest, für welche neuen Objekte Benachrichtigungen verschickt werden.
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-center gap-2">
              <input type="radio" name="filterMode" value="SameAsSearch" checked />
              <span class="font-semibold">Wie Filtereinstellungen</span>
            </span>
            <span class="pl-6 text-xs text-muted-foreground">Nutzt automatisch Ihre gespeicherten Suchfilter.</span>
          </label>
          <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-center gap-2">
              <input type="radio" name="filterMode" value="Custom" />
              <span class="font-semibold">Eigene Filter</span>
            </span>
            <span class="pl-6 text-xs text-muted-foreground">Kriterien nur für Benachrichtigungen festlegen.</span>
          </label>
          <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <span class="flex items-center gap-2">
              <input type="radio" name="filterMode" value="All" />
              <span class="font-semibold">Alle neuen Objekte</span>
            </span>
            <span class="pl-6 text-xs text-muted-foreground">Hinweis bei jedem neuen Inserat in Oberösterreich.</span>
          </label>
        </div>
        <a href="/filter-einstellungen/" class="mt-3 inline-block text-sm font-medium text-primary underline-offset-4 hover:underline" data-notification-samesearch>
          Filtereinstellungen anpassen
        </a>
      </div>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-custom hidden>
        <h2 class="text-base font-semibold">Immobilientyp</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="house" checked /> Haus</label>
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="land" checked /> Grund</label>
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="foreclosure" checked /> Zwangsversteigerungen</label>
        </div>
      </div>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-custom hidden>
        <h2 class="text-base font-semibold">Anbietertyp</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="private" checked /> Privat</label>
          <label class="flex gap-3 rounded-lg border border-border px-4 py-3 text-sm"><input type="checkbox" name="broker" checked /> Makler</label>
        </div>
      </div>
      <div class="rounded-lg border border-border bg-card p-4" data-notification-custom hidden>
        <h2 class="text-base font-semibold">Orte</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Leer lassen bedeutet: alle Orte in Oberösterreich. Mehrere Orte werden wie in der App gespeichert.
        </p>
        <div class="mt-4">
          <OrtPicker name="locations" placeholder="Orte auswählen" />
        </div>
      </div>
      <p class="hidden text-sm" data-form-status></p>
      <button type="submit" class="inline-flex h-10 items-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-accent">
        Benachrichtigungen speichern
      </button>
    </form>
  </section>
</BaseLayout>
