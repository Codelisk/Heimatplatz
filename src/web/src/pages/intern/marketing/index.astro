---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import { adminApiGet, type MarketingStats } from "@/lib/server/admin-api";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).
// Marketing-Zentrale: Auswertung + Einstieg in Schreiben/Posteingang/Kontakte/Gesendet.

const stats = await adminApiGet<MarketingStats>("/api/admin/marketing/stats");

const statEntries = stats
  ? [
      { label: t("intern.marketingStatsContacts"), value: String(stats.TotalContacts) },
      { label: t("intern.marketingStatsLeads"), value: String(stats.Leads) },
      { label: t("intern.marketingStatsContacted"), value: String(stats.Contacted) },
      { label: t("intern.marketingStatsReplied"), value: String(stats.Replied) },
      { label: t("intern.marketingStatsInterested"), value: String(stats.Interested) },
      { label: t("intern.marketingStatsCustomers"), value: String(stats.Customers) },
      { label: t("intern.marketingStatsEmails30"), value: String(stats.EmailsSent30Days) },
      { label: t("intern.marketingStatsEmailsTotal"), value: String(stats.EmailsSentTotal) },
      { label: t("intern.marketingStatsReplies30"), value: String(stats.Replies30Days) },
      { label: t("intern.marketingStatsUnread"), value: String(stats.UnreadReplies) },
      {
        label: t("intern.marketingStatsReplyRate"),
        value: stats.ReplyRatePercent !== null ? `${stats.ReplyRatePercent} %` : "–",
      },
    ]
  : [];

const navCards = [
  {
    href: "/intern/marketing/schreiben/",
    title: t("intern.marketingNavCompose"),
    description: t("intern.marketingNavComposeDescription"),
    badge: null as string | null,
  },
  {
    href: "/intern/marketing/eingang/",
    title: t("intern.marketingNavInbox"),
    description: t("intern.marketingNavInboxDescription"),
    badge:
      stats && stats.UnreadReplies > 0
        ? t("intern.marketingUnreadBadge", { count: stats.UnreadReplies })
        : null,
  },
  {
    href: "/intern/marketing/kontakte/",
    title: t("intern.marketingNavContacts"),
    description: t("intern.marketingNavContactsDescription"),
    badge: null,
  },
  {
    href: "/intern/marketing/gesendet/",
    title: t("intern.marketingNavSent"),
    description: t("intern.marketingNavSentDescription"),
    badge: null,
  },
];
---

<BaseLayout
  title={t("intern.marketingMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/marketing/"
  noindex
>
  <section class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <span>{t("intern.marketingTitle")}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">{t("intern.marketingTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.marketingDashIntro")}</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {navCards.map((card) => (
        <a
          href={card.href}
          class="rounded-lg border border-border bg-card p-5 transition-colors hover:bg-muted"
        >
          <h2 class="flex items-center gap-2 text-base font-semibold">
            {card.title}
            {card.badge && (
              <span class="rounded-full bg-red-600 px-2 py-0.5 text-xs font-medium text-white">
                {card.badge}
              </span>
            )}
          </h2>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">{card.description}</p>
        </a>
      ))}
    </div>

    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.marketingStatsHeading")}</h2>

      {stats ? (
        <dl class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-3">
          {statEntries.map((entry) => (
            <div>
              <dt class="text-muted-foreground">{entry.label}</dt>
              <dd class="text-lg font-semibold">{entry.value}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="mt-4 text-sm text-muted-foreground">{t("intern.statsLoadFailed")}</p>
      )}
    </section>
  </section>
</BaseLayout>
