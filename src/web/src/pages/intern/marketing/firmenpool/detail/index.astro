---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import {
  adminApiGet,
  type MarketingLeadCompanyResponse,
} from "@/lib/server/admin-api";
import {
  contactStatusBadgeClass,
  contactStatusLabel,
} from "@/lib/intern/marketing-labels";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).
// Die Firmendaten kommen live aus der Firmenpool-API (Auszug, Funktionaere, Gewerbe) -
// Heimatplatz haelt keinen eigenen Firmenkatalog mehr.

const ALLOWED_BACK_PARAMS = ["q", "ort", "alle", "page"] as const;

function safeBackQuery(value: string | null) {
  const raw = new URLSearchParams(value ?? "");
  const safe = new URLSearchParams();
  for (const key of ALLOWED_BACK_PARAMS) {
    const item = raw.get(key);
    if (item) safe.set(key, item);
  }
  return safe.toString();
}

function formatDate(value: string | null) {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.valueOf())) return value;
  return new Intl.DateTimeFormat("de-AT", {
    dateStyle: "medium",
    timeZone: "Europe/Vienna",
  }).format(date);
}

function formatDateTime(value: string | null) {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.valueOf())) return value;
  return new Intl.DateTimeFormat("de-AT", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Vienna",
  }).format(date);
}

const fnr = Astro.url.searchParams.get("fnr")?.trim() ?? "";
const backQuery = safeBackQuery(Astro.url.searchParams.get("back"));
const backHref = backQuery
  ? `/intern/marketing/firmenpool/?${backQuery}`
  : "/intern/marketing/firmenpool/";

const detail = fnr
  ? await adminApiGet<MarketingLeadCompanyResponse>(
      `/api/admin/marketing/lead-pool/company/${encodeURIComponent(fnr)}`,
    )
  : null;
const company = detail?.Company ?? null;

const anschrift = company
  ? [
      [company.Strasse, company.Hausnummer].filter(Boolean).join(" "),
      [company.Plz, company.Ort].filter(Boolean).join(" "),
    ]
      .filter((part) => part.length > 0)
      .join(", ") || null
  : null;

type DetailField = {
  label: string;
  value: string | null;
};

const registerFields: DetailField[] = company
  ? [
      {
        label: t("intern.mkPoolDetailFieldFnr"),
        value: company.Fnr,
      },
      {
        label: t("intern.mkPoolDetailFieldStatus"),
        value: company.Status ?? t("intern.mkPoolDetailStatusActive"),
      },
      {
        label: t("intern.mkPoolDetailFieldAddress"),
        value: anschrift,
      },
      {
        label: t("intern.mkPoolDetailFieldSitz"),
        value: company.Sitz,
      },
      {
        label: t("intern.mkPoolDetailFieldLegalForm"),
        value: company.RechtsformText,
      },
      {
        label: t("intern.mkPoolDetailFieldLegalFormCode"),
        value: company.RechtsformCode,
      },
      {
        label: t("intern.mkPoolDetailFieldCourt"),
        value: company.GerichtText,
      },
      {
        label: t("intern.mkPoolDetailFieldFounded"),
        value: formatDate(company.Gegruendet),
      },
      {
        label: t("intern.mkPoolDetailFieldEuid"),
        value: company.Euid,
      },
      {
        label: t("intern.mkPoolDetailFieldHrNumber"),
        value: company.Handelsregisternummer,
      },
    ]
  : [];

const sourceFields: DetailField[] = company
  ? [
      {
        label: t("intern.mkPoolDetailFieldAuszugStand"),
        value: formatDateTime(company.AuszugStand),
      },
      {
        label: t("intern.mkPoolDetailFieldStatements"),
        value: String(company.AbschluesseVorhanden),
      },
    ]
  : [];

function fieldValue(field: DetailField) {
  return field.value || t("intern.mkPoolDetailNotAvailable");
}
---

<BaseLayout
  title={company
    ? t("intern.mkPoolDetailMetaTitleCompany", { company: company.Name })
    : t("intern.mkPoolDetailMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/marketing/firmenpool/detail/"
  noindex
>
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:text-foreground hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <a href="/intern/marketing/" class="hover:text-foreground hover:underline">
        {t("intern.marketingTitle")}
      </a>
      <span aria-hidden="true"> / </span>
      <a href={backHref} class="hover:text-foreground hover:underline">
        {t("intern.mkPoolTitle")}
      </a>
      <span aria-hidden="true"> / </span>
      <span>{company?.Name ?? t("intern.mkPoolDetailTitle")}</span>
    </nav>

    {!company ? (
      <div class="mt-6 rounded-xl border border-border bg-card p-6 shadow-sm">
        <h1 class="text-2xl font-bold">{t("intern.mkPoolDetailNotFound")}</h1>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {t("intern.mkPoolDetailNotFoundHint")}
        </p>
        <Button href={backHref} variant="outline" size="sm" class="mt-5">
          ← {t("intern.mkPoolDetailBack")}
        </Button>
      </div>
    ) : (
      <>
        <header class="mt-3 overflow-hidden rounded-xl border border-border bg-card shadow-sm">
          <div class="flex flex-col gap-5 p-5 sm:flex-row sm:items-start sm:justify-between sm:p-6">
            <div class="flex min-w-0 items-start gap-4">
              <div
                class="grid size-12 shrink-0 place-items-center rounded-xl bg-primary/10 text-sm font-bold text-primary"
                aria-hidden="true"
              >
                FB
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{company.Name}</h1>
                  <span
                    class:list={[
                      "rounded-full border px-2.5 py-0.5 text-xs font-medium",
                      company.Status
                        ? "border-warning/40 bg-warning/10 text-warning-foreground"
                        : "border-success/40 bg-success/10 text-success-foreground",
                    ]}
                  >
                    {company.Status ?? t("intern.mkPoolDetailStatusActive")}
                  </span>
                  {detail?.ContactId && detail.ContactStatus && (
                    <a
                      href={`/intern/marketing/kontakte/detail/?id=${detail.ContactId}`}
                      class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${contactStatusBadgeClass(detail.ContactStatus)}`}
                    >
                      {contactStatusLabel(detail.ContactStatus)}
                    </a>
                  )}
                </div>
                <p class="mt-1 text-sm text-muted-foreground">
                  {[anschrift ?? company.Sitz, company.RechtsformText, company.Fnr]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
              </div>
            </div>

            <div class="flex shrink-0 flex-wrap gap-2">
              <Button href={backHref} variant="outline" size="sm">
                ← {t("intern.mkPoolDetailBack")}
              </Button>
              {detail?.ContactId ? (
                <Button
                  href={`/intern/marketing/kontakte/detail/?id=${detail.ContactId}`}
                  variant="default"
                  size="sm"
                >
                  {t("intern.mkPoolDetailOpenContact")}
                </Button>
              ) : (
                <form method="POST" action="/intern/marketing/firmenpool/uebernehmen">
                  <input type="hidden" name="ids" value={company.Fnr} />
                  <input type="hidden" name="back" value={backQuery} />
                  <Button type="submit" variant="default" size="sm">
                    {t("intern.mkPoolDetailTakeContact")}
                  </Button>
                </form>
              )}
            </div>
          </div>

          <div class="border-t border-border bg-muted/35 px-5 py-3 text-sm text-muted-foreground sm:px-6">
            {t("intern.mkPoolDetailContactDataHint")}
          </div>
        </header>

        <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(17rem,0.8fr)]">
          <div class="min-w-0 space-y-6">
            <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-primary">
                  {t("intern.mkPoolDetailOfficialEyebrow")}
                </p>
                <h2 class="mt-1 text-lg font-semibold">{t("intern.mkPoolDetailRegisterHeading")}</h2>
              </div>
              <dl class="mt-5 grid gap-3 sm:grid-cols-2">
                {registerFields.map((field) => (
                  <div class="rounded-lg border border-border/70 bg-muted/30 px-4 py-3">
                    <dt class="text-xs font-medium text-muted-foreground">{field.label}</dt>
                    <dd class:list={["mt-1 break-words text-sm font-medium", !field.value && "text-muted-foreground"]}>
                      {fieldValue(field)}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>

            <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
              <h2 class="text-lg font-semibold">{t("intern.mkPoolDetailOfficersHeading")}</h2>
              {company.Funktionaere.length === 0 ? (
                <p class="mt-3 text-sm text-muted-foreground">
                  {t("intern.mkPoolDetailOfficersEmpty")}
                </p>
              ) : (
                <ul class="mt-4 divide-y divide-border/70">
                  {company.Funktionaere.map((officer) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2.5">
                      <span class="min-w-0">
                        <span
                          class:list={[
                            "block truncate text-sm font-medium",
                            !officer.Aktiv && "text-muted-foreground line-through",
                          ]}
                        >
                          {officer.Name}
                        </span>
                        <span class="block text-xs text-muted-foreground">
                          {officer.FunktionText ?? t("intern.mkPoolDetailNotAvailable")}
                        </span>
                      </span>
                      <span class="shrink-0 text-xs text-muted-foreground">
                        {officer.Aktiv
                          ? officer.Seit
                            ? t("intern.mkPoolDetailOfficerSince", {
                                date: formatDate(officer.Seit) ?? officer.Seit,
                              })
                            : ""
                          : t("intern.mkPoolDetailOfficerFormer")}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </section>

            <section class="rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
              <h2 class="text-lg font-semibold">{t("intern.mkPoolDetailTradesHeading")}</h2>
              {company.Gewerbe.length === 0 ? (
                <p class="mt-3 text-sm text-muted-foreground">
                  {t("intern.mkPoolDetailTradesEmpty")}
                </p>
              ) : (
                <ul class="mt-4 divide-y divide-border/70">
                  {company.Gewerbe.map((trade) => (
                    <li class="py-2.5">
                      <p
                        class:list={[
                          "text-sm font-medium leading-6 whitespace-pre-line",
                          !trade.Aktiv && "text-muted-foreground line-through",
                        ]}
                      >
                        {trade.Wortlaut ?? t("intern.mkPoolDetailNotAvailable")}
                      </p>
                      <p class="mt-0.5 text-xs text-muted-foreground">
                        {[
                          [trade.Plz, trade.Ort].filter(Boolean).join(" "),
                          `GISA ${trade.GisaZahl}`,
                          trade.Aktiv ? null : t("intern.mkPoolDetailTradeInactive"),
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </p>
                      {trade.WeitereStandorte.length > 0 && (
                        <p class="mt-0.5 text-xs text-muted-foreground">
                          {t("intern.mkPoolDetailTradeMoreLocations", {
                            locations: trade.WeitereStandorte.join(", "),
                          })}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          </div>

          <section class="h-fit rounded-xl border border-border bg-card p-5 shadow-sm sm:p-6">
            <p class="text-xs font-semibold uppercase tracking-wider text-primary">
              {t("intern.mkPoolDetailSourceEyebrow")}
            </p>
            <h2 class="mt-1 text-lg font-semibold">{t("intern.mkPoolDetailSourceHeading")}</h2>
            <dl class="mt-5 space-y-4">
              {sourceFields.map((field) => (
                <div>
                  <dt class="text-xs font-medium text-muted-foreground">{field.label}</dt>
                  <dd class:list={["mt-1 break-all text-sm font-medium", !field.value && "text-muted-foreground"]}>
                    {fieldValue(field)}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      </>
    )}
  </section>
</BaseLayout>
