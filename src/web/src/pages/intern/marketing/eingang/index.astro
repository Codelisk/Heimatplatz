---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import { adminApiGet, type MarketingInboxPage } from "@/lib/server/admin-api";
import { formatInternDate } from "@/lib/intern/marketing-labels";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).
// Beim Laden dieser Seite ruft die API das Postfach automatisch ab (gedrosselt,
// max. alle 5 Minuten); "Jetzt abrufen" erzwingt einen sofortigen Sync.

const PAGE_SIZE = 50;

const unreadOnly = Astro.url.searchParams.get("filter") === "unread";
const page = Math.max(Number.parseInt(Astro.url.searchParams.get("page") ?? "0", 10) || 0, 0);
const action = Astro.url.searchParams.get("action");
const actionCount = Astro.url.searchParams.get("count");
const actionError = Astro.url.searchParams.get("error");

const query = new URLSearchParams({ page: String(page), pageSize: String(PAGE_SIZE) });
if (unreadOnly) query.set("unreadOnly", "true");

const data = await adminApiGet<MarketingInboxPage>(`/api/admin/marketing/inbox?${query}`);
const totalPages = data ? Math.max(Math.ceil(data.Total / data.PageSize), 1) : 1;

// Warnungen nicht stapeln: Ist das Postfach gar nicht konfiguriert, ist das die
// eigentliche Ursache - Sync-Fehlermeldungen (URL-Param und gespeicherter SyncError)
// wuerden dasselbe Problem nur mehrfach melden. Es erscheint hoechstens eine
// Fehlermeldung: nicht konfiguriert > Sync-Fehler aus dem gerade ausgeloesten
// Abruf > gespeicherter SyncError.
const imapConfigured = data?.ImapConfigured ?? false;
const showNotConfigured = Boolean(data) && !imapConfigured;
const showSyncFailedParam = action === "syncfailed" && !showNotConfigured;
const showStoredSyncError = Boolean(data?.SyncError) && !showNotConfigured && !showSyncFailedParam;

function pageLink(target: number) {
  const params = new URLSearchParams();
  if (unreadOnly) params.set("filter", "unread");
  if (target > 0) params.set("page", String(target));
  const qs = params.toString();
  return qs ? `/intern/marketing/eingang/?${qs}` : "/intern/marketing/eingang/";
}

const backQuery = unreadOnly ? "unread" : "";
---

<BaseLayout
  title={t("intern.mkInboxMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/marketing/eingang/"
  noindex
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <a href="/intern/marketing/" class="hover:underline">{t("intern.marketingTitle")}</a>
      <span aria-hidden="true"> / </span>
      <span>{t("intern.mkInboxTitle")}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">{t("intern.mkInboxTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.mkInboxIntro")}</p>

    {action === "synced" && (
      <div class="mt-6 rounded-lg border border-border bg-muted p-4 text-sm">
        {actionCount === "1"
          ? t("intern.mkInboxSyncOkOne")
          : t("intern.mkInboxSyncOk", { count: actionCount ?? "0" })}
      </div>
    )}
    {showSyncFailedParam && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.mkInboxSyncFailed", { error: actionError ?? "?" })}
      </div>
    )}
    {action === "read" && (
      <div class="mt-6 rounded-lg border border-border bg-muted p-4 text-sm">
        {t("intern.mkInboxReadOk")}
      </div>
    )}
    {showNotConfigured && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.mkInboxNotConfigured")}
      </div>
    )}
    {showStoredSyncError && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.mkInboxSyncFailed", { error: data?.SyncError ?? "?" })}
      </div>
    )}

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <form method="POST" action="/intern/marketing/eingang/sync">
        <input type="hidden" name="back" value={backQuery} />
        <Button type="submit" variant="default" disabled={!imapConfigured}>
          {t("intern.mkInboxSyncNow")}
        </Button>
      </form>
      <div class="flex gap-3 text-sm">
        <a
          href="/intern/marketing/eingang/"
          class={unreadOnly ? "underline hover:no-underline" : "font-semibold"}
        >
          {t("intern.mkInboxFilterAll")}
        </a>
        <a
          href="/intern/marketing/eingang/?filter=unread"
          class={unreadOnly ? "font-semibold" : "underline hover:no-underline"}
        >
          {t("intern.mkInboxFilterUnread")}
        </a>
      </div>
    </div>

    {!data && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.mkInboxLoadFailed")}
      </div>
    )}

    {data && (
      <section class="mt-6 rounded-lg border border-border bg-card">
        <p class="border-b border-border px-5 py-3 text-sm text-muted-foreground">
          {data.Total === 1
            ? t("intern.mkInboxTotalOne")
            : t("intern.mkInboxTotal", { count: data.Total })}
        </p>

        {data.Items.length === 0 ? (
          <p class="px-5 py-6 text-sm text-muted-foreground">{t("intern.mkInboxEmpty")}</p>
        ) : (
          <ul class="divide-y divide-border">
            {data.Items.map((item) => (
              <li class={`px-5 py-4 ${item.IsRead ? "" : "bg-muted/50"}`}>
                <div class="flex flex-wrap items-center gap-2">
                  {!item.IsRead && (
                    <span class="rounded-full bg-red-600 px-2 py-0.5 text-xs font-medium text-white">
                      {t("intern.mkInboxBadgeUnread")}
                    </span>
                  )}
                  {item.IsBounce && (
                    <span class="rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-900 dark:bg-red-900/40 dark:text-red-200">
                      {t("intern.mkInboxBadgeBounce")}
                    </span>
                  )}
                  {item.ContactId ? (
                    <a
                      href={`/intern/marketing/kontakte/detail/?id=${item.ContactId}`}
                      class="font-medium underline hover:no-underline"
                    >
                      {item.ContactName ?? item.FromName ?? item.FromAddress}
                    </a>
                  ) : (
                    <span class="font-medium">{item.FromName ?? item.FromAddress}</span>
                  )}
                  <span class="text-xs text-muted-foreground">{item.FromAddress}</span>
                  <span class="text-xs text-muted-foreground">
                    {formatInternDate(item.ReceivedAt)}
                  </span>
                </div>
                <p class="mt-1 text-sm font-medium">{item.Subject}</p>
                {item.RepliedToSubject && (
                  <p class="mt-0.5 text-xs text-muted-foreground">
                    {t("intern.mkInboxRepliedTo", { subject: item.RepliedToSubject })}
                  </p>
                )}
                {item.BodyText && (
                  <details class="mt-1">
                    <summary class="cursor-pointer text-sm text-muted-foreground">
                      {t("intern.mkInboxShowBody")}
                    </summary>
                    <p class="mt-2 whitespace-pre-wrap text-sm">{item.BodyText}</p>
                  </details>
                )}
                <form method="POST" action="/intern/marketing/eingang/read" class="mt-2">
                  <input type="hidden" name="id" value={item.Id} />
                  <input type="hidden" name="isRead" value={item.IsRead ? "false" : "true"} />
                  <input type="hidden" name="back" value={backQuery} />
                  <button type="submit" class="text-sm underline hover:no-underline">
                    {item.IsRead ? t("intern.mkInboxMarkUnread") : t("intern.mkInboxMarkRead")}
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {data && totalPages > 1 && (
      <nav class="mt-6 flex items-center justify-between text-sm">
        {page > 0 ? (
          <a href={pageLink(page - 1)} class="underline hover:no-underline">
            {t("intern.pagePrev")}
          </a>
        ) : (
          <span />
        )}
        <span class="text-muted-foreground">
          {t("intern.pageInfo", { page: page + 1, pages: totalPages })}
        </span>
        {data.HasMore ? (
          <a href={pageLink(page + 1)} class="underline hover:no-underline">
            {t("intern.pageNext")}
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </section>
</BaseLayout>
