---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import {
  adminApiGet,
  type MarketingSignatureResponse,
  type MarketingTemplatesResponse,
} from "@/lib/server/admin-api";
import { t } from "@/i18n";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).
// Die Generate-/Send-/Vorlagen-Aufrufe laufen ueber die Server-Routes im selben Ordner,
// die den ADMIN_API_KEY serverseitig anhaengen - der Key bleibt aus dem Browser raus.
// ?email=&name= (z.B. aus der Kontaktliste) fuellen Empfaenger vor.
// ?contactId= verknuepft den Versand mit einem bestehenden Kontakt - noetig fuer
// Firmenpool-Kontakte, die noch keine Adresse haben und sonst als Dublette entstuenden.

const prefillEmail = Astro.url.searchParams.get("email")?.trim() ?? "";
const prefillName = Astro.url.searchParams.get("name")?.trim() ?? "";
const contactId = Astro.url.searchParams.get("contactId")?.trim() ?? "";

const templates =
  (await adminApiGet<MarketingTemplatesResponse>("/api/admin/marketing/templates"))?.Templates ??
  [];

// Signatur-Vorschau schon beim Laden, damit auch selbst geschriebene E-Mails
// (ohne KI-Generierung) sehen, was beim Versand angehaengt wird. Bei nicht
// erreichbarer API bleibt die Vorschau leer - der Versand haengt die Signatur
// serverseitig ohnehin an.
const signaturePreview =
  (await adminApiGet<MarketingSignatureResponse>("/api/admin/marketing/email/signature"))
    ?.SignatureText ?? "";

const inputClass =
  "w-full rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40";
---

<BaseLayout
  title={t("intern.marketingMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/marketing/schreiben/"
  noindex
>
  <section class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8" data-contact-id={contactId}>
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <a href="/intern/marketing/" class="hover:underline">{t("intern.marketingTitle")}</a>
      <span aria-hidden="true"> / </span>
      <span>{t("intern.marketingNavCompose")}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">{t("intern.marketingNavCompose")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.marketingIntro")}</p>

    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.marketingEmailHeading")}</h2>

      <div class="mt-4 flex flex-col gap-4">
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("intern.marketingRecipientLabel")}</span>
          <input
            type="email"
            data-hook="recipient-email"
            value={prefillEmail}
            placeholder={t("intern.marketingRecipientPlaceholder")}
            class={inputClass}
          />
        </label>

        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("intern.marketingRecipientNameLabel")}</span>
          <input
            type="text"
            data-hook="recipient-name"
            value={prefillName}
            placeholder={t("intern.marketingRecipientNamePlaceholder")}
            class={inputClass}
          />
        </label>

        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("intern.marketingCcLabel")}</span>
          <input
            type="email"
            data-hook="cc-email"
            placeholder={t("intern.marketingCcPlaceholder")}
            class={inputClass}
          />
        </label>

        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("intern.marketingBccLabel")}</span>
          <input
            type="email"
            data-hook="bcc-email"
            placeholder={t("intern.marketingBccPlaceholder")}
            class={inputClass}
          />
        </label>
      </div>
    </section>

    <section class="mt-6 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.marketingTemplateHeading")}</h2>
      <p class="mt-1 text-sm text-muted-foreground">{t("intern.marketingTemplateHint")}</p>

      {templates.length === 0 ? (
        <p class="mt-4 text-sm text-muted-foreground">
          {t("intern.marketingTemplateEmpty")}{" "}
          <a href="/intern/marketing/vorlagen/" class="underline hover:no-underline">
            {t("intern.marketingTemplateManage")}
          </a>
        </p>
      ) : (
        <div class="mt-4 flex flex-col gap-4">
          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("intern.marketingTemplateLabel")}</span>
            <select data-hook="template" class={inputClass}>
              <option value="">{t("intern.marketingTemplateNone")}</option>
              {templates.map((tpl) => (
                <option value={tpl.Id}>{tpl.Name}</option>
              ))}
            </select>
          </label>

          <div class="flex items-center gap-3">
            <Button type="button" variant="outline" data-hook="apply-template">
              {t("intern.marketingTemplateApply")}
            </Button>
            <span class="hidden text-sm text-muted-foreground" data-hook="template-status">
              {t("intern.marketingTemplateApplying")}
            </span>
            <a
              href="/intern/marketing/vorlagen/"
              class="text-sm text-muted-foreground underline hover:no-underline"
            >
              {t("intern.marketingTemplateManage")}
            </a>
          </div>
        </div>
      )}
    </section>

    <section class="mt-6 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.marketingAiHeading")}</h2>
      <p class="mt-1 text-sm text-muted-foreground">{t("intern.marketingAiHint")}</p>

      <div class="mt-4 flex flex-col gap-4">
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("intern.marketingKeywordsLabel")}</span>
          <textarea
            rows="4"
            data-hook="keywords"
            placeholder={t("intern.marketingKeywordsPlaceholder")}
            class={inputClass}></textarea>
        </label>

        <div class="flex items-center gap-3">
          <Button type="button" variant="outline" data-hook="generate">
            {t("intern.marketingGenerate")}
          </Button>
          <span class="hidden text-sm text-muted-foreground" data-hook="generate-status">
            {t("intern.marketingGenerating")}
          </span>
        </div>
      </div>
    </section>

    <section class="mt-6 rounded-lg border border-border bg-card p-5" data-hook="draft-section">
      <h2 class="text-base font-semibold">{t("intern.marketingDraftHeading")}</h2>

      <div class="mt-4 flex flex-col gap-4">
        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("intern.marketingSubjectLabel")}</span>
          <input type="text" data-hook="subject" class={inputClass} />
        </label>

        <label class="flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("intern.marketingBodyLabel")}</span>
          <textarea
            rows="14"
            data-hook="body"
            placeholder={t("intern.marketingBodyPlaceholder")}
            class={inputClass}></textarea>
        </label>

        <div class="flex flex-col gap-1 text-sm">
          <span class="font-medium text-muted-foreground">{t("intern.marketingSignatureLabel")}</span>
          <pre
            data-hook="signature"
            class="whitespace-pre-wrap rounded-md border border-border bg-muted px-3 py-2 font-sans text-sm text-muted-foreground">{signaturePreview}</pre>
        </div>

        <div class="flex items-center gap-3">
          <Button type="button" variant="default" data-hook="send">
            {t("intern.marketingSend")}
          </Button>
          <span class="hidden text-sm text-muted-foreground" data-hook="send-status">
            {t("intern.marketingSending")}
          </span>
        </div>
      </div>
    </section>

    <div class="mt-6 hidden rounded-lg border border-border bg-muted p-4 text-sm" data-hook="banner-ok"></div>
    <div
      class="mt-6 hidden rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700"
      data-hook="banner-error"
    >
    </div>
  </section>
</BaseLayout>

<script>
  import { t } from "@/i18n";

  function hook<T extends HTMLElement>(name: string): T {
    const el = document.querySelector<T>(`[data-hook="${name}"]`);
    if (!el) throw new Error(`data-hook fehlt: ${name}`);
    return el;
  }

  /** Die Vorlagen-Auswahl fehlt im Markup, solange keine Vorlage angelegt ist */
  function optionalHook<T extends HTMLElement>(name: string): T | null {
    return document.querySelector<T>(`[data-hook="${name}"]`);
  }

  // Verknuepfung mit einem bestehenden Kontakt (aus der Kontaktliste/Detailseite heraus)
  const contactId =
    document.querySelector<HTMLElement>("[data-contact-id]")?.dataset.contactId ?? "";

  const recipientEmail = hook<HTMLInputElement>("recipient-email");
  const recipientName = hook<HTMLInputElement>("recipient-name");
  const ccEmail = hook<HTMLInputElement>("cc-email");
  const bccEmail = hook<HTMLInputElement>("bcc-email");
  const keywords = hook<HTMLTextAreaElement>("keywords");
  const templateSelect = optionalHook<HTMLSelectElement>("template");
  const applyTemplateButton = optionalHook<HTMLButtonElement>("apply-template");
  const templateStatus = optionalHook<HTMLSpanElement>("template-status");
  const generateButton = hook<HTMLButtonElement>("generate");
  const generateStatus = hook<HTMLSpanElement>("generate-status");
  const draftSection = hook<HTMLElement>("draft-section");
  const subject = hook<HTMLInputElement>("subject");
  const body = hook<HTMLTextAreaElement>("body");
  const signature = hook<HTMLPreElement>("signature");
  const sendButton = hook<HTMLButtonElement>("send");
  const sendStatus = hook<HTMLSpanElement>("send-status");
  const bannerOk = hook<HTMLDivElement>("banner-ok");
  const bannerError = hook<HTMLDivElement>("banner-error");

  function showBanner(target: HTMLDivElement, other: HTMLDivElement, message: string, contactId?: string | null) {
    target.textContent = message;
    if (contactId) {
      target.append(" ");
      const link = document.createElement("a");
      link.href = `/intern/marketing/kontakte/detail/?id=${encodeURIComponent(contactId)}`;
      link.className = "underline";
      link.textContent = t("intern.marketingSentContactLink");
      target.append(link);
    }
    target.classList.remove("hidden");
    other.classList.add("hidden");
  }

  function hideBanners() {
    bannerOk.classList.add("hidden");
    bannerError.classList.add("hidden");
  }

  async function postJson(path: string, payload: unknown): Promise<any | null> {
    try {
      const response = await fetch(path, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) return null;
      return await response.json();
    } catch {
      return null;
    }
  }

  applyTemplateButton?.addEventListener("click", async () => {
    hideBanners();

    const templateId = templateSelect?.value ?? "";
    if (!templateId) {
      showBanner(bannerError, bannerOk, t("intern.marketingTemplateValidation"));
      return;
    }
    // Gleiche Rueckfrage wie bei der KI-Generierung - ein vorhandener Entwurf soll
    // nicht kommentarlos verloren gehen.
    if (
      (subject.value.trim() || body.value.trim()) &&
      !window.confirm(t("intern.marketingConfirmOverwrite"))
    )
      return;

    applyTemplateButton.disabled = true;
    templateStatus?.classList.remove("hidden");
    try {
      const result = await postJson("/intern/marketing/schreiben/vorlage", {
        templateId,
        contactId,
      });

      if (!result) {
        showBanner(bannerError, bannerOk, t("intern.marketingApiUnreachable"));
        return;
      }
      if (!result.ok) {
        showBanner(
          bannerError,
          bannerOk,
          t("intern.marketingTemplateFailed", { error: result.error ?? "?" }),
        );
        return;
      }

      subject.value = result.subject ?? "";
      body.value = result.body ?? "";
      draftSection.scrollIntoView({ behavior: "smooth", block: "start" });
    } finally {
      applyTemplateButton.disabled = false;
      templateStatus?.classList.add("hidden");
    }
  });

  generateButton.addEventListener("click", async () => {
    hideBanners();

    if (!keywords.value.trim()) {
      showBanner(bannerError, bannerOk, t("intern.marketingValidationKeywords"));
      return;
    }
    // Selbst geschriebener (oder frueher generierter) Entwurf soll nicht
    // kommentarlos verloren gehen.
    if ((subject.value.trim() || body.value.trim()) && !window.confirm(t("intern.marketingConfirmOverwrite")))
      return;

    generateButton.disabled = true;
    generateStatus.classList.remove("hidden");
    try {
      const result = await postJson("/intern/marketing/schreiben/generate", {
        keywords: keywords.value.trim(),
        recipientName: recipientName.value.trim(),
      });

      if (!result) {
        showBanner(bannerError, bannerOk, t("intern.marketingApiUnreachable"));
        return;
      }
      if (!result.ok) {
        showBanner(
          bannerError,
          bannerOk,
          t("intern.marketingGenerateFailed", { error: result.error ?? "?" }),
        );
        return;
      }

      subject.value = result.subject ?? "";
      body.value = result.body ?? "";
      signature.textContent = result.signatureText ?? "";
      generateButton.textContent = t("intern.marketingRegenerate");
      draftSection.scrollIntoView({ behavior: "smooth", block: "start" });
    } finally {
      generateButton.disabled = false;
      generateStatus.classList.add("hidden");
    }
  });

  sendButton.addEventListener("click", async () => {
    hideBanners();

    const email = recipientEmail.value.trim();
    if (!email || !recipientEmail.checkValidity()) {
      showBanner(bannerError, bannerOk, t("intern.marketingValidationRecipient"));
      return;
    }
    const cc = ccEmail.value.trim();
    if (cc && !ccEmail.checkValidity()) {
      showBanner(bannerError, bannerOk, t("intern.marketingValidationCc"));
      return;
    }
    const bcc = bccEmail.value.trim();
    if (bcc && !bccEmail.checkValidity()) {
      showBanner(bannerError, bannerOk, t("intern.marketingValidationBcc"));
      return;
    }
    if (!subject.value.trim() || !body.value.trim()) {
      showBanner(bannerError, bannerOk, t("intern.marketingValidationDraft"));
      return;
    }
    const copyLines = [
      ...(cc ? [t("intern.marketingConfirmCc", { cc })] : []),
      ...(bcc ? [t("intern.marketingConfirmBcc", { bcc })] : []),
    ];
    const confirmMessage = [t("intern.marketingConfirmSend", { email }), ...copyLines].join("\n");
    if (!window.confirm(confirmMessage)) return;

    sendButton.disabled = true;
    sendStatus.classList.remove("hidden");
    try {
      const result = await postJson("/intern/marketing/schreiben/send", {
        recipientEmail: email,
        recipientName: recipientName.value.trim(),
        ccEmail: cc,
        bccEmail: bcc,
        keywords: keywords.value.trim(),
        subject: subject.value.trim(),
        body: body.value.trim(),
        contactId,
      });

      if (!result) {
        showBanner(bannerError, bannerOk, t("intern.marketingApiUnreachable"));
        return;
      }
      if (!result.ok) {
        showBanner(
          bannerError,
          bannerOk,
          t("intern.marketingSendFailed", { error: result.error ?? "?" }),
        );
        return;
      }

      const message = result.smtpConfigured
        ? t("intern.marketingSendOk", { email })
        : `${t("intern.marketingSendOk", { email })} ${t("intern.marketingSendOkNoSmtp")}`;
      showBanner(bannerOk, bannerError, message, result.contactId);
    } finally {
      sendButton.disabled = false;
      sendStatus.classList.add("hidden");
    }
  });
</script>
