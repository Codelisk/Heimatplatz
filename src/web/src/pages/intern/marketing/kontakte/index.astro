---
import BaseLayout from "@/layouts/BaseLayout.astro";
import MarketingContactForm from "@/components/intern/MarketingContactForm.astro";
import MarketingQuickActions from "@/components/intern/MarketingQuickActions.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import { adminApiGet, type MarketingContactsPage } from "@/lib/server/admin-api";
import {
  CONTACT_STATUSES,
  CONTACT_TYPES,
  contactStatusBadgeClass,
  contactStatusLabel,
  contactTypeLabel,
  formatInternDate,
  formatInternDay,
  isFollowUpDue,
} from "@/lib/intern/marketing-labels";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).
// Akquise-Cockpit: Pipeline-Chips mit Zaehlern statt Status-Dropdown, dazu
// Ein-Klick-Aktionen (MarketingQuickActions) direkt an jeder Zeile.

const PAGE_SIZE = 50;

const search = Astro.url.searchParams.get("q")?.trim() ?? "";
const statusFilter = Astro.url.searchParams.get("status") ?? "";
const typeFilter = Astro.url.searchParams.get("type") ?? "";
const dueOnly = Astro.url.searchParams.get("faellig") === "1";
const page = Math.max(Number.parseInt(Astro.url.searchParams.get("page") ?? "0", 10) || 0, 0);
const action = Astro.url.searchParams.get("action");
const actionError = Astro.url.searchParams.get("error");

const query = new URLSearchParams({ page: String(page), pageSize: String(PAGE_SIZE) });
if (search) query.set("search", search);
if (statusFilter) query.set("status", statusFilter);
if (typeFilter) query.set("contactType", typeFilter);
if (dueOnly) query.set("dueOnly", "true");

const data = await adminApiGet<MarketingContactsPage>(`/api/admin/marketing/contacts?${query}`);
const totalPages = data ? Math.max(Math.ceil(data.Total / data.PageSize), 1) : 1;

const statusCounts = new Map((data?.StatusCounts ?? []).map((entry) => [entry.Status, entry.Count]));
const allCount = [...statusCounts.values()].reduce((sum, count) => sum + count, 0);
const dueCount = data?.DueCount ?? 0;

const selectClass =
  "rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40";

function pageLink(target: number) {
  const params = new URLSearchParams();
  if (search) params.set("q", search);
  if (statusFilter) params.set("status", statusFilter);
  if (typeFilter) params.set("type", typeFilter);
  if (dueOnly) params.set("faellig", "1");
  if (target > 0) params.set("page", String(target));
  const qs = params.toString();
  return qs ? `/intern/marketing/kontakte/?${qs}` : "/intern/marketing/kontakte/";
}

/** Chip-Link: Suche/Typ bleiben erhalten, Status/Faellig sind exklusiv, Seite beginnt vorn */
function chipLink(target: { status?: string; due?: boolean }) {
  const params = new URLSearchParams();
  if (search) params.set("q", search);
  if (typeFilter) params.set("type", typeFilter);
  if (target.status) params.set("status", target.status);
  if (target.due) params.set("faellig", "1");
  const qs = params.toString();
  return qs ? `/intern/marketing/kontakte/?${qs}` : "/intern/marketing/kontakte/";
}

// Pipeline-Chips: Alle + Faellig vorn, danach der Funnel in Arbeitsreihenfolge.
// Status ohne Kontakte werden ausgeblendet (ausser gerade aktiv) - kuerzere Leiste.
const chips = [
  {
    href: chipLink({}),
    label: t("intern.mkContactsChipAll"),
    count: allCount,
    active: !statusFilter && !dueOnly,
    alert: false,
  },
  {
    href: chipLink({ due: true }),
    label: t("intern.mkContactsChipDue"),
    count: dueCount,
    active: dueOnly,
    alert: dueCount > 0,
  },
  ...CONTACT_STATUSES.map((status) => ({
    href: chipLink({ status }),
    label: contactStatusLabel(status),
    count: statusCounts.get(status) ?? 0,
    active: statusFilter === status,
    alert: false,
  })),
].filter((chip) => chip.count > 0 || chip.active || chip.label === t("intern.mkContactsChipAll"));

const chipBase = "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-sm transition-colors";
const chipActive = "border-transparent bg-primary text-primary-foreground";
const chipIdle = "border-border bg-card hover:bg-muted";
const chipAlert = "border-error/40 bg-card text-error hover:bg-error/10";

const badgeBase = "rounded-full px-2 py-0.5 text-xs font-medium";
---

<BaseLayout
  title={t("intern.mkContactsMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/marketing/kontakte/"
  noindex
>
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <a href="/intern/marketing/" class="hover:underline">{t("intern.marketingTitle")}</a>
      <span aria-hidden="true"> / </span>
      <span>{t("intern.mkContactsTitle")}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">{t("intern.mkContactsTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.mkContactsIntro")}</p>

    {action === "saved" && (
      <div class="mt-6 rounded-lg border border-border bg-muted p-4 text-sm">
        {t("intern.mkContactSavedOk")}
      </div>
    )}
    {action === "deleted" && (
      <div class="mt-6 rounded-lg border border-border bg-muted p-4 text-sm">
        {t("intern.mkContactDeletedOk")}
      </div>
    )}
    {action === "failed" && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.mkContactActionFailed", { error: actionError ?? "?" })}
      </div>
    )}

    <form
      method="GET"
      action="/intern/marketing/kontakte/"
      class="mt-6 flex flex-wrap gap-2"
      data-autosubmit
    >
      {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
      {dueOnly && <input type="hidden" name="faellig" value="1" />}
      <input
        type="search"
        name="q"
        value={search}
        placeholder={t("intern.mkContactsSearchPlaceholder")}
        class="min-w-48 flex-1 rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40"
      />
      <select name="type" aria-label={t("intern.mkContactsFilterTypeAria")} class={selectClass}>
        <option value="" selected={!typeFilter}>{t("intern.mkContactsFilterTypeAll")}</option>
        {CONTACT_TYPES.map((type) => (
          <option value={type} selected={typeFilter === type}>{contactTypeLabel(type)}</option>
        ))}
      </select>
      <Button type="submit" variant="outline" size="sm">{t("intern.filterButton")}</Button>
    </form>

    {data && (
      <nav class="mt-4 flex flex-wrap gap-1.5" aria-label={t("intern.mkContactsFilterStatusAria")}>
        {chips.map((chip) => (
          <a
            href={chip.href}
            class={`${chipBase} ${chip.active ? chipActive : chip.alert ? chipAlert : chipIdle}`}
            aria-current={chip.active ? "page" : undefined}
          >
            {chip.label}
            <span class="text-xs tabular-nums opacity-70">{chip.count}</span>
          </a>
        ))}
      </nav>
    )}

    {!data && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.mkContactsLoadFailed")}
      </div>
    )}

    {data && (
      <section class="mt-4 rounded-lg border border-border bg-card">
        {data.Contacts.length === 0 ? (
          <p class="px-5 py-6 text-sm text-muted-foreground">{t("intern.mkContactsEmpty")}</p>
        ) : (
          <ul class="divide-y divide-border">
            {data.Contacts.map((contact) => {
              const detailHref = `/intern/marketing/kontakte/detail/?id=${contact.Id}`;
              const due = isFollowUpDue(contact.NextFollowUpAt);
              return (
                <li class="px-5 py-4 transition-colors hover:bg-muted/40" data-contact-row>
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                    <div class="min-w-0" data-contact-info>
                      <p class="truncate font-medium">
                        {due && (
                          <span
                            class="mr-1.5 inline-block size-2 rounded-full bg-error align-middle"
                            title={t("intern.mkContactsDueBadge")}
                          />
                        )}
                        <a href={detailHref} class="hover:underline">
                          {contact.Company ?? contact.Name ?? contact.Email}
                        </a>
                        {contact.Company && contact.Name && (
                          <span class="font-normal text-muted-foreground"> · {contact.Name}</span>
                        )}
                      </p>
                      <p class="mt-0.5 truncate text-sm text-muted-foreground">
                        {[
                          contact.Email ?? t("intern.mkContactsNoEmail"),
                          contact.Phone,
                          contact.City,
                          contactTypeLabel(contact.ContactType),
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </p>
                      <p class="mt-1 text-xs text-muted-foreground">
                        {t("intern.mkContactColLastContact")}: {formatInternDate(contact.LastContactedAt)}
                        {" · "}
                        {t("intern.mkContactColActivity")}: {contact.EmailCount} / {contact.ReplyCount}
                        {contact.NextFollowUpAt && (
                          <span class={due ? "font-medium text-error" : ""}>
                            {" · "}
                            {t("intern.mkDetailNextFollowUp")}: {formatInternDay(contact.NextFollowUpAt)}
                            {due && ` (${t("intern.mkContactsDueBadge")})`}
                          </span>
                        )}
                      </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2 sm:flex-col sm:items-end">
                      <span data-status-badge class={`${badgeBase} ${contactStatusBadgeClass(contact.Status)}`}>
                        {contactStatusLabel(contact.Status)}
                      </span>
                      <a
                        href={detailHref}
                        class="text-xs text-muted-foreground underline hover:no-underline"
                      >
                        {t("intern.mkContactDetail")}
                      </a>
                    </div>
                  </div>
                  <div class="mt-3">
                    <MarketingQuickActions contact={contact} mode="row" />
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    )}

    {data && totalPages > 1 && (
      <nav class="mt-6 flex items-center justify-between text-sm">
        {page > 0 ? (
          <a href={pageLink(page - 1)} class="underline hover:no-underline">
            {t("intern.pagePrev")}
          </a>
        ) : (
          <span />
        )}
        <span class="text-muted-foreground">
          {t("intern.pageInfo", { page: page + 1, pages: totalPages })}
        </span>
        {data.HasMore ? (
          <a href={pageLink(page + 1)} class="underline hover:no-underline">
            {t("intern.pageNext")}
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}

    <details class="group mt-8 rounded-lg border border-border bg-card">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-base font-semibold select-none">
        {t("intern.mkContactsNewHeading")}
        <span aria-hidden="true" class="text-muted-foreground transition-transform group-open:rotate-180">
          ▾
        </span>
      </summary>
      <div class="border-t border-border p-5">
        <MarketingContactForm redirect="list" />
      </div>
    </details>
  </section>
</BaseLayout>

<script>
  // Typ-Wechsel filtert sofort - der Filtern-Button bleibt fuer die Suche per Maus
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-autosubmit]")) {
    form.addEventListener("change", (event) => {
      if (event.target instanceof HTMLSelectElement) form.requestSubmit();
    });
  }
</script>
