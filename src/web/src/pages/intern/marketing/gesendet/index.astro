---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import { adminApiGet, type MarketingEmailsPage } from "@/lib/server/admin-api";
import { formatInternDate } from "@/lib/intern/marketing-labels";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).

const PAGE_SIZE = 50;

const page = Math.max(Number.parseInt(Astro.url.searchParams.get("page") ?? "0", 10) || 0, 0);

const data = await adminApiGet<MarketingEmailsPage>(
  `/api/admin/marketing/emails?page=${page}&pageSize=${PAGE_SIZE}`,
);
const totalPages = data ? Math.max(Math.ceil(data.Total / data.PageSize), 1) : 1;

function pageLink(target: number) {
  return target > 0
    ? `/intern/marketing/gesendet/?page=${target}`
    : "/intern/marketing/gesendet/";
}
---

<BaseLayout
  title={t("intern.mkSentMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/marketing/gesendet/"
  noindex
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <a href="/intern/marketing/" class="hover:underline">{t("intern.marketingTitle")}</a>
      <span aria-hidden="true"> / </span>
      <span>{t("intern.mkSentTitle")}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">{t("intern.mkSentTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.mkSentIntro")}</p>

    {!data && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.mkSentLoadFailed")}
      </div>
    )}

    {data && (
      <section class="mt-6 rounded-lg border border-border bg-card">
        <p class="border-b border-border px-5 py-3 text-sm text-muted-foreground">
          {t("intern.mkSentTotal", { count: data.Total })}
        </p>

        {data.Emails.length === 0 ? (
          <p class="px-5 py-6 text-sm text-muted-foreground">{t("intern.mkSentEmpty")}</p>
        ) : (
          <ul class="divide-y divide-border">
            {data.Emails.map((email) => (
              <li class="px-5 py-4">
                <div class="flex flex-wrap items-center gap-2">
                  <a
                    href={`/intern/marketing/kontakte/detail/?id=${email.ContactId}`}
                    class="font-medium underline hover:no-underline"
                  >
                    {email.ContactName ?? email.ContactEmail}
                  </a>
                  <span class="text-xs text-muted-foreground">
                    {formatInternDate(email.SentAt)}
                  </span>
                  {email.Status === "LoggedOnly" && (
                    <span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">
                      {t("intern.mkSentBadgeLoggedOnly")}
                    </span>
                  )}
                  {email.Status === "DeliveryFailed" && (
                    <span class="rounded bg-red-100 px-1.5 py-0.5 text-xs text-red-900 dark:bg-red-900/40 dark:text-red-200">
                      {t("intern.mkSentBadgeFailed")}
                    </span>
                  )}
                  {email.ReplyCount > 0 && (
                    <span class="rounded bg-green-100 px-1.5 py-0.5 text-xs text-green-900 dark:bg-green-900/40 dark:text-green-200">
                      {t("intern.mkSentReplies", { count: email.ReplyCount })}
                    </span>
                  )}
                </div>
                <p class="mt-1 text-sm font-medium">{email.Subject}</p>
                <details class="mt-1">
                  <summary class="cursor-pointer text-sm text-muted-foreground">
                    {t("intern.mkSentShowBody")}
                  </summary>
                  <p class="mt-2 whitespace-pre-wrap text-sm">{email.Body}</p>
                </details>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {data && totalPages > 1 && (
      <nav class="mt-6 flex items-center justify-between text-sm">
        {page > 0 ? (
          <a href={pageLink(page - 1)} class="underline hover:no-underline">
            {t("intern.pagePrev")}
          </a>
        ) : (
          <span />
        )}
        <span class="text-muted-foreground">
          {t("intern.pageInfo", { page: page + 1, pages: totalPages })}
        </span>
        {data.HasMore ? (
          <a href={pageLink(page + 1)} class="underline hover:no-underline">
            {t("intern.pageNext")}
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </section>
</BaseLayout>
