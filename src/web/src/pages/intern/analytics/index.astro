---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import { adminApiGet, type SearchConsoleSummary } from "@/lib/server/admin-api";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile), wie der ganze
// Intern-Bereich. Das SearchConsole-Widget ruft zusaetzlich /api/admin/search-console/summary
// auf (X-Admin-Key wie alle Admin-Endpoints) - fail-soft, siehe Features/SearchConsole/README.md.

const searchConsole = await adminApiGet<SearchConsoleSummary>("/api/admin/search-console/summary");

function formatNumber(value: number) {
  return new Intl.NumberFormat("de-AT").format(value);
}

function formatPercent(value: number) {
  return new Intl.NumberFormat("de-AT", { style: "percent", maximumFractionDigits: 1 }).format(value);
}

function formatPosition(value: number) {
  return new Intl.NumberFormat("de-AT", { maximumFractionDigits: 1 }).format(value);
}
---

<BaseLayout
  title={t("intern.analyticsMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/analytics/"
  noindex
>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <span>{t("intern.analyticsTitle")}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">{t("intern.analyticsTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.analyticsIntro")}</p>

    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.rybbitHeading")}</h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">{t("intern.rybbitExplainer")}</p>
      <a
        href="https://analytics.heimatplatz.at"
        target="_blank"
        rel="noopener"
        class="mt-4 inline-flex items-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
      >
        {t("intern.rybbitOpenButton")}
      </a>
    </section>

    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.searchConsoleHeading")}</h2>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">{t("intern.searchConsoleExplainer")}</p>

      {!searchConsole && (
        <p class="mt-4 text-sm text-muted-foreground">{t("intern.searchConsoleLoadFailed")}</p>
      )}

      {searchConsole && !searchConsole.Enabled && (
        <p class="mt-4 text-sm text-muted-foreground">{t("intern.searchConsoleNotConfigured")}</p>
      )}

      {searchConsole && searchConsole.Enabled && (
        <>
          <dl class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
            <div>
              <dt class="text-muted-foreground">{t("intern.searchConsoleClicks")}</dt>
              <dd class="text-lg font-semibold">{formatNumber(searchConsole.ClicksTotal)}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">{t("intern.searchConsoleImpressions")}</dt>
              <dd class="text-lg font-semibold">{formatNumber(searchConsole.ImpressionsTotal)}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">{t("intern.searchConsoleCtr")}</dt>
              <dd class="text-lg font-semibold">{formatPercent(searchConsole.AverageCtr)}</dd>
            </div>
            <div>
              <dt class="text-muted-foreground">{t("intern.searchConsolePosition")}</dt>
              <dd class="text-lg font-semibold">{formatPosition(searchConsole.AveragePosition)}</dd>
            </div>
          </dl>

          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            <div>
              <h3 class="text-sm font-semibold">{t("intern.searchConsoleTopQueries")}</h3>
              <table class="mt-2 w-full text-sm">
                <thead>
                  <tr class="text-left text-xs text-muted-foreground">
                    <th class="font-normal">{t("intern.searchConsoleColQuery")}</th>
                    <th class="font-normal text-right">{t("intern.searchConsoleColClicks")}</th>
                    <th class="font-normal text-right">{t("intern.searchConsoleColImpressions")}</th>
                  </tr>
                </thead>
                <tbody>
                  {searchConsole.TopQueries.map((row) => (
                    <tr class="border-t border-border">
                      <td class="py-1.5 pr-2">{row.Label}</td>
                      <td class="py-1.5 text-right">{formatNumber(row.Clicks)}</td>
                      <td class="py-1.5 text-right">{formatNumber(row.Impressions)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div>
              <h3 class="text-sm font-semibold">{t("intern.searchConsoleTopPages")}</h3>
              <table class="mt-2 w-full text-sm">
                <thead>
                  <tr class="text-left text-xs text-muted-foreground">
                    <th class="font-normal">{t("intern.searchConsoleColPage")}</th>
                    <th class="font-normal text-right">{t("intern.searchConsoleColClicks")}</th>
                    <th class="font-normal text-right">{t("intern.searchConsoleColImpressions")}</th>
                  </tr>
                </thead>
                <tbody>
                  {searchConsole.TopPages.map((row) => (
                    <tr class="border-t border-border">
                      <td class="py-1.5 pr-2 break-all">{row.Label}</td>
                      <td class="py-1.5 text-right">{formatNumber(row.Clicks)}</td>
                      <td class="py-1.5 text-right">{formatNumber(row.Impressions)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </>
      )}
    </section>
  </section>
</BaseLayout>
