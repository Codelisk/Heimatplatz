---
import { Button } from "@/components/starwind/button";
import { fetchContactInfo, fetchImprint } from "@/features/legal/api";
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile). Die Schreib-
// Aufrufe laufen ueber speichern.ts/impressum.ts, die den ADMIN_API_KEY serverseitig
// anhaengen - der Key bleibt aus dem Browser raus.

const [contact, imprint] = await Promise.all([fetchContactInfo(), fetchImprint()]);

const action = Astro.url.searchParams.get("action");
const errorText = Astro.url.searchParams.get("error") ?? "";

const banner =
  action === "saved"
    ? { ok: true, text: t("intern.contactSaved") }
    : action === "imprint-saved"
      ? { ok: true, text: t("intern.contactImprintSaved") }
      : action === "failed"
        ? { ok: false, text: t("intern.contactSaveFailed", { error: errorText || "Unbekannter Fehler." }) }
        : null;

const inputClass =
  "w-full rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40";

// Immer drei Zeilen anbieten, damit ohne JavaScript Profile ergaenzt werden koennen
const socialRows = [0, 1, 2].map((index) => contact.socialLinks[index] ?? { platform: "", url: "" });

// Impressum-Felder deklarativ: Reihenfolge = Formularreihenfolge, spart 20x gleiches Markup
type ImprintField = {
  name: string;
  label: string;
  value: string;
  required: boolean;
  type?: "text" | "email" | "url";
};

const imprintFields: ImprintField[] = [
  { name: "companyName", label: t("intern.contactFieldCompanyName"), value: imprint.companyName, required: true },
  { name: "legalForm", label: t("intern.contactFieldLegalForm"), value: imprint.legalForm, required: true },
  { name: "owner", label: t("intern.contactFieldOwner"), value: imprint.owner, required: true },
  { name: "street", label: t("intern.contactFieldStreet"), value: imprint.street, required: true },
  { name: "postalCode", label: t("intern.contactFieldPostalCode"), value: imprint.postalCode, required: true },
  { name: "city", label: t("intern.contactFieldCity"), value: imprint.city, required: true },
  { name: "country", label: t("intern.contactFieldCountry"), value: imprint.country, required: true },
  { name: "email", label: t("intern.contactFieldEmail"), value: imprint.email, required: true, type: "email" },
  { name: "phone", label: t("intern.contactFieldPhone"), value: imprint.phone, required: false },
  { name: "website", label: t("intern.contactFieldWebsite"), value: imprint.website, required: false, type: "url" },
  { name: "uidNumber", label: t("intern.contactFieldUid"), value: imprint.uidNumber, required: true },
  { name: "taxNumber", label: t("intern.contactFieldTaxNumber"), value: imprint.taxNumber, required: true },
  { name: "dunsNumber", label: t("intern.contactFieldDuns"), value: imprint.dunsNumber, required: false },
  { name: "gln", label: t("intern.contactFieldGln"), value: imprint.gln, required: false },
  { name: "gisaNumber", label: t("intern.contactFieldGisa"), value: imprint.gisaNumber, required: false },
  { name: "trade", label: t("intern.contactFieldTrade"), value: imprint.trade, required: true },
  { name: "tradeAuthority", label: t("intern.contactFieldTradeAuthority"), value: imprint.tradeAuthority, required: true },
  { name: "professionalLaw", label: t("intern.contactFieldProfessionalLaw"), value: imprint.professionalLaw, required: true },
  { name: "chamberMembership", label: t("intern.contactFieldChamber"), value: imprint.chamberMembership, required: false },
  { name: "tradeGroup", label: t("intern.contactFieldTradeGroup"), value: imprint.tradeGroup, required: false },
];

const preview = [
  { label: t("intern.contactFieldEmail"), value: contact.supportEmail },
  { label: t("intern.contactFieldPhone"), value: contact.phone },
  { label: t("intern.contactPreviewPhoneLink"), value: contact.phoneLink ? `tel:${contact.phoneLink}` : "" },
  { label: t("intern.contactOfficeHoursLabel"), value: contact.officeHours },
];
---

<BaseLayout
  title={t("intern.contactMetaTitle")}
  description={t("intern.contactIntro")}
  canonicalPath="/intern/kontakt/"
  noindex
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 class="text-2xl font-extrabold tracking-tight">{t("intern.contactTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.contactIntro")}</p>

    {
      banner && (
        <div
          class={`mt-6 rounded-lg border border-border p-4 text-sm ${
            banner.ok ? "bg-muted" : "bg-red-50 text-red-700"
          }`}
          role="status"
        >
          {banner.text}
        </div>
      )
    }

    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.contactPreviewHeading")}</h2>
      <dl class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          preview.map((row) => (
            <div>
              <dt class="text-xs text-muted-foreground">{row.label}</dt>
              <dd class={`text-sm ${row.value ? "" : "italic text-muted-foreground"}`}>
                {row.value || t("intern.contactPreviewEmpty")}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <form method="POST" action="/intern/kontakt/speichern">
      <section class="mt-8 rounded-lg border border-border bg-card p-5">
        <h2 class="text-base font-semibold">{t("intern.contactSectionHeading")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">{t("intern.contactSectionHint")}</p>

        <div class="mt-4 flex flex-col gap-4">
          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("intern.contactEmailLabel")}</span>
            <input type="email" name="email" value={contact.email} class={inputClass} />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("intern.contactSupportEmailLabel")}</span>
            <input type="email" name="supportEmail" value={contact.supportEmail} class={inputClass} />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("intern.contactPhoneLabel")}</span>
            <input type="tel" name="phone" value={contact.phone} class={inputClass} />
            <span class="text-xs text-muted-foreground">{t("intern.contactPhoneHint")}</span>
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("intern.contactWebsiteLabel")}</span>
            <input type="url" name="website" value={contact.website} class={inputClass} />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("intern.contactOfficeHoursLabel")}</span>
            <input
              type="text"
              name="officeHours"
              value={contact.officeHours}
              placeholder={t("intern.contactOfficeHoursPlaceholder")}
              class={inputClass}
            />
          </label>
        </div>
      </section>

      <section class="mt-6 rounded-lg border border-border bg-card p-5">
        <h2 class="text-base font-semibold">{t("intern.contactSocialHeading")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">{t("intern.contactSocialHint")}</p>

        <div class="mt-4 flex flex-col gap-4">
          {
            socialRows.map((row, index) => (
              <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
                <label class="flex flex-col gap-1 text-sm">
                  <span class="font-medium">
                    {t("intern.contactSocialPlatformLabel", { index: index + 1 })}
                  </span>
                  <input type="text" name="socialPlatform" value={row.platform} class={inputClass} />
                </label>
                <label class="flex flex-col gap-1 text-sm">
                  <span class="font-medium">
                    {t("intern.contactSocialUrlLabel", { index: index + 1 })}
                  </span>
                  <input type="url" name="socialUrl" value={row.url} class={inputClass} />
                </label>
              </div>
            ))
          }
        </div>

        <div class="mt-5">
          <Button type="submit">{t("intern.contactSave")}</Button>
        </div>
      </section>
    </form>

    <form method="POST" action="/intern/kontakt/impressum">
      <section class="mt-6 rounded-lg border border-border bg-card p-5">
        <h2 class="text-base font-semibold">{t("intern.contactImprintHeading")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">{t("intern.contactImprintHint")}</p>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            imprintFields.map((field) => (
              <label class="flex flex-col gap-1 text-sm">
                <span class="font-medium">{field.label}</span>
                <input
                  type={field.type ?? "text"}
                  name={field.name}
                  value={field.value}
                  required={field.required}
                  class={inputClass}
                />
              </label>
            ))
          }
        </div>

        <div class="mt-5">
          <Button type="submit">{t("intern.contactSave")}</Button>
        </div>
      </section>
    </form>
  </div>
</BaseLayout>
