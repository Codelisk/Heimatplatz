---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n";
import { fetchWkoCompanyById, type WkoCompany } from "@/lib/server/wko-api";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).

const id = Astro.url.searchParams.get("id") ?? "";
const company: WkoCompany | null = id ? await fetchWkoCompanyById(id) : null;

function formatDate(value: string | null) {
  if (!value) return null;
  return new Intl.DateTimeFormat("de-AT", {
    dateStyle: "medium",
    timeZone: "Europe/Vienna",
  }).format(new Date(value));
}

function formatDateTime(value: string | null) {
  if (!value) return null;
  return new Intl.DateTimeFormat("de-AT", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Vienna",
  }).format(new Date(value));
}

const dtClass = "text-muted-foreground";
const ddClass = "font-medium";

type Field = { label: string; value: string | null };

const contactFields: Field[] = company
  ? [
      { label: t("intern.wkoDetailFieldStreet"), value: company.Street },
      { label: t("intern.wkoDetailFieldPostalCode"), value: company.PostalCode },
      { label: t("intern.wkoDetailFieldCity"), value: company.City },
      {
        label: t("intern.wkoDetailFieldPhones"),
        value: company.Phones.length > 0 ? company.Phones.join(", ") : null,
      },
      { label: t("intern.wkoDetailFieldEmail"), value: company.Email },
      { label: t("intern.wkoDetailFieldWebsite"), value: company.Website },
      { label: t("intern.wkoDetailFieldOpeningHours"), value: company.OpeningHoursText },
    ]
  : [];

const companyFields: Field[] = company
  ? [
      { label: t("intern.wkoDetailFieldLegalForm"), value: company.LegalForm },
      { label: t("intern.wkoDetailFieldCompanyRegisterNumber"), value: company.CompanyRegisterNumber },
      { label: t("intern.wkoDetailFieldCompanyCourt"), value: company.CompanyCourt },
      { label: t("intern.wkoDetailFieldGln"), value: company.Gln },
      {
        label: t("intern.wkoDetailFieldFoundedYear"),
        value: company.FoundedYear ? String(company.FoundedYear) : null,
      },
    ]
  : [];

const firmenbuchFields: Field[] = company
  ? [
      { label: t("intern.wkoDetailFieldEuid"), value: company.Euid },
      {
        label: t("intern.wkoDetailFieldFirmenbuchFoundedDate"),
        value: formatDate(company.FirmenbuchFoundedDate),
      },
      {
        label: t("intern.wkoDetailFieldFirmenbuchEnrichedAt"),
        value: formatDateTime(company.FirmenbuchEnrichedAt),
      },
    ]
  : [];
const hasFirmenbuchData = firmenbuchFields.some((f) => f.value);

const scrapingFields: Field[] = company
  ? [
      { label: t("intern.wkoDetailFieldSourceSearchTerm"), value: company.SourceSearchTerm },
      { label: t("intern.wkoDetailFieldFirstSeenAt"), value: formatDateTime(company.FirstSeenAt) },
      { label: t("intern.wkoDetailFieldLastScrapedAt"), value: formatDateTime(company.LastScrapedAt) },
    ]
  : [];

function fieldList(fields: Field[]) {
  return fields.filter((f) => f.value);
}
---

<BaseLayout
  title={t("intern.wkoDetailMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/firmen/detail/"
  noindex
>
  <section class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <a href="/intern/firmen/" class="hover:underline">{t("intern.wkoTitle")}</a>
      <span aria-hidden="true"> / </span>
      <span>{company?.Name ?? "?"}</span>
    </nav>

    {!company && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.wkoDetailNotFound")}
      </div>
    )}

    {company && (
      <>
        <div class="mt-2 flex flex-wrap items-center gap-3">
          <h1 class="text-3xl font-bold">{company.Name}</h1>
          {!company.IsActive && (
            <span class="rounded-full border border-red-200 bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">
              {t("intern.wkoBadgeInactive")}
            </span>
          )}
          {company.IsTrainingCompany && (
            <span class="rounded-full border border-border bg-muted px-2 py-0.5 text-xs font-medium">
              {t("intern.wkoBadgeTrainingCompany")}
            </span>
          )}
        </div>
        {company.CategoryText && (
          <p class="mt-1 text-sm text-muted-foreground">{company.CategoryText}</p>
        )}

        <div class="mt-4">
          <a href={company.DetailUrl} target="_blank" rel="noopener" class="text-sm font-medium hover:underline">
            {t("intern.wkoWkoLink")} →
          </a>
        </div>

        <section class="mt-8 rounded-lg border border-border bg-card p-5">
          <h2 class="text-base font-semibold">{t("intern.wkoDetailContactHeading")}</h2>
          <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
            {fieldList(contactFields).map((f) => (
              <div>
                <dt class={dtClass}>{f.label}</dt>
                <dd class={ddClass}>{f.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="mt-6 rounded-lg border border-border bg-card p-5">
          <h2 class="text-base font-semibold">{t("intern.wkoDetailCompanyHeading")}</h2>
          <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
            {fieldList(companyFields).map((f) => (
              <div>
                <dt class={dtClass}>{f.label}</dt>
                <dd class={ddClass}>{f.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="mt-6 rounded-lg border border-border bg-card p-5">
          <h2 class="text-base font-semibold">{t("intern.wkoDetailFirmenbuchHeading")}</h2>
          {!hasFirmenbuchData ? (
            <p class="mt-3 text-sm text-muted-foreground">
              {t("intern.wkoDetailFirmenbuchNotEnriched")}
            </p>
          ) : (
            <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
              {fieldList(firmenbuchFields).map((f) => (
                <div>
                  <dt class={dtClass}>{f.label}</dt>
                  <dd class={ddClass}>{f.value}</dd>
                </div>
              ))}
            </dl>
          )}

          {company.FirmenbuchManagingDirectors.length > 0 && (
            <div class="mt-5">
              <h3 class="text-sm font-semibold">
                {t("intern.wkoDetailManagingDirectorsHeading")}
              </h3>
              <ul class="mt-2 space-y-2 text-sm">
                {company.FirmenbuchManagingDirectors.map((person) => (
                  <li class="rounded-md border border-border bg-muted/50 p-3">
                    <p class="font-medium">{person.Name}</p>
                    <p class="text-xs text-muted-foreground">
                      {[person.Role, person.BirthDate ? `* ${formatDate(person.BirthDate)}` : null]
                        .filter(Boolean)
                        .join(" · ")}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>

        <section class="mt-6 rounded-lg border border-border bg-card p-5">
          <h2 class="text-base font-semibold">{t("intern.wkoDetailPermitsHeading")}</h2>
          {company.Permits.length === 0 ? (
            <p class="mt-3 text-sm text-muted-foreground">{t("intern.wkoDetailPermitsEmpty")}</p>
          ) : (
            <ul class="mt-4 space-y-3 text-sm">
              {company.Permits.map((permit) => (
                <li class="rounded-md border border-border bg-muted/50 p-3">
                  {permit.FachgruppeName && <p class="font-medium">{permit.FachgruppeName}</p>}
                  {permit.Description && <p class="mt-1">{permit.Description}</p>}
                  <p class="mt-1 text-xs text-muted-foreground">
                    {[
                      permit.ManagingDirector,
                      permit.GisaNumber ? `GISA-Zahl: ${permit.GisaNumber}` : null,
                      permit.Since ? `Seit ${formatDate(permit.Since)}` : null,
                    ]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="mt-6 rounded-lg border border-border bg-card p-5">
          <h2 class="text-base font-semibold">{t("intern.wkoDetailScrapingHeading")}</h2>
          <dl class="mt-4 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
            {fieldList(scrapingFields).map((f) => (
              <div>
                <dt class={dtClass}>{f.label}</dt>
                <dd class={ddClass}>{f.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      </>
    )}
  </section>
</BaseLayout>
