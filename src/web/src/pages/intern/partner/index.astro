---
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { adminApiGet, type AdminPartner, type AdminPartnersResponse } from "@/lib/server/admin-api";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile). Die Schreib-
// Aufrufe laufen ueber speichern.ts/loeschen.ts, die den ADMIN_API_KEY serverseitig
// anhaengen - der Key bleibt aus dem Browser raus (Muster /intern/kontakt).

const data = await adminApiGet<AdminPartnersResponse>("/api/admin/partners");
const partners: AdminPartner[] = data?.Partners ?? [];
const apiUnreachable = data === null;

const action = Astro.url.searchParams.get("action");
const errorText = Astro.url.searchParams.get("error") ?? "";

const banner =
  action === "saved"
    ? { ok: true, text: t("partner.internSaved") }
    : action === "deleted"
      ? { ok: true, text: t("partner.internDeleted") }
      : action === "failed"
        ? { ok: false, text: t("partner.internFailed", { error: errorText || "Unbekannter Fehler." }) }
        : null;

// ?edit=<id> waehlt den Partner fuers Formular; ohne Treffer bleibt es das Anlege-Formular
const editId = Astro.url.searchParams.get("edit");
const editing = editId ? (partners.find((partner) => partner.Id === editId) ?? null) : null;

const categories = [
  { value: "Broker", label: t("partner.categoryBroker") },
  { value: "DataSource", label: t("partner.categoryDataSource") },
];

const categoryLabel = (value: string) =>
  categories.find((category) => category.value === value)?.label ?? value;

const inputClass =
  "w-full rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40";
---

<BaseLayout
  title={t("partner.internMetaTitle")}
  description={t("partner.internIntro")}
  canonicalPath="/intern/partner/"
  noindex
>
  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 class="text-2xl font-extrabold tracking-tight">{t("partner.internTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("partner.internIntro")}</p>

    {
      banner && (
        <div
          class={`mt-6 rounded-lg border border-border p-4 text-sm ${
            banner.ok ? "bg-muted" : "bg-red-50 text-red-700"
          }`}
          role="status"
        >
          {banner.text}
        </div>
      )
    }

    {
      apiUnreachable && (
        <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700" role="status">
          {t("partner.internFailed", { error: "Die API ist nicht erreichbar oder ADMIN_API_KEY fehlt." })}
        </div>
      )
    }

    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("partner.internListHeading")}</h2>

      {partners.length === 0 && !apiUnreachable && (
        <p class="mt-4 text-sm italic text-muted-foreground">{t("partner.internEmpty")}</p>
      )}

      {
        partners.length > 0 && (
          <ul class="mt-4 divide-y divide-border">
            {partners.map((partner) => (
              <li class="flex flex-wrap items-center gap-x-4 gap-y-2 py-3">
                {partner.LogoUrl ? (
                  <img
                    src={partner.LogoUrl}
                    alt=""
                    class="h-9 w-14 shrink-0 rounded border border-border bg-white object-contain p-1"
                    loading="lazy"
                  />
                ) : (
                  <span class="grid h-9 w-14 shrink-0 place-items-center rounded border border-dashed border-border text-[10px] uppercase text-muted-foreground">
                    Logo
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-semibold">
                    {partner.Name}
                    {!partner.IsVisible && (
                      <span class="ml-2 rounded bg-muted px-1.5 py-0.5 text-xs font-medium text-muted-foreground">
                        {t("partner.internHiddenTag")}
                      </span>
                    )}
                  </p>
                  <p class="text-xs text-muted-foreground">
                    {categoryLabel(partner.Category)}
                    {partner.Region ? ` · ${partner.Region}` : ""}
                    {partner.SourceName ? ` · ${t("partner.internListListings", { count: partner.ActiveListingCount })}` : ""}
                  </p>
                </div>
                <div class="flex items-center gap-3 text-sm">
                  <a class="font-semibold underline-offset-4 hover:underline" href={`/intern/partner/?edit=${partner.Id}#formular`}>
                    {t("partner.internEdit")}
                  </a>
                  <form
                    method="POST"
                    action="/intern/partner/loeschen"
                    data-partner-delete
                  >
                    <input type="hidden" name="id" value={partner.Id} />
                    <button type="submit" class="font-semibold text-error underline-offset-4 hover:underline">
                      {t("partner.internDelete")}
                    </button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <form method="POST" action="/intern/partner/speichern" enctype="multipart/form-data" id="formular" class="scroll-mt-20">
      <section class="mt-6 rounded-lg border border-border bg-card p-5">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-base font-semibold">
            {editing ? t("partner.internEditHeading") : t("partner.internNewHeading")}
            {editing && <span class="font-normal text-muted-foreground"> – {editing.Name}</span>}
          </h2>
          {editing && (
            <a class="text-sm font-semibold underline-offset-4 hover:underline" href="/intern/partner/">
              {t("partner.internCancelEdit")}
            </a>
          )}
        </div>

        {editing && <input type="hidden" name="id" value={editing.Id} />}
        <input type="hidden" name="logoUrl" value={editing?.LogoUrl ?? ""} />

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldName")}</span>
            <input type="text" name="name" value={editing?.Name ?? ""} required maxlength="200" class={inputClass} />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldCategory")}</span>
            <select name="category" class={inputClass}>
              {categories.map((category) => (
                <option value={category.value} selected={(editing?.Category ?? "Broker") === category.value}>
                  {category.label}
                </option>
              ))}
            </select>
          </label>
        </div>

        <label class="mt-4 flex flex-col gap-1 text-sm">
          <span class="font-medium">{t("partner.internFieldDescription")}</span>
          <textarea name="description" rows="3" maxlength="2000" class={inputClass}>{editing?.Description ?? ""}</textarea>
        </label>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldWebsite")}</span>
            <input type="url" name="websiteUrl" value={editing?.WebsiteUrl ?? ""} maxlength="500" class={inputClass} />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldRegion")}</span>
            <input
              type="text"
              name="region"
              value={editing?.Region ?? ""}
              placeholder={t("partner.internFieldRegionPlaceholder")}
              maxlength="200"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldSinceYear")}</span>
            <input
              type="number"
              name="partnerSinceYear"
              value={editing?.PartnerSinceYear ?? ""}
              min="1900"
              max="2100"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldDisplayOrder")}</span>
            <input type="number" name="displayOrder" value={editing?.DisplayOrder ?? 10} class={inputClass} />
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldSourceName")}</span>
            <input type="text" name="sourceName" value={editing?.SourceName ?? ""} maxlength="200" class={inputClass} />
            <span class="text-xs text-muted-foreground">{t("partner.internFieldSourceNameHint")}</span>
          </label>

          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldSellerName")}</span>
            <input type="text" name="sellerName" value={editing?.SellerName ?? ""} maxlength="200" class={inputClass} />
            <span class="text-xs text-muted-foreground">{t("partner.internFieldSellerNameHint")}</span>
          </label>
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1 text-sm">
            <span class="font-medium">{t("partner.internFieldLogo")}</span>
            <input type="file" name="logoFile" accept="image/*" class={inputClass} />
            <span class="text-xs text-muted-foreground">{t("partner.internFieldLogoHint")}</span>
          </label>

          {editing?.LogoUrl && (
            <div class="flex flex-col gap-2 text-sm">
              <span class="font-medium">{t("partner.internLogoCurrent")}</span>
              <img
                src={editing.LogoUrl}
                alt={t("partner.logoAlt", { name: editing.Name })}
                class="h-14 w-fit max-w-full rounded border border-border bg-white object-contain p-1"
              />
              <label class="flex items-center gap-2">
                <input type="checkbox" name="logoRemove" class="rounded border-border" />
                <span>{t("partner.internLogoRemove")}</span>
              </label>
            </div>
          )}
        </div>

        <label class="mt-4 flex items-center gap-2 text-sm">
          <input type="checkbox" name="isVisible" checked={editing?.IsVisible ?? true} class="rounded border-border" />
          <span class="font-medium">{t("partner.internFieldVisible")}</span>
        </label>

        <div class="mt-5">
          <Button type="submit">{t("partner.internSave")}</Button>
        </div>
      </section>
    </form>
  </div>
</BaseLayout>

<script>
  import { t } from "@/i18n";

  // Loeschen ist endgueltig (inkl. Logo-Datei) - Bestaetigung nur bei Destruktivem
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-partner-delete]")) {
    form.addEventListener("submit", (event) => {
      if (!window.confirm(t("partner.internDeleteConfirm"))) event.preventDefault();
    });
  }
</script>
