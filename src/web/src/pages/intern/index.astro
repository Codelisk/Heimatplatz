---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import { getServerApiBaseUrl } from "@/lib/server/api-base";
import { adminApiGet, type AdminStats } from "@/lib/server/admin-api";

// Erreichbarkeit ist bereits durch Caddy auf IP-Ebene beschraenkt (siehe
// deploy/hetzner/Caddyfile, @internBlocked auf /intern*) - kein weiterer Check noetig,
// wenn eine Anfrage hier ankommt, hat sie den Netzwerk-Filter bereits passiert.

type SyncStatus = {
  LastSyncAt: string | null;
  TotalActiveAuctions: number;
  TotalRemovedAuctions: number;
  TotalChanges: number;
  IsRunning: boolean;
};

async function fetchSyncStatus(): Promise<SyncStatus | null> {
  try {
    const response = await fetch(new URL("/api/foreclosure-auctions/sync/status", getServerApiBaseUrl()));
    if (!response.ok) return null;
    return await response.json();
  } catch {
    return null;
  }
}

const [status, stats] = await Promise.all([
  fetchSyncStatus(),
  adminApiGet<AdminStats>("/api/admin/stats"),
]);
const triggered = Astro.url.searchParams.get("triggered") === "1";
const triggerFailed = Astro.url.searchParams.get("triggered") === "0";
// Laeuft gerade ein Sync, wird der Start-Button deaktiviert - der Server ignoriert
// Doppel-Trigger zwar ohnehin, aber die UI soll das gar nicht erst anbieten.
const syncRunning = status?.IsRunning === true;

function formatDate(value: string | null) {
  if (!value) return t("intern.never");
  return new Intl.DateTimeFormat("de-AT", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: "Europe/Vienna",
  }).format(new Date(value));
}

const statEntries = stats
  ? [
      { label: t("intern.statsTotalUsers"), value: stats.TotalUsers },
      { label: t("intern.statsNewUsers7"), value: stats.NewUsers7Days },
      { label: t("intern.statsNewUsers30"), value: stats.NewUsers30Days },
      { label: t("intern.statsTotalProperties"), value: stats.TotalProperties },
      { label: t("intern.statsUserProperties"), value: stats.UserProperties },
      { label: t("intern.statsForeclosures"), value: stats.ForeclosureProperties },
      { label: t("intern.statsHidden"), value: stats.HiddenProperties },
    ]
  : [];
---

<BaseLayout
  title={t("intern.metaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/"
  noindex
>
  <section class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold">{t("intern.title")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">
      {t("intern.intro")}
    </p>

    {triggered && (
      <div class="mt-6 rounded-lg border border-border bg-muted p-4 text-sm">
        {t("intern.syncTriggered")}
      </div>
    )}
    {triggerFailed && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.syncFailed")}
      </div>
    )}
    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.statsHeading")}</h2>

      {stats ? (
        <dl class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-3">
          {statEntries.map((entry) => (
            <div>
              <dt class="text-muted-foreground">{entry.label}</dt>
              <dd class="text-lg font-semibold">{entry.value}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <p class="mt-4 text-sm text-muted-foreground">{t("intern.statsLoadFailed")}</p>
      )}
    </section>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a
        href="/intern/nutzer/"
        class="rounded-lg border border-border bg-card p-5 transition-colors hover:bg-muted"
      >
        <h2 class="text-base font-semibold">{t("intern.navUsers")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {t("intern.navUsersDescription")}
        </p>
      </a>
      <a
        href="/intern/immobilien/"
        class="rounded-lg border border-border bg-card p-5 transition-colors hover:bg-muted"
      >
        <h2 class="text-base font-semibold">{t("intern.navProperties")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {t("intern.navPropertiesDescription")}
        </p>
      </a>
      <a
        href="/intern/marketing/"
        class="rounded-lg border border-border bg-card p-5 transition-colors hover:bg-muted"
      >
        <h2 class="text-base font-semibold">{t("intern.navMarketing")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {t("intern.navMarketingDescription")}
        </p>
      </a>
      <a
        href="/intern/feedback/"
        class="rounded-lg border border-border bg-card p-5 transition-colors hover:bg-muted"
      >
        <h2 class="text-base font-semibold">{t("intern.navFeedback")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {t("intern.navFeedbackDescription")}
        </p>
      </a>
      <a
        href="/intern/analytics/"
        class="rounded-lg border border-border bg-card p-5 transition-colors hover:bg-muted"
      >
        <h2 class="text-base font-semibold">{t("intern.navAnalytics")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {t("intern.navAnalyticsDescription")}
        </p>
      </a>
      <a
        href="/intern/kontakt/"
        class="rounded-lg border border-border bg-card p-5 transition-colors hover:bg-muted"
      >
        <h2 class="text-base font-semibold">{t("intern.navContact")}</h2>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          {t("intern.navContactDescription")}
        </p>
      </a>
    </div>

    <section class="mt-8 rounded-lg border border-border bg-card p-5">
      <h2 class="text-base font-semibold">{t("intern.syncHeading")}</h2>

      {status ? (
        <dl class="mt-4 grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-muted-foreground">{t("intern.lastSync")}</dt>
            <dd class="font-medium">{formatDate(status.LastSyncAt)}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">{t("intern.activeAuctions")}</dt>
            <dd class="font-medium">{status.TotalActiveAuctions}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">{t("intern.removedAuctions")}</dt>
            <dd class="font-medium">{status.TotalRemovedAuctions}</dd>
          </div>
          <div>
            <dt class="text-muted-foreground">{t("intern.totalChanges")}</dt>
            <dd class="font-medium">{status.TotalChanges}</dd>
          </div>
        </dl>
      ) : (
        <p class="mt-4 text-sm text-muted-foreground">{t("intern.statusLoadFailed")}</p>
      )}

      {syncRunning && (
        <p class="mt-4 text-sm font-medium text-amber-700 dark:text-amber-300">
          {t("intern.syncRunning")}
        </p>
      )}

      <form method="POST" action="/intern/sync" class="mt-6">
        <Button type="submit" variant="default" disabled={syncRunning}>
          {t("intern.startSync")}
        </Button>
      </form>

      <p class="mt-3 text-xs leading-5 text-muted-foreground">
        {t("intern.syncExplainer")}
      </p>
    </section>

  </section>
</BaseLayout>
