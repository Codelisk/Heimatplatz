---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import { adminApiGet, type AdminFeedbackStats, type AdminFeedbackTicketsPage } from "@/lib/server/admin-api";
import {
  FEEDBACK_CATEGORIES,
  FEEDBACK_STATUSES,
  feedbackCategoryLabel,
  feedbackSourceLabel,
  feedbackStatusBadgeClass,
  feedbackStatusLabel,
} from "@/lib/intern/feedback-labels";
import { formatInternDate } from "@/lib/intern/marketing-labels";

// Zugriffsschutz: Caddy-IP-Sperre auf /intern* (deploy/hetzner/Caddyfile).

const PAGE_SIZE = 50;

const status = Astro.url.searchParams.get("status") ?? "";
const category = Astro.url.searchParams.get("category") ?? "";
const search = Astro.url.searchParams.get("search") ?? "";
const page = Math.max(Number.parseInt(Astro.url.searchParams.get("page") ?? "0", 10) || 0, 0);
const action = Astro.url.searchParams.get("action");

const query = new URLSearchParams({ page: String(page), pageSize: String(PAGE_SIZE) });
if (status) query.set("status", status);
if (category) query.set("category", category);
if (search) query.set("search", search);

const [data, stats] = await Promise.all([
  adminApiGet<AdminFeedbackTicketsPage>(`/api/admin/feedback?${query}`),
  adminApiGet<AdminFeedbackStats>("/api/admin/feedback/stats"),
]);
const totalPages = data ? Math.max(Math.ceil(data.Total / data.PageSize), 1) : 1;

function pageLink(target: number) {
  const params = new URLSearchParams();
  if (status) params.set("status", status);
  if (category) params.set("category", category);
  if (search) params.set("search", search);
  if (target > 0) params.set("page", String(target));
  const qs = params.toString();
  return qs ? `/intern/feedback/?${qs}` : "/intern/feedback/";
}

const inputClass =
  "w-full rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40";

const statCards = stats
  ? [
      { label: t("intern.fbStatsOpen"), value: stats.Open },
      { label: t("intern.fbStatsInProgress"), value: stats.InProgress },
      { label: t("intern.fbStatsUnread"), value: stats.UnreadFromUser },
      { label: t("intern.fbStatsTotal"), value: stats.Total },
    ]
  : [];
---

<BaseLayout
  title={t("intern.fbMetaTitle")}
  description={t("intern.metaDescription")}
  canonicalPath="/intern/feedback/"
  noindex
>
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <nav class="text-sm text-muted-foreground">
      <a href="/intern/" class="hover:underline">{t("intern.title")}</a>
      <span aria-hidden="true"> / </span>
      <span>{t("intern.fbTitle")}</span>
    </nav>

    <h1 class="mt-2 text-3xl font-bold">{t("intern.fbTitle")}</h1>
    <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("intern.fbIntro")}</p>

    {action === "replied" && (
      <div class="mt-6 rounded-lg border border-border bg-muted p-4 text-sm">
        {t("intern.fbReplyOk")}
      </div>
    )}
    {action === "replyfailed" && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.fbReplyFailed")}
      </div>
    )}
    {action === "status" && (
      <div class="mt-6 rounded-lg border border-border bg-muted p-4 text-sm">
        {t("intern.fbStatusOk")}
      </div>
    )}
    {action === "statusfailed" && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.fbStatusFailed")}
      </div>
    )}

    {statCards.length > 0 && (
      <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {statCards.map((card) => (
          <div class="rounded-lg border border-border bg-card p-4">
            <dt class="text-xs text-muted-foreground">{card.label}</dt>
            <dd class="mt-1 text-2xl font-bold">{card.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <form method="GET" action="/intern/feedback/" class="mt-6 grid gap-3 sm:grid-cols-[10rem_10rem_1fr_auto]">
      <label class="block">
        <span class="mb-1 block text-xs text-muted-foreground">{t("intern.fbFilterStatus")}</span>
        <select name="status" class={inputClass}>
          <option value="">{t("intern.fbFilterAll")}</option>
          {FEEDBACK_STATUSES.map((value) => (
            <option value={value} selected={status === value}>{feedbackStatusLabel(value)}</option>
          ))}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs text-muted-foreground">{t("intern.fbFilterCategory")}</span>
        <select name="category" class={inputClass}>
          <option value="">{t("intern.fbFilterAll")}</option>
          {FEEDBACK_CATEGORIES.map((value) => (
            <option value={value} selected={category === value}>{feedbackCategoryLabel(value)}</option>
          ))}
        </select>
      </label>
      <label class="block">
        <span class="mb-1 block text-xs text-muted-foreground">&nbsp;</span>
        <input
          type="search"
          name="search"
          value={search}
          placeholder={t("intern.fbSearchPlaceholder")}
          class={inputClass}
        />
      </label>
      <div class="flex items-end">
        <Button type="submit" variant="default">{t("intern.fbSearchSubmit")}</Button>
      </div>
    </form>

    {!data && (
      <div class="mt-6 rounded-lg border border-border bg-red-50 p-4 text-sm text-red-700">
        {t("intern.fbLoadFailed")}
      </div>
    )}

    {data && (
      <section class="mt-6 rounded-lg border border-border bg-card">
        <p class="border-b border-border px-5 py-3 text-sm text-muted-foreground">
          {data.Total === 1
            ? t("intern.fbTotalOne")
            : t("intern.fbTotal", { count: data.Total })}
        </p>

        {data.Tickets.length === 0 ? (
          <p class="px-5 py-6 text-sm text-muted-foreground">{t("intern.fbEmpty")}</p>
        ) : (
          <ul class="divide-y divide-border">
            {data.Tickets.map((ticket) => (
              <li class={`px-5 py-4 ${ticket.HasUnreadFromUser ? "bg-muted/50" : ""}`}>
                <div class="flex flex-wrap items-center gap-2">
                  {ticket.HasUnreadFromUser && (
                    <span class="rounded-full bg-red-600 px-2 py-0.5 text-xs font-medium text-white">
                      {t("intern.fbBadgeUnread")}
                    </span>
                  )}
                  <span class={`rounded-full px-2 py-0.5 text-xs font-medium ${feedbackStatusBadgeClass(ticket.Status)}`}>
                    {feedbackStatusLabel(ticket.Status)}
                  </span>
                  <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                    {feedbackCategoryLabel(ticket.Category)}
                  </span>
                  <span class="text-xs text-muted-foreground">
                    {formatInternDate(ticket.LastMessageAt)}
                  </span>
                </div>
                <a
                  href={`/intern/feedback/detail/?id=${ticket.Id}`}
                  class="mt-1 block text-sm font-medium underline-offset-2 hover:underline"
                >
                  {ticket.Subject}
                </a>
                <p class="mt-0.5 truncate text-sm text-muted-foreground">{ticket.LastMessagePreview}</p>
                <p class="mt-1 text-xs text-muted-foreground">
                  {ticket.UserName ?? "?"}
                  {ticket.UserEmail && <span> · {ticket.UserEmail}</span>}
                  <span> · {feedbackSourceLabel(ticket.Source)}</span>
                  {ticket.AppVersion && <span> · v{ticket.AppVersion}</span>}
                  <span>
                    {" · "}
                    {ticket.MessageCount === 1
                      ? t("intern.fbMessageCountOne")
                      : t("intern.fbMessageCount", { count: ticket.MessageCount })}
                  </span>
                </p>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    {data && totalPages > 1 && (
      <nav class="mt-6 flex items-center justify-between text-sm">
        {page > 0 ? (
          <a href={pageLink(page - 1)} class="underline hover:no-underline">
            {t("intern.pagePrev")}
          </a>
        ) : (
          <span />
        )}
        <span class="text-muted-foreground">
          {t("intern.pageInfo", { page: page + 1, pages: totalPages })}
        </span>
        {data.HasMore ? (
          <a href={pageLink(page + 1)} class="underline hover:no-underline">
            {t("intern.pageNext")}
          </a>
        ) : (
          <span />
        )}
      </nav>
    )}
  </section>
</BaseLayout>
