---
import AuthShell from "@/components/auth/AuthShell.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
---

<AuthShell
  title={t("auth.verifyTitle")}
  description={t("auth.verifyDescription")}
  canonicalPath="/email-bestaetigen/"
>
  {/* Der Token kommt als ?token= aus dem Mail-Link; das globale Script ruft die API automatisch auf */}
  <div class="mt-10" data-verify-email>
    <p class="text-sm text-muted-foreground" data-verify-pending>{t("auth.verifyPending")}</p>
    <div data-verify-success hidden>
      <p class="text-sm font-medium text-success-foreground dark:text-success" data-verify-success-message></p>
      <Button href="/profil/" class="mt-6">{t("auth.verifyContinue")}</Button>
    </div>
    <div data-verify-error hidden>
      <p class="text-sm text-error" data-verify-error-message></p>
      <p class="mt-3 text-sm text-muted-foreground">
        {t("auth.verifyErrorHelpPrefix")} <a class="font-semibold text-foreground" href="/profil/">{t("auth.verifyErrorHelpLink")}</a> {t("auth.verifyErrorHelpSuffix")}
      </p>
    </div>
  </div>
</AuthShell>

<script>
  // Die Kopf-Beschreibung "Wir prüfen Ihren Bestätigungslink." passt nur zum
  // Pruef-Zustand: Sobald das globale Script Erfolg oder Fehler einblendet
  // (hidden-Attribut entfernt), traegt der Body die eigentliche Meldung - die
  // Kopfzeile wuerde sonst doppelt wirken. Der Zustand wird per
  // MutationObserver beobachtet, weil das globale Script nicht hier lebt.
  const description = document.querySelector<HTMLElement>("[data-auth-description]");
  const states = Array.from(
    document.querySelectorAll<HTMLElement>("[data-verify-success], [data-verify-error]"),
  );
  if (description && states.length > 0) {
    const sync = () => {
      description.hidden = states.some((element) => !element.hidden);
    };
    const observer = new MutationObserver(sync);
    for (const element of states) {
      observer.observe(element, { attributes: true, attributeFilter: ["hidden"] });
    }
    sync();
  }
</script>
