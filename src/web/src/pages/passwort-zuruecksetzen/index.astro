---
import AuthShell from "@/components/auth/AuthShell.astro";
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { t } from "@/i18n";
---

<AuthShell
  title={t("auth.resetTitle")}
  description={t("auth.resetDescription")}
  canonicalPath="/passwort-zuruecksetzen/"
>
  {/* Der Reset-Token kommt als ?token= aus dem Mail-Link (PropertyStateScript liest ihn aus) */}
  <form class="mt-10 space-y-5" method="post" data-reset-password-form>
    {/* Der Passwortmanager-Benutzername steckt datensparsam im URL-Fragment
        und wird vom Script eingesetzt, ohne an die API gesendet zu werden. */}
    <input
      id="resetPasswordUsername"
      class="hidden"
      type="email"
      name="username"
      autocomplete="username"
      data-password-username
    />
    <div class="space-y-2">
      <Label for="newPassword">{t("auth.newPasswordLabel")}</Label>
      <Input id="newPassword" type="password" name="newPassword" placeholder={t("auth.passwordMinHint")} minlength="8" autocomplete="new-password" required />
    </div>
    <div class="space-y-2">
      <Label for="newPasswordConfirm">{t("auth.newPasswordConfirmLabel")}</Label>
      <Input id="newPasswordConfirm" type="password" name="newPasswordConfirm" placeholder={t("auth.resetConfirmPlaceholder")} minlength="8" autocomplete="new-password" required />
    </div>
    <p class="hidden text-sm" data-form-status></p>
    <Button type="submit" class="w-full">{t("auth.changePassword")}</Button>
  </form>
  <p class="mt-8 text-center text-sm text-muted-foreground">
    {t("auth.backToLoginPrefix")} <a class="font-semibold text-foreground" href="/anmelden/">{t("auth.backToLoginLink")}</a>
  </p>
</AuthShell>
