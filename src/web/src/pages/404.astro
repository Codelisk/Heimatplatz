---
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={t("notFound.metaTitle")}
  description={t("notFound.metaDescription")}
  noindex
>
  <section class="mx-auto flex max-w-xl flex-col items-center gap-4 px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted-foreground">{t("notFound.kicker")}</p>
    <h1 class="text-3xl font-bold">{t("notFound.title")}</h1>
    <p class="text-muted-foreground">
      {t("notFound.text")}
    </p>
    <a
      href="/"
      class="mt-2 inline-flex h-10 items-center rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-accent"
    >
      {t("notFound.backHome")}
    </a>
  </section>
</BaseLayout>
