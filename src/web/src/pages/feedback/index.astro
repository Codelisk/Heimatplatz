---
import BulbIcon from "@tabler/icons/outline/bulb.svg";
import AlertTriangleIcon from "@tabler/icons/outline/alert-triangle.svg";
import HelpCircleIcon from "@tabler/icons/outline/help-circle.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import DotsIcon from "@tabler/icons/outline/dots.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthGate from "@/components/app/AuthGate.astro";
import MessageComposer from "@/components/app/MessageComposer.astro";
import { t } from "@/i18n";

// Feedback & Wuensche: Kategorie waehlen, Nachricht mit Bildern/Sprachnachricht
// direkt in der Messenger-Zeile schicken, unten die eigenen Anfragen.
// Logik in PropertyStateScript.astro (bindFeedbackPage + setupMessageComposer).

const categories = [
  { value: "Idea", icon: BulbIcon, label: t("feedback.categoryIdea"), hint: t("feedback.categoryIdeaHint") },
  { value: "Problem", icon: AlertTriangleIcon, label: t("feedback.categoryProblem"), hint: t("feedback.categoryProblemHint") },
  { value: "Question", icon: HelpCircleIcon, label: t("feedback.categoryQuestion"), hint: t("feedback.categoryQuestionHint") },
  { value: "Praise", icon: HeartIcon, label: t("feedback.categoryPraise"), hint: t("feedback.categoryPraiseHint") },
  { value: "Other", icon: DotsIcon, label: t("feedback.categoryOther"), hint: t("feedback.categoryOtherHint") },
];
---

<BaseLayout
  title={t("feedback.metaTitle")}
  description={t("feedback.metaDescription")}
  canonicalPath="/feedback/"
  noindex
>
  <AuthGate title={t("feedback.authTitle")} description={t("feedback.authDescription")}>
    <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold">{t("feedback.title")}</h1>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">{t("feedback.intro")}</p>

      <form data-feedback-form class="mt-6" novalidate>
        <fieldset class="rounded-lg border border-border bg-card p-5">
          <legend class="px-1 text-base font-semibold">{t("feedback.categoryLegend")}</legend>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {categories.map((category, index) => (
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="category"
                  value={category.value}
                  class="peer sr-only"
                  checked={index === 0}
                />
                <span class="flex items-start gap-3 rounded-lg border border-border bg-muted p-4 transition-colors peer-checked:border-primary peer-checked:bg-primary/5 peer-checked:ring-1 peer-checked:ring-primary hover:border-foreground/30">
                  <category.icon class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold">{category.label}</span>
                    <span class="mt-0.5 block text-xs leading-5 text-muted-foreground">{category.hint}</span>
                  </span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-4">
          <MessageComposer placeholder={t("feedback.messagePlaceholder")} hint={t("feedback.composeHint")} />
        </div>
      </form>

      <section class="mt-12" data-feedback-list-section>
        <h2 class="text-xl font-bold">{t("feedback.listTitle")}</h2>
        <p class="mt-4 hidden text-sm text-muted-foreground" data-feedback-list-empty>
          {t("feedback.listEmpty")}
        </p>
        <p class="mt-4 hidden text-sm text-error" data-feedback-list-error></p>
        <ul class="mt-4 divide-y divide-border rounded-lg border border-border bg-card" data-feedback-list hidden></ul>
      </section>
    </section>
  </AuthGate>
</BaseLayout>
