---
import ArrowLeftIcon from "@tabler/icons/outline/arrow-left.svg";
import PhotoPlusIcon from "@tabler/icons/outline/photo-plus.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthGate from "@/components/app/AuthGate.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";

// Verlauf einer Feedback-Anfrage (?id=...): Nachrichten chronologisch als Chat,
// Antwort-Formular unten. Logik in PropertyStateScript.astro (bindFeedbackThreadPage);
// das Laden markiert Team-Antworten serverseitig als gelesen.

const inputClass =
  "w-full rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40";
---

<BaseLayout
  title={t("feedback.threadMetaTitle")}
  description={t("feedback.metaDescription")}
  canonicalPath="/feedback/anfrage/"
  noindex
>
  <AuthGate title={t("feedback.authTitle")} description={t("feedback.authDescription")}>
    <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8" data-feedback-thread>
      <a href="/feedback/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground">
        <ArrowLeftIcon class="size-4" aria-hidden="true" />
        {t("feedback.threadBack")}
      </a>

      <p class="mt-6 hidden text-sm text-error" data-thread-error></p>

      <div data-thread-content hidden>
        <header class="mt-4">
          <div class="flex flex-wrap items-center gap-2" data-thread-badges></div>
          <h1 class="mt-2 text-2xl font-bold sm:text-3xl" data-thread-subject></h1>
        </header>

        <ol class="mt-8 space-y-4" data-thread-messages></ol>

        <form class="mt-8 rounded-lg border border-border bg-card p-5" data-feedback-reply-form>
          <label class="block">
            <span class="mb-1 block text-sm font-medium">{t("feedback.replyLabel")}</span>
            <textarea
              name="body"
              rows="4"
              maxlength="4000"
              placeholder={t("feedback.replyPlaceholder")}
              class={inputClass}></textarea>
          </label>
          <input
            type="file"
            accept="image/jpeg,image/png,image/webp"
            multiple
            class="sr-only"
            data-feedback-images
          />
          <div class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-5" data-feedback-image-grid hidden></div>
          <p class="mt-3 hidden text-sm" data-form-status></p>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <Button type="submit" size="sm" data-feedback-submit>{t("feedback.replySend")}</Button>
            <Button type="button" variant="outline" size="sm" data-feedback-images-add>
              <PhotoPlusIcon class="size-4" aria-hidden="true" />
              {t("feedback.photosAdd")}
            </Button>
          </div>
        </form>
      </div>
    </section>
  </AuthGate>
</BaseLayout>
