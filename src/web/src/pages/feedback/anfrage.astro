---
import ArrowLeftIcon from "@tabler/icons/outline/arrow-left.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthGate from "@/components/app/AuthGate.astro";
import MessageComposer from "@/components/app/MessageComposer.astro";
import { t } from "@/i18n";

// Verlauf einer Feedback-Anfrage (?id=...): Nachrichten chronologisch als Chat,
// unten die Messenger-Eingabe (Text, Bilder, Sprachnachricht). Logik in
// PropertyStateScript.astro (bindFeedbackThreadPage); das Laden markiert
// Team-Antworten serverseitig als gelesen.
---

<BaseLayout
  title={t("feedback.threadMetaTitle")}
  description={t("feedback.metaDescription")}
  canonicalPath="/feedback/anfrage/"
  noindex
>
  <AuthGate title={t("feedback.authTitle")} description={t("feedback.authDescription")}>
    <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8" data-feedback-thread>
      <a href="/feedback/" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground">
        <ArrowLeftIcon class="size-4" aria-hidden="true" />
        {t("feedback.threadBack")}
      </a>

      <p class="mt-6 hidden text-sm text-error" data-thread-error></p>

      <div data-thread-content hidden>
        <header class="mt-4">
          <div class="flex flex-wrap items-center gap-2" data-thread-badges></div>
          <h1 class="mt-2 text-2xl font-bold sm:text-3xl" data-thread-subject></h1>
        </header>

        <ol class="mt-8 space-y-4" data-thread-messages></ol>

        <div class="sticky bottom-4 mt-8" data-feedback-reply-form>
          <MessageComposer placeholder={t("feedback.replyPlaceholder")} />
        </div>
      </div>
    </section>
  </AuthGate>
</BaseLayout>
