---
import AlertTriangleIcon from "@tabler/icons/outline/alert-triangle.svg";
import BellIcon from "@tabler/icons/outline/bell.svg";
import ChevronRightIcon from "@tabler/icons/outline/chevron-right.svg";
import FilterIcon from "@tabler/icons/outline/filter.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import HomeIcon from "@tabler/icons/outline/home.svg";
import LayoutDashboardIcon from "@tabler/icons/outline/layout-dashboard.svg";
import LockIcon from "@tabler/icons/outline/lock.svg";
import LoginIcon from "@tabler/icons/outline/login.svg";
import LogoutIcon from "@tabler/icons/outline/logout.svg";
import MailCheckIcon from "@tabler/icons/outline/mail-check.svg";
import PlusIcon from "@tabler/icons/outline/plus.svg";
import RosetteCheckIcon from "@tabler/icons/outline/rosette-discount-check.svg";
import ShieldOffIcon from "@tabler/icons/outline/shield-off.svg";
import UserIcon from "@tabler/icons/outline/user.svg";
import UserPlusIcon from "@tabler/icons/outline/user-plus.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { t } from "@/i18n";
import { buildLoginHref, buildRegisterHref, getCurrentReturnTo } from "@/lib/navigation";

// Schnellzugriff: Ziele ohne eigene Zaehler-Kachel (Favoriten/Blockiert/Inserate
// haben oben bereits verlinkte Kacheln - hier nur der Rest, sonst doppelt)
const quickLinks = [
  { label: t("profile.quickDashboardLabel"), description: t("profile.quickDashboardDescription"), href: "/meine-uebersicht/", icon: LayoutDashboardIcon },
  { label: t("profile.quickInsertLabel"), description: t("profile.quickInsertDescription"), href: "/inserieren/", icon: PlusIcon, sellerOnly: true },
  { label: t("profile.quickNotificationsLabel"), description: t("profile.quickNotificationsDescription"), href: "/benachrichtigungen/", icon: BellIcon },
  { label: t("profile.quickFiltersLabel"), description: t("profile.quickFiltersDescription"), href: "/filter-einstellungen/", icon: FilterIcon },
];
const returnTo = getCurrentReturnTo(Astro.url);
const loginHref = buildLoginHref(returnTo);
const registerHref = buildRegisterHref(returnTo);
---

<BaseLayout title={t("profile.title")} description={t("profile.metaDescription")} canonicalPath="/profil/" noindex>
  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <h1 class="sr-only">{t("profile.title")}</h1>

    {/* ---------- Gast: Anmelde-Einladung mit Marken-Panel ---------- */}
    <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm" data-guest-only>
      <div class="grid lg:grid-cols-[3fr_2fr]">
        <div class="p-6 sm:p-10">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-primary">{t("profile.title")}</p>
          <h2 class="mt-2 text-2xl font-bold sm:text-3xl">{t("profile.guestTitle")}</h2>
          <p class="mt-3 max-w-md text-sm leading-6 text-muted-foreground">
            {t("profile.guestIntro")}
          </p>
          <ul class="mt-6 space-y-4 text-sm">
            <li class="flex items-start gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <HeartIcon class="size-5" aria-hidden="true" />
              </span>
              <span class="pt-0.5"><strong class="font-semibold">{t("profile.guestFavoritesTitle")}</strong><br /><span class="text-muted-foreground">{t("profile.guestFavoritesText")}</span></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <BellIcon class="size-5" aria-hidden="true" />
              </span>
              <span class="pt-0.5"><strong class="font-semibold">{t("profile.guestNotificationsTitle")}</strong><br /><span class="text-muted-foreground">{t("profile.guestNotificationsText")}</span></span>
            </li>
            <li class="flex items-start gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <HomeIcon class="size-5" aria-hidden="true" />
              </span>
              <span class="pt-0.5"><strong class="font-semibold">{t("profile.guestSellTitle")}</strong><br /><span class="text-muted-foreground">{t("profile.guestSellText")}</span></span>
            </li>
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <Button href={loginHref}>
              <LoginIcon class="size-4" aria-hidden="true" />
              {t("auth.login")}
            </Button>
            <Button href={registerHref} variant="outline">
              <UserPlusIcon class="size-4" aria-hidden="true" />
              {t("auth.registerFree")}
            </Button>
          </div>
        </div>
        {/* Markenpanel: Light hellt zum Koralle-Ton auf, Dark Rot-Schwarz (wie Identitaets-Band) */}
        <aside class="relative hidden overflow-hidden bg-[linear-gradient(160deg,#c9161c,#ee6a50)] text-white lg:grid lg:place-items-center dark:bg-[linear-gradient(160deg,#bb0916,#1a0508)]" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute -right-16 -top-10 size-[22rem] text-white/10">
            <path d="M3.5 12.5 12 5l8.5 7.5" />
            <path d="M6.5 11.5V19h11v-7.5" />
            <path d="M12 19v-4" />
          </svg>
          <p class="relative px-10 text-3xl font-extrabold uppercase tracking-tight">Heimatplatz</p>
        </aside>
      </div>
    </div>

    {/* ---------- Angemeldet: Konto-Dashboard ---------- */}
    <div class="space-y-5" data-auth-only hidden>
      {/* Identitaets-Karte mit Markenband: Light wird zur Sonne hin HELLER
          (tiefes Rot -> sonniges Koralle, bleibt in der Markenfamilie),
          Dark behaelt den Rot-Schwarz-Verlauf */}
      <div class="overflow-hidden rounded-xl border border-border bg-card shadow-sm">
        <div class="relative h-20 bg-[linear-gradient(160deg,#c9161c,#ee6a50)] sm:h-24 dark:bg-[linear-gradient(160deg,#bb0916,#1a0508)]" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute -right-6 -top-14 size-52 text-white/10">
            <path d="M3.5 12.5 12 5l8.5 7.5" />
            <path d="M6.5 11.5V19h11v-7.5" />
            <path d="M12 19v-4" />
          </svg>
        </div>
        <div class="px-5 pb-5 sm:px-6 sm:pb-6">
          <div class="-mt-10 flex items-start gap-4 sm:-mt-12">
            {/* Marken-roter Kreis mit weissen Initialen (wie Header-Avatar); der Ring
                in Kartenfarbe loest den Kreis als Cut-out vom Markenband. Auf der
                Karte uebernimmt ein weicher, nach unten versetzter Schatten die
                Abgrenzung - eine Ringfarbe kann dort nicht gleichzeitig auf Band
                und Karte sichtbar sein, ein Schatten blendet dagegen natuerlich
                aus. relative, damit der Kreis ueber dem Markenband gezeichnet wird */}
            <div class="relative grid size-20 shrink-0 place-items-center rounded-full bg-primary text-2xl font-bold text-primary-foreground ring-[3px] ring-card shadow-[0_5px_14px_-4px_rgb(0_0_0/0.4)] sm:size-24 sm:text-3xl dark:shadow-[0_6px_16px_-4px_rgb(0_0_0/0.7)]" data-auth-initials aria-hidden="true">?</div>
            {/* pt muss den -mt der Zeile plus Luft ausgleichen, damit Name/E-Mail
                komplett unterm Markenband beginnen - das Band ist positioniert und
                wuerde darueberragenden Text sonst uebermalen (abgeschnittene Zeile) */}
            <div class="min-w-0 flex-1 pt-12 sm:pt-14">
              <p class="truncate text-xl font-bold sm:text-2xl" data-auth-name>{t("profile.notLoggedIn")}</p>
              <p class="truncate text-sm text-muted-foreground" data-auth-email></p>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-muted px-3 py-1 text-xs font-semibold" data-auth-role-badge></span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-success/20 px-3 py-1 text-xs font-semibold text-success-foreground dark:bg-success/15 dark:text-success" data-email-verified-badge hidden>
                <RosetteCheckIcon class="size-3.5" aria-hidden="true" />
                {t("profile.emailVerifiedBadge")}
              </span>
            </div>
            <Button type="button" variant="outline" size="sm" data-logout>
              <LogoutIcon class="size-4" aria-hidden="true" />
              {t("profile.logout")}
            </Button>
          </div>
        </div>
      </div>

      {/* Hinweis-Banner: nur sichtbar, solange die E-Mail-Adresse unbestaetigt ist */}
      <div class="rounded-xl border border-warning bg-warning/15 p-4 sm:p-5" data-email-verification hidden>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <div class="flex min-w-0 flex-1 items-start gap-3">
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-warning/40 text-warning-foreground dark:text-warning">
              <AlertTriangleIcon class="size-5" aria-hidden="true" />
            </span>
            <div class="min-w-0">
              <h2 class="text-sm font-semibold">{t("auth.verifyTitle")}</h2>
              <p class="mt-0.5 text-sm text-muted-foreground" data-email-verification-status>{t("profile.verifyStatusLoading")}</p>
            </div>
          </div>
          <Button type="button" variant="outline" size="sm" class="shrink-0 self-start sm:self-center" data-resend-verification hidden>
            <MailCheckIcon class="size-4" aria-hidden="true" />
            {t("profile.resendVerification")}
          </Button>
        </div>
        <p class="mt-2 hidden pl-12 text-sm" role="status" data-resend-verification-status></p>
      </div>

      {/* Zaehler-Kacheln: kompakter Konto-Ueberblick mit Direkteinstieg */}
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        <a href="/favoriten/" class="flex items-center gap-3 rounded-xl border border-border bg-card px-4 py-3 shadow-sm transition-colors hover:border-primary/50">
          <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
            <HeartIcon class="size-4.5" aria-hidden="true" />
          </span>
          <span class="min-w-0">
            <span class="block text-lg font-bold leading-tight tabular-nums" data-profile-stat="favorites">–</span>
            <span class="block truncate text-xs text-muted-foreground">{t("profile.statFavorites")}</span>
          </span>
        </a>
        <a href="/blockiert/" class="flex items-center gap-3 rounded-xl border border-border bg-card px-4 py-3 shadow-sm transition-colors hover:border-primary/50">
          <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
            <ShieldOffIcon class="size-4.5" aria-hidden="true" />
          </span>
          <span class="min-w-0">
            <span class="block text-lg font-bold leading-tight tabular-nums" data-profile-stat="blocked">–</span>
            <span class="block truncate text-xs text-muted-foreground">{t("profile.statBlocked")}</span>
          </span>
        </a>
        <a href="/meine-immobilien/" class="flex items-center gap-3 rounded-xl border border-border bg-card px-4 py-3 shadow-sm transition-colors hover:border-primary/50" data-auth-role-seller hidden>
          <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
            <HomeIcon class="size-4.5" aria-hidden="true" />
          </span>
          <span class="min-w-0">
            <span class="block text-lg font-bold leading-tight tabular-nums" data-profile-stat="mine">–</span>
            <span class="block truncate text-xs text-muted-foreground">{t("profile.statMine")}</span>
          </span>
        </a>
      </div>

      <div class="grid gap-5 lg:grid-cols-3 lg:items-start">
        {/* Schnellzugriff: auf Mobil vor den Formularen, auf Desktop rechts */}
        <aside class="lg:order-2">
          <div class="rounded-xl border border-border bg-card shadow-sm">
            <div class="border-b border-border px-5 py-4">
              <h2 class="text-base font-semibold">{t("profile.quickAccessTitle")}</h2>
            </div>
            <nav class="p-2" aria-label={t("profile.quickAccessAria")}>
              {quickLinks.map((link) => {
                const Icon = link.icon;
                return (
                  <a
                    href={link.href}
                    class="group flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-accent"
                    data-auth-role-seller={link.sellerOnly ? "" : undefined}
                    hidden={link.sellerOnly ? true : undefined}
                  >
                    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                      <Icon class="size-5" aria-hidden="true" />
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-sm font-medium">{link.label}</span>
                      <span class="block truncate text-xs text-muted-foreground">{link.description}</span>
                    </span>
                    <ChevronRightIcon class="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                  </a>
                );
              })}
            </nav>
          </div>
        </aside>

        <div class="space-y-5 lg:order-1 lg:col-span-2">
          {/* Profil & Verkaeufer-Einstellungen */}
          <div class="rounded-xl border border-border bg-card shadow-sm">
            <div class="flex items-center gap-3 border-b border-border px-5 py-4 sm:px-6">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <UserIcon class="size-5" aria-hidden="true" />
              </span>
              <div>
                <h2 class="text-base font-semibold">{t("profile.sectionTitle")}</h2>
                <p class="text-xs text-muted-foreground">{t("profile.sectionSubtitle")}</p>
              </div>
            </div>
            <form class="space-y-5 px-5 py-5 sm:px-6" method="post" data-profile-form>
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                  <Label for="profileFirstName">{t("auth.firstNameLabel")}</Label>
                  <Input id="profileFirstName" name="firstName" autocomplete="given-name" required class="w-full" />
                </div>
                <div class="space-y-2">
                  <Label for="profileLastName">{t("auth.lastNameLabel")}</Label>
                  <Input id="profileLastName" name="lastName" autocomplete="family-name" required class="w-full" />
                </div>
              </div>

              <div class="space-y-2">
                <Label for="profilePhone">{t("profile.phoneLabel")}</Label>
                <Input id="profilePhone" name="phone" type="tel" inputmode="tel" maxlength="50" autocomplete="tel" placeholder={t("profile.phonePlaceholder")} class="w-full" />
                <p class="text-xs text-muted-foreground">{t("profile.phoneHint")}</p>
              </div>

              <label class="flex cursor-pointer items-center justify-between gap-3 rounded-lg border border-border bg-background/50 p-4 transition-colors has-[:checked]:border-primary/60">
                <span class="text-sm"><strong class="font-semibold">{t("profile.wantsToSellTitle")}</strong><br /><span class="text-muted-foreground">{t("profile.wantsToSellHint")}</span></span>
                <input type="checkbox" name="wantsToSell" value="yes" class="size-5 shrink-0 rounded" />
              </label>

              <fieldset class="space-y-3" data-seller-fields hidden>
                <legend class="text-sm font-semibold">{t("auth.sellerTypeLegend")}</legend>
                <div class="grid gap-3 sm:grid-cols-3">
                  <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:disabled]:cursor-default has-[:disabled]:opacity-60">
                    <span class="flex items-center gap-2">
                      <input type="radio" name="sellerType" value="Private" checked disabled />
                      <span class="font-semibold">{t("auth.sellerTypePrivate")}</span>
                    </span>
                    <span class="pl-6 text-xs text-muted-foreground">{t("auth.sellerTypePrivateHint")}</span>
                  </label>
                  <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:disabled]:cursor-default has-[:disabled]:opacity-60">
                    <span class="flex items-center gap-2">
                      <input type="radio" name="sellerType" value="Broker" disabled />
                      <span class="font-semibold">{t("auth.sellerTypeBroker")}</span>
                    </span>
                    <span class="pl-6 text-xs text-muted-foreground">{t("profile.sellerTypeBrokerHint")}</span>
                  </label>
                  <label class="flex cursor-pointer flex-col gap-1 rounded-lg border border-border p-3 text-sm transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5 has-[:disabled]:cursor-default has-[:disabled]:opacity-60">
                    <span class="flex items-center gap-2">
                      <input type="radio" name="sellerType" value="PropertyManager" disabled />
                      <span class="font-semibold">{t("auth.sellerTypeManager")}</span>
                    </span>
                    <span class="pl-6 text-xs text-muted-foreground">{t("profile.sellerTypeManagerHint")}</span>
                  </label>
                </div>
                <div class="space-y-2" data-company-field hidden>
                  <Label for="profileCompanyName">{t("auth.companyNameLabel")}</Label>
                  <Input id="profileCompanyName" name="companyName" autocomplete="organization" placeholder={t("profile.companyNamePlaceholder")} disabled class="w-full" />
                </div>
              </fieldset>

              <p class="hidden text-sm" role="status" data-form-status></p>
              <div class="flex justify-end border-t border-border pt-4">
                <Button type="submit">{t("profile.saveProfile")}</Button>
              </div>
            </form>
          </div>

          {/* Sicherheit: Passwort aendern */}
          <div class="rounded-xl border border-border bg-card shadow-sm">
            <div class="flex items-center gap-3 border-b border-border px-5 py-4 sm:px-6">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
                <LockIcon class="size-5" aria-hidden="true" />
              </span>
              <div>
                <h2 class="text-base font-semibold">{t("profile.securityTitle")}</h2>
                <p class="text-xs text-muted-foreground">{t("profile.securitySubtitle")}</p>
              </div>
            </div>
            <form class="space-y-4 px-5 py-5 sm:px-6" method="post" data-change-password-form>
              {/* Chrome und andere Passwortmanager ordnen die Aenderung ueber
                  autocomplete=username dem richtigen Konto zu. Das Script
                  befuellt den Wert aus der aktuellen Sitzung. */}
              <input
                id="changePasswordUsername"
                class="hidden"
                type="email"
                name="username"
                autocomplete="username"
                data-password-username
              />
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                  <div class="flex items-baseline justify-between gap-2">
                    <Label for="currentPassword">{t("profile.currentPasswordLabel")}</Label>
                    <a href="/passwort-vergessen/" class="text-xs font-medium text-primary hover:underline dark:text-price">{t("auth.forgotPassword")}</a>
                  </div>
                  <Input id="currentPassword" type="password" name="currentPassword" autocomplete="current-password" required class="w-full" />
                </div>
              </div>
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                  <Label for="newPassword">{t("auth.newPasswordLabel")}</Label>
                  <Input id="newPassword" type="password" name="newPassword" minlength={8} autocomplete="new-password" required class="w-full" aria-describedby="newPasswordHint" />
                  <p id="newPasswordHint" class="text-xs text-muted-foreground">{t("auth.passwordMinHint")}</p>
                </div>
                <div class="space-y-2">
                  <Label for="newPasswordConfirm">{t("auth.newPasswordConfirmLabel")}</Label>
                  <Input id="newPasswordConfirm" type="password" name="newPasswordConfirm" minlength={8} autocomplete="new-password" required class="w-full" />
                </div>
              </div>
              <p class="hidden text-sm" role="status" data-form-status></p>
              <div class="flex justify-end border-t border-border pt-4">
                <Button type="submit" variant="outline">{t("auth.changePassword")}</Button>
              </div>
            </form>
          </div>

          {/* Gefahrenzone */}
          <div class="rounded-xl border border-error/50 bg-card shadow-sm">
            <div class="px-5 py-5 sm:px-6">
              <h2 class="text-base font-semibold text-error dark:text-error">{t("profile.deleteAccount")}</h2>
              <p class="mt-1.5 text-sm text-muted-foreground">
                {t("profile.deleteAccountText")}
              </p>
              <p class="mt-3 hidden text-sm" role="status" data-delete-account-status></p>
              <div class="mt-4">
                <Button type="button" variant="outline" size="sm" class="border-error/50 text-error hover:bg-error/10 hover:text-error" data-delete-account>{t("profile.deleteAccount")}</Button>
              </div>
              {/* Zweistufige Bestaetigung statt window.confirm */}
              <div class="mt-4 rounded-lg border border-error/50 bg-error/5 p-4" data-delete-account-confirm hidden>
                <p class="text-sm font-semibold">{t("profile.deleteConfirmTitle")}</p>
                <p class="mt-1 text-sm text-muted-foreground">{t("profile.deleteConfirmText")}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <Button type="button" variant="error" size="sm" data-delete-account-confirmed>{t("profile.deleteConfirmButton")}</Button>
                  <Button type="button" variant="outline" size="sm" data-delete-account-cancel>{t("common.cancel")}</Button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
