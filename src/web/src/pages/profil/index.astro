---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/starwind/button";
---

<BaseLayout title="Mein Konto" description="Profil und Konto für Heimatplatz verwalten." canonicalPath="/profil/" noindex>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="rounded-lg border border-border bg-card p-5" data-guest-only>
      <p class="text-sm text-muted-foreground">Nicht angemeldet</p>
      <p class="mt-2 text-lg font-semibold">Melden Sie sich an, um Profil, Favoriten und Inserate zu verwalten.</p>
      <Button href="/anmelden/" variant="default" class="mt-5">Anmelden</Button>
    </div>

    <div class="mt-5 rounded-lg border border-border bg-card p-5" data-auth-only hidden>
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-4">
          <div class="grid size-16 shrink-0 place-items-center rounded-full bg-primary text-xl font-bold text-primary-foreground" data-auth-initials>?</div>
          <div>
            <p class="text-sm text-muted-foreground">Angemeldet als</p>
            <p class="mt-1 text-xl font-semibold" data-auth-name>Nicht angemeldet</p>
            <p class="mt-1 text-sm text-muted-foreground" data-auth-email></p>
            <p class="mt-3 inline-flex rounded-full bg-muted px-3 py-1 text-xs font-semibold" data-auth-role-badge></p>
          </div>
        </div>
        <Button type="button" variant="outline" data-logout>Abmelden</Button>
      </div>
    </div>

    <div class="mt-5 grid gap-4 md:grid-cols-2" data-auth-only hidden>
      <div class="rounded-lg border border-border p-5">
        <p class="text-sm text-muted-foreground">In jedem Konto enthalten</p>
        <h2 class="mt-1 text-lg font-semibold">Käufer</h2>
        <p class="mt-2 text-sm text-muted-foreground">Immobilien suchen, Favoriten speichern und Anbieter kontaktieren.</p>
      </div>
      <div class="rounded-lg border border-border p-5" data-auth-role-seller hidden>
        <p class="text-sm text-muted-foreground">Inserieren</p>
        <h2 class="mt-1 text-lg font-semibold">Verkäufer</h2>
        <p class="mt-2 text-sm text-muted-foreground">Eigene Immobilien anbieten, bearbeiten und verwalten.</p>
      </div>
    </div>

    {/* E-Mail-Bestätigung: Status + Neuversand der Verifikations-Mail */}
    <div class="mt-5 rounded-lg border border-border bg-card p-5" data-auth-only data-email-verification hidden>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold">E-Mail-Bestätigung</h2>
          <p class="mt-1 text-sm text-muted-foreground" data-email-verification-status>Status wird geladen...</p>
        </div>
        <Button type="button" variant="outline" data-resend-verification hidden>Bestätigungs-E-Mail erneut senden</Button>
      </div>
      <p class="mt-3 hidden text-sm" data-resend-verification-status></p>
    </div>

    {/* Profil bearbeiten: Namen und Verkäufer-Einstellungen (nachträglich änderbar) */}
    <div class="mt-8 rounded-lg border border-border bg-card p-5" data-auth-only hidden>
      <h2 class="text-lg font-semibold">Profil &amp; Verkäufer-Einstellungen</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Sie können jederzeit Verkäufer werden, den Anbietertyp wechseln oder das Anbieten wieder deaktivieren.
        Bestehende Inserate behalten ihre bisherigen Anbieter-Angaben.
      </p>
      <form class="mt-5 space-y-4" method="post" data-profile-form>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="space-y-2">
            <label class="text-sm font-medium" for="profileFirstName">Vorname</label>
            <input class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" id="profileFirstName" name="firstName" required />
          </div>
          <div class="space-y-2">
            <label class="text-sm font-medium" for="profileLastName">Nachname</label>
            <input class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" id="profileLastName" name="lastName" required />
          </div>
        </div>
        <label class="flex gap-3 rounded-md border border-border p-3 text-sm">
          <input type="checkbox" name="wantsToSell" value="yes" />
          <span><strong>Ich möchte Immobilien anbieten</strong></span>
        </label>
        <fieldset class="space-y-2" data-seller-fields hidden>
          <legend class="text-sm font-semibold">Anbietertyp</legend>
          <label class="flex gap-3 rounded-md border border-border p-3 text-sm">
            <input type="radio" name="sellerType" value="Private" checked disabled />
            <span>Privatperson</span>
          </label>
          <label class="flex gap-3 rounded-md border border-border p-3 text-sm">
            <input type="radio" name="sellerType" value="Broker" disabled />
            <span>Makler</span>
          </label>
          <label class="flex gap-3 rounded-md border border-border p-3 text-sm">
            <input type="radio" name="sellerType" value="PropertyManager" disabled />
            <span>Hausverwaltung</span>
          </label>
          <div class="space-y-2" data-company-field hidden>
            <label class="text-sm font-medium" for="profileCompanyName">Firmenname</label>
            <input class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" id="profileCompanyName" name="companyName" disabled />
          </div>
        </fieldset>
        <p class="hidden text-sm" data-form-status></p>
        <Button type="submit">Profil speichern</Button>
      </form>
    </div>

    {/* Passwort ändern: widerruft alle anderen Sitzungen */}
    <div class="mt-8 rounded-lg border border-border bg-card p-5" data-auth-only hidden>
      <h2 class="text-lg font-semibold">Passwort ändern</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Nach der Änderung werden alle anderen angemeldeten Geräte abgemeldet.
      </p>
      <form class="mt-5 max-w-md space-y-4" method="post" data-change-password-form>
        <div class="space-y-2">
          <label class="text-sm font-medium" for="currentPassword">Aktuelles Passwort</label>
          <input class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" id="currentPassword" type="password" name="currentPassword" autocomplete="current-password" required />
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium" for="newPassword">Neues Passwort</label>
          <input class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" id="newPassword" type="password" name="newPassword" minlength="8" autocomplete="new-password" required />
        </div>
        <div class="space-y-2">
          <label class="text-sm font-medium" for="newPasswordConfirm">Neues Passwort bestätigen</label>
          <input class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm" id="newPasswordConfirm" type="password" name="newPasswordConfirm" minlength="8" autocomplete="new-password" required />
        </div>
        <p class="hidden text-sm" data-form-status></p>
        <Button type="submit">Passwort ändern</Button>
      </form>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <a class="rounded-lg border border-border bg-card p-5 font-medium transition-colors hover:border-primary/50 hover:bg-accent" href="/favoriten/">Favoriten</a>
      <a class="rounded-lg border border-border bg-card p-5 font-medium transition-colors hover:border-primary/50 hover:bg-accent" href="/meine-immobilien/">Meine Immobilien</a>
      <a class="rounded-lg border border-border bg-card p-5 font-medium transition-colors hover:border-primary/50 hover:bg-accent" href="/benachrichtigungen/">Benachrichtigungen</a>
    </div>

    <div class="mt-8 rounded-lg border border-error/40 bg-card p-5" data-auth-only hidden>
      <h2 class="text-lg font-semibold text-error">Konto löschen</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        Wenn Sie Ihr Konto löschen, werden Ihr Profil, Ihre Inserate, Favoriten, Blockierungen und
        Benachrichtigungs-Einstellungen unwiderruflich entfernt. Diese Aktion kann nicht rückgängig gemacht werden.
      </p>
      <p class="mt-3 hidden text-sm" data-delete-account-status></p>
      <Button type="button" variant="error" class="mt-4" data-delete-account>Konto löschen</Button>
    </div>
  </section>
</BaseLayout>
