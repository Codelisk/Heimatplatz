---
import ArrowRightIcon from "@tabler/icons/outline/arrow-right.svg";
import ExternalLinkIcon from "@tabler/icons/outline/external-link.svg";
import BrandMark from "@/components/layout/BrandMark.astro";
import {
  fetchPartners,
  PARTNER_CATEGORY_DATA_SOURCE,
} from "@/features/partners/api";
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { breadcrumbSchema } from "@/lib/seo";

// Design laut docs/partner-seite-konzept.md, Blue-Ocean-Fassung (Kundenwunsch 4.8.):
// redaktionelles Partnerverzeichnis im Regionalblatt-Stil, kraftvoll gesetzt -
// grosse rote Verzeichnisnummern, Live-Inseratszahl als Ticker-Zahl am Eintrag,
// Rubrik als schwarzer Balken. Vertrauen kommt aus nachpruefbaren Fakten
// (Live-Zahlen, Stand-Datum) statt aus Effekten; einzige Animation sind Link-Hovers.

const partners = await fetchPartners();
const listingsTotal = partners.reduce((sum, partner) => sum + partner.activeListingCount, 0);

const categoryLabel = (category: string) =>
  category === PARTNER_CATEGORY_DATA_SOURCE
    ? t("partner.categoryDataSource")
    : t("partner.categoryBroker");

// Meta-Zeile: Kategorie (rot) · Region · seit Jahr - alles Kleinkapitale
const metaFor = (partner: (typeof partners)[number]) =>
  [partner.region, partner.partnerSinceYear ? t("partner.metaSince", { year: partner.partnerSinceYear }) : null]
    .filter(Boolean)
    .join(" · ");

// Stand-Datum der Datumszeile: Render-Zeitpunkt, die Zahlen dahinter kommen live
const standDatum = new Intl.DateTimeFormat("de-AT", {
  dateStyle: "long",
  timeZone: "Europe/Vienna",
}).format(new Date());

const pageUrl = new URL("/partner/", Astro.site).toString();

const structuredData = [
  breadcrumbSchema([
    { name: "Heimatplatz", url: new URL("/", Astro.site).toString() },
    { name: t("partner.title"), url: pageUrl },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: t("partner.title"),
    itemListElement: partners.map((partner, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Organization",
        name: partner.name,
        ...(partner.websiteUrl ? { url: partner.websiteUrl } : {}),
        ...(partner.logoUrl ? { logo: partner.logoUrl } : {}),
        ...(partner.description ? { description: partner.description } : {}),
      },
    })),
  },
];
---

<BaseLayout
  title={t("partner.metaTitle")}
  description={t("partner.metaDescription")}
  canonicalPath="/partner/"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    {/* Titelkopf im Regionalblatt-Stil: dicke + duenne Linie, Wappen als Krone,
        grosser Titel (fluide Groesse - "Partnerverzeichnis" darf am Handy nicht
        ueberlaufen), kraeftige Datumszeile mit den nachpruefbaren Eckdaten */}
    <header>
      <div class="border-t-2 border-foreground"></div>
      <div class="mt-[3px] border-t border-foreground"></div>

      <BrandMark class="mx-auto mt-8 h-14 sm:h-16" />

      <p class="mt-5 text-center text-[11px] font-bold uppercase tracking-[0.22em] text-primary sm:text-xs">
        {t("partner.kicker")}
      </p>
      <h1 class="mx-auto mt-2 text-center text-[clamp(2.2rem,9.5vw,4.4rem)] font-extrabold leading-none tracking-tight">
        {t("partner.title")}
      </h1>

      <div class="mt-7 border-y-2 border-foreground py-2">
        <p class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-center text-[10px] font-bold uppercase tracking-[0.14em] sm:justify-between sm:text-[11px]">
          <span>{t("partner.datelineStand", { date: standDatum })}</span>
          <span class="hidden text-muted-foreground sm:inline">{t("partner.datelineRegion")}</span>
          <span>
            {t("partner.datelinePartners", { count: partners.length })}
            {listingsTotal === 1 && ` · ${t("partner.datelineListingsOne")}`}
            {listingsTotal > 1 && ` · ${t("partner.datelineListings", { count: listingsTotal })}`}
          </span>
        </p>
      </div>

      {/* Lead mit Initiale - redaktioneller Auftakt statt Hero-Flaeche */}
      <p class="lead mx-auto mt-9 max-w-prose text-base leading-7 sm:text-lg sm:leading-8">
        {t("partner.lead")}
      </p>
    </header>

    {/* Verzeichnis: grosse rote Nummern, Live-Inseratszahl als Ticker-Zahl -
        Fakten statt Kartenschmuck */}
    <section class="mt-12" aria-labelledby="verzeichnis">
      <div class="flex items-end justify-between gap-4 border-b-2 border-foreground">
        <h2
          id="verzeichnis"
          class="inline-block bg-foreground px-3 py-1.5 text-xs font-bold uppercase tracking-[0.22em] text-background"
        >
          {t("partner.directoryHeading")}
        </h2>
        <span class="hidden pb-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-muted-foreground sm:inline">
          {t("partner.directoryColumn")}
        </span>
      </div>

      {
        partners.length === 0 && (
          <p class="mt-8 max-w-prose text-base leading-7 text-muted-foreground">
            {t("partner.emptyDirectory")}
          </p>
        )
      }

      <ol class="divide-y divide-border">
        {
          partners.map((partner, index) => (
            <li class="grid grid-cols-[minmax(2.9rem,auto)_minmax(0,1fr)] gap-x-4 py-10 sm:grid-cols-[minmax(4rem,auto)_minmax(0,1fr)] sm:gap-x-6">
              <span
                class="mt-0.5 font-mono text-[2rem] font-extrabold leading-none tracking-tighter text-primary sm:text-[2.6rem]"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
                  <div class="min-w-0 flex-1 basis-56">
                    <h3 class="text-[1.65rem] font-extrabold leading-tight tracking-tight sm:text-3xl">
                      {partner.name}
                    </h3>
                    <p class="mt-2 text-[10px] font-bold uppercase tracking-[0.16em] sm:text-[11px]">
                      <span class="text-primary">{categoryLabel(partner.category)}</span>
                      {metaFor(partner) && (
                        <span class="font-semibold text-muted-foreground"> · {metaFor(partner)}</span>
                      )}
                    </p>
                  </div>

                  {/* Ticker-Zahl: die Live-Inseratszahl als groesster Wert des Eintrags */}
                  {(partner.activeListingCount > 0 || partner.logoUrl) && (
                    <div class="flex shrink-0 flex-col items-end gap-3">
                      {partner.activeListingCount > 0 && (
                        <span class="text-right">
                          <span class="block text-[2.4rem] font-extrabold leading-none tracking-tight tabular-nums text-primary sm:text-5xl">
                            {partner.activeListingCount}
                          </span>
                          <span class="mt-1 block text-[9px] font-bold uppercase tracking-[0.16em] text-muted-foreground sm:text-[10px]">
                            {partner.activeListingCount === 1
                              ? t("partner.statListingsLabelOne")
                              : t("partner.statListingsLabel")}
                          </span>
                        </span>
                      )}
                      {/* Logo im Kontext des Eintrags; bleibt auch im Dark Mode
                          auf hellem Feld - Logos nie invertieren */}
                      {partner.logoUrl && (
                        <img
                          src={partner.logoUrl}
                          alt={t("partner.logoAlt", { name: partner.name })}
                          class="h-10 max-w-32 rounded-sm border border-border bg-white object-contain p-1"
                          loading="lazy"
                        />
                      )}
                    </div>
                  )}
                </div>

                {partner.description && (
                  <p class="mt-4 max-w-prose text-[0.95rem] leading-7 text-muted-foreground">
                    {partner.description}
                  </p>
                )}

                <p class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-[0.9rem]">
                  {partner.activeListingCount > 0 && (
                    <a
                      href={`/?q=${encodeURIComponent(partner.sellerName || partner.name)}`}
                      class="group inline-flex items-center gap-1.5 font-extrabold text-primary underline-offset-4 hover:underline"
                    >
                      {t("partner.viewListings")}
                      <ArrowRightIcon class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                    </a>
                  )}
                  {partner.websiteUrl && (
                    <a
                      href={partner.websiteUrl}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 font-semibold text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
                    >
                      {t("partner.websiteLink")}
                      <ExternalLinkIcon class="size-4" aria-hidden="true" />
                    </a>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* CTA als klassische Zeitungsanzeige: doppelter Rahmen, "Anzeige in eigener Sache" */}
    <aside class="mt-10 border-[3px] border-foreground p-1" aria-labelledby="anzeige">
      <div class="border border-foreground px-6 py-10 text-center sm:px-10 sm:py-12">
        <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-primary">
          {t("partner.adKicker")}
        </p>
        <h2 id="anzeige" class="mx-auto mt-3 max-w-xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
          {t("partner.adTitle")}
        </h2>
        <p class="mx-auto mt-4 max-w-md text-sm leading-6 text-muted-foreground sm:text-[0.95rem] sm:leading-7">
          {t("partner.adText")}
        </p>
        <a
          href="/makler/"
          class="group mt-7 inline-flex items-center gap-2 rounded-md bg-primary px-8 py-3.5 text-base font-extrabold text-primary-foreground transition-colors hover:bg-primary-accent"
        >
          {t("partner.adButton")}
          <ArrowRightIcon class="size-5 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>
      </div>
    </aside>

    {/* Fussnote traegt die Edikte-Transparenz (frueher Teil der entfallenen Erklaerung) */}
    <p class="mt-8 text-xs leading-5 text-muted-foreground">
      {t("partner.footnote")}
    </p>

    {/* Schlusslinie spiegelt den Titelkopf */}
    <div class="mt-6 border-t border-foreground"></div>
    <div class="mt-[3px] border-t-2 border-foreground"></div>
  </div>
</BaseLayout>

<style>
  /* Initiale im Lead: klassisches Zeitungs-Stilmittel */
  .lead::first-letter {
    float: left;
    margin-right: 0.5rem;
    font-size: 3.4em;
    line-height: 0.85;
    font-weight: 800;
    color: var(--primary);
  }
</style>
