---
import ArrowRightIcon from "@tabler/icons/outline/arrow-right.svg";
import ExternalLinkIcon from "@tabler/icons/outline/external-link.svg";
import {
  fetchPartners,
  PARTNER_CATEGORY_DATA_SOURCE,
} from "@/features/partners/api";
import { t } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { breadcrumbSchema } from "@/lib/seo";

// Design laut docs/partner-seite-konzept.md, Blue-Ocean-Fassung (Kundenwunsch 4.8.):
// KEIN Karten-Grid, KEINE Logo-Wand, KEINE Effekt-Gimmicks - stattdessen ein
// redaktionelles Partnerverzeichnis im Regionalblatt-Stil. Vertrauen kommt aus
// nachpruefbaren Fakten (Live-Zahlen mit Stand-Datum, OpenImmo-Automatik) statt
// aus Animationen; Rot bleibt reine Signalfarbe (NN/g: communicating trustworthiness).

const partners = await fetchPartners();
const listingsTotal = partners.reduce((sum, partner) => sum + partner.activeListingCount, 0);

const categoryLabel = (category: string) =>
  category === PARTNER_CATEGORY_DATA_SOURCE
    ? t("partner.categoryDataSource")
    : t("partner.categoryBroker");

// Faktenzeile je Eintrag: nur belegbare Angaben, leere Felder fallen einfach weg;
// die Live-Inseratszahl ist der einzige hervorgehobene Wert (Signalfarbe)
type Fact = { text: string; highlight?: boolean };
const factsFor = (partner: (typeof partners)[number]): Fact[] =>
  [
    partner.partnerSinceYear
      ? { text: t("partner.factSince", { year: partner.partnerSinceYear }) }
      : null,
    partner.sourceName ? { text: t("partner.factAutoImport") } : null,
    partner.activeListingCount === 1
      ? { text: t("partner.factListingsOne"), highlight: true }
      : partner.activeListingCount > 1
        ? { text: t("partner.factListings", { count: partner.activeListingCount }), highlight: true }
        : null,
  ].filter((fact): fact is Fact => Boolean(fact));

// Stand-Datum der Datumszeile: Render-Zeitpunkt, die Zahlen dahinter kommen live
const standDatum = new Intl.DateTimeFormat("de-AT", {
  dateStyle: "long",
  timeZone: "Europe/Vienna",
}).format(new Date());

const pageUrl = new URL("/partner/", Astro.site).toString();

const structuredData = [
  breadcrumbSchema([
    { name: "Heimatplatz", url: new URL("/", Astro.site).toString() },
    { name: t("partner.title"), url: pageUrl },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: t("partner.title"),
    itemListElement: partners.map((partner, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Organization",
        name: partner.name,
        ...(partner.websiteUrl ? { url: partner.websiteUrl } : {}),
        ...(partner.logoUrl ? { logo: partner.logoUrl } : {}),
        ...(partner.description ? { description: partner.description } : {}),
      },
    })),
  },
];
---

<BaseLayout
  title={t("partner.metaTitle")}
  description={t("partner.metaDescription")}
  canonicalPath="/partner/"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    {/* Masthead im Regionalblatt-Stil: dicke + duenne Linie, zentrierter Titelkopf,
        Datumszeile mit den nachpruefbaren Eckdaten */}
    <header>
      <div class="border-t-2 border-foreground"></div>
      <div class="mt-[3px] border-t border-foreground"></div>

      <p class="mt-6 text-center text-xs font-bold uppercase tracking-[0.22em] text-primary">
        {t("partner.kicker")}
      </p>
      <h1 class="mt-3 text-center text-5xl font-extrabold tracking-tight sm:text-6xl">
        {t("partner.title")}
      </h1>

      <div class="mt-6 border-y border-foreground/60 py-2">
        <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground sm:justify-between">
          <span>{t("partner.datelineStand", { date: standDatum })}</span>
          <span class="hidden sm:inline">{t("partner.datelineRegion")}</span>
          <span>
            {t("partner.datelinePartners", { count: partners.length })}
            {listingsTotal === 1 && ` · ${t("partner.datelineListingsOne")}`}
            {listingsTotal > 1 && ` · ${t("partner.datelineListings", { count: listingsTotal })}`}
          </span>
        </p>
      </div>

      {/* Lead mit Initiale - redaktioneller Auftakt statt Hero-Flaeche */}
      <p class="lead mx-auto mt-8 max-w-prose text-base leading-7 sm:text-lg sm:leading-8">
        {t("partner.lead")}
      </p>
    </header>

    {/* Verzeichnis: nummerierte Eintraege mit Haarlinien - Fakten statt Kartenschmuck */}
    <section class="mt-14" aria-labelledby="verzeichnis">
      <h2
        id="verzeichnis"
        class="border-b-2 border-foreground pb-2 text-xs font-bold uppercase tracking-[0.22em]"
      >
        {t("partner.directoryHeading")}
      </h2>

      {
        partners.length === 0 && (
          <p class="mt-8 max-w-prose text-base leading-7 text-muted-foreground">
            {t("partner.emptyDirectory")}
          </p>
        )
      }

      <ol class="divide-y divide-border">
        {
          partners.map((partner, index) => (
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 py-9 sm:gap-x-7">
              <span class="pt-1 font-mono text-sm font-bold tabular-nums text-primary" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div>
                <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
                  <div class="min-w-0">
                    <h3 class="text-2xl font-extrabold tracking-tight">{partner.name}</h3>
                    <p class="mt-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-muted-foreground">
                      {categoryLabel(partner.category)}
                      {partner.region && ` · ${partner.region}`}
                    </p>
                  </div>
                  {/* Logo im Kontext des Eintrags statt in einer Logo-Wand; bleibt
                      auch im Dark Mode auf hellem Feld - Logos nie invertieren */}
                  {partner.logoUrl && (
                    <img
                      src={partner.logoUrl}
                      alt={t("partner.logoAlt", { name: partner.name })}
                      class="h-10 max-w-32 shrink-0 rounded border border-border bg-white object-contain p-1"
                      loading="lazy"
                    />
                  )}
                </div>

                {partner.description && (
                  <p class="mt-3 max-w-prose text-base leading-7 text-muted-foreground">
                    {partner.description}
                  </p>
                )}

                {factsFor(partner).length > 0 && (
                  <p class="mt-4 text-sm font-medium">
                    {factsFor(partner).map((fact, factIndex) => (
                      <>
                        {factIndex > 0 && <span class="text-muted-foreground"> · </span>}
                        <span class={fact.highlight ? "font-bold text-primary" : ""}>{fact.text}</span>
                      </>
                    ))}
                  </p>
                )}

                <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-bold">
                  {partner.activeListingCount > 0 && (
                    <a
                      href={`/?q=${encodeURIComponent(partner.sellerName || partner.name)}`}
                      class="group inline-flex items-center gap-1.5 text-primary underline-offset-4 hover:underline"
                    >
                      {t("partner.viewListings")}
                      <ArrowRightIcon class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
                    </a>
                  )}
                  {partner.websiteUrl && (
                    <a
                      href={partner.websiteUrl}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-center gap-1 font-semibold text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
                    >
                      {t("partner.websiteLink")}
                      <ExternalLinkIcon class="size-4" aria-hidden="true" />
                    </a>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* Partnerschafts-Erklaerung: drei ueberpruefbare Zusagen statt Marketing-Floskeln;
        Punkt 3 traegt die Edikte-Transparenz gleich mit */}
    <section class="mt-14" aria-labelledby="erklaerung">
      <h2
        id="erklaerung"
        class="border-b-2 border-foreground pb-2 text-xs font-bold uppercase tracking-[0.22em]"
      >
        {t("partner.charterHeading")}
      </h2>
      <ol class="divide-y divide-border">
        {
          [
            { title: t("partner.charter1Title"), text: t("partner.charter1Text") },
            { title: t("partner.charter2Title"), text: t("partner.charter2Text") },
            { title: t("partner.charter3Title"), text: t("partner.charter3Text") },
          ].map((item, index) => (
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 py-6 sm:gap-x-7">
              <span class="pt-0.5 font-mono text-sm font-bold tabular-nums text-primary" aria-hidden="true">
                §{index + 1}
              </span>
              <div>
                <h3 class="text-base font-extrabold">{item.title}</h3>
                <p class="mt-1 max-w-prose text-sm leading-6 text-muted-foreground">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* CTA als klassische Zeitungsanzeige: doppelter Rahmen, "Anzeige in eigener Sache" */}
    <aside class="mt-14 border-[3px] border-foreground p-1" aria-labelledby="anzeige">
      <div class="border border-foreground px-6 py-9 text-center sm:px-10">
        <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-muted-foreground">
          {t("partner.adKicker")}
        </p>
        <h2 id="anzeige" class="mt-3 text-2xl font-extrabold tracking-tight sm:text-3xl">
          {t("partner.adTitle")}
        </h2>
        <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-muted-foreground">
          {t("partner.adText")}
        </p>
        <a
          href="/makler/"
          class="group mt-6 inline-flex items-center gap-2 rounded-md bg-primary px-6 py-3 text-sm font-bold text-primary-foreground transition-colors hover:bg-primary-accent"
        >
          {t("partner.adButton")}
          <ArrowRightIcon class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>
      </div>
    </aside>

    {/* Schlusslinie spiegelt den Masthead */}
    <div class="mt-14 border-t border-foreground"></div>
    <div class="mt-[3px] border-t-2 border-foreground"></div>
  </div>
</BaseLayout>

<style>
  /* Initiale im Lead: klassisches Zeitungs-Stilmittel, das einzige "Schmuck"-Element */
  .lead::first-letter {
    float: left;
    margin-right: 0.5rem;
    font-size: 3.4em;
    line-height: 0.85;
    font-weight: 800;
    color: var(--primary);
  }
</style>
