---
import ArrowLeftIcon from "@tabler/icons/outline/arrow-left.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PropertyWysiwygForm from "@/components/properties/PropertyWysiwygForm.astro";
---

<BaseLayout
  title="Immobilie bearbeiten"
  description="Eigene Immobilie in Oberösterreich bearbeiten."
  canonicalPath="/immobilien/bearbeiten/"
  noindex
>
  <article class="bg-background pb-16">
    <header class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
      <h1 class="sr-only">Immobilie bearbeiten</h1>
      <a href="/meine-immobilien/" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
        <ArrowLeftIcon class="size-4" aria-hidden="true" />
        Zurück
      </a>
    </header>
    <PropertyWysiwygForm editMode />
  </article>
</BaseLayout>
