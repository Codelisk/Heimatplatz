---
import ArrowLeftIcon from "@tabler/icons/outline/arrow-left.svg";
import ChevronRightIcon from "@tabler/icons/outline/chevron-right.svg";
import CopyIcon from "@tabler/icons/outline/copy.svg";
import ExternalLinkIcon from "@tabler/icons/outline/external-link.svg";
import EyeOffIcon from "@tabler/icons/outline/eye-off.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import ShareIcon from "@tabler/icons/outline/share.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactDock from "@/components/properties/ContactDock.astro";
import ImageGallery from "@/components/properties/ImageGallery.astro";
import PropertyLocationMap from "@/components/properties/PropertyLocationMap.astro";
import { Button } from "@/components/starwind/button";
import {
  fetchApiPropertyById,
  fetchApiPropertyMapPin,
  formatApiDate,
  formatApiPriceLong,
  getApiAreaLabel,
  getApiPropertyJsonLd,
  getApiPropertyPath,
  getApiPropertyTypeLabel,
  getApiSellerLabel,
  getApiPropertyImage,
  getApiPropertyImages,
  isCourtForeclosure,
  type ApiContact,
} from "@/features/properties/live-api";
import { getApiPriceFact, getApiPropertyDetailSections } from "@/features/properties/detail-sections";
import { getDisplayTitle } from "@/features/properties/format";
import { t } from "@/i18n";
import { breadcrumbSchema } from "@/lib/seo";

// SSR: Immobilie pro Request laden - neue Inserate sind sofort erreichbar,
// entfernte liefern 404 (rendert src/pages/404.astro).
const { id } = Astro.params;
const property = id ? await fetchApiPropertyById(id) : null;

if (!property) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
const canonicalPath = getApiPropertyPath(property);
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
// Viele Titel enthalten den Ort bereits ("... in Pettenbach") - nicht doppelt anhaengen
const pageTitle = property.Title.includes(property.City)
  ? property.Title
  : t("detail.metaTitle", { title: property.Title, city: property.City });
const imageUrl = getApiPropertyImage(property);
const images = getApiPropertyImages(property);
const description = property.Description?.trim() ?? "";
// Zwangsversteigerungen: Price ist Mindestgebot/Schaetzwert, die Kernfelder tragen
// Edikt-Semantik (LivingAreaM2 = bebaute Flaeche, PlotAreaM2 = Gesamtflaeche).
const priceFact = getApiPriceFact(property);
const isForeclosure = property.Type === "Foreclosure";
// Kacheln ohne Wert ausblenden (WEB-043): "Wohnflaeche - Keine Angabe" bei einem
// Grundstueck wirkt wie unvollstaendige Datenerfassung statt wie ein anderer Typ
const factCandidates: ([string, string] | null)[] = isForeclosure
  ? [
      [priceFact.label, priceFact.value],
      property.PlotAreaM2 ? [t("detail.factArea"), `${property.PlotAreaM2} m²`] : null,
      property.LivingAreaM2 ? [t("detail.factBuiltArea"), `${property.LivingAreaM2} m²`] : null,
      property.Rooms ? [t("detail.factRooms"), `${property.Rooms}`] : null,
    ]
  : [
      [t("detail.factPrice"), formatApiPriceLong(property.Price)],
      property.LivingAreaM2 ? [t("detail.factLivingArea"), `${property.LivingAreaM2} m²`] : null,
      property.PlotAreaM2 ? [t("detail.factPlot"), `${property.PlotAreaM2} m²`] : null,
      property.Rooms ? [t("detail.factRooms"), `${property.Rooms}`] : null,
    ];
const facts = factCandidates.filter((fact): fact is [string, string] => fact !== null);
const priceText = isForeclosure ? `${priceFact.label} ${priceFact.value}` : formatApiPriceLong(property.Price);
// "Gericht" nur fuer aus dem Edikte-Sync importierte ZV - privat erstellte
// Zwangsversteigerungen behalten die echte Anbieterrolle (WEB-016)
const courtForeclosure = isForeclosure && isCourtForeclosure(property);
const sellerRoleLabel = courtForeclosure ? t("detail.sellerCourt") : getApiSellerLabel(property.SellerType);
// SourceName ist nur als echte Fremdquelle eine Info; "Heimatplatz" (unser eigenes Portal) sagt dem Nutzer nichts.
const externalSource = property.SourceName && property.SourceName !== "Heimatplatz" ? property.SourceName : null;
const sellerMeta = [sellerRoleLabel, externalSource].filter(Boolean).join(" · ");
const features = property.Features?.length
  ? property.Features
  : [getApiPropertyTypeLabel(property.Type), property.City, getApiAreaLabel(property)].filter(Boolean);
// Mini-Karte "Lage & Umgebung": Pin kommt vom map-pins-Endpoint (serverseitiger
// Privacy-Jitter fuer ungenaue Lagen); ohne Koordinaten entfaellt die Section.
const mapPin = await fetchApiPropertyMapPin(property.Id);
const contactCards: ApiContact[] = property.Contacts?.length
  ? property.Contacts
  : [{ Name: property.SellerName, SourceName: property.SourceName, Email: null, Phone: null }];
const originalUrl = contactCards.find((contact) => contact.OriginalListingUrl)?.OriginalListingUrl;
const primaryEmail = contactCards.find((contact) => contact.Email)?.Email;
const primaryPhone = contactCards.find((contact) => contact.Phone)?.Phone;
const detailSections = getApiPropertyDetailSections(property);
---

<BaseLayout
  title={pageTitle}
  description={t("detail.metaDescription", {
    title: property.Title,
    postalCode: property.PostalCode,
    city: property.City,
    price: priceText,
    area: getApiAreaLabel(property),
  })}
  canonicalPath={canonicalPath}
  image={imageUrl}
  structuredData={[
    breadcrumbSchema([
      { name: "Heimatplatz", url: new URL("/", Astro.site).toString() },
      { name: property.Title, url: canonicalUrl },
    ]),
    getApiPropertyJsonLd(property, canonicalUrl, imageUrl),
  ]}
>
  <article class="bg-background pb-28 lg:pb-10">
    <header class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
        <ArrowLeftIcon class="size-4" aria-hidden="true" />
        {t("common.back")}
      </a>
    </header>

    {/* grid-cols-[minmax(0,1fr)] auch unterhalb lg: sonst sprengt die intrinsische
        Bildbreite die implizite Spalte und die Seite wird breiter als der Viewport */}
    <section class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-8 px-4 pb-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:px-8">
      <div>
        <div class="relative">
          <ImageGallery images={images} title={property.Title} />
          {/* right-40 laesst Platz fuer die drei Action-Buttons, sonst ueberlappen die Badges */}
          <div class="pointer-events-none absolute left-4 right-40 top-4 z-10 flex flex-wrap gap-2" data-photo-badges>
            <span
              class:list={[
                "rounded-full px-3 py-1.5 text-xs font-bold",
                property.Type === "Foreclosure"
                  ? "bg-brand text-brand-foreground"
                  : property.Type === "Land"
                    ? "bg-type-grund text-white"
                    : property.Type === "House"
                      ? "bg-type-haus text-white"
                      : "bg-foreground text-background",
              ]}
            >{getApiPropertyTypeLabel(property.Type)}</span>
            <span class="rounded-full bg-background/90 px-3 py-1.5 text-xs font-bold text-foreground">{property.City}</span>
          </div>
          <div class="pointer-events-none absolute right-4 top-4 z-10 flex gap-2">
            <button
              class="pointer-events-auto grid size-10 place-items-center rounded-full bg-black/60 text-white"
              type="button"
              aria-label={t("detail.actionFavorite")}
              aria-pressed="false"
              data-property-action="favorite"
              data-property-slug={property.Id}
              data-property-id={property.Id}
            >
              <HeartIcon class="size-5" aria-hidden="true" />
            </button>
            <button
              class="pointer-events-auto grid size-10 place-items-center rounded-full bg-black/60 text-white"
              type="button"
              aria-label={t("detail.actionBlock")}
              aria-pressed="false"
              data-property-action="block"
              data-property-slug={property.Id}
              data-property-id={property.Id}
            >
              <EyeOffIcon class="size-5" aria-hidden="true" />
            </button>
            <button
              class="pointer-events-auto grid size-10 place-items-center rounded-full bg-black/60 text-white"
              type="button"
              aria-label={t("detail.actionShare")}
              data-share-url={canonicalUrl}
              data-share-title={property.Title}
            >
              <ShareIcon class="size-5" aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="mt-6">
          <p class="text-sm font-semibold text-muted-foreground">{property.PostalCode} {property.City} · {property.Address}</p>
          <h1 class="mt-3 max-w-3xl break-words text-3xl font-bold leading-tight sm:text-4xl">{getDisplayTitle(property.Title)}</h1>
        </div>

        <dl class="mt-6 grid gap-3 sm:grid-cols-4">
          {facts.map(([label, value]) => (
            <div class="rounded-lg border border-border bg-card p-4">
              <dt class="text-sm text-muted-foreground">{label}</dt>
              <dd class:list={["mt-1 text-xl font-bold", label === priceFact.label && "text-price"]}>{value}</dd>
            </div>
          ))}
        </dl>

        {detailSections.length > 0 && (
          <section class="mt-8" aria-labelledby="api-details">
            <h2 id="api-details" class="text-sm font-bold uppercase text-muted-foreground">{t("detail.sectionDetails")}</h2>
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              {detailSections.map((section) => (
                <section class="rounded-lg border border-border bg-card p-4" aria-label={section.title}>
                  <h3 class="text-xs font-bold uppercase text-muted-foreground">{section.title}</h3>
                  <dl class="mt-3 divide-y divide-border">
                    {section.items.map((item) => (
                      <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-3 py-2 text-sm">
                        <dt class="text-muted-foreground">{item.label}</dt>
                        <dd class="max-w-44 text-right font-medium">
                          {item.href ? (
                            <a href={item.href} target="_blank" rel="nofollow noopener" class="underline underline-offset-4 hover:text-foreground">{item.value}</a>
                          ) : (
                            item.value
                          )}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </section>
              ))}
            </div>
          </section>
        )}

        <section class="mt-8" aria-labelledby="api-features">
          <h2 id="api-features" class="text-sm font-bold uppercase text-muted-foreground">{t("detail.sectionFeaturesHeading")}</h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {features.map((feature) => <li class="rounded-md bg-muted px-4 py-3 text-sm">{feature}</li>)}
          </ul>
        </section>

        {description && (
          <section class="mt-8" aria-labelledby="api-description">
            <h2 id="api-description" class="text-sm font-bold uppercase text-muted-foreground">{t("detail.sectionDescription")}</h2>
            <p class="mt-4 max-w-3xl text-base leading-7">{description}</p>
          </section>
        )}

        {mapPin && <PropertyLocationMap pin={mapPin} />}
      </div>

      <aside class="self-start rounded-lg border border-border bg-card p-5 shadow-sm lg:sticky lg:top-20">
        <p class="text-sm text-muted-foreground">{courtForeclosure ? t("detail.sellerCourt") : t("detail.sellerProvider")}</p>
        <h2 class="mt-1 text-xl font-bold">{property.SellerName}</h2>
        {!courtForeclosure && sellerMeta && (
          <p class="mt-2 text-sm text-muted-foreground">{sellerMeta}</p>
        )}
        <p class="mt-2 text-sm text-muted-foreground">{t("detail.updatedAt", { value: formatApiDate(property.CreatedAt) || t("detail.liveOffer") })}</p>
        <div class="mt-5 space-y-3">
          {contactCards.map((contact) => (
            <div class="rounded-md bg-muted p-3 text-sm">
              <p class="font-semibold">{contact.Name || contact.SourceName || property.SellerName}</p>
              {contact.Email && (
                <div class="mt-1 flex items-center justify-between gap-2">
                  <a class="min-w-0 truncate text-muted-foreground hover:text-foreground" href={`mailto:${contact.Email}`}>{contact.Email}</a>
                  <button
                    class="inline-flex h-8 shrink-0 items-center gap-1 rounded-md border border-border px-2 text-xs font-medium hover:border-foreground"
                    type="button"
                    data-copy-value={contact.Email}
                    aria-label={t("contact.copyEmail", { email: contact.Email })}
                  >
                    <CopyIcon class="size-3.5" aria-hidden="true" />
                    <span data-copy-text>{t("contact.copy")}</span>
                  </button>
                </div>
              )}
              {contact.Phone && (
                <div class="mt-1 flex items-center justify-between gap-2">
                  <a class="min-w-0 truncate text-muted-foreground hover:text-foreground" href={`tel:${contact.Phone.replace(/\s+/g, "")}`}>{contact.Phone}</a>
                  <button
                    class="inline-flex h-8 shrink-0 items-center gap-1 rounded-md border border-border px-2 text-xs font-medium hover:border-foreground"
                    type="button"
                    data-copy-value={contact.Phone}
                    aria-label={t("contact.copyPhone", { phone: contact.Phone })}
                  >
                    <CopyIcon class="size-3.5" aria-hidden="true" />
                    <span data-copy-text>{t("contact.copy")}</span>
                  </button>
                </div>
              )}
            </div>
          ))}
        </div>
        <div class="mt-5 grid gap-2">
          {primaryEmail && <Button href={`mailto:${primaryEmail}`} variant="default" class="w-full">{t("contact.writeEmail")}</Button>}
          {primaryPhone && <Button href={`tel:${primaryPhone.replace(/\s+/g, "")}`} variant={primaryEmail ? "outline" : "default"} class="w-full">{t("contact.call")}</Button>}
          {!(primaryEmail || primaryPhone) && <p class="rounded-md bg-muted p-3 text-sm text-muted-foreground">{t("contact.viaProvider")}</p>}
        </div>
        {originalUrl && (
          <a
            href={originalUrl}
            class="group mt-3 flex items-center gap-3 rounded-lg border border-border bg-muted/40 p-3 transition-colors hover:border-foreground"
            rel="nofollow noopener"
            target="_blank"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-full border border-border bg-background">
              <ExternalLinkIcon class="size-5 text-muted-foreground transition-colors group-hover:text-foreground" aria-hidden="true" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[10px] font-bold uppercase tracking-wider text-muted-foreground">{t("detail.sourceLabel")}</span>
              <span class="block text-sm font-bold">{t("detail.openOriginal")}</span>
              <span class="block truncate text-xs text-muted-foreground">{t("detail.openOriginalHint")}</span>
            </span>
            <ChevronRightIcon class="size-5 shrink-0 text-muted-foreground transition-colors group-hover:text-foreground" aria-hidden="true" />
          </a>
        )}
      </aside>
    </section>
    <ContactDock
      sellerName={property.SellerName}
      sellerMeta={sellerMeta}
      contacts={contactCards.map((contact) => ({
        name: contact.Name ?? contact.SourceName ?? property.SellerName,
        email: contact.Email ?? null,
        phone: contact.Phone ?? null,
        sourceName: contact.SourceName ?? null,
      }))}
      primaryEmail={primaryEmail}
      primaryPhone={primaryPhone}
      originalUrl={originalUrl ?? null}
    />
  </article>
</BaseLayout>
