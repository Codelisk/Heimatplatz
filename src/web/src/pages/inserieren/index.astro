---
import ArrowLeftIcon from "@tabler/icons/outline/arrow-left.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthGate from "@/components/app/AuthGate.astro";
import SellerGate from "@/components/app/SellerGate.astro";
import PropertyWysiwygForm from "@/components/properties/PropertyWysiwygForm.astro";
import { t } from "@/i18n";
---

<BaseLayout
  title={t("editor.createMetaTitle")}
  description={t("editor.createMetaDescription")}
  canonicalPath="/inserieren/"
>
  <article class="bg-background pb-16">
    <header class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
      <h1 class="sr-only">{t("editor.createHeading")}</h1>
      <a href="/" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
        <ArrowLeftIcon class="size-4" aria-hidden="true" />
        {t("common.back")}
      </a>
    </header>
    <AuthGate
      title={t("editor.createAuthTitle")}
      description={t("editor.createAuthDescription")}
    >
      <SellerGate>
        <PropertyWysiwygForm />
      </SellerGate>
    </AuthGate>
  </article>
</BaseLayout>
