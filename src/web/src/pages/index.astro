---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PropertySearchApp from "@/components/properties/PropertySearchApp.astro";
import { t } from "@/i18n";
import { fetchApiPropertySearch } from "@/features/properties/live-api";
import { buildOrtSlugMap, fetchOrtRegions } from "@/features/locations/live-api";
import {
  ALL_SELLERS,
  ALL_TYPES,
  buildPropertySearchQuery,
  normalizeTypeValue,
  type PropertySearchState,
} from "@/features/properties/search-query";

// SSR wendet die URL-Filter bereits an (gleicher Query-Builder wie der Client) -
// erster Paint und SEO-Snapshot zeigen dieselben Treffer wie nach der Hydration.
const params = Astro.url.searchParams;

function parseSelection(name: string, allowed: readonly string[]) {
  const values = params
    .getAll(name)
    .flatMap((value) => value.split(","))
    .map((value) => normalizeTypeValue(value.trim()))
    .filter((value) => allowed.includes(value));
  return [...new Set(values)];
}

const ortRegions = await fetchOrtRegions();
const ortSlugMap = buildOrtSlugMap(ortRegions);

const searchState: PropertySearchState = {
  q: params.get("q") ?? "",
  types: parseSelection("type", ALL_TYPES),
  sellers: parseSelection("seller", ALL_SELLERS),
  ortSlugs: (params.get("region") ?? "").split(",").map((value) => value.trim()).filter(Boolean),
  age: params.get("age") ?? "",
  sort: params.get("sort") ?? "newest",
  // URL-Parameter ist 1-basiert ("Seite 2" = ?page=2), intern/API-seitig 0-basiert
  page: Math.max(0, (Number(params.get("page") ?? 1) || 1) - 1),
};

const searchQuery = buildPropertySearchQuery(searchState, ortSlugMap);
const searchResult = await fetchApiPropertySearch(searchQuery);
---

<BaseLayout
  title={t("home.metaTitle")}
  description={t("home.metaDescription")}
  canonicalPath="/"
>
  <PropertySearchApp
    apiProperties={searchResult.properties}
    total={searchResult.total}
    page={searchState.page}
    ssrQuery={searchQuery}
    ortSlugMap={ortSlugMap}
  />
</BaseLayout>
