---
import XIcon from "@tabler/icons/outline/x.svg";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PropertySearchApp from "@/components/properties/PropertySearchApp.astro";
import { t } from "@/i18n";
import { fetchApiPropertySearch } from "@/features/properties/live-api";
import { buildOrtSlugMap, fetchOrtRegions } from "@/features/locations/live-api";
import {
  ALL_SELLERS,
  ALL_TYPES,
  buildPropertySearchQuery,
  DEFAULT_TYPES,
  normalizeTypeValue,
  SEARCH_PAGE_SIZE,
  type PropertySearchState,
} from "@/features/properties/search-query";

// SSR wendet die URL-Filter bereits an (gleicher Query-Builder wie der Client) -
// erster Paint und SEO-Snapshot zeigen dieselben Treffer wie nach der Hydration.
const params = Astro.url.searchParams;

function parseSelection(name: string, allowed: readonly string[]) {
  const values = params
    .getAll(name)
    .flatMap((value) => value.split(","))
    .map((value) => normalizeTypeValue(value.trim()))
    .filter((value) => allowed.includes(value));
  return [...new Set(values)];
}

const ortRegions = await fetchOrtRegions();
const ortSlugMap = buildOrtSlugMap(ortRegions);

// Ohne ?type-Parameter gilt die Standard-Auswahl (Zwangsversteigerungen aus) -
// identisch zum Client-Default in PropertySearchApp, damit der Initial-Query matcht.
const typeSelection = parseSelection("type", ALL_TYPES);
const requestedPage = Number(params.get("page") ?? "1");
const page = Math.max(0, Math.floor(Number.isFinite(requestedPage) ? requestedPage : 1) - 1);

const searchState: PropertySearchState = {
  q: params.get("q") ?? "",
  types: typeSelection.length > 0 ? typeSelection : [...DEFAULT_TYPES],
  sellers: parseSelection("seller", ALL_SELLERS),
  ortSlugs: (params.get("region") ?? "").split(",").map((value) => value.trim()).filter(Boolean),
  age: params.get("age") ?? "",
  sort: params.get("sort") ?? "newest",
  // URL-Parameter ist 1-basiert ("Seite 2" = ?page=2), intern/API-seitig 0-basiert
  page,
};

const searchQuery = buildPropertySearchQuery(searchState, ortSlugMap);
const searchResult = await fetchApiPropertySearch(searchQuery);

// Direkte/veraltete Links dürfen keine leere Seite mit positiver Trefferzahl
// zeigen. Auf die letzte gültige Seite umleiten (bei nur einer Seite ohne ?page).
const lastPage = Math.max(0, Math.ceil(searchResult.total / SEARCH_PAGE_SIZE) - 1);
if (searchState.page > lastPage) {
  const redirectUrl = new URL(Astro.url);
  if (lastPage === 0) redirectUrl.searchParams.delete("page");
  else redirectUrl.searchParams.set("page", String(lastPage + 1));
  return Astro.redirect(`${redirectUrl.pathname}${redirectUrl.search}`, 302);
}
---

<BaseLayout
  title={t("home.metaTitle")}
  description={t("home.metaDescription")}
  canonicalPath="/"
>
  {/* Die Suche rendert keine sichtbare Ueberschrift - sr-only H1 fuer die
      Dokumentstruktur (Screenreader/SEO) */}
  <h1 class="sr-only">{t("common.homeHeading")}</h1>
  <PropertySearchApp
    apiProperties={searchResult.properties}
    total={searchResult.total}
    page={searchState.page}
    ssrQuery={searchQuery}
    ortSlugMap={ortSlugMap}
  >
    {/* Makler-Teaser unter der Ergebnisleiste (Trefferzahl + Sortierung):
        wegdrückbar, die Entscheidung bleibt (localStorage). Startet hidden -
        das Inline-Script direkt darunter blendet ihn nur ein, wenn er nicht
        weggedrückt wurde (kein Aufblitzen bei Wiederkehrern). */}
    <Fragment slot="after-toolbar">
      <section class="px-3 pt-4 sm:px-5" aria-label={t("nav.forBrokers")} data-broker-teaser hidden>
        <div class="broker-teaser-card relative mx-auto flex max-w-7xl flex-col gap-3 rounded-lg bg-card p-4 pr-12 sm:flex-row sm:items-center sm:justify-between sm:p-5 sm:pr-14">
          <div>
            <p class="text-base font-bold">{t("broker.homeTeaserTitle")}</p>
            <p class="mt-0.5 text-sm leading-6 text-muted-foreground">{t("broker.homeTeaserText")}</p>
          </div>
          <a
            href="/makler/"
            class="inline-flex shrink-0 self-start rounded-md border border-primary bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 sm:self-auto"
          >
            {t("broker.homeTeaserCta")}
          </a>
          <button
            type="button"
            class="absolute right-3 top-3 grid size-8 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            aria-label={t("broker.teaserDismiss")}
            data-broker-teaser-dismiss
          >
            <XIcon class="size-4" aria-hidden="true" />
          </button>
        </div>
      </section>
      <script is:inline>
        // Direkt beim Parsen (vor dem ersten Paint der Sektion) entscheiden -
        // ein spaeter gebuendeltes Script wuerde den Banner sichtbar aufblitzen lassen
        (() => {
          const teaser = document.querySelector("[data-broker-teaser]");
          if (!teaser) return;
          try {
            if (window.localStorage.getItem("heimatplatz:broker-teaser-dismissed") !== "1") teaser.hidden = false;
          } catch {
            teaser.hidden = false;
          }
        })();
      </script>
    </Fragment>
  </PropertySearchApp>
</BaseLayout>

<style>
  /* Zettel-Optik wie die Inserat-Karten: Schatten statt Border */
  .broker-teaser-card {
    box-shadow: var(--zettel-shadow);
  }
</style>

<script>
  const teaser = document.querySelector<HTMLElement>("[data-broker-teaser]");
  document.querySelector("[data-broker-teaser-dismiss]")?.addEventListener("click", () => {
    try {
      window.localStorage.setItem("heimatplatz:broker-teaser-dismissed", "1");
    } catch {
      // localStorage gesperrt: dann eben nur fuer diese Seite ausblenden
    }
    if (teaser) teaser.hidden = true;
  });
</script>
