---
import ArrowLeftIcon from "@tabler/icons/outline/arrow-left.svg";
import ChevronRightIcon from "@tabler/icons/outline/chevron-right.svg";
import EyeOffIcon from "@tabler/icons/outline/eye-off.svg";
import ExternalLinkIcon from "@tabler/icons/outline/external-link.svg";
import FileTextIcon from "@tabler/icons/outline/file-text.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import ShareIcon from "@tabler/icons/outline/share.svg";
import ImageGallery from "@/components/properties/ImageGallery.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  fetchForeclosureAuctionById,
  formatAuctionArea,
  formatAuctionDate,
  formatAuctionDateShort,
  formatAuctionMoney,
  getAuctionDescription,
  getAuctionDetailSections,
  getAuctionDocumentLinks,
  getAuctionImages,
  getAuctionJsonLd,
  getAuctionPriceLabel,
  getAuctionPrimaryArea,
  getAuctionTitle,
  getForeclosureAuctionPath,
  getForeclosureAuctionSlug,
  getForeclosureCategoryLabel,
} from "@/features/foreclosures/api";
import { breadcrumbSchema } from "@/lib/seo";

// SSR: Der Slug endet auf die Auktions-GUID (siehe getForeclosureAuctionSlug) -
// daraus laden wir die Versteigerung pro Request. Unbekannte Ids liefern 404,
// veraltete Slug-Varianten (z.B. geaenderte Kategorie) leiten 301 auf die kanonische URL.
const { slug } = Astro.params;
const id = slug?.slice(-36) ?? "";
const isGuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);
const auction = isGuid ? await fetchForeclosureAuctionById(id) : null;

if (!auction) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

if (slug !== getForeclosureAuctionSlug(auction)) {
  return Astro.redirect(getForeclosureAuctionPath(auction), 301);
}
const canonicalPath = getForeclosureAuctionPath(auction);
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const title = getAuctionTitle(auction);
const description = getAuctionDescription(auction);
const detailSections = getAuctionDetailSections(auction);
const documents = getAuctionDocumentLinks(auction);
const images = getAuctionImages(auction);
const primaryFacts = [
  ["Termin", formatAuctionDate(auction.AuctionDate)],
  ["Schätzwert", formatAuctionMoney(auction.EstimatedValue)],
  ["Mindestgebot", formatAuctionMoney(auction.MinimumBid)],
  ["Fläche", formatAuctionArea(getAuctionPrimaryArea(auction))],
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={images[0]}
  structuredData={[
    breadcrumbSchema([
      { name: "Heimatplatz", url: new URL("/", Astro.site).toString() },
      { name: title, url: canonicalUrl },
    ]),
    getAuctionJsonLd(auction, canonicalUrl),
  ]}
>
  <article class="bg-background pb-28">
    <header class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground">
        <ArrowLeftIcon class="size-4" aria-hidden="true" />
        Zurück
      </a>
    </header>

    {/* grid-cols-[minmax(0,1fr)] auch unterhalb lg: sonst sprengt die intrinsische
        Bildbreite die implizite Spalte und die Seite wird breiter als der Viewport */}
    <section class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-8 px-4 pb-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:px-8">
      <div>
        <div class="relative">
          <ImageGallery images={images} title={title} />
          {/* right-40 laesst Platz fuer die drei Action-Buttons, sonst ueberlappen die Badges */}
          <div class="pointer-events-none absolute left-4 right-40 top-4 z-10 flex flex-wrap gap-2">
            <span class="rounded-full bg-brand px-3 py-1.5 text-xs font-bold text-brand-foreground">ZV</span>
            <span class="rounded-full bg-background/90 px-3 py-1.5 text-xs font-bold text-foreground">
              {getForeclosureCategoryLabel(auction.Category)}
            </span>
            {auction.Status && (
              <span class="rounded-full bg-background/90 px-3 py-1.5 text-xs font-bold text-foreground">
                {auction.Status}
              </span>
            )}
          </div>
          <div class="pointer-events-none absolute right-4 top-4 z-10 flex gap-2">
            <button
              class="pointer-events-auto grid size-10 place-items-center rounded-full bg-black/60 text-white"
              type="button"
              aria-label="Merken"
              aria-pressed="false"
              data-property-action="favorite"
              data-property-slug={auction.Id}
              data-property-id={auction.Id}
            >
              <HeartIcon class="size-5" aria-hidden="true" />
            </button>
            <button
              class="pointer-events-auto grid size-10 place-items-center rounded-full bg-black/60 text-white"
              type="button"
              aria-label="Blockieren"
              aria-pressed="false"
              data-property-action="block"
              data-property-slug={auction.Id}
              data-property-id={auction.Id}
            >
              <EyeOffIcon class="size-5" aria-hidden="true" />
            </button>
            <button
              class="pointer-events-auto grid size-10 place-items-center rounded-full bg-black/60 text-white"
              type="button"
              aria-label="Teilen"
              data-share-url={canonicalUrl}
              data-share-title={title}
            >
              <ShareIcon class="size-5" aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="mt-6">
          <p class="text-sm font-semibold text-muted-foreground">{auction.PostalCode} {auction.City} · {auction.Address}</p>
          <h1 class="mt-3 max-w-3xl break-words text-3xl font-bold leading-tight sm:text-4xl">{title}</h1>
          <p class="mt-4 max-w-3xl text-base leading-7 text-muted-foreground">{description}</p>
        </div>

        <dl class="mt-6 grid gap-3 sm:grid-cols-4">
          {primaryFacts.map(([label, value]) => (
            <div class="rounded-lg border border-border bg-card p-4">
              <dt class="text-sm text-muted-foreground">{label}</dt>
              <dd class="mt-1 text-xl font-bold">{value}</dd>
            </div>
          ))}
        </dl>

        <section class="mt-8" aria-labelledby="auction-object-description">
          <h2 id="auction-object-description" class="text-sm font-bold uppercase text-muted-foreground">
            Objektbeschreibung
          </h2>
          <p class="mt-4 max-w-3xl text-base leading-7">
            {auction.ObjectDescription}
          </p>
        </section>

        <div class="mt-8 space-y-6">
          {detailSections.map((section) => (
            <section aria-labelledby={`section-${section.title.toLowerCase()}`}>
              <h2 id={`section-${section.title.toLowerCase()}`} class="text-sm font-bold uppercase text-muted-foreground">
                {section.title}
              </h2>
              <dl class="mt-3 overflow-hidden rounded-lg border border-border bg-card">
                {section.items.map(([label, value]) => (
                  <div class="grid gap-2 border-b border-border px-4 py-3 last:border-b-0 sm:grid-cols-[180px_minmax(0,1fr)]">
                    <dt class="text-sm font-semibold text-muted-foreground">{label}</dt>
                    <dd class="text-sm font-medium">{value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))}
        </div>

        {(auction.Notes || documents.length > 0) && (
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {auction.Notes && (
              <section aria-labelledby="auction-notes">
                <h2 id="auction-notes" class="text-sm font-bold uppercase text-muted-foreground">Hinweise</h2>
                <p class="mt-3 rounded-lg border border-border bg-card p-4 text-sm leading-6">{auction.Notes}</p>
              </section>
            )}

            {documents.length > 0 && (
              <section aria-labelledby="auction-documents">
                <h2 id="auction-documents" class="text-sm font-bold uppercase text-muted-foreground">Dokumente</h2>
                <div class="mt-3 space-y-2">
                  {documents.map(([label, url]) => (
                    <a
                      class="flex items-center justify-between gap-3 rounded-lg border border-border bg-card px-4 py-3 text-sm font-semibold hover:border-foreground"
                      href={url}
                      rel="nofollow noopener"
                      target="_blank"
                    >
                      <span class="inline-flex min-w-0 items-center gap-2">
                        <FileTextIcon class="size-4 shrink-0" aria-hidden="true" />
                        <span class="truncate">{label}</span>
                      </span>
                      <ExternalLinkIcon class="size-4 shrink-0" aria-hidden="true" />
                    </a>
                  ))}
                </div>
              </section>
            )}
          </div>
        )}
      </div>

      <aside class="self-start rounded-lg border border-border bg-card p-5 shadow-sm lg:sticky lg:top-20">
        <p class="text-sm text-muted-foreground">Gericht / Quelle</p>
        <h2 class="mt-1 text-xl font-bold">{auction.Court ?? "Bezirksgericht"}</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          {auction.CaseNumber ? `Aktenzeichen ${auction.CaseNumber}` : "Gerichtliche Immobilienversteigerung"}
        </p>
        <p class="mt-4 text-3xl font-bold text-primary">{getAuctionPriceLabel(auction)}</p>
        <p class="mt-2 text-sm text-muted-foreground">Mindestgebot oder Schätzwert, soweit veröffentlicht.</p>

        {auction.EdictUrl ? (
          <a
            href={auction.EdictUrl}
            class="group mt-5 flex items-center gap-3 rounded-lg border border-border bg-muted/40 p-3 transition-colors hover:border-foreground"
            rel="nofollow noopener"
            target="_blank"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-full border border-border bg-background">
              <ExternalLinkIcon class="size-5 text-muted-foreground transition-colors group-hover:text-foreground" aria-hidden="true" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Amtliches Dokument</span>
              <span class="block text-sm font-bold">Edikt öffnen</span>
              <span class="block truncate text-xs text-muted-foreground">Alle Angaben im Original-Edikt ansehen</span>
            </span>
            <ChevronRightIcon class="size-5 shrink-0 text-muted-foreground transition-colors group-hover:text-foreground" aria-hidden="true" />
          </a>
        ) : (
          <p class="mt-5 rounded-md bg-muted p-3 text-sm text-muted-foreground">Edikt noch nicht verfügbar.</p>
        )}

        <div class="mt-5 border-t border-border pt-4 text-sm text-muted-foreground">
          <p>Erfasst: {formatAuctionDate(auction.FirstSeenAt ?? auction.CreatedAt, "Nicht angegeben")}</p>
          <p class="mt-1">Aktualisiert: {formatAuctionDate(auction.LastScrapedAt ?? auction.CreatedAt, "Nicht angegeben")}</p>
        </div>
      </aside>
    </section>

    <section
      class="fixed inset-x-0 bottom-0 z-30 border-t border-border bg-background/95 shadow-[0_-12px_32px_rgba(15,23,42,0.12)] backdrop-blur"
      aria-label="Schnellzugriff"
    >
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <span class="min-w-0">
          <span class="block truncate text-sm font-semibold">{getAuctionPriceLabel(auction)}</span>
          <span class="mt-0.5 block truncate text-xs text-muted-foreground">Termin: {formatAuctionDateShort(auction.AuctionDate)}</span>
        </span>
        {auction.EdictUrl ? (
          <a
            class="inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary-accent"
            href={auction.EdictUrl}
            rel="nofollow noopener"
            target="_blank"
          >
            Edikt ansehen
            <ExternalLinkIcon class="size-4" aria-hidden="true" />
          </a>
        ) : (
          <span class="inline-flex h-10 shrink-0 items-center justify-center rounded-md border border-border px-4 text-sm font-semibold text-muted-foreground">
            Edikt offen
          </span>
        )}
      </div>
    </section>
  </article>
</BaseLayout>
