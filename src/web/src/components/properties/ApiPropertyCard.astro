---
import CalendarIcon from "@tabler/icons/outline/calendar.svg";
import EyeOffIcon from "@tabler/icons/outline/eye-off.svg";
import GavelIcon from "@tabler/icons/outline/gavel.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import UserIcon from "@tabler/icons/outline/user.svg";
import {
  formatApiDate,
  formatApiPrice,
  getApiAreaLabel,
  getApiAreaValue,
  getApiPropertyPath,
  getApiPropertyTypeLabel,
  getApiPropertyTypeSearchValue,
  getApiSellerLabel,
  getApiSellerSearchValue,
  getApiPropertyImage,
  getApiLocationLine,
  getApiStreetLine,
  isCourtForeclosure,
  type ApiProperty,
} from "@/features/properties/live-api";
import { slugifyLocation } from "@/features/locations/region-match";
import { getAuctionCountdownLabel, getDisplayTitle } from "@/features/properties/format";
import { getResponsiveImage } from "@/lib/images";
import { t } from "@/i18n";

interface Props {
  property: ApiProperty;
}

const { property } = Astro.props;
const href = getApiPropertyPath(property);
const typeSearchValue = getApiPropertyTypeSearchValue(property.Type, property);
const sellerSearchValue = getApiSellerSearchValue(property.SellerType);
const isForeclosure = typeSearchValue === "foreclosure";
// "Gericht" nur fuer aus dem Edikte-Sync importierte ZV - privat erstellte
// Zwangsversteigerungen behalten die echte Anbieterrolle (WEB-016)
const sellerLabel = isForeclosure && isCourtForeclosure(property)
  ? t("card.sellerCourt")
  : getApiSellerLabel(property.SellerType);
// ZV: Auktionstermin beschriftet statt unbeschriftetem Einstelldatum (WEB-011)
const auctionDateLabel = isForeclosure && property.AuctionDate
  ? t("card.auctionDate", { date: formatApiDate(property.AuctionDate) })
  : null;
// ZV: Countdown-Overlay am Foto-Unterrand ("heute/morgen/in X Tagen") - nur
// fuer kuenftige Termine, das absolute Datum steht weiter in der Fusszeile
const auctionCountdown = isForeclosure ? getAuctionCountdownLabel(property.AuctionDate) : null;
// Fusszeile vertraegt fehlende Namen (kein haengender Trennpunkt)
const sellerLine = [sellerLabel, property.SellerName?.trim()].filter(Boolean).join(" · ");
const area = getApiAreaValue(property);
// Titel als Kopfzeile, darunter "PLZ Ort" und dann die Strasse - die PLZ
// gehoert zum Ort, nie vor die Strasse ("4742 Bahnhofstrasse 3" liest sich falsch)
const displayTitle = getDisplayTitle(property.Title);
const locationLine = getApiLocationLine(property) || property.City;
const streetLine = getApiStreetLine(property);
const imageUrl = getApiPropertyImage(property);
const responsiveImage = getResponsiveImage(imageUrl);
const citySlug = slugifyLocation(property.City);
---

<article
  class="property-card group flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lg"
  data-property-card
  data-live-property="true"
  data-slug={property.Id}
  data-property-id={property.Id}
  data-type={typeSearchValue}
  data-seller={sellerSearchValue}
  data-region={citySlug}
  data-location={citySlug}
  data-updated={property.CreatedAt}
  data-price={property.Price}
  data-area={area}
  data-postal={property.PostalCode}
  data-search={`${property.Title} ${property.Address} ${property.City} ${property.PostalCode} ${property.SellerName} ${property.SourceName ?? ""}`.toLowerCase()}
>
  <div class="relative h-50 overflow-hidden bg-muted">
    <a href={href} class="block h-full">
      <img
        src={responsiveImage.src}
        srcset={responsiveImage.srcset}
        sizes="(min-width: 1280px) 416px, (min-width: 640px) calc(50vw - 2rem), calc(100vw - 1.5rem)"
        alt={property.Title}
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        loading="lazy"
        decoding="async"
        data-fallback-image="/favicon.svg"
        data-smart-image
      />
    </a>
    {/* Typ-Farben: ZV = Markenrot, Grund = Gruen, Haus = Blau, Rest neutral */}
    <span
      class:list={[
        "absolute left-3 top-3 rounded-full px-3 py-1.5 text-xs font-bold",
        typeSearchValue === "foreclosure"
          ? "bg-brand text-brand-foreground"
          : typeSearchValue === "land"
            ? "bg-type-grund text-white"
            : typeSearchValue === "house"
              ? "bg-type-haus text-white"
              : "bg-foreground text-background",
      ]}
    >
      {getApiPropertyTypeLabel(property.Type, property)}
    </span>
    <div class="absolute right-3 top-3 flex gap-1">
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full bg-black/55 text-white"
        aria-label={t("card.favoriteAdd")}
        aria-pressed="false"
        data-property-action="favorite"
        data-property-slug={property.Id}
        data-property-id={property.Id}
      >
        <HeartIcon class="size-5" aria-hidden="true" />
      </button>
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full bg-black/55 text-white"
        aria-label={t("card.blockAdd")}
        aria-pressed="false"
        data-property-action="block"
        data-property-slug={property.Id}
        data-property-id={property.Id}
      >
        <EyeOffIcon class="size-5" aria-hidden="true" />
      </button>
    </div>
    {/* Countdown als Overlay am Foto-Unterrand statt eigener Zeile - so
        bleiben Titel/Preis aller Karten einer Grid-Zeile auf gleicher Hoehe */}
    {auctionCountdown && (
      <p class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-1.5 bg-brand/90 px-3 py-1.5 text-xs font-semibold text-brand-foreground">
        <GavelIcon class="size-3.5 shrink-0" aria-hidden="true" />
        <span class="truncate">{auctionCountdown}</span>
      </p>
    )}
  </div>

  <div class="grid grid-cols-[1fr_auto] gap-3 p-3">
    <div class="min-w-0">
      <h2 class="truncate text-base font-semibold">
        <a href={href} class="hover:underline">{displayTitle || locationLine}</a>
      </h2>
      {/* Gestaffelte Adresse: Ort kraeftig, Strasse klein und grau - zwei
          gleich graue Zeilen wirkten plump */}
      {locationLine && <p class="mt-0.5 truncate text-sm font-medium">{locationLine}</p>}
      {streetLine && <p class="mt-0.5 truncate text-xs text-muted-foreground">{streetLine}</p>}
    </div>

    <dl class="text-right">
      <div>
        <dt class="sr-only">{t("card.price")}</dt>
        <dd class="whitespace-nowrap text-xl font-bold leading-none text-price">{formatApiPrice(property.Price)}</dd>
      </div>
      <div class="mt-1.5">
        <dt class="sr-only">{t("card.area")}</dt>
        <dd class="text-sm font-semibold text-muted-foreground">{area ? t(property.PlotAreaM2 ? "card.plotAreaValue" : isForeclosure ? "card.builtAreaValue" : "card.livingAreaValue", { area }) : t("card.areaUnknown")}</dd>
      </div>
      {(property.LivingAreaM2 || property.Rooms) && (
        <div class="mt-3 flex justify-end gap-1">
          {property.LivingAreaM2 && <span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">{t(isForeclosure ? "card.chipBuiltArea" : "card.chipLivingArea", { value: property.LivingAreaM2 })}</span>}
          {property.Rooms && <span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">{t("card.chipRooms", { value: property.Rooms })}</span>}
        </div>
      )}
    </dl>
  </div>

  {/* mt-auto pinnt die Fusszeile an den Kartenboden - Karten in einer
      Grid-Zeile sind gleich hoch, auch wenn z.B. die Chips-Zeile fehlt */}
  <div class="mt-auto flex items-center justify-between gap-3 border-t border-border bg-muted/50 px-3 py-2 text-xs text-muted-foreground">
    <span class="flex min-w-0 items-center gap-1.5">
      <UserIcon class="size-3.5 shrink-0" aria-hidden="true" />
      <span class="truncate">{sellerLine}</span>
    </span>
    <span class="flex shrink-0 items-center gap-1.5">
      <CalendarIcon class="size-3.5 shrink-0" aria-hidden="true" />
      {auctionDateLabel ?? (formatApiDate(property.CreatedAt) || t("card.liveOffer"))}
    </span>
  </div>
  <p class="sr-only">{getApiAreaLabel(property)}</p>
</article>
