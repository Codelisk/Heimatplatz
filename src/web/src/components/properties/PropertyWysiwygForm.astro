---
import ChevronDownIcon from "@tabler/icons/outline/chevron-down.svg";
import EyeOffIcon from "@tabler/icons/outline/eye-off.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import PencilIcon from "@tabler/icons/outline/pencil.svg";
import PhotoPlusIcon from "@tabler/icons/outline/photo-plus.svg";
import ShareIcon from "@tabler/icons/outline/share.svg";
import { Button } from "@/components/starwind/button";
import { fetchApiPropertyTypes } from "@/features/properties/live-api";
import { t } from "@/i18n";

/**
 * WYSIWYG-Inseratsformular: 1:1 wie die Immobilien-Detailansicht aufgebaut
 * (Hero-Foto mit Badges und Aktions-Buttons, Titel, Fakten-Kacheln, Details,
 * Beschreibung, Anbieter-Sidebar) - nur dass die Anzeige-Elemente direkt
 * editierbare Felder sind. Feldnamen und data-Attribute muessen mit
 * PropertyStateScript.astro uebereinstimmen (data-local-property-form,
 * data-property-images, data-structure-property-field, ...).
 *
 * Ort/PLZ werden frei eingegeben; die Gemeinde loest PropertyStateScript beim
 * Speichern ueber findMunicipalityId (Ort+PLZ -> /api/locations) automatisch auf.
 *
 * editMode: /immobilien/bearbeiten/ - markiert das Formular als
 * data-edit-property-form (Prefill + Update statt Neuanlage durch das Script).
 */
interface Props {
  editMode?: boolean;
}

const { editMode = false } = Astro.props;
const submitLabel = editMode ? t("editor.submitSave") : t("editor.submitCreate");
const cancelHref = editMode ? "/meine-immobilien/" : "/";
const photoHelp = editMode ? t("editor.photoHelpEdit") : t("editor.photoHelpCreate");

// Typenliste kommt aus dem Backend (PropertyType-Enum) - nicht hardcoden!
const propertyTypes = await fetchApiPropertyTypes();

// UX-Obergrenze fuer das Baujahr; massgeblich validiert der Server
// (PropertyFieldValidation.cs: Baujahr darf nicht in der Zukunft liegen)
const currentYear = new Date().getFullYear();
---

<form
  class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-8 px-4 pb-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:px-8"
  action="/meine-immobilien/"
  method="get"
  data-local-property-form
  data-wysiwyg-property
  data-edit-property-form={editMode ? "" : undefined}
>
  <input type="hidden" name="municipalityId" />
  <input type="hidden" name="imageUrls" data-property-image-urls />
  {/* city/postalCode sind sichtbare Inline-Felder in der Adresszeile */}

  <div>
    <p class="wys-rise flex items-center gap-2 rounded-md border border-border bg-card px-4 py-3 text-sm text-muted-foreground">
      <PencilIcon class="size-4 shrink-0" aria-hidden="true" />
      {t("editor.livePreviewHint")}
    </p>

    {/* Hero-Fotozone wie die Galerie der Detailseite, inkl. Badge- und Button-Overlays */}
    <div class="wys-rise relative mt-5 h-[320px] w-full overflow-hidden rounded-xl bg-muted sm:h-[460px]" style="--rise: 0.06s">
      <img data-preview-hero alt={t("editor.heroAlt")} class="hidden h-full w-full object-cover" />
      <label
        for="propertyImages"
        data-preview-hero-empty
        class="group absolute inset-0 grid cursor-pointer place-items-center"
      >
        <span class="pointer-events-none mx-6 grid place-items-center gap-3 rounded-xl border-2 border-dashed border-border px-10 py-12 text-center transition-colors duration-300 group-hover:border-outline">
          <span class="grid size-14 place-items-center rounded-full bg-background text-muted-foreground transition-transform duration-300 group-hover:scale-110 group-hover:text-foreground">
            <PhotoPlusIcon class="size-7" aria-hidden="true" />
          </span>
          <span class="text-base font-bold">{t("editor.addPhotos")}</span>
          <span class="text-xs text-muted-foreground">{t("editor.photoFormats")}</span>
        </span>
      </label>
      <label
        for="propertyImages"
        data-preview-hero-add
        class="absolute bottom-3 right-3 z-10 hidden cursor-pointer items-center gap-2 rounded-full bg-black/70 px-3.5 py-2 text-xs font-bold text-white backdrop-blur-sm transition-transform duration-300 hover:scale-105"
      >
        <PhotoPlusIcon class="size-4" aria-hidden="true" />
        {t("editor.addPhotos")}
      </label>
      {/* right-40 wie auf der Detailseite: Platz fuer die drei Aktions-Buttons */}
      <div class="pointer-events-none absolute left-4 right-40 top-4 z-10 flex flex-wrap items-center gap-2" data-photo-badges>
        <span
          class="pointer-events-auto relative inline-flex items-center rounded-[2px] bg-type-haus text-white transition-colors duration-300"
          data-preview-type-badge
        >
          <select
            id="propertyType"
            name="propertyType"
            required
            aria-label={t("editor.propertyType")}
            class="cursor-pointer appearance-none border-0 bg-transparent py-1.5 pl-3 pr-8 text-xs font-bold text-inherit outline-none focus-visible:ring-2 focus-visible:ring-white/70"
          >
            {propertyTypes.map((type, index) => (
              <option value={type.Value.toLowerCase()} selected={index === 0}>{type.Label}</option>
            ))}
          </select>
          <ChevronDownIcon class="pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2 opacity-80" aria-hidden="true" />
        </span>
        <span class="rounded-[2px] bg-background/90 px-3 py-1.5 text-xs font-bold text-foreground" data-preview-city>{t("editor.cityLabel")}</span>
      </div>
      {/* Merken/Blockieren/Teilen wie auf der Detailseite - im Editor nur Kulisse */}
      <div class="pointer-events-none absolute right-4 top-4 z-10 flex gap-2" aria-hidden="true">
        <span class="grid size-10 place-items-center rounded-full bg-black/60 text-white"><HeartIcon class="size-5" /></span>
        <span class="grid size-10 place-items-center rounded-full bg-black/60 text-white"><EyeOffIcon class="size-5" /></span>
        <span class="grid size-10 place-items-center rounded-full bg-black/60 text-white"><ShareIcon class="size-5" /></span>
      </div>
    </div>
    <input
      id="propertyImages"
      name="propertyImages"
      type="file"
      accept="image/jpeg,image/png,image/webp"
      multiple
      class="sr-only"
      data-property-images
    />
    <div class="mt-3 hidden grid grid-cols-3 gap-2 sm:grid-cols-5" data-property-image-grid></div>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
      <p data-property-image-count>{t("editor.photoCount", { current: 0, max: 20 })}</p>
      <p data-property-image-help>{photoHelp}</p>
    </div>

    {/* Adresszeile + Titel wie auf der Detailseite, nur editierbar */}
    <div class="wys-rise mt-6" style="--rise: 0.12s">
      <div class="flex flex-wrap items-center gap-2 text-sm font-semibold text-muted-foreground">
        <input
          id="postalCode"
          name="postalCode"
          class="wys w-20 text-center"
          inputmode="numeric"
          minlength="4"
          maxlength="4"
          pattern="[0-9]{4}"
          placeholder={t("editor.postalCodePlaceholder")}
          aria-label={t("editor.postalCodeLabel")}
          required
        />
        <input id="city" name="city" class="wys w-44" placeholder={t("editor.cityLabel")} aria-label={t("editor.cityLabel")} required />
        <span aria-hidden="true">·</span>
        <input
          id="address"
          name="address"
          class="wys min-w-56 flex-1"
          placeholder={t("editor.addressPlaceholder")}
          aria-label={t("editor.addressLabel")}
          required
        />
      </div>
      <input
        id="title"
        name="title"
        class="wys mt-3 w-full max-w-3xl text-3xl font-bold leading-tight sm:text-4xl"
        placeholder={t("editor.titlePlaceholder")}
        aria-label={t("editor.titleLabel")}
        minlength="10"
        required
      />
    </div>

    {/* Fakten-Kacheln 1:1 wie auf der Detailseite */}
    <div class="wys-rise mt-6 grid gap-3 sm:grid-cols-4" style="--rise: 0.18s">
      <div class="wys-tile rounded-lg border border-border bg-card p-4">
        <label for="price" class="text-sm text-muted-foreground">{t("editor.priceLabel")}</label>
        {/* Euro-Zeichen vorangestellt wie im de-AT-Format der Detailseite ("€ 350.000");
            bewusst KEIN text-price im Editor - Rot an Eingabefeldern liest sich als Fehler */}
        <div class="mt-1 flex items-baseline gap-1">
          <span class="text-xl font-bold" aria-hidden="true">€</span>
          <input
            id="price"
            name="price"
            type="number"
            inputmode="numeric"
            min="1"
            max="100000000"
            step="1"
            placeholder="350000"
            class="wys-bare w-full text-xl font-bold"
            required
          />
        </div>
      </div>
      <div class="wys-tile rounded-lg border border-border bg-card p-4" data-structure-property-field>
        <label for="livingArea" class="text-sm text-muted-foreground">{t("editor.livingAreaLabel")}</label>
        <div class="mt-1 flex items-baseline gap-1">
          <input
            id="livingArea"
            name="livingArea"
            type="number"
            inputmode="numeric"
            min="1"
            max="10000"
            step="1"
            placeholder="90"
            class="wys-bare w-full text-xl font-bold"
          />
          <span class="text-sm text-muted-foreground">m²</span>
        </div>
      </div>
      <div class="wys-tile rounded-lg border border-border bg-card p-4">
        <label for="plotArea" class="text-sm text-muted-foreground">{t("editor.plotLabel")}</label>
        <div class="mt-1 flex items-baseline gap-1">
          <input
            id="plotArea"
            name="plotArea"
            type="number"
            inputmode="numeric"
            min="1"
            max="1000000"
            step="1"
            placeholder="500"
            class="wys-bare w-full text-xl font-bold"
          />
          <span class="text-sm text-muted-foreground">m²</span>
        </div>
      </div>
      <div class="wys-tile rounded-lg border border-border bg-card p-4" data-structure-property-field>
        <label for="rooms" class="text-sm text-muted-foreground">{t("editor.roomsLabel")}</label>
        <input
          id="rooms"
          name="rooms"
          type="number"
          inputmode="numeric"
          min="1"
          max="200"
          step="1"
          placeholder="3"
          class="wys-bare mt-1 w-full text-xl font-bold"
        />
      </div>
    </div>

    {/* Detail-Sektion wie auf der Detailseite ("Gebaeude" wie in detail-sections.ts) */}
    <section class="wys-rise mt-8" style="--rise: 0.24s" data-structure-property-field>
      <h2 class="text-sm font-bold uppercase text-muted-foreground">{t("editor.detailsHeading")}</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <section class="wys-tile rounded-lg border border-border bg-card p-4" aria-label={t("editor.buildingHeading")}>
          <h3 class="text-xs font-bold uppercase text-muted-foreground">{t("editor.buildingHeading")}</h3>
          <div class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 py-2 text-sm">
            <label for="yearBuilt" class="text-muted-foreground">{t("editor.yearBuiltLabel")}</label>
            <input
              id="yearBuilt"
              name="yearBuilt"
              type="number"
              inputmode="numeric"
              min="1000"
              max={currentYear}
              step="1"
              placeholder="1998"
              class="wys-bare w-24 text-right font-medium"
            />
          </div>
        </section>
      </div>
    </section>

    <section class="wys-rise mt-8" style="--rise: 0.3s" aria-labelledby="preview-features-heading">
      <h2 id="preview-features-heading" class="text-sm font-bold uppercase text-muted-foreground">{t("editor.featuresHeading")}</h2>
      <input type="hidden" name="features" data-feature-store />
      <ul class="mt-4 grid gap-2 sm:grid-cols-2" data-preview-features></ul>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <input
          data-feature-input
          class="wys wys-sm w-72 max-w-full"
          placeholder={t("editor.featurePlaceholder")}
          aria-label={t("editor.featureLabel")}
        />
        <p class="text-xs text-muted-foreground">
          {t("editor.featureHint")}
        </p>
      </div>
    </section>

    <section class="wys-rise mt-8" style="--rise: 0.36s" aria-labelledby="description-heading">
      <h2 id="description-heading" class="text-sm font-bold uppercase text-muted-foreground">{t("editor.descriptionHeading")}</h2>
      <textarea
        id="description"
        name="description"
        rows="5"
        minlength="50"
        required
        class="wys wys-grow mt-4 min-h-36 w-full max-w-3xl text-base leading-7"
        placeholder={t("editor.descriptionPlaceholder")}
        aria-label={t("editor.descriptionHeading")}></textarea>
    </section>

    <fieldset class="mt-8 rounded-lg border border-border bg-card p-4" data-foreclosure-fields hidden>
      <legend class="px-1 text-sm font-bold uppercase text-muted-foreground">{t("editor.foreclosureLegend")}</legend>
      <div class="mt-2 grid gap-4 md:grid-cols-2">
        <div class="space-y-1">
          <label for="foreclosureCourtName" class="wys-label">{t("editor.fcCourt")}</label>
          <input id="foreclosureCourtName" name="foreclosureCourtName" placeholder={t("editor.fcCourtPlaceholder")} class="wys wys-sm w-full" data-foreclosure-required disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureFileNumber" class="wys-label">{t("editor.fcFileNumber")}</label>
          <input id="foreclosureFileNumber" name="foreclosureFileNumber" placeholder={t("editor.fcFileNumberPlaceholder")} class="wys wys-sm w-full" data-foreclosure-required disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureAuctionDate" class="wys-label">{t("editor.fcAuctionDate")}</label>
          <input id="foreclosureAuctionDate" name="foreclosureAuctionDate" type="datetime-local" class="wys wys-sm w-full" data-foreclosure-required disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureMinimumBid" class="wys-label">{t("editor.fcMinimumBid")}</label>
          <input id="foreclosureMinimumBid" name="foreclosureMinimumBid" type="number" inputmode="numeric" min="1" step="1" placeholder="250000" class="wys wys-sm w-full" data-foreclosure-required disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureEstimatedValue" class="wys-label">{t("editor.fcEstimatedValue")}</label>
          <input id="foreclosureEstimatedValue" name="foreclosureEstimatedValue" type="number" inputmode="numeric" min="1" step="1" placeholder="500000" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureStatus" class="wys-label">{t("editor.fcStatus")}</label>
          <select id="foreclosureStatus" name="foreclosureStatus" class="wys wys-sm w-full" disabled>
            <option value="Scheduled">{t("editor.fcStatusScheduled")}</option>
            <option value="Pending">{t("editor.fcStatusPending")}</option>
            <option value="InProgress">{t("editor.fcStatusInProgress")}</option>
            <option value="Completed">{t("editor.fcStatusCompleted")}</option>
            <option value="Cancelled">{t("editor.fcStatusCancelled")}</option>
          </select>
        </div>
        <div class="space-y-1">
          <label for="foreclosureViewingDate" class="wys-label">{t("editor.fcViewingDate")}</label>
          <input id="foreclosureViewingDate" name="foreclosureViewingDate" type="datetime-local" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureBiddingDeadline" class="wys-label">{t("editor.fcBiddingDeadline")}</label>
          <input id="foreclosureBiddingDeadline" name="foreclosureBiddingDeadline" type="datetime-local" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureOwnershipShare" class="wys-label">{t("editor.fcOwnershipShare")}</label>
          <input id="foreclosureOwnershipShare" name="foreclosureOwnershipShare" placeholder={t("editor.fcOwnershipSharePlaceholder")} class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureEdictUrl" class="wys-label">{t("editor.fcEdictUrl")}</label>
          <input id="foreclosureEdictUrl" name="foreclosureEdictUrl" type="url" placeholder="https://..." class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureRegistrationNumber" class="wys-label">{t("editor.fcRegistrationNumber")}</label>
          <input id="foreclosureRegistrationNumber" name="foreclosureRegistrationNumber" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureCadastralMunicipality" class="wys-label">{t("editor.fcCadastralMunicipality")}</label>
          <input id="foreclosureCadastralMunicipality" name="foreclosureCadastralMunicipality" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosurePlotNumber" class="wys-label">{t("editor.fcPlotNumber")}</label>
          <input id="foreclosurePlotNumber" name="foreclosurePlotNumber" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureTotalArea" class="wys-label">{t("editor.fcTotalArea")}</label>
          <input id="foreclosureTotalArea" name="foreclosureTotalArea" type="number" inputmode="numeric" min="1" step="1" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureBuildingArea" class="wys-label">{t("editor.fcBuildingArea")}</label>
          <input id="foreclosureBuildingArea" name="foreclosureBuildingArea" type="number" inputmode="numeric" min="1" step="1" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureZoningDesignation" class="wys-label">{t("editor.fcZoning")}</label>
          <input id="foreclosureZoningDesignation" name="foreclosureZoningDesignation" class="wys wys-sm w-full" disabled />
        </div>
        <div class="space-y-1">
          <label for="foreclosureBuildingCondition" class="wys-label">{t("editor.fcBuildingCondition")}</label>
          <input id="foreclosureBuildingCondition" name="foreclosureBuildingCondition" class="wys wys-sm w-full" disabled />
        </div>
      </div>
      <div class="mt-4 space-y-1">
        <label for="foreclosureNotes" class="wys-label">{t("editor.fcNotes")}</label>
        <textarea id="foreclosureNotes" name="foreclosureNotes" rows="3" class="wys wys-sm min-h-24 w-full" disabled></textarea>
      </div>
    </fieldset>
  </div>

  {/* Anbieter-Sidebar 1:1 wie auf der Detailseite - die Daten kommen aus dem
      Benutzerprofil (so erscheinen sie auch im veroeffentlichten Inserat).
      Statt der Kontakt-CTAs stehen hier die Speichern/Abbrechen-Aktionen. */}
  <aside class="wys-rise self-start rounded-lg border border-border bg-card p-5 shadow-sm lg:sticky lg:top-20" style="--rise: 0.12s">
    <p class="text-sm text-muted-foreground">{t("editor.sellerLabel")}</p>
    <h2 class="mt-1 text-xl font-bold" data-preview-seller-name>{t("editor.sellerNamePlaceholder")}</h2>
    <p class="mt-2 text-sm text-muted-foreground" data-preview-seller-meta>{t("editor.sellerTypePrivate")}</p>
    <p class="mt-2 text-sm text-muted-foreground">{t("editor.updatedToday")}</p>
    <div class="mt-5 space-y-3">
      <div class="rounded-md bg-muted p-3 text-sm">
        <p class="font-semibold" data-preview-seller-name>{t("editor.sellerNamePlaceholder")}</p>
        <p class="mt-1 truncate text-muted-foreground" data-preview-seller-email>{t("editor.sellerEmailPlaceholder")}</p>
      </div>
    </div>
    <p class="mt-3 text-xs text-muted-foreground" data-preview-seller-hint>{t("editor.sellerHint")}</p>
    <div class="mt-5 grid gap-2">
      <Button type="submit" class="w-full">{submitLabel}</Button>
      <Button href={cancelHref} variant="outline" class="w-full">{t("common.cancel")}</Button>
    </div>
    <p class="mt-3 hidden text-sm" data-form-status></p>
  </aside>
</form>

<style>
  /* Editierbare Anzeige-Felder: opakes Papier (keine durchscheinenden
     Bretterfugen!), gestrichelte Kante als "hier ausfuellen"-Affordance,
     die bei Hover/Fokus fest wird und das Feld leicht anhebt. */
  .wys {
    background-color: var(--card);
    border: 1px dashed var(--input);
    border-radius: 0.375rem;
    padding: 0.35rem 0.6rem;
    color: var(--foreground);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.25s ease,
      transform 0.2s ease;
  }
  .wys::placeholder {
    color: var(--muted-foreground);
    opacity: 0.75;
  }
  /* Aktiv-Zustaende bewusst NEUTRAL (Foreground statt Markenrot/--outline):
     rote Raender/Labels an Eingabefeldern lesen sich als Validierungsfehler
     (Kundenfeedback 17.7.). Gilt auch fuer die Text-Selektion in den Feldern. */
  .wys:hover {
    border-style: solid;
    border-color: color-mix(in oklab, var(--foreground) 35%, var(--input));
  }
  .wys:focus-visible {
    outline: none;
    border-style: solid;
    border-color: var(--foreground);
    background-color: var(--popover);
    box-shadow:
      0 0 0 3px color-mix(in oklab, var(--foreground) 18%, transparent),
      var(--zettel-shadow);
    transform: translateY(-1px);
  }
  .wys::selection,
  .wys-bare::selection {
    background-color: color-mix(in oklab, var(--foreground) 20%, transparent);
  }
  .wys-sm {
    padding: 0.3rem 0.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .wys-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  /* Felder in Kacheln: nur eine gestrichelte Grundlinie, die Kachel selbst
     reagiert auf Fokus (Anheben + Zettel-Schatten). */
  .wys-bare {
    background-color: transparent;
    border: 0;
    border-bottom: 1px dashed var(--input);
    border-radius: 0;
    padding: 0 0 2px;
    color: inherit;
    transition: border-color 0.2s ease;
  }
  .wys-bare::placeholder {
    color: var(--muted-foreground);
    opacity: 0.6;
  }
  .wys-bare:hover {
    border-bottom-style: solid;
  }
  .wys-bare:focus-visible {
    outline: none;
    border-bottom: 2px solid var(--foreground);
    padding-bottom: 1px;
    /* @tailwindcss/forms wuerde sonst seinen blauen Fokus-Ring zeichnen */
    box-shadow: none;
  }
  .wys-tile {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.2s ease;
  }
  .wys-tile:focus-within {
    border-color: var(--foreground);
    transform: translateY(-2px);
    box-shadow: var(--zettel-shadow);
  }
  .wys-tile:focus-within label {
    color: var(--foreground);
  }

  /* Zahlenfelder ohne Spinner - sie sollen wie Anzeige-Text wirken */
  .wys-bare::-webkit-outer-spin-button,
  .wys-bare::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .wys-bare[type="number"] {
    appearance: textfield;
    -moz-appearance: textfield;
  }

  /* Beschreibung waechst mit dem Inhalt (Browser ohne field-sizing behalten min-height) */
  .wys-grow {
    field-sizing: content;
  }

  /* Sanftes Aufsteigen der Bloecke beim Seitenaufbau */
  @media (prefers-reduced-motion: no-preference) {
    .wys-rise {
      animation: wys-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--rise, 0s);
    }
    @keyframes wys-rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wys,
    .wys-bare,
    .wys-tile {
      transition: none;
    }
  }
</style>

<script>
  import { t } from "@/i18n";
  import { readDebugApiUrl } from "@/lib/utils/debug-host";

  // Live-Vorschau: Typ-Badge, Ort-Badge, Merkmal-Chips,
  // Hero-Bild und Anbieter-Karte spiegeln Feldwerte bzw. Profildaten sofort
  // wider. Speichern/Bild-Handling uebernimmt PropertyStateScript (BaseLayout).
  //
  // Typ-Labels kommen aus den serverseitig gerenderten <option>-Texten
  // (GET /api/properties/types) - hier liegen nur noch die Badge-Farben,
  // denn Farb-Tokens sind Praesentation und damit Frontend-Sache.
  const TYPE_BADGE_CLASSES: Record<string, string[]> = {
    house: ["bg-type-haus", "text-white"],
    land: ["bg-type-grund", "text-white"],
    foreclosure: ["bg-brand", "text-brand-foreground"],
  };
  const DEFAULT_BADGE_CLASSES = ["bg-foreground", "text-background"];
  const ALL_BADGE_CLASSES = [...new Set([...Object.values(TYPE_BADGE_CLASSES).flat(), ...DEFAULT_BADGE_CLASSES])];

  // Gleiche Zuordnung wie getApiSellerLabel (live-api.ts) fuer Profil-SellerType
  const SELLER_TYPE_LABELS: Record<string, string> = {
    Private: t("editor.sellerTypePrivate"),
    Broker: t("editor.sellerTypeBroker"),
    Builder: t("editor.sellerTypeBuilder"),
    PropertyManager: t("editor.sellerTypeManager"),
  };

  const API_BASE_URL = readDebugApiUrl() || import.meta.env.PUBLIC_API_BASE_URL || "https://api.heimatplatz.at";
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function initWysiwygPreview(form: HTMLFormElement) {
    const field = (name: string) => {
      const el = form.elements.namedItem(name);
      return el instanceof HTMLInputElement || el instanceof HTMLSelectElement || el instanceof HTMLTextAreaElement
        ? el
        : null;
    };

    const typeSelect = field("propertyType");
    const typeBadge = form.querySelector<HTMLElement>("[data-preview-type-badge]");
    const cityBadge = form.querySelector<HTMLElement>("[data-preview-city]");
    const featureList = form.querySelector<HTMLElement>("[data-preview-features]");
    const featureStore = form.querySelector<HTMLInputElement>("[data-feature-store]");
    const featureInput = form.querySelector<HTMLInputElement>("[data-feature-input]");
    const heroImage = form.querySelector<HTMLImageElement>("[data-preview-hero]");
    const heroEmpty = form.querySelector<HTMLElement>("[data-preview-hero-empty]");
    const heroAdd = form.querySelector<HTMLElement>("[data-preview-hero-add]");
    const imageGrid = form.querySelector<HTMLElement>("[data-property-image-grid]");

    let lastFeatures = "";

    // Merkmale: hidden input "features" (kommagetrennt) ist die Quelle der
    // Wahrheit - so landen sie via FormData im Draft und in der API
    const parseFeatures = (value: string) =>
      [...new Set(value.split(",").map((feature) => feature.trim()).filter(Boolean))];

    const writeFeatures = (features: string[]) => {
      if (!featureStore) return;
      featureStore.value = features.join(", ");
      update();
    };

    const addFeatures = (raw: string) => {
      if (!featureStore) return;
      const additions = parseFeatures(raw);
      if (additions.length === 0) return;
      writeFeatures(parseFeatures(`${featureStore.value},${additions.join(",")}`));
    };

    const update = () => {
      const type = typeSelect?.value || "house";
      const typeLabel = (typeSelect instanceof HTMLSelectElement ? typeSelect.selectedOptions[0]?.textContent : null)?.trim() ?? "";
      if (typeBadge) {
        typeBadge.classList.remove(...ALL_BADGE_CLASSES);
        typeBadge.classList.add(...(TYPE_BADGE_CLASSES[type] ?? DEFAULT_BADGE_CLASSES));
      }

      const city = field("city")?.value.trim() ?? "";
      if (cityBadge) {
        const text = city || t("editor.cityLabel");
        if (cityBadge.textContent !== text) cityBadge.textContent = text;
      }

      const living = field("livingArea");
      const livingValue = living && !living.disabled ? Number(living.value) : 0;
      const plotValue = Number(field("plotArea")?.value ?? "");
      const area =
        livingValue > 0
          ? t("editor.areaLiving", { value: livingValue })
          : plotValue > 0
            ? t("editor.areaPlot", { value: plotValue })
            : "";

      // Eigene Merkmale (editierbar); ohne eigene zeigt das Inserat den
      // automatischen Fallback aus Typ/Ort/Flaeche - wie die echte Detailseite
      const userFeatures = featureStore ? parseFeatures(featureStore.value) : [];
      const isAutoChips = userFeatures.length === 0;
      const chips = isAutoChips ? [typeLabel, city, area].filter(Boolean) : userFeatures;
      const chipKey = `${isAutoChips ? "auto" : "user"}:${chips.join("|")}`;
      if (featureList && chipKey !== lastFeatures) {
        lastFeatures = chipKey;
        featureList.textContent = "";
        for (const chip of chips) {
          const item = document.createElement("li");
          item.className = "flex items-center justify-between gap-2 rounded-md bg-muted px-4 py-3 text-sm";
          const label = document.createElement("span");
          label.textContent = chip;
          item.append(label);
          if (isAutoChips) {
            item.classList.add("opacity-80");
          } else {
            const remove = document.createElement("button");
            remove.type = "button";
            remove.className = "shrink-0 text-base leading-none text-muted-foreground transition-colors hover:text-foreground";
            remove.setAttribute("aria-label", t("editor.removeFeature", { feature: chip }));
            remove.textContent = "×";
            remove.addEventListener("click", () => {
              writeFeatures(parseFeatures(featureStore?.value ?? "").filter((feature) => feature !== chip));
            });
            item.append(remove);
          }
          featureList.append(item);
        }
      }
    };

    const updateHero = () => {
      if (!heroImage || !heroEmpty || !heroAdd) return;
      const firstImage = imageGrid?.querySelector("img");
      if (firstImage) {
        if (heroImage.src !== firstImage.src) {
          heroImage.src = firstImage.src;
          if (!reduceMotion) heroImage.animate([{ opacity: 0.4 }, { opacity: 1 }], { duration: 350, easing: "ease-out" });
        }
        heroImage.classList.remove("hidden");
        heroEmpty.classList.add("hidden");
        heroAdd.classList.remove("hidden");
        heroAdd.classList.add("inline-flex");
      } else {
        heroImage.classList.add("hidden");
        heroImage.removeAttribute("src");
        heroEmpty.classList.remove("hidden");
        heroAdd.classList.add("hidden");
        heroAdd.classList.remove("inline-flex");
      }
    };

    featureInput?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== ",") return;
      // Enter wuerde sonst das Formular absenden
      event.preventDefault();
      addFeatures(featureInput.value);
      featureInput.value = "";
    });
    featureInput?.addEventListener("blur", () => {
      addFeatures(featureInput.value);
      featureInput.value = "";
    });

    form.addEventListener("input", update);
    form.addEventListener("change", update);
    // Entwurf-/Inserat-Prefill schreibt Felder programmatisch (ohne Events) -
    // ein leichter Watcher haelt die Vorschau trotzdem aktuell.
    window.setInterval(update, 800);
    if (imageGrid) new MutationObserver(updateHero).observe(imageGrid, { childList: true });

    update();
    updateHero();
    void initSellerPreview(form);
  }

  // Anbieter-Karte: zeigt die Profildaten, die auch im veroeffentlichten
  // Inserat als Anbieter erscheinen (Session sofort, Profil-API fuer
  // Firmenname/Anbietertyp nachgezogen; ohne Login bleiben Platzhalter).
  async function initSellerPreview(form: HTMLFormElement) {
    const nameTargets = form.querySelectorAll<HTMLElement>("[data-preview-seller-name]");
    const emailTarget = form.querySelector<HTMLElement>("[data-preview-seller-email]");
    const metaTarget = form.querySelector<HTMLElement>("[data-preview-seller-meta]");
    const hintTarget = form.querySelector<HTMLElement>("[data-preview-seller-hint]");

    let session: { AccessToken?: string; FullName?: string; Email?: string } | null = null;
    try {
      session = JSON.parse(window.localStorage.getItem("heimatplatz:session") ?? "null");
    } catch {
      session = null;
    }

    if (!session?.AccessToken) {
      if (hintTarget) hintTarget.textContent = t("editor.loginHint");
      return;
    }

    const apply = (name: string | null | undefined, email: string | null | undefined, sellerType: string | null | undefined) => {
      if (name) nameTargets.forEach((target) => { target.textContent = name; });
      if (email && emailTarget) emailTarget.textContent = email;
      if (metaTarget) metaTarget.textContent = SELLER_TYPE_LABELS[sellerType ?? ""] ?? t("editor.sellerTypePrivate");
    };

    apply(session.FullName, session.Email, null);

    try {
      const response = await fetch(new URL("/api/auth/profile", API_BASE_URL), {
        headers: { Authorization: `Bearer ${session.AccessToken}` },
      });
      if (!response.ok) return;
      const profile = await response.json() as { FullName?: string; Email?: string; CompanyName?: string | null; SellerType?: string | null };
      apply(profile.CompanyName || profile.FullName, profile.Email, profile.SellerType);
    } catch {
      // Session-Daten reichen als Vorschau
    }
  }

  const wysiwygForm = document.querySelector<HTMLFormElement>("[data-wysiwyg-property]");
  if (wysiwygForm) initWysiwygPreview(wysiwygForm);
</script>
