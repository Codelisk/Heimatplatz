---
import MapIcon from "@tabler/icons/outline/map-2.svg";
import { fetchOrtRegions } from "@/features/locations/live-api";
import { jsonForScriptTag } from "@/lib/utils/json";
import { t } from "@/i18n";

/**
 * "Faltkarte": Kartenansicht der Immobiliensuche als Aushang an der Anschlagtafel.
 * Seit Phase 2 rendert MapLibre GL die Karte (lazy geladen beim ersten Oeffnen):
 * eigener Papier-Stil aus den Heimatplatz-Tokens (map-style.ts), selbst gehostete
 * PMTiles von der eigenen Origin (Range-Requests via Caddy, CSP bleibt 'self').
 * Ohne erreichbare Tiles faellt der Stil auf die gezeichnete Papierkarte zurueck
 * (Landesgrenze/Donau/Seen als GeoJSON im Bundle) - frei zoombar bleibt sie trotzdem.
 *
 * Interaktion: Bezirks-Cluster (Stempel) bis Zoom ~9, darueber Preis-Schilder.
 * Stempel-Klick zoomt auf den Bezirk UND setzt den bestehenden Region-Filter
 * (ort-picker-change) - die Trefferliste folgt dem Kartenausschnitt, es gibt
 * kein zweites Filtersystem. Filter-Sync via "property-search-query-changed".
 */

// municipalityId -> Bezirk fuer die Cluster-Gruppierung (gleiche Quelle wie der
// OrtPicker, TTL-gecacht; Slugs identisch zu ortSlugMap -> Region-Filter passt)
const regions = await fetchOrtRegions();
const municipalityRegionMap: Record<string, { name: string; slug: string }> = {};
for (const region of regions) {
  for (const locality of region.localities) {
    for (const id of locality.municipalityIds) {
      municipalityRegionMap[id] = { name: region.name, slug: region.slug };
    }
  }
}
---

<section data-map-stage class="hpmap-stage">
  <div class="hpmap-collapse" id="property-map" role="region" aria-label={t("search.mapRegionLabel")}>
    <div class="hpmap-clip">
      <div class="hpmap-frame mx-auto max-w-3xl px-3 pb-5 pt-4 sm:px-5">
        <div class="hpmap-sheet">
          <div class="hpmap-canvas" data-map-canvas>
            <div class="hpmap-maplibre" data-map-gl></div>

            {/* Falz-Spuren: die Karte bleibt erkennbar eine gefaltete Karte */}
            <div class="hpmap-falz" aria-hidden="true"><i class="v1"></i><i class="v2"></i><i class="h1"></i></div>

            {/* Falt-Animation: zwei Papierbahnen klappen nacheinander auf */}
            <div class="hpmap-fold" data-fold-anim aria-hidden="true">
              <div class="hpmap-flap hpmap-flap-top" data-flap-top></div>
              <div class="hpmap-flap hpmap-flap-bottom" data-flap-bottom></div>
            </div>

            <div class="hpmap-cartouche hpmap-fade" aria-hidden="true">
              <div class="hpmap-cartouche-title">{t("search.mapCartoucheTitle")}</div>
              <div class="hpmap-cartouche-count" data-map-cartouche-count></div>
              <div class="hpmap-legend">
                <span class="hpmap-legend-row"><i class="hpmap-dot hpmap-dot-haus"></i>{t("filter.typeHouse")}</span>
                <span class="hpmap-legend-row"><i class="hpmap-dot hpmap-dot-grund"></i>{t("filter.typeLand")}</span>
                <span class="hpmap-legend-row"><i class="hpmap-dot hpmap-dot-zv"></i>{t("filter.typeForeclosure")}</span>
              </div>
            </div>

            <button type="button" class="hpmap-back" data-map-back>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
              {t("search.mapBackToOverview")}
            </button>

            {/* Vollbild-Modus (mobil): eigener Schliessen-Button oben rechts */}
            <button type="button" class="hpmap-close lg:hidden" data-map-close aria-label={t("search.mapClose")}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg>
            </button>

            <p class="hpmap-status" data-map-status hidden></p>
          </div>
        </div>
        <p class="hpmap-note" data-map-note hidden></p>
      </div>
    </div>

    {/* Mini-Zettel als Bottom-Sheet (mobil) - Inhalt kommt aus buildPopupContent */}
    <div class="hpmap-bottomsheet lg:hidden" data-map-bottomsheet aria-live="polite"></div>
  </div>

  {/* Schwebende Karte-Pille (mobil, Airbnb-Muster) - verschwindet bei offener Karte */}
  <button type="button" class="hpmap-pill lg:hidden" data-map-pill aria-controls="property-map" aria-expanded="false">
    <MapIcon class="size-4" aria-hidden="true" />
    {t("search.mapToggle")}
  </button>
</section>
<script is:inline type="application/json" data-municipality-region-map set:html={jsonForScriptTag(municipalityRegionMap)} />

<style is:global>
  /* Faltkarte - globale Styles (Marker/Popup entstehen per JS bzw. MapLibre und
     haetten keine Astro-Scoped-Attribute). Alles unter .hpmap- Prefix. */

  .hpmap-collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .hpmap-stage.open .hpmap-collapse { grid-template-rows: 1fr; }
  .hpmap-clip { overflow: hidden; min-height: 0; }

  .hpmap-sheet {
    --hpmap-ink: color-mix(in oklab, var(--foreground) 88%, transparent);
    position: relative;
    background: var(--card);
    border: 1px solid var(--zettel-rand);
    border-radius: var(--radius);
    box-shadow: var(--zettel-shadow);
    outline: 1px solid var(--zettel-frame);
    outline-offset: -7px;
  }

  .hpmap-canvas { position: relative; overflow: hidden; border-radius: var(--radius); }
  /* Seitenverhaeltnis der OÖ-Geografie (breitenkorrigiert), wie die Phase-1-SVG */
  .hpmap-maplibre { width: 100%; aspect-ratio: 1000 / 883; background: var(--card); }
  .hpmap-maplibre .maplibregl-canvas { outline: none; }

  /* MapLibre-Chrome in Zettel-Optik */
  .hpmap-canvas .maplibregl-ctrl-group {
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: 0 3px 8px -3px oklch(0.25 0.04 55 / 40%);
    border: 1px solid color-mix(in oklab, var(--hpmap-ink) 25%, transparent);
    overflow: hidden;
  }
  .hpmap-canvas .maplibregl-ctrl-group button { background: transparent; }
  .hpmap-canvas .maplibregl-ctrl-group button + button {
    border-top: 1px solid color-mix(in oklab, var(--hpmap-ink) 18%, transparent);
  }
  .dark .hpmap-canvas .maplibregl-ctrl button.maplibregl-ctrl-zoom-in .maplibregl-ctrl-icon,
  .dark .hpmap-canvas .maplibregl-ctrl button.maplibregl-ctrl-zoom-out .maplibregl-ctrl-icon {
    filter: invert(1);
  }
  .hpmap-canvas .maplibregl-ctrl-attrib {
    background: color-mix(in oklab, var(--card) 80%, transparent);
    color: var(--muted-foreground);
    font-size: 10px;
  }
  .hpmap-canvas .maplibregl-ctrl-attrib a { color: var(--muted-foreground); }

  .hpmap-falz { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .hpmap-falz i { position: absolute; display: block; }
  .hpmap-falz .v1, .hpmap-falz .v2 {
    top: 0; bottom: 0; width: 14px;
    background: linear-gradient(90deg, transparent, oklch(0.3 0.03 55 / 7%) 50%, transparent);
  }
  .hpmap-falz .v1 { left: calc(33.3% - 7px); }
  .hpmap-falz .v2 { left: calc(66.6% - 7px); }
  .hpmap-falz .h1 {
    left: 0; right: 0; height: 14px; top: calc(50% - 7px);
    background: linear-gradient(180deg, transparent, oklch(0.3 0.03 55 / 8%) 50%, transparent);
  }

  /* Falt-Animation */
  .hpmap-fold { position: absolute; inset: 0; display: none; perspective: 1400px; pointer-events: none; z-index: 6; }
  .hpmap-stage.folding .hpmap-fold { display: block; }
  .hpmap-stage.folding .hpmap-fade,
  .hpmap-stage.folding .hpmap-pin,
  .hpmap-stage.folding .hpmap-cluster { opacity: 0; }
  .hpmap-flap { position: absolute; left: 0; right: 0; height: 50%; overflow: hidden; backface-visibility: hidden; background: var(--card); }
  .hpmap-flap::before {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, transparent calc(33.3% - 7px), oklch(0.3 0.03 55 / 7%) 33.3%, transparent calc(33.3% + 7px)),
      linear-gradient(90deg, transparent calc(66.6% - 7px), oklch(0.3 0.03 55 / 7%) 66.6%, transparent calc(66.6% + 7px));
  }
  .hpmap-flap-top { top: 0; transform-origin: top center; animation: hpmap-unfold 0.42s cubic-bezier(0.25, 0.7, 0.3, 1) both; }
  .hpmap-flap-bottom { top: 50%; transform-origin: top center; animation: hpmap-unfold 0.42s 0.4s cubic-bezier(0.25, 0.7, 0.3, 1) both; }
  .hpmap-flap::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, oklch(0.2 0.02 55 / 45%), transparent 80%);
  }
  .hpmap-flap-top::after { animation: hpmap-shade 0.42s ease-out both; }
  .hpmap-flap-bottom::after { animation: hpmap-shade 0.42s 0.4s ease-out both; }
  @keyframes hpmap-unfold { from { transform: rotateX(-86deg); } to { transform: none; } }
  @keyframes hpmap-shade { from { opacity: 1; } to { opacity: 0; } }

  .hpmap-fade { transition: opacity 0.25s ease; }

  /* Marker-Ebenen: Bezirks-Stempel (Uebersicht) vs. Preis-Schilder (ab Zoom ~9).
     MapLibre-Marker sind DOM-Kinder des Karten-Containers - die Stage-Klassen
     schalten per CSS um, die Marker selbst bleiben bestehen. */
  .maplibregl-marker { z-index: 3; }
  .hpmap-cluster, .hpmap-pin { transition: opacity 0.25s ease, transform 0.18s cubic-bezier(0.3, 0.7, 0.3, 1.4); }
  .hpmap-stage.zoomed .hpmap-cluster { opacity: 0 !important; pointer-events: none; }
  .hpmap-pin { opacity: 0; pointer-events: none; }
  .hpmap-stage.zoomed .hpmap-pin { opacity: 1; pointer-events: auto; }

  .hpmap-cluster {
    display: grid; place-items: center; position: relative;
    width: var(--s, 38px); height: var(--s, 38px);
    font-weight: 700; font-size: calc(var(--s, 38px) * 0.34);
    font-variant-numeric: tabular-nums;
    color: var(--card-foreground);
    background: var(--card);
    border: 1.5px solid color-mix(in oklab, var(--hpmap-ink) 55%, transparent);
    border-radius: 999px;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--card) 80%, transparent),
                0 4px 10px -4px oklch(0.25 0.04 55 / 40%);
    cursor: zoom-in;
    opacity: 0;
    transform: scale(0.6);
  }
  .hpmap-stage.unfolded .hpmap-cluster {
    opacity: 1;
    transform: scale(1);
    transition-delay: calc(var(--i) * 28ms), calc(var(--i) * 28ms);
  }
  .hpmap-stage.unfolded .hpmap-cluster:hover {
    transform: scale(1.12);
    border-color: var(--primary);
    transition-delay: 0ms;
  }
  .hpmap-cluster-label {
    position: absolute; top: calc(100% + 4px); left: 50%; transform: translateX(-50%);
    font-size: 9px; font-weight: 650; letter-spacing: 0.09em; text-transform: uppercase;
    color: color-mix(in oklab, var(--hpmap-ink) 75%, transparent);
    white-space: nowrap; pointer-events: none;
    text-shadow: 0 0 4px var(--card), 0 0 8px var(--card);
  }

  .hpmap-pin {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 11.5px; font-weight: 700; font-variant-numeric: tabular-nums;
    color: var(--card-foreground);
    background: var(--card);
    border: 1px solid color-mix(in oklab, var(--hpmap-ink) 45%, transparent);
    border-radius: 999px; padding: 3px 9px 3px 7px;
    box-shadow: 0 3px 8px -3px oklch(0.25 0.04 55 / 45%);
    cursor: pointer; white-space: nowrap;
  }
  .hpmap-pin:hover { transform: scale(1.09); box-shadow: var(--zettel-shadow-hover); }
  .hpmap-pin.aktiv {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--primary) 45%, transparent), var(--zettel-shadow-hover);
  }
  .hpmap-dot { width: 8px; height: 8px; border-radius: 999px; flex: none; display: inline-block; }
  .hpmap-dot-haus { background: var(--type-haus); }
  .hpmap-dot-grund { background: var(--type-grund); }
  .hpmap-dot-zv { background: var(--brand); }
  .hpmap-pin--zv { background: var(--brand); color: var(--brand-foreground); border-color: var(--brand); }
  .hpmap-pin--zv .hpmap-dot-zv { background: var(--brand-foreground); }

  .hpmap-back {
    position: absolute; right: 12px; top: 12px; z-index: 5;
    display: none; align-items: center; gap: 0.4rem;
    font-size: 0.8rem; font-weight: 600; color: var(--foreground);
    background: var(--card);
    border: 1px solid color-mix(in oklab, var(--hpmap-ink) 35%, transparent);
    border-radius: 999px; padding: 0.3rem 0.85rem; cursor: zoom-out;
    box-shadow: 0 3px 8px -3px oklch(0.25 0.04 55 / 40%);
  }
  .hpmap-stage.zoomed .hpmap-back { display: inline-flex; }

  .hpmap-cartouche {
    position: absolute; left: 2.6%; top: 4%; z-index: 3;
    background: color-mix(in oklab, var(--card) 88%, transparent);
    border: 1px solid color-mix(in oklab, var(--hpmap-ink) 32%, transparent);
    border-radius: 3px; padding: 0.5rem 0.75rem 0.55rem;
    box-shadow: 0 2px 8px -4px oklch(0.25 0.04 55 / 30%);
    pointer-events: none;
  }
  .hpmap-stage.zoomed .hpmap-cartouche { opacity: 0; }
  .hpmap-cartouche-title { font-size: 0.72rem; font-weight: 750; letter-spacing: 0.16em; color: var(--hpmap-ink); }
  .hpmap-cartouche-count {
    font-size: 0.64rem; letter-spacing: 0.06em; color: var(--muted-foreground);
    margin-top: 1px; font-variant-numeric: tabular-nums;
  }
  .hpmap-legend { display: grid; gap: 2px; margin-top: 0.45rem; }
  .hpmap-legend-row { display: flex; align-items: center; gap: 0.4rem; font-size: 0.66rem; color: var(--muted-foreground); }

  /* Mini-Zettel als MapLibre-Popup */
  .hpmap-glpopup { z-index: 7; }
  .hpmap-glpopup .maplibregl-popup-content {
    padding: 0; width: 200px; overflow: hidden;
    background: var(--card); color: var(--card-foreground);
    border: 1px solid var(--zettel-rand); border-radius: var(--radius);
    box-shadow: var(--zettel-shadow-hover);
    font-size: 0.8rem; line-height: 1.45;
  }
  .hpmap-glpopup.maplibregl-popup-anchor-bottom .maplibregl-popup-tip { border-top-color: var(--card); }
  .hpmap-glpopup.maplibregl-popup-anchor-top .maplibregl-popup-tip { border-bottom-color: var(--card); }
  .hpmap-glpopup.maplibregl-popup-anchor-left .maplibregl-popup-tip { border-right-color: var(--card); }
  .hpmap-glpopup.maplibregl-popup-anchor-right .maplibregl-popup-tip { border-left-color: var(--card); }
  .hpmap-popup-foto { display: block; width: 100%; height: 72px; object-fit: cover; background: var(--muted); }
  .hpmap-popup-inner { padding: 0.5rem 0.7rem 0.65rem; }
  .hpmap-popup-title { font-weight: 700; font-size: 0.82rem; line-height: 1.3; margin: 0; }
  .hpmap-popup-ort { font-size: 0.72rem; color: var(--muted-foreground); margin: 0; }
  .hpmap-popup-preis { font-weight: 750; color: var(--price); font-variant-numeric: tabular-nums; margin: 0.2rem 0 0; }
  .hpmap-popup-zv { font-size: 0.7rem; font-weight: 700; color: var(--primary); margin: 0.15rem 0 0; }
  .hpmap-popup-approx { font-size: 0.68rem; color: var(--muted-foreground); margin: 0.15rem 0 0; }
  .hpmap-popup-cta { display: inline-block; margin-top: 0.45rem; font-size: 0.75rem; font-weight: 700; color: var(--primary); }
  .hpmap-popup-close {
    position: absolute; right: 5px; top: 5px; z-index: 1;
    display: grid; place-items: center; width: 20px; height: 20px;
    background: oklch(0.2 0.02 55 / 55%); color: #fff; border: none; border-radius: 999px;
    cursor: pointer; font-size: 11px; line-height: 1;
  }

  .hpmap-status {
    position: absolute; inset: auto 0 0 0; z-index: 5; margin: 0;
    padding: 0.5rem 1rem; text-align: center;
    font-size: 0.8rem; color: var(--muted-foreground);
    background: color-mix(in oklab, var(--card) 85%, transparent);
  }
  .hpmap-note { margin: 0.6rem 0 0; text-align: center; font-size: 0.78rem; color: var(--muted-foreground); }

  /* Schwebende Karte-Pille (mobil): dunkle Pille unten mittig, verschwindet
     bei offener Karte. bg/fg invertiert = passt sich beiden Themes an. */
  .hpmap-pill {
    position: fixed;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    /* Anzeige kommt aus der max-lg-Media-Query unten - ein display hier wuerde
       das lg:hidden-Utility bei gleicher Spezifitaet per Quellreihenfolge schlagen */
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    background: var(--foreground);
    color: var(--background);
    font-size: 0.9rem;
    font-weight: 700;
    box-shadow: 0 10px 26px -10px oklch(0 0 0 / 55%);
    cursor: pointer;
  }
  .hpmap-stage.open .hpmap-pill { display: none; }

  /* Vollbild-Schliessen (mobil) - Anzeige nur in der max-lg-Media-Query */
  .hpmap-close {
    position: absolute;
    right: 12px;
    top: max(12px, env(safe-area-inset-top));
    z-index: 6;
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: var(--card);
    color: var(--foreground);
    border: 1px solid color-mix(in oklab, var(--hpmap-ink) 35%, transparent);
    box-shadow: 0 3px 8px -3px oklch(0.25 0.04 55 / 40%);
    cursor: pointer;
  }

  /* Mini-Zettel als Bottom-Sheet (mobil): schiebt von unten ein */
  .hpmap-bottomsheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: var(--card);
    color: var(--card-foreground);
    border-radius: 14px 14px 0 0;
    box-shadow: 0 -12px 34px -12px oklch(0 0 0 / 50%);
    padding-bottom: env(safe-area-inset-bottom);
    transform: translateY(110%);
    visibility: hidden;
    transition: transform 0.3s cubic-bezier(0.3, 0.7, 0.3, 1), visibility 0.3s;
  }
  .hpmap-bottomsheet.sichtbar { transform: none; visibility: visible; }
  .hpmap-bottomsheet::before {
    content: "";
    display: block;
    width: 42px;
    height: 4px;
    margin: 0.5rem auto 0;
    border-radius: 999px;
    background: color-mix(in oklab, var(--foreground) 25%, transparent);
  }
  .hpmap-bottomsheet .hpmap-popup-foto { height: 150px; }
  .hpmap-bottomsheet .hpmap-popup-inner { padding: 0.75rem 1.1rem 1rem; font-size: 0.9rem; }
  .hpmap-bottomsheet .hpmap-popup-title { font-size: 1rem; }
  .hpmap-bottomsheet .hpmap-popup-ort { font-size: 0.8rem; }
  .hpmap-bottomsheet .hpmap-popup-preis { font-size: 1.05rem; }
  .hpmap-bottomsheet .hpmap-popup-cta { font-size: 0.9rem; margin-top: 0.6rem; }
  .hpmap-bottomsheet .hpmap-popup-close { top: 12px; right: 12px; width: 26px; height: 26px; font-size: 13px; }

  /* Waehrend die Vollbildkarte offen ist, scrollt die Seite dahinter nicht */
  .hpmap-lock { overflow: hidden; }

  /* Mobil/Tablet (< lg): offene Karte als Vollbild-Overlay statt Inline-Panel */
  @media (max-width: 1023.98px) {
    .hpmap-pill { display: inline-flex; }
    .hpmap-stage.open .hpmap-pill { display: none; }
    .hpmap-close { display: grid; }
    .hpmap-stage.open .hpmap-collapse {
      position: fixed;
      inset: 0;
      z-index: 50;
      grid-template-rows: 1fr;
      transition: none;
      background: var(--background);
    }
    .hpmap-stage.open .hpmap-frame {
      height: 100%;
      max-width: none;
      padding: 0;
    }
    .hpmap-stage.open .hpmap-sheet {
      height: 100%;
      border: 0;
      border-radius: 0;
      outline: none;
      box-shadow: none;
    }
    .hpmap-stage.open .hpmap-canvas { height: 100%; border-radius: 0; }
    .hpmap-stage.open .hpmap-maplibre { height: 100%; aspect-ratio: auto; }
    .hpmap-stage.open .hpmap-note { display: none; }
    /* Zurueck-Button kollidiert oben rechts mit dem Schliessen-X */
    .hpmap-stage.open .hpmap-back { right: auto; left: 12px; top: max(12px, env(safe-area-inset-top)); }
  }

  /* Kleine Screens: Kartusche kompakt, Beschriftungen weg - die Stempel-Zahlen
     tragen die Information, alles andere wird auf 390px nur Kollisionsrauschen */
  @media (max-width: 640px) {
    .hpmap-legend { display: none; }
    .hpmap-cluster-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hpmap-collapse { transition: none; }
    .hpmap-flap-top, .hpmap-flap-bottom, .hpmap-flap-top::after, .hpmap-flap-bottom::after { animation: none; }
    .hpmap-fold { display: none !important; }
    .hpmap-cluster, .hpmap-stage.unfolded .hpmap-cluster, .hpmap-pin, .hpmap-fade { transition: none; }
  }
</style>

<script>
  import { t } from "@/i18n";
  import { formatApiPrice, getAuctionCountdownLabel } from "@/features/properties/format";
  import { readDebugApiUrl } from "@/lib/utils/debug-host";
  import { readAccessToken } from "@/lib/utils/access-token";
  import { buildMapPinsQuery, type ApiMapPin, type ApiMapPinsResponse } from "@/features/properties/map-pins";
  import type { Map as MapLibreMap, Marker as MapLibreMarker, Popup as MapLibrePopup } from "maplibre-gl";

  const stage = document.querySelector<HTMLElement>("[data-map-stage]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-map-toggle]");
  const glContainer = stage?.querySelector<HTMLElement>("[data-map-gl]");

  if (stage && toggle && glContainer) {
    const API_BASE_URL = readDebugApiUrl() || import.meta.env.PUBLIC_API_BASE_URL || "https://api.heimatplatz.at";
    // Tiles/Assets von der eigenen Origin (Caddy liefert PMTiles per Range-Request);
    // ohne hinterlegte Datei rendert map-style.ts die Papier-Fallback-Karte
    // Absolute URLs: MapLibre verlangt fuer sprite zwingend eine absolute URL
    const TILES_URL = new URL(import.meta.env.PUBLIC_MAP_TILES_URL || "/tiles/oberoesterreich.pmtiles", window.location.origin).href;
    const ASSETS_URL = new URL(import.meta.env.PUBLIC_MAP_ASSETS_URL || "/tiles/assets", window.location.origin).href;
    /** Ab diesem Zoom werden aus Bezirks-Stempeln einzelne Preis-Schilder */
    const PIN_MIN_ZOOM = 9;

    const statusEl = stage.querySelector<HTMLElement>("[data-map-status]")!;
    const noteEl = stage.querySelector<HTMLElement>("[data-map-note]")!;
    const cartoucheCount = stage.querySelector<HTMLElement>("[data-map-cartouche-count]")!;
    const backBtn = stage.querySelector<HTMLButtonElement>("[data-map-back]")!;
    const closeBtn = stage.querySelector<HTMLButtonElement>("[data-map-close]")!;
    const pillBtn = stage.querySelector<HTMLButtonElement>("[data-map-pill]")!;
    const bottomSheet = stage.querySelector<HTMLElement>("[data-map-bottomsheet]")!;
    // Unter lg: Vollbild-Overlay + Bottom-Sheet statt Inline-Panel + Popup
    const mobileQuery = window.matchMedia("(max-width: 1023.98px)");

    type RegionInfo = { name: string; slug: string };
    const municipalityRegionMap: Record<string, RegionInfo> = (() => {
      try {
        return JSON.parse(document.querySelector("[data-municipality-region-map]")?.textContent ?? "{}");
      } catch {
        return {};
      }
    })();

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let isOpen = false;
    /** 'bezirk' = Bezirks-Filter aktiv (Stempel-Klick), steuert die Filter-Kopplung */
    let mode: "over" | "bezirk" = "over";
    let savedRegionParam: string | null = null;
    let selfDispatchedOrtChange = false;
    let latestQuery = document.querySelector<HTMLElement>("[data-search-config]")?.dataset.latestQuery ?? "";
    let lastFetchedQuery: string | null = null;
    let pins: ApiMapPin[] = [];
    let fetchTimer: number | undefined;
    let foldTimer: number | undefined;
    let abortController: AbortController | null = null;

    // MapLibre wird erst beim ersten Oeffnen geladen (Bundle-Split)
    let maplibre: typeof import("maplibre-gl") | null = null;
    let buildStyle: ((dark: boolean) => import("maplibre-gl").StyleSpecification) | null = null;
    let map: MapLibreMap | null = null;
    let mapInitPromise: Promise<void> | null = null;
    let fitOverviewBounds: (() => void) | null = null;
    /** Waehrend fitBounds in den Bezirk faehrt, darf der Zoom-Handler nicht ausloesen */
    let bezirkFitting = false;
    let clusterMarkers: MapLibreMarker[] = [];
    let pinMarkers: MapLibreMarker[] = [];
    let popup: MapLibrePopup | null = null;
    let lastDark = document.documentElement.classList.contains("dark");

    function typeKey(type: ApiMapPin["Type"]): "haus" | "grund" | "zv" {
      if (type === "Land" || type === 1) return "grund";
      if (type === "Foreclosure" || type === 2) return "zv";
      return "haus";
    }

    function getDetailPath(id: string) {
      return `/immobilien/angebote/${encodeURIComponent(id)}/`;
    }

    async function checkTilesAvailable(): Promise<boolean> {
      try {
        const response = await fetch(TILES_URL, { headers: { Range: "bytes=0-127" } });
        return response.ok;
      } catch {
        return false;
      }
    }

    async function ensureMap(): Promise<void> {
      if (mapInitPromise) return mapInitPromise;
      mapInitPromise = (async () => {
        const [maplibreModule, pmtilesModule, styleModule] = await Promise.all([
          import("maplibre-gl"),
          import("pmtiles"),
          import("@/features/map/map-style"),
          import("maplibre-gl/dist/maplibre-gl.css"),
        ]);
        maplibre = maplibreModule;

        const protocol = new pmtilesModule.Protocol();
        maplibre.addProtocol("pmtiles", protocol.tile);

        const tilesAvailable = await checkTilesAvailable();
        buildStyle = (dark: boolean) =>
          styleModule.buildMapStyle({ dark, tilesAvailable, tilesUrl: TILES_URL, assetsUrl: ASSETS_URL });

        map = new maplibre.Map({
          container: glContainer!,
          style: buildStyle(lastDark),
          bounds: styleModule.OOE_BOUNDS,
          fitBoundsOptions: { padding: 24 },
          maxBounds: styleModule.OOE_MAX_BOUNDS,
          minZoom: 6.3,
          maxZoom: 16.5,
          attributionControl: { compact: true },
          // Seiten-Scroll nicht kapern: Zoomen per Strg+Scrollen bzw. zwei Fingern
          cooperativeGestures: true,
          locale: {
            "CooperativeGesturesHandler.WindowsHelpText": "Zoomen mit Strg + Scrollen",
            "CooperativeGesturesHandler.MacHelpText": "Zoomen mit ⌘ + Scrollen",
            "CooperativeGesturesHandler.MobileHelpText": "Verschieben mit zwei Fingern",
            "NavigationControl.ZoomIn": "Hineinzoomen",
            "NavigationControl.ZoomOut": "Herauszoomen",
            "AttributionControl.ToggleAttribution": "Quellenangabe umschalten",
          },
        });
        // unten links: oben links sitzt die Kartusche, unten rechts die Attribution
        map.addControl(new maplibre.NavigationControl({ showCompass: false }), "bottom-left");

        fitOverviewBounds = () =>
          map!.fitBounds(styleModule.OOE_BOUNDS, { padding: 24, duration: reducedMotion ? 0 : 600 });

        // Stempel bis PIN_MIN_ZOOM, darueber Preis-Schilder (CSS schaltet um).
        // Natuerlicher Rueckweg: wer unter die Stempel-Schwelle rauszoomt/pincht,
        // loest die Bezirks-Kopplung automatisch - man muss den Uebersicht-Button
        // nicht kennen. bezirkFitting schuetzt die Hinein-Animation (dort ist der
        // Zoom anfangs noch niedrig, waehrend mode schon 'bezirk' ist).
        map.on("zoom", () => {
          const zoomLevel = map!.getZoom();
          stage!.classList.toggle("zoomed", zoomLevel >= PIN_MIN_ZOOM);
          if (!bezirkFitting && mode === "bezirk" && zoomLevel < PIN_MIN_ZOOM - 0.2) {
            releaseBezirk();
          }
        });

        // Vollbild (mobil): Ein-Finger-Verschieben - die Zwei-Finger-Sperre schuetzt
        // nur eingebettete Karten vor gekapertem Seiten-Scroll, im Vollbild gibt es
        // keine Seite dahinter
        syncGestureMode();

        // Klick auf leere Karte schliesst das Bottom-Sheet (Marker-Klicks laufen
        // ueber eigene DOM-Elemente und loesen kein Karten-Click aus)
        map.on("click", () => {
          if (mobileQuery.matches) hidePopup();
        });

        // Container startet zusammengeklappt (Hoehe 0) und aendert sich mit dem
        // Aufklappen/Umbruechen - MapLibre beobachtet nur window-Resizes selbst
        new ResizeObserver(() => map?.resize()).observe(glContainer!);

        // Theme-Wechsel: Stil neu setzen, Marker (DOM-Overlays) bleiben erhalten
        new MutationObserver(() => {
          const dark = document.documentElement.classList.contains("dark");
          if (dark !== lastDark && map && buildStyle) {
            lastDark = dark;
            map.setStyle(buildStyle(dark));
          }
        }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

        await new Promise<void>((resolve) => map!.once("load", () => resolve()));
        render();
      })();
      return mapInitPromise;
    }

    function hidePopup() {
      popup?.remove();
      popup = null;
      bottomSheet.classList.remove("sichtbar");
      pinMarkers.forEach((marker) => marker.getElement().firstElementChild?.classList.remove("aktiv"));
    }

    function buildPopupContent(pin: ApiMapPin): HTMLElement {
      const content = document.createElement("div");

      if (pin.ImageUrl) {
        const img = document.createElement("img");
        img.className = "hpmap-popup-foto";
        img.alt = "";
        img.loading = "lazy";
        img.src = pin.ImageUrl;
        img.addEventListener("error", () => img.remove());
        content.append(img);
      }

      const close = document.createElement("button");
      close.type = "button";
      close.className = "hpmap-popup-close";
      close.setAttribute("aria-label", t("search.mapPopupClose"));
      close.textContent = "✕";
      close.addEventListener("click", (event) => {
        event.stopPropagation();
        hidePopup();
      });
      content.append(close);

      const inner = document.createElement("div");
      inner.className = "hpmap-popup-inner";
      const title = document.createElement("p");
      title.className = "hpmap-popup-title";
      title.textContent = pin.Title;
      const ort = document.createElement("p");
      ort.className = "hpmap-popup-ort";
      ort.textContent = `${pin.PostalCode} ${pin.City}`;
      const preis = document.createElement("p");
      preis.className = "hpmap-popup-preis";
      preis.textContent = formatApiPrice(pin.Price);
      inner.append(title, ort, preis);

      const countdown = typeKey(pin.Type) === "zv" ? getAuctionCountdownLabel(pin.AuctionDate) : null;
      if (countdown) {
        const zv = document.createElement("p");
        zv.className = "hpmap-popup-zv";
        zv.textContent = countdown;
        inner.append(zv);
      }
      if (pin.IsApproximate) {
        const approx = document.createElement("p");
        approx.className = "hpmap-popup-approx";
        approx.textContent = t("search.mapApproxHint");
        inner.append(approx);
      }

      const cta = document.createElement("a");
      cta.className = "hpmap-popup-cta";
      cta.href = getDetailPath(pin.Id);
      cta.textContent = `${t("search.mapOpenListing")} →`;
      inner.append(cta);
      content.append(inner);
      return content;
    }

    function showPopup(pin: ApiMapPin, marker: MapLibreMarker) {
      const mapRef = map;
      const libRef = maplibre;
      if (!mapRef || !libRef) return;
      hidePopup();
      marker.getElement().firstElementChild?.classList.add("aktiv");

      // Mobil: Bottom-Sheet statt Popup - am Pin verankerte Popups clippen auf
      // kleinen Screens staendig am Kartenrand
      if (mobileQuery.matches) {
        bottomSheet.replaceChildren(buildPopupContent(pin));
        bottomSheet.classList.add("sichtbar");
        return;
      }

      const nextPopup = new libRef.Popup({
        closeButton: false,
        offset: 16,
        maxWidth: "230px",
        className: "hpmap-glpopup",
      })
        .setLngLat(marker.getLngLat())
        .setDOMContent(buildPopupContent(pin))
        .addTo(mapRef);
      nextPopup.on("close", () => {
        pinMarkers.forEach((m) => m.getElement().firstElementChild?.classList.remove("aktiv"));
      });
      popup = nextPopup;
    }

    function render() {
      const mapRef = map;
      const libRef = maplibre;
      if (!mapRef || !libRef) return;
      hidePopup();
      clusterMarkers.forEach((marker) => marker.remove());
      pinMarkers.forEach((marker) => marker.remove());
      clusterMarkers = [];
      pinMarkers = [];

      // Preis-Schilder (einzelne Inserate)
      for (const pin of pins) {
        const el = document.createElement("button");
        el.type = "button";
        const key = typeKey(pin.Type);
        el.className = `hpmap-pin${key === "zv" ? " hpmap-pin--zv" : ""}`;
        const dot = document.createElement("i");
        dot.className = `hpmap-dot hpmap-dot-${key}`;
        el.append(dot, document.createTextNode(formatApiPrice(pin.Price)));
        el.setAttribute(
          "aria-label",
          t("search.mapPinAria", { title: pin.Title, location: `${pin.PostalCode} ${pin.City}`, price: formatApiPrice(pin.Price) }),
        );
        // Marker-Element als Wrapper, damit Hover-Transforms nicht mit MapLibres
        // eigenem translate() auf dem Marker-Element kollidieren
        const wrapper = document.createElement("div");
        wrapper.append(el);
        const marker = new libRef.Marker({ element: wrapper }).setLngLat([pin.Longitude, pin.Latitude]).addTo(mapRef);
        el.addEventListener("click", (event) => {
          event.stopPropagation();
          showPopup(pin, marker);
        });
        pinMarkers.push(marker);
      }

      // Bezirks-Stempel (Cluster) am Schwerpunkt der Bezirks-Pins
      const groups = new Map<string, { name: string; pins: ApiMapPin[] }>();
      for (const pin of pins) {
        const region = municipalityRegionMap[pin.MunicipalityId];
        const slug = region?.slug ?? "__other";
        const name = region?.name ?? t("search.mapOtherRegion");
        const group = groups.get(slug) ?? { name, pins: [] };
        group.pins.push(pin);
        groups.set(slug, group);
      }
      const entries = [...groups.entries()]
        .sort((a, b) => b[1].pins.length - a[1].pins.length)
        .map(([slug, group]) => {
          const count = group.pins.length;
          return {
            slug,
            group,
            count,
            lng: group.pins.reduce((sum, p) => sum + p.Longitude, 0) / count,
            lat: group.pins.reduce((sum, p) => sum + p.Latitude, 0) / count,
          };
        });

      // Entzerrung in Pixeln (Stadt Linz / Linz-Land liegen fast uebereinander):
      // Schwerpunkte projizieren, auseinanderschieben, zurueckprojizieren
      const projected = entries.map((entry) => mapRef.project([entry.lng, entry.lat]));
      for (let iteration = 0; iteration < 3; iteration++) {
        for (let i = 0; i < projected.length; i++) {
          for (let j = i + 1; j < projected.length; j++) {
            const dx = projected[j].x - projected[i].x;
            const dy = projected[j].y - projected[i].y;
            const distance = Math.hypot(dx, dy);
            const minDistance = 46;
            if (distance > 0 && distance < minDistance) {
              const push = (minDistance - distance) / 2;
              projected[i].x -= (dx / distance) * push;
              projected[i].y -= (dy / distance) * push;
              projected[j].x += (dx / distance) * push;
              projected[j].y += (dy / distance) * push;
            }
          }
        }
      }

      entries.forEach((entry, index) => {
        const position = mapRef.unproject(projected[index]);
        const el = document.createElement("button");
        el.type = "button";
        el.className = "hpmap-cluster";
        const size = entry.count >= 20 ? 48 : entry.count >= 8 ? 41 : 34;
        el.style.setProperty("--s", `${size}px`);
        el.style.setProperty("--i", String(index));
        el.setAttribute("aria-label", t("search.mapClusterAria", { region: entry.group.name, count: entry.count }));
        el.append(document.createTextNode(String(entry.count)));
        const label = document.createElement("span");
        label.className = "hpmap-cluster-label";
        label.textContent = entry.group.name;
        el.append(label);
        el.addEventListener("click", (event) => {
          event.stopPropagation();
          zoomToBezirk(entry.slug, entry.group.pins);
        });
        const wrapper = document.createElement("div");
        wrapper.append(el);
        clusterMarkers.push(new libRef.Marker({ element: wrapper }).setLngLat(position).addTo(mapRef));
      });

      statusEl.hidden = pins.length > 0;
      if (pins.length === 0) statusEl.textContent = t("search.mapEmpty");
      cartoucheCount.textContent = t("search.mapCartoucheCount", { count: pins.length });
    }

    function updateNote(payload: ApiMapPinsResponse) {
      const notes: string[] = [];
      const withoutCoordinates = payload.WithoutCoordinates ?? 0;
      if (withoutCoordinates > 0) notes.push(t("search.mapWithoutCoords", { count: withoutCoordinates }));
      if (payload.Truncated) notes.push(t("search.mapTruncated", { count: pins.length }));
      noteEl.hidden = notes.length === 0;
      noteEl.textContent = notes.join(" ");
    }

    async function fetchPins() {
      abortController?.abort();
      const controller = new AbortController();
      abortController = controller;

      const query = buildMapPinsQuery(latestQuery);
      try {
        const token = readAccessToken();
        const response = await fetch(`${API_BASE_URL}/api/properties/map-pins?${query}`, {
          signal: controller.signal,
          headers: token ? { Authorization: `Bearer ${token}` } : undefined,
        });
        if (!response.ok) throw new Error(`API ${response.status}`);
        const payload = (await response.json()) as ApiMapPinsResponse;
        if (controller.signal.aborted) return;

        lastFetchedQuery = latestQuery;
        pins = payload.Pins ?? [];
        render();
        updateNote(payload);
      } catch {
        if (controller.signal.aborted) return;
        statusEl.hidden = false;
        statusEl.textContent = t("search.mapLoadError");
      }
    }

    function scheduleFetch() {
      window.clearTimeout(fetchTimer);
      fetchTimer = window.setTimeout(() => void fetchPins(), 200);
    }

    function dispatchOrtChange(values: string[]) {
      selfDispatchedOrtChange = true;
      document.dispatchEvent(new CustomEvent("ort-picker-change", { detail: { name: "region", values } }));
      selfDispatchedOrtChange = false;
    }

    /** Bezirks-Kopplung loesen und den vorherigen Region-Filter wiederherstellen. */
    function releaseBezirk() {
      if (mode !== "bezirk") return;
      mode = "over";
      dispatchOrtChange(savedRegionParam ? savedRegionParam.split(",").filter(Boolean) : []);
      savedRegionParam = null;
    }

    /** Zwei-Finger-Sperre nur fuer die eingebettete Karte, nicht im Vollbild. */
    function syncGestureMode() {
      if (!map) return;
      const fullscreen = isOpen && mobileQuery.matches;
      if (fullscreen) map.cooperativeGestures.disable();
      else map.cooperativeGestures.enable();
    }

    function zoomToBezirk(slug: string, bezirkPins: ApiMapPin[]) {
      if (!map) return;
      if (mode === "over") {
        savedRegionParam = new URLSearchParams(window.location.search).get("region");
      }
      mode = "bezirk";
      hidePopup();

      const lngs = bezirkPins.map((p) => p.Longitude);
      const lats = bezirkPins.map((p) => p.Latitude);
      bezirkFitting = true;
      map.once("moveend", () => {
        bezirkFitting = false;
      });
      map.fitBounds(
        [
          [Math.min(...lngs), Math.min(...lats)],
          [Math.max(...lngs), Math.max(...lats)],
        ],
        { padding: 72, maxZoom: 12.5, duration: reducedMotion ? 0 : 600 },
      );

      // Liste folgt dem Kartenausschnitt: Bezirks-Slug ueber den bestehenden
      // Region-Filter anwenden (kein zweites Filtersystem). "__other" hat
      // keinen Slug - dann bleibt der Filter unveraendert, nur der Zoom greift.
      if (slug !== "__other") dispatchOrtChange([slug]);
    }

    function zoomToOverview(restoreFilter: boolean) {
      hidePopup();
      if (restoreFilter) {
        releaseBezirk();
      } else {
        mode = "over";
        savedRegionParam = null;
      }
      fitOverviewBounds?.();
    }

    function updateAnsichtParam(open: boolean) {
      const url = new URL(window.location.href);
      if (open) url.searchParams.set("ansicht", "karte");
      else url.searchParams.delete("ansicht");
      history.replaceState(null, "", url);
    }

    function openMap() {
      if (isOpen) return;
      isOpen = true;
      toggle!.setAttribute("aria-pressed", "true");
      toggle!.setAttribute("aria-expanded", "true");
      pillBtn.setAttribute("aria-expanded", "true");
      stage!.classList.add("open");
      // Vollbild-Overlay (mobil): Seite dahinter nicht mitscrollen lassen
      if (mobileQuery.matches) document.documentElement.classList.add("hpmap-lock");
      updateAnsichtParam(true);

      window.clearTimeout(foldTimer);
      if (reducedMotion) {
        stage!.classList.add("unfolded");
      } else {
        stage!.classList.remove("unfolded");
        stage!.classList.add("folding");
        foldTimer = window.setTimeout(() => {
          stage!.classList.remove("folding");
          stage!.classList.add("unfolded");
        }, 880);
      }

      void ensureMap()
        .then(() => syncGestureMode())
        .catch(() => {
          statusEl.hidden = false;
          statusEl.textContent = t("search.mapLoadError");
        });
      if (latestQuery !== lastFetchedQuery) scheduleFetch();
    }

    function closeMap() {
      if (!isOpen) return;
      isOpen = false;
      toggle!.setAttribute("aria-pressed", "false");
      toggle!.setAttribute("aria-expanded", "false");
      pillBtn.setAttribute("aria-expanded", "false");
      if (mode === "bezirk") zoomToOverview(true);
      stage!.classList.remove("open", "folding", "unfolded");
      document.documentElement.classList.remove("hpmap-lock");
      syncGestureMode();
      hidePopup();
      updateAnsichtParam(false);
    }

    toggle.addEventListener("click", () => (isOpen ? closeMap() : openMap()));
    pillBtn.addEventListener("click", openMap);
    closeBtn.addEventListener("click", closeMap);

    // Breakpoint-Wechsel bei offener Karte: Scroll-Lock/Gesten nur im Vollbild-Modus
    mobileQuery.addEventListener("change", () => {
      document.documentElement.classList.toggle("hpmap-lock", isOpen && mobileQuery.matches);
      if (!mobileQuery.matches) bottomSheet.classList.remove("sichtbar");
      syncGestureMode();
    });
    backBtn.addEventListener("click", (event) => {
      event.stopPropagation();
      zoomToOverview(true);
    });

    // Filter-Sync: PropertySearchApp meldet jeden neuen Listen-Query
    document.addEventListener("property-search-query-changed", (event) => {
      const detail = (event as CustomEvent<{ query: string }>).detail;
      if (typeof detail?.query !== "string") return;
      latestQuery = detail.query;
      if (isOpen) scheduleFetch();
    });

    // Fremder Ortsfilter-Wechsel (OrtPicker) waehrend des Bezirks-Zooms:
    // Kopplung loesen, ohne die neue Auswahl zu ueberschreiben
    document.addEventListener("ort-picker-change", (event) => {
      const detail = (event as CustomEvent<{ name: string }>).detail;
      if (selfDispatchedOrtChange || detail?.name !== "region") return;
      if (mode === "bezirk") {
        mode = "over";
        savedRegionParam = null;
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (popup || bottomSheet.classList.contains("sichtbar")) hidePopup();
      else if (mode === "bezirk") zoomToOverview(true);
      else if (isOpen && mobileQuery.matches) closeMap();
    });

    // Deep-Link ?ansicht=karte: Karte gleich aufklappen
    if (new URLSearchParams(window.location.search).get("ansicht") === "karte") {
      openMap();
    }
  }
</script>
