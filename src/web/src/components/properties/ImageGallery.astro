---
import ArrowsDiagonalIcon from "@tabler/icons/outline/arrows-diagonal.svg";
import ChevronLeftIcon from "@tabler/icons/outline/chevron-left.svg";
import ChevronRightIcon from "@tabler/icons/outline/chevron-right.svg";
import ExternalLinkIcon from "@tabler/icons/outline/external-link.svg";
import PhotoIcon from "@tabler/icons/outline/photo.svg";
import XIcon from "@tabler/icons/outline/x.svg";
import { t } from "@/i18n";
import { getOriginalProxyImage, getResponsiveImage, withProxyImageWidth } from "@/lib/images";
import { jsonForScriptTag } from "@/lib/utils/json";

interface Props {
  images: string[];
  title: string;
}

const FALLBACK_IMAGE = "/favicon.svg";

const { images, title } = Astro.props;

const items = images.map((url, index) => {
  const responsive = getResponsiveImage(url);
  return {
    thumb: responsive.src,
    thumbSrcset: responsive.srcset,
    preview: withProxyImageWidth(url, 320),
    full: getOriginalProxyImage(url),
    alt: t("gallery.imageAlt", { title, index: index + 1, count: images.length }),
  };
});

const hasImages = items.length > 0;
const sideItems = items.slice(1, 3);
const remainingCount = items.length - 3;
---

{
  !hasImages && (
    <div class="overflow-hidden rounded-xl bg-muted">
      <img
        src={FALLBACK_IMAGE}
        alt={title}
        class="h-[320px] w-full object-contain p-10 opacity-70 sm:h-[460px]"
        loading="eager"
        decoding="async"
      />
    </div>
  )
}

{
  hasImages && (
    <div data-image-gallery>
      <div
        class:list={[
          "grid gap-2 overflow-hidden rounded-xl",
          sideItems.length > 0 && "sm:h-[460px] sm:grid-cols-3 sm:grid-rows-2",
        ]}
      >
        <button
          type="button"
          class:list={[
            "group relative block h-[320px] w-full cursor-zoom-in overflow-hidden bg-muted text-left focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-foreground",
            sideItems.length > 0 ? "sm:col-span-2 sm:row-span-2 sm:h-full" : "sm:h-[460px]",
          ]}
          data-gallery-open="0"
          aria-label={t("gallery.openImageAria", { title, index: 1 })}
        >
          <img
            src={items[0].thumb}
            srcset={items[0].thumbSrcset}
            sizes="(min-width: 1024px) 600px, (min-width: 640px) 67vw, 100vw"
            alt={items[0].alt}
            class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
            loading="eager"
            decoding="async"
            data-fallback-image={FALLBACK_IMAGE}
            data-smart-image
          />
          <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
          <span class="pointer-events-none absolute bottom-3 right-3 inline-flex items-center gap-2 rounded-full bg-black/70 px-3.5 py-2 text-xs font-bold text-white backdrop-blur-sm transition-transform duration-300 group-hover:scale-105">
            <PhotoIcon class="size-4" aria-hidden="true" />
            {items.length === 1 ? t("gallery.viewPhoto") : t("gallery.allPhotos", { count: items.length })}
            <ArrowsDiagonalIcon class="size-4" aria-hidden="true" />
          </span>
        </button>

        {sideItems.map((item, index) => (
          <button
            type="button"
            class="group relative hidden cursor-zoom-in overflow-hidden bg-muted sm:block focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-foreground"
            data-gallery-open={String(index + 1)}
            aria-label={t("gallery.openImageAria", { title, index: index + 2 })}
          >
            <img
              src={item.thumb}
              srcset={item.thumbSrcset}
              sizes="(min-width: 1024px) 300px, 33vw"
              alt={item.alt}
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.05]"
              loading="lazy"
              decoding="async"
              data-fallback-image={FALLBACK_IMAGE}
              data-smart-image
            />
            {index === sideItems.length - 1 && remainingCount > 0 && (
              <span class="absolute inset-0 grid place-items-center bg-black/55 text-lg font-bold text-white backdrop-blur-[2px] transition-colors duration-300 group-hover:bg-black/45">
                {t("gallery.morePhotos", { count: remainingCount })}
              </span>
            )}
          </button>
        ))}
      </div>

      <div
        data-lightbox
        class="fixed inset-0 z-[80] hidden flex-col bg-black/95 opacity-0 backdrop-blur-sm transition-opacity duration-200"
        role="dialog"
        aria-modal="true"
        aria-label={t("gallery.lightboxLabel", { title })}
      >
        <header class="flex items-center justify-between gap-3 px-4 py-3 sm:px-6">
          <p class="text-sm font-semibold tabular-nums text-white/90" data-lightbox-counter aria-live="polite">
            1 / {items.length}
          </p>
          <div class="flex items-center gap-2">
            <a
              class="grid size-11 place-items-center rounded-full text-white/80 transition hover:bg-white/10 hover:text-white"
              data-lightbox-original
              href={items[0].full}
              target="_blank"
              rel="nofollow noopener"
              title={t("gallery.openOriginalTab")}
              aria-label={t("gallery.openOriginalTab")}
            >
              <ExternalLinkIcon class="size-5" aria-hidden="true" />
            </a>
            <button
              type="button"
              class="grid size-11 place-items-center rounded-full text-white/80 transition hover:bg-white/10 hover:text-white"
              data-lightbox-close
              aria-label={t("gallery.close")}
            >
              <XIcon class="size-6" aria-hidden="true" />
            </button>
          </div>
        </header>

        <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 sm:px-20" data-lightbox-stage>
          <div
            class="pointer-events-none absolute size-10 animate-spin rounded-full border-2 border-white/25 border-t-white/90"
            data-lightbox-spinner
            hidden
          />
          <img
            src={items[0].full}
            alt={items[0].alt}
            class="h-full w-full select-none object-contain opacity-0 transition-opacity duration-300"
            data-lightbox-image
            decoding="async"
            draggable="false"
          />

          {items.length > 1 && (
            <>
              <button
                type="button"
                class="absolute left-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white backdrop-blur-sm transition hover:bg-white/25 sm:left-5"
                data-lightbox-prev
                aria-label={t("gallery.prev")}
              >
                <ChevronLeftIcon class="size-6" aria-hidden="true" />
              </button>
              <button
                type="button"
                class="absolute right-3 top-1/2 grid size-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-white backdrop-blur-sm transition hover:bg-white/25 sm:right-5"
                data-lightbox-next
                aria-label={t("gallery.next")}
              >
                <ChevronRightIcon class="size-6" aria-hidden="true" />
              </button>
            </>
          )}
        </div>

        {items.length > 1 && (
          <footer class="hidden justify-center px-4 pb-4 pt-3 sm:flex">
            <div class="flex max-w-full gap-2 overflow-x-auto rounded-xl p-1" data-lightbox-strip>
              {items.map((item, index) => (
                <button
                  type="button"
                  class="relative block h-14 w-20 shrink-0 overflow-hidden rounded-md opacity-45 outline-2 outline-offset-2 outline-transparent transition duration-200 hover:opacity-80 data-[active]:opacity-100 data-[active]:outline-white"
                  data-lightbox-thumb={String(index)}
                  aria-label={t("gallery.showImage", { index: index + 1 })}
                >
                  <img
                    src={item.preview}
                    alt=""
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>
          </footer>
        )}
      </div>

      <script is:inline type="application/json" data-gallery-items set:html={jsonForScriptTag(items)} />
    </div>
  )
}

<script>
  type GalleryItem = { thumb: string; full: string; alt: string };

  const FALLBACK_IMAGE = "/favicon.svg";

  function initGallery(root: HTMLElement) {
    const itemsJson = root.querySelector("[data-gallery-items]")?.textContent;
    if (!itemsJson) return;
    const items: GalleryItem[] = JSON.parse(itemsJson);

    const lightbox = root.querySelector<HTMLElement>("[data-lightbox]");
    const image = root.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const counter = root.querySelector<HTMLElement>("[data-lightbox-counter]");
    const spinner = root.querySelector<HTMLElement>("[data-lightbox-spinner]");
    const originalLink = root.querySelector<HTMLAnchorElement>("[data-lightbox-original]");
    const closeButton = root.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    const stage = root.querySelector<HTMLElement>("[data-lightbox-stage]");
    const strip = root.querySelector<HTMLElement>("[data-lightbox-strip]");
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-lightbox-thumb]"));
    if (!lightbox || !image || !counter || !closeButton) return;

    let current = 0;
    let lastFocused: HTMLElement | null = null;
    const preloaded = new Set<string>();

    const preload = (index: number) => {
      const item = items[(index + items.length) % items.length];
      if (!item || preloaded.has(item.full)) return;
      preloaded.add(item.full);
      new Image().src = item.full;
    };

    const show = (index: number) => {
      current = (index + items.length) % items.length;
      const item = items[current];

      counter.textContent = `${current + 1} / ${items.length}`;
      originalLink?.setAttribute("href", item.full);

      spinner?.removeAttribute("hidden");
      image.classList.add("opacity-0");
      image.alt = item.alt;
      image.src = item.full;

      for (const thumb of thumbs) {
        if (Number(thumb.dataset.lightboxThumb) === current) {
          thumb.setAttribute("data-active", "");
          thumb.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        } else {
          thumb.removeAttribute("data-active");
        }
      }

      preload(current + 1);
      preload(current - 1);
    };

    image.addEventListener("load", () => {
      spinner?.setAttribute("hidden", "");
      image.classList.remove("opacity-0");
    });
    image.addEventListener("error", () => {
      spinner?.setAttribute("hidden", "");
      image.classList.remove("opacity-0");
      if (image.src !== new URL(FALLBACK_IMAGE, location.href).href) image.src = FALLBACK_IMAGE;
    });

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape") close();
      else if (event.key === "ArrowRight") show(current + 1);
      else if (event.key === "ArrowLeft") show(current - 1);
    };

    const open = (index: number) => {
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      show(index);
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      requestAnimationFrame(() => lightbox.classList.remove("opacity-0"));
      document.documentElement.classList.add("overflow-hidden");
      document.addEventListener("keydown", onKeydown);
      closeButton.focus();
    };

    const close = () => {
      lightbox.classList.add("opacity-0");
      document.documentElement.classList.remove("overflow-hidden");
      document.removeEventListener("keydown", onKeydown);
      window.setTimeout(() => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
      }, 200);
      lastFocused?.focus();
    };

    for (const trigger of root.querySelectorAll<HTMLButtonElement>("[data-gallery-open]")) {
      trigger.addEventListener("click", () => open(Number(trigger.dataset.galleryOpen) || 0));
    }
    closeButton.addEventListener("click", close);
    root.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(current - 1));
    root.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(current + 1));
    for (const thumb of thumbs) {
      thumb.addEventListener("click", () => show(Number(thumb.dataset.lightboxThumb) || 0));
    }

    // Klick auf den dunklen Hintergrund (nicht auf Bild/Buttons) schließt.
    // Das <img> füllt die ganze Bühne (object-contain), daher zählt auch der
    // Letterbox-Bereich um das tatsächlich gerenderte Bild als Hintergrund.
    let pointerMoved = false;
    stage?.addEventListener("click", (event) => {
      if (pointerMoved) return;
      if (event.target === stage) {
        close();
        return;
      }
      if (event.target !== image || !image.naturalWidth || !image.naturalHeight) return;
      const rect = image.getBoundingClientRect();
      const scale = Math.min(rect.width / image.naturalWidth, rect.height / image.naturalHeight);
      const renderedWidth = image.naturalWidth * scale;
      const renderedHeight = image.naturalHeight * scale;
      const left = rect.left + (rect.width - renderedWidth) / 2;
      const top = rect.top + (rect.height - renderedHeight) / 2;
      const insideImage =
        event.clientX >= left && event.clientX <= left + renderedWidth &&
        event.clientY >= top && event.clientY <= top + renderedHeight;
      if (!insideImage) close();
    });

    // Swipe-Navigation auf Touch-Geräten
    let pointerStartX: number | null = null;
    stage?.addEventListener("pointerdown", (event) => {
      pointerStartX = event.clientX;
      pointerMoved = false;
    });
    stage?.addEventListener("pointerup", (event) => {
      if (pointerStartX === null) return;
      const deltaX = event.clientX - pointerStartX;
      pointerStartX = null;
      pointerMoved = Math.abs(deltaX) > 10;
      if (Math.abs(deltaX) < 48 || items.length < 2) return;
      show(deltaX < 0 ? current + 1 : current - 1);
    });

    strip?.addEventListener("wheel", (event) => {
      if (event.deltaY === 0) return;
      event.preventDefault();
      strip.scrollLeft += event.deltaY;
    }, { passive: false });
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-image-gallery]")) {
    initGallery(root);
  }
</script>
