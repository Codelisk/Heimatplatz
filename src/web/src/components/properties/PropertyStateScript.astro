<script>
  import { getResponsiveImage } from "@/lib/images";
  import { buildLoginHref, buildRegisterHref } from "@/lib/navigation";
  import { readDebugApiUrl } from "@/lib/utils/debug-host";
  import { formatApiPrice, getApiLocationLine, getApiStreetLine, getDisplayTitle } from "@/features/properties/format";
  import { t } from "@/i18n";
  // Nur Typ-Import aus live-api (wird beim Build geloescht) - Wert-Importe wuerden
  // die Server-Abhaengigkeiten (ttl-cache, api-base) ins Client-Bundle ziehen
  import type { ApiProperty } from "@/features/properties/live-api";

  type Draft = {
    id?: string;
    updatedAt?: string;
    title?: string;
    propertyType?: string;
    sellerName?: string;
    sellerType?: string;
    description?: string;
    municipalityId?: string;
    postalCode?: string;
    city?: string;
    address?: string;
    price?: string;
    livingArea?: string;
    plotArea?: string;
    rooms?: string;
    yearBuilt?: string;
    features?: string;
    /** "approximate" | "exact" | "hidden" - Lage-Anzeige des Inserats */
    locationDisplay?: string;
    originalListingUrl?: string;
    contactName?: string;
    contactEmail?: string;
    contactPhone?: string;
    imageUrls?: string[];
    [key: string]: string | string[] | undefined;
  };

  // Session inkl. RefreshToken im localStorage: Das Web nutzt denselben
  // Refresh-Flow wie MAUI. Serverseitig rotiert jeder Refresh den Token und
  // Wiederverwendung widerruft die gesamte Token-Familie (Reuse-Detection) -
  // ein gestohlener Token fliegt auf, sobald beide Seiten refreshen.
  // ACHTUNG ExpiresAt: Das ist der Ablauf des REFRESH Tokens (~30 Tage).
  // Der Access Token selbst laeuft nach JWT exp (~60 Minuten) ab und wird in
  // apiRequest proaktiv erneuert.
  type Session = {
    AccessToken: string;
    // Fehlt bei Alt-Sessions, die vor dem Refresh-Flow angelegt wurden
    RefreshToken?: string;
    UserId: string;
    Email: string;
    FullName: string;
    ExpiresAt: string;
  };

  type RequestOptions = Omit<RequestInit, "body"> & {
    body?: unknown;
    skipAuth?: boolean;
    /**
     * Endpunkt liefert ohne Token grundsaetzlich 401 (z.B. /api/favorites).
     * Endet die Sitzung beim Refresh, wird der Request gar nicht erst gesendet.
     */
    authRequired?: boolean;
  };

  class ApiRequestError extends Error {
    readonly status: number;

    constructor(status: number, message: string) {
      super(message);
      this.name = "ApiRequestError";
      this.status = status;
    }
  }


  type Municipality = {
    Id: string;
    Name: string;
    PostalCode: string;
    DistrictName: string;
  };

  type LocationsResponse = {
    FederalProvinces: Array<{
      Districts: Array<{
        Name: string;
        Municipalities: Array<{ Id: string; Name: string; PostalCode: string }>;
      }>;
    }>;
  };

  type PropertyImageItem = {
    id: string;
    url: string;
    fileName: string;
    contentType: string;
    existing: boolean;
    file?: File;
  };

  const STORAGE_KEYS = {
    session: "heimatplatz:session",
    favorites: "heimatplatz:favorites",
    blocked: "heimatplatz:blocked",
    drafts: "heimatplatz:property-drafts",
    notificationPreferences: "heimatplatz:notification-preferences",
    filterPreferences: "heimatplatz:filter-preferences",
    pendingNotificationPreferences: "heimatplatz:pending-notification-preferences",
    pendingFilterPreferences: "heimatplatz:pending-filter-preferences",
    webPushDeviceId: "heimatplatz:web-push-device-id",
  };

  // Debug-Tab kann den Endpunkt zur Laufzeit umschalten (nur localhost/LAN, wie MAUI-DebugPage)
  const API_BASE_URL = readDebugApiUrl() || import.meta.env.PUBLIC_API_BASE_URL || "https://api.heimatplatz.at";
  const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
  const MAX_PROPERTY_IMAGES = 20;
  const imageFormState = new WeakMap<HTMLFormElement, PropertyImageItem[]>();
  let municipalityPromise: Promise<Municipality[]> | null = null;
  let propertyActionRevision = 0;
  let preferenceLoadRevision = 0;
  let propertyActionStatusTimer: number | null = null;

  function readArray<T = string>(key: string): T[] {
    try {
      const value = window.localStorage.getItem(key);
      const parsed = value ? JSON.parse(value) : [];
      return Array.isArray(parsed) ? parsed as T[] : [];
    } catch {
      return [];
    }
  }

  function writeArray<T>(key: string, value: T[]) {
    try {
      window.localStorage.setItem(key, JSON.stringify(value));
    } catch {
      // Local storage can be disabled; the UI should still remain usable.
    }
  }

  function readJson<T>(key: string): T | null {
    try {
      const value = window.localStorage.getItem(key);
      return value ? JSON.parse(value) as T : null;
    } catch {
      return null;
    }
  }

  function writeJson<T>(key: string, value: T) {
    try {
      window.localStorage.setItem(key, JSON.stringify(value));
    } catch {
      // Local storage can be disabled; the UI should still remain usable.
    }
  }

  function decodeJwtPayload(accessToken: string): Record<string, unknown> | null {
    try {
      const payload = accessToken.split(".")[1];
      if (!payload) return null;
      const padded = payload.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(payload.length / 4) * 4, "=");
      return JSON.parse(window.atob(padded)) as Record<string, unknown>;
    } catch {
      return null;
    }
  }

  function getJwtExpiryMs(accessToken: string): number | null {
    const exp = decodeJwtPayload(accessToken)?.exp;
    return typeof exp === "number" ? exp * 1000 : null;
  }

  function readSession() {
    const session = readJson<Session>(STORAGE_KEYS.session);
    if (!session?.AccessToken) return null;

    // ExpiresAt = Ablauf des Refresh Tokens; danach ist die Sitzung endgueltig vorbei
    if (session.ExpiresAt && new Date(session.ExpiresAt).getTime() <= Date.now()) {
      window.localStorage.removeItem(STORAGE_KEYS.session);
      clearUserStateCache();
      return null;
    }

    // Alt-Sessions ohne RefreshToken sind tot, sobald ihr Access Token ablaeuft
    if (!session.RefreshToken) {
      const accessExpiryMs = getJwtExpiryMs(session.AccessToken);
      if (accessExpiryMs !== null && accessExpiryMs <= Date.now()) {
        window.localStorage.removeItem(STORAGE_KEYS.session);
        clearUserStateCache();
        return null;
      }
    }

    return session;
  }

  function readSessionRoles(session: Session | null) {
    const roles = new Set<string>();
    if (!session?.AccessToken) return roles;

    // Role badges sind Progressive Enhancement; die Anmeldung selbst haengt nicht daran
    const parsed = decodeJwtPayload(session.AccessToken);
    if (!parsed) return roles;

    const roleClaim = parsed.user_role;
    const values = Array.isArray(roleClaim) ? roleClaim : [roleClaim];
    values.forEach((role) => {
      if (typeof role === "string") roles.add(role.toLowerCase());
    });
    // Konkreter Anbietertyp (Private/Broker/PropertyManager) als eigener Claim
    if (typeof parsed.seller_type === "string") {
      roles.add(`seller_type:${parsed.seller_type.toLowerCase()}`);
    }

    return roles;
  }

  function getInitials(fullName: string | undefined) {
    const parts = (fullName ?? "").trim().split(/\s+/).filter(Boolean);
    if (parts.length === 0) return "?";
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
  }

  function getRoleBadgeText(roles: Set<string>) {
    // Kaeufer ist jedes Konto implizit; Verkaeufer werden mit Anbietertyp ausgewiesen
    if (roles.has("admin")) return t("auth.roleAdmin");
    if (roles.has("seller")) {
      if (roles.has("seller_type:broker")) return t("auth.roleSellerBroker");
      if (roles.has("seller_type:propertymanager")) return t("auth.roleSellerPropertyManager");
      return t("auth.roleSellerPrivate");
    }
    return t("auth.roleBuyer");
  }

  function saveSession(session: Session) {
    writeJson(STORAGE_KEYS.session, session);
    renderAuthState();
  }

  function clearUserStateCache(options: { preservePendingPreferences?: boolean } = {}) {
    [
      STORAGE_KEYS.favorites,
      STORAGE_KEYS.blocked,
      STORAGE_KEYS.notificationPreferences,
      STORAGE_KEYS.filterPreferences,
    ].forEach((key) => window.localStorage.removeItem(key));
    if (!options.preservePendingPreferences) {
      [
        STORAGE_KEYS.pendingNotificationPreferences,
        STORAGE_KEYS.pendingFilterPreferences,
      ].forEach((key) => window.localStorage.removeItem(key));
    }
    propertyActionRevision += 1;
    preferenceLoadRevision += 1;
  }

  function clearSession() {
    window.localStorage.removeItem(STORAGE_KEYS.session);
    clearUserStateCache();
    renderAuthState();
    refreshActionButtons();
    syncUserLists();
  }

  function setDeleteAccountStatus(message: string, tone: "info" | "error") {
    const statusEl = document.querySelector<HTMLElement>("[data-delete-account-status]");
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.classList.remove("hidden", "text-muted-foreground", "text-error");
    statusEl.classList.add(tone === "error" ? "text-error" : "text-muted-foreground");
  }

  // Zweistufige Inline-Bestaetigung auf der Profilseite; liefert false,
  // wenn die Seite kein Bestaetigungs-Markup hat (dann window.confirm-Fallback)
  function toggleDeleteAccountConfirm(open: boolean) {
    const confirmBlock = document.querySelector<HTMLElement>("[data-delete-account-confirm]");
    if (!confirmBlock) return false;
    confirmBlock.hidden = !open;
    const trigger = document.querySelector<HTMLButtonElement>("[data-delete-account]");
    if (trigger) trigger.hidden = open;
    // Fokus fuehren (WEB-036): beim Oeffnen auf den Bestaetigen-Button, beim
    // Schliessen zurueck auf den Ausloeser - sonst landet der Fokus auf <body>
    if (open) {
      confirmBlock.querySelector<HTMLButtonElement>("[data-delete-account-confirmed]")?.focus();
    } else {
      trigger?.focus();
    }
    return true;
  }

  async function performDeleteAccount(button: HTMLButtonElement) {
    button.setAttribute("disabled", "true");
    setDeleteAccountStatus(t("profile.deleteStatusDeleting"), "info");

    try {
      // Die gesamte Loeschlogik liegt im Backend. Der Benutzer wird per Bearer-Token erkannt.
      await apiRequest("/api/auth/account", { method: "DELETE" });

      // Lokale Daten ebenfalls entfernen
      clearSession();
      window.localStorage.removeItem(STORAGE_KEYS.favorites);
      window.localStorage.removeItem(STORAGE_KEYS.blocked);
      window.localStorage.removeItem(STORAGE_KEYS.drafts);
      window.localStorage.removeItem(STORAGE_KEYS.notificationPreferences);
      window.localStorage.removeItem(STORAGE_KEYS.filterPreferences);
      // Push-Geraete-Id gehoert zum geloeschten Konto (WEB-044)
      window.localStorage.removeItem(STORAGE_KEYS.webPushDeviceId);

      setDeleteAccountStatus(t("profile.deleteStatusDone"), "info");
      window.location.href = "/";
    } catch (error) {
      button.removeAttribute("disabled");
      setDeleteAccountStatus(
        error instanceof Error ? t("profile.deleteFailedDetail", { message: error.message }) : t("profile.deleteFailed"),
        "error",
      );
    }
  }

  async function handleDeleteAccount(button: HTMLButtonElement) {
    const session = readSession();
    if (!session) {
      window.location.href = getLoginHrefForCurrentPage();
      return;
    }

    if (toggleDeleteAccountConfirm(true)) return;

    const confirmed = window.confirm(t("profile.deleteConfirmPrompt"));
    if (!confirmed) return;

    await performDeleteAccount(button);
  }

  // Access Token kurz vor Ablauf proaktiv erneuern, damit laufende Requests
  // nicht in einen 401 laufen
  const TOKEN_REFRESH_MARGIN_MS = 2 * 60 * 1000;

  function isAccessTokenStale(session: Session) {
    const accessExpiryMs = getJwtExpiryMs(session.AccessToken);
    return accessExpiryMs !== null && accessExpiryMs - Date.now() <= TOKEN_REFRESH_MARGIN_MS;
  }

  // Single-Flight ueber alle Tabs: Die API rotiert Refresh Tokens, und ein
  // wiederverwendeter Token widerruft die gesamte Familie (Reuse-Detection).
  // Zwei parallele Refreshes wuerden sich also gegenseitig ausloggen - der Web
  // Lock serialisiert sie, der Re-Read nach Lock-Erwerb uebernimmt das Ergebnis
  // des Gewinners. Ohne Web-Locks-Support (Safari < 15.4) direkt refreshen; das
  // Rest-Race endet schlimmstenfalls im Logout.
  function withRefreshLock<T>(work: () => Promise<T>): Promise<T> {
    if (navigator.locks) {
      return navigator.locks.request("heimatplatz:token-refresh", work) as Promise<T>;
    }
    return work();
  }

  // Erneuert den Access Token, wenn er kurz vor Ablauf ist oder der Server ihn
  // bereits abgelehnt hat (failedAccessToken). Liefert die aktuelle Session,
  // oder null wenn die Sitzung endgueltig vorbei ist.
  function refreshSession(failedAccessToken?: string): Promise<Session | null> {
    return withRefreshLock(async () => {
      // Re-Read nach Lock-Erwerb: ein anderer Tab kann schon refresht haben
      const session = readSession();
      if (!session) return null;
      if (!isAccessTokenStale(session) && session.AccessToken !== failedAccessToken) {
        return session;
      }

      if (!session.RefreshToken) {
        // Alt-Session ohne Refresh-Flow: bei hartem 401 endgueltig ausloggen,
        // sonst darf der Resttoken noch bis JWT exp weiterarbeiten
        if (session.AccessToken === failedAccessToken) {
          clearSession();
          return null;
        }
        return session;
      }

      let response: Response;
      try {
        response = await fetch(new URL("/api/auth/refresh", API_BASE_URL), {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ RefreshToken: session.RefreshToken }),
        });
      } catch {
        // Netzwerkfehler: Sitzung behalten - der naechste Versuch refresht erneut
        return session;
      }

      if (response.status === 401) {
        // Refresh Token abgelaufen oder widerrufen - die Sitzung ist vorbei
        clearSession();
        return null;
      }
      if (!response.ok) {
        // Transienter Serverfehler: Sitzung nicht wegwerfen
        return session;
      }

      const result = await response.json() as { AccessToken: string; RefreshToken: string; ExpiresAt: string };
      const next: Session = {
        ...session,
        AccessToken: result.AccessToken,
        RefreshToken: result.RefreshToken,
        ExpiresAt: result.ExpiresAt,
      };
      saveSession(next);
      return next;
    });
  }

  async function apiRequest<TResponse>(path: string, options: RequestOptions = {}): Promise<TResponse> {
    const url = new URL(path, API_BASE_URL);

    let session = options.skipAuth ? null : readSession();
    if (session && isAccessTokenStale(session)) {
      session = await refreshSession();

      // Refresh mit 401 beantwortet: Die Sitzung ist endgueltig vorbei. Einen
      // reinen Auth-Endpunkt jetzt noch ohne Token anzufragen erzeugt nur einen
      // weiteren 401 in der Konsole - der Fehler steht schon fest.
      if (!session && options.authRequired) {
        throw new ApiRequestError(401, t("auth.errorSessionExpired"));
      }
    }

    const doFetch = () => {
      const headers = new Headers(options.headers);
      if (options.body !== undefined && !headers.has("content-type")) {
        headers.set("content-type", "application/json");
      }
      if (session?.AccessToken && !headers.has("authorization")) {
        headers.set("authorization", `Bearer ${session.AccessToken}`);
      }
      return fetch(url, {
        ...options,
        headers,
        body: options.body === undefined ? undefined : JSON.stringify(options.body),
      });
    };

    let response = await doFetch();

    // 401 trotz (scheinbar) gueltigem Token: serverseitig invalidiert, z.B. nach
    // Key-Rotation - einmal refreshen und den Request wiederholen
    if (response.status === 401 && session) {
      const failedToken = session.AccessToken;
      session = await refreshSession(failedToken);
      if (session && session.AccessToken !== failedToken) {
        response = await doFetch();
      }
    }

    const contentType = response.headers.get("content-type") ?? "";
    const payload = contentType.includes("application/json")
      ? await response.json()
      : await response.text();

    if (!response.ok) {
      if (response.status === 401 && !options.skipAuth && !readSession()) {
        // Sitzung endgueltig abgelaufen: Anmelde-Dialog statt kryptischem 401
        showLoginPrompt();
        throw new ApiRequestError(response.status, t("auth.errorSessionExpired"));
      }
      throw new ApiRequestError(
        response.status,
        extractErrorMessage(payload) || t("auth.requestFailedStatus", { status: response.status }),
      );
    }

    return payload as TResponse;
  }

  function extractErrorMessage(payload: unknown) {
    if (typeof payload === "string") return payload.trim();
    if (payload && typeof payload === "object") {
      // ProblemDetails (RFC 9457) der API: detail enthaelt die Benutzermeldung
      const problem = payload as { detail?: string; message?: string; Message?: string; title?: string };
      return (problem.detail || problem.message || problem.Message || problem.title || "").trim();
    }
    return "";
  }

  function toggleValue(key: string, value: string) {
    const values = new Set(readArray(key));
    const nextActive = !values.has(value);
    if (nextActive) {
      values.add(value);
    } else {
      values.delete(value);
    }
    writeArray(key, Array.from(values));
    return nextActive;
  }

  function removeValue(key: string, value: string) {
    const values = new Set(readArray(key));
    values.delete(value);
    writeArray(key, Array.from(values));
  }

  function setFormStatus(form: HTMLFormElement, message: string, tone: "info" | "error" | "success" = "info") {
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    if (!status) return;

    status.textContent = message;
    status.classList.remove("hidden", "text-muted-foreground", "text-error", "text-success-foreground", "dark:text-success");
    if (tone === "error") status.classList.add("text-error");
    if (tone === "success") status.classList.add("text-success-foreground", "dark:text-success");
    if (tone === "info") status.classList.add("text-muted-foreground");

    // Die Statuszeile steht oben im Formular, der Speichern-Button in der Sidebar
    // klebt aber weiter unten. Ohne Scrollen sieht ein Fehler nach "es passiert
    // nichts" aus (native Pflichtfeld-Fehler scrollen selbst, eigene nicht).
    if (tone === "error") scrollStatusIntoView(status);
  }

  function scrollStatusIntoView(status: HTMLElement) {
    const rect = status.getBoundingClientRect();
    const header = document.querySelector<HTMLElement>("header");
    const topOffset = (header?.offsetHeight ?? 0) + 12;
    if (rect.top >= topOffset && rect.bottom <= window.innerHeight) return;

    window.scrollTo({
      top: Math.max(0, rect.top + window.scrollY - topOffset),
      behavior: "smooth",
    });
  }

  function renderAuthState() {
    const session = readSession();
    const loggedIn = !!session;
    const roles = readSessionRoles(session);
    // Kaeufer ist jedes angemeldete Konto implizit
    const isBuyer = loggedIn;
    const isSeller = roles.has("seller");

    document.querySelectorAll<HTMLElement>("[data-auth-email]").forEach((element) => {
      element.textContent = session?.Email ?? "";
    });
    document.querySelectorAll<HTMLElement>("[data-auth-name]").forEach((element) => {
      element.textContent = session?.FullName ?? t("auth.notSignedIn");
    });
    document.querySelectorAll<HTMLElement>("[data-auth-initials]").forEach((element) => {
      element.textContent = loggedIn ? getInitials(session?.FullName) : "?";
    });
    document.querySelectorAll<HTMLElement>("[data-auth-tooltip]").forEach((element) => {
      element.title = loggedIn ? [session?.FullName, session?.Email].filter(Boolean).join("\n") : "";
    });
    document.querySelectorAll<HTMLElement>("[data-auth-role-badge]").forEach((element) => {
      element.textContent = loggedIn ? getRoleBadgeText(roles) : "";
    });
    document.querySelectorAll<HTMLElement>("[data-auth-user-id]").forEach((element) => {
      element.textContent = session?.UserId ?? "";
    });
    document.querySelectorAll<HTMLElement>("[data-auth-role-buyer]").forEach((element) => {
      element.hidden = !isBuyer;
    });
    document.querySelectorAll<HTMLElement>("[data-auth-role-buyer-only]").forEach((element) => {
      element.hidden = !isBuyer || isSeller;
    });
    document.querySelectorAll<HTMLElement>("[data-auth-role-seller]").forEach((element) => {
      element.hidden = !isSeller;
    });
    document.querySelectorAll<HTMLElement>("[data-guest-only]").forEach((element) => {
      element.hidden = loggedIn;
    });
    document.querySelectorAll<HTMLElement>("[data-auth-only]").forEach((element) => {
      element.hidden = !loggedIn;
    });
  }

  // Firmenname ist bei allen gewerblichen Anbietern Pflicht (Makler und Hausverwaltung)
  function sellerTypeNeedsCompany(sellerType: string) {
    return sellerType === "Broker" || sellerType === "PropertyManager";
  }

  function bindRegisterRoleFields() {
    // Gleiches Toggle-Verhalten fuer Registrierung und Profil-Bearbeitung
    document.querySelectorAll<HTMLFormElement>("[data-auth-form='register'], [data-profile-form]").forEach((form) => {
      const wantsToSell = form.querySelector<HTMLInputElement>("[name='wantsToSell']");
      const sellerFields = form.querySelector<HTMLElement>("[data-seller-fields]");
      const sellerTypes = Array.from(form.querySelectorAll<HTMLInputElement>("[name='sellerType']"));
      const companyWrapper = form.querySelector<HTMLElement>("[data-company-field]");
      const companyName = form.querySelector<HTMLInputElement>("[name='companyName']");

      const update = () => {
        const sellerSelected = Boolean(wantsToSell?.checked);
        if (sellerFields) sellerFields.hidden = !sellerSelected;
        wantsToSell?.setAttribute("aria-expanded", String(sellerSelected));
        sellerTypes.forEach((input) => {
          input.disabled = !sellerSelected;
        });

        const selectedType = sellerTypes.find((input) => input.checked)?.value ?? "";
        const needsCompany = sellerSelected && sellerTypeNeedsCompany(selectedType);
        if (companyWrapper) companyWrapper.hidden = !needsCompany;
        if (companyName) {
          companyName.disabled = !needsCompany;
          companyName.required = needsCompany;
          if (!needsCompany) companyName.value = "";
        }
      };

      form.addEventListener("change", update);
      update();
    });
  }

  function validateRegisterForm(formData: FormData) {
    const password = String(formData.get("password") ?? "");
    const passwordConfirm = String(formData.get("passwordConfirm") ?? "");
    const wantsSeller = formData.has("wantsToSell");
    const sellerType = String(formData.get("sellerType") ?? "");
    const companyName = String(formData.get("companyName") ?? "").trim();

    if (password !== passwordConfirm) return t("auth.errorPasswordMismatch");
    if (wantsSeller && !sellerType) return t("auth.errorSellerTypeRequired");
    if (wantsSeller && sellerTypeNeedsCompany(sellerType) && !companyName) return t("auth.errorCompanyNameRequired");
    return "";
  }

  function bindAuthForms() {
    document.querySelectorAll<HTMLFormElement>("[data-auth-form]").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const mode = form.getAttribute("data-auth-form");
        const formData = new FormData(form);
        const submit = form.querySelector<HTMLButtonElement>("[type='submit']");
        const wantsSeller = formData.has("wantsToSell");
        const sellerType = wantsSeller ? String(formData.get("sellerType") ?? "Private") : "";
        const companyName = String(formData.get("companyName") ?? "").trim();

        if (mode === "register") {
          const validationMessage = validateRegisterForm(formData);
          if (validationMessage) {
            setFormStatus(form, validationMessage, "error");
            return;
          }
        }

        submit?.setAttribute("disabled", "true");
        setFormStatus(form, mode === "register" ? t("auth.statusRegistering") : t("auth.statusLoggingIn"));

        try {
          const payload = mode === "register"
            ? {
                FirstName: String(formData.get("firstName") ?? ""),
                LastName: String(formData.get("lastName") ?? ""),
                Email: String(formData.get("email") ?? ""),
                Password: String(formData.get("password") ?? ""),
                SellerType: wantsSeller ? sellerType : null,
                CompanyName: wantsSeller && sellerTypeNeedsCompany(sellerType) ? companyName : null,
              }
            : {
                Email: String(formData.get("email") ?? ""),
                Password: String(formData.get("password") ?? ""),
              };

          const session = await apiRequest<Session>(
            mode === "register" ? "/api/auth/register" : "/api/auth/login",
            { method: "POST", body: payload, skipAuth: true },
          );

          // Kontogebundene Browser-Caches duerfen nicht vom vorherigen Benutzer
          // in die neue Sitzung uebernommen werden; die Zielseite hydratisiert sie neu.
          clearUserStateCache({ preservePendingPreferences: true });
          saveSession(session);
          // Gast-Einstellungen gehoeren bewusst zur neuen Sitzung. Der Sync
          // wird vor der Weiterleitung versucht und bei Netzfehlern auf der
          // Zielseite automatisch wiederholt.
          await syncPendingPreferences();
          setFormStatus(form, t("auth.statusLoggedIn"), "success");
          if (mode === "register") {
            window.rybbit?.event("registration_completed", { seller: String(wantsSeller) });
          }
          // Verkaeufer landen bei ihren Inseraten, alle anderen in der Suche
          const sellerRedirect = form.getAttribute("data-success-redirect-seller");
          const redirect = (mode === "register" && wantsSeller && sellerRedirect)
            ? sellerRedirect
            : form.getAttribute("data-success-redirect") || "/profil/";
          window.location.href = redirect;
        } catch (error) {
          setFormStatus(
            form,
            error instanceof Error ? error.message : t("auth.errorLoginFailed"),
            "error",
          );
        } finally {
          submit?.removeAttribute("disabled");
        }
      });
    });
  }

  type Profile = {
    UserId: string;
    FirstName: string;
    LastName: string;
    Email: string;
    FullName: string;
    SellerType: string | null;
    CompanyName: string | null;
    IsAdmin: boolean;
    EmailVerified: boolean;
    Phone: string | null;
  };

  function setPasswordManagerUsername(form: HTMLFormElement, email: string) {
    const username = form.querySelector<HTMLInputElement>("[data-password-username]");
    if (!username) return;

    const normalizedEmail = email.trim();
    username.value = normalizedEmail;
    // form.reset() soll den Kontobezug nach erfolgreicher Passwortaenderung
    // nicht entfernen.
    username.defaultValue = normalizedEmail;
  }

  function getLoginHrefForCurrentPage() {
    return buildLoginHref(`${window.location.pathname}${window.location.search}`);
  }

  function getRegisterHrefForCurrentPage() {
    return buildRegisterHref(`${window.location.pathname}${window.location.search}`);
  }

  // Profil-Formular: laedt die aktuellen Daten und speichert Aenderungen
  // (Verkaeufer werden/Anbietertyp wechseln/Anbieten deaktivieren) via PUT /api/auth/profile
  function bindProfileForms() {
    document.querySelectorAll<HTMLFormElement>("[data-profile-form]").forEach((form) => {
      const load = async () => {
        if (!readSession()) return;
        try {
          const profile = await apiRequest<Profile>("/api/auth/profile");
          setField(form, "firstName", profile.FirstName);
          setField(form, "lastName", profile.LastName);
          const wantsToSell = form.querySelector<HTMLInputElement>("[name='wantsToSell']");
          if (wantsToSell) wantsToSell.checked = Boolean(profile.SellerType);
          if (profile.SellerType) {
            const typeInput = form.querySelector<HTMLInputElement>(`[name='sellerType'][value='${profile.SellerType}']`);
            if (typeInput) typeInput.checked = true;
          }
          setField(form, "companyName", profile.CompanyName ?? "");
          setField(form, "phone", profile.Phone ?? "");
          form.dispatchEvent(new Event("change"));
        } catch {
          // Formular bleibt leer; Speichern validiert serverseitig
        }
      };
      void load();

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const session = readSession();
        if (!session) return;

        const formData = new FormData(form);
        const wantsSeller = formData.has("wantsToSell");
        const sellerType = wantsSeller ? String(formData.get("sellerType") ?? "Private") : null;
        const companyName = String(formData.get("companyName") ?? "").trim();

        if (wantsSeller && sellerType && sellerTypeNeedsCompany(sellerType) && !companyName) {
          setFormStatus(form, t("auth.errorCompanyNameRequired"), "error");
          return;
        }

        setFormStatus(form, t("profile.statusSaving"));
        try {
          const result = await apiRequest<{ FullName: string; AccessToken: string }>("/api/auth/profile", {
            method: "PUT",
            body: {
              FirstName: String(formData.get("firstName") ?? ""),
              LastName: String(formData.get("lastName") ?? ""),
              SellerType: sellerType,
              CompanyName: wantsSeller && sellerType && sellerTypeNeedsCompany(sellerType) ? companyName : null,
              Phone: String(formData.get("phone") ?? "").trim() || null,
            },
          });

          // Neuer Access Token traegt die aktualisierten Claims (Seller/SellerType)
          saveSession({ ...session, AccessToken: result.AccessToken, FullName: result.FullName });
          setFormStatus(form, t("profile.statusSaved"), "success");
          // Frisch eingeblendete Kacheln (z.B. "Meine Inserate" nach Anbieter-Opt-in)
          // nachladen - sonst bleibt der Zaehler bis zum Reload bei "-" (WEB-024)
          bindProfileStats();
        } catch (error) {
          setFormStatus(form, error instanceof Error ? error.message : t("profile.statusSaveFailed"), "error");
        }
      });
    });

    document.querySelectorAll<HTMLFormElement>("[data-change-password-form]").forEach((form) => {
      const currentSession = readSession();
      if (currentSession) {
        setPasswordManagerUsername(form, currentSession.Email);
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const session = readSession();
        if (!session) return;

        const formData = new FormData(form);
        const newPassword = String(formData.get("newPassword") ?? "");
        const confirm = String(formData.get("newPasswordConfirm") ?? "");

        if (newPassword !== confirm) {
          setFormStatus(form, t("auth.errorPasswordMismatch"), "error");
          return;
        }

        setFormStatus(form, t("auth.statusChangingPassword"));
        try {
          const result = await apiRequest<{ AccessToken: string; RefreshToken: string; ExpiresAt: string }>(
            "/api/auth/change-password",
            {
              method: "POST",
              body: {
                CurrentPassword: String(formData.get("currentPassword") ?? ""),
                NewPassword: newPassword,
              },
            },
          );

          // Alle anderen Sitzungen sind widerrufen; diese Session bekommt das
          // frische Token-Paar
          saveSession({
            ...session,
            AccessToken: result.AccessToken,
            RefreshToken: result.RefreshToken,
            ExpiresAt: result.ExpiresAt,
          });
          form.reset();
          setFormStatus(form, t("auth.statusPasswordChanged"), "success");
        } catch (error) {
          setFormStatus(form, error instanceof Error ? error.message : t("auth.errorChangePasswordFailed"), "error");
        }
      });
    });
  }

  // "Passwort vergessen" (E-Mail-Formular) und "Passwort zuruecksetzen" (Token aus ?token=)
  function bindPasswordResetForms() {
    document.querySelectorAll<HTMLFormElement>("[data-forgot-password-form]").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const submit = form.querySelector<HTMLButtonElement>("[type='submit']");
        const email = String(new FormData(form).get("email") ?? "");

        submit?.setAttribute("disabled", "true");
        setFormStatus(form, t("auth.statusSendingRequest"));
        try {
          // Die Antwort ist bewusst immer generisch (kein Rueckschluss auf existierende Konten)
          const result = await apiRequest<{ Message: string }>("/api/auth/forgot-password", {
            method: "POST",
            body: { Email: email },
            skipAuth: true,
          });
          setFormStatus(form, result.Message, "success");
        } catch (error) {
          setFormStatus(form, error instanceof Error ? error.message : t("auth.errorForgotFailed"), "error");
        } finally {
          submit?.removeAttribute("disabled");
        }
      });
    });

    document.querySelectorAll<HTMLFormElement>("[data-reset-password-form]").forEach((form) => {
      const query = new URLSearchParams(window.location.search);
      const fragment = new URLSearchParams(window.location.hash.slice(1));
      const token = query.get("token") ?? "";
      setPasswordManagerUsername(form, fragment.get("email") ?? query.get("email") ?? "");
      const submit = form.querySelector<HTMLButtonElement>("[type='submit']");

      if (!token) {
        setFormStatus(form, t("auth.errorResetLinkIncomplete"), "error");
        submit?.setAttribute("disabled", "true");
        return;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(form);
        const newPassword = String(formData.get("newPassword") ?? "");
        const confirm = String(formData.get("newPasswordConfirm") ?? "");

        if (newPassword !== confirm) {
          setFormStatus(form, t("auth.errorPasswordMismatch"), "error");
          return;
        }

        submit?.setAttribute("disabled", "true");
        setFormStatus(form, t("auth.statusSettingPassword"));
        try {
          const result = await apiRequest<{ Message: string }>("/api/auth/reset-password", {
            method: "POST",
            body: { Token: token, NewPassword: newPassword },
            skipAuth: true,
          });
          form.reset();
          // Submit bleibt deaktiviert - der Token ist eingeloest, ein zweiter Versuch scheitert ohnehin
          setFormStatus(form, result.Message, "success");
        } catch (error) {
          setFormStatus(form, error instanceof Error ? error.message : t("auth.errorResetFailed"), "error");
          submit?.removeAttribute("disabled");
        }
      });
    });
  }

  // /email-bestaetigen: ruft die API mit dem ?token= aus dem Mail-Link automatisch auf
  function bindVerifyEmailPage() {
    const container = document.querySelector<HTMLElement>("[data-verify-email]");
    if (!container) return;

    const pending = container.querySelector<HTMLElement>("[data-verify-pending]");
    const success = container.querySelector<HTMLElement>("[data-verify-success]");
    const successMessage = container.querySelector<HTMLElement>("[data-verify-success-message]");
    const errorBlock = container.querySelector<HTMLElement>("[data-verify-error]");
    const errorMessage = container.querySelector<HTMLElement>("[data-verify-error-message]");
    const token = new URLSearchParams(window.location.search).get("token") ?? "";

    const showError = (message: string) => {
      pending?.setAttribute("hidden", "true");
      if (errorMessage) errorMessage.textContent = message;
      errorBlock?.removeAttribute("hidden");
    };

    if (!token) {
      showError(t("auth.errorVerifyLinkIncomplete"));
      return;
    }

    void (async () => {
      try {
        const result = await apiRequest<{ Email: string; AlreadyVerified: boolean }>("/api/auth/verify-email", {
          method: "POST",
          body: { Token: token },
          skipAuth: true,
        });
        pending?.setAttribute("hidden", "true");
        if (successMessage) {
          successMessage.textContent = result.AlreadyVerified
            ? t("auth.verifyAlreadyVerified", { email: result.Email })
            : t("auth.verifySuccess", { email: result.Email });
        }
        success?.removeAttribute("hidden");
      } catch (error) {
        showError(error instanceof Error ? error.message : t("auth.errorVerifyFailed"));
      }
    })();
  }

  // Profil: Verifikationsstatus anzeigen + Bestaetigungs-Mail erneut senden
  function bindEmailVerification() {
    const card = document.querySelector<HTMLElement>("[data-email-verification]");
    if (!card || !readSession()) return;

    const statusEl = card.querySelector<HTMLElement>("[data-email-verification-status]");
    const resendButton = card.querySelector<HTMLButtonElement>("[data-resend-verification]");
    const resendStatus = card.querySelector<HTMLElement>("[data-resend-verification-status]");

    const setResendStatus = (message: string, tone: "info" | "error" | "success") => {
      if (!resendStatus) return;
      resendStatus.textContent = message;
      resendStatus.classList.remove("hidden", "text-muted-foreground", "text-error", "text-success-foreground", "dark:text-success");
      if (tone === "error") resendStatus.classList.add("text-error");
      if (tone === "success") resendStatus.classList.add("text-success-foreground", "dark:text-success");
      if (tone === "info") resendStatus.classList.add("text-muted-foreground");
    };

    const renderVerified = (email: string, verified: boolean) => {
      // Banner nur zeigen, solange die Adresse unbestaetigt ist -
      // bestaetigte Konten bekommen stattdessen das gruene Badge in der Identitaets-Karte
      card.hidden = verified;
      document.querySelectorAll<HTMLElement>("[data-email-verified-badge]").forEach((badge) => {
        badge.hidden = !verified;
      });
      if (statusEl && !verified) {
        statusEl.textContent = t("auth.verifyEmailPendingHint", { email });
      }
      if (verified) {
        resendButton?.setAttribute("hidden", "true");
      } else {
        resendButton?.removeAttribute("hidden");
      }
    };

    void (async () => {
      try {
        const profile = await apiRequest<Profile>("/api/auth/profile");
        renderVerified(profile.Email, profile.EmailVerified);
      } catch {
        if (statusEl) statusEl.textContent = t("auth.verifyStatusLoadFailed");
      }
    })();

    resendButton?.addEventListener("click", async () => {
      resendButton.setAttribute("disabled", "true");
      setResendStatus(t("auth.statusSendingVerification"), "info");
      try {
        const result = await apiRequest<{ AlreadyVerified: boolean }>("/api/auth/resend-verification", {
          method: "POST",
          body: {},
        });
        if (result.AlreadyVerified) {
          setResendStatus(t("auth.verifyAlreadyDone"), "success");
          renderVerified(readSession()?.Email ?? "", true);
        } else {
          setResendStatus(t("auth.verifySent"), "success");
        }
      } catch (error) {
        setResendStatus(error instanceof Error ? error.message : t("auth.errorVerifySendFailed"), "error");
      } finally {
        resendButton.removeAttribute("disabled");
      }
    });
  }

  // Profil-Dashboard: Zaehler-Kacheln fuer Favoriten/Blockiert/eigene Inserate
  function bindProfileStats() {
    const counters = document.querySelectorAll<HTMLElement>("[data-profile-stat]");
    if (counters.length === 0 || !readSession()) return;

    const endpoints: Record<string, string> = {
      favorites: "/api/favorites",
      blocked: "/api/blocked",
      mine: "/api/properties/user",
    };

    counters.forEach((counter) => {
      const endpoint = endpoints[counter.getAttribute("data-profile-stat") ?? ""];
      // Verkaeufer-Kacheln sind fuer Kaeufer versteckt - Anfrage sparen
      if (!endpoint || counter.closest("[hidden]")) return;
      void (async () => {
        try {
          const response = await apiRequest<{ Properties: unknown[] }>(endpoint);
          counter.textContent = String(response.Properties?.length ?? 0);
        } catch {
          // Zaehler sind Komfort - bei Fehlern bleibt der Platzhalter stehen
        }
      })();
    });
  }

  function hasCheckbox(formData: FormData, name: string) {
    return formData.has(name);
  }

  function getStringArray(formData: FormData, name: string) {
    // Der OrtPicker sammelt seine Auswahl kommagetrennt in EINEM Hidden-Input -
    // ohne Split wuerde "wels,linz" als ein Wert gespeichert und das
    // Backend-Matching (Stadt == Eintrag) griffe bei Mehrfachauswahl nie.
    return formData.getAll(name)
      .flatMap((value) => String(value).split(","))
      .map((value) => value.trim())
      .filter(Boolean);
  }

  function buildNotificationPreferences(formData: FormData) {
    return {
      IsEnabled: hasCheckbox(formData, "isEnabled"),
      FilterMode: String(formData.get("filterMode") ?? "SameAsSearch"),
      Locations: getStringArray(formData, "locations"),
      IsHausSelected: hasCheckbox(formData, "house"),
      IsGrundstueckSelected: hasCheckbox(formData, "land"),
      IsZwangsversteigerungSelected: hasCheckbox(formData, "foreclosure"),
      IsPrivateSelected: hasCheckbox(formData, "private"),
      IsBrokerSelected: hasCheckbox(formData, "broker"),
    };
  }

  function buildFilterPreferences(formData: FormData) {
    return {
      SelectedOrtes: getStringArray(formData, "locations"),
      SelectedAgeFilter: Number(formData.get("ageFilter") ?? 0),
      IsHausSelected: hasCheckbox(formData, "house"),
      IsGrundstueckSelected: hasCheckbox(formData, "land"),
      IsZwangsversteigerungSelected: hasCheckbox(formData, "foreclosure"),
      IsPrivateSelected: hasCheckbox(formData, "private"),
      IsBrokerSelected: hasCheckbox(formData, "broker"),
      ExcludedSellerSourceIds: [],
      SelectedSort: Number(formData.get("sort") ?? 0),
    };
  }

  function setCheckbox(form: HTMLFormElement, name: string, checked: boolean | undefined) {
    const input = form.querySelector<HTMLInputElement>(`input[type="checkbox"][name="${name}"]`);
    if (input && typeof checked === "boolean") input.checked = checked;
  }

  function setCheckboxValues(form: HTMLFormElement, name: string, values: unknown) {
    const selected = new Set(Array.isArray(values) ? values.map(String) : []);
    form.querySelectorAll<HTMLInputElement>(`input[type="checkbox"][name="${name}"]`).forEach((input) => {
      input.checked = selected.has(input.value);
    });
  }

  function normalizeAgeFilterValue(value: unknown) {
    const numeric = Number(value ?? 0);
    if (numeric === 7) return "2";
    if (numeric === 30) return "3";
    if (numeric >= 365) return "4";
    if ([0, 1, 2, 3, 4].includes(numeric)) return String(numeric);
    return "0";
  }

  function normalizeSortValue(value: unknown) {
    const numeric = Number(value ?? 0);
    return [0, 1, 2, 3, 4, 5, 6, 7].includes(numeric) ? String(numeric) : "0";
  }

  // Der OrtPicker haelt seine Auswahl in unbenannten Checkboxen + einem Hidden-Input;
  // die Wiederherstellung muss daher ueber seine programmatische API laufen, sonst
  // geht die gespeicherte Ortsauswahl beim naechsten Speichern still verloren.
  // Retry, weil die Skript-Ausfuehrungsreihenfolge (Picker vs. dieses Bundle) nicht garantiert ist.
  function applyOrtPickerSelection(name: string, values: unknown, attempt = 0) {
    if (!document.querySelector(`[data-ort-picker][data-ort-picker-name="${name}"]`)) return;
    const setter = (window as { setOrtPickerValues?: (n: string, v: string[]) => void }).setOrtPickerValues;
    if (typeof setter === "function") {
      setter(name, Array.isArray(values) ? values.map(String) : []);
      return;
    }
    if (attempt < 20) {
      window.setTimeout(() => applyOrtPickerSelection(name, values, attempt + 1), 100);
    }
  }

  type PreferenceMode = "notifications" | "filters";

  type PendingPreferenceSyncResult = "none" | "synced" | "failed";

  function getPreferenceConfig(mode: PreferenceMode) {
    return mode === "notifications"
      ? {
          endpoint: "/api/notifications/preferences",
          method: "PUT",
          storageKey: STORAGE_KEYS.notificationPreferences,
          pendingKey: STORAGE_KEYS.pendingNotificationPreferences,
        }
      : {
          endpoint: "/api/auth/filter-preferences",
          method: "POST",
          storageKey: STORAGE_KEYS.filterPreferences,
          pendingKey: STORAGE_KEYS.pendingFilterPreferences,
        };
  }

  async function syncPendingPreference(mode: PreferenceMode): Promise<PendingPreferenceSyncResult> {
    if (!readSession()) return "none";

    const config = getPreferenceConfig(mode);
    const pending = readJson<Record<string, unknown>>(config.pendingKey);
    if (!pending) return "none";

    try {
      await apiRequest(config.endpoint, { method: config.method, body: pending, authRequired: true });
      writeJson(config.storageKey, pending);
      window.localStorage.removeItem(config.pendingKey);
      return "synced";
    } catch (error) {
      // Pending-Daten bleiben erhalten und werden beim naechsten Seitenaufruf
      // erneut versucht. Ein nachfolgendes GET darf sie nicht ueberschreiben.
      console.warn(`[Heimatplatz] ${mode} preferences pending sync failed`, error);
      return "failed";
    }
  }

  async function syncPendingPreferences() {
    await Promise.all([
      syncPendingPreference("notifications"),
      syncPendingPreference("filters"),
    ]);
  }

  function applyPreferencesToForm(
    form: HTMLFormElement,
    mode: PreferenceMode,
    preferences: Record<string, unknown>,
  ) {
    if (mode === "notifications") {
      setCheckbox(form, "isEnabled", preferences.IsEnabled as boolean);
      setCheckbox(form, "house", preferences.IsHausSelected as boolean);
      setCheckbox(form, "land", preferences.IsGrundstueckSelected as boolean);
      setCheckbox(form, "foreclosure", preferences.IsZwangsversteigerungSelected as boolean);
      setCheckbox(form, "private", preferences.IsPrivateSelected as boolean);
      setCheckbox(form, "broker", preferences.IsBrokerSelected as boolean);
      setCheckboxValues(form, "locations", preferences.Locations);
      applyOrtPickerSelection("locations", preferences.Locations);
      if (typeof preferences.FilterMode === "string") {
        const filterMode = form.querySelector<HTMLInputElement>(`input[name='filterMode'][value='${preferences.FilterMode}']`);
        if (filterMode) filterMode.checked = true;
      }
      updateNotificationPreferenceVisibility(form);
      return;
    }

    setCheckbox(form, "house", preferences.IsHausSelected as boolean);
    setCheckbox(form, "land", preferences.IsGrundstueckSelected as boolean);
    setCheckbox(form, "foreclosure", preferences.IsZwangsversteigerungSelected as boolean);
    setCheckbox(form, "private", preferences.IsPrivateSelected as boolean);
    setCheckbox(form, "broker", preferences.IsBrokerSelected as boolean);
    const age = form.querySelector<HTMLSelectElement>("[name='ageFilter']");
    const sort = form.querySelector<HTMLSelectElement>("[name='sort']");
    const location = form.querySelector<HTMLSelectElement>("[name='locations']");
    if (age && preferences.SelectedAgeFilter !== undefined) age.value = normalizeAgeFilterValue(preferences.SelectedAgeFilter);
    if (sort && preferences.SelectedSort !== undefined) sort.value = normalizeSortValue(preferences.SelectedSort);
    setCheckboxValues(form, "locations", preferences.SelectedOrtes);
    // Nur echte <select>-Fallbacks direkt setzen - der OrtPicker-Hidden-Input
    // wird ueber applyOrtPickerSelection befuellt (sonst ginge Mehrfachauswahl verloren)
    if (location instanceof HTMLSelectElement && Array.isArray(preferences.SelectedOrtes) && preferences.SelectedOrtes[0]) {
      location.value = String(preferences.SelectedOrtes[0]);
    }
    applyOrtPickerSelection("locations", preferences.SelectedOrtes);
  }

  function applySavedPreferences() {
    document.querySelectorAll<HTMLFormElement>("[data-preferences-form]").forEach((form) => {
      const mode = form.getAttribute("data-preferences-form") as PreferenceMode | null;
      if (!mode) return;
      const preferences = mode === "notifications"
        ? readJson<Record<string, unknown>>(STORAGE_KEYS.notificationPreferences)
        : readJson<Record<string, unknown>>(STORAGE_KEYS.filterPreferences);
      if (preferences) applyPreferencesToForm(form, mode, preferences);
    });
  }

  async function loadRemotePreference(
    mode: PreferenceMode,
    endpoint: string,
    storageKey: string,
  ) {
    const form = document.querySelector<HTMLFormElement>(`[data-preferences-form="${mode}"]`);
    const revision = preferenceLoadRevision;
    form?.setAttribute("aria-busy", "true");

    try {
      const pendingResult = await syncPendingPreference(mode);
      if (pendingResult === "failed") return;

      const preferences = await apiRequest<Record<string, unknown>>(endpoint, { authRequired: true });
      if (revision !== preferenceLoadRevision || !readSession()) return;
      writeJson(storageKey, preferences);
      if (form && form.dataset.preferencesDirty !== "true") {
        applyPreferencesToForm(form, mode, preferences);
      }
      if (mode === "filters") {
        document.dispatchEvent(new CustomEvent("filter-preferences-loaded", { detail: preferences }));
      }
    } catch (error) {
      // Lokale Einstellungen bleiben als Offline-Fallback aktiv. Eine beendete
      // Sitzung ist erwartbar und keine Warnung wert.
      if (readSession()) console.warn(`[Heimatplatz] ${mode} preferences load failed`, error);
    } finally {
      form?.removeAttribute("aria-busy");
    }
  }

  function loadRemotePreferences() {
    if (!readSession()) return;

    const needsNotifications = Boolean(document.querySelector("[data-preferences-form='notifications']"));
    const needsFilters = Boolean(document.querySelector("[data-preferences-form='filters'], [data-search-config]"));

    if (needsNotifications) {
      void loadRemotePreference(
        "notifications",
        "/api/notifications/preferences",
        STORAGE_KEYS.notificationPreferences,
      );
    } else {
      void syncPendingPreference("notifications");
    }
    if (needsFilters) {
      void loadRemotePreference(
        "filters",
        "/api/auth/filter-preferences",
        STORAGE_KEYS.filterPreferences,
      );
    } else {
      void syncPendingPreference("filters");
    }
  }

  function updateNotificationPreferenceVisibility(form: HTMLFormElement) {
    const enabled = form.querySelector<HTMLInputElement>("[name='isEnabled']")?.checked ?? false;
    const mode = form.querySelector<HTMLInputElement>("[name='filterMode']:checked")?.value ?? "SameAsSearch";
    const showFilters = enabled;
    const showCustom = enabled && mode === "Custom";

    form.querySelectorAll<HTMLElement>("[data-notification-filter-settings]").forEach((element) => {
      element.hidden = !showFilters;
    });
    form.querySelectorAll<HTMLElement>("[data-notification-custom]").forEach((element) => {
      element.hidden = !showCustom;
    });
    form.querySelectorAll<HTMLElement>("[data-notification-samesearch]").forEach((element) => {
      element.hidden = mode !== "SameAsSearch";
    });
  }

  function bindNotificationPreferenceVisibility() {
    document.querySelectorAll<HTMLFormElement>("[data-preferences-form='notifications']").forEach((form) => {
      form.addEventListener("change", () => updateNotificationPreferenceVisibility(form));
      updateNotificationPreferenceVisibility(form);
    });
  }

  // ---- Web Push (Browser-Benachrichtigungen) ----
  // Der Service Worker (public/push-sw.js) zeigt eingehende Pushes an und oeffnet
  // beim Klick die Immobilien-Detailseite. Die Subscription wird ueber
  // /api/notifications/register-device an das angemeldete Konto gebunden.
  const WEB_PUSH_SW_PATH = "/push-sw.js";

  function isWebPushSupported() {
    return window.isSecureContext
      && "serviceWorker" in navigator
      && "PushManager" in window
      && "Notification" in window;
  }

  function getWebPushDeviceId() {
    let deviceId = window.localStorage.getItem(STORAGE_KEYS.webPushDeviceId);
    if (!deviceId) {
      deviceId = typeof crypto.randomUUID === "function"
        ? crypto.randomUUID()
        : `web-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      try {
        window.localStorage.setItem(STORAGE_KEYS.webPushDeviceId, deviceId);
      } catch {
        // Ohne localStorage entsteht pro Registrierung eine neue DeviceId -
        // der Server konsolidiert dann ueber den Subscription-Endpoint (DeviceToken).
      }
    }
    return deviceId;
  }

  function urlBase64ToUint8Array(base64: string) {
    const padding = "=".repeat((4 - (base64.length % 4)) % 4);
    const normalized = (base64 + padding).replace(/-/g, "+").replace(/_/g, "/");
    const raw = window.atob(normalized);
    return Uint8Array.from(raw, (char) => char.charCodeAt(0));
  }

  function bufferToBase64Url(buffer: ArrayBuffer | null) {
    if (!buffer) return "";
    let binary = "";
    new Uint8Array(buffer).forEach((byte) => {
      binary += String.fromCharCode(byte);
    });
    return window.btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  }

  async function getWebPushSubscription() {
    const registration = await navigator.serviceWorker.getRegistration(WEB_PUSH_SW_PATH);
    return (await registration?.pushManager.getSubscription()) ?? null;
  }

  async function registerWebPushSubscription(subscription: PushSubscription) {
    const keys = subscription.toJSON().keys ?? {};
    await apiRequest("/api/notifications/register-device", {
      method: "POST",
      body: {
        DeviceToken: subscription.endpoint,
        Platform: "Web",
        DeviceId: getWebPushDeviceId(),
        Data: { p256dh: keys.p256dh ?? "", auth: keys.auth ?? "" },
      },
    });
  }

  function setWebPushUi(statusText: string, action: "enable" | "disable" | "login" | null, buttonLabel?: string) {
    const section = document.querySelector<HTMLElement>("[data-web-push]");
    if (!section) return;
    section.hidden = false;

    const status = section.querySelector<HTMLElement>("[data-web-push-status]");
    if (status) status.textContent = statusText;

    const button = section.querySelector<HTMLButtonElement>("[data-web-push-toggle]");
    if (!button) return;
    if (!action) {
      button.hidden = true;
      return;
    }
    button.hidden = false;
    button.setAttribute("data-web-push-action", action);
    button.textContent = buttonLabel ?? "";
  }

  async function renderWebPushSection() {
    const section = document.querySelector<HTMLElement>("[data-web-push]");
    if (!section) return;

    if (!isWebPushSupported()) {
      setWebPushUi(t("notifications.webPushUnsupported"), null);
      return;
    }

    if (Notification.permission === "denied") {
      setWebPushUi(t("notifications.webPushBlocked"), null);
      return;
    }

    const subscription = await getWebPushSubscription().catch(() => null);
    if (subscription) {
      setWebPushUi(t("notifications.webPushActive"), "disable", t("notifications.webPushDisable"));
    } else if (!readSession()) {
      setWebPushUi(t("notifications.webPushLoginFirst"), "login", t("common.login"));
    } else {
      setWebPushUi(t("notifications.webPushOffer"), "enable", t("notifications.webPushEnable"));
    }
  }

  async function enableWebPush(button: HTMLButtonElement) {
    if (!readSession()) {
      window.location.href = getLoginHrefForCurrentPage();
      return;
    }

    button.disabled = true;
    try {
      setWebPushUi(t("notifications.webPushSettingUp"), null);
      const registration = await navigator.serviceWorker.register(WEB_PUSH_SW_PATH);

      const permission = await Notification.requestPermission();
      if (permission !== "granted") {
        void renderWebPushSection();
        return;
      }

      const keyResponse = await apiRequest<{ Enabled?: boolean; PublicKey?: string | null }>(
        "/api/notifications/web-push-public-key",
        { skipAuth: true },
      );
      if (!keyResponse.PublicKey) {
        setWebPushUi(t("notifications.webPushNotConfigured"), null);
        return;
      }

      // Bei rotiertem VAPID-Schluessel ist die alte Subscription wertlos - neu abonnieren
      let subscription = await registration.pushManager.getSubscription();
      if (subscription && bufferToBase64Url(subscription.options.applicationServerKey) !== keyResponse.PublicKey) {
        await subscription.unsubscribe();
        subscription = null;
      }

      subscription ??= await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(keyResponse.PublicKey),
      });

      await registerWebPushSubscription(subscription);
    } catch (error) {
      console.warn("[Heimatplatz] Web-Push-Aktivierung fehlgeschlagen", error);
      setWebPushUi(
        error instanceof Error
          ? t("notifications.webPushEnableFailedDetail", { message: error.message })
          : t("notifications.webPushEnableFailed"),
        "enable",
        t("common.retry"),
      );
      return;
    } finally {
      button.disabled = false;
    }
    void renderWebPushSection();
  }

  async function disableWebPush(button: HTMLButtonElement) {
    button.disabled = true;
    try {
      const subscription = await getWebPushSubscription();
      if (subscription) {
        // Server-Abmeldung ist Best-Effort: ein verwaister Endpoint wird beim
        // naechsten Sendeversuch automatisch geprunt (410 Gone).
        try {
          await apiRequest("/api/notifications/unregister-device", {
            method: "POST",
            body: { DeviceToken: subscription.endpoint, Platform: "Web" },
          });
        } catch (error) {
          console.warn("[Heimatplatz] Web-Push-Server-Abmeldung fehlgeschlagen", error);
        }
        await subscription.unsubscribe();
      }
    } finally {
      button.disabled = false;
    }
    void renderWebPushSection();
  }

  // Bestehende Subscription beim Seitenbesuch erneut ans aktuelle Konto binden
  // (z.B. nach Logout/Login mit anderem Benutzer im selben Browser).
  async function syncWebPushRegistration() {
    if (!isWebPushSupported() || Notification.permission !== "granted" || !readSession()) return;
    try {
      const subscription = await getWebPushSubscription();
      if (subscription) await registerWebPushSubscription(subscription);
    } catch (error) {
      console.warn("[Heimatplatz] Web-Push-Sync fehlgeschlagen", error);
    }
  }

  function initWebPush() {
    const section = document.querySelector<HTMLElement>("[data-web-push]");
    if (!section) return;

    const button = section.querySelector<HTMLButtonElement>("[data-web-push-toggle]");
    button?.addEventListener("click", () => {
      const action = button.getAttribute("data-web-push-action");
      if (action === "enable") void enableWebPush(button);
      else if (action === "disable") void disableWebPush(button);
      else if (action === "login") window.location.href = getLoginHrefForCurrentPage();
    });

    void renderWebPushSection();
    void syncWebPushRegistration();
  }

  function bindPreferenceForms() {
    document.querySelectorAll<HTMLFormElement>("[data-preferences-form]").forEach((form) => {
      const markDirty = () => {
        form.dataset.preferencesDirty = "true";
      };
      form.addEventListener("input", markDirty);
      form.addEventListener("change", markDirty);
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const mode = form.getAttribute("data-preferences-form");
        const submit = form.querySelector<HTMLButtonElement>("[type='submit']");
        const formData = new FormData(form);

        if (mode === "filters") {
          const hasHouse = hasCheckbox(formData, "house");
          const hasLand = hasCheckbox(formData, "land");
          const hasForeclosure = hasCheckbox(formData, "foreclosure");
          if (!hasHouse && !hasLand && !hasForeclosure) {
            setFormStatus(form, t("search.settingsTypeRequired"), "error");
            form.querySelector<HTMLInputElement>("[name='house']")?.focus();
            return;
          }
          // Bei reiner Zwangsversteigerungs-Auswahl gibt es keinen Anbietertyp.
          // Sobald Haus oder Grund aktiv sind, muss mindestens einer gewählt sein.
          if ((hasHouse || hasLand) && !["private", "broker"].some((name) => hasCheckbox(formData, name))) {
            setFormStatus(form, t("search.settingsSellerRequired"), "error");
            form.querySelector<HTMLInputElement>("[name='private']")?.focus();
            return;
          }
        }

        const preferences = mode === "notifications"
          ? buildNotificationPreferences(formData)
          : buildFilterPreferences(formData);

        const preferenceMode: PreferenceMode = mode === "notifications" ? "notifications" : "filters";
        const config = getPreferenceConfig(preferenceMode);

        const session = readSession();
        writeJson(config.storageKey, preferences);
        if (session) {
          // Ein etwaiger Gast-Stand ist durch diese neuere Eingabe ersetzt.
          window.localStorage.removeItem(config.pendingKey);
        } else {
          writeJson(config.pendingKey, preferences);
        }
        submit?.setAttribute("disabled", "true");
        setFormStatus(form, session ? t("search.prefsSyncing") : t("search.prefsSavedLocal"));

        try {
          if (session) {
            await apiRequest(config.endpoint, { method: config.method, body: preferences });
            setFormStatus(form, t("search.prefsSavedSynced"), "success");
          } else {
            setFormStatus(form, t("search.prefsSavedLocalLoginHint"), "success");
          }
          form.dataset.preferencesDirty = "false";
        } catch (error) {
          setFormStatus(
            form,
            error instanceof Error
              ? t("search.prefsSyncFailedDetail", { message: error.message })
              : t("search.prefsSyncFailed"),
            "error",
          );
        } finally {
          submit?.removeAttribute("disabled");
        }
      });
    });
  }

  function refreshActionButtons() {
    const favorites = new Set(readArray(STORAGE_KEYS.favorites));
    const blocked = new Set(readArray(STORAGE_KEYS.blocked));

    document.querySelectorAll("[data-property-action]").forEach((button) => {
      const action = button.getAttribute("data-property-action");
      const slug = button.getAttribute("data-property-slug");
      if (!slug || !(button instanceof HTMLButtonElement)) return;

      const active = action === "favorite" ? favorites.has(slug) : blocked.has(slug);
      button.setAttribute("aria-pressed", String(active));
      if (action === "favorite") {
        button.setAttribute("aria-label", active ? t("card.favoriteRemove") : t("card.favoriteAdd"));
      }
      if (action === "block") {
        button.setAttribute("aria-label", active ? t("card.blockRemove") : t("card.blockAdd"));
      }

      const label = button.querySelector<HTMLElement>("[data-action-label]");
      if (label) {
        label.textContent = active
          ? button.getAttribute("data-active-text") ?? label.textContent
          : button.getAttribute("data-inactive-text") ?? label.textContent;
      }
    });
  }

  type PropertyActionListResponse = {
    Properties?: Array<{ Id?: string }>;
    HasMore?: boolean;
  };

  async function loadAllRemotePropertyIds(endpoint: string) {
    const ids: string[] = [];

    for (let page = 0; page < 100; page += 1) {
      const separator = endpoint.includes("?") ? "&" : "?";
      const response = await apiRequest<PropertyActionListResponse>(
        `${endpoint}${separator}Page=${page}&PageSize=100`,
        { authRequired: true },
      );
      (response.Properties ?? []).forEach((property) => {
        if (property.Id) ids.push(property.Id);
      });
      if (!response.HasMore) break;
    }

    return ids;
  }

  async function hydrateRemotePropertyActions() {
    if (!readSession() || !document.querySelector("[data-property-action], [data-search-config]")) return;

    const revision = propertyActionRevision;
    const [favorites, blocked] = await Promise.allSettled([
      loadAllRemotePropertyIds("/api/favorites"),
      loadAllRemotePropertyIds("/api/blocked"),
    ]);

    // Eine inzwischen erfolgte Benutzeraktion hat Vorrang vor einem aelteren GET.
    if (revision !== propertyActionRevision) return;

    // Abgelaufene Sitzung ist kein Fehlerfall: readSession() ist dann bereits leer,
    // die Listen bleiben schlicht ungeladen (Gast-Zustand).
    const sessionEnded = !readSession();

    if (favorites.status === "fulfilled") {
      writeArray(STORAGE_KEYS.favorites, favorites.value);
    } else if (!sessionEnded) {
      console.warn("[Heimatplatz] Favorite state load failed", favorites.reason);
    }
    if (blocked.status === "fulfilled") {
      writeArray(STORAGE_KEYS.blocked, blocked.value);
    } else if (!sessionEnded) {
      console.warn("[Heimatplatz] Blocked state load failed", blocked.reason);
    }

    refreshActionButtons();
    syncUserLists();
  }

  function closeCardMenus(except?: HTMLElement | null) {
    document.querySelectorAll<HTMLElement>("[data-card-menu]").forEach((menu) => {
      if (menu === except) return;
      menu.classList.add("hidden");
      const button = document.querySelector<HTMLButtonElement>(`[data-card-action][aria-controls="${menu.id}"]`);
      button?.setAttribute("aria-expanded", "false");
    });
  }

  type PropertyActionMutationResponse = {
    Success?: boolean;
    Message?: string | null;
  };

  async function assertPropertyActionSucceeded(
    response: PropertyActionMutationResponse,
    action: "favorite" | "block",
    propertyId: string,
  ) {
    if (response?.Success !== false) return;

    // POSTs sind fachlich idempotent: wenn ein aelterer lokaler Stand noch
    // "inaktiv" sagte, der Server den Eintrag aber bereits kennt, ist der
    // gewuenschte Zielzustand trotzdem erreicht.
    const endpoint = action === "favorite" ? "/api/favorites" : "/api/blocked";
    try {
      const remoteIds = await loadAllRemotePropertyIds(endpoint);
      if (remoteIds.includes(propertyId)) return;
    } catch {
      // Die urspruengliche fachliche Fehlermeldung bleibt aussagekraeftiger.
    }

    throw new Error(response.Message || t("card.actionSyncFailed"));
  }

  function setPropertyActionBusy(slug: string, busy: boolean) {
    document.querySelectorAll<HTMLButtonElement>("[data-property-action], [data-list-remove]").forEach((button) => {
      if (button.getAttribute("data-property-slug") !== slug) return;
      button.disabled = busy;
      button.toggleAttribute("aria-busy", busy);
      button.classList.toggle("opacity-60", busy);
    });
  }

  function showPropertyActionError(error: unknown) {
    let status = document.querySelector<HTMLElement>("[data-property-action-status]");
    if (!status) {
      status = document.createElement("div");
      status.dataset.propertyActionStatus = "";
      status.setAttribute("role", "alert");
      status.className = "fixed bottom-4 left-1/2 z-[70] w-[min(92vw,32rem)] -translate-x-1/2 rounded-lg border border-error/45 bg-card px-4 py-3 text-sm font-medium text-error shadow-xl";
      document.body.append(status);
    }

    const message = error instanceof Error ? error.message.trim() : "";
    status.textContent = message
      ? t("card.actionSyncFailedDetail", { message })
      : t("card.actionSyncFailed");
    status.hidden = false;

    if (propertyActionStatusTimer !== null) {
      window.clearTimeout(propertyActionStatusTimer);
    }
    propertyActionStatusTimer = window.setTimeout(() => {
      status?.remove();
      propertyActionStatusTimer = null;
    }, 6000);
  }

  async function syncRemotePropertyAction(
    action: string | null,
    propertyId: string | null,
    active: boolean,
    oppositeWasActive = false,
  ) {
    const session = readSession();
    if (!session) throw new Error(t("auth.errorSessionExpired"));
    if (!propertyId || !UUID_PATTERN.test(propertyId)) throw new Error(t("card.actionSyncFailed"));

    if (action === "favorite") {
      if (!active) {
        // "Nicht gefunden" bedeutet beim Entfernen ebenfalls: Zielzustand erreicht.
        await apiRequest<PropertyActionMutationResponse>(
          `/api/favorites/${propertyId}`,
          { method: "DELETE" },
        );
        return;
      }

      let blockWasRemoved = false;
      try {
        // Das Backend lehnt Favoriten ab, solange das Objekt blockiert ist.
        // Deshalb die Blockierung zuerst serverseitig aufheben.
        if (oppositeWasActive) {
          await apiRequest<PropertyActionMutationResponse>(
            `/api/blocked/${propertyId}`,
            { method: "DELETE" },
          );
          blockWasRemoved = true;
        }

        const response = await apiRequest<PropertyActionMutationResponse>(
          "/api/favorites",
          { method: "POST", body: { PropertyId: propertyId } },
        );
        await assertPropertyActionSucceeded(response, "favorite", propertyId);
      } catch (error) {
        // Falls Schritt zwei scheitert, den vorherigen Serverzustand bestmoeglich
        // wiederherstellen. AddBlocked entfernt einen eventuell angelegten Favoriten.
        if (blockWasRemoved) {
          try {
            const rollback = await apiRequest<PropertyActionMutationResponse>(
              "/api/blocked",
              { method: "POST", body: { PropertyId: propertyId } },
            );
            await assertPropertyActionSucceeded(rollback, "block", propertyId);
          } catch (rollbackError) {
            console.warn("[Heimatplatz] Property status rollback failed", rollbackError);
          }
        }
        throw error;
      }
      return;
    }

    if (action === "block") {
      if (!active) {
        await apiRequest<PropertyActionMutationResponse>(
          `/api/blocked/${propertyId}`,
          { method: "DELETE" },
        );
        return;
      }

      const response = await apiRequest<PropertyActionMutationResponse>(
        "/api/blocked",
        { method: "POST", body: { PropertyId: propertyId } },
      );
      await assertPropertyActionSucceeded(response, "block", propertyId);
      return;
    }

    throw new Error(t("card.actionSyncFailed"));
  }

  function syncUserLists() {
    const favorites = new Set(readArray(STORAGE_KEYS.favorites));
    const blocked = new Set(readArray(STORAGE_KEYS.blocked));

    document.querySelectorAll("[data-user-list]").forEach((list) => {
      const mode = list.getAttribute("data-user-mode");
      if (mode !== "favorites" && mode !== "blocked") return;

      const wanted = mode === "favorites" ? favorites : blocked;
      let visible = 0;
      list.querySelectorAll<HTMLElement>("[data-property-card]").forEach((card) => {
        const slug = card.getAttribute("data-slug");
        const show = !!slug && wanted.has(slug);
        card.hidden = !show;
        if (show) visible += 1;
      });

      list.classList.toggle("hidden", visible === 0);
      const empty = list.closest("[data-user-page]")?.querySelector("[data-user-empty]");
      empty?.classList.toggle("hidden", visible > 0);
    });
  }


  function createText<K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text: string) {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = text;
    return element;
  }

  function getImageState(form: HTMLFormElement) {
    let state = imageFormState.get(form);
    if (!state) {
      state = [];
      imageFormState.set(form, state);
    }
    return state;
  }

  function getDraftImageUrls(draft: Draft) {
    return Array.isArray(draft.imageUrls) ? draft.imageUrls.filter(Boolean) : [];
  }

  function writeImageUrlField(form: HTMLFormElement) {
    const field = form.querySelector<HTMLInputElement>("[data-property-image-urls]");
    if (!field) return;
    field.value = JSON.stringify(getImageState(form).map((item) => item.url));
  }

  function renderImageGrid(form: HTMLFormElement) {
    const state = getImageState(form);
    const grid = form.querySelector<HTMLElement>("[data-property-image-grid]");
    const count = form.querySelector<HTMLElement>("[data-property-image-count]");
    if (count) count.textContent = t("editor.photoCount", { current: state.length, max: MAX_PROPERTY_IMAGES });
    if (!grid) return;

    grid.textContent = "";
    grid.classList.toggle("hidden", state.length === 0);
    state.forEach((item) => {
      const frame = document.createElement("div");
      frame.className = "relative aspect-[4/3] overflow-hidden rounded-md border border-border bg-muted";

      const image = document.createElement("img");
      image.src = item.url;
      image.alt = item.fileName;
      image.className = "h-full w-full object-cover";
      image.loading = "lazy";
      image.addEventListener("error", () => {
        image.src = "/favicon.svg";
      }, { once: true });

      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "absolute right-1 top-1 grid size-7 place-items-center rounded-full bg-black/70 text-xs font-bold text-white";
      remove.setAttribute("aria-label", t("editor.photoRemove"));
      remove.textContent = "x";
      remove.addEventListener("click", () => {
        imageFormState.set(form, getImageState(form).filter((entry) => entry.id !== item.id));
        writeImageUrlField(form);
        renderImageGrid(form);
      });

      frame.append(image, remove);
      grid.append(frame);
    });

    writeImageUrlField(form);
  }

  function setFormImages(form: HTMLFormElement, urls: string[]) {
    imageFormState.set(
      form,
      urls.slice(0, MAX_PROPERTY_IMAGES).map((url, index) => ({
        id: `existing-${index}-${url}`,
        url,
        fileName: url.split("/").pop() || `Bild ${index + 1}`,
        contentType: url.startsWith("data:") ? (url.match(/^data:([^;]+);/)?.[1] ?? "image/jpeg") : "image/jpeg",
        existing: !url.startsWith("data:"),
      })),
    );
    renderImageGrid(form);
  }

  function readFileAsDataUrl(file: File) {
    return new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.addEventListener("load", () => resolve(String(reader.result ?? "")));
      reader.addEventListener("error", () => reject(reader.error ?? new Error(t("editor.fileReadFailed"))));
      reader.readAsDataURL(file);
    });
  }

  async function getLocalImageUrls(form: HTMLFormElement) {
    const urls: string[] = [];
    for (const item of getImageState(form)) {
      if (!item.file) {
        urls.push(item.url);
      } else {
        urls.push(await readFileAsDataUrl(item.file));
      }
    }
    return urls;
  }

  async function uploadImages(form: HTMLFormElement, requireImage: boolean) {
    const state = getImageState(form);
    if (requireImage && state.length === 0) {
      throw new Error(t("editor.photoRequired"));
    }

    const existingUrls = state.filter((item) => item.existing && item.url).map((item) => item.url);
    const newImages = state.filter((item) => item.file || (!item.existing && item.url.startsWith("data:")));
    if (newImages.length === 0) return existingUrls;

    const images = await Promise.all(newImages.map(async (item) => {
      const dataUrl = item.file ? await readFileAsDataUrl(item.file) : item.url;
      return {
        FileName: item.fileName,
        ContentType: item.contentType || item.file?.type || dataUrl.match(/^data:([^;]+);/)?.[1] || "image/jpeg",
        Base64Data: dataUrl.split(",")[1] ?? "",
      };
    }));

    const response = await apiRequest<{ ImageUrls: string[] }>("/api/properties/images", {
      method: "POST",
      body: { Images: images },
    });

    return [...existingUrls, ...(response.ImageUrls ?? [])];
  }

  function addImageFiles(form: HTMLFormElement, files: File[]) {
    const images = files.filter((file) => file.type.startsWith("image/"));
    if (images.length === 0) return;

    const state = getImageState(form);
    const remaining = Math.max(0, MAX_PROPERTY_IMAGES - state.length);
    images.slice(0, remaining).forEach((file) => {
      state.push({
        id: `${Date.now()}-${crypto.randomUUID?.() ?? Math.random().toString(36).slice(2)}`,
        url: URL.createObjectURL(file),
        fileName: file.name,
        contentType: file.type || "image/jpeg",
        existing: false,
        file,
      });
    });

    renderImageGrid(form);
    if (images.length > remaining) {
      setFormStatus(form, t("editor.photoLimitReached", { remaining }), "error");
    }
  }

  // Dateidialog bewusst per JS oeffnen (statt <label for>): showPicker ist der
  // dokumentierte Weg, click() der Fallback fuer aeltere Browser.
  function openImagePicker(form: HTMLFormElement, input: HTMLInputElement) {
    try {
      if (typeof input.showPicker === "function") {
        input.showPicker();
        return;
      }
    } catch (error) {
      console.warn("[Heimatplatz] showPicker failed, falling back to click()", error);
    }

    try {
      input.click();
    } catch (error) {
      console.warn("[Heimatplatz] file picker failed", error);
      setFormStatus(form, t("editor.photoPickerFailed"), "error");
    }
  }

  function bindImagePickers() {
    document.querySelectorAll<HTMLFormElement>("[data-local-property-form]").forEach((form) => {
      renderImageGrid(form);
      const input = form.querySelector<HTMLInputElement>("[data-property-images]");
      if (!input) return;

      input.addEventListener("change", () => {
        addImageFiles(form, Array.from(input.files ?? []));
        input.value = "";
      });

      form.querySelectorAll<HTMLElement>("[data-photo-trigger]").forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          openImagePicker(form, input);
        });
      });

      // Drag&Drop auf die Fotoflaeche - unabhaengig vom Dateidialog
      const dropzone = form.querySelector<HTMLElement>("[data-photo-dropzone]");
      if (!dropzone) return;

      const setDragState = (active: boolean) => {
        dropzone.classList.toggle("ring-2", active);
        dropzone.classList.toggle("ring-primary", active);
      };
      ["dragenter", "dragover"].forEach((type) =>
        dropzone.addEventListener(type, (event) => {
          event.preventDefault();
          setDragState(true);
        }),
      );
      ["dragleave", "dragend"].forEach((type) =>
        dropzone.addEventListener(type, () => setDragState(false)),
      );
      dropzone.addEventListener("drop", (event) => {
        event.preventDefault();
        setDragState(false);
        addImageFiles(form, Array.from((event as DragEvent).dataTransfer?.files ?? []));
      });
    });
  }

