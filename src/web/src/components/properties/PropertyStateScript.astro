  /**
   * Nachrichten-Eingabe im Messenger-Stil (Markup: components/app/MessageComposer.astro):
   * Bilder und Sprachnachricht haengen direkt an der Zeile. Bild-Vorschauen ueber
   * createObjectURL (CSP: blob:), Sprachaufnahme ueber MediaRecorder - fehlt die API
   * (z.B. ohne HTTPS), bleibt das Mikrofon ausgeblendet, alles andere funktioniert.
   */
  type ComposerAttachment = {
    kind: "image" | "audio";
    blob: Blob;
    fileName: string;
    contentType: string;
    durationSeconds: number | null;
    previewUrl: string;
  };

  function canRecordAudio() {
    return (
      typeof MediaRecorder !== "undefined" &&
      !!navigator.mediaDevices &&
      typeof navigator.mediaDevices.getUserMedia === "function"
    );
  }

  function readBlobAsDataUrl(blob: Blob) {
    return new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.addEventListener("load", () => resolve(String(reader.result)));
      reader.addEventListener("error", () => reject(reader.error));
      reader.readAsDataURL(blob);
    });
  }

  function setupMessageComposer(root: HTMLElement, onSend: () => void | Promise<void>) {
    const list = root.querySelector<HTMLElement>("[data-composer-attachments]");
    const input = root.querySelector<HTMLTextAreaElement>("[data-composer-input]");
    const fileInput = root.querySelector<HTMLInputElement>("[data-composer-files]");
    const captureInput = root.querySelector<HTMLInputElement>("[data-composer-capture]");
    const attachButton = root.querySelector<HTMLButtonElement>("[data-composer-attach]");
    const cameraButton = root.querySelector<HTMLButtonElement>("[data-composer-camera]");
    const micButton = root.querySelector<HTMLButtonElement>("[data-composer-mic]");
    const sendButton = root.querySelector<HTMLButtonElement>("[data-composer-send]");
    const row = root.querySelector<HTMLElement>("[data-composer-row]");
    const recordingRow = root.querySelector<HTMLElement>("[data-composer-recording]");
    const recordTime = root.querySelector<HTMLElement>("[data-composer-record-time]");
    const cancelRecord = root.querySelector<HTMLButtonElement>("[data-composer-record-cancel]");
    const stopRecord = root.querySelector<HTMLButtonElement>("[data-composer-record-stop]");
    const errorEl = root.querySelector<HTMLElement>("[data-composer-error]");
    const statusEl = root.querySelector<HTMLElement>("[data-composer-status]");

    const attachments: ComposerAttachment[] = [];
    let recorder: MediaRecorder | null = null;
    let recordStream: MediaStream | null = null;
    let recordChunks: Blob[] = [];
    let recordStartedAt = 0;
    let recordTimer: number | undefined;
    let recordCancelled = false;
    let sending = false;

    function setError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.classList.toggle("hidden", message.length === 0);
    }

    function setStatus(message: string) {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle("hidden", message.length === 0);
    }

    /** Leeres Feld ohne Anhang zeigt das Mikrofon, sonst den Senden-Pfeil (wie im Messenger). */
    function updateButtons() {
      const hasText = (input?.value ?? "").trim().length > 0;
      const showMic = canRecordAudio() && !hasText && attachments.length === 0;
      if (micButton) micButton.hidden = !showMic;
      if (sendButton) {
        sendButton.hidden = showMic;
        sendButton.disabled = sending;
      }
    }

    function renderAttachments() {
      if (!list) return;
      list.innerHTML = "";
      list.hidden = attachments.length === 0;

      attachments.forEach((attachment, index) => {
        const cell = document.createElement("div");
        cell.className = "relative";

        if (attachment.kind === "image") {
          const img = document.createElement("img");
          img.src = attachment.previewUrl;
          img.alt = attachment.fileName;
          img.className = "size-16 rounded-lg border border-border object-cover";
          cell.append(img);
        } else {
          const audioWrap = document.createElement("div");
          audioWrap.className =
            "flex h-16 items-center rounded-lg border border-border bg-muted px-3";
          const audio = document.createElement("audio");
          audio.controls = true;
          audio.src = attachment.previewUrl;
          audio.className = "h-8 max-w-[190px]";
          audioWrap.append(audio);
          cell.append(audioWrap);
        }

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className =
          "absolute -right-2 -top-2 grid size-6 place-items-center rounded-full border border-border bg-background text-xs shadow-sm hover:bg-muted";
        remove.textContent = "✕";
        remove.setAttribute("aria-label", t("feedback.attachmentRemove"));
        remove.addEventListener("click", () => {
          URL.revokeObjectURL(attachment.previewUrl);
          attachments.splice(index, 1);
          // Limit-Meldung ("Maximal 5 Bilder") ist nach dem Entfernen hinfaellig (WEB-026)
          setError("");
          renderAttachments();
          updateButtons();
        });
        cell.append(remove);
        list.append(cell);
      });
    }

    function addImageFiles(files: File[]) {
      for (const file of files) {
        if (attachments.filter((item) => item.kind === "image").length >= MAX_FEEDBACK_IMAGES) {
          setError(t("feedback.photosMax", { count: MAX_FEEDBACK_IMAGES }));
          break;
        }
        attachments.push({
          kind: "image",
          blob: file,
          fileName: file.name,
          contentType: file.type || "image/jpeg",
          durationSeconds: null,
          previewUrl: URL.createObjectURL(file),
        });
      }
      renderAttachments();
      updateButtons();
    }

    function setRecordingUi(active: boolean) {
      if (recordingRow) {
        recordingRow.classList.toggle("hidden", !active);
        recordingRow.classList.toggle("flex", active);
      }
      if (row) row.classList.toggle("hidden", active);
    }

    function stopStream() {
      recordStream?.getTracks().forEach((track) => track.stop());
      recordStream = null;
      window.clearInterval(recordTimer);
      recordTimer = undefined;
    }

    async function startRecording() {
      setError("");
      try {
        recordStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch {
        setError(t("feedback.micDenied"));
        return;
      }

      let activeRecorder: MediaRecorder;
      try {
        activeRecorder = new MediaRecorder(recordStream);
      } catch {
        setError(t("feedback.recordFailed"));
        stopStream();
        return;
      }

      recorder = activeRecorder;
      recordChunks = [];
      recordCancelled = false;
      recordStartedAt = Date.now();

      activeRecorder.addEventListener("dataavailable", (event) => {
        if (event.data.size > 0) recordChunks.push(event.data);
      });
      activeRecorder.addEventListener("stop", () => {
        const durationSeconds = (Date.now() - recordStartedAt) / 1000;
        stopStream();
        setRecordingUi(false);
        recorder = null;

        if (recordCancelled || recordChunks.length === 0) {
          updateButtons();
          return;
        }

        // mimeType kann "audio/webm;codecs=opus" sein - der Server kennt nur den Basistyp
        const contentType = (activeRecorder.mimeType || "audio/webm").split(";")[0];
        const extension = contentType.includes("ogg")
          ? "ogg"
          : contentType.includes("mp4")
            ? "m4a"
            : "webm";
        const blob = new Blob(recordChunks, { type: contentType });

        attachments.push({
          kind: "audio",
          blob,
          fileName: `sprachnachricht.${extension}`,
          contentType,
          durationSeconds,
          previewUrl: URL.createObjectURL(blob),
        });

        renderAttachments();
        updateButtons();
      });

      activeRecorder.start();
      setRecordingUi(true);
      if (recordTime) recordTime.textContent = "0:00";
      recordTimer = window.setInterval(() => {
        if (!recordTime) return;
        const total = Math.floor((Date.now() - recordStartedAt) / 1000);
        recordTime.textContent = `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
      }, 500);
    }

    attachButton?.addEventListener("click", () => fileInput?.click());
    cameraButton?.addEventListener("click", () => captureInput?.click());
    fileInput?.addEventListener("change", () => {
      addImageFiles(Array.from(fileInput.files ?? []));
      fileInput.value = "";
    });
    captureInput?.addEventListener("change", () => {
      addImageFiles(Array.from(captureInput.files ?? []));
      captureInput.value = "";
    });
    micButton?.addEventListener("click", () => void startRecording());
    cancelRecord?.addEventListener("click", () => {
      recordCancelled = true;
      recorder?.stop();
    });
    stopRecord?.addEventListener("click", () => recorder?.stop());
    sendButton?.addEventListener("click", () => void onSend());

    input?.addEventListener("input", () => {
      updateButtons();
      // Eingabefeld waechst mit dem Text (wie im Messenger)
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 160)}px`;
    });

    updateButtons();
    renderAttachments();

    return {
      get text() {
        return (input?.value ?? "").trim();
      },
      get hasContent() {
        return (input?.value ?? "").trim().length > 0 || attachments.length > 0;
      },
      setError,
      setSending(value: boolean) {
        sending = value;
        setStatus(value ? t("feedback.submitting") : "");
        updateButtons();
      },
      /** Beendet eine laufende Aufnahme, damit sie beim Senden nicht verloren geht. */
      async finishPendingRecording() {
        const active = recorder;
        if (!active || active.state === "inactive") return;
        await new Promise<void>((resolve) => {
          active.addEventListener("stop", () => resolve(), { once: true });
          active.stop();
        });
      },
      /** Laedt alle Anhaenge einzeln hoch und liefert die Referenzen fuer die API. */
      async uploadAttachments() {
        const uploaded: { Url: string; DurationSeconds: number | null }[] = [];
        for (const [index, attachment] of attachments.entries()) {
          setStatus(t("feedback.uploadingPhotos", { current: index + 1, total: attachments.length }));
          const dataUrl = await readBlobAsDataUrl(attachment.blob);
          const response = await apiRequest<{ Url: string }>("/api/feedback/attachments", {
            method: "POST",
            body: {
              FileName: attachment.fileName,
              ContentType: attachment.contentType,
              Base64Data: dataUrl.split(",")[1] ?? "",
            },
          });
          uploaded.push({ Url: response.Url, DurationSeconds: attachment.durationSeconds });
        }
        setStatus("");
        return uploaded;
      },
      reset() {
        if (input) {
          input.value = "";
          input.style.height = "auto";
        }
        attachments.forEach((attachment) => URL.revokeObjectURL(attachment.previewUrl));
        attachments.length = 0;
        renderAttachments();
        setError("");
        setStatus("");
        updateButtons();
      },
    };
  }

  function createFeedbackBadge(text: string, classes: string) {
    const badge = document.createElement("span");
    badge.className = `rounded-full px-2 py-0.5 text-xs font-medium ${classes}`;
    badge.textContent = text;
    return badge;
  }

  async function renderFeedbackTicketList() {
    const list = document.querySelector<HTMLElement>("[data-feedback-list]");
    const empty = document.querySelector<HTMLElement>("[data-feedback-list-empty]");
    const error = document.querySelector<HTMLElement>("[data-feedback-list-error]");
    if (!list || !readSession()) return;

    try {
      const response = await apiRequest<{ Tickets: FeedbackTicketSummary[] }>("/api/feedback");
      list.innerHTML = "";
      const tickets = response.Tickets ?? [];
      list.hidden = tickets.length === 0;
      if (empty) empty.classList.toggle("hidden", tickets.length > 0);

      for (const ticket of tickets) {
        const item = document.createElement("li");
        item.className = "relative";

        // Eigener Button ausserhalb des <a> (kein interaktives Element im Link verschachteln) -
        // der Auto-Titel ("Lob 1" etc.) laesst sich hier umbenennen, siehe categoryLegend-Flow.
        const renameButton = document.createElement("button");
        renameButton.type = "button";
        renameButton.className = "absolute right-5 top-4 text-xs font-medium text-primary hover:underline";
        renameButton.textContent = t("feedback.renameAction");
        renameButton.addEventListener("click", async (event) => {
          event.preventDefault();
          event.stopPropagation();
          const next = window.prompt(t("feedback.renamePrompt"), ticket.Subject)?.trim();
          if (!next || next === ticket.Subject) return;

          try {
            await apiRequest("/api/feedback/subject", {
              method: "POST",
              body: { TicketId: ticket.Id, Subject: next },
            });
            void renderFeedbackTicketList();
          } catch (cause) {
            window.alert(t("feedback.renameFailed", { error: cause instanceof Error ? cause.message : String(cause) }));
          }
        });

        const link = document.createElement("a");
        link.href = `/feedback/anfrage/?id=${ticket.Id}`;
        link.className = "block px-5 py-4 pr-20 transition-colors hover:bg-muted/60";

        const badges = document.createElement("div");
        badges.className = "flex flex-wrap items-center gap-2";
        if (ticket.HasUnread) {
          badges.append(createFeedbackBadge(t("feedback.listUnread"), "bg-red-600 text-white"));
        }
        badges.append(createFeedbackBadge(feedbackStatusLabelText(ticket.Status), feedbackStatusBadgeClasses(ticket.Status)));
        badges.append(createFeedbackBadge(feedbackCategoryLabelText(ticket.Category), "bg-muted text-muted-foreground"));
        const date = document.createElement("span");
        date.className = "text-xs text-muted-foreground";
        date.textContent = feedbackDateFormat.format(new Date(ticket.LastMessageAt));
        badges.append(date);

        const subject = createText("p", "mt-1 text-sm font-semibold", ticket.Subject);
        const preview = createText("p", "mt-0.5 truncate text-sm text-muted-foreground", ticket.LastMessagePreview);
        const meta = createText(
          "p",
          "mt-1 text-xs text-muted-foreground",
          ticket.MessageCount === 1
            ? t("feedback.listMessageCountOne")
            : t("feedback.listMessageCount", { count: ticket.MessageCount }),
        );

        link.append(badges, subject, preview, meta);
        item.append(link, renameButton);
        list.append(item);
      }
    } catch (cause) {
      if (error) {
        error.textContent = t("feedback.listLoadFailed", { error: cause instanceof Error ? cause.message : String(cause) });
        error.classList.remove("hidden");
      }
    }
  }

  function renderFeedbackMessage(message: FeedbackMessageDto) {
    const item = document.createElement("li");
    item.className =
      message.Author === "User"
        ? "ml-auto max-w-[85%] rounded-lg border border-primary/30 bg-primary/5 p-4"
        : "max-w-[85%] rounded-lg border border-border bg-card p-4";

    const header = document.createElement("p");
    header.className = "flex flex-wrap items-baseline gap-2 text-xs text-muted-foreground";
    const author = document.createElement("span");
    author.className = "font-semibold text-foreground";
    author.textContent = message.Author === "User" ? t("feedback.threadYou") : t("feedback.threadTeam");
    header.append(author, document.createTextNode(feedbackDateFormat.format(new Date(message.CreatedAt))));
    item.append(header);

    if (message.Body) {
      const body = document.createElement("p");
      body.className = "mt-2 whitespace-pre-wrap text-sm";
      body.textContent = message.Body;
      item.append(body);
    }

    if (message.Attachments.length > 0) {
      const attachments = document.createElement("div");
      attachments.className = "mt-3 flex flex-wrap gap-3";
      message.Attachments.forEach((attachment, index) => {
        if (attachment.Kind === "Image") {
          const link = document.createElement("a");
          link.href = attachment.Url;
          link.target = "_blank";
          link.rel = "noopener";
          const img = document.createElement("img");
          img.src = attachment.ThumbnailUrl ?? attachment.Url;
          img.alt = t("feedback.threadImageAlt", { index: index + 1 });
          img.loading = "lazy";
          img.className = "h-24 w-24 rounded-md border border-border object-cover";
          link.append(img);
          attachments.append(link);
        } else {
          const wrapper = document.createElement("div");
          wrapper.className = "w-full max-w-xs";
          const duration = formatFeedbackDuration(attachment.DurationSeconds);
          wrapper.append(createText("p", "mb-1 text-xs text-muted-foreground",
            duration ? `${t("feedback.threadVoiceMessage")} · ${duration}` : t("feedback.threadVoiceMessage")));
          const audio = document.createElement("audio");
          audio.controls = true;
          audio.preload = "metadata";
          audio.src = attachment.Url;
          audio.className = "w-full";
          wrapper.append(audio);
          attachments.append(wrapper);
        }
      });
      item.append(attachments);
    }

    return item;
  }

  function bindFeedbackPage() {
    const form = document.querySelector<HTMLFormElement>("[data-feedback-form]");
    const composerRoot = form?.querySelector<HTMLElement>("[data-message-composer]");
    if (!form || !composerRoot) return;

    const composer = setupMessageComposer(composerRoot, submit);

    async function submit() {
      await composer.finishPendingRecording();
      if (!composer.hasContent) {
        composer.setError(t("feedback.errorEmpty"));
        return;
      }

      const formData = new FormData(form!);
      composer.setSending(true);
      composer.setError("");
      try {
        const attachments = await composer.uploadAttachments();
        await apiRequest("/api/feedback", {
          method: "POST",
          body: {
            Category: formData.get("category")?.toString() ?? "Idea",
            Body: composer.text,
            Source: "Web",
            AppVersion: null,
            Attachments: attachments,
          },
        });

        composer.reset();
        void renderFeedbackTicketList();
      } catch (cause) {
        composer.setError(
          t("feedback.errorGeneric", { error: cause instanceof Error ? cause.message : String(cause) }),
        );
      } finally {
        composer.setSending(false);
      }
    }

    void renderFeedbackTicketList();
  }

  function bindFeedbackThreadPage() {
    const container = document.querySelector<HTMLElement>("[data-feedback-thread]");
    if (!container) return;

    const content = container.querySelector<HTMLElement>("[data-thread-content]");
    const errorBox = container.querySelector<HTMLElement>("[data-thread-error]");
    const badges = container.querySelector<HTMLElement>("[data-thread-badges]");
    const subject = container.querySelector<HTMLElement>("[data-thread-subject]");
    const messages = container.querySelector<HTMLElement>("[data-thread-messages]");
    const ticketId = new URLSearchParams(window.location.search).get("id") ?? "";

    function showThreadError(message: string) {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.classList.remove("hidden");
    }

    function renderThread(ticket: FeedbackTicketDetail) {
      if (!content || !badges || !subject || !messages) return;
      content.hidden = false;
      subject.textContent = ticket.Subject;
      // Konkreter Betreff im Tab-Titel statt generischem "Anfrage" (WEB-046)
      document.title = `${ticket.Subject} | Heimatplatz`;
      badges.innerHTML = "";
      badges.append(
        createFeedbackBadge(feedbackStatusLabelText(ticket.Status), feedbackStatusBadgeClasses(ticket.Status)),
        createFeedbackBadge(feedbackCategoryLabelText(ticket.Category), "bg-muted text-muted-foreground"),
      );
      messages.innerHTML = "";
      for (const message of ticket.Messages) {
        messages.append(renderFeedbackMessage(message));
      }
    }

    async function loadThread() {
      if (!ticketId) {
        showThreadError(t("feedback.threadNotFound"));
        return;
      }
      try {
        const response = await apiRequest<{ Ticket: FeedbackTicketDetail | null }>(`/api/feedback/${ticketId}`);
        if (!response.Ticket) {
          showThreadError(t("feedback.threadNotFound"));
          return;
        }
        renderThread(response.Ticket);
      } catch (cause) {
        // API antwortet bei unbekannten/fremden Tickets jetzt mit 404 (WEB-027)
        if (cause instanceof ApiRequestError && cause.status === 404) {
          showThreadError(t("feedback.threadNotFound"));
          return;
        }
        showThreadError(t("feedback.threadLoadFailed", { error: cause instanceof Error ? cause.message : String(cause) }));
      }
    }

    const composerRoot = container.querySelector<HTMLElement>("[data-message-composer]");
    if (composerRoot) {
      const composer = setupMessageComposer(composerRoot, sendReply);

      async function sendReply() {
        await composer.finishPendingRecording();
        if (!composer.hasContent) {
          composer.setError(t("feedback.errorEmpty"));
          return;
        }

        composer.setSending(true);
        composer.setError("");
        try {
          const attachments = await composer.uploadAttachments();
          const response = await apiRequest<{ Message: FeedbackMessageDto | null }>("/api/feedback/messages", {
            method: "POST",
            body: { TicketId: ticketId, Body: composer.text, Attachments: attachments },
          });
          if (response.Message) {
            messages?.append(renderFeedbackMessage(response.Message));
          }
          composer.reset();
        } catch (cause) {
          composer.setError(
            t("feedback.errorGeneric", { error: cause instanceof Error ? cause.message : String(cause) }),
          );
        } finally {
          composer.setSending(false);
        }
      }
    }

    void loadThread();
  }

  function bootPropertyState() {
    renderAuthState();
    refreshActionButtons();
    bindFallbackImages();
    observeSmartImages();
    syncUserLists();
    void hydrateRemotePropertyActions();
    renderMineStatus();
    renderDrafts();
    void renderRemoteUserLists();
    applySavedPreferences();
    bindNotificationPreferenceVisibility();
    bindPreferenceForms();
    loadRemotePreferences();
    bindRegisterRoleFields();
    bindImagePickers();
    bindLocationPickers();
    bindPropertyTypeFields();
    bindAmountInputs();
    void hydratePropertyEditForm();
    bindAuthForms();
    bindPasswordResetForms();
    bindVerifyEmailPage();
    bindEmailVerification();
    bindProfileStats();
    bindProfileForms();
    initWebPush();
    bindPropertyForm();
    bindFeedbackPage();
    bindFeedbackThreadPage();
    bindGlobalActions();
  }

  // Die Startseiten-Suche rendert das Karten-Grid bei jedem Filterwechsel neu
  // (PropertySearchApp) - Favoriten-/Blockiert-Zustaende danach neu anwenden.
  document.addEventListener("property-cards-rendered", () => refreshActionButtons());

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootPropertyState, { once: true });
  } else {
    bootPropertyState();
  }
</script>
