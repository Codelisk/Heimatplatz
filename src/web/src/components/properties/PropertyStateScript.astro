  function scalarValue(value: string | string[] | number | null | undefined) {
    if (Array.isArray(value)) return value[0] ?? "";
    return value ?? "";
  }

  function toNumber(value: string | string[] | number | null | undefined) {
    const scalar = scalarValue(value);
    const parsed = Number(scalar);
    return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
  }

  // --- Betragsfelder (Preis, Mindestgebot, Schaetzwert) -------------------
  // Angezeigt wird das Hausformat mit Tausenderpunkten ("350.000"), gespeichert
  // und an die API geht immer die reine Ziffernfolge (WEB-B04). Die App ist
  // ausschliesslich deutsch, die Gruppierung darf also fest verdrahtet sein.
  function groupAmountDigits(digits: string) {
    return digits.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
  }

  // Eingabe des Nutzers: Punkte sind reine Anzeige, alles andere faellt weg
  function amountInputDigits(value: string) {
    return value.replace(/\D+/g, "").replace(/^0+(?=\d)/, "").slice(0, 12);
  }

  // Vorbefuellung aus Entwurf/API: Price und MinimumBid sind decimal ("349000.5")
  function amountValueDigits(value: string | number | null | undefined) {
    const raw = String(value ?? "").trim();
    if (!raw) return "";
    const numeric = Number(raw);
    return Number.isFinite(numeric) && numeric > 0
      ? String(Math.round(numeric))
      : amountInputDigits(raw);
  }

  function formatAmountField(input: HTMLInputElement) {
    const formatted = groupAmountDigits(amountInputDigits(input.value));
    if (formatted === input.value) return;

    // Caret relativ zum Feldende halten - beim Tippen wandern die Punkte nach
    // links, eine absolute Position wuerde springen
    const fromEnd = input.value.length - (input.selectionStart ?? input.value.length);
    input.value = formatted;
    if (input === document.activeElement) {
      const caret = Math.max(0, formatted.length - fromEnd);
      input.setSelectionRange(caret, caret);
    }
  }

  function bindAmountInputs() {
    document.querySelectorAll<HTMLInputElement>("input[data-amount-input]").forEach((input) => {
      if (input.dataset.amountBound === "true") return;
      input.dataset.amountBound = "true";
      formatAmountField(input);
      input.addEventListener("input", () => formatAmountField(input));
    });
  }

  function getAmountFieldNames(form: HTMLFormElement) {
    return new Set(
      Array.from(form.querySelectorAll<HTMLInputElement>("input[data-amount-input]")).map((input) => input.name),
    );
  }

  function requiredText(value: string | string[] | number | null | undefined) {
    return String(scalarValue(value) ?? "").trim();
  }

  function mapPropertyType(value: string | undefined) {
    if (value === "land") return "Land";
    if (value === "foreclosure") return "Foreclosure";
    return "House";
  }

  function mapApiPropertyType(value: string | undefined) {
    if (value === "Land") return "land";
    if (value === "Foreclosure") return "foreclosure";
    return "house";
  }

  function hasStructureFields(draft: Draft) {
    return draft.propertyType !== "land";
  }

  // Merkmale werden im Formular als kommagetrennter String gefuehrt
  // (hidden input "features"), die API erwartet eine Liste
  function parseDraftFeatures(value: string | string[] | undefined) {
    const scalar = scalarValue(value);
    if (!scalar) return [];
    return [...new Set(String(scalar).split(",").map((feature: string) => feature.trim()).filter(Boolean))];
  }

  function toIsoDateTime(value: string | string[] | undefined) {
    const scalar = scalarValue(value);
    if (!scalar) return null;
    const date = new Date(scalar);
    return Number.isFinite(date.valueOf()) ? date.toISOString() : null;
  }

  function toDateTimeLocal(value: unknown) {
    if (!value || typeof value !== "string") return "";
    const date = new Date(value);
    if (!Number.isFinite(date.valueOf())) return "";
    const pad = (number: number) => String(number).padStart(2, "0");
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  }

  function readTypeSpecificData(property: ApiProperty) {
    if (!property.TypeSpecificData) return {};
    if (typeof property.TypeSpecificData === "object") return property.TypeSpecificData;
    try {
      const parsed = JSON.parse(property.TypeSpecificData);
      return parsed && typeof parsed === "object" ? parsed as Record<string, unknown> : {};
    } catch {
      return {};
    }
  }

  function readTypedString(data: Record<string, unknown>, key: string) {
    const value = data[key];
    if (value === null || value === undefined) return "";
    return String(value);
  }

  function buildForeclosureTypeSpecificData(draft: Draft) {
    if (draft.propertyType !== "foreclosure") return null;

    return {
      CourtName: scalarValue(draft.foreclosureCourtName),
      // Keine erfundenen Fallbacks (frueher: heutiges Datum / 0): Pflichtfelder prueft
      // validatePropertyDraft vorab, und die API validiert erneut - fehlende Werte
      // muessen als Fehler enden, nicht als falsche Fachdaten im Bestand.
      AuctionDate: toIsoDateTime(draft.foreclosureAuctionDate) || null,
      MinimumBid: toNumber(draft.foreclosureMinimumBid),
      EstimatedValue: toNumber(draft.foreclosureEstimatedValue),
      Encumbrances: [],
      Status: scalarValue(draft.foreclosureStatus) || "Scheduled",
      FileNumber: scalarValue(draft.foreclosureFileNumber),
      RegistrationNumber: scalarValue(draft.foreclosureRegistrationNumber) || null,
      CadastralMunicipality: scalarValue(draft.foreclosureCadastralMunicipality) || null,
      PlotNumber: scalarValue(draft.foreclosurePlotNumber) || null,
      TotalArea: toNumber(draft.foreclosureTotalArea) ?? toNumber(draft.plotArea),
      BuildingArea: toNumber(draft.foreclosureBuildingArea),
      ZoningDesignation: scalarValue(draft.foreclosureZoningDesignation) || null,
      BuildingCondition: scalarValue(draft.foreclosureBuildingCondition) || null,
      NumberOfRooms: toNumber(draft.rooms),
      YearBuilt: toNumber(draft.yearBuilt),
      ViewingDate: toIsoDateTime(draft.foreclosureViewingDate),
      BiddingDeadline: toIsoDateTime(draft.foreclosureBiddingDeadline),
      OwnershipShare: scalarValue(draft.foreclosureOwnershipShare) || null,
      Notes: scalarValue(draft.foreclosureNotes) || null,
      EdictUrl: scalarValue(draft.foreclosureEdictUrl) || null,
      FloorPlanUrl: null,
      SitePlanUrl: null,
      LongAppraisalUrl: null,
      ShortAppraisalUrl: null,
    };
  }

  function validatePropertyDraft(draft: Draft, options: { isEdit?: boolean } = {}) {
    if (requiredText(draft.title).length < 10) return t("editor.valTitleMin");
    if (requiredText(draft.description).length < 50) return t("editor.valDescriptionMin");
    // ZV: das Preisfeld ist ausgeblendet, der Preis kommt aus dem Mindestgebot (WEB-014)
    if (draft.propertyType !== "foreclosure") {
      const price = toNumber(draft.price);
      if (!price) return t("editor.valPriceInvalid");
      // Obergrenze wie CreatePropertyHandler; das Feld ist seit WEB-B04 ein
      // Textfeld mit Tausenderpunkten, der Browser prueft sie nicht mehr
      if (price > 100_000_000) return t("editor.valPriceUnrealistic");
    }
    if (!requiredText(draft.address)) return t("editor.valStreetRequired");
    if (!requiredText(draft.city) || !requiredText(draft.postalCode)) return t("editor.valCityRequired");
    if (!/^\d{4}$/.test(requiredText(draft.postalCode))) return t("editor.valPostalCodeInvalid");

    // Plausibilitaet der Zahlenfelder (Spiegel der Server-Validierung in
    // PropertyFieldValidation.cs - massgeblich bleibt der Server)
    const yearBuilt = toNumber(draft.yearBuilt);
    if (draft.yearBuilt && (!yearBuilt || yearBuilt < 1000 || yearBuilt > new Date().getFullYear())) {
      return t("editor.valYearBuiltFuture");
    }
    const livingArea = toNumber(draft.livingArea);
    if (draft.livingArea && (!livingArea || livingArea > 10_000)) return t("editor.valLivingAreaUnrealistic");
    const plotArea = toNumber(draft.plotArea);
    if (draft.plotArea && (!plotArea || plotArea > 1_000_000)) return t("editor.valPlotAreaUnrealistic");
    const rooms = toNumber(draft.rooms);
    if (draft.rooms && (!rooms || rooms > 200)) return t("editor.valRoomsUnrealistic");

    // Originalinserat: optional, aber wenn angegeben eine absolute http(s)-URL
    // (Spiegel von PropertyFieldValidation.NormalizeOriginalListingUrl)
    const originalListingUrl = requiredText(draft.originalListingUrl);
    if (originalListingUrl && !/^https?:\/\/\S+$/i.test(originalListingUrl)) {
      return t("editor.valOriginalUrlInvalid");
    }

    // Ansprechpartner: optional, aber wenn angegeben Name + E-Mail oder Telefon
    // (Spiegel von PropertyFieldValidation.NormalizeContactPerson)
    const contactName = requiredText(draft.contactName);
    const contactEmail = requiredText(draft.contactEmail);
    const contactPhone = requiredText(draft.contactPhone);
    if ((contactEmail || contactPhone) && !contactName) return t("editor.valContactNameRequired");
    if (contactName && !contactEmail && !contactPhone) return t("editor.valContactReachRequired");

    if (draft.propertyType !== "foreclosure") return "";
    if (!draft.foreclosureCourtName) return t("editor.valCourtRequired");
    if (!draft.foreclosureFileNumber) return t("editor.valFileNumberRequired");
    const auctionIso = toIsoDateTime(draft.foreclosureAuctionDate);
    if (!auctionIso) return t("editor.valAuctionDateInvalid");
    // WEB-017: neue Versteigerungen brauchen einen zukuenftigen Termin; beim Bearbeiten
    // bleiben vergangene Termine korrigierbar (Spiegel der Server-Regeln)
    if (!options.isEdit && new Date(auctionIso).valueOf() < Date.now() - 24 * 60 * 60 * 1000) {
      return t("editor.valAuctionDatePast");
    }
    if (!toNumber(draft.foreclosureMinimumBid)) return t("editor.valMinimumBidRequired");
    return "";
  }

  function mapSellerType(value: ApiProperty["SellerType"] | undefined) {
    return value === "Broker" ? "Broker" : "Private";
  }

  function normalizeText(value: string | undefined) {
    return (value ?? "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  async function loadMunicipalities() {
    if (!municipalityPromise) {
      municipalityPromise = apiRequest<LocationsResponse>("/api/locations").then((locations) =>
        locations.FederalProvinces
          .flatMap((province) => province.Districts)
          .flatMap((district) =>
            district.Municipalities.map((municipality) => ({
              ...municipality,
              DistrictName: district.Name,
            })),
          )
          .sort((a, b) => `${a.PostalCode} ${a.Name}`.localeCompare(`${b.PostalCode} ${b.Name}`, "de-AT")),
      );
    }

    return municipalityPromise;
  }

  function setLocationStatus(form: HTMLFormElement, message: string, tone: "info" | "error" = "info") {
    const status = form.querySelector<HTMLElement>("[data-location-status]");
    if (!status) return;
    status.textContent = message;
    status.classList.toggle("text-error", tone === "error");
    status.classList.toggle("text-muted-foreground", tone === "info");
  }

  function applyMunicipalityToForm(form: HTMLFormElement, municipality: Municipality) {
    setField(form, "municipalityId", municipality.Id);
    setField(form, "city", municipality.Name);
    setField(form, "postalCode", municipality.PostalCode);
  }

  function syncLocationSelect(form: HTMLFormElement) {
    const select = form.querySelector<HTMLSelectElement>("[data-location-select]");
    if (!select || select.options.length <= 1) return;

    const municipalityId = String((form.elements.namedItem("municipalityId") as HTMLInputElement | null)?.value ?? "");
    if (municipalityId) {
      select.value = municipalityId;
      return;
    }

    const city = normalizeText(String((form.elements.namedItem("city") as HTMLInputElement | null)?.value ?? ""));
    const postalCode = String((form.elements.namedItem("postalCode") as HTMLInputElement | null)?.value ?? "").trim();
    const option = Array.from(select.options).find((item) =>
      normalizeText(item.dataset.name) === city && (!postalCode || item.dataset.postalCode === postalCode)
    );
    if (option) {
      select.value = option.value;
      setField(form, "municipalityId", option.value);
    }
  }

  async function populateLocationSelects() {
    const forms = Array.from(document.querySelectorAll<HTMLFormElement>("[data-local-property-form]"));
    if (forms.length === 0) return;

    try {
      const municipalities = await loadMunicipalities();
      forms.forEach((form) => {
        const select = form.querySelector<HTMLSelectElement>("[data-location-select]");
        if (!select) return;

        select.textContent = "";
        select.append(new Option(t("editor.locationSelectPlaceholder"), ""));
        municipalities.forEach((municipality) => {
          const option = new Option(`${municipality.PostalCode} ${municipality.Name} (${municipality.DistrictName})`, municipality.Id);
          option.dataset.name = municipality.Name;
          option.dataset.postalCode = municipality.PostalCode;
          select.append(option);
        });

        syncLocationSelect(form);
        setLocationStatus(form, t("editor.locationSelectHint"));
      });
    } catch (error) {
      forms.forEach((form) => {
        const select = form.querySelector<HTMLSelectElement>("[data-location-select]");
        if (select) {
          select.textContent = "";
          select.append(new Option(t("editor.locationManualOption"), ""));
        }
        setLocationStatus(
          form,
          error instanceof Error ? t("editor.locationLoadFailedDetail", { message: error.message }) : t("editor.locationLoadFailed"),
          "error",
        );
      });
    }
  }

  function bindLocationPickers() {
    document.querySelectorAll<HTMLFormElement>("[data-local-property-form]").forEach((form) => {
      const select = form.querySelector<HTMLSelectElement>("[data-location-select]");
      select?.addEventListener("change", async () => {
        if (!select.value) return;
        const municipality = (await loadMunicipalities()).find((item) => item.Id === select.value);
        if (municipality) applyMunicipalityToForm(form, municipality);
      });
    });

    void populateLocationSelects();
  }

  async function findMunicipalityId(draft: Draft) {
    if (draft.municipalityId && UUID_PATTERN.test(draft.municipalityId)) {
      return draft.municipalityId;
    }

    const city = normalizeText(draft.city);
    const postalCode = draft.postalCode?.trim();
    const municipalities = await loadMunicipalities();

    const exact = municipalities.find((municipality) =>
      normalizeText(municipality.Name) === city &&
      (!postalCode || municipality.PostalCode === postalCode)
    );
    return exact?.Id ?? municipalities.find((municipality) => normalizeText(municipality.Name) === city)?.Id ?? null;
  }

  async function createRemoteProperty(draft: Draft, imageUrls: string[]) {
    const session = readSession();
    if (!session) return null;

    const municipalityId = await findMunicipalityId(draft);
    if (!municipalityId) {
      throw new Error(t("editor.locationNotFound"));
    }

    const response = await apiRequest<{ PropertyId: string; Title: string; CreatedAt: string }>("/api/properties", {
      method: "POST",
      body: {
        Title: draft.title,
        Address: draft.address,
        MunicipalityId: municipalityId,
        // Eingegebene PLZ erhalten (WEB-009): Municipality fuehrt nur eine PLZ pro
        // Gemeinde, 4040 Linz wuerde sonst stillschweigend zu 4020
        PostalCode: requiredText(draft.postalCode) || null,
        // ZV: Preisfeld ist ausgeblendet, das Mindestgebot ist der Preis (WEB-014)
        Price: draft.propertyType === "foreclosure" ? toNumber(draft.foreclosureMinimumBid) : toNumber(draft.price),
        Type: mapPropertyType(draft.propertyType),
        // SellerType/SellerName leitet der Server aus dem Benutzerprofil ab
        Description: draft.description || null,
        LivingAreaSquareMeters: hasStructureFields(draft) ? toNumber(draft.livingArea) : null,
        PlotAreaSquareMeters: toNumber(draft.plotArea),
        Rooms: hasStructureFields(draft) ? toNumber(draft.rooms) : null,
        YearBuilt: hasStructureFields(draft) ? toNumber(draft.yearBuilt) : null,
        Features: parseDraftFeatures(draft.features),
        ImageUrls: imageUrls,
        TypeSpecificData: buildForeclosureTypeSpecificData(draft),
        OriginalListingUrl: requiredText(draft.originalListingUrl) || null,
        ContactPerson: buildDraftContactPerson(draft),
        // Lage-Anzeige (Genau/Ungefaehr/Verborgen) - Entscheidung des Anbieters
        LocationDisplay: mapLocationDisplayToApi(draft.locationDisplay),
      },
    });

    return response;
  }

  async function updateRemoteProperty(id: string, draft: Draft, imageUrls: string[]) {
    const session = readSession();
    if (!session || !UUID_PATTERN.test(id)) return null;

    const municipalityId = await findMunicipalityId(draft);
    if (!municipalityId) {
      throw new Error(t("editor.locationNotFound"));
    }

    const response = await apiRequest<{ Success: boolean }>("/api/properties", {
      method: "PUT",
      body: {
        Id: id,
        Title: draft.title,
        Address: draft.address,
        MunicipalityId: municipalityId,
        // Eingegebene PLZ erhalten (WEB-009), s. createRemoteProperty
        PostalCode: requiredText(draft.postalCode) || null,
        // ZV: Preisfeld ist ausgeblendet, das Mindestgebot ist der Preis (WEB-014)
        Price: draft.propertyType === "foreclosure" ? toNumber(draft.foreclosureMinimumBid) : toNumber(draft.price),
        Type: mapPropertyType(draft.propertyType),
        // SellerType/SellerName leitet der Server aus dem Benutzerprofil ab
        Description: draft.description || null,
        LivingAreaSquareMeters: hasStructureFields(draft) ? toNumber(draft.livingArea) : null,
        PlotAreaSquareMeters: toNumber(draft.plotArea),
        Rooms: hasStructureFields(draft) ? toNumber(draft.rooms) : null,
        YearBuilt: hasStructureFields(draft) ? toNumber(draft.yearBuilt) : null,
        Features: parseDraftFeatures(draft.features),
        ImageUrls: imageUrls,
        TypeSpecificData: buildForeclosureTypeSpecificData(draft),
        OriginalListingUrl: requiredText(draft.originalListingUrl) || null,
        ContactPerson: buildDraftContactPerson(draft),
        // Lage-Anzeige (Genau/Ungefaehr/Verborgen) - Entscheidung des Anbieters
        LocationDisplay: mapLocationDisplayToApi(draft.locationDisplay),
      },
    });

    return response;
  }

  // Lage-Anzeige: Formularwerte (lowercase Radios) <-> API-Enum-Strings
  function mapLocationDisplayToApi(value?: string) {
    if (value === "exact") return "Exact";
    if (value === "hidden") return "Hidden";
    return "Approximate";
  }

  function mapLocationDisplayFromApi(value?: string | number | null) {
    if (value === "Exact" || value === 1) return "exact";
    if (value === "Hidden" || value === 2) return "hidden";
    return "approximate";
  }

  // Optionaler Ansprechpartner: komplett leere Felder bedeuten "kein
  // Ansprechpartner" (der Server entfernt ihn dann beim Update)
  function buildDraftContactPerson(draft: Draft) {
    const name = requiredText(draft.contactName);
    const email = requiredText(draft.contactEmail);
    const phone = requiredText(draft.contactPhone);
    if (!name && !email && !phone) return null;
    return { Name: name, Email: email || null, Phone: phone || null };
  }

  function saveLocalDraft(draft: Draft, editId: string | null) {
    const drafts = readArray<Draft>(STORAGE_KEYS.drafts);
    if (editId) {
      const existingIndex = drafts.findIndex((item) => item.id === editId);
      draft.id = editId;
      if (existingIndex >= 0) {
        drafts[existingIndex] = draft;
        writeArray(STORAGE_KEYS.drafts, drafts);
        return;
      }
    }

    writeArray(STORAGE_KEYS.drafts, [draft, ...drafts]);
  }

  function setField(form: HTMLFormElement, name: string, value: string | number | null | undefined) {
    const field = form.elements.namedItem(name);
    // Radio-Gruppen (z.B. locationDisplay) liefern eine RadioNodeList - deren
    // value-Setter checkt das passende Radio
    if (typeof RadioNodeList !== "undefined" && field instanceof RadioNodeList) {
      field.value = value === null || value === undefined ? "" : String(value);
      return;
    }
    if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
      // Betragsfelder werden im Hausformat vorbefuellt ("350.000"); beim
      // Speichern schreibt das Formular wieder reine Ziffern (WEB-B04)
      field.value = field instanceof HTMLInputElement && field.dataset.amountInput !== undefined
        ? groupAmountDigits(amountValueDigits(value))
        : value === null || value === undefined ? "" : String(value);
    }
  }

  function updatePropertyTypeFields(form: HTMLFormElement) {
    const type = form.elements.namedItem("propertyType");
    const propertyType = type instanceof HTMLSelectElement ? type.value : "house";
    const isLand = propertyType === "land";
    const isForeclosure = propertyType === "foreclosure";
    const foreclosureFields = form.querySelector<HTMLElement>("[data-foreclosure-fields]");

    form.querySelectorAll<HTMLElement>("[data-structure-property-field]").forEach((element) => {
      element.hidden = isLand;
      element
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select")
        .forEach((field) => {
          field.disabled = isLand;
        });
    });

    if (foreclosureFields) {
      foreclosureFields.hidden = !isForeclosure;
      foreclosureFields
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select")
        .forEach((field) => {
          field.disabled = !isForeclosure;
          field.required = isForeclosure && field.hasAttribute("data-foreclosure-required");
        });

      // WEB-017: keine vergangenen Versteigerungstermine anbieten (Server prueft beim
      // Erstellen ebenfalls). datetime-local erwartet lokale Zeit im ISO-Kurzformat.
      const auctionDate = foreclosureFields.querySelector<HTMLInputElement>('[name="foreclosureAuctionDate"]');
      if (auctionDate && isForeclosure) {
        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        auctionDate.min = now.toISOString().slice(0, 16);
      }
    }

    // WEB-014: Bei Zwangsversteigerungen setzt der Server Price ohnehin auf das
    // Mindestgebot - das separate Pflicht-Preisfeld war unerklaert und konnte
    // widerspruechliche Werte erzeugen. Tile ausblenden, Mindestgebot uebernimmt.
    const priceTile = form.querySelector<HTMLElement>("[data-price-tile]");
    const priceField = form.elements.namedItem("price");
    if (priceTile && priceField instanceof HTMLInputElement) {
      priceTile.hidden = isForeclosure;
      priceField.disabled = isForeclosure;
      priceField.required = !isForeclosure;
    }
  }

  function bindPropertyTypeFields() {
    document.querySelectorAll<HTMLFormElement>("[data-local-property-form]").forEach((form) => {
      const type = form.elements.namedItem("propertyType");
      if (type instanceof HTMLSelectElement) {
        type.addEventListener("change", () => updatePropertyTypeFields(form));
      }
      updatePropertyTypeFields(form);
    });
  }

  function fillPropertyForm(form: HTMLFormElement, draft: Draft) {
    // Alte lokale Entwuerfe kennen noch "apartment" - die API (und das
    // Formular-Select) nur house/land/foreclosure, analog search-query.ts
    setField(form, "propertyType", draft.propertyType === "apartment" ? "house" : draft.propertyType);
    setField(form, "title", draft.title);
    setField(form, "description", draft.description);
    setField(form, "address", draft.address);
    setField(form, "city", draft.city);
    setField(form, "postalCode", draft.postalCode);
    setField(form, "price", draft.price);
    setField(form, "livingArea", draft.livingArea);
    setField(form, "plotArea", draft.plotArea);
    setField(form, "rooms", draft.rooms);
    setField(form, "yearBuilt", draft.yearBuilt);
    setField(form, "features", draft.features);
    setField(form, "originalListingUrl", draft.originalListingUrl);
    setField(form, "contactName", draft.contactName);
    setField(form, "contactEmail", draft.contactEmail);
    setField(form, "contactPhone", draft.contactPhone);
    setField(form, "municipalityId", draft.municipalityId);
    [
      "foreclosureCourtName",
      "foreclosureFileNumber",
      "foreclosureAuctionDate",
      "foreclosureMinimumBid",
      "foreclosureEstimatedValue",
      "foreclosureStatus",
      "foreclosureViewingDate",
      "foreclosureBiddingDeadline",
      "foreclosureOwnershipShare",
      "foreclosureEdictUrl",
      "foreclosureRegistrationNumber",
      "foreclosureCadastralMunicipality",
      "foreclosurePlotNumber",
      "foreclosureTotalArea",
      "foreclosureBuildingArea",
      "foreclosureZoningDesignation",
      "foreclosureBuildingCondition",
      "foreclosureNotes",
    ].forEach((field) => setField(form, field, draft[field] as string | undefined));
    setField(form, "locationDisplay", draft.locationDisplay ?? "approximate");
    updatePropertyTypeFields(form);
    setFormImages(form, getDraftImageUrls(draft));
    syncLocationSelect(form);
    // Kartenvorschau u.a. lauschen darauf - programmatisches setField feuert
    // keine input/change-Events
    form.dispatchEvent(new CustomEvent("property-form-prefilled", { bubbles: true }));
  }

  function apiPropertyToDraft(property: ApiProperty) {
    const typeSpecificData = readTypeSpecificData(property);
    // Ansprechpartner = erster manuell gepflegter Kontakt jenseits des Anbieters
    // (DisplayOrder 0); muss beim Bearbeiten vorbefuellt werden, sonst wuerde der
    // Server ihn beim Speichern als "entfernt" interpretieren
    const contactPerson = (property.Contacts ?? []).find(
      (contact) =>
        (contact.DisplayOrder ?? 0) > 0 && (contact.Source === "Manual" || contact.Source === 0),
    );
    return {
      id: property.Id,
      title: property.Title,
      description: property.Description ?? "",
      propertyType: mapApiPropertyType(property.Type),
      sellerName: property.SellerName,
      sellerType: mapSellerType(property.SellerType ?? undefined),
      address: property.Address,
      city: property.City,
      postalCode: property.PostalCode,
      price: String(property.Price ?? ""),
      livingArea: property.LivingAreaM2 ? String(property.LivingAreaM2) : "",
      plotArea: property.PlotAreaM2 ? String(property.PlotAreaM2) : "",
      rooms: property.Rooms ? String(property.Rooms) : "",
      yearBuilt: property.YearBuilt ? String(property.YearBuilt) : "",
      features: (property.Features ?? []).join(", "),
      originalListingUrl: property.Contacts?.find((contact) => contact.OriginalListingUrl)?.OriginalListingUrl ?? "",
      contactName: contactPerson?.Name ?? "",
      contactEmail: contactPerson?.Email ?? "",
      contactPhone: contactPerson?.Phone ?? "",
      municipalityId: property.MunicipalityId ?? "",
      locationDisplay: mapLocationDisplayFromApi(property.LocationDisplay),
      imageUrls: property.ImageUrls ?? [],
      foreclosureCourtName: readTypedString(typeSpecificData, "CourtName"),
      foreclosureFileNumber: readTypedString(typeSpecificData, "FileNumber"),
      foreclosureAuctionDate: toDateTimeLocal(typeSpecificData.AuctionDate),
      foreclosureMinimumBid: readTypedString(typeSpecificData, "MinimumBid"),
      foreclosureEstimatedValue: readTypedString(typeSpecificData, "EstimatedValue"),
      foreclosureStatus: readTypedString(typeSpecificData, "Status") || "Scheduled",
      foreclosureViewingDate: toDateTimeLocal(typeSpecificData.ViewingDate),
      foreclosureBiddingDeadline: toDateTimeLocal(typeSpecificData.BiddingDeadline),
      foreclosureOwnershipShare: readTypedString(typeSpecificData, "OwnershipShare"),
      foreclosureEdictUrl: readTypedString(typeSpecificData, "EdictUrl"),
      foreclosureRegistrationNumber: readTypedString(typeSpecificData, "RegistrationNumber"),
      foreclosureCadastralMunicipality: readTypedString(typeSpecificData, "CadastralMunicipality"),
      foreclosurePlotNumber: readTypedString(typeSpecificData, "PlotNumber"),
      foreclosureTotalArea: readTypedString(typeSpecificData, "TotalArea"),
      foreclosureBuildingArea: readTypedString(typeSpecificData, "BuildingArea"),
      foreclosureZoningDesignation: readTypedString(typeSpecificData, "ZoningDesignation"),
      foreclosureBuildingCondition: readTypedString(typeSpecificData, "BuildingCondition"),
      foreclosureNotes: readTypedString(typeSpecificData, "Notes"),
    } satisfies Draft;
  }

  type PropertyEditState = "loading" | "ready" | "error";

  function setPropertyEditState(form: HTMLFormElement, state: PropertyEditState) {
    const fields = form.querySelector<HTMLFieldSetElement>("[data-property-form-fields]");
    if (fields) {
      fields.disabled = state !== "ready";
      fields.hidden = state !== "ready";
    }

    form.dataset.editState = state;
    if (state === "loading") {
      form.setAttribute("aria-busy", "true");
    } else {
      form.removeAttribute("aria-busy");
    }
  }

  async function hydratePropertyEditForm() {
    const form = document.querySelector<HTMLFormElement>("[data-edit-property-form]");
    if (!form) return;

    setPropertyEditState(form, "loading");
    const params = new URLSearchParams(window.location.search);
    const draftId = params.get("draft");
    const remoteId = params.get("id");

    if (draftId) {
      const draft = readArray<Draft>(STORAGE_KEYS.drafts).find((item) => item.id === draftId);
      if (draft) {
        fillPropertyForm(form, draft);
        setPropertyEditState(form, "ready");
        setFormStatus(form, t("editor.statusDraftLoaded"));
      } else {
        setPropertyEditState(form, "error");
        setFormStatus(form, t("editor.statusNotFound"), "error");
      }
      return;
    }

    if (!remoteId || !UUID_PATTERN.test(remoteId)) {
      setPropertyEditState(form, "error");
      setFormStatus(form, t("editor.statusNotFound"), "error");
      return;
    }

    setFormStatus(form, t("editor.statusLoading"));
    try {
      const response = await apiRequest<{ Property: ApiProperty | null }>(`/api/properties/${remoteId}/edit`);
      if (response.Property) {
        fillPropertyForm(form, apiPropertyToDraft(response.Property));
        setPropertyEditState(form, "ready");
        setFormStatus(form, t("editor.statusLoaded"), "success");
      } else {
        setPropertyEditState(form, "error");
        setFormStatus(form, t("editor.statusNotFound"), "error");
      }
    } catch (error) {
      setPropertyEditState(form, "error");
      setFormStatus(
        form,
        error instanceof Error ? t("editor.statusLoadFailedDetail", { message: error.message }) : t("editor.statusLoadFailed"),
        "error",
      );
    }
  }

  function renderDrafts() {
    const drafts = readArray<Draft>(STORAGE_KEYS.drafts);
    document.querySelectorAll<HTMLElement>("[data-local-drafts]").forEach((container) => {
      container.textContent = "";
      drafts.forEach((draft) => container.append(createDraftCard(draft)));
      container.classList.toggle("hidden", drafts.length === 0);

      const empty = container.closest("[data-user-page]")?.querySelector("[data-user-empty]");
      empty?.classList.toggle("hidden", drafts.length > 0);
    });
  }

  function renderMineStatus() {
    const status = document.querySelector<HTMLElement>("[data-mine-status]");
    const text = document.querySelector<HTMLElement>("[data-mine-status-text]");
    if (!status || !text) return;

    const params = new URLSearchParams(window.location.search);
    // "=api" = live am Server veroeffentlicht, sonst lokaler Entwurf (wie UserListPage-SSR)
    const message = params.has("bearbeitet")
      ? t("myProperties.statusEdited")
      : params.get("gespeichert") === "api"
        ? t("myProperties.statusPublished")
        : params.has("gespeichert")
          ? t("myProperties.statusDraftSaved")
          : "";

    text.textContent = message;
    status.classList.toggle("hidden", !message);
  }

  function applyFallbackImage(image: HTMLImageElement) {
    if (image.dataset.fallbackApplied === "true") return;
    image.dataset.fallbackApplied = "true";
    image.removeAttribute("srcset");
    image.removeAttribute("sizes");
    image.src = image.dataset.fallbackImage || "/favicon.svg";
  }

  function bindFallbackImages() {
    document.querySelectorAll<HTMLImageElement>("[data-fallback-image]").forEach((image) => {
      if (image.dataset.fallbackBound) return;
      image.dataset.fallbackBound = "true";
      image.addEventListener("error", () => applyFallbackImage(image));
      // Bei SSR-Bildern kann das Fehlerereignis vor dem Modul-Script eintreten.
      if (image.complete && image.naturalWidth === 0) applyFallbackImage(image);
    });
  }

  // Edikte-Anhaenge sind oft kleine A4-Hochformat-Scans. object-cover wuerde sie
  // hochskalieren und beschneiden (unscharf) - stattdessen einpassen und den
  // Rahmen mit einer weichgezeichneten Kopie des Bilds fuellen.
  function applySmartImageFit(image: HTMLImageElement) {
    if (image.dataset.smartImageApplied || !image.naturalWidth || !image.naturalHeight) return;
    const parent = image.parentElement;
    if (!parent) return;

    const source = image.currentSrc || image.src;
    const isFallbackLogo = source.endsWith("/favicon.svg");
    const frameWidth = parent.getBoundingClientRect().width;
    // Hochformat nur dort einpassen, wo das ganze Bild zaehlt (Galerie der
    // Detailseite, data-smart-image="fit"). Im Kartenraster wird wie ueberall
    // formatfuellend beschnitten - eine einzelne Karte mit Balken sieht dort
    // nach Fehler aus, obwohl das Foto nur hochkant ist (WEB-B06).
    const isPortrait = image.naturalHeight > image.naturalWidth && image.dataset.smartImage === "fit";
    const wouldUpscale = frameWidth > 0 && image.naturalWidth < frameWidth * 0.75;
    if (!isFallbackLogo && !isPortrait && !wouldUpscale) return;

    image.dataset.smartImageApplied = "true";
    image.classList.remove("object-cover");
    image.classList.add("object-contain");

    if (isFallbackLogo) {
      // Logo-Platzhalter nie beschneiden oder weichzeichnen, nur verkleinert zentrieren
      image.classList.add("p-8", "opacity-70");
      return;
    }

    parent.classList.add("relative", "isolate", "overflow-hidden");
    const backdrop = document.createElement("div");
    backdrop.setAttribute("aria-hidden", "true");
    backdrop.className = "absolute inset-0 -z-10 scale-110 bg-cover bg-center blur-md opacity-60";
    backdrop.style.backgroundImage = `url("${source}")`;
    parent.insertBefore(backdrop, image);
  }

  function bindSmartImages() {
    document.querySelectorAll<HTMLImageElement>("img[data-smart-image]").forEach((image) => {
      if (image.dataset.smartImageBound) return;
      image.dataset.smartImageBound = "true";
      if (image.complete && image.naturalWidth > 0) applySmartImageFit(image);
      image.addEventListener("load", () => applySmartImageFit(image));
    });
  }

  function observeSmartImages() {
    bindSmartImages();
    // Suchergebnis- und Favoritenkarten entstehen client-seitig nach dem Boot
    new MutationObserver(() => {
      bindFallbackImages();
      bindSmartImages();
    }).observe(document.body, { childList: true, subtree: true });
  }

  // "Meine Immobilien" ohne Anbieter-Rolle: Hinweis + Weg ins Profil statt
  // leerer Liste (der Server antwortet auf /api/properties/user mit 403).
  function renderSellerNotEnabled(container: HTMLElement) {
    const emptyState = container.closest("[data-user-page]")?.querySelector("[data-user-empty]");
    const title = emptyState?.querySelector("h2");
    const text = emptyState?.querySelector("p");
    if (title) title.textContent = t("myProperties.sellerNotEnabledTitle");
    if (text) text.textContent = t("myProperties.sellerNotEnabledText");
    // Inserieren fuehrt ohne Anbieter-Rolle ins Leere -> auf das Profil umlenken
    document.querySelectorAll<HTMLElement>("[data-mine-cta]").forEach((cta) => cta.classList.add("hidden"));
    document.querySelector<HTMLElement>("[data-mine-profile-cta]")?.classList.remove("hidden");
  }

  async function renderRemoteUserLists() {
    const session = readSession();
    if (!session) return;

    const endpoints: Record<string, string> = {
      favorites: "/api/favorites",
      blocked: "/api/blocked",
      mine: "/api/properties/user",
    };
    const isSeller = readSessionRoles(session).has("seller");

    document.querySelectorAll<HTMLElement>("[data-remote-properties]").forEach(async (container) => {
      const mode = container.getAttribute("data-remote-mode") ?? "";
      const endpoint = endpoints[mode];
      if (!endpoint) return;

      // Ohne Anbieter-Rolle liefert der Endpunkt garantiert 403 - die Anfrage
      // gar nicht erst senden, sonst steht bei jedem Aufruf ein Fehler in
      // Konsole und Telemetrie (WEB-B03).
      if (mode === "mine" && !isSeller) {
        renderSellerNotEnabled(container);
        return;
      }

      try {
        const response = await apiRequest<{ Properties: ApiProperty[] }>(endpoint);
        const properties = response.Properties ?? [];
        container.textContent = "";
        properties.forEach((property) => container.append(createApiPropertyCard(property, mode)));
        container.classList.toggle("hidden", properties.length === 0);

        const empty = container.closest("[data-user-page]")?.querySelector("[data-user-empty]");
        empty?.classList.toggle("hidden", properties.length > 0);
      } catch (error) {
        console.warn("[Heimatplatz] API user list load failed", error);
        // Fehler nicht als "leere Liste" maskieren: Kaeufer ohne Anbieter-Rolle
        // bekommen auf "Meine Immobilien" ein 403 - auf den Profil-Schalter verweisen.
        // (Greift nur noch bei veraltetem Token; der Normalfall wird oben abgefangen.)
        const emptyState = container.closest("[data-user-page]")?.querySelector("[data-user-empty]");
        const title = emptyState?.querySelector("h2");
        const text = emptyState?.querySelector("p");
        if (mode === "mine" && error instanceof Error && error.message.includes("403")) {
          renderSellerNotEnabled(container);
        } else if (title) {
          title.textContent = t("account.listLoadFailedTitle");
          if (text) text.textContent = t("account.listLoadFailedText");
        }
      }
    });
  }

  function bindPropertyForm() {
    document.querySelectorAll<HTMLFormElement>("[data-local-property-form]").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const submit = form.querySelector<HTMLButtonElement>("[type='submit']");
        const params = new URLSearchParams(window.location.search);
        const isEditForm = form.hasAttribute("data-edit-property-form");
        const remoteEditId = params.get("id");
        const localDraftId = params.get("draft");
        const editId = remoteEditId ?? localDraftId;
        const isRemoteEdit = !!remoteEditId && UUID_PATTERN.test(remoteEditId);

        if (isEditForm && form.dataset.editState !== "ready") {
          setFormStatus(form, t("editor.statusEditUnavailable"), "error");
          return;
        }

        const formData = new FormData(form);
        const amountFields = getAmountFieldNames(form);
        const draft: Draft = {};
        formData.forEach((value, key) => {
          if (key === "propertyImages" || key === "municipalityLookup" || key === "imageUrls") return;
          const raw = typeof value === "string" ? value : value.name;
          // Betragsfelder tragen Tausenderpunkte fuer die Anzeige - Entwurf und
          // API bekommen die reine Ziffernfolge (WEB-B04)
          draft[key] = amountFields.has(key) ? amountInputDigits(raw) : raw;
        });
        draft.id = editId ?? crypto.randomUUID?.() ?? `${Date.now()}`;
        draft.updatedAt = new Date().toISOString();

        const validationMessage = validatePropertyDraft(draft, { isEdit: !!editId });
        if (validationMessage) {
          setFormStatus(form, validationMessage, "error");
          return;
        }

        // Mindestens ein Foto - auch beim Bearbeiten (WEB-004; der Server prueft ebenfalls)
        if (getImageState(form).length === 0) {
          setFormStatus(form, t("editor.photoRequired"), "error");
          return;
        }

        submit?.setAttribute("disabled", "true");
        setFormStatus(form, editId ? t("editor.statusSavingChanges") : readSession() ? t("editor.statusSavingListing") : t("editor.statusSavingDraftLocal"));

        try {
          if (isRemoteEdit && readSession()) {
            setFormStatus(form, t("editor.statusUploadingImages"));
            const imageUrls = await uploadImages(form, true);
            draft.imageUrls = imageUrls;
            const updated = await updateRemoteProperty(remoteEditId, draft, imageUrls);
            if (updated) {
              window.location.href = "/meine-immobilien/?bearbeitet=api";
              return;
            }
          }

          if (!editId) {
            let imageUrls = await getLocalImageUrls(form);
            if (readSession()) {
              setFormStatus(form, t("editor.statusUploadingImages"));
              imageUrls = await uploadImages(form, true);
            }
            draft.imageUrls = imageUrls;
            const remote = await createRemoteProperty(draft, imageUrls);
            if (remote?.PropertyId) {
              window.location.href = "/meine-immobilien/?gespeichert=api";
              return;
            }
          }

          draft.imageUrls = await getLocalImageUrls(form);
          saveLocalDraft(draft, editId);
          window.location.href = editId ? "/meine-immobilien/?bearbeitet=1" : "/meine-immobilien/?gespeichert=1";
        } catch (error) {
          const remoteEditRejected =
            isRemoteEdit &&
            error instanceof ApiRequestError &&
            [401, 403, 404].includes(error.status);

          if (remoteEditRejected) {
            setPropertyEditState(form, "error");
          } else {
            draft.imageUrls = await getLocalImageUrls(form);
            saveLocalDraft(draft, editId);
          }

          if (editId) {
            setFormStatus(
              form,
              remoteEditRejected
                ? error instanceof Error
                  ? t("editor.statusUpdateRejectedDetail", { message: error.message })
                  : t("editor.statusUpdateRejected")
                : error instanceof Error
                  ? t("editor.statusUpdateFailedDetail", { message: error.message })
                  : t("editor.statusUpdateFailed"),
              "error",
            );
          } else {
            setFormStatus(
              form,
              error instanceof Error
                ? t("editor.statusSaveFailedDetail", { message: error.message })
                : t("editor.statusSaveFailed"),
              "error",
            );
          }
        } finally {
          submit?.removeAttribute("disabled");
        }
      });
    });
  }

  async function deleteRemoteProperty(id: string, button: HTMLButtonElement) {
    if (!readSession() || !UUID_PATTERN.test(id)) return;
    const card = button.closest("article");
    button.setAttribute("disabled", "true");

    try {
      await apiRequest(`/api/properties/${id}`, { method: "DELETE" });
      card?.remove();
      document.querySelectorAll<HTMLElement>("[data-remote-properties]").forEach((container) => {
        const empty = container.closest("[data-user-page]")?.querySelector("[data-user-empty]");
        empty?.classList.toggle("hidden", container.querySelectorAll("article").length > 0);
      });
    } catch (error) {
      window.alert(error instanceof Error ? error.message : t("myProperties.deleteFailed"));
      button.removeAttribute("disabled");
    }
  }

  // Sichtbare Bestaetigung nach Clipboard-Kopie (WEB-042) - beim nativen
  // Share-Sheet gibt das Betriebssystem selbst Rueckmeldung
  let shareToastTimer = 0;
  function announceLinkCopied() {
    let toast = document.querySelector<HTMLElement>("[data-share-toast]");
    if (!toast) {
      toast = document.createElement("div");
      toast.setAttribute("data-share-toast", "");
      toast.setAttribute("role", "status");
      toast.className = "fixed bottom-24 left-1/2 z-50 -translate-x-1/2 rounded-full bg-foreground px-4 py-2 text-sm font-semibold text-background shadow-lg";
      document.body.append(toast);
    }
    toast.textContent = t("detail.linkCopied");
    toast.hidden = false;
    window.clearTimeout(shareToastTimer);
    shareToastTimer = window.setTimeout(() => {
      toast.hidden = true;
    }, 2000);
  }

  async function shareUrl(button: HTMLButtonElement) {
    const url = button.getAttribute("data-share-url") || window.location.href;
    const title = button.getAttribute("data-share-title") || document.title;
    try {
      if (navigator.share) {
        await navigator.share({ title, url });
      } else {
        await navigator.clipboard.writeText(url);
        announceLinkCopied();
      }
      button.setAttribute("data-copied", "true");
      window.setTimeout(() => button.removeAttribute("data-copied"), 1600);
    } catch {
      // Sharing is user-controlled and can be cancelled without affecting the page.
    }
  }

  async function copyText(button: HTMLButtonElement) {
    const value = button.getAttribute("data-copy-value");
    if (!value) return;

    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
      } else {
        const input = document.createElement("textarea");
        input.value = value;
        input.setAttribute("readonly", "true");
        input.style.position = "fixed";
        input.style.left = "-9999px";
        document.body.append(input);
        input.select();
        const legacyDocument = document as unknown as { execCommand(commandId: string): boolean };
        legacyDocument.execCommand("copy");
        input.remove();
      }

      const text = button.querySelector<HTMLElement>("[data-copy-text]");
      const originalText = text?.textContent;
      const originalLabel = button.getAttribute("aria-label");
      button.setAttribute("data-copied", "true");
      button.setAttribute("aria-label", t("contact.copied"));
      if (text) text.textContent = t("contact.copied");

      window.setTimeout(() => {
        button.removeAttribute("data-copied");
        if (text && originalText) text.textContent = originalText;
        if (originalLabel) button.setAttribute("aria-label", originalLabel);
      }, 1600);
    } catch {
      const text = button.querySelector<HTMLElement>("[data-copy-text]");
      const originalText = text?.textContent;
      if (text) text.textContent = t("contact.copyFailed");
      window.setTimeout(() => {
        if (text && originalText) text.textContent = originalText;
      }, 1600);
    }
  }

  function bindGlobalActions() {
    document.addEventListener("click", async (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const menuButton = target?.closest("[data-card-action]");
      if (menuButton instanceof HTMLButtonElement) {
        const menuId = menuButton.getAttribute("aria-controls");
        const menu = menuId ? document.getElementById(menuId) : null;
        const willOpen = menu?.classList.contains("hidden") ?? false;
        closeCardMenus(menu instanceof HTMLElement ? menu : null);

        if (menu instanceof HTMLElement) {
          menu.classList.toggle("hidden", !willOpen);
          menuButton.setAttribute("aria-expanded", String(willOpen));
        }
        return;
      }

      // Entfernen-Icon auf Favoriten-/Blockiert-Seite: bewusst KEIN Toggle -
      // der Eintrag wird immer entfernt (auch wenn localStorage nicht mit dem
      // Server synchron ist), die Karte verschwindet sofort aus der Liste
      const listRemove = target?.closest("[data-list-remove]");
      if (listRemove instanceof HTMLButtonElement) {
        const action = listRemove.getAttribute("data-list-remove");
        const slug = listRemove.getAttribute("data-property-slug");
        const propertyId = listRemove.getAttribute("data-property-id");
        if (!slug || (action !== "favorite" && action !== "block")) return;

        setPropertyActionBusy(slug, true);
        try {
          await syncRemotePropertyAction(action, propertyId, false);
          propertyActionRevision += 1;
          removeValue(action === "favorite" ? STORAGE_KEYS.favorites : STORAGE_KEYS.blocked, slug);
          refreshActionButtons();
          syncUserLists();

          const container = listRemove.closest<HTMLElement>("[data-remote-properties]");
          listRemove.closest("[data-property-card]")?.remove();
          if (container) {
            const hasCards = container.querySelectorAll("[data-property-card]").length > 0;
            container.classList.toggle("hidden", !hasCards);
            const empty = container.closest("[data-user-page]")?.querySelector("[data-user-empty]");
            empty?.classList.toggle("hidden", hasCards);
          }
        } catch (error) {
          console.warn("[Heimatplatz] API sync for property status failed", error);
          showPropertyActionError(error);
        } finally {
          setPropertyActionBusy(slug, false);
        }
        return;
      }

      const actionButton = target?.closest("[data-property-action]");
      if (actionButton instanceof HTMLButtonElement) {
        const action = actionButton.getAttribute("data-property-action");
        const slug = actionButton.getAttribute("data-property-slug");
        const propertyId = actionButton.getAttribute("data-property-id");
        if (!slug || (action !== "favorite" && action !== "block")) return;

        if (!readSession()) {
          showLoginPrompt();
          return;
        }

        const previousFavorites = readArray<string>(STORAGE_KEYS.favorites);
        const previousBlocked = readArray<string>(STORAGE_KEYS.blocked);
        const oppositeWasActive = action === "favorite"
          ? previousBlocked.includes(slug)
          : previousFavorites.includes(slug);
        propertyActionRevision += 1;
        let active = false;

        if (action === "favorite") {
          active = toggleValue(STORAGE_KEYS.favorites, slug);
          if (active) removeValue(STORAGE_KEYS.blocked, slug);
        }
        if (action === "block") {
          active = toggleValue(STORAGE_KEYS.blocked, slug);
          if (active) removeValue(STORAGE_KEYS.favorites, slug);
        }

        refreshActionButtons();
        syncUserLists();
        closeCardMenus();
        setPropertyActionBusy(slug, true);
        try {
          await syncRemotePropertyAction(action, propertyId, active, oppositeWasActive);
          if (action === "block") {
            // Erst nach bestaetigtem Server-Sync melden: PropertySearchApp
            // refetcht dann und die blockierte Karte verschwindet aus der Liste.
            document.dispatchEvent(new CustomEvent("property-block-changed"));
          }
        } catch (error) {
          propertyActionRevision += 1;
          writeArray(STORAGE_KEYS.favorites, previousFavorites);
          writeArray(STORAGE_KEYS.blocked, previousBlocked);
          refreshActionButtons();
          syncUserLists();
          console.warn("[Heimatplatz] API sync for property status failed", error);
          showPropertyActionError(error);
        } finally {
          setPropertyActionBusy(slug, false);
        }
        return;
      }

      const remove = target?.closest("[data-draft-remove]");
      if (remove instanceof HTMLButtonElement) {
        const id = remove.getAttribute("data-draft-remove");
        const drafts = readArray<Draft>(STORAGE_KEYS.drafts).filter((draft) => draft.id !== id);
        writeArray(STORAGE_KEYS.drafts, drafts);
        renderDrafts();
        return;
      }

      const remoteDelete = target?.closest("[data-remote-delete]");
      if (remoteDelete instanceof HTMLButtonElement) {
        const id = remoteDelete.getAttribute("data-remote-delete");
        if (id && window.confirm(t("card.deleteConfirm"))) {
          void deleteRemoteProperty(id, remoteDelete);
        }
        return;
      }

      const copy = target?.closest("[data-copy-value]");
      if (copy instanceof HTMLButtonElement) {
        void copyText(copy);
        return;
      }

      const share = target?.closest("[data-share-url]");
      if (share instanceof HTMLButtonElement) {
        void shareUrl(share);
        return;
      }

      const logout = target?.closest("[data-logout]");
      if (logout instanceof HTMLButtonElement) {
        clearSession();
        if (window.location.pathname === "/profil/") {
          window.location.href = getLoginHrefForCurrentPage();
        }
      }

      const deleteAccount = target?.closest("[data-delete-account]");
      if (deleteAccount instanceof HTMLButtonElement) {
        void handleDeleteAccount(deleteAccount);
        return;
      }

      const deleteAccountConfirmed = target?.closest("[data-delete-account-confirmed]");
      if (deleteAccountConfirmed instanceof HTMLButtonElement) {
        void performDeleteAccount(deleteAccountConfirmed);
        return;
      }

      const deleteAccountCancel = target?.closest("[data-delete-account-cancel]");
      if (deleteAccountCancel instanceof HTMLButtonElement) {
        toggleDeleteAccountConfirm(false);
        return;
      }

      if (!target?.closest("[data-card-menu]")) {
        closeCardMenus();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeCardMenus();
      }
    });
  }

