---
import ChevronDownIcon from "@tabler/icons/outline/chevron-down.svg";
import FilterIcon from "@tabler/icons/outline/filter.svg";
import { NativeSelect } from "@/components/starwind/native-select";
import OrtPicker from "@/components/properties/OrtPicker.astro";
import { fetchOrtRegions } from "@/features/locations/live-api";
import { t } from "@/i18n";

// Gleiche API-basierte Ortsliste wie der Desktop-Picker im SiteHeader (cached)
const ortRegions = await fetchOrtRegions();
---

<section class="border-b border-border bg-background lg:hidden" data-mobile-filter>
  <button
    class="group grid min-h-11 w-full grid-cols-[1fr_auto] items-center px-3 text-left"
    type="button"
    data-mobile-filter-toggle
    aria-expanded="false"
  >
    <span class="flex items-center gap-2 text-sm font-semibold">
      <FilterIcon class="size-4" aria-hidden="true" />
      {t("search.filterToggle")}
    </span>
    {/* Die Trefferzahl steht direkt darunter als Stempel in der Suchleiste -
        hier bleibt nur der Aufklapp-Indikator */}
    <ChevronDownIcon class="size-4 text-muted-foreground transition-transform duration-200 group-aria-expanded:rotate-180" aria-hidden="true" />
  </button>

  <form action="/" method="get" class="hidden px-3 pb-3" data-mobile-filter-body>
    <div class="grid grid-cols-2 gap-2">
      <OrtPicker name="region" placeholder={t("filter.locationPlaceholder")} regions={ortRegions.length > 0 ? ortRegions : undefined} />
      {/* size="sm" (h-9): gleiche Hoehe wie der OrtPicker-Trigger daneben;
          text-base bleibt - <select> unter 16px loest auf iOS Auto-Zoom aus */}
      <NativeSelect name="age" size="sm" class="text-base" aria-label={t("filter.period")} data-filter-age>
        <option value="">{t("filter.period")}</option>
        <option value="day">{t("filter.period24h")}</option>
        <option value="week">{t("filter.period7d")}</option>
        <option value="month">{t("filter.period30d")}</option>
        <option value="year">{t("filter.period1y")}</option>
      </NativeSelect>
    </div>

    <div class="mt-3 flex flex-wrap gap-2">
      {/* Kein eigener "Wohnung"-Chip: die API kennt nur House/Land/Foreclosure,
          die Desktop-Suchleiste bietet ihn ebenfalls nicht - Filterung laeuft
          komplett serverseitig. Zwangsversteigerungen standardmaessig deaktiviert. */}
      <div class="filter-chip-group" role="group" aria-label={t("search.settingsTypeTitle")}>
        <button type="button" class="filter-chip" data-filter-type="house" aria-pressed="true">{t("filter.typeHouse")}</button>
        <button type="button" class="filter-chip" data-filter-type="land" aria-pressed="true">{t("filter.typeLand")}</button>
        <button type="button" class="filter-chip" data-filter-type="foreclosure" aria-pressed="false">{t("filter.typeForeclosure")}</button>
      </div>
      <div class="filter-chip-group" role="group" aria-label={t("search.settingsSellerTitle")} data-seller-filter-group>
        <button type="button" class="filter-chip" data-filter-seller-chip="private" aria-pressed="true">{t("filter.sellerPrivate")}</button>
        <button type="button" class="filter-chip" data-filter-seller-chip="agent" aria-pressed="true">{t("filter.sellerAgent")}</button>
      </div>
    </div>

    <button
      type="button"
      class="mt-3 w-full rounded-md border border-border px-4 py-2.5 text-sm font-semibold text-muted-foreground hover:border-foreground hover:text-foreground"
      data-filter-reset
    >
      {t("search.filterReset")}
    </button>
  </form>
</section>
