---
import ArrowsSortIcon from "@tabler/icons/outline/arrows-sort.svg";
import ChevronLeftIcon from "@tabler/icons/outline/chevron-left.svg";
import ChevronRightIcon from "@tabler/icons/outline/chevron-right.svg";
import { NativeSelect } from "@/components/starwind/native-select";
import type { ApiProperty } from "@/features/properties/live-api";
import type { OrtSlugMap } from "@/features/properties/search-query";
import { SEARCH_PAGE_SIZE } from "@/features/properties/search-query";
import { fetchOrtRegions } from "@/features/locations/live-api";
import { jsonForScriptTag } from "@/lib/utils/json";
import { t } from "@/i18n";
import ApiPropertyCard from "@/components/properties/ApiPropertyCard.astro";
import MobileFilterPanel from "@/components/properties/MobileFilterPanel.astro";
import OrtPicker from "@/components/properties/OrtPicker.astro";

interface Props {
  apiProperties?: ApiProperty[];
  /** Gesamtanzahl Treffer (Server-Paging), nicht nur die aktuelle Seite */
  total?: number;
  /** 0-basierte Seite, die SSR gerendert hat */
  page?: number;
  /** Query-String des SSR-Fetches - Client refetcht nur bei Abweichung */
  ssrQuery?: string;
  /** Slug -> MunicipalityIds fuer den Client-Query-Builder */
  ortSlugMap?: OrtSlugMap;
}

const {
  apiProperties = [],
  total = apiProperties.length,
  page = 0,
  ssrQuery = "",
  ortSlugMap = {},
} = Astro.props;
const pageCount = Math.max(1, Math.ceil(total / SEARCH_PAGE_SIZE));
// Such-Picker arbeitet auf der echten Bezirk/Gemeinde-Hierarchie der API
// (Slugs -> MunicipalityIds, serverseitige Filterung). Cached, faellt bei
// API-Ausfall auf die statischen SEO-Ortsteile zurueck.
const ortRegions = await fetchOrtRegions();
---

<MobileFilterPanel />

<div
  data-search-config
  data-ssr-query={ssrQuery}
  data-initial-total={String(total)}
  data-initial-page={String(page)}
  hidden
>
</div>
<script is:inline type="application/json" data-ort-slug-map set:html={jsonForScriptTag(ortSlugMap)} />

{/* Suchleiste: Desktop-Filter links, Treffer-Stempel + Sortierung rechts.
    Ab lg klebt sie unter dem Header (Filter bleiben beim Scrollen greifbar);
    auf Mobile liefert das MobileFilterPanel darueber die Filter. */}
<section class="z-30 border-b border-border bg-background supports-[backdrop-filter]:bg-background/85 supports-[backdrop-filter]:backdrop-blur-md lg:sticky lg:top-14">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-3 py-2 sm:px-5">
    <form action="/" method="get" class="hidden min-w-0 flex-1 flex-wrap items-center gap-2.5 lg:flex">
      <div class="w-44 xl:w-56">
        <OrtPicker name="region" placeholder={t("filter.locationPlaceholder")} regions={ortRegions.length > 0 ? ortRegions : undefined} />
      </div>
      <NativeSelect name="age" size="sm" class="w-32" data-filter-age>
        <option value="">{t("filter.period")}</option>
        <option value="day">{t("filter.period24h")}</option>
        <option value="week">{t("filter.period7d")}</option>
        <option value="month">{t("filter.period30d")}</option>
        <option value="year">{t("filter.period1y")}</option>
      </NativeSelect>
      <div class="filter-chip-group" role="group" aria-label={t("search.settingsTypeTitle")}>
        <button type="button" class="filter-chip" data-filter-type="house" aria-pressed="true">{t("filter.typeHouse")}</button>
        <button type="button" class="filter-chip" data-filter-type="land" aria-pressed="true">{t("filter.typeLand")}</button>
        {/* Zwangsversteigerungen sind standardmaessig deaktiviert - Chip startet
            unpressed, updateFilterChips uebernimmt danach URL/Praeferenzen */}
        <button type="button" class="filter-chip" data-filter-type="foreclosure" aria-pressed="false">{t("filter.typeForeclosure")}</button>
      </div>
      <div class="filter-chip-group" role="group" aria-label={t("search.settingsSellerTitle")} data-seller-filter-group>
        <button type="button" class="filter-chip" data-filter-seller-chip="private" aria-pressed="true">{t("filter.sellerPrivate")}</button>
        <button type="button" class="filter-chip" data-filter-seller-chip="agent" aria-pressed="true">{t("filter.sellerAgent")}</button>
      </div>
    </form>
    <div class="flex flex-1 items-center justify-between gap-3 lg:flex-none lg:justify-end">
      <span class="result-count" data-result-count>{t(total === 1 ? "search.resultCountOne" : "search.resultCountMany", { count: total })}</span>
      <label class="flex items-center">
        <span class="sr-only">{t("search.sortLabel")}</span>
        {/* Gleiche eingefasste Optik wie das Zeitraum-Select; das Sortier-Icon
            sitzt als Indikator im Rahmen (ersetzt den Chevron-Slot).
            text-base auf Mobile: <select> unter 16px loest auf iOS Auto-Zoom aus */}
        <NativeSelect size="sm" class="cursor-pointer text-base sm:text-sm" data-filter-sort>
          <option value="newest">{t("search.sortNewest")}</option>
          <option value="oldest">{t("search.sortOldest")}</option>
          <option value="price-asc">{t("search.sortPriceAsc")}</option>
          <option value="price-desc">{t("search.sortPriceDesc")}</option>
          <option value="area-desc">{t("search.sortAreaDesc")}</option>
          <option value="area-asc">{t("search.sortAreaAsc")}</option>
          <option value="postal-asc">{t("search.sortPostalAsc")}</option>
          <option value="postal-desc">{t("search.sortPostalDesc")}</option>
          <ArrowsSortIcon
            slot="icon"
            class="pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2 text-foreground opacity-50"
            aria-hidden="true"
          />
        </NativeSelect>
      </label>
    </div>
  </div>
</section>

<slot name="after-toolbar" />

<section class="px-3 py-4 sm:px-5">
  <div class="mx-auto grid max-w-7xl gap-4 sm:grid-cols-2 xl:grid-cols-3" data-property-grid>
    {apiProperties.map((property) => <ApiPropertyCard property={property} />)}
  </div>
  <p class="mx-auto mt-4 hidden max-w-7xl text-sm text-muted-foreground" data-live-status></p>
  <p
    class:list={["mx-auto max-w-7xl py-16 text-center text-sm text-muted-foreground", total !== 0 && "hidden"]}
    data-empty-state
  >
    {t("search.emptyState")}
  </p>
  <nav
    class:list={[
      "mx-auto mt-5 max-w-7xl items-center justify-center gap-4 border-t border-border pt-4",
      pageCount > 1 ? "flex" : "hidden",
    ]}
    aria-label={t("search.paginationLabel")}
    data-pagination
  >
    <button
      type="button"
      class="grid size-10 place-items-center rounded-md border border-border bg-background text-foreground disabled:cursor-not-allowed disabled:opacity-40"
      aria-label={t("search.pagePrev")}
      disabled={page <= 0}
      data-page-prev
    >
      <ChevronLeftIcon class="size-5" aria-hidden="true" />
    </button>
    <span class="min-w-28 text-center text-sm font-medium text-muted-foreground" aria-live="polite" data-pagination-info>
      {pageCount > 1 ? t("search.pageOf", { current: page + 1, total: pageCount }) : ""}
    </span>
    <button
      type="button"
      class="grid size-10 place-items-center rounded-md border border-border bg-background text-foreground disabled:cursor-not-allowed disabled:opacity-40"
      aria-label={t("search.pageNext")}
      disabled={page >= pageCount - 1}
      data-page-next
    >
      <ChevronRightIcon class="size-5" aria-hidden="true" />
    </button>
  </nav>
</section>

<script>
  import { getResponsiveImage } from "@/lib/images";
  import { formatApiDate, formatApiPrice, getApiLocationLine, getApiStreetLine, getDisplayTitle } from "@/features/properties/format";
  import { readDebugApiUrl } from "@/lib/utils/debug-host";
  import { t } from "@/i18n";
  import {
    ALL_SELLERS,
    ALL_TYPES,
    buildPropertySearchQuery,
    DEFAULT_TYPES,
    normalizeTypeValue,
    SEARCH_PAGE_SIZE,
    type OrtSlugMap,
    type PropertySearchState,
  } from "@/features/properties/search-query";
  // Nur Typ-Importe aus live-api (werden beim Build geloescht) - Wert-Importe wuerden
  // die Server-Abhaengigkeiten (ttl-cache, api-base) ins Client-Bundle ziehen
  import type { ApiProperty, ApiPropertyResponse } from "@/features/properties/live-api";

  type VerifiedImageMap = Record<string, string>;

  // Debug-Tab kann den Endpunkt zur Laufzeit umschalten (nur localhost/LAN, wie MAUI-DebugPage)
  const API_BASE_URL = readDebugApiUrl() || import.meta.env.PUBLIC_API_BASE_URL || "https://api.heimatplatz.at";

  // Angemeldet suchen: Die API filtert blockierte Immobilien nur bei
  // authentifizierten Requests aus (GetPropertiesHandler) - dafuer braucht der
  // Such-Fetch das Access Token aus der Session (gleicher Key wie PropertyStateScript).
  function readAccessToken(): string | null {
    try {
      const raw = window.localStorage.getItem("heimatplatz:session");
      if (!raw) return null;
      const session = JSON.parse(raw) as { AccessToken?: string; ExpiresAt?: string };
      if (!session.AccessToken) return null;
      if (session.ExpiresAt && new Date(session.ExpiresAt).getTime() <= Date.now()) return null;
      // Abgelaufene Access Tokens (JWT exp) nicht mitschicken - dann lieber
      // anonym suchen; den Refresh erledigt PropertyStateScript beim naechsten
      // apiRequest, die Suche liest hier den frischen Token aus dem localStorage.
      const payload = session.AccessToken.split(".")[1];
      if (payload) {
        const padded = payload.replace(/-/g, "+").replace(/_/g, "/").padEnd(Math.ceil(payload.length / 4) * 4, "=");
        const exp = (JSON.parse(window.atob(padded)) as { exp?: number }).exp;
        if (typeof exp === "number" && exp * 1000 <= Date.now()) return null;
      }
      return session.AccessToken;
    } catch {
      return null;
    }
  }
  const params = new URLSearchParams(window.location.search);
  const resultCount = document.querySelector<HTMLElement>("[data-result-count]");
  const mobileResultCount = document.querySelector<HTMLElement>("[data-mobile-result-count]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  const liveStatus = document.querySelector<HTMLElement>("[data-live-status]");
  const input = document.querySelector<HTMLInputElement>("[data-filter-input]");
  const ortPickers = Array.from(document.querySelectorAll<HTMLElement>("[data-ort-picker][data-ort-picker-name='region']"));
  const ageControls = Array.from(document.querySelectorAll<HTMLSelectElement>("[data-filter-age]"));
  const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter-type]"));
  const sellerButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter-seller-chip]"));
  const sellerFilterGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-seller-filter-group]"));
  const sort = document.querySelector<HTMLSelectElement>("[data-filter-sort]");
  const pagination = document.querySelector<HTMLElement>("[data-pagination]");
  const prevPage = document.querySelector<HTMLButtonElement>("[data-page-prev]");
  const nextPage = document.querySelector<HTMLButtonElement>("[data-page-next]");
  const paginationInfo = document.querySelector<HTMLElement>("[data-pagination-info]");
  const mobileToggle = document.querySelector<HTMLButtonElement>("[data-mobile-filter-toggle]");
  const mobileBody = document.querySelector<HTMLElement>("[data-mobile-filter-body]");
  const config = document.querySelector<HTMLElement>("[data-search-config]");
  const TYPE_VALUES: string[] = [...ALL_TYPES];
  const DEFAULT_TYPE_VALUES: string[] = [...DEFAULT_TYPES];
  const SELLER_VALUES: string[] = [...ALL_SELLERS];

  // Slug -> MunicipalityIds, vom SSR eingebettet (gleiche Quelle wie der OrtPicker)
  const ortSlugMap: OrtSlugMap = (() => {
    try {
      return JSON.parse(document.querySelector("[data-ort-slug-map]")?.textContent ?? "{}") as OrtSlugMap;
    } catch {
      return {};
    }
  })();

  let currentPage = Math.max(0, Number(config?.dataset.initialPage ?? 0) || 0);
  let totalCount = Math.max(0, Number(config?.dataset.initialTotal ?? 0) || 0);
  let verifiedImageMapPromise: Promise<VerifiedImageMap> | null = null;

  const preset = {
    q: config?.dataset.presetQuery ?? "",
    type: config?.dataset.presetType ?? "",
    seller: config?.dataset.presetSeller ?? "",
    region: config?.dataset.presetRegion ?? "",
    age: config?.dataset.presetAge ?? "",
  };

  function transliterateGerman(value: string) {
    return value
      .replace(/ä/g, "ae")
      .replace(/Ä/g, "ae")
      .replace(/ö/g, "oe")
      .replace(/Ö/g, "oe")
      .replace(/ü/g, "ue")
      .replace(/Ü/g, "ue")
      .replace(/ß/g, "ss");
  }

  function normalize(value: string) {
    return transliterateGerman(value)
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");
  }

  type StoredFilterPreferences = {
    IsHausSelected?: boolean;
    IsGrundstueckSelected?: boolean;
    IsZwangsversteigerungSelected?: boolean;
    IsPrivateSelected?: boolean;
    IsBrokerSelected?: boolean;
    SelectedOrtes?: string[];
    SelectedAgeFilter?: number | string;
    SelectedSort?: number | string;
  };

  function readStoredFilterPreferences(): StoredFilterPreferences | null {
    try {
      const value = localStorage.getItem("heimatplatz:filter-preferences");
      return value ? JSON.parse(value) as StoredFilterPreferences : null;
    } catch {
      return null;
    }
  }

  function getSelectedTypes(preferences: StoredFilterPreferences | null) {
    if (!preferences) return "";
    // Zwangsversteigerungen nur bei explizitem Opt-in ("=== true"): fehlt der Wert
    // in aelteren Praeferenzen, gilt der Standard (deaktiviert). Eine Voll-Auswahl
    // wird bewusst NICHT auf "kein Filter" reduziert, sonst fiele sie auf den
    // Default (ohne Zwangsversteigerungen) zurueck.
    const selected = [
      preferences.IsHausSelected !== false ? "house" : "",
      preferences.IsGrundstueckSelected !== false ? "land" : "",
      preferences.IsZwangsversteigerungSelected === true ? "foreclosure" : "",
    ].filter(Boolean);
    return selected.join(",");
  }

  function getSelectedSellers(preferences: StoredFilterPreferences | null) {
    if (!preferences) return "";
    const selected = [
      preferences.IsPrivateSelected !== false ? "private" : "",
      preferences.IsBrokerSelected !== false ? "agent" : "",
    ].filter(Boolean);
    return selected.length > 0 && selected.length < SELLER_VALUES.length ? selected.join(",") : "";
  }

  function getStoredAge(preferences: StoredFilterPreferences | null) {
    const age = Number(preferences?.SelectedAgeFilter ?? 0);
    if (age === 1) return "day";
    if (age === 2 || age === 7) return "week";
    if (age === 3 || age === 30) return "month";
    if (age === 4 || age >= 365) return "year";
    return "";
  }

  function getStoredSort(preferences: StoredFilterPreferences | null) {
    const mode = Number(preferences?.SelectedSort ?? 0);
    if (mode === 1) return "oldest";
    if (mode === 2) return "price-asc";
    if (mode === 3) return "price-desc";
    if (mode === 4) return "area-desc";
    if (mode === 5) return "area-asc";
    if (mode === 6) return "postal-asc";
    if (mode === 7) return "postal-desc";
    return "newest";
  }

  function getStoredLocations(preferences: StoredFilterPreferences | null) {
    return Array.isArray(preferences?.SelectedOrtes)
      ? preferences.SelectedOrtes.map((item) => String(item)).filter(Boolean)
      : [];
  }

  const storedPreferences = readStoredFilterPreferences();
  const storedOrtSlugs = getStoredLocations(storedPreferences)
    .map((location) => normalize(location))
    .filter(Boolean);
  const storedInitial = {
    type: getSelectedTypes(storedPreferences),
    seller: getSelectedSellers(storedPreferences),
    age: getStoredAge(storedPreferences),
    sort: getStoredSort(storedPreferences),
  };

  function initialValue(name: string, presetValue: string, storedValue: string) {
    const value = params.get(name);
    if (value !== null) return value;
    return presetValue || storedValue || "";
  }

  function splitSelection(value: string | null | undefined, allowed: string[]) {
    if (!value) return [];
    return value
      .split(",")
      .map((item) => normalizeTypeValue(item.trim()))
      .filter((item) => allowed.includes(item));
  }

  function getQuerySelection(name: string, allowed: string[]) {
    return params
      .getAll(name)
      .flatMap((value) => splitSelection(value, allowed));
  }

  function initialSelection(name: string, presetValue: string, storedValue: string, allowed: string[], fallback: string[] = allowed) {
    const queryValues = getQuerySelection(name, allowed);
    if (queryValues.length > 0) return queryValues;

    const presetValues = splitSelection(presetValue, allowed);
    if (presetValues.length > 0) return presetValues;

    const storedValues = splitSelection(storedValue, allowed);
    if (storedValues.length > 0) return storedValues;

    return [...fallback];
  }

  const initial = {
    q: params.get("q") ?? preset.q,
    types: initialSelection("type", preset.type, storedInitial.type, TYPE_VALUES, DEFAULT_TYPE_VALUES),
    sellers: initialSelection("seller", preset.seller, storedInitial.seller, SELLER_VALUES),
    age: initialValue("age", preset.age, storedInitial.age),
    sort: params.get("sort") ?? storedInitial.sort,
  };
  const selectedTypes = new Set(initial.types);
  const selectedSellers = new Set(initial.sellers);
  let filtersTouched = false;

  // Multi-Select Orte: aus URL (?region=linz,steyr), Preset oder gespeicherten Praeferenzen
  function parseSlugList(value: string | null | undefined) {
    if (!value) return [] as string[];
    return value
      .split(",")
      .map((entry) => entry.trim())
      .filter(Boolean);
  }
  const initialOrtSlugs: string[] = (() => {
    const fromUrl = parseSlugList(params.get("region"));
    if (fromUrl.length > 0) return fromUrl;
    const fromPreset = parseSlugList(preset.region);
    if (fromPreset.length > 0) return fromPreset;
    return storedOrtSlugs;
  })();
  const selectedOrtSlugs = new Set(initialOrtSlugs);

  if (input) input.value = initial.q;
  if (ortPickers.length > 0) {
    const api = (window as any).setOrtPickerValues;
    if (typeof api === "function") api("region", Array.from(selectedOrtSlugs));
  }
  ageControls.forEach((control) => {
    control.value = initial.age;
  });
  if (sort) sort.value = initial.sort;

  function isApiApartmentCandidate(property: ApiProperty) {
    const searchText = [
      property.Title,
      property.Description ?? "",
      property.Features?.join(" ") ?? "",
    ].join(" ").toLowerCase();

    return Boolean(property.LivingAreaM2 && !property.PlotAreaM2)
      || searchText.includes("wohnung")
      || searchText.includes("eigentumswohnung")
      || searchText.includes("apartment");
  }

  // Nur fuer die Badge-Anzeige auf der Karte - gefiltert wird serverseitig
  function mapType(property: ApiProperty) {
    if (property.Type === "House" && isApiApartmentCandidate(property)) return "apartment";
    const type = property.Type;
    if (type === "Land") return "land";
    if (type === "Foreclosure") return "foreclosure";
    return "house";
  }

  // Anbieter-Label wie getApiSellerLabel/ApiPropertyCard (Anzeige, kein Filter)
  function mapSellerLabel(property: ApiProperty) {
    if (property.Type === "Foreclosure") return t("card.sellerCourt");
    const sellerType = property.SellerType;
    if (sellerType === "Broker" || sellerType === 2) return t("card.sellerAgent");
    if (sellerType === "PropertyManager" || sellerType === 3) return t("card.sellerManager");
    return t("card.sellerPrivate");
  }

  function setLiveStatus(message: string, visible = true) {
    if (!liveStatus) return;
    liveStatus.textContent = message;
    liveStatus.classList.toggle("hidden", !visible);
  }

  function createText(tag: keyof HTMLElementTagNameMap, className: string, text: string) {
    const element = document.createElement(tag);
    element.className = className;
    element.textContent = text;
    return element;
  }

  function getApiDetailPath(id: string) {
    return `/immobilien/angebote/${encodeURIComponent(id)}/`;
  }

  // Inline-SVGs 1:1 aus ApiPropertyCard.astro (Tabler heart/eye-off/user/calendar),
  // damit JS-gerenderte Karten identisch zu den SSR-Karten aussehen.
  const ICONS = {
    heart: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"></path></svg>',
    eyeOff: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M10.585 10.587a2 2 0 0 0 2.829 2.828"></path><path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87"></path><path d="M3 3l18 18"></path></svg>',
    user: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"></path><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"></path></svg>',
    calendar: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12"></path><path d="M16 3v4"></path><path d="M8 3v4"></path><path d="M4 11h16"></path><path d="M11 15h1"></path><path d="M12 15v3"></path></svg>',
  };

  // Fusszeile der Karte (Verkaeufer links, Datum rechts) - 1:1 zu ApiPropertyCard.astro.
  // mt-auto pinnt sie an den Kartenboden (Grid-Zeilen strecken die Karten gleich hoch).
  function createCardFooter(property: ApiProperty) {
    const footer = document.createElement("div");
    footer.className = "mt-auto flex items-center justify-between gap-3 border-t border-border bg-muted/50 px-3 py-2 text-xs text-muted-foreground";

    const seller = document.createElement("span");
    seller.className = "flex min-w-0 items-center gap-1.5";
    seller.innerHTML = ICONS.user.replace('class="size-3"', 'class="size-3.5 shrink-0"');
    seller.append(createText("span", "truncate", [mapSellerLabel(property), property.SellerName?.trim()].filter(Boolean).join(" · ")));

    const date = document.createElement("span");
    date.className = "flex shrink-0 items-center gap-1.5";
    date.innerHTML = ICONS.calendar.replace('class="size-3"', 'class="size-3.5 shrink-0"');
    date.append(document.createTextNode(formatApiDate(property.CreatedAt) || t("card.liveOffer")));

    footer.append(seller, date);
    return footer;
  }

  function loadVerifiedImageMap() {
    if (!verifiedImageMapPromise) {
      verifiedImageMapPromise = fetch("/api/property-image-map.json")
        .then((response) => response.ok ? response.json() as Promise<VerifiedImageMap> : {})
        .catch(() => ({}));
    }

    return verifiedImageMapPromise;
  }

  function getSafeImageUrl(property: ApiProperty, verifiedImages: VerifiedImageMap) {
    const verified = verifiedImages[property.Id];
    if (verified) return verified;

    const firstImage = property.ImageUrls?.[0] ?? "";
    if (firstImage.startsWith("/") || (firstImage && !firstImage.includes("/api/images/proxy"))) {
      return firstImage;
    }

    return "/favicon.svg";
  }

  function applyImageFallback(image: HTMLImageElement) {
    if (image.dataset.fallbackApplied === "true") return;
    image.dataset.fallbackApplied = "true";
    image.removeAttribute("srcset");
    image.removeAttribute("sizes");
    image.src = image.dataset.fallbackImage || "/favicon.svg";
  }

  function createApiCard(property: ApiProperty, verifiedImages: VerifiedImageMap) {
    const article = document.createElement("article");
    const type = mapType(property);
    const area = property.PlotAreaM2 ?? property.LivingAreaM2 ?? 0;

    article.className = "property-card group flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lg";
    article.dataset.propertyCard = "";
    article.dataset.liveProperty = "true";
    article.dataset.slug = property.Id;
    article.dataset.propertyId = property.Id;

    const media = document.createElement("div");
    media.className = "relative h-50 overflow-hidden bg-muted";
    const link = document.createElement("a");
    link.href = getApiDetailPath(property.Id);
    link.className = "block h-full";
    const image = document.createElement("img");
    const responsiveImage = getResponsiveImage(getSafeImageUrl(property, verifiedImages));
    image.alt = property.Title;
    image.loading = "lazy";
    image.decoding = "async";
    image.className = "h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]";
    image.dataset.fallbackImage = "/favicon.svg";
    image.dataset.smartImage = "";
    image.addEventListener("error", () => applyImageFallback(image));
    image.src = responsiveImage.src;
    if (responsiveImage.srcset) image.srcset = responsiveImage.srcset;
    image.sizes = "(min-width: 1280px) 416px, (min-width: 640px) calc(50vw - 2rem), calc(100vw - 1.5rem)";
    link.append(image);

    // Typ-Farben: ZV = Markenrot, Grund = Gruen, Haus = Blau, Rest neutral (wie ApiPropertyCard.astro)
    const badgeClasses =
      type === "foreclosure"
        ? "bg-brand text-brand-foreground"
        : type === "land"
          ? "bg-type-grund text-white"
          : type === "house"
            ? "bg-type-haus text-white"
            : "bg-foreground text-background";
    const badge = createText(
      "span",
      `absolute left-3 top-3 rounded-full px-3 py-1.5 text-xs font-bold ${badgeClasses}`,
      type === "foreclosure" ? t("card.typeForeclosure") : type === "land" ? t("card.typeLand") : type === "apartment" ? t("card.typeApartment") : t("card.typeHouse"),
    );
    const actions = document.createElement("div");
    actions.className = "absolute right-3 top-3 flex gap-1";
    actions.innerHTML = `
      <button type="button" class="grid size-9 place-items-center rounded-full bg-black/55 text-white" aria-label="${t("card.favoriteAdd")}" aria-pressed="false" data-property-action="favorite" data-property-slug="${property.Id}" data-property-id="${property.Id}">${ICONS.heart}</button>
      <button type="button" class="grid size-9 place-items-center rounded-full bg-black/55 text-white" aria-label="${t("card.blockAdd")}" aria-pressed="false" data-property-action="block" data-property-slug="${property.Id}" data-property-id="${property.Id}">${ICONS.eyeOff}</button>
    `;
    media.append(link, badge, actions);

    const body = document.createElement("div");
    body.className = "grid grid-cols-[1fr_auto] gap-3 p-3";
    const left = document.createElement("div");
    left.className = "min-w-0";
    const title = document.createElement("h2");
    title.className = "truncate text-base font-semibold";
    const titleLink = document.createElement("a");
    titleLink.href = getApiDetailPath(property.Id);
    titleLink.className = "hover:underline";
    // Titel als Kopfzeile, darunter "PLZ Ort" und Strasse (wie ApiPropertyCard.astro)
    const locationLine = getApiLocationLine(property) || property.City;
    titleLink.textContent = getDisplayTitle(property.Title) || locationLine;
    title.append(titleLink);
    const streetLine = getApiStreetLine(property);
    // Gestaffelte Adresse: Ort kraeftig, Strasse klein und grau (wie ApiPropertyCard.astro)
    left.append(
      title,
      ...(locationLine ? [createText("p", "mt-0.5 truncate text-sm font-medium", locationLine)] : []),
      ...(streetLine ? [createText("p", "mt-0.5 truncate text-xs text-muted-foreground", streetLine)] : []),
    );

    const facts = document.createElement("dl");
    facts.className = "text-right";
    const chips = [
      property.LivingAreaM2 ? `<span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">${t("card.chipLivingArea", { value: property.LivingAreaM2 })}</span>` : "",
      property.Rooms ? `<span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">${t("card.chipRooms", { value: property.Rooms })}</span>` : "",
    ].filter(Boolean).join("");
    facts.innerHTML = `
      <div>
        <dt class="sr-only">${t("card.price")}</dt>
        <dd class="whitespace-nowrap text-xl font-bold leading-none text-price">${formatApiPrice(property.Price)}</dd>
      </div>
      <div class="mt-1.5">
        <dt class="sr-only">${t("card.area")}</dt>
        <dd class="text-sm font-semibold text-muted-foreground">${area ? t(property.PlotAreaM2 ? "card.plotAreaValue" : "card.livingAreaValue", { area }) : t("card.areaUnknown")}</dd>
      </div>
      ${chips ? `<div class="mt-3 flex justify-end gap-1">${chips}</div>` : ""}
    `;

    body.append(left, facts);
    article.append(media, body, createCardFooter(property));
    return article;
  }

  function getAgeValue() {
    return ageControls[0]?.value ?? initial.age;
  }

  function setSelectValue(controls: HTMLSelectElement[], value: string) {
    controls.forEach((control) => {
      control.value = value;
    });
  }

  function getActiveTypes() {
    const values = Array.from(selectedTypes).filter((value) => TYPE_VALUES.includes(value));
    return values.length > 0 ? values : [...DEFAULT_TYPE_VALUES];
  }

  function getActiveSellers() {
    const values = Array.from(selectedSellers).filter((value) => SELLER_VALUES.includes(value));
    return values.length > 0 ? values : [...SELLER_VALUES];
  }

  function setChipPressed(button: HTMLButtonElement, pressed: boolean) {
    // Die Optik haengt komplett am Attribut (.filter-chip[aria-pressed] in starwind.css)
    button.setAttribute("aria-pressed", String(pressed));
  }

  function updateFilterChips() {
    typeButtons.forEach((button) => {
      const value = button.dataset.filterType;
      setChipPressed(button, Boolean(value && selectedTypes.has(value)));
    });

    // Bei Zwangsversteigerungen gibt es keinen Anbieter-Unterschied (immer Gericht/Edikt) -
    // Anbieter-Filter ist dann wirkungslos und wird ausgeblendet statt eine tote Auswahl zu zeigen.
    // Die Auswahl bleibt erhalten, damit sie beim Zuschalten normaler Inserate wieder korrekt
    // sichtbar und wirksam wird.
    const activeTypes = getActiveTypes();
    const onlyForeclosure = activeTypes.length === 1 && activeTypes[0] === "foreclosure";
    sellerFilterGroups.forEach((group) => group.classList.toggle("hidden", onlyForeclosure));

    sellerButtons.forEach((button) => {
      const value = button.dataset.filterSellerChip;
      setChipPressed(button, Boolean(value && selectedSellers.has(value)));
    });
  }

  function getSearchState(): PropertySearchState {
    return {
      q: input?.value ?? initial.q,
      types: getActiveTypes(),
      sellers: getActiveSellers(),
      ortSlugs: Array.from(selectedOrtSlugs),
      age: getAgeValue(),
      sort: sort?.value ?? initial.sort,
      page: currentPage,
    };
  }

  function updateResultMeta() {
    const label = t(totalCount === 1 ? "search.resultCountOne" : "search.resultCountMany", { count: totalCount });
    if (resultCount) resultCount.textContent = label;
    if (mobileResultCount) mobileResultCount.textContent = label;
    if (emptyState) emptyState.classList.toggle("hidden", totalCount !== 0);

    const pageCount = Math.max(1, Math.ceil(totalCount / SEARCH_PAGE_SIZE));
    if (pagination) pagination.classList.toggle("hidden", pageCount <= 1);
    if (pagination) pagination.classList.toggle("flex", pageCount > 1);
    if (paginationInfo) paginationInfo.textContent = pageCount > 1 ? t("search.pageOf", { current: currentPage + 1, total: pageCount }) : "";
    if (prevPage) prevPage.disabled = currentPage <= 0;
    if (nextPage) nextPage.disabled = currentPage >= pageCount - 1;
  }

  // Filteraenderungen in die URL spiegeln: Reload/Teilen liefert per SSR
  // dieselben Treffer (gleicher Query-Builder auf dem Server).
  function updateUrl() {
    const url = new URL(window.location.href);
    ["q", "type", "seller", "region", "age", "sort", "page"].forEach((key) => url.searchParams.delete(key));

    const q = (input?.value ?? initial.q).trim();
    if (q) url.searchParams.set("q", q);
    // Der type-Parameter entfaellt nur bei der Standard-Auswahl (ohne Zwangs-
    // versteigerungen) - eine Voll-Auswahl muss explizit in der URL stehen,
    // sonst wuerde SSR beim Reload/Teilen wieder den Default anwenden.
    const types = getActiveTypes();
    const isDefaultTypes = types.length === DEFAULT_TYPE_VALUES.length
      && DEFAULT_TYPE_VALUES.every((type) => types.includes(type));
    if (!isDefaultTypes) url.searchParams.set("type", types.join(","));
    const sellers = getActiveSellers();
    if (sellers.length < SELLER_VALUES.length) url.searchParams.set("seller", sellers.join(","));
    if (selectedOrtSlugs.size > 0) url.searchParams.set("region", Array.from(selectedOrtSlugs).join(","));
    const age = getAgeValue();
    if (age) url.searchParams.set("age", age);
    const sortValue = sort?.value ?? "newest";
    if (sortValue !== "newest") url.searchParams.set("sort", sortValue);
    // 1-basiert in die URL spiegeln, passend zur Anzeige "Seite 2 von 2"
    if (currentPage > 0) url.searchParams.set("page", String(currentPage + 1));

    history.replaceState(null, "", url);
  }

  let refreshTimer: number | undefined;
  let abortController: AbortController | null = null;

  function scheduleRefresh(resetPage = false) {
    if (resetPage) currentPage = 0;
    window.clearTimeout(refreshTimer);
    // Kurzes Debounce buendelt schnelle Chip-Toggles zu einem Request
    refreshTimer = window.setTimeout(() => {
      void refresh();
    }, 150);
  }

  async function refresh() {
    const grid = document.querySelector<HTMLElement>("[data-property-grid]");
    if (!grid) return;

    abortController?.abort();
    const controller = new AbortController();
    abortController = controller;
    setLiveStatus(t("search.loading"));

    try {
      const query = buildPropertySearchQuery(getSearchState(), ortSlugMap);
      const token = readAccessToken();
      const response = await fetch(`${API_BASE_URL}/api/properties?${query}`, {
        signal: controller.signal,
        headers: token ? { Authorization: `Bearer ${token}` } : undefined,
      });
      if (!response.ok) throw new Error(`API ${response.status}`);
      const payload = await response.json() as ApiPropertyResponse;
      if (controller.signal.aborted) return;

      const properties = payload.Properties ?? [];
      totalCount = payload.Total ?? properties.length;
      const lastPage = Math.max(0, Math.ceil(totalCount / SEARCH_PAGE_SIZE) - 1);
      if (currentPage > lastPage) {
        // Kann z.B. nach dem Blockieren des letzten Treffers einer Seite passieren.
        // URL sofort korrigieren und die letzte gültige Seite nachladen.
        currentPage = lastPage;
        updateUrl();
        scheduleRefresh();
        return;
      }

      const verifiedImages = await loadVerifiedImageMap();
      if (controller.signal.aborted) return;
      grid.replaceChildren(...properties.map((property) => createApiCard(property, verifiedImages)));
      // PropertyStateScript setzt Favoriten-/Blockiert-Zustaende auf den neuen Karten
      document.dispatchEvent(new CustomEvent("property-cards-rendered"));
      updateResultMeta();
      updateUrl();
      setLiveStatus("", false);
    } catch {
      if (controller.signal.aborted) return;
      setLiveStatus(t("search.loadError"));
    }
  }

  function applyRemoteFilterPreferences(preferences: StoredFilterPreferences) {
    if (filtersTouched) return;

    if (!params.has("type") && !preset.type) {
      const types = splitSelection(getSelectedTypes(preferences), TYPE_VALUES);
      selectedTypes.clear();
      (types.length > 0 ? types : DEFAULT_TYPE_VALUES).forEach((value) => selectedTypes.add(value));
    }

    if (!params.has("seller") && !preset.seller) {
      const sellers = [
        preferences.IsPrivateSelected !== false ? "private" : "",
        preferences.IsBrokerSelected !== false ? "agent" : "",
      ].filter((value): value is string => Boolean(value));
      selectedSellers.clear();
      (sellers.length > 0 ? sellers : SELLER_VALUES).forEach((value) => selectedSellers.add(value));
    }

    if (!params.has("age") && !preset.age) {
      setSelectValue(ageControls, getStoredAge(preferences));
    }

    if (!params.has("sort") && sort) {
      sort.value = getStoredSort(preferences);
    }

    if (!params.has("region") && !preset.region) {
      selectedOrtSlugs.clear();
      getStoredLocations(preferences)
        .map((location) => normalize(location))
        .filter(Boolean)
        .forEach((value) => selectedOrtSlugs.add(value));
      const api = (window as any).setOrtPickerValues;
      if (typeof api === "function") api("region", Array.from(selectedOrtSlugs));
    }

    updateFilterChips();
    scheduleRefresh(true);
  }

  document.addEventListener("filter-preferences-loaded", (event) => {
    const preferences = (event as CustomEvent<StoredFilterPreferences>).detail;
    if (preferences) applyRemoteFilterPreferences(preferences);
  });

  input?.addEventListener("input", () => {
    filtersTouched = true;
    scheduleRefresh(true);
  });
  // OrtPicker (Multi-Select): aktualisiert das gemeinsame Set und synct alle Instanzen
  document.addEventListener("ort-picker-change", (event) => {
    const detail = (event as CustomEvent<{ name: string; values: string[] }>).detail;
    if (!detail || detail.name !== "region") return;
    filtersTouched = true;
    selectedOrtSlugs.clear();
    detail.values.forEach((value) => selectedOrtSlugs.add(value));
    // Andere OrtPicker (z.B. Mobile vs Desktop) synchronisieren - setOrtPickerValues
    // triggert syncState, aber kein erneutes emitChange, daher keine Endlosschleife.
    const api = (window as any).setOrtPickerValues;
    if (typeof api === "function") api("region", Array.from(selectedOrtSlugs));
    scheduleRefresh(true);
  });
  ageControls.forEach((control) => {
    control.addEventListener("change", () => {
      filtersTouched = true;
      setSelectValue(ageControls, control.value);
      scheduleRefresh(true);
    });
  });
  typeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.dataset.filterType;
      if (!value) return;
      filtersTouched = true;
      if (selectedTypes.has(value) && selectedTypes.size > 1) {
        selectedTypes.delete(value);
      } else {
        selectedTypes.add(value);
      }
      updateFilterChips();
      scheduleRefresh(true);
    });
  });
  sellerButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const value = button.dataset.filterSellerChip;
      if (!value) return;
      filtersTouched = true;
      if (selectedSellers.has(value) && selectedSellers.size > 1) {
        selectedSellers.delete(value);
      } else {
        selectedSellers.add(value);
      }
      updateFilterChips();
      scheduleRefresh(true);
    });
  });
  sort?.addEventListener("change", () => {
    filtersTouched = true;
    scheduleRefresh(true);
  });
  prevPage?.addEventListener("click", () => {
    if (currentPage <= 0) return;
    currentPage -= 1;
    scheduleRefresh();
  });
  nextPage?.addEventListener("click", () => {
    currentPage += 1;
    scheduleRefresh();
  });
  mobileToggle?.addEventListener("click", () => {
    const expanded = mobileToggle.getAttribute("aria-expanded") === "true";
    mobileToggle.setAttribute("aria-expanded", String(!expanded));
    mobileBody?.classList.toggle("hidden", expanded);
  });
  document.querySelectorAll<HTMLButtonElement>("[data-filter-reset]").forEach((button) => {
    button.addEventListener("click", () => {
      filtersTouched = true;
      if (input) input.value = "";
      selectedOrtSlugs.clear();
      const api = (window as any).setOrtPickerValues;
      if (typeof api === "function") api("region", []);
      setSelectValue(ageControls, "");
      selectedTypes.clear();
      DEFAULT_TYPE_VALUES.forEach((type) => selectedTypes.add(type));
      selectedSellers.clear();
      SELLER_VALUES.forEach((seller) => selectedSellers.add(seller));
      if (sort) sort.value = "newest";
      updateFilterChips();
      scheduleRefresh(true);
    });
  });

  // PropertyStateScript meldet Blockieren/Entblocken aus der Trefferliste -
  // authentifizierter Refetch entfernt die Karte und korrigiert den Zaehler.
  document.addEventListener("property-block-changed", () => scheduleRefresh());

  updateFilterChips();
  updateResultMeta();
  // Refetch, wenn der effektive Initial-Zustand (URL + gespeicherte Praeferenzen)
  // vom SSR-Zustand (nur URL) abweicht - oder eine Session existiert: SSR laeuft
  // ohne Token, erst der authentifizierte Fetch filtert blockierte Immobilien aus.
  if (buildPropertySearchQuery(getSearchState(), ortSlugMap) !== (config?.dataset.ssrQuery ?? "") || readAccessToken()) {
    scheduleRefresh();
  }
</script>
