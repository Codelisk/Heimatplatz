---
/**
 * Die Such-/Filterleiste der Trefferlisten als wiederverwendbares Control:
 * Desktop-Suchleiste (sticky, OrtPicker + Zeitraum + Typ-/Anbieter-/Neubau-Chips
 * + Treffer-Stempel + Sortierung) plus MobileFilterPanel darueber.
 *
 * Verwendet von der Startseite (PropertySearchApp, unveraendertes Verhalten -
 * deren Script bindet weiter ueber die data-Attribute) UND der Listen-Ansicht
 * unter /meine-uebersicht/ (eigener schlanker Binder in DashboardApp).
 * Markup-Aenderungen hier wirken auf BEIDE Seiten.
 *
 * `initial` setzt die SSR-Startzustaende (Listen-Ansicht: KI-Query als
 * Vorbelegung); ohne `initial` gelten die Startseiten-Defaults (Haus+Grund an,
 * ZV aus, beide Anbieter, Neubau an, Sortierung neueste).
 */
import ArrowsSortIcon from "@tabler/icons/outline/arrows-sort.svg";
import MapIcon from "@tabler/icons/outline/map-2.svg";
import { NativeSelect } from "@/components/starwind/native-select";
import MobileFilterPanel from "@/components/properties/MobileFilterPanel.astro";
import OrtPicker from "@/components/properties/OrtPicker.astro";
import { fetchOrtRegions } from "@/features/locations/live-api";
import { t } from "@/i18n";

export interface FilterBarInitial {
  /** aktivierte Objektarten ("house" | "land" | "foreclosure"); fehlt = Startseiten-Default */
  types?: string[];
  /** aktivierte Anbieter ("private" | "agent"); fehlt = beide */
  sellers?: string[];
  /** Sortierung (Startseiten-Werte, z.B. "newest", "price-asc") */
  sort?: string;
  /** false = Neubauprojekte-Chip aus */
  newBuild?: boolean;
}

interface Props {
  /** Karten-Toggle anzeigen (nur sinnvoll, wenn PropertyMapPanel auf der Seite ist) */
  showMapToggle?: boolean;
  /** Treffer-Stempel-Startwert (SSR) */
  initialTotal?: number;
  initial?: FilterBarInitial;
}

const { showMapToggle = true, initialTotal = 0, initial } = Astro.props;

// Such-Picker arbeitet auf der echten Bezirk/Gemeinde-Hierarchie der API
// (Slugs -> MunicipalityIds, serverseitige Filterung). Cached, faellt bei
// API-Ausfall auf die statischen SEO-Ortsteile zurueck.
const ortRegions = await fetchOrtRegions();

const typePressed = (slug: string) =>
  initial?.types ? initial.types.includes(slug) : slug !== "foreclosure";
const sellerPressed = (slug: string) => (initial?.sellers ? initial.sellers.includes(slug) : true);
const newBuildPressed = initial?.newBuild !== false;
const sortValue = initial?.sort ?? "newest";
const sortOptions = [
  ["newest", t("search.sortNewest")],
  ["oldest", t("search.sortOldest")],
  ["price-asc", t("search.sortPriceAsc")],
  ["price-desc", t("search.sortPriceDesc")],
  ["area-desc", t("search.sortAreaDesc")],
  ["area-asc", t("search.sortAreaAsc")],
  ["postal-asc", t("search.sortPostalAsc")],
  ["postal-desc", t("search.sortPostalDesc")],
] as const;
---

<MobileFilterPanel showMapToggle={showMapToggle} initial={initial} />

{/* Suchleiste: Desktop-Filter links, Treffer-Stempel + Sortierung rechts.
    Ab lg klebt sie unter dem Header (Filter bleiben beim Scrollen greifbar);
    auf Mobile liefert das MobileFilterPanel darueber die Filter. */}
<section class="z-30 border-b border-border bg-background supports-[backdrop-filter]:bg-background/85 supports-[backdrop-filter]:backdrop-blur-md lg:sticky lg:top-14">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-4 gap-y-2 px-3 py-2 sm:px-5">
    <form action="/" method="get" class="hidden min-w-0 flex-1 flex-wrap items-center gap-2.5 lg:flex">
      <div class="w-44 xl:w-56">
        <OrtPicker name="region" placeholder={t("filter.locationPlaceholder")} regions={ortRegions.length > 0 ? ortRegions : undefined} />
      </div>
      {/* aria-label PFLICHT: die erste Option ist nur ein visueller Titel, ohne
          Label bliebe die Auswahl im Accessibility-Tree namenlos (WEB-B07) */}
      <NativeSelect name="age" size="sm" class="w-32" aria-label={t("filter.period")} data-filter-age>
        <option value="">{t("filter.period")}</option>
        <option value="day">{t("filter.period24h")}</option>
        <option value="week">{t("filter.period7d")}</option>
        <option value="month">{t("filter.period30d")}</option>
        <option value="year">{t("filter.period1y")}</option>
      </NativeSelect>
      <div class="filter-chip-group" role="group" aria-label={t("search.settingsTypeTitle")}>
        <button type="button" class="filter-chip" data-filter-type="house" aria-pressed={typePressed("house") ? "true" : "false"}>{t("filter.typeHouse")}</button>
        <button type="button" class="filter-chip" data-filter-type="land" aria-pressed={typePressed("land") ? "true" : "false"}>{t("filter.typeLand")}</button>
        {/* Zwangsversteigerungen sind standardmaessig deaktiviert - Chip startet
            unpressed, updateFilterChips uebernimmt danach URL/Praeferenzen */}
        <button type="button" class="filter-chip" data-filter-type="foreclosure" aria-pressed={typePressed("foreclosure") ? "true" : "false"}>{t("filter.typeForeclosure")}</button>
      </div>
      <div class="filter-chip-group" role="group" aria-label={t("search.settingsSellerTitle")} data-seller-filter-group>
        <button type="button" class="filter-chip" data-filter-seller-chip="private" aria-pressed={sellerPressed("private") ? "true" : "false"}>{t("filter.sellerPrivate")}</button>
        <button type="button" class="filter-chip" data-filter-seller-chip="agent" aria-pressed={sellerPressed("agent") ? "true" : "false"}>{t("filter.sellerAgent")}</button>
      </div>
      {/* Neubauprojekte (noch nicht fertig gebaute Haeuser): eigener Ein-Chip-Toggle,
          KEIN Objekttyp (ein Neubauprojekt IST ein Haus) - gedrueckt = anzeigen (Default) */}
      <div class="filter-chip-group" role="group" aria-label={t("filter.newBuildGroup")}>
        <button type="button" class="filter-chip" data-filter-newbuild aria-pressed={newBuildPressed ? "true" : "false"} title={t("filter.newBuildHint")}>{t("filter.newBuild")}</button>
      </div>
    </form>
    <div class="flex flex-1 items-center justify-between gap-3 lg:flex-none lg:justify-end">
      {/* Kartenansicht: Toggle-Chip mit gleicher aria-pressed-Sprache wie die
          Filter-Chips - die Faltkarte (PropertyMapPanel) klappt als rechte
          Split-Spalte neben der Trefferliste auf, die Liste bleibt sichtbar */}
      {showMapToggle && (
        <button
          type="button"
          class="hidden shrink-0 cursor-pointer items-center gap-1.5 rounded-md border border-input bg-muted px-2.5 py-1.5 text-sm font-semibold text-foreground transition-colors aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground lg:inline-flex"
          data-map-toggle
          aria-pressed="false"
          aria-expanded="false"
          aria-controls="property-map"
        >
          <MapIcon class="size-4" aria-hidden="true" />
          {t("search.mapToggle")}
        </button>
      )}
      <span class="result-count" data-result-count>{t(initialTotal === 1 ? "search.resultCountOne" : "search.resultCountMany", { count: initialTotal })}</span>
      <label class="flex items-center">
        <span class="sr-only">{t("search.sortLabel")}</span>
        {/* Gleiche eingefasste Optik wie das Zeitraum-Select; das Sortier-Icon
            sitzt als Indikator im Rahmen (ersetzt den Chevron-Slot).
            text-base auf Mobile: <select> unter 16px loest auf iOS Auto-Zoom aus */}
        <NativeSelect size="sm" class="cursor-pointer text-base sm:text-sm" data-filter-sort>
          {sortOptions.map(([value, label]) => (
            <option value={value} selected={value === sortValue}>{label}</option>
          ))}
          <ArrowsSortIcon
            slot="icon"
            class="pointer-events-none absolute right-2 top-1/2 size-3.5 -translate-y-1/2 text-foreground opacity-50"
            aria-hidden="true"
          />
        </NativeSelect>
      </label>
    </div>
  </div>
</section>
