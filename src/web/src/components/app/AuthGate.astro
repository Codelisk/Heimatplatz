---
import LoginIcon from "@tabler/icons/outline/login.svg";
import UserPlusIcon from "@tabler/icons/outline/user-plus.svg";
import { Button } from "@/components/starwind/button";

/**
 * Blendet den Slot-Inhalt nur fuer angemeldete Nutzer ein und zeigt Gaesten
 * stattdessen einen Anmelde-Hinweis. Die Sichtbarkeit schaltet
 * PropertyStateScript ueber data-guest-only/data-auth-only (Client-Session in
 * localStorage) - Gaeste sehen den Hinweis sofort ohne Flackern, weil der
 * Slot serverseitig hidden gerendert wird.
 */
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-guest-only>
  <div class="mx-auto max-w-xl rounded-xl border border-border bg-card p-8 text-center shadow-sm sm:p-10">
    <span class="mx-auto grid size-12 place-items-center rounded-full bg-primary/10 text-primary">
      <LoginIcon class="size-6" aria-hidden="true" />
    </span>
    <h2 class="mt-4 text-xl font-bold sm:text-2xl">{title}</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">{description}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <Button href="/anmelden/">
        <LoginIcon class="size-4" aria-hidden="true" />
        Anmelden
      </Button>
      <Button href="/registrieren/" variant="outline">
        <UserPlusIcon class="size-4" aria-hidden="true" />
        Kostenlos registrieren
      </Button>
    </div>
  </div>
</div>

<div data-auth-only hidden>
  <slot />
</div>
