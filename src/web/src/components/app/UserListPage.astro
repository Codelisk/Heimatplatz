---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import EyeOffIcon from "@tabler/icons/outline/eye-off.svg";
import HomeIcon from "@tabler/icons/outline/home.svg";
import PlusIcon from "@tabler/icons/outline/plus.svg";
import UserIcon from "@tabler/icons/outline/user-cog.svg";
import AuthGate from "@/components/app/AuthGate.astro";
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  emptyTitle?: string;
  emptyText?: string;
  mode?: "favorites" | "blocked" | "mine";
}

const {
  title,
  description,
  canonicalPath,
  emptyTitle,
  emptyText,
  mode = "favorites",
} = Astro.props;

const emptyDefaults = {
  favorites: {
    title: t("favorites.emptyTitle"),
    text: t("favorites.emptyText"),
    Icon: HeartIcon,
  },
  blocked: {
    title: t("blocked.emptyTitle"),
    text: t("blocked.emptyText"),
    Icon: EyeOffIcon,
  },
  mine: {
    title: t("myProperties.emptyTitle"),
    text: t("myProperties.emptyText"),
    Icon: HomeIcon,
  },
} as const;

const empty = emptyDefaults[mode];
const Icon = empty.Icon;
const authCopy = {
  favorites: {
    title: t("favorites.authTitle"),
    text: t("favorites.authText"),
  },
  blocked: {
    title: t("blocked.authTitle"),
    text: t("blocked.authText"),
  },
  mine: {
    title: t("myProperties.authTitle"),
    text: t("myProperties.authText"),
  },
} as const;
const isMine = mode === "mine";
const savedDraft = isMine && Astro.url.searchParams.has("gespeichert");
const editedDraft = isMine && Astro.url.searchParams.has("bearbeitet");
// "=api" heisst: direkt am Server gespeichert (live), sonst lokaler Entwurf
const savedViaApi = Astro.url.searchParams.get("gespeichert") === "api";
const statusMessage = editedDraft
  ? t("myProperties.statusEdited")
  : savedViaApi
    ? t("myProperties.statusPublished")
    : t("myProperties.statusDraftSaved");
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} noindex>
  <div class="py-6 sm:py-8">
    <AuthGate title={authCopy[mode].title} description={authCopy[mode].text}>
      <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-user-page>
        {isMine && (
          <div class:list={["mb-5 rounded-md border border-border bg-muted px-4 py-3 text-sm font-medium", !(savedDraft || editedDraft) && "hidden"]} data-mine-status>
            <span data-mine-status-text>{statusMessage}</span>
          </div>
        )}

        {/* Aktionsleiste fuer die gefuellte Liste; bei leerer Liste uebernimmt der
            grosse Button im Empty-State (siehe :has()-Regel unten). */}
        {isMine && (
          <div class="mb-6 flex items-center justify-end gap-3" data-mine-cta-bar>
            <h1 class="sr-only">{t("myProperties.metaTitle")}</h1>
            <Button href="/inserieren/" data-mine-cta>
              <PlusIcon class="size-4.5" aria-hidden="true" />
              {t("myProperties.createCta")}
            </Button>
          </div>
        )}

        <div class="hidden grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-remote-properties data-remote-mode={mode}></div>
        {isMine && <div class="hidden grid gap-4 sm:grid-cols-2 xl:grid-cols-3" data-local-drafts></div>}

        <div class="flex min-h-[60vh] flex-col items-center justify-center gap-3 text-center" data-user-empty>
          <Icon class="size-16 text-muted-foreground" aria-hidden="true" />
          <h2 class="text-lg font-semibold">{emptyTitle ?? empty.title}</h2>
          <p class="max-w-sm text-sm text-muted-foreground">{emptyText ?? empty.text}</p>
          {isMine && (
            <>
              <Button href="/inserieren/" size="lg" class="mt-3" data-mine-cta>
                <PlusIcon class="size-5" aria-hidden="true" />
                {t("myProperties.createCta")}
              </Button>
              {/* Nur fuer Kaeufer ohne Anbieter-Rolle (403): PropertyStateScript blendet um */}
              <Button href="/profil/" size="lg" variant="outline" class="mt-3 hidden" data-mine-profile-cta>
                <UserIcon class="size-5" aria-hidden="true" />
                {t("myProperties.enableSellerCta")}
              </Button>
            </>
          )}
        </div>
      </section>
    </AuthGate>
  </div>
</BaseLayout>

<style>
  /* Solange der Empty-State sichtbar ist, traegt sein grosser Button die Aktion -
     die Kopfleiste waere daneben nur eine Dopplung. */
  [data-user-page]:has([data-user-empty]:not(.hidden)) [data-mine-cta-bar] {
    display: none;
  }
</style>
