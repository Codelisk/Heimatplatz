---
import CalendarIcon from "@tabler/icons/outline/calendar.svg";
import EyeOffIcon from "@tabler/icons/outline/eye-off.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import ScaleIcon from "@tabler/icons/outline/scale.svg";
import {
  formatAuctionArea,
  formatAuctionDateShort,
  getAuctionImage,
  getAuctionPriceLabel,
  getAuctionPrimaryArea,
  getAuctionTitle,
  getForeclosureAuctionPath,
  getForeclosureCategoryLabel,
  type ApiForeclosureAuction,
} from "@/features/foreclosures/api";
import { getResponsiveImage } from "@/lib/images";

interface Props {
  auction: ApiForeclosureAuction;
}

const { auction } = Astro.props;
const href = getForeclosureAuctionPath(auction);
const area = formatAuctionArea(getAuctionPrimaryArea(auction), "k.A.");
const imageUrl = getAuctionImage(auction);
const responsiveImage = getResponsiveImage(imageUrl);
---

<article
  class="group overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lg"
  data-property-card
  data-slug={auction.Id}
  data-property-id={auction.Id}
>
  <div class="relative h-50 overflow-hidden bg-muted">
    <a href={href} class="block h-full">
      <img
        src={responsiveImage.src}
        srcset={responsiveImage.srcset}
        sizes="(min-width: 1280px) 416px, (min-width: 640px) calc(50vw - 2rem), calc(100vw - 1.5rem)"
        alt={getAuctionTitle(auction)}
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        loading="lazy"
        decoding="async"
        data-fallback-image="/favicon.svg"
        data-smart-image
      />
    </a>
    <span class="absolute left-3 top-3 rounded-full bg-brand px-3 py-1.5 text-xs font-bold text-brand-foreground">ZV</span>
    <div class="absolute right-3 top-3 flex gap-1">
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full bg-black/55 text-white"
        aria-label="Zwangsversteigerung merken"
        aria-pressed="false"
        data-property-action="favorite"
        data-property-slug={auction.Id}
        data-property-id={auction.Id}
      >
        <HeartIcon class="size-5" aria-hidden="true" />
      </button>
      <button
        type="button"
        class="grid size-9 place-items-center rounded-full bg-black/55 text-white"
        aria-label="Zwangsversteigerung blockieren"
        aria-pressed="false"
        data-property-action="block"
        data-property-slug={auction.Id}
        data-property-id={auction.Id}
      >
        <EyeOffIcon class="size-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="grid grid-cols-[1fr_auto] gap-3 p-3">
    <div class="min-w-0">
      <h2 class="truncate text-base font-semibold">
        <a href={href} class="hover:underline">{auction.City}</a>
      </h2>
      <p class="truncate text-sm text-muted-foreground">{auction.PostalCode} {auction.Address}</p>
      <p class="mt-1 truncate text-xs text-muted-foreground">{getForeclosureCategoryLabel(auction.Category)}</p>
      <p class="mt-2 flex items-center gap-1 text-xs text-muted-foreground">
        <ScaleIcon class="size-3" aria-hidden="true" />
        {auction.Court || "Gericht offen"}
      </p>
      {/* Versteigerungstermin ist DIE Entscheidungsinfo bei ZV - deshalb betont statt muted */}
      <p class="mt-1 flex items-center gap-1 text-xs font-semibold text-foreground">
        <CalendarIcon class="size-3 text-primary" aria-hidden="true" />
        {formatAuctionDateShort(auction.AuctionDate)}
      </p>
    </div>

    <dl class="text-right">
      <div>
        <dt class="sr-only">Preis</dt>
        <dd class="whitespace-nowrap text-xl font-bold leading-none text-foreground">{getAuctionPriceLabel(auction)}</dd>
      </div>
      <div class="mt-1.5">
        <dt class="sr-only">Fläche</dt>
        <dd class="text-sm font-semibold text-muted-foreground">{area}</dd>
      </div>
      <div class="mt-3 flex justify-end gap-1">
        {auction.NumberOfRooms && <span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">{auction.NumberOfRooms} Zi</span>}
        {auction.YearBuilt && <span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">Bj. {auction.YearBuilt}</span>}
      </div>
    </dl>
  </div>
</article>
