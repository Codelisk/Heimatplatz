---
/**
 * SSR-Renderer der Widgets für die Erstauslieferung von /meine-uebersicht/:
 * malt exakt dieselben Strukturen wie die <template>-Klone in DashboardApp,
 * nur bereits serverseitig mit Daten gefüllt — die Seite kommt fertig beim
 * Browser an. Nach der ersten Interaktion (Anpassen/Wechseln) übernimmt das
 * Client-Rendering; Änderungen an Markup/Klassen müssen daher IMMER in beiden
 * Pfaden passieren (Templates in DashboardApp + hier).
 *
 * Grid-Karten kommen von der echten ApiPropertyCard (identisch zur Startseite,
 * inklusive Favoriten-/Blockieren-Buttons); die Karten-Widgets bekommen ihre
 * Pins als eingebettetes JSON und werden vom Island initialisiert.
 */
import ApiPropertyCard from "@/components/properties/ApiPropertyCard.astro";
import ChevronLeftIcon from "@tabler/icons/outline/chevron-left.svg";
import ChevronRightIcon from "@tabler/icons/outline/chevron-right.svg";
import type { ApiProperty } from "@/features/properties/live-api";
import {
  formatDashboardPrice,
  listFieldValue,
  normalizePropertyType,
  normalizeViewType,
  sizeToSpanClass,
  type ApiPropertyItem,
  type DashboardDefinition,
  type WidgetData,
} from "@/features/dashboard/spec";
import { jsonForScriptTag } from "@/lib/utils/json";
import { t } from "@/i18n";

interface Props {
  definition: DashboardDefinition;
  widgets: WidgetData[];
  /** "dashboard" | "list" - Listen-Ansichten rendern ohne Widget-Karten-Rahmen */
  viewType?: string | null;
  /** false = Trefferzahl-Zeile weglassen (die Filterleiste traegt sie bereits) */
  showListCount?: boolean;
}

const { definition, widgets, viewType = null, showListCount = true } = Astro.props;
const isListView = normalizeViewType(viewType) === "list";
const dataById = new Map(widgets.map((item) => [item.WidgetId, item]));

const detailHref = (item: ApiPropertyItem) => `/immobilien/angebote/${encodeURIComponent(item.Id)}/`;
const locationLine = (item: ApiPropertyItem) => [item.PostalCode, item.City].filter(Boolean).join(" ");
const areaOf = (item: ApiPropertyItem) => item.LivingAreaM2 ?? item.PlotAreaM2;
const metaLine = (item: ApiPropertyItem) =>
  [areaOf(item) ? `${areaOf(item)} m²` : null, item.Rooms ? `${item.Rooms} Zimmer` : null, item.SellerName?.trim() || null]
    .filter(Boolean)
    .join(" · ");
// Muss zur Client-Logik joinFieldValues/fillRowFields in DashboardApp passen
const joinFields = (item: ApiPropertyItem, fields: string[]) =>
  fields
    .filter((field) => !["foto", "titel", "preis", "ort"].includes(field))
    .map((field) => listFieldValue(item, field))
    .filter(Boolean)
    .join(" · ");
const rowRest = (fields: string[]) => fields.filter((field) => !["foto", "preis", "titel"].includes(field));
const rowLine1 = (item: ApiPropertyItem, fields: string[]) =>
  fields.includes("titel") ? item.Title : (listFieldValue(item, rowRest(fields)[0] ?? "") ?? item.Title);
const rowLine2 = (item: ApiPropertyItem, fields: string[]) => {
  const rest = rowRest(fields);
  const startIndex = fields.includes("titel") ? 0 : 1;
  return rest
    .slice(startIndex)
    .map((field) => listFieldValue(item, field))
    .filter(Boolean)
    .join(" · ");
};
const badge = (item: ApiPropertyItem) => {
  const type = normalizePropertyType(item.Type);
  return {
    text: type === "land" ? "Grundstück" : type === "foreclosure" ? "Zwangsversteigerung" : "Haus",
    class:
      type === "foreclosure"
        ? "bg-brand text-brand-foreground"
        : type === "land"
          ? "bg-type-grund text-white"
          : "bg-type-haus text-white",
  };
};
---

{
  definition.Widgets.map((widget) => {
    const data = dataById.get(widget.Id);
    const failed = !data || !data.Success;
    const items = data?.PropertyList?.Properties ?? [];
    const variant = widget.Kind === "new-listings" ? "list" : (widget.Options?.Variant ?? "grid");
    const fields = widget.Options?.Fields ?? null;
    // Listen-Ansicht: Trefferzahl + Startseiten-Paging (Client blaettert per ?Page=N)
    const listChrome = isListView && widget.Kind === "property-list" && !failed;
    const listTotal = data?.PropertyList?.Total ?? 0;
    const listPageSize = data?.PropertyList?.PageSize || items.length || 1;
    const listPageCount = Math.max(1, Math.ceil(listTotal / listPageSize));
    const listPage = data?.PropertyList?.Page ?? 0;
    return (
      <article
        class:list={[
          "min-w-0",
          !isListView && "rounded-lg border border-border bg-card shadow-sm",
          sizeToSpanClass(widget.Size),
        ]}
        data-dash-widget={widget.Kind}
      >
        {widget.Title && (
          <h3 class:list={[isListView ? "mb-3 text-base font-semibold" : "border-b border-border px-4 py-3 text-sm font-semibold"]}>
            {widget.Title}
          </h3>
        )}
        <div class:list={[!isListView && "p-4", isListView && "@container"]} data-w-body>
          {listChrome && showListCount && (
            <p class="mb-3">
              <span class="result-count">
                {t(listTotal === 1 ? "search.resultCountOne" : "search.resultCountMany", { count: listTotal })}
              </span>
            </p>
          )}
          {failed ? (
            <p class="py-6 text-center text-sm text-muted-foreground">{data?.Error || t("dash.widgetError")}</p>
          ) : widget.Kind === "stat-row" ? (
            <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5">
              {(data!.StatRow?.Tiles ?? []).map((tile) => (
                <div class="rounded-md border border-border bg-background px-4 py-3" data-dash-tile={tile.Key}>
                  <dt class="text-xs font-medium text-muted-foreground">{tile.Label}</dt>
                  <dd class="mt-1 text-xl font-bold">{tile.Value}</dd>
                </div>
              ))}
            </dl>
          ) : widget.Kind === "text-note" ? (
            <p class="text-sm leading-relaxed text-muted-foreground">{data!.TextNote?.Text ?? ""}</p>
          ) : widget.Kind === "price-chart" ? (
            data!.Chart ? (
              <figure class="m-0">
                <img class="dash-chart-light w-full" src={data!.Chart.ImageLight} alt={data!.Chart.AltText} />
                <img class="dash-chart-dark w-full" src={data!.Chart.ImageDark} alt={data!.Chart.AltText} />
                {data!.Chart.Caption && (
                  <figcaption class="mt-1 text-xs text-muted-foreground">{data!.Chart.Caption}</figcaption>
                )}
              </figure>
            ) : (
              <p class="py-6 text-center text-sm text-muted-foreground">{t("dash.widgetEmpty")}</p>
            )
          ) : widget.Kind === "map" ? (
            <div>
              <div class="h-80 overflow-hidden rounded-md border border-border bg-muted" data-w-map data-dash-ssr-map>
                <script
                  is:inline
                  type="application/json"
                  data-dash-ssr-pins
                  set:html={jsonForScriptTag(data!.Map?.Pins ?? [])}
                />
              </div>
              <p class="mt-2 text-xs text-muted-foreground">
                {(data!.Map?.Pins?.length ?? 0) > 0
                  ? t("dash.mapTotal", { count: data!.Map?.Total ?? 0 })
                  : t("dash.mapNone")}
              </p>
            </div>
          ) : items.length === 0 ? (
            <p class="py-6 text-center text-sm text-muted-foreground">{t("dash.widgetEmpty")}</p>
          ) : widget.Kind === "highlight" ? (
            <a class="group flex flex-col gap-0 overflow-hidden sm:flex-row" href={detailHref(items[0])} data-detail-id={items[0].Id}>
              <span class="relative block h-48 shrink-0 overflow-hidden bg-muted sm:h-auto sm:w-72">
                <img
                  class="h-full w-full object-cover"
                  src={items[0].ImageUrls?.[0] || "/kein-foto.svg"}
                  alt={items[0].Title}
                  loading="lazy"
                  decoding="async"
                  data-fallback-image="/kein-foto.svg"
                />
                <span class:list={["absolute left-3 top-3 rounded-full px-3 py-1.5 text-xs font-bold", badge(items[0]).class]}>
                  {badge(items[0]).text}
                </span>
              </span>
              <span class="flex min-w-0 flex-1 flex-col justify-center gap-1 p-4">
                <span class="text-lg font-semibold group-hover:underline">{items[0].Title}</span>
                <span class="text-sm text-muted-foreground">{locationLine(items[0])}</span>
                <span class="mt-1 text-2xl font-bold text-price">{formatDashboardPrice(items[0].Price)}</span>
                <span class="mt-1 text-xs text-muted-foreground">
                  {fields ? joinFields(items[0], fields) : metaLine(items[0])}
                </span>
              </span>
            </a>
          ) : variant === "grid" ? (
            <div>
              <div class:list={[isListView ? "grid gap-4 @2xl:grid-cols-2 @6xl:grid-cols-3" : "grid gap-4 sm:grid-cols-2"]}>
                {items.map((item) =>
                  fields ? (
                    // Feldauswahl: eigene Karte mit exakt den gewuenschten Werten
                    // (Client-Pendant: property-card-Template + applyFieldsToCard)
                    <article
                      class="property-card group flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lg"
                      data-property-card
                      data-detail-id={item.Id}
                    >
                      <div class="relative h-44 overflow-hidden bg-muted">
                        <a class="block h-full" href={detailHref(item)}>
                          <img
                            class="h-full w-full object-cover"
                            src={item.ImageUrls?.[0] || "/kein-foto.svg"}
                            alt={item.Title}
                            loading="lazy"
                            decoding="async"
                            data-fallback-image="/kein-foto.svg"
                          />
                        </a>
                        <span class:list={["absolute left-3 top-3 rounded-full px-3 py-1.5 text-xs font-bold", badge(item).class]}>
                          {badge(item).text}
                        </span>
                      </div>
                      <div class="grid grid-cols-[1fr_auto] gap-3 p-3">
                        <div class="min-w-0">
                          <h4 class="truncate text-base font-semibold">
                            <a class="hover:underline" href={detailHref(item)}>{item.Title}</a>
                          </h4>
                          {fields.includes("ort") && <p class="mt-0.5 truncate text-sm font-medium">{locationLine(item)}</p>}
                        </div>
                        {fields.includes("preis") && (
                          <p class="whitespace-nowrap text-right text-xl font-bold leading-none text-price">
                            {formatDashboardPrice(item.Price)}
                          </p>
                        )}
                      </div>
                      <p class="mt-auto border-t border-border bg-muted/50 px-3 py-2 text-xs text-muted-foreground">
                        {joinFields(item, fields)}
                      </p>
                    </article>
                  ) : (
                    <ApiPropertyCard property={item as unknown as ApiProperty} />
                  ),
                )}
              </div>
              {!isListView && (data!.PropertyList?.Total ?? 0) > items.length && (
                <p class="mt-3 text-xs text-muted-foreground">
                  {t("dash.listTotal", { count: data!.PropertyList?.Total ?? 0 })}
                </p>
              )}
            </div>
          ) : (
            <div>
              <div class="flex flex-col gap-2">
                {items.map((item) =>
                  fields ? (
                    // Feld-gesteuerte Zeile (Client-Pendant: property-row-fields-Template)
                    <a
                      class="group flex items-center gap-3 rounded-md border border-border bg-background p-2 transition-colors hover:bg-accent"
                      href={detailHref(item)}
                      data-detail-id={item.Id}
                    >
                      {fields.includes("foto") && (
                        <img
                          class="h-14 w-20 shrink-0 rounded object-cover"
                          src={item.ImageUrls?.[0] || "/kein-foto.svg"}
                          alt={item.Title}
                          loading="lazy"
                          decoding="async"
                          data-fallback-image="/kein-foto.svg"
                        />
                      )}
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-semibold">{rowLine1(item, fields)}</span>
                        <span class="block truncate text-xs text-muted-foreground">{rowLine2(item, fields)}</span>
                      </span>
                      {fields.includes("preis") && (
                        <span class="shrink-0 text-sm font-bold text-price">{formatDashboardPrice(item.Price)}</span>
                      )}
                    </a>
                  ) : variant === "minimal" ? (
                    <a
                      class="flex items-baseline justify-between gap-3 rounded-md px-2 py-1.5 transition-colors hover:bg-accent"
                      href={detailHref(item)}
                      data-detail-id={item.Id}
                    >
                      <span class="min-w-0 flex-1">
                        <span class="truncate text-sm font-medium">{item.Title}</span>
                        <span class="ml-2 text-xs text-muted-foreground">{locationLine(item)}</span>
                      </span>
                      <span class="flex shrink-0 items-baseline gap-2">
                        {areaOf(item) && <span class="text-xs text-muted-foreground">{areaOf(item)} m²</span>}
                        <span class="text-sm font-bold text-price">{formatDashboardPrice(item.Price)}</span>
                      </span>
                    </a>
                  ) : (
                    <a
                      class="group flex items-center gap-3 rounded-md border border-border bg-background p-2 transition-colors hover:bg-accent"
                      href={detailHref(item)}
                      data-detail-id={item.Id}
                    >
                      <img
                        class="h-14 w-20 shrink-0 rounded object-cover"
                        src={item.ImageUrls?.[0] || "/kein-foto.svg"}
                        alt={item.Title}
                        loading="lazy"
                        decoding="async"
                        data-fallback-image="/kein-foto.svg"
                      />
                      <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-semibold">{item.Title}</span>
                        <span class="block truncate text-xs text-muted-foreground">{locationLine(item)}</span>
                      </span>
                      <span class="shrink-0 text-right">
                        <span class="block text-sm font-bold text-price">{formatDashboardPrice(item.Price)}</span>
                        {areaOf(item) && <span class="block text-xs text-muted-foreground">{areaOf(item)} m²</span>}
                      </span>
                    </a>
                  ),
                )}
              </div>
              {!isListView && (data!.PropertyList?.Total ?? 0) > items.length && (
                <p class="mt-3 text-xs text-muted-foreground">
                  {t("dash.listTotal", { count: data!.PropertyList?.Total ?? 0 })}
                </p>
              )}
            </div>
          )}
          {listChrome && items.length > 0 && listPageCount > 1 && (
            <nav
              class="mt-5 flex items-center justify-center gap-4 border-t border-border pt-4"
              aria-label={t("search.paginationLabel")}
              data-list-pagination
              data-page={listPage}
              data-page-count={listPageCount}
            >
              <button
                type="button"
                class="grid size-10 place-items-center rounded-md border border-border bg-background text-foreground disabled:cursor-not-allowed disabled:opacity-40"
                aria-label={t("search.pagePrev")}
                disabled={listPage <= 0}
                data-page-prev
              >
                <ChevronLeftIcon class="size-5" aria-hidden="true" />
              </button>
              <span class="min-w-28 text-center text-sm font-medium text-muted-foreground" aria-live="polite" data-pagination-info>
                {t("search.pageOf", { current: listPage + 1, total: listPageCount })}
              </span>
              <button
                type="button"
                class="grid size-10 place-items-center rounded-md border border-border bg-background text-foreground disabled:cursor-not-allowed disabled:opacity-40"
                aria-label={t("search.pageNext")}
                disabled={listPage >= listPageCount - 1}
                data-page-next
              >
                <ChevronRightIcon class="size-5" aria-hidden="true" />
              </button>
            </nav>
          )}
        </div>
      </article>
    );
  })
}
