---
/**
 * "Meine Übersicht": KI-generiertes, personalisiertes Dashboard.
 *
 * Server-Driven UI: Die API liefert eine validierte DashboardDefinition
 * (Widget-Komposition) plus anzeigefertige Widget-Daten — dieses Island rendert
 * sie nur noch. Markup der Widgets lebt in <template>-Elementen (bleibt im
 * Designsystem, kein DOM-Bau in JS-Strings); das Script klont und befüllt.
 *
 * Auth wie UserListPage: SSR kennt den Nutzer nicht (localStorage-Session),
 * AuthGate zeigt Gästen das Login-Panel, das Script bootet nur mit Token.
 */
import AuthGate from "@/components/app/AuthGate.astro";
import DashboardSsr from "@/components/dashboard/DashboardSsr.astro";
import LayoutDashboardIcon from "@tabler/icons/outline/layout-dashboard.svg";
import SparklesIcon from "@tabler/icons/outline/sparkles.svg";
import ArrowBackIcon from "@tabler/icons/outline/arrow-back-up.svg";
import PencilIcon from "@tabler/icons/outline/pencil.svg";
import TrashIcon from "@tabler/icons/outline/trash.svg";
import PlusIcon from "@tabler/icons/outline/plus.svg";
import XIcon from "@tabler/icons/outline/x.svg";
import { normalizeStatus } from "@/features/dashboard/spec";
import type { DashboardSsrState } from "@/features/dashboard/ssr-api";
import { jsonForScriptTag } from "@/lib/utils/json";
import { t } from "@/i18n";

interface Props {
  /**
   * SSR-Erstauslieferung (Token-Cookie-Spiegel): Liste + aktive Uebersicht +
   * Widget-Daten bereits serverseitig beschafft. null = wie bisher rein
   * clientseitig rendern (Gast, abgelaufenes Cookie, API-Fehler).
   */
  ssr?: DashboardSsrState | null;
}

const { ssr = null } = Astro.props;
const ssrDashboard = ssr?.Dashboard ?? null;
const ssrStatus = ssrDashboard ? normalizeStatus(ssrDashboard.Status) : null;
const ssrShowView = ssrStatus === "finished" && !!ssrDashboard?.Definition && !!ssr?.Widgets;
const ssrGenerating = ssrStatus === "queued" || ssrStatus === "inProgress";
const ssrFailed = ssrStatus === "failed";
const ssrShowCreate = !!ssr && (ssr.Summaries?.length ?? 0) === 0;
const ssrIntro = ssrShowView ? (ssrDashboard?.Definition?.Intro?.trim() ?? null) : null;
const ssrWishes = ssrShowView ? (ssrDashboard?.Definition?.UnsupportedWishes ?? []).filter(Boolean) : [];
const tabClassActive = "min-h-9 rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground";
const tabClassInactive =
  "min-h-9 rounded-md border border-border px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground";
---

<div class="py-6 sm:py-8">
  <h1 class="sr-only">{t("dash.title")}</h1>
  <AuthGate title={t("dash.authTitle")} description={t("dash.authText")} assumeAuthenticated={!!ssr}>
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" data-dash-app>
      {/* Übersichts-Wechsler (erst sichtbar, wenn mindestens eine Übersicht existiert) */}
      <div
        class:list={["mb-6 flex-wrap items-center gap-2", (ssr?.Summaries?.length ?? 0) > 0 ? "flex" : "hidden"]}
        data-dash-toolbar
      >
        <span class="mr-1 text-sm font-medium text-muted-foreground">{t("dash.listLabel")}</span>
        <div class="flex flex-wrap gap-2" data-dash-tabs>
          {(ssr?.Summaries ?? []).map((summary) => (
            <button
              type="button"
              data-dash-tab={summary.Id}
              class={summary.Id === ssrDashboard?.Id ? tabClassActive : tabClassInactive}
            >
              {summary.Title || t("dash.title")}
            </button>
          ))}
        </div>
        <button
          type="button"
          class="inline-flex min-h-9 items-center gap-1.5 rounded-md border border-dashed border-border px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          data-dash-new
        >
          <PlusIcon class="size-4" aria-hidden="true" />
          {t("dash.newButton")}
        </button>
      </div>

      {/* Erstellen (Hero bei 0 Übersichten bzw. nach "Neue Übersicht") */}
      <div class:list={["mx-auto max-w-2xl", !ssrShowCreate && "hidden"]} data-dash-create>
        <div class="rounded-lg border border-border bg-card p-6 shadow-sm sm:p-8">
          <div class="mb-4 flex items-center gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary">
              <LayoutDashboardIcon class="size-6" aria-hidden="true" />
            </span>
            <div>
              <h2 class="text-lg font-semibold">{t("dash.createTitle")}</h2>
              <p class="text-sm text-muted-foreground">{t("dash.createText")}</p>
            </div>
          </div>
          <textarea
            class="min-h-28 w-full resize-y rounded-md border border-border bg-background px-3 py-2 text-sm"
            maxlength="1000"
            placeholder={t("dash.createPlaceholder")}
            data-dash-create-input></textarea>
          <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-muted-foreground">{t("dash.examplesLabel")}</span>
            {[t("dash.example1"), t("dash.example2"), t("dash.example3")].map((example) => (
              <button
                type="button"
                class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                data-dash-example
              >
                {example}
              </button>
            ))}
          </div>
          <p class="mt-3 hidden text-sm font-medium text-destructive" data-dash-create-error></p>
          <div class="mt-4 flex items-center justify-end gap-3">
            <button
              type="button"
              class="hidden min-h-10 rounded-md px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent"
              data-dash-create-cancel
            >
              Abbrechen
            </button>
            <button
              type="button"
              class="inline-flex min-h-10 items-center gap-2 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-50"
              data-dash-create-submit
            >
              <SparklesIcon class="size-4.5" aria-hidden="true" />
              {t("dash.createSubmit")}
            </button>
          </div>
        </div>
      </div>

      {/* Fortschritt (Polling) */}
      <div class:list={["mx-auto max-w-2xl", !ssrGenerating && "hidden"]} data-dash-progress>
        <div class="flex min-h-[40vh] flex-col items-center justify-center gap-4 rounded-lg border border-border bg-card p-8 text-center shadow-sm">
          <span class="dash-spinner" aria-hidden="true"></span>
          <p class="text-sm font-medium text-muted-foreground" data-dash-progress-text aria-live="polite">
            {t("dash.progressInProgress")}
          </p>
        </div>
      </div>

      {/* Fehlschlag */}
      <div class:list={["mx-auto max-w-2xl", !ssrFailed && "hidden"]} data-dash-failed>
        <div class="rounded-lg border border-border bg-card p-6 text-center shadow-sm sm:p-8">
          <h2 class="text-lg font-semibold">{t("dash.failedTitle")}</h2>
          <p class="mt-2 text-sm text-muted-foreground" data-dash-failed-text>{ssrFailed ? (ssrDashboard?.Error ?? "") : ""}</p>
          <p class="mt-4 text-sm text-muted-foreground">{t("dash.retryHint")}</p>
        </div>
      </div>

      {/* Die gerenderte Übersicht */}
      <div class:list={[!(ssrShowView || ssrFailed) && "hidden"]} data-dash-view>
        <header class="mb-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="text-xl font-bold sm:text-2xl" data-dash-title>{ssrDashboard?.Title ?? ""}</h2>
              <p class:list={["mt-1 text-sm text-muted-foreground", !ssrIntro && "hidden"]} data-dash-intro>{ssrIntro ?? ""}</p>
            </div>
            <div class="flex shrink-0 items-center gap-1.5">
              <button
                type="button"
                class:list={[
                  ssrShowView && ssrDashboard?.CanRevert ? "inline-flex" : "hidden",
                  "min-h-9 items-center gap-1.5 rounded-md border border-border px-3 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground",
                ]}
                data-dash-revert
                title={t("dash.revert")}
              >
                <ArrowBackIcon class="size-4" aria-hidden="true" />
                {t("dash.revert")}
              </button>
              <button
                type="button"
                class="grid size-9 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                data-dash-rename
                aria-label={t("dash.rename")}
                title={t("dash.rename")}
              >
                <PencilIcon class="size-4" aria-hidden="true" />
              </button>
              <button
                type="button"
                class="grid min-h-9 place-items-center rounded-md border border-border px-3 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-destructive"
                data-dash-delete
              >
                <TrashIcon class="size-4" aria-hidden="true" />
              </button>
            </div>
          </div>
          <div class="mt-2 hidden items-center gap-2" data-dash-rename-row>
            <input
              type="text"
              maxlength="120"
              class="min-h-9 w-full max-w-sm rounded-md border border-border bg-background px-3 text-sm"
              data-dash-rename-input
            />
            <button
              type="button"
              class="min-h-9 rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground"
              data-dash-rename-save
            >
              {t("dash.renameSave")}
            </button>
          </div>
        </header>

        {/* Nicht erfüllbare Wünsche — ehrlich statt erfunden */}
        <div
          class:list={["mb-5 rounded-md border border-border bg-muted px-4 py-3 text-sm", ssrWishes.length === 0 && "hidden"]}
          data-dash-unsupported
        >
          <p class="font-medium">{t("dash.unsupportedTitle")}</p>
          <ul class="mt-1 list-inside list-disc text-muted-foreground" data-dash-unsupported-list>
            {ssrWishes.map((wish) => <li>{wish}</li>)}
          </ul>
        </div>

        <div class="grid grid-cols-1 gap-4 lg:grid-cols-12" data-dash-grid>
          {ssrShowView && ssrDashboard?.Definition && ssr?.Widgets && (
            <DashboardSsr definition={ssrDashboard.Definition} widgets={ssr.Widgets} />
          )}
        </div>

        {/* Verfeinerungs-Zeile ("Wunsch an die KI") */}
        <div class="mt-6 rounded-lg border border-border bg-card p-4 shadow-sm">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center" data-dash-refine-form>
            <div class="flex min-w-0 flex-1 items-center gap-2">
              <SparklesIcon class="size-5 shrink-0 text-primary" aria-hidden="true" />
              <input
                type="text"
                maxlength="1000"
                class="min-h-10 w-full rounded-md border border-border bg-background px-3 text-sm"
                placeholder={t("dash.refinePlaceholder")}
                data-dash-refine-input
              />
            </div>
            <button
              type="button"
              class="inline-flex min-h-10 shrink-0 items-center justify-center gap-2 rounded-md bg-primary px-5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90 disabled:opacity-50"
              data-dash-refine-submit
            >
              {t("dash.refineSubmit")}
            </button>
          </div>
          {/* Waehrend der Runde ersetzt dieser Zustand das Formular - genau dort,
              wo der Nutzer gerade abgeschickt hat, sieht er den Fortschritt */}
          <div class="hidden min-h-10 items-center gap-3" data-dash-refine-busy aria-live="polite">
            <span class="dash-spinner dash-spinner-sm" aria-hidden="true"></span>
            <p class="text-sm font-medium text-muted-foreground">{t("dash.progressRefine")}</p>
          </div>
          <p class="mt-2 hidden text-sm font-medium text-destructive" data-dash-refine-error></p>
        </div>
      </div>

      <p class="mx-auto mt-6 hidden max-w-2xl rounded-md border border-border bg-muted px-4 py-3 text-center text-sm font-medium" data-dash-global-error></p>

      {/* SSR-Zustand fuers Island: uebernimmt statt neu zu fetchen (jsonForScriptTag escapet gegen Stored-XSS) */}
      {ssr && <script is:inline type="application/json" data-dash-ssr-state set:html={jsonForScriptTag(ssr)} />}

      {/* Personalisierte Detail-Overlay: Aufbau (Sektionen + Fakten-Felder) folgt
          definition.Detail; die oeffentliche Detailseite bleibt unberuehrt und ist
          unten verlinkt. Vor der Hydration navigieren Klicks ganz normal dorthin. */}
      <div class="fixed inset-0 z-50 hidden" data-dash-detail>
        <div class="absolute inset-0 bg-black/50" data-dash-detail-backdrop></div>
        <aside
          class="absolute inset-x-0 bottom-0 top-12 flex flex-col overflow-hidden rounded-t-xl border border-border bg-background shadow-2xl sm:inset-y-0 sm:left-auto sm:right-0 sm:w-[600px] sm:rounded-none sm:border-y-0 sm:border-r-0"
          role="dialog"
          aria-modal="true"
          aria-label={t("dash.detailAria")}
        >
          <div class="flex shrink-0 items-center justify-between gap-3 border-b border-border px-4 py-3">
            <h3 class="min-w-0 truncate text-base font-semibold" data-dash-detail-title></h3>
            <button
              type="button"
              class="grid size-9 shrink-0 place-items-center rounded-md border border-border text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
              data-dash-detail-close
              aria-label={t("dash.detailClose")}
            >
              <XIcon class="size-4" aria-hidden="true" />
            </button>
          </div>
          <div class="min-h-0 flex-1 overflow-y-auto p-4" data-dash-detail-body></div>
          <div class="flex shrink-0 items-center justify-end border-t border-border px-4 py-3">
            <a class="text-sm font-medium text-primary hover:underline" data-dash-detail-full>{t("dash.detailFullLink")}</a>
          </div>
        </aside>
      </div>
    </section>
  </AuthGate>
</div>

{/* ---------- Widget-Templates (das Script klont und befüllt) ---------- */}

<template data-dash-tpl="frame">
  <article class="min-w-0 rounded-lg border border-border bg-card shadow-sm">
    <h3 class="hidden border-b border-border px-4 py-3 text-sm font-semibold" data-w-title></h3>
    <div class="p-4" data-w-body></div>
  </article>
</template>

<template data-dash-tpl="stat-row">
  <dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-5" data-w-tiles></dl>
</template>

<template data-dash-tpl="stat-tile">
  <div class="rounded-md border border-border bg-background px-4 py-3">
    <dt class="text-xs font-medium text-muted-foreground" data-tile-label></dt>
    <dd class="mt-1 text-xl font-bold" data-tile-value></dd>
  </div>
</template>

<template data-dash-tpl="property-grid">
  <div class="grid gap-4 sm:grid-cols-2" data-w-items></div>
</template>

<template data-dash-tpl="property-rows">
  <div class="flex flex-col gap-2" data-w-items></div>
</template>

<template data-dash-tpl="property-card">
  <article class="property-card group flex flex-col overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lg" data-property-card>
    <div class="relative h-44 overflow-hidden bg-muted">
      <a class="block h-full" data-card-link>
        <img class="h-full w-full object-cover" loading="lazy" decoding="async" alt="" data-card-image />
      </a>
      <span class="absolute left-3 top-3 rounded-full px-3 py-1.5 text-xs font-bold" data-card-badge></span>
    </div>
    <div class="grid grid-cols-[1fr_auto] gap-3 p-3">
      <div class="min-w-0">
        <h4 class="truncate text-base font-semibold">
          <a class="hover:underline" data-card-link data-card-title></a>
        </h4>
        <p class="mt-0.5 truncate text-sm font-medium" data-card-location></p>
      </div>
      <p class="whitespace-nowrap text-right text-xl font-bold leading-none text-price" data-card-price></p>
    </div>
    <p class="mt-auto border-t border-border bg-muted/50 px-3 py-2 text-xs text-muted-foreground" data-card-meta></p>
  </article>
</template>

<template data-dash-tpl="property-row">
  <a class="group flex items-center gap-3 rounded-md border border-border bg-background p-2 transition-colors hover:bg-accent" data-card-link>
    <img class="h-14 w-20 shrink-0 rounded object-cover" loading="lazy" decoding="async" alt="" data-card-image />
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-semibold" data-card-title></span>
      <span class="block truncate text-xs text-muted-foreground" data-card-location></span>
    </span>
    <span class="shrink-0 text-right">
      <span class="block text-sm font-bold text-price" data-card-price></span>
      <span class="block text-xs text-muted-foreground" data-card-area></span>
    </span>
  </a>
</template>

<template data-dash-tpl="property-row-minimal">
  <a class="flex items-baseline justify-between gap-3 rounded-md px-2 py-1.5 transition-colors hover:bg-accent" data-card-link>
    <span class="min-w-0 flex-1">
      <span class="truncate text-sm font-medium" data-card-title></span>
      <span class="ml-2 text-xs text-muted-foreground" data-card-location></span>
    </span>
    <span class="flex shrink-0 items-baseline gap-2">
      <span class="text-xs text-muted-foreground" data-card-area></span>
      <span class="text-sm font-bold text-price" data-card-price></span>
    </span>
  </a>
</template>

<template data-dash-tpl="highlight">
  <a class="group flex flex-col gap-0 overflow-hidden sm:flex-row" data-card-link>
    <span class="relative block h-48 shrink-0 overflow-hidden bg-muted sm:h-auto sm:w-72">
      <img class="h-full w-full object-cover" loading="lazy" decoding="async" alt="" data-card-image />
      <span class="absolute left-3 top-3 rounded-full px-3 py-1.5 text-xs font-bold" data-card-badge></span>
    </span>
    <span class="flex min-w-0 flex-1 flex-col justify-center gap-1 p-4">
      <span class="text-lg font-semibold group-hover:underline" data-card-title></span>
      <span class="text-sm text-muted-foreground" data-card-location></span>
      <span class="mt-1 text-2xl font-bold text-price" data-card-price></span>
      <span class="mt-1 text-xs text-muted-foreground" data-card-meta></span>
    </span>
  </a>
</template>

<template data-dash-tpl="map">
  <div>
    <div class="h-80 overflow-hidden rounded-md border border-border bg-muted" data-w-map></div>
    <p class="mt-2 text-xs text-muted-foreground" data-w-map-total></p>
  </div>
</template>

<template data-dash-tpl="text-note">
  <p class="text-sm leading-relaxed text-muted-foreground" data-w-text></p>
</template>

<template data-dash-tpl="property-row-fields">
  <a class="group flex items-center gap-3 rounded-md border border-border bg-background p-2 transition-colors hover:bg-accent" data-card-link>
    <img class="h-14 w-20 shrink-0 rounded object-cover" loading="lazy" decoding="async" alt="" data-card-image hidden />
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-semibold" data-card-line1></span>
      <span class="block truncate text-xs text-muted-foreground" data-card-line2></span>
    </span>
    <span class="shrink-0 text-sm font-bold text-price" data-card-price hidden></span>
  </a>
</template>

<template data-dash-tpl="detail-fact">
  <div class="flex items-baseline justify-between gap-4 border-b border-border/60 py-2 last:border-0">
    <dt class="shrink-0 text-sm text-muted-foreground" data-fact-label></dt>
    <dd class="min-w-0 text-right text-sm font-semibold" data-fact-value></dd>
  </div>
</template>

<template data-dash-tpl="detail-section-title">
  <h4 class="mb-2 mt-6 text-sm font-semibold first:mt-0"></h4>
</template>

<template data-dash-tpl="price-chart">
  <figure class="m-0">
    <img class="dash-chart-light w-full" alt="" data-chart-light />
    <img class="dash-chart-dark w-full" alt="" data-chart-dark />
    <figcaption class="mt-1 text-xs text-muted-foreground" data-chart-caption></figcaption>
  </figure>
</template>

<template data-dash-tpl="widget-error">
  <p class="py-6 text-center text-sm text-muted-foreground" data-w-error></p>
</template>

<style>
  .dash-spinner {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    animation: dash-spin 0.9s linear infinite;
  }
  .dash-spinner-sm {
    width: 1.25rem;
    height: 1.25rem;
    border-width: 2px;
  }
  @keyframes dash-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dash-spinner { animation-duration: 2.5s; }
  }
</style>

<style is:global>
  /* Server-gerenderte Diagramme: je Theme die passende Bildvariante zeigen.
     Global, weil die html.dark-Klasse ausserhalb des Komponenten-Scopes lebt. */
  .dash-chart-dark { display: none; }
  .dark .dash-chart-light { display: none; }
  .dark .dash-chart-dark { display: block; }
</style>

<script>
  import { t } from "@/i18n";
  import { readDebugApiUrl } from "@/lib/utils/debug-host";
  import { readAccessToken } from "@/lib/utils/access-token";
  import {
    normalizeStatus,
    normalizePropertyType,
    sizeToSpanClass,
    formatDashboardPrice,
    listFieldValue,
    detailFieldRow,
    DEFAULT_DETAIL_SECTIONS,
    DEFAULT_DETAIL_FIELDS,
    type ApiPropertyDetail,
    type ApiPropertyItem,
    type DashboardResponse,
    type DashboardSummary,
    type DashboardWidget,
    type WidgetData,
  } from "@/features/dashboard/spec";

  const app = document.querySelector<HTMLElement>("[data-dash-app]");

  if (app) {
    const API_BASE_URL = readDebugApiUrl() || import.meta.env.PUBLIC_API_BASE_URL || "https://api.heimatplatz.at";
    const POLL_INTERVAL_MS = 3500;
    const POLL_TIMEOUT_MS = 120_000;

    const q = <T extends HTMLElement>(selector: string) => app.querySelector<T>(selector)!;
    const toolbar = q("[data-dash-toolbar]");
    const tabs = q("[data-dash-tabs]");
    const newButton = q<HTMLButtonElement>("[data-dash-new]");
    const createPanel = q("[data-dash-create]");
    const createInput = q<HTMLTextAreaElement>("[data-dash-create-input]");
    const createSubmit = q<HTMLButtonElement>("[data-dash-create-submit]");
    const createCancel = q<HTMLButtonElement>("[data-dash-create-cancel]");
    const createError = q("[data-dash-create-error]");
    const progressPanel = q("[data-dash-progress]");
    const progressText = q("[data-dash-progress-text]");
    const failedPanel = q("[data-dash-failed]");
    const failedText = q("[data-dash-failed-text]");
    const view = q("[data-dash-view]");
    const titleEl = q("[data-dash-title]");
    const introEl = q("[data-dash-intro]");
    const unsupportedPanel = q("[data-dash-unsupported]");
    const unsupportedList = q("[data-dash-unsupported-list]");
    const grid = q("[data-dash-grid]");
    const refineInput = q<HTMLInputElement>("[data-dash-refine-input]");
    const refineSubmit = q<HTMLButtonElement>("[data-dash-refine-submit]");
    const refineForm = q("[data-dash-refine-form]");
    const refineBusy = q("[data-dash-refine-busy]");
    const refineError = q("[data-dash-refine-error]");
    const revertButton = q<HTMLButtonElement>("[data-dash-revert]");
    const renameButton = q<HTMLButtonElement>("[data-dash-rename]");
    const renameRow = q("[data-dash-rename-row]");
    const renameInput = q<HTMLInputElement>("[data-dash-rename-input]");
    const renameSave = q<HTMLButtonElement>("[data-dash-rename-save]");
    const deleteButton = q<HTMLButtonElement>("[data-dash-delete]");
    const globalError = q("[data-dash-global-error]");

    const template = (name: string) =>
      document.querySelector<HTMLTemplateElement>(`[data-dash-tpl="${name}"]`)!;
    const clone = (name: string) => template(name).content.firstElementChild!.cloneNode(true) as HTMLElement;

    let summaries: DashboardSummary[] = [];
    let activeId: string | null = null;
    let current: DashboardResponse | null = null;
    let pollTimer: number | undefined;
    let pollStartedAt = 0;
    let refining = false;
    let busy = false;

    // ---------- API ----------

    async function apiFetch<T>(path: string, init?: RequestInit): Promise<T> {
      const token = readAccessToken();
      if (!token) throw new Error(t("dash.sessionExpired"));
      const response = await fetch(`${API_BASE_URL}${path}`, {
        ...init,
        headers: {
          Authorization: `Bearer ${token}`,
          ...(init?.body ? { "Content-Type": "application/json" } : {}),
          ...init?.headers,
        },
      });
      if (response.status === 401) throw new Error(t("dash.sessionExpired"));
      if (!response.ok) {
        let message = t("dash.genericError");
        try {
          const problem = (await response.json()) as { detail?: string; title?: string };
          message = problem.detail || problem.title || message;
        } catch {
          /* Fehlertext bleibt generisch */
        }
        throw new Error(message);
      }
      return (await response.json()) as T;
    }

    // ---------- Panels ----------

    type Panel = "create" | "progress" | "failed" | "view" | "none";
    function showPanel(panel: Panel) {
      createPanel.classList.toggle("hidden", panel !== "create");
      progressPanel.classList.toggle("hidden", panel !== "progress");
      failedPanel.classList.toggle("hidden", panel !== "failed");
      view.classList.toggle("hidden", panel !== "view" && panel !== "failed");
      // Beim Fehlschlag bleibt die Verfeinerungs-Zeile nutzbar (neuer Anlauf),
      // aber Kopf/Grid der alten Ansicht sollen nicht halb leer herumstehen.
      if (panel === "failed") {
        grid.replaceChildren();
        unsupportedPanel.classList.add("hidden");
      }
      globalError.classList.add("hidden");
    }

    function showGlobalError(message: string) {
      globalError.textContent = message;
      globalError.classList.remove("hidden");
    }

    // ---------- Übersichts-Wechsler ----------

    function renderTabs() {
      tabs.replaceChildren(
        ...summaries.map((summary) => {
          const button = document.createElement("button");
          button.type = "button";
          button.dataset.dashTab = summary.Id;
          button.textContent = summary.Title || t("dash.title");
          button.className =
            summary.Id === activeId
              ? "min-h-9 rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground"
              : "min-h-9 rounded-md border border-border px-3 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground";
          button.addEventListener("click", () => {
            if (summary.Id !== activeId) void selectDashboard(summary.Id);
          });
          return button;
        }),
      );
      toolbar.classList.toggle("hidden", summaries.length === 0);
      toolbar.classList.toggle("flex", summaries.length > 0);
    }

    function syncUrl() {
      const url = new URL(window.location.href);
      if (activeId) url.searchParams.set("id", activeId);
      else url.searchParams.delete("id");
      window.history.replaceState(null, "", url);
    }

    // ---------- Laden + Polling ----------

    async function loadList(preferredId?: string | null) {
      const result = await apiFetch<{ Dashboards: DashboardSummary[] }>("/api/dashboards");
      summaries = result.Dashboards ?? [];
      if (summaries.length === 0) {
        activeId = null;
        renderTabs();
        syncUrl();
        createCancel.classList.add("hidden");
        showPanel("create");
        return;
      }
      const target =
        summaries.find((item) => item.Id === preferredId) ?? summaries[0];
      await selectDashboard(target.Id);
    }

    async function selectDashboard(id: string) {
      stopPolling();
      activeId = id;
      renderTabs();
      syncUrl();
      await loadDashboard();
    }

    async function loadDashboard() {
      if (!activeId) return;
      const dashboard = await apiFetch<DashboardResponse>(`/api/dashboards/${activeId}`);
      current = dashboard;
      const summary = summaries.find((item) => item.Id === dashboard.Id);
      if (summary && dashboard.Title) summary.Title = dashboard.Title;
      renderTabs();

      const status = normalizeStatus(dashboard.Status);
      if (status === "queued" || status === "inProgress") {
        progressText.textContent =
          refining && dashboard.Definition
            ? t("dash.progressRefine")
            : status === "queued"
              ? t("dash.progressQueued")
              : t("dash.progressInProgress");
        // Während einer Verfeinerung bleibt die alte Ansicht sichtbar,
        // nur die Aktionen sind gesperrt
        if (refining && dashboard.Definition) {
          setRefineBusy(true);
        } else {
          showPanel("progress");
        }
        schedulePoll();
        return;
      }

      stopPolling();
      refining = false;
      setRefineBusy(false);

      if (status === "failed") {
        failedText.textContent = dashboard.Error || t("dash.genericError");
        showPanel("failed");
        renderHeader(dashboard);
        return;
      }

      renderHeader(dashboard);
      showPanel("view");
      await renderData(dashboard);
    }

    function schedulePoll() {
      if (!pollStartedAt) pollStartedAt = Date.now();
      if (Date.now() - pollStartedAt > POLL_TIMEOUT_MS) {
        progressText.textContent = t("dash.progressTimeout");
      }
      pollTimer = window.setTimeout(() => {
        void loadDashboard().catch((error: Error) => showGlobalError(error.message));
      }, POLL_INTERVAL_MS);
    }

    function stopPolling() {
      if (pollTimer) window.clearTimeout(pollTimer);
      pollTimer = undefined;
      pollStartedAt = 0;
    }

    function setRefineBusy(value: boolean) {
      // Deutlich sichtbar: Formular wird durch Spinner+Text ersetzt (genau dort,
      // wo abgeschickt wurde), die alte Ansicht bleibt gedimmt stehen
      refineForm.classList.toggle("hidden", value);
      refineForm.classList.toggle("flex", !value);
      refineBusy.classList.toggle("hidden", !value);
      refineBusy.classList.toggle("flex", value);
      grid.classList.toggle("opacity-60", value);
      grid.classList.toggle("pointer-events-none", value);
      refineSubmit.disabled = value;
      refineInput.disabled = value;
      for (const button of [revertButton, renameButton, deleteButton]) {
        button.disabled = value;
        button.classList.toggle("opacity-50", value);
      }
    }

    // ---------- Rendern ----------

    function renderHeader(dashboard: DashboardResponse) {
      titleEl.textContent = dashboard.Title || t("dash.title");
      const intro = dashboard.Definition?.Intro?.trim();
      introEl.textContent = intro ?? "";
      introEl.classList.toggle("hidden", !intro);
      revertButton.classList.toggle("hidden", !dashboard.CanRevert);
      revertButton.classList.toggle("inline-flex", dashboard.CanRevert);
      renameRow.classList.add("hidden");
      resetDeleteButton();
    }

    async function renderData(dashboard: DashboardResponse) {
      const definition = dashboard.Definition;
      grid.replaceChildren();
      unsupportedPanel.classList.add("hidden");
      if (!definition) return;

      const wishes = (definition.UnsupportedWishes ?? []).filter(Boolean);
      if (wishes.length > 0) {
        unsupportedList.replaceChildren(
          ...wishes.map((wish) => {
            const li = document.createElement("li");
            li.textContent = wish;
            return li;
          }),
        );
        unsupportedPanel.classList.remove("hidden");
      }

      // Skeleton-Frames sofort, Daten folgen mit einem Request für alle Widgets
      const frames = new Map<string, HTMLElement>();
      for (const widget of definition.Widgets ?? []) {
        const frame = clone("frame");
        frame.classList.add(sizeToSpanClass(widget.Size));
        frame.dataset.dashWidget = widget.Kind;
        const title = frame.querySelector<HTMLElement>("[data-w-title]")!;
        if (widget.Title) {
          title.textContent = widget.Title;
          title.classList.remove("hidden");
        }
        frame.querySelector<HTMLElement>("[data-w-body]")!.append(makeSkeleton());
        grid.append(frame);
        frames.set(widget.Id, frame);
      }

      let data: WidgetData[] = [];
      try {
        const result = await apiFetch<{ Widgets: WidgetData[] }>(`/api/dashboards/${dashboard.Id}/data`);
        data = result.Widgets ?? [];
      } catch (error) {
        showGlobalError((error as Error).message);
      }
      const dataById = new Map(data.map((item) => [item.WidgetId, item]));

      for (const widget of definition.Widgets ?? []) {
        const frame = frames.get(widget.Id);
        if (!frame) continue;
        const body = frame.querySelector<HTMLElement>("[data-w-body]")!;
        body.replaceChildren(renderWidgetBody(widget, dataById.get(widget.Id)));
      }
    }

    function makeSkeleton() {
      const div = document.createElement("div");
      div.className = "h-24 animate-pulse rounded-md bg-muted";
      return div;
    }

    function renderWidgetBody(widget: DashboardWidget, data: WidgetData | undefined): HTMLElement {
      if (!data || !data.Success) {
        const error = clone("widget-error");
        error.querySelector<HTMLElement>("[data-w-error]")!.textContent = data?.Error || t("dash.widgetError");
        return error;
      }

      switch (widget.Kind) {
        case "stat-row":
          return renderStatRow(data);
        case "property-list":
          return renderPropertyList(widget, data);
        case "new-listings":
          return renderPropertyList(widget, data, "list");
        case "highlight":
          return renderHighlight(widget, data);
        case "map":
          return renderMap(data);
        case "text-note":
          return renderTextNote(data);
        case "price-chart":
          return renderChart(data);
        default: {
          // Tolerant-Reader: unbekanntes Kind still überspringen
          const empty = document.createElement("div");
          empty.classList.add("hidden");
          return empty;
        }
      }
    }

    function renderStatRow(data: WidgetData): HTMLElement {
      const row = clone("stat-row");
      const tilesHost = row.matches("[data-w-tiles]") ? row : row.querySelector<HTMLElement>("[data-w-tiles]")!;
      for (const tile of data.StatRow?.Tiles ?? []) {
        const tileEl = clone("stat-tile");
        tileEl.dataset.dashTile = tile.Key;
        tileEl.querySelector<HTMLElement>("[data-tile-label]")!.textContent = tile.Label;
        tileEl.querySelector<HTMLElement>("[data-tile-value]")!.textContent = tile.Value;
        tilesHost.append(tileEl);
      }
      return row;
    }

    function renderPropertyList(widget: DashboardWidget, data: WidgetData, forcedVariant?: string): HTMLElement {
      const items = data.PropertyList?.Properties ?? [];
      if (items.length === 0) return emptyNote();

      const fields = widget.Options?.Fields ?? null;
      const variant = forcedVariant ?? widget.Options?.Variant ?? "grid";
      const containerName = variant === "grid" ? "property-grid" : "property-rows";
      const container = clone(containerName);
      const host = container.querySelector<HTMLElement>("[data-w-items]") ?? container;

      for (const item of items) {
        if (fields && variant !== "grid") {
          host.append(fillRowFields(clone("property-row-fields"), item, fields));
          continue;
        }
        const itemTemplate =
          variant === "grid" ? "property-card" : variant === "minimal" ? "property-row-minimal" : "property-row";
        const card = fillCard(clone(itemTemplate), item);
        if (fields && variant === "grid") applyFieldsToCard(card, item, fields);
        host.append(card);
      }

      const total = data.PropertyList?.Total ?? items.length;
      if (total > items.length) {
        const note = document.createElement("p");
        note.className = "mt-3 text-xs text-muted-foreground";
        note.textContent = t("dash.listTotal", { count: total });
        container.append(note);
      }
      return container;
    }

    function renderHighlight(widget: DashboardWidget, data: WidgetData): HTMLElement {
      const item = data.PropertyList?.Properties?.[0];
      if (!item) return emptyNote();
      const card = fillCard(clone("highlight"), item);
      const fields = widget.Options?.Fields;
      if (fields) {
        const meta = card.querySelector<HTMLElement>("[data-card-meta]");
        if (meta) meta.textContent = joinFieldValues(item, fields);
      }
      return card;
    }

    /** Restfelder (ohne die fest platzierten) in Wunsch-Reihenfolge als Info-Zeile */
    function joinFieldValues(item: ApiPropertyItem, fields: string[]): string {
      return fields
        .filter((field) => !["foto", "titel", "preis", "ort"].includes(field))
        .map((field) => listFieldValue(item, field))
        .filter(Boolean)
        .join(" · ");
    }

    /**
     * Feld-gesteuerte Zeile: "titel" wird Zeile 1, "preis" steht rechts, "foto"
     * schaltet das Vorschaubild - alle uebrigen Felder bilden in der
     * Wunsch-Reihenfolge Zeile 2.
     */
    function fillRowFields(row: HTMLElement, item: ApiPropertyItem, fields: string[]): HTMLElement {
      const href = detailHrefOf(item.Id);
      (row as unknown as HTMLAnchorElement).href = href;
      row.dataset.detailId = item.Id;

      const image = row.querySelector<HTMLImageElement>("[data-card-image]")!;
      if (fields.includes("foto")) {
        image.hidden = false;
        image.src = item.ImageUrls?.[0] || "/kein-foto.svg";
        image.alt = item.Title;
        image.addEventListener("error", () => (image.src = "/kein-foto.svg"), { once: true });
      }

      const price = row.querySelector<HTMLElement>("[data-card-price]")!;
      if (fields.includes("preis")) {
        price.hidden = false;
        price.textContent = formatDashboardPrice(item.Price);
      }

      const rest = fields.filter((field) => !["foto", "preis", "titel"].includes(field));
      const line1 = fields.includes("titel")
        ? item.Title
        : (listFieldValue(item, rest.shift() ?? "") ?? item.Title);
      row.querySelector<HTMLElement>("[data-card-line1]")!.textContent = line1;
      row.querySelector<HTMLElement>("[data-card-line2]")!.textContent = rest
        .map((field) => listFieldValue(item, field))
        .filter(Boolean)
        .join(" · ");
      return row;
    }

    /** Feldauswahl auf die Grid-Karte anwenden (Foto bleibt - grid IST die Foto-Variante) */
    function applyFieldsToCard(card: HTMLElement, item: ApiPropertyItem, fields: string[]) {
      card.querySelector<HTMLElement>("[data-card-location]")?.toggleAttribute("hidden", !fields.includes("ort"));
      card.querySelector<HTMLElement>("[data-card-price]")?.toggleAttribute("hidden", !fields.includes("preis"));
      const meta = card.querySelector<HTMLElement>("[data-card-meta]");
      if (meta) meta.textContent = joinFieldValues(item, fields);
    }

    function renderTextNote(data: WidgetData): HTMLElement {
      const note = clone("text-note");
      const host = note.matches("[data-w-text]") ? note : note.querySelector<HTMLElement>("[data-w-text]")!;
      host.textContent = data.TextNote?.Text ?? "";
      return note;
    }

    function renderChart(data: WidgetData): HTMLElement {
      const chart = data.Chart;
      if (!chart) return emptyNote();
      const figure = clone("price-chart");
      const light = figure.querySelector<HTMLImageElement>("[data-chart-light]")!;
      const darkImg = figure.querySelector<HTMLImageElement>("[data-chart-dark]")!;
      light.src = chart.ImageLight;
      light.alt = chart.AltText;
      darkImg.src = chart.ImageDark;
      darkImg.alt = chart.AltText;
      const caption = figure.querySelector<HTMLElement>("[data-chart-caption]")!;
      if (chart.Caption) caption.textContent = chart.Caption;
      else caption.remove();
      return figure;
    }

    function emptyNote(text?: string): HTMLElement {
      const error = clone("widget-error");
      error.querySelector<HTMLElement>("[data-w-error]")!.textContent = text ?? t("dash.widgetEmpty");
      return error;
    }

    function detailHrefOf(id: string): string {
      return `/immobilien/angebote/${encodeURIComponent(id)}/`;
    }

    function fillCard(card: HTMLElement, item: ApiPropertyItem): HTMLElement {
      const href = detailHrefOf(item.Id);
      card.dataset.detailId = item.Id;
      card.querySelectorAll<HTMLAnchorElement>("[data-card-link]").forEach((link) => (link.href = href));
      if (card.matches("a[data-card-link]")) (card as unknown as HTMLAnchorElement).href = href;

      const image = card.querySelector<HTMLImageElement>("[data-card-image]");
      if (image) {
        image.src = item.ImageUrls?.[0] || "/kein-foto.svg";
        image.alt = item.Title;
        image.addEventListener("error", () => (image.src = "/kein-foto.svg"), { once: true });
      }

      const badge = card.querySelector<HTMLElement>("[data-card-badge]");
      if (badge) {
        const type = normalizePropertyType(item.Type);
        badge.textContent = type === "land" ? "Grundstück" : type === "foreclosure" ? "Zwangsversteigerung" : "Haus";
        badge.classList.add(
          ...(type === "foreclosure"
            ? ["bg-brand", "text-brand-foreground"]
            : type === "land"
              ? ["bg-type-grund", "text-white"]
              : ["bg-type-haus", "text-white"]),
        );
      }

      const title = card.querySelector<HTMLElement>("[data-card-title]");
      if (title) title.textContent = item.Title;

      const location = card.querySelector<HTMLElement>("[data-card-location]");
      if (location) location.textContent = [item.PostalCode, item.City].filter(Boolean).join(" ");

      const price = card.querySelector<HTMLElement>("[data-card-price]");
      if (price) price.textContent = formatDashboardPrice(item.Price);

      const area = item.LivingAreaM2 ?? item.PlotAreaM2;

      const areaEl = card.querySelector<HTMLElement>("[data-card-area]");
      if (areaEl) areaEl.textContent = area ? `${area} m²` : "";

      const meta = card.querySelector<HTMLElement>("[data-card-meta]");
      if (meta) {
        meta.textContent = [
          area ? `${area} m²` : null,
          item.Rooms ? `${item.Rooms} Zimmer` : null,
          item.SellerName?.trim() || null,
        ]
          .filter(Boolean)
          .join(" · ");
      }
      return card;
    }

    // ---------- Karten-Widget (lazy MapLibre wie PropertyLocationPreview) ----------

    function renderMap(data: WidgetData): HTMLElement {
      const wrapper = clone("map");
      const container = wrapper.querySelector<HTMLElement>("[data-w-map]")!;
      const totalLine = wrapper.querySelector<HTMLElement>("[data-w-map-total]")!;
      const pins = data.Map?.Pins ?? [];
      totalLine.textContent =
        pins.length > 0 ? t("dash.mapTotal", { count: data.Map?.Total ?? pins.length }) : t("dash.mapNone");
      if (pins.length > 0) void initMap(container, pins);
      return wrapper;
    }

    async function initMap(container: HTMLElement, pins: NonNullable<WidgetData["Map"]>["Pins"]) {
      try {
        const TILES_URL = new URL(
          import.meta.env.PUBLIC_MAP_TILES_URL || "/tiles/oberoesterreich.pmtiles",
          window.location.origin,
        ).href;
        const ASSETS_URL = new URL(
          import.meta.env.PUBLIC_MAP_ASSETS_URL || "/tiles/assets",
          window.location.origin,
        ).href;

        const [loaderModule, pmtilesModule, styleModule] = await Promise.all([
          import("@/features/map/maplibre-loader"),
          import("pmtiles"),
          import("@/features/map/map-style"),
          import("maplibre-gl/dist/maplibre-gl.css"),
        ]);
        const maplibre = await loaderModule.loadMaplibre();
        // addProtocol ist idempotent genug: erneutes Registrieren überschreibt nur
        maplibre.addProtocol("pmtiles", new pmtilesModule.Protocol().tile);

        let tilesAvailable = false;
        try {
          tilesAvailable = (await fetch(TILES_URL, { headers: { Range: "bytes=0-127" } })).ok;
        } catch {
          tilesAvailable = false;
        }

        let dark = document.documentElement.classList.contains("dark");
        const buildStyle = () => styleModule.buildMapStyle({ dark, tilesAvailable, tilesUrl: TILES_URL, assetsUrl: ASSETS_URL });

        const bounds = new maplibre.LngLatBounds();
        for (const pin of pins) bounds.extend([pin.Longitude, pin.Latitude]);

        const map = new maplibre.Map({
          container,
          style: buildStyle(),
          bounds,
          fitBoundsOptions: { padding: 42, maxZoom: 13.5 },
          minZoom: 7,
          maxZoom: 16.5,
          attributionControl: { compact: true },
          cooperativeGestures: true,
          locale: {
            "CooperativeGesturesHandler.WindowsHelpText": "Zoomen mit Strg + Scrollen",
            "CooperativeGesturesHandler.MacHelpText": "Zoomen mit ⌘ + Scrollen",
            "CooperativeGesturesHandler.MobileHelpText": "Verschieben mit zwei Fingern",
            "AttributionControl.ToggleAttribution": "Quellenangabe umschalten",
          },
        });
        new ResizeObserver(() => map.resize()).observe(container);

        const pinFeatures = {
          type: "FeatureCollection" as const,
          features: pins.map((pin) => ({
            type: "Feature" as const,
            geometry: { type: "Point" as const, coordinates: [pin.Longitude, pin.Latitude] },
            properties: { id: pin.Id },
          })),
        };

        map.on("style.load", () => {
          if (map.getSource("dash-pins")) return;
          map.addSource("dash-pins", { type: "geojson", data: pinFeatures });
          map.addLayer({
            id: "dash-pins-dots",
            type: "circle",
            source: "dash-pins",
            paint: {
              "circle-radius": 6,
              "circle-color": styleModule.BRAND_RED,
              "circle-stroke-width": 1.5,
              "circle-stroke-color": "#ffffff",
            },
          });
        });
        map.on("click", "dash-pins-dots", (event) => {
          const id = event.features?.[0]?.properties?.id as string | undefined;
          if (id) window.location.href = `/immobilien/angebote/${encodeURIComponent(id)}/`;
        });
        map.on("mouseenter", "dash-pins-dots", () => (map.getCanvas().style.cursor = "pointer"));
        map.on("mouseleave", "dash-pins-dots", () => (map.getCanvas().style.cursor = ""));

        new MutationObserver(() => {
          const nextDark = document.documentElement.classList.contains("dark");
          if (nextDark !== dark) {
            dark = nextDark;
            map.setStyle(buildStyle());
          }
        }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
      } catch {
        container.replaceChildren(emptyNote());
      }
    }

    // ---------- Aktionen ----------

    async function createDashboard() {
      const prompt = createInput.value.trim();
      if (prompt.length < 5) {
        createError.textContent = t("dash.createHintMin");
        createError.classList.remove("hidden");
        return;
      }
      createError.classList.add("hidden");
      createSubmit.disabled = true;
      try {
        const result = await apiFetch<{ DashboardId: string }>("/api/dashboards/generate", {
          method: "POST",
          body: JSON.stringify({ Prompt: prompt }),
        });
        createInput.value = "";
        summaries.unshift({
          Id: result.DashboardId,
          Title: t("dash.title"),
          Status: 1,
          CreatedAt: new Date().toISOString(),
          UpdatedAt: null,
        });
        await selectDashboard(result.DashboardId);
      } catch (error) {
        createError.textContent = (error as Error).message;
        createError.classList.remove("hidden");
      } finally {
        createSubmit.disabled = false;
      }
    }

    async function refineDashboard() {
      if (!activeId || refining) return;
      const instruction = refineInput.value.trim();
      if (instruction.length < 5) {
        refineError.textContent = t("dash.createHintMin");
        refineError.classList.remove("hidden");
        return;
      }
      refineError.classList.add("hidden");
      refining = true;
      setRefineBusy(true);
      try {
        await apiFetch(`/api/dashboards/refine`, {
          method: "POST",
          body: JSON.stringify({ Id: activeId, Instruction: instruction }),
        });
        refineInput.value = "";
        await loadDashboard();
      } catch (error) {
        refining = false;
        setRefineBusy(false);
        refineError.textContent = (error as Error).message;
        refineError.classList.remove("hidden");
      }
    }

    async function revertDashboard() {
      if (!activeId || busy) return;
      busy = true;
      try {
        await apiFetch(`/api/dashboards/revert`, {
          method: "POST",
          body: JSON.stringify({ Id: activeId }),
        });
        await loadDashboard();
      } catch (error) {
        showGlobalError((error as Error).message);
      } finally {
        busy = false;
      }
    }

    async function renameDashboard() {
      if (!activeId) return;
      const title = renameInput.value.trim();
      if (!title) return;
      try {
        await apiFetch(`/api/dashboards/`, {
          method: "PUT",
          body: JSON.stringify({ Id: activeId, Title: title }),
        });
        const summary = summaries.find((item) => item.Id === activeId);
        if (summary) summary.Title = title;
        titleEl.textContent = title;
        renameRow.classList.add("hidden");
        renderTabs();
      } catch (error) {
        showGlobalError((error as Error).message);
      }
    }

    // Original-Icon einmal sichern — die Bestätigungsstufe ersetzt es durch Text
    const deleteIcon = deleteButton.querySelector("svg")?.cloneNode(true) ?? null;

    function resetDeleteButton() {
      deleteButton.dataset.confirming = "";
      if (deleteIcon) deleteButton.replaceChildren(deleteIcon.cloneNode(true));
      else deleteButton.textContent = t("dash.delete");
    }

    async function deleteDashboard() {
      if (!activeId) return;
      // Destruktiv: zweistufige Inline-Bestätigung statt blockierendem confirm()
      if (deleteButton.dataset.confirming !== "yes") {
        deleteButton.dataset.confirming = "yes";
        deleteButton.textContent = t("dash.deleteConfirm");
        window.setTimeout(() => {
          if (deleteButton.dataset.confirming === "yes") resetDeleteButton();
        }, 4000);
        return;
      }
      try {
        await apiFetch(`/api/dashboards/${activeId}`, { method: "DELETE" });
        stopPolling();
        activeId = null;
        await loadList();
      } catch (error) {
        showGlobalError((error as Error).message);
      }
    }

    // ---------- Personalisierte Detail-Overlay ----------

    const detailOverlay = q("[data-dash-detail]");
    const detailTitle = q("[data-dash-detail-title]");
    const detailBody = q("[data-dash-detail-body]");
    const detailFull = q<HTMLAnchorElement>("[data-dash-detail-full]");
    let detailOpen = false;

    async function openDetail(propertyId: string) {
      detailOpen = true;
      detailOverlay.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      detailFull.href = detailHrefOf(propertyId);
      detailTitle.textContent = "…";
      detailBody.replaceChildren(makeSkeleton());
      try {
        // Antwort ist gewrappt: GetPropertyByIdResponse.Property
        const result = await apiFetch<{ Property: ApiPropertyDetail | null }>(
          `/api/properties/${encodeURIComponent(propertyId)}`,
        );
        if (!detailOpen) return;
        if (!result.Property) throw new Error("nicht gefunden");
        renderDetail(result.Property);
      } catch {
        detailBody.replaceChildren(emptyNote(t("dash.detailLoadError")));
      }
    }

    function closeDetail() {
      detailOpen = false;
      detailOverlay.classList.add("hidden");
      document.body.style.overflow = "";
    }

    function sectionTitle(text: string): HTMLElement {
      const heading = clone("detail-section-title");
      heading.textContent = text;
      return heading;
    }

    /** Aufbau folgt definition.Detail (Sections + Fakten-Felder), sonst Standard */
    function renderDetail(detail: ApiPropertyDetail) {
      detailTitle.textContent = detail.Title;
      const spec = current?.Definition?.Detail ?? null;
      const sections = spec?.Sections?.length ? spec.Sections : DEFAULT_DETAIL_SECTIONS;
      const fields = spec?.Fields?.length ? spec.Fields : DEFAULT_DETAIL_FIELDS;
      const parts: HTMLElement[] = [];

      for (const section of sections) {
        switch (section) {
          case "gallery": {
            const images = (detail.PreviewImageUrls?.length ? detail.PreviewImageUrls : detail.ImageUrls) ?? [];
            if (images.length === 0) break;
            const wrap = document.createElement("div");
            const main = document.createElement("img");
            main.className = "max-h-80 w-full rounded-md object-cover";
            main.src = images[0];
            main.alt = detail.Title;
            wrap.append(main);
            if (images.length > 1) {
              const thumbs = document.createElement("div");
              thumbs.className = "mt-2 flex gap-2 overflow-x-auto";
              for (const url of images.slice(0, 8)) {
                const thumb = document.createElement("img");
                thumb.className = "h-14 w-20 shrink-0 cursor-pointer rounded object-cover";
                thumb.src = url;
                thumb.alt = "";
                thumb.addEventListener("click", () => (main.src = url));
                thumbs.append(thumb);
              }
              wrap.append(thumbs);
            }
            parts.push(wrap);
            break;
          }
          case "facts": {
            const dl = document.createElement("dl");
            for (const key of fields) {
              const row = detailFieldRow(detail, key);
              if (!row) continue;
              const el = clone("detail-fact");
              el.querySelector<HTMLElement>("[data-fact-label]")!.textContent = row.label;
              el.querySelector<HTMLElement>("[data-fact-value]")!.textContent = row.value;
              dl.append(el);
            }
            if (dl.childElementCount > 0) parts.push(dl);
            break;
          }
          case "description": {
            const text = detail.Description?.trim();
            if (!text) break;
            parts.push(sectionTitle(t("dash.detailDescriptionTitle")));
            const p = document.createElement("p");
            p.className = "whitespace-pre-line text-sm leading-relaxed";
            p.textContent = text;
            parts.push(p);
            break;
          }
          case "features": {
            const features = (detail.Features ?? []).filter(Boolean);
            if (features.length === 0) break;
            parts.push(sectionTitle(t("dash.detailFeaturesTitle")));
            const chips = document.createElement("div");
            chips.className = "flex flex-wrap gap-2";
            for (const feature of features) {
              const chip = document.createElement("span");
              chip.className = "rounded bg-muted px-2 py-1 text-xs";
              chip.textContent = feature;
              chips.append(chip);
            }
            parts.push(chips);
            break;
          }
          case "contact": {
            const contacts = (detail.Contacts ?? []).filter((c) => c.Name || c.Phone || c.Email);
            if (contacts.length === 0) break;
            parts.push(sectionTitle(t("dash.detailContactTitle")));
            for (const contact of contacts) {
              const block = document.createElement("div");
              block.className = "mb-3 text-sm";
              if (contact.Name) {
                const name = document.createElement("p");
                name.className = "font-medium";
                name.textContent = contact.Name;
                block.append(name);
              }
              if (contact.Phone) {
                const phone = document.createElement("a");
                phone.className = "block text-primary hover:underline";
                phone.href = `tel:${contact.Phone.replace(/\s+/g, "")}`;
                phone.textContent = contact.Phone;
                block.append(phone);
              }
              if (contact.Email) {
                const email = document.createElement("a");
                email.className = "block text-primary hover:underline";
                email.href = `mailto:${contact.Email}`;
                email.textContent = contact.Email;
                block.append(email);
              }
              parts.push(block);
            }
            break;
          }
          case "map": {
            const container = document.createElement("div");
            container.className = "mt-2 h-64 overflow-hidden rounded-md border border-border bg-muted";
            parts.push(container);
            void apiFetch<{ Pins: NonNullable<WidgetData["Map"]>["Pins"] }>(
              `/api/properties/map-pins?PropertyId=${encodeURIComponent(detail.Id)}`,
            )
              .then((result) => {
                if (detailOpen && (result.Pins?.length ?? 0) > 0) void initMap(container, result.Pins);
              })
              .catch(() => container.remove());
            break;
          }
        }
      }

      detailBody.replaceChildren(...parts);
    }

    // Klicks auf Inserats-Eintraege im Dashboard oeffnen die Overlay statt zu
    // navigieren; Modifier-Klicks (neuer Tab) und Buttons (Favoriten) bleiben unberuehrt
    grid.addEventListener("click", (event) => {
      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const target = event.target as HTMLElement;
      if (target.closest("button")) return;
      const link = target.closest("a");
      if (!link || !link.href.includes("/immobilien/angebote/")) return;
      const holder = target.closest<HTMLElement>("[data-detail-id], [data-property-id]");
      const id = holder?.dataset.detailId || holder?.dataset.propertyId;
      if (!id) return;
      event.preventDefault();
      void openDetail(id);
    });

    q("[data-dash-detail-close]").addEventListener("click", closeDetail);
    q("[data-dash-detail-backdrop]").addEventListener("click", closeDetail);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && detailOpen) closeDetail();
    });

    // ---------- Wiring ----------

    createSubmit.addEventListener("click", () => void createDashboard());
    createInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && (event.ctrlKey || event.metaKey)) {
        event.preventDefault();
        void createDashboard();
      }
    });
    app.querySelectorAll<HTMLButtonElement>("[data-dash-example]").forEach((chip) => {
      chip.addEventListener("click", () => {
        createInput.value = chip.textContent?.trim() ?? "";
        createInput.focus();
      });
    });
    newButton.addEventListener("click", () => {
      createCancel.classList.remove("hidden");
      showPanel("create");
      createInput.focus();
    });
    createCancel.addEventListener("click", () => {
      if (activeId) void loadDashboard();
    });
    refineSubmit.addEventListener("click", () => void refineDashboard());
    // Enter darf nie ein umgebendes Formular absenden (bekannte Falle) —
    // hier gibt es zwar keines, aber preventDefault schadet nicht und startet die Runde
    refineInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        void refineDashboard();
      }
    });
    revertButton.addEventListener("click", () => void revertDashboard());
    renameButton.addEventListener("click", () => {
      renameInput.value = current?.Title ?? "";
      renameRow.classList.toggle("hidden");
      renameRow.classList.toggle("flex");
      renameInput.focus();
    });
    renameSave.addEventListener("click", () => void renameDashboard());
    renameInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        void renameDashboard();
      }
    });
    deleteButton.addEventListener("click", () => void deleteDashboard());

    // ---------- Boot ----------

    /**
     * SSR-Erstauslieferung uebernehmen: Liste/aktive Uebersicht kommen bereits
     * fertig gerendert vom Server - nichts neu fetchen oder rendern, nur die
     * Interaktivitaet anbinden und die Karten-Widgets initialisieren.
     */
    async function adoptSsrState(state: {
      Summaries: DashboardSummary[];
      Dashboard: DashboardResponse | null;
      Widgets: WidgetData[] | null;
    }) {
      summaries = state.Summaries ?? [];
      if (!state.Dashboard) {
        renderTabs();
        showPanel("create");
        return;
      }

      activeId = state.Dashboard.Id;
      current = state.Dashboard;
      renderTabs();
      syncUrl();

      const status = normalizeStatus(state.Dashboard.Status);
      if (status === "finished" && state.Widgets && state.Dashboard.Definition) {
        renderHeader(state.Dashboard);
        showPanel("view");
        initSsrMaps();
        return;
      }

      // Queued/InProgress/Failed: der normale Client-Pfad uebernimmt (Polling/Fehlerbild)
      await loadDashboard();
    }

    function initSsrMaps() {
      grid.querySelectorAll<HTMLElement>("[data-dash-ssr-map]").forEach((container) => {
        const pinsEl = container.querySelector("script[data-dash-ssr-pins]");
        let pins: NonNullable<WidgetData["Map"]>["Pins"] = [];
        try {
          pins = JSON.parse(pinsEl?.textContent ?? "[]");
        } catch {
          pins = [];
        }
        pinsEl?.remove();
        if (pins.length > 0) void initMap(container, pins);
      });
    }

    function readSsrState() {
      const stateEl = document.querySelector("script[data-dash-ssr-state]");
      if (!stateEl?.textContent) return null;
      try {
        return JSON.parse(stateEl.textContent) as {
          Summaries: DashboardSummary[];
          Dashboard: DashboardResponse | null;
          Widgets: WidgetData[] | null;
        };
      } catch {
        return null;
      }
    }

    if (readAccessToken()) {
      const preferredId = new URL(window.location.href).searchParams.get("id");
      const ssrState = readSsrState();
      if (ssrState) {
        void adoptSsrState(ssrState).catch((error: Error) => showGlobalError(error.message));
      } else {
        void loadList(preferredId).catch((error: Error) => showGlobalError(error.message));
      }
    }
  }
</script>
