---
/**
 * Kontakt-Formular (Anlegen + Bearbeiten) fuer die Marketing-Kontaktdatenbank.
 * PRG-Muster: POST an kontakte/save.ts, das den ADMIN_API_KEY serverseitig anhaengt.
 */
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import type { MarketingContact } from "@/lib/server/admin-api";
import {
  CONTACT_STATUSES,
  CONTACT_TYPES,
  contactStatusLabel,
  contactTypeLabel,
} from "@/lib/intern/marketing-labels";

interface Props {
  contact?: MarketingContact | null;
  /** Ziel nach dem Speichern: "list" (Kontaktliste) oder "detail" (Detailseite) */
  redirect: "list" | "detail";
}

const { contact = null, redirect } = Astro.props;

const inputClass =
  "w-full rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40";
---

<form method="POST" action="/intern/marketing/kontakte/save" class="flex flex-col gap-4">
  {contact && <input type="hidden" name="id" value={contact.Id} />}
  <input type="hidden" name="redirect" value={redirect} />

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-medium">{t("intern.mkFieldEmail")}</span>
      <input type="email" name="email" required value={contact?.Email ?? ""} class={inputClass} />
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-medium">{t("intern.mkFieldName")}</span>
      <input type="text" name="name" value={contact?.Name ?? ""} class={inputClass} />
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-medium">{t("intern.mkFieldCompany")}</span>
      <input type="text" name="company" value={contact?.Company ?? ""} class={inputClass} />
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-medium">{t("intern.mkFieldPhone")}</span>
      <input type="text" name="phone" value={contact?.Phone ?? ""} class={inputClass} />
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-medium">{t("intern.mkFieldType")}</span>
      <select name="contactType" class={inputClass}>
        {CONTACT_TYPES.map((type) => (
          <option value={type} selected={(contact?.ContactType ?? "Unknown") === type}>
            {contactTypeLabel(type)}
          </option>
        ))}
      </select>
    </label>
    <label class="flex flex-col gap-1 text-sm">
      <span class="font-medium">{t("intern.mkFieldStatus")}</span>
      <select name="status" class={inputClass}>
        {CONTACT_STATUSES.map((status) => (
          <option value={status} selected={(contact?.Status ?? "Lead") === status}>
            {contactStatusLabel(status)}
          </option>
        ))}
      </select>
    </label>
  </div>

  <label class="flex flex-col gap-1 text-sm">
    <span class="font-medium">{t("intern.mkFieldNotes")}</span>
    <textarea name="notes" rows="4" class={inputClass}>{contact?.Notes ?? ""}</textarea>
  </label>

  <div>
    <Button type="submit" variant="default">{t("intern.mkSave")}</Button>
  </div>
</form>
