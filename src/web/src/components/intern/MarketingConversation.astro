---
/**
 * Chat-Verlauf eines Kontakts: gesendete Mails rechts (primary-getoent), empfangene
 * Rueckmeldungen links, Aktivitaeten als zentrierte Systemzeilen - nach Tagen gruppiert,
 * aelteste oben, der Container startet ans Ende gescrollt (neueste Nachricht sichtbar).
 * Darunter der Antwort-Composer: schreibt ueber kontakte/antwort.ts eine echte Reply
 * (Threading-Header) auf die juengste empfangene Nachricht; Strg+Enter sendet.
 * Ohne empfangene Nachricht gibt es kein Antwortziel - dann fuehrt der Composer-Platz
 * zur Erstansprache ueber "Schreiben".
 */
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n";
import type { MarketingContact, MarketingContactDetail } from "@/lib/server/admin-api";
import {
  activityTypeLabel,
  contactStatusLabel,
  formatInternDay,
  formatInternTime,
} from "@/lib/intern/marketing-labels";

interface Props {
  contact: MarketingContact;
  detail: MarketingContactDetail;
}

const { contact, detail } = Astro.props;

const warnBadgeClass =
  "rounded bg-amber-100 px-1.5 py-0.5 text-amber-900 dark:bg-amber-900/40 dark:text-amber-200";
const errorBadgeClass =
  "rounded bg-red-100 px-1.5 py-0.5 text-red-900 dark:bg-red-900/40 dark:text-red-200";

type Message = {
  kind: "sent" | "reply" | "activity";
  date: string;
  subject: string;
  body: string;
  /** Absenderadresse an der Empfangs-Bubble, wenn sie von der Stammadresse abweicht */
  meta?: string;
  badge?: string;
  badgeClass?: string;
};

const messages: Message[] = [
  ...(detail.Emails ?? []).map((email) => ({
    kind: "sent" as const,
    date: email.SentAt,
    subject: email.Subject,
    body: email.Body,
    badge:
      email.Status === "LoggedOnly"
        ? t("intern.mkSentBadgeLoggedOnly")
        : email.Status === "DeliveryFailed"
          ? t("intern.mkSentBadgeFailed")
          : undefined,
    badgeClass: email.Status === "DeliveryFailed" ? errorBadgeClass : warnBadgeClass,
  })),
  ...(detail.Replies ?? []).map((reply) => ({
    kind: "reply" as const,
    date: reply.ReceivedAt,
    subject: reply.Subject ?? "",
    body: reply.BodyText ?? "",
    meta: reply.FromAddress !== contact.Email ? reply.FromAddress : undefined,
    badge: reply.IsBounce ? t("intern.mkInboxBadgeBounce") : undefined,
    badgeClass: errorBadgeClass,
  })),
  // Anrufe, Notizen, Statuswechsel und Termine - die Kopfzeile traegt die Aussage,
  // der Text darunter ist die Gespraechsnotiz
  ...(detail.Activities ?? []).map((activity) => ({
    kind: "activity" as const,
    date: activity.OccurredAt,
    subject:
      activity.Type === "StatusChange"
        ? t("intern.mkActivityStatusLine", {
            from: activity.StatusFrom ? contactStatusLabel(activity.StatusFrom) : "–",
            to: activity.StatusTo ? contactStatusLabel(activity.StatusTo) : "–",
          })
        : activity.FollowUpAt
          ? t("intern.mkActivityFollowUpLine", { date: formatInternDay(activity.FollowUpAt) })
          : activityTypeLabel(activity.Type),
    body: activity.Notes ?? "",
    // Kein Badge am Statuswechsel - die Kopfzeile beginnt schon mit "Status:"
    badge: activity.Type === "StatusChange" ? undefined : activityTypeLabel(activity.Type),
  })),
].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());

// Tages-Trenner: vor der ersten Nachricht eines Tages eine Datumszeile einschieben
type Row = { day: string } | { message: Message };
const rows: Row[] = [];
let currentDay = "";
for (const message of messages) {
  const day = formatInternDay(message.date);
  if (day !== currentDay) {
    rows.push({ day });
    currentDay = day;
  }
  rows.push({ message });
}

// Antwortziel: juengste echte Rueckmeldung - eine Antwort an mailer-daemon/postmaster
// (Bounce) laeuft ins Leere
const replyTarget =
  [...(detail.Replies ?? [])]
    .filter((reply) => !reply.IsBounce)
    .sort((a, b) => new Date(b.ReceivedAt).getTime() - new Date(a.ReceivedAt).getTime())[0] ??
  null;

const composeParams = new URLSearchParams({ contactId: contact.Id });
if (contact.Email) composeParams.set("email", contact.Email);
if (contact.Name) composeParams.set("name", contact.Name);
const composeHref = `/intern/marketing/schreiben/?${composeParams}`;
---

<section class="mt-6 overflow-hidden rounded-lg border border-border bg-card">
  <h2 class="border-b border-border px-5 py-3 text-base font-semibold">
    {t("intern.mkDetailTimelineHeading")}
  </h2>

  {messages.length === 0 ? (
    <p class="px-5 py-6 text-sm text-muted-foreground">{t("intern.mkDetailTimelineEmpty")}</p>
  ) : (
    <div class="max-h-[34rem] overflow-y-auto px-4 py-4 sm:px-5" data-conv-thread>
      <div class="flex flex-col gap-3">
        {rows.map((row) =>
          "day" in row ? (
            <div class="my-1 flex items-center gap-3">
              <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
              <span class="text-xs text-muted-foreground">{row.day}</span>
              <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
            </div>
          ) : row.message.kind === "activity" ? (
            <div class="mx-auto w-full max-w-md text-center">
              <p class="text-xs text-muted-foreground">
                {row.message.badge && (
                  <>
                    <span class="rounded bg-muted px-1.5 py-0.5">{row.message.badge}</span>
                    {" "}
                  </>
                )}
                {row.message.subject}
                <span aria-hidden="true"> · </span>{formatInternTime(row.message.date)}
              </p>
              {row.message.body && (
                <p class="mt-1.5 rounded-lg border border-dashed border-border px-3 py-2 text-left text-sm whitespace-pre-wrap">
                  {row.message.body}
                </p>
              )}
            </div>
          ) : (
            <div class={`flex ${row.message.kind === "sent" ? "justify-end" : "justify-start"}`}>
              <div
                class={`max-w-[85%] rounded-lg px-3.5 py-2.5 ${
                  row.message.kind === "sent"
                    ? "rounded-br-sm border border-primary/25 bg-primary/10"
                    : "rounded-bl-sm border border-border bg-muted"
                }`}
              >
                <span class="sr-only">
                  {row.message.kind === "sent"
                    ? t("intern.mkDetailSentPrefix")
                    : t("intern.mkDetailReplyPrefix")}
                </span>
                {row.message.subject && (
                  <p class="text-sm font-semibold">{row.message.subject}</p>
                )}
                {row.message.body && (
                  <>
                    <p class="mt-1 text-sm whitespace-pre-wrap" data-conv-body>
                      {row.message.body}
                    </p>
                    <button
                      type="button"
                      class="mt-1 hidden text-xs font-medium underline hover:no-underline"
                      data-conv-toggle
                      data-more={t("intern.mkConvShowMore")}
                      data-less={t("intern.mkConvShowLess")}
                    >
                      {t("intern.mkConvShowMore")}
                    </button>
                  </>
                )}
                <p class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-muted-foreground">
                  <span>{formatInternTime(row.message.date)}</span>
                  {row.message.meta && <span>{row.message.meta}</span>}
                  {row.message.badge && (
                    <span class={row.message.badgeClass}>{row.message.badge}</span>
                  )}
                </p>
              </div>
            </div>
          ),
        )}
      </div>
    </div>
  )}

  <div class="border-t border-border px-4 py-3 sm:px-5">
    {replyTarget ? (
      <form
        method="POST"
        action="/intern/marketing/kontakte/antwort"
        class="flex flex-col gap-2"
        data-conv-form
      >
        <input type="hidden" name="contactId" value={contact.Id} />
        <input type="hidden" name="inboundEmailId" value={replyTarget.Id} />
        <textarea
          name="body"
          rows="2"
          required
          placeholder={t("intern.mkInboxReplyPlaceholder", {
            name: contact.Name ?? contact.Email ?? "?",
          })}
          class="max-h-48 w-full resize-none rounded-md border border-border bg-muted px-3 py-2 text-sm outline-none focus:border-foreground/40"
          data-conv-input></textarea>

        {/* Ergebnis des KI-Checks: bleibt unsichtbar bis zur ersten Pruefung, das
            Script fuellt Urteil/Korrektur/Vorschlag und blendet nur Zutreffendes ein */}
        <div class="hidden rounded-md border border-border bg-background p-3" data-check-panel>
          <div class="flex items-start justify-between gap-3">
            <p class="text-sm font-medium" data-check-verdict></p>
            <button
              type="button"
              class="shrink-0 leading-none text-muted-foreground hover:text-foreground"
              data-check-close
              aria-label={t("intern.mkConvCheckClose")}
            >✕</button>
          </div>
          <p class="mt-1 hidden text-sm text-muted-foreground" data-check-note></p>
          <p class="mt-1 hidden text-sm text-muted-foreground" data-check-noissues>
            {t("intern.mkConvCheckNoIssues")}
          </p>
          {["corrected", "suggested"].map((kind) => (
            <div class="mt-3 hidden" data-check-block={kind}>
              <p class="text-xs font-semibold tracking-wide text-muted-foreground uppercase">
                {kind === "corrected"
                  ? t("intern.mkConvCheckCorrectedHeading")
                  : t("intern.mkConvCheckSuggestedHeading")}
              </p>
              <p
                class="mt-1 max-h-40 overflow-y-auto rounded-md border border-border bg-muted/50 px-3 py-2 text-sm whitespace-pre-wrap"
                data-check-text
              ></p>
              <div class="mt-1.5 flex items-center gap-3">
                <button
                  type="button"
                  class="text-xs font-medium underline hover:no-underline disabled:no-underline disabled:opacity-60"
                  data-check-apply
                  data-apply-label={t("intern.mkConvCheckApply")}
                  data-applied-label={t("intern.mkConvCheckApplied")}
                >{t("intern.mkConvCheckApply")}</button>
                <button
                  type="button"
                  class="hidden text-xs text-muted-foreground underline hover:no-underline"
                  data-check-undo
                >{t("intern.mkConvCheckUndo")}</button>
              </div>
            </div>
          ))}

          {/* Naechste Runde: Wunsch an die KI - ueberarbeitet den angezeigten Vorschlag
              (bzw. den Entwurf, wenn es noch keinen gibt). Enter loest die Runde aus,
              das Script faengt ihn ab - sonst wuerde er die Antwort SENDEN. */}
          <div class="mt-3 hidden border-t border-border pt-3" data-check-refine>
            <div class="flex items-center gap-2">
              <input
                type="text"
                placeholder={t("intern.mkConvCheckRefinePlaceholder")}
                class="min-w-0 flex-1 rounded-md border border-border bg-muted px-3 py-1.5 text-sm outline-none focus:border-foreground/40"
                data-check-refine-input
              />
              <button
                type="button"
                class="shrink-0 rounded-md border border-border px-2.5 py-1.5 text-sm font-medium transition-colors hover:bg-muted disabled:opacity-60"
                data-check-refine-btn
                data-idle-label={t("intern.mkConvCheckRefineSend")}
                data-running-label={t("intern.mkConvCheckRunning")}
              >{t("intern.mkConvCheckRefineSend")}</button>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-xs leading-5 text-muted-foreground">
            {t("intern.mkInboxReplyHint", { address: replyTarget.FromAddress })}
            {" "}{t("intern.mkConvSendShortcut")}
          </p>
          <div class="flex shrink-0 items-center gap-3">
            <a href={composeHref} class="text-xs underline hover:no-underline">
              {t("intern.mkConvWriteNew")}
            </a>
            <Button
              type="button"
              variant="outline"
              size="sm"
              data-conv-check-btn
              data-idle-label={t("intern.mkConvCheck")}
              data-running-label={t("intern.mkConvCheckRunning")}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" />
              </svg>
              <span data-check-btn-label>{t("intern.mkConvCheck")}</span>
            </Button>
            <Button type="submit" variant="default" size="sm">
              {t("intern.mkInboxReplySend")}
            </Button>
          </div>
        </div>
      </form>
    ) : (
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-muted-foreground">{t("intern.mkConvNoReplyTarget")}</p>
        {contact.Email ? (
          <Button href={composeHref} variant="default" size="sm">
            {t("intern.mkConvWriteNew")}
          </Button>
        ) : (
          <Button href={composeHref} variant="outline" size="sm">
            {t("intern.mkConvWriteNew")}
          </Button>
        )}
      </div>
    )}
  </div>
</section>

<script>
  import { t } from "@/i18n";

  // Lange Nachrichten geclamped mit Umschalter (erst clampen, dann ans Ende scrollen -
  // das Clampen aendert die Hoehen), Strg+Enter sendet, die Textarea waechst beim Tippen.
  for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-conv-toggle]")) {
    const body = toggle.previousElementSibling;
    if (!(body instanceof HTMLElement)) continue;
    body.classList.add("line-clamp-[10]");
    if (body.scrollHeight <= body.clientHeight + 2) {
      body.classList.remove("line-clamp-[10]");
      continue;
    }
    toggle.classList.remove("hidden");
    toggle.addEventListener("click", () => {
      const clamped = body.classList.toggle("line-clamp-[10]");
      toggle.textContent = (clamped ? toggle.dataset.more : toggle.dataset.less) ?? "";
      if (clamped) body.scrollIntoView({ block: "nearest" });
    });
  }

  const thread = document.querySelector<HTMLElement>("[data-conv-thread]");
  if (thread) thread.scrollTop = thread.scrollHeight;

  const form = document.querySelector<HTMLFormElement>("[data-conv-form]");
  const input = form?.querySelector<HTMLTextAreaElement>("[data-conv-input]") ?? null;
  if (form && input) {
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && (event.ctrlKey || event.metaKey)) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
    const grow = () => {
      input.style.height = "auto";
      input.style.height = `${Math.min(input.scrollHeight, 192)}px`;
    };
    input.addEventListener("input", grow);

    // --- KI-Check: Entwurf gegen den Verlauf pruefen lassen (versendet nichts) ---
    type CheckResult = {
      ok: boolean;
      fitsContext?: boolean;
      contextNote?: string | null;
      correctedText?: string | null;
      suggestedText?: string | null;
      error?: string | null;
    };

    const checkBtn = form.querySelector<HTMLButtonElement>("[data-conv-check-btn]");
    const btnLabel = checkBtn?.querySelector<HTMLElement>("[data-check-btn-label]") ?? null;
    const panel = form.querySelector<HTMLElement>("[data-check-panel]");
    const verdict = panel?.querySelector<HTMLElement>("[data-check-verdict]") ?? null;
    const note = panel?.querySelector<HTMLElement>("[data-check-note]") ?? null;
    const noIssues = panel?.querySelector<HTMLElement>("[data-check-noissues]") ?? null;

    if (checkBtn && btnLabel && panel && verdict && note && noIssues) {
      panel
        .querySelector("[data-check-close]")
        ?.addEventListener("click", () => panel.classList.add("hidden"));

      // Uebernehmen ersetzt den Entwurf (Rueckgaengig stellt den Stand davor wieder her) -
      // einmalige Bindung, die Fuellung pro Check setzt nur Text und Button-Zustand zurueck
      for (const block of panel.querySelectorAll<HTMLElement>("[data-check-block]")) {
        const text = block.querySelector<HTMLElement>("[data-check-text]");
        const apply = block.querySelector<HTMLButtonElement>("[data-check-apply]");
        const undo = block.querySelector<HTMLButtonElement>("[data-check-undo]");
        if (!text || !apply || !undo) continue;
        let previousDraft = "";
        apply.addEventListener("click", () => {
          previousDraft = input.value;
          input.value = text.textContent ?? "";
          grow();
          apply.disabled = true;
          apply.textContent = apply.dataset.appliedLabel ?? "";
          undo.classList.remove("hidden");
          input.focus();
        });
        undo.addEventListener("click", () => {
          input.value = previousDraft;
          grow();
          apply.disabled = false;
          apply.textContent = apply.dataset.applyLabel ?? "";
          undo.classList.add("hidden");
          input.focus();
        });
      }

      const fillBlock = (kind: string, value: string | null | undefined, draft: string): boolean => {
        const block = panel.querySelector<HTMLElement>(`[data-check-block="${kind}"]`);
        const text = block?.querySelector<HTMLElement>("[data-check-text]");
        const apply = block?.querySelector<HTMLButtonElement>("[data-check-apply]");
        const undo = block?.querySelector<HTMLButtonElement>("[data-check-undo]");
        if (!block || !text || !apply || !undo) return false;
        const trimmed = value?.trim() ?? "";
        // Text, der dem Entwurf gleicht, ist keine Anmerkung
        const show = trimmed.length > 0 && trimmed !== draft;
        block.classList.toggle("hidden", !show);
        if (!show) return false;
        text.textContent = trimmed;
        apply.disabled = false;
        apply.textContent = apply.dataset.applyLabel ?? "";
        undo.classList.add("hidden");
        return true;
      };

      const refineRow = panel.querySelector<HTMLElement>("[data-check-refine]");
      const refineInput =
        refineRow?.querySelector<HTMLInputElement>("[data-check-refine-input]") ?? null;
      const refineBtn =
        refineRow?.querySelector<HTMLButtonElement>("[data-check-refine-btn]") ?? null;

      const showResult = (result: CheckResult | null, draft: string): void => {
        panel.classList.remove("hidden");
        if (!result?.ok) {
          verdict.textContent = t("intern.mkConvCheckFailed", {
            error: result?.error ?? "API nicht erreichbar",
          });
          verdict.className = "text-sm font-medium text-red-700 dark:text-red-300";
          note.classList.add("hidden");
          noIssues.classList.add("hidden");
          for (const block of panel.querySelectorAll("[data-check-block]"))
            block.classList.add("hidden");
          refineRow?.classList.add("hidden");
          return;
        }

        verdict.textContent = result.fitsContext
          ? `✓ ${t("intern.mkConvCheckFits")}`
          : `⚠ ${t("intern.mkConvCheckFitsNot")}`;
        verdict.className = result.fitsContext
          ? "text-sm font-medium text-success"
          : "text-sm font-medium text-amber-700 dark:text-amber-300";

        const noteText = result.contextNote?.trim() ?? "";
        note.textContent = noteText;
        note.classList.toggle("hidden", noteText.length === 0);

        const hasCorrection = fillBlock("corrected", result.correctedText, draft);
        const hasSuggestion = fillBlock("suggested", result.suggestedText, draft);
        noIssues.classList.toggle("hidden", !result.fitsContext || hasCorrection || hasSuggestion);
        refineRow?.classList.remove("hidden");
        panel.scrollIntoView({ block: "nearest" });
      };

      // Check und Ueberarbeitungs-Runde teilen sich den Aufruf; waehrend eine Runde
      // laeuft, sind beide Ausloeser gesperrt und nur der ausloesende zeigt "Prüft …"
      const setBusy = (busy: boolean, source: "check" | "refine"): void => {
        checkBtn.disabled = busy;
        btnLabel.textContent =
          (busy && source === "check" ? checkBtn.dataset.runningLabel : checkBtn.dataset.idleLabel) ?? "";
        if (refineBtn) {
          refineBtn.disabled = busy;
          refineBtn.textContent =
            (busy && source === "refine" ? refineBtn.dataset.runningLabel : refineBtn.dataset.idleLabel) ?? "";
        }
      };

      const performCheck = async (
        extra: Record<string, string>,
        source: "check" | "refine",
      ): Promise<CheckResult | null> => {
        const draft = input.value.trim();
        if (!draft) {
          input.focus();
          return null;
        }
        const inboundEmailId =
          form.querySelector<HTMLInputElement>("input[name='inboundEmailId']")?.value ?? "";

        setBusy(true, source);
        try {
          const response = await fetch("/intern/marketing/kontakte/antwort-check", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ inboundEmailId, draft, ...extra }),
          });
          const result = (await response.json().catch(() => null)) as CheckResult | null;
          showResult(result, draft);
          return result;
        } catch {
          showResult(null, draft);
          return null;
        } finally {
          setBusy(false, source);
        }
      };

      checkBtn.addEventListener("click", () => void performCheck({}, "check"));

      if (refineInput && refineBtn) {
        const runRefine = async (): Promise<void> => {
          const instruction = refineInput.value.trim();
          if (!instruction) {
            refineInput.focus();
            return;
          }
          const suggestedBlock = panel.querySelector<HTMLElement>('[data-check-block="suggested"]');
          const previousSuggestion =
            suggestedBlock && !suggestedBlock.classList.contains("hidden")
              ? (suggestedBlock.querySelector("[data-check-text]")?.textContent ?? "")
              : "";
          const result = await performCheck({ instruction, previousSuggestion }, "refine");
          if (result?.ok) refineInput.value = "";
        };

        refineBtn.addEventListener("click", () => void runRefine());
        // Enter startet die Runde - ohne preventDefault wuerde er das Antwort-Formular
        // abschicken und die Mail SENDEN
        refineInput.addEventListener("keydown", (event) => {
          if (event.key === "Enter") {
            event.preventDefault();
            void runRefine();
          }
        });
      }
    }
  }
</script>
