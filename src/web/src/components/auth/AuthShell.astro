---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandMark from "@/components/layout/BrandMark.astro";
import { t } from "@/i18n";

interface Props {
  title: string;
  description: string;
  mode?: "login" | "register";
  /* Fuer Seiten ausserhalb von Login/Registrieren (z.B. Passwort-Reset) direkt angebbar */
  canonicalPath?: string;
}

const { title, description, mode, canonicalPath = mode === "register" ? "/registrieren/" : "/anmelden/" } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} chrome={false} noindex>
  <div class="grid min-h-screen lg:grid-cols-[minmax(420px,560px)_1fr]">
    <section class="bg-background px-6 py-8 sm:px-12">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground">← {t("common.back")}</a>
      <div class="mt-12 max-w-md">
        <h1 class="text-3xl font-bold">{title}</h1>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">{description}</p>
        <slot />
      </div>
    </section>
    {/* Markenpanel: Light hellt zur Sonne hin auf (tiefes Rot -> Koralle, der Text
        liegt auf der satten Rot-Seite), Dark im kraeftigen Rot-Schwarz */}
    <aside class="relative hidden overflow-hidden bg-[linear-gradient(160deg,#c9161c,#ee6a50)] text-white lg:grid lg:place-items-center dark:bg-[linear-gradient(160deg,#bb0916,#1a0508)]">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="0.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="pointer-events-none absolute -right-24 -top-16 size-[34rem] text-white/10"
        aria-hidden="true"
      >
        <path d="M3.5 12.5 12 5l8.5 7.5" />
        <path d="M6.5 11.5V19h11v-7.5" />
        <path d="M12 19v-4" />
      </svg>
      <div class="relative max-w-md px-10">
        {/* Wappen-Lockup: zweizeilige Wortmarke an der Wortfuge Heimat|platz,
            daneben das Abzeichen als leicht gedrehtes Siegel ("Stempel") */}
        <div class="flex items-center gap-7">
          <p class="text-5xl font-extrabold uppercase leading-[0.95] tracking-tight"><span class="block">Heimat</span><span class="block">platz</span></p>
          <BrandMark tile class="brand-seal h-28 drop-shadow-[0_10px_24px_rgba(0,0,0,0.3)]" />
        </div>
        <p class="mt-7 text-lg leading-8 text-white/80">
          {t("auth.brandTagline")}
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  /* Siegel wird beim Laden wie ein Stempel aufgedrueckt: kommt gross und
     staerker gedreht an, setzt sich auf 6 Grad ab. is:global, weil die
     Klasse auf dem img der BrandMark-Kindkomponente liegt (Astro-Scoping
     erreicht Kindkomponenten nicht). */
  .brand-seal {
    rotate: 6deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand-seal {
      animation: seal-stamp 0.45s cubic-bezier(0.2, 0.85, 0.3, 1) 0.15s both;
    }

    @keyframes seal-stamp {
      from {
        opacity: 0;
        scale: 1.35;
        rotate: 15deg;
      }
      to {
        opacity: 1;
        scale: 1;
        rotate: 6deg;
      }
    }
  }
</style>
