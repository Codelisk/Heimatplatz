---
/**
 * Heimatplatz-Abzeichen: rundes Vintage-Emblem - rotes Ringband mit
 * "OBERÖSTERREICH" als Bogenschrift, innen die Szene (rotes Haus mit
 * Herz-Giebel, Tannen, Felder), unten das Banner "HEIMATPLATZ".
 * Selbsttragend (weisser Teller, Schrift als Pfade) - traegt auf hellen,
 * dunklen und roten Flaechen; `tile` bleibt als Alias fuer favicon.svg
 * (identisches Abzeichen) erhalten.
 * Wird in Header, Navigation, Footer und Auth-Panel als Wiedererkennungszeichen genutzt.
 */
interface Props {
  class?: string;
  tile?: boolean;
}

const { class: className = "h-8", tile = false } = Astro.props;
---

<img
  src={tile ? "/favicon.svg" : "/logo-mark.svg"}
  alt=""
  aria-hidden="true"
  width="48"
  height="48"
  class:list={["w-auto shrink-0", className]}
/>
