---
/**
 * Heimatplatz-Huettenmarke: handgezeichnetes Etikett mit Almhuette, Rauchkringel
 * und Tanne zwischen rot-weiss-roten Baendern (logo-mark.svg).
 * `tile` liefert die Kachel-Variante (weisse Kachel, favicon.svg) fuer
 * Flaechen, auf denen das freistehende Etikett nicht traegt (z.B. rotes Panel).
 * Wird in Header, Navigation, Footer und Auth-Panel als Wiedererkennungszeichen genutzt.
 */
interface Props {
  class?: string;
  tile?: boolean;
}

const { class: className = "h-8", tile = false } = Astro.props;
---

<img
  src={tile ? "/favicon.svg" : "/logo-mark.svg"}
  alt=""
  aria-hidden="true"
  width="48"
  height="48"
  class:list={["w-auto shrink-0", className]}
/>
