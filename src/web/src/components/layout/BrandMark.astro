---
/**
 * Heimatplatz-Signet: Haus als rot-weiss-rote Flagge (logo-mark.svg).
 * `tile` liefert die Kachel-Variante (weisse Kachel, favicon.svg) fuer
 * Flaechen, auf denen das freistehende Signet nicht traegt (z.B. rotes Panel).
 * Wird in Header, Navigation, Footer und Auth-Panel als Wiedererkennungszeichen genutzt.
 */
interface Props {
  class?: string;
  tile?: boolean;
}

const { class: className = "h-8", tile = false } = Astro.props;
---

<img
  src={tile ? "/favicon.svg" : "/logo-mark.svg"}
  alt=""
  aria-hidden="true"
  width="48"
  height="48"
  class:list={["w-auto shrink-0", className]}
/>
