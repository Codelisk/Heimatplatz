---
/**
 * Heimatplatz-Marke im Stil des Ursprungslogos: zwei rot-weiss-rote Balken,
 * das Haus steht weiss freigestellt auf dem unteren Balken, Tanne rechts
 * (logo-mark.svg, Querformat). `tile` liefert die Kachel-Variante (weisse
 * Kachel, favicon.svg) fuer Flaechen, auf denen die freistehende Marke nicht
 * traegt (z.B. rotes Panel).
 * Wird in Header, Navigation, Footer und Auth-Panel als Wiedererkennungszeichen genutzt.
 */
interface Props {
  class?: string;
  tile?: boolean;
}

const { class: className = "h-8", tile = false } = Astro.props;
---

<img
  src={tile ? "/favicon.svg" : "/logo-mark.svg"}
  alt=""
  aria-hidden="true"
  width={tile ? 48 : 58}
  height={tile ? 48 : 32}
  class:list={["w-auto shrink-0", className]}
/>
