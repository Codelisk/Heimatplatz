---
import BellIcon from "@tabler/icons/outline/bell.svg";
import BugIcon from "@tabler/icons/outline/bug.svg";
import FilterIcon from "@tabler/icons/outline/filter.svg";
import HeartIcon from "@tabler/icons/outline/heart.svg";
import HomeIcon from "@tabler/icons/outline/home.svg";
import LoginIcon from "@tabler/icons/outline/login.svg";
import MenuIcon from "@tabler/icons/outline/menu-2.svg";
import PlusIcon from "@tabler/icons/outline/plus.svg";
import ShieldOffIcon from "@tabler/icons/outline/shield-off.svg";
import UserIcon from "@tabler/icons/outline/user.svg";
import UserPlusIcon from "@tabler/icons/outline/user-plus.svg";
import XIcon from "@tabler/icons/outline/x.svg";
import { Button } from "@/components/starwind/button";
import { NativeSelect } from "@/components/starwind/native-select";
import { t } from "@/i18n";
import BrandMark from "@/components/layout/BrandMark.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import OrtPicker from "@/components/properties/OrtPicker.astro";
import { fetchOrtRegions } from "@/features/locations/live-api";

const pathname = Astro.url.pathname;
const showFilters = pathname === "/";
// Such-Picker arbeitet auf der echten Bezirk/Gemeinde-Hierarchie der API
// (Slugs -> MunicipalityIds, serverseitige Filterung). Cached, faellt bei
// API-Ausfall auf die statischen SEO-Ortsteile zurueck.
const ortRegions = showFilters ? await fetchOrtRegions() : [];
const titleByPath = [
  { test: (path: string) => path === "/", title: "HEIMATPLATZ" },
  { test: (path: string) => path.startsWith("/immobilien/angebote/"), title: t("nav.property") },
  { test: (path: string) => path.startsWith("/zwangsversteigerungen/") && path !== "/zwangsversteigerungen/", title: t("nav.foreclosure") },
  { test: (path: string) => path.startsWith("/immobilien/bearbeiten"), title: t("nav.editProperty") },
  { test: (path: string) => path.startsWith("/inserieren"), title: t("nav.addProperty") },
  { test: (path: string) => path.startsWith("/meine-immobilien"), title: t("nav.myProperties") },
  { test: (path: string) => path.startsWith("/favoriten"), title: t("nav.myFavorites") },
  { test: (path: string) => path.startsWith("/blockiert"), title: t("nav.blockedProperties") },
  { test: (path: string) => path.startsWith("/benachrichtigungen"), title: t("nav.notifications") },
  { test: (path: string) => path.startsWith("/filter-einstellungen"), title: t("nav.filterSettings") },
  { test: (path: string) => path.startsWith("/profil"), title: t("nav.myProfile") },
  { test: (path: string) => path.startsWith("/zwangsversteigerungen"), title: t("nav.foreclosures") },
];
const currentTitle = titleByPath.find((item) => item.test(pathname))?.title ?? "HEIMATPLATZ";

// Wie Uno MainPage NavigationView.MenuItems
const navItems = [
  { label: t("nav.home"), href: "/", icon: HomeIcon },
  { label: t("nav.myProperties"), href: "/meine-immobilien/", icon: HomeIcon },
  { label: t("nav.myFavorites"), href: "/favoriten/", icon: HeartIcon },
  { label: t("nav.blockedProperties"), href: "/blockiert/", icon: ShieldOffIcon },
  // Inserieren erfordert ein Konto - Gaeste sehen den Eintrag nicht (PropertyStateScript blendet ein)
  { label: t("nav.addProperty"), href: "/inserieren/", icon: PlusIcon, separator: true, authOnly: true },
];

// Wie Uno NavigationView.FooterMenuItems
const navFooterItems = [
  { label: t("nav.notifications"), href: "/benachrichtigungen/", icon: BellIcon },
  { label: t("nav.filterSettings"), href: "/filter-einstellungen/", icon: FilterIcon },
  // Nur auf Debug-Hosts (localhost/LAN-IP) sichtbar - Client-Script blendet ein
  { label: t("nav.debug"), href: "/debug/", icon: BugIcon, debugOnly: true },
];

function isActive(href: string) {
  return href === "/" ? pathname === "/" : pathname.startsWith(href);
}
---

{/* Blur liegt auf der Zeile statt auf <header>: backdrop-filter macht das Element
    zum Containing Block, der fixe Drawer darunter muesste sonst am Header kleben */}
<header class="sticky top-0 z-40 border-b border-border">
  <div class="flex h-14 items-center justify-between gap-3 bg-background px-3 supports-[backdrop-filter]:bg-background/85 supports-[backdrop-filter]:backdrop-blur-md sm:px-4">
    {/* min-w-0 OHNE shrink-0: lange Seitentitel (z.B. "Blockierte Immobilien")
        muessen auf schmalen Screens truncaten, sonst schiebt der Header den
        Avatar aus dem Viewport (horizontaler Overflow) */}
    <div class="flex min-w-0 items-center gap-1">
      <button
        type="button"
        class="grid size-10 place-items-center rounded-md text-foreground hover:bg-accent hover:text-accent-foreground"
        aria-label={t("nav.openNavigation")}
        aria-expanded="false"
        data-site-nav-toggle
      >
        <MenuIcon class="size-5" aria-hidden="true" />
      </button>
      <a href="/" class="flex min-w-0 items-center gap-2.5 px-1 text-foreground" aria-label={t("nav.homeAriaLabel")}>
        <BrandMark class="h-8" />
        <span class="block truncate text-xs font-extrabold uppercase tracking-[0.14em] sm:text-sm">{currentTitle}</span>
      </a>
    </div>

    {
      showFilters && (
        <form action="/" method="get" class="hidden min-w-0 flex-1 items-center justify-center gap-2 xl:flex">
          <div class="w-44">
            <OrtPicker name="region" placeholder={t("filter.locationPlaceholder")} regions={ortRegions.length > 0 ? ortRegions : undefined} />
          </div>
          <NativeSelect name="age" class="w-32" data-filter-age>
            <option value="">{t("filter.period")}</option>
            <option value="day">{t("filter.period24h")}</option>
            <option value="week">{t("filter.period7d")}</option>
            <option value="month">{t("filter.period30d")}</option>
            <option value="year">{t("filter.period1y")}</option>
          </NativeSelect>
          <button type="button" class="rounded-md border border-primary bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors" data-filter-type="house" aria-pressed="true">
            {t("filter.typeHouse")}
          </button>
          <button type="button" class="rounded-md border border-primary bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors" data-filter-type="land" aria-pressed="true">
            {t("filter.typeLand")}
          </button>
          <button type="button" class="rounded-md border border-primary bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors" data-filter-type="foreclosure" aria-pressed="true">
            {t("filter.typeForeclosure")}
          </button>
          <div class="flex items-center gap-2" data-seller-filter-group>
            <span class="mx-1 h-6 w-px bg-border" aria-hidden="true" />
            <button type="button" class="rounded-md border border-primary bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors" data-filter-seller-chip="private" aria-pressed="true">
              {t("filter.sellerPrivate")}
            </button>
            <button type="button" class="rounded-md border border-primary bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors" data-filter-seller-chip="agent" aria-pressed="true">
              {t("filter.sellerAgent")}
            </button>
            <button type="button" class="rounded-md border border-primary bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors" data-filter-seller-chip="court" aria-pressed="true">
              {t("filter.sellerPortal")}
            </button>
          </div>
        </form>
      )
    }

    <div class="flex shrink-0 items-center gap-1.5">
      <ThemeToggle />
      <div class="hidden items-center gap-2 sm:flex">
        <Button href="/anmelden/" variant="ghost" size="sm" data-guest-only>
          {t("common.login")}
        </Button>
        <Button href="/registrieren/" variant="default" size="sm" data-guest-only>
          {t("common.register")}
        </Button>
      </div>
      {/* Initialen-Avatar im Marken-Rot wie die CTA-Buttons (--primary folgt dem
          Theme, kein greller Weiss-Kreis im Dark Mode); Hover dunkelt ab,
          Name + E-Mail kommen als Tooltip */}
      <a
        href="/profil/"
        class="grid size-9 shrink-0 place-items-center rounded-full bg-primary text-xs font-bold text-primary-foreground transition-colors outline-none hover:bg-primary-accent focus-visible:ring-3 focus-visible:ring-primary/50"
        aria-label={t("nav.myProfile")}
        data-auth-only
        data-auth-tooltip
        hidden
      >
        <span data-auth-initials aria-hidden="true">?</span>
      </a>
    </div>
  </div>

  <div class="fixed inset-0 z-50 bg-black/35" data-site-nav-overlay hidden></div>
  <aside
    class="fixed inset-y-0 left-0 z-50 flex w-[min(20rem,calc(100vw-2rem))] -translate-x-full flex-col border-r border-border bg-background shadow-xl transition-transform duration-200"
    aria-label={t("nav.drawerAriaLabel")}
    aria-hidden="true"
    inert
    data-site-nav-panel
  >
    <div class="flex h-14 items-center justify-between border-b border-border px-4">
      <a href="/" class="flex items-center gap-2.5 font-extrabold uppercase tracking-[0.14em]">
        <BrandMark class="h-7" />
        Heimatplatz
      </a>
      <button type="button" class="grid size-10 place-items-center rounded-md text-foreground hover:bg-accent hover:text-accent-foreground" aria-label={t("nav.closeNavigation")} data-site-nav-close>
        <XIcon class="size-5" aria-hidden="true" />
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-3 py-4">
      <div class="space-y-1">
        {navItems.map((item) => {
          const Icon = item.icon;
          const active = isActive(item.href);
          return (
            <>
              {item.separator && (
                <div
                  class="my-2 border-t border-border"
                  aria-hidden="true"
                  data-auth-only={item.authOnly ? "" : undefined}
                  hidden={item.authOnly ? true : undefined}
                />
              )}
              <a
                href={item.href}
                class:list={[
                  "flex min-h-10 items-center gap-3 rounded-md px-3 text-sm font-medium",
                  active ? "bg-accent text-accent-foreground" : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
                ]}
                aria-current={active ? "page" : undefined}
                data-auth-only={item.authOnly ? "" : undefined}
                hidden={item.authOnly ? true : undefined}
              >
                <Icon class="size-4" aria-hidden="true" />
                <span>{item.label}</span>
              </a>
            </>
          );
        })}
      </div>

      <div class="mt-6 space-y-2 px-3" data-guest-only>
        <Button href="/anmelden/" variant="outline" class="w-full justify-start">
          <LoginIcon class="size-4" aria-hidden="true" />
          {t("common.login")}
        </Button>
        <Button href="/registrieren/" class="w-full justify-start">
          <UserPlusIcon class="size-4" aria-hidden="true" />
          {t("common.register")}
        </Button>
      </div>
    </div>

    <div class="border-t border-border px-3 py-3 space-y-1">
      {navFooterItems.map((item) => {
        const Icon = item.icon;
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              "flex min-h-10 items-center gap-3 rounded-md px-3 text-sm font-medium",
              active ? "bg-accent text-accent-foreground" : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
            ]}
            aria-current={active ? "page" : undefined}
            data-debug-only={item.debugOnly ? "" : undefined}
            hidden={item.debugOnly ? true : undefined}
          >
            <Icon class="size-4" aria-hidden="true" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>

    <div class="border-t border-border p-3" data-auth-only hidden>
      <div class="mb-2 flex items-center gap-3 rounded-md bg-muted px-3 py-2.5">
        <span class="grid size-9 shrink-0 place-items-center rounded-full bg-primary text-xs font-bold text-primary-foreground" data-auth-initials aria-hidden="true">?</span>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold" data-auth-name>{t("nav.notSignedIn")}</p>
          <p class="truncate text-xs text-muted-foreground" data-auth-email></p>
        </div>
      </div>
      <a href="/profil/" class="flex min-h-10 items-center gap-3 rounded-md px-3 text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground">
        <UserIcon class="size-4" aria-hidden="true" />
        <span>{t("nav.myProfile")}</span>
      </a>
      <button type="button" class="mt-1 w-full rounded-md px-3 py-2 text-left text-sm font-medium text-muted-foreground hover:bg-accent hover:text-accent-foreground" data-logout>
        {t("common.logout")}
      </button>
    </div>
  </aside>
</header>

<script>
  import { isDebugHost } from "@/lib/utils/debug-host";

  // Debug-Eintrag nur einblenden, wenn die Seite vom Entwicklungs-PC (localhost/LAN) laeuft
  if (isDebugHost()) {
    document.querySelectorAll<HTMLElement>("[data-debug-only]").forEach((element) => {
      element.hidden = false;
    });
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-site-nav-toggle]");
  const close = document.querySelector<HTMLButtonElement>("[data-site-nav-close]");
  const panel = document.querySelector<HTMLElement>("[data-site-nav-panel]");
  const overlay = document.querySelector<HTMLElement>("[data-site-nav-overlay]");

  function setOpen(open: boolean) {
    toggle?.setAttribute("aria-expanded", String(open));
    panel?.classList.toggle("-translate-x-full", !open);
    panel?.setAttribute("aria-hidden", String(!open));
    panel?.toggleAttribute("inert", !open);
    overlay?.toggleAttribute("hidden", !open);
    document.documentElement.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  close?.addEventListener("click", () => setOpen(false));
  overlay?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
</script>
