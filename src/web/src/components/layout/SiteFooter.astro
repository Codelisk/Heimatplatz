---
import BrandMark from "@/components/layout/BrandMark.astro";
import type { ContactInfo } from "@/features/legal/api";
import { t } from "@/i18n";

interface Props {
  contact: ContactInfo;
}

const { contact } = Astro.props;
const year = new Date().getFullYear();

// Nur gepflegte Werte verlinken - eine fehlende Telefonnummer soll keine leere Zeile und
// kein "tel:" ohne Ziel erzeugen. Gepflegt wird unter /intern/kontakt, nicht hier.
const contactItems = [
  contact.supportEmail && { href: `mailto:${contact.supportEmail}`, label: contact.supportEmail },
  contact.phone && contact.phoneLink && { href: `tel:${contact.phoneLink}`, label: contact.phone },
].filter((item): item is { href: string; label: string } => Boolean(item));
---

<footer class="border-t border-border bg-card">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex items-center gap-2.5">
      <BrandMark class="h-7" />
      <div>
        <p class="text-sm font-extrabold uppercase tracking-[0.14em]">Heimatplatz</p>
        <p class="text-xs text-muted-foreground">{t("footer.tagline")}</p>
      </div>
    </div>
    <div class="flex flex-col gap-2 sm:items-end">
      {
        contactItems.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground">
            {contactItems.map((item) => (
              <a class="transition-colors hover:text-foreground" href={item.href}>
                {item.label}
              </a>
            ))}
            {contact.officeHours && <span>{contact.officeHours}</span>}
          </div>
        )
      }
      <nav
        class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted-foreground"
        aria-label={t("footer.legalAriaLabel")}
      >
        {
          contact.socialLinks.map((link) => (
            <a
              class="transition-colors hover:text-foreground"
              href={link.url}
              rel="noopener noreferrer"
              target="_blank"
            >
              {link.platform}
            </a>
          ))
        }
        <a class="transition-colors hover:text-foreground" href="/partner/">{t("footer.partners")}</a>
        <a class="transition-colors hover:text-foreground" href="/makler/">{t("footer.forBrokers")}</a>
        <a class="transition-colors hover:text-foreground" href="/impressum/">{t("footer.imprint")}</a>
        <a class="transition-colors hover:text-foreground" href="/datenschutz/">{t("footer.privacy")}</a>
        <span>{t("footer.copyright", { year })}</span>
      </nav>
    </div>
  </div>
</footer>
