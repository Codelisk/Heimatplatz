---
import BrandMark from "@/components/layout/BrandMark.astro";
import { t } from "@/i18n";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-card">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex items-center gap-2.5">
      <BrandMark class="h-7" />
      <div>
        <p class="text-sm font-extrabold uppercase tracking-[0.14em]">Heimatplatz</p>
        <p class="text-xs text-muted-foreground">{t("footer.tagline")}</p>
      </div>
    </div>
    <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-muted-foreground" aria-label={t("footer.legalAriaLabel")}>
      <a class="transition-colors hover:text-foreground" href="/impressum/">{t("footer.imprint")}</a>
      <a class="transition-colors hover:text-foreground" href="/datenschutz/">{t("footer.privacy")}</a>
      <span>{t("footer.copyright", { year })}</span>
    </nav>
  </div>
</footer>
