<?xml version="1.0" encoding="UTF-8" ?>
<shiny:ShinyShell
    x:Class="Heimatplatz.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
    xmlns:properties="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
    xmlns:auth="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
    Title="Heimatplatz"
    FlyoutBehavior="Flyout">

    <Shell.FlyoutHeader>
        <Grid Padding="20,32,20,20"
              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}">
            <VerticalStackLayout Spacing="4">
                <Label Text="HEIMATPLATZ"
                       FontSize="16"
                       FontAttributes="Bold"
                       CharacterSpacing="4"
                       TextColor="{StaticResource White}" />
                <Label Text="Immobilien in Ihrer Region"
                       FontSize="12"
                       TextColor="{StaticResource Gray300}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Startseite als verstecktes ShellContent; der Flyout-Eintrag ist ein MenuItem mit
         absoluter Route, damit der Navigation-Stack auch von gepushten Seiten
         (z.B. Meine Immobilien) zurueck zur Startseite aufgeloest wird.
         Ein sichtbares FlyoutItem wuerde bei erneutem Klick auf das aktive Item nichts tun. -->
    <ShellContent
        Title="Startseite"
        ContentTemplate="{DataTemplate properties:HomePage}"
        Route="MainPage"
        FlyoutItemIsVisible="False" />

    <!-- Login als verstecktes ShellContent, damit absolute Navigation (//Login) beim Logout funktioniert -->
    <ShellContent
        Title="Anmelden"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="Login"
        FlyoutItemIsVisible="False" />

    <MenuItem Text="Startseite" shiny:Navigate.Route="///MainPage" />
    <MenuItem Text="Meine Immobilien" shiny:Navigate.Route="MyProperties" />
    <MenuItem Text="Favoriten" shiny:Navigate.Route="Favorites" />
    <MenuItem Text="Blockiert" shiny:Navigate.Route="Blocked" />
    <!-- Route wird im Code-Behind gesetzt: KI-Flow auf Phones, manuell sonst -->
    <MenuItem x:Name="AddPropertyMenuItem" Text="Immobilie hinzufügen" shiny:Navigate.Route="AddProperty" />
    <MenuItem Text="Benachrichtigungen" shiny:Navigate.Route="NotificationSettings" />
    <MenuItem Text="Filtereinstellungen" shiny:Navigate.Route="FilterPreferences" />
    <MenuItem Text="Profil" shiny:Navigate.Route="UserProfile" />
    <MenuItem Text="Impressum" shiny:Navigate.Route="Imprint" />
    <MenuItem Text="Datenschutz" shiny:Navigate.Route="PrivacyPolicy" />

</shiny:ShinyShell>
