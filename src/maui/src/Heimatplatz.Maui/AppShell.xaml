<?xml version="1.0" encoding="UTF-8" ?>
<shiny:ShinyShell
    x:Class="Heimatplatz.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
    xmlns:local="clr-namespace:Heimatplatz.Maui"
    xmlns:controls="clr-namespace:Heimatplatz.Maui.Controls"
    xmlns:properties="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
    xmlns:auth="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
    xmlns:notifications="clr-namespace:Heimatplatz.Maui.Features.Notifications.Presentation"
    xmlns:feedback="clr-namespace:Heimatplatz.Maui.Features.Feedback.Presentation"
    x:DataType="local:AppShell"
    Title="Heimatplatz"
    FlyoutBehavior="Flyout"
    FlyoutWidth="300"
    FlyoutBackdrop="{StaticResource ScrimColor}"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <!-- Selbstgebaute Flyout-Liste statt Shell-ItemTemplate/MenuItemTemplate:
         Der Android-Flyout-Adapter (RecyclerView) hat Zeilen nach mehreren Rebinds
         falsch verdrahtet - Tap auf einen Eintrag loeste die Aktion eines anderen aus
         (z.B. "Benachrichtigungen" -> KI-Inserat). Hier haengt jeder Tap-Handler direkt
         am gebundenen Eintrag; die Eintraege baut der Code-Behind aus den Shell-Items. -->
    <Shell.FlyoutContent>
        <ScrollView>
            <VerticalStackLayout x:Name="FlyoutMenuList" Padding="0,8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="local:FlyoutMenuEntry">
                        <!-- Gerundete Zeile, Icon + Text; Auswahl als warmer Rot-Tint auf dem
                             inneren Grid (DataTrigger), Hover auf dem Border (VSM) - getrennte
                             Ebenen, damit sich Zustaende nicht gegenseitig ueberschreiben. -->
                        <Border Margin="12,2"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                HeightRequest="50"
                                AutomationId="{Binding AutomationId}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFlyoutEntryTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="14,0">
                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RedTint}, Dark={StaticResource RedTintDark}}" />
                                    </DataTrigger>
                                </Grid.Triggers>

                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontFamily="SansMedium"
                                       FontSize="14.5"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Shell.FlyoutContent>

    <Shell.FlyoutHeader>
        <!-- Galerie-Header: Light als warme Papierflaeche mit sanftem Markenrot-Tint,
             Dark weiterhin als warme dunkle Karte. So fuegt sich der Header ins jeweilige
             Theme ein, ohne die klare Markenwirkung zu verlieren. -->
        <Grid Padding="20,44,20,22"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="14">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                  Offset="0" />
                    <GradientStop Color="{AppThemeBinding Light={StaticResource RedTint}, Dark={StaticResource CardBackgroundDark}}"
                                  Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Rundes Abzeichen mittig auf weisser Karte. -->
            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource White}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    WidthRequest="56"
                    HeightRequest="56"
                    Padding="5">
                <Image Source="logo.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="5"
                                 VerticalOptions="Center">
                <Label Text="HEIMATPLATZ"
                       FontFamily="SansBold"
                       FontSize="16"
                       CharacterSpacing="4"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Label Text="{Binding Loc.Tagline}"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <controls:FlagBand Margin="0,3,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Sichtbare Shell-Roots: Das Framework regelt das Navigations-Icon selbst -
         Hamburger auf den Root-Seiten, Zurueck-Pfeil nur auf gepushten Detailseiten. -->
    <ShellContent
        Title="{Binding Loc.HomeTitle}"
        Icon="icon_home.png"
        ContentTemplate="{DataTemplate properties:HomePage}"
        Route="MainPage" />
    <ShellContent
        Title="{Binding Loc.MyPropertiesTitle}"
        Icon="icon_buildings.png"
        ContentTemplate="{DataTemplate properties:MyPropertiesPage}"
        Route="MyProperties" />
    <ShellContent
        Title="{Binding Loc.FavoritesTitle}"
        Icon="icon_heart.png"
        ContentTemplate="{DataTemplate properties:FavoritesPage}"
        Route="Favorites" />
    <ShellContent
        Title="{Binding Loc.BlockedTitle}"
        Icon="icon_block.png"
        ContentTemplate="{DataTemplate properties:BlockedPage}"
        Route="Blocked" />
    <ShellContent
        Title="{Binding Loc.NotificationsTitle}"
        Icon="icon_bell.png"
        ContentTemplate="{DataTemplate notifications:NotificationSettingsPage}"
        Route="NotificationSettings" />
    <ShellContent
        Title="{Binding Loc.FeedbackTitle}"
        Icon="icon_feedback.png"
        ContentTemplate="{DataTemplate feedback:FeedbackListPage}"
        Route="Feedback" />
    <ShellContent
        Title="{Binding Loc.ProfileTitle}"
        Icon="icon_user.png"
        ContentTemplate="{DataTemplate auth:UserProfilePage}"
        Route="UserProfile" />
    <!-- Login als verstecktes ShellContent, damit absolute Navigation (//Login) beim Logout funktioniert -->
    <ShellContent
        Title="{Binding Loc.LoginTitle}"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="Login"
        FlyoutItemIsVisible="False" />

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,12,20,20" Spacing="10">
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" />

            <!-- Rechtliches dezent im Footer statt als eigene Menuepunkte -->
            <HorizontalStackLayout Spacing="6">
                <Label Text="{Binding Loc.ImprintLink}"
                       FontSize="11"
                       TextDecorations="Underline"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       AutomationId="Flyout_ImprintLink">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImprintTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="·"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding Loc.PrivacyLink}"
                       FontSize="11"
                       TextDecorations="Underline"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       AutomationId="Flyout_PrivacyPolicyLink">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Label x:Name="VersionLabel"
                   FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</shiny:ShinyShell>
