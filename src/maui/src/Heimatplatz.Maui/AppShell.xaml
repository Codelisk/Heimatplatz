<?xml version="1.0" encoding="UTF-8" ?>
<shiny:ShinyShell
    x:Class="Heimatplatz.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
    xmlns:properties="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
    xmlns:auth="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
    xmlns:notifications="clr-namespace:Heimatplatz.Maui.Features.Notifications.Presentation"
    Title="Heimatplatz"
    FlyoutBehavior="Flyout"
    FlyoutWidth="300"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <Shell.Resources>
        <!-- Einheitliches Erscheinungsbild aller Flyout-Eintraege (FlyoutItems und MenuItems):
             Icon + Text. BindingContext ist das jeweilige BaseShellItem; MenuShellItems spiegeln
             Text/IconImageSource des MenuItems auf Title/Icon (siehe SyncMenuItemIcons). -->
        <DataTemplate x:Key="FlyoutEntryTemplate" x:DataType="BaseShellItem">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="14"
                  Padding="20,0"
                  HeightRequest="48">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <Image Grid.Column="0"
                       Source="{Binding Icon}"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="14"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </Grid>
        </DataTemplate>
    </Shell.Resources>

    <!-- ItemTemplate + MenuItemTemplate werden im Code-Behind auf FlyoutEntryTemplate gesetzt -->

    <Shell.FlyoutHeader>
        <Grid Padding="20,40,20,24"
              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="14">

            <!-- Rundes Abzeichen mittig auf weisser Karte. -->
            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource White}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="56"
                    HeightRequest="56"
                    Padding="5">
                <Image Source="logo.png"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 VerticalOptions="Center">
                <Label Text="HEIMATPLATZ"
                       FontSize="16"
                       FontAttributes="Bold"
                       CharacterSpacing="3"
                       TextColor="{StaticResource White}" />
                <Label Text="Immobilien in Ihrer Region"
                       FontSize="12"
                       TextColor="{StaticResource Gray300}" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Sichtbare Shell-Roots: Das Framework regelt das Navigations-Icon selbst -
         Hamburger auf den Root-Seiten, Zurueck-Pfeil nur auf gepushten Detailseiten. -->
    <ShellContent
        Title="Startseite"
        Icon="icon_home.png"
        ContentTemplate="{DataTemplate properties:HomePage}"
        Route="MainPage" />
    <!-- Gleiche eigenstaendige Seite wie ueber das Filter-Symbol der Startseite.
         Als MenuItem bleibt die Startseite Shell-Root und ihr Hamburger stabil sichtbar. -->
    <MenuItem x:Name="FilterSettingsMenuItem"
              Text="Filtereinstellungen"
              IconImageSource="icon_filter.png"
              Clicked="OnFilterSettingsTapped" />
    <ShellContent
        Title="Meine Immobilien"
        Icon="icon_buildings.png"
        ContentTemplate="{DataTemplate properties:MyPropertiesPage}"
        Route="MyProperties" />
    <ShellContent
        Title="Favoriten"
        Icon="icon_heart.png"
        ContentTemplate="{DataTemplate properties:FavoritesPage}"
        Route="Favorites" />
    <ShellContent
        Title="Blockiert"
        Icon="icon_block.png"
        ContentTemplate="{DataTemplate properties:BlockedPage}"
        Route="Blocked" />
    <ShellContent
        Title="Benachrichtigungen"
        Icon="icon_bell.png"
        ContentTemplate="{DataTemplate notifications:NotificationSettingsPage}"
        Route="NotificationSettings" />
    <ShellContent
        Title="Profil"
        Icon="icon_user.png"
        ContentTemplate="{DataTemplate auth:UserProfilePage}"
        Route="UserProfile" />
    <!-- Login als verstecktes ShellContent, damit absolute Navigation (//Login) beim Logout funktioniert -->
    <ShellContent
        Title="Anmelden"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="Login"
        FlyoutItemIsVisible="False" />

    <!-- Aktion statt Ziel: pusht die Erfassungsseite (mit Zurueck-Pfeil zum Abbrechen).
         Route wird im Code-Behind gesetzt: KI-Flow auf Phones, manuell sonst -->
    <MenuItem x:Name="AddPropertyMenuItem" Text="Immobilie hinzufügen" IconImageSource="icon_add.png" />

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,12,20,20" Spacing="10">
            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" />

            <!-- Rechtliches dezent im Footer statt als eigene Menuepunkte -->
            <HorizontalStackLayout Spacing="6">
                <Label Text="Impressum"
                       FontSize="11"
                       TextDecorations="Underline"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       AutomationId="Flyout_ImprintLink">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnImprintTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="·"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Label Text="Datenschutz"
                       FontSize="11"
                       TextDecorations="Underline"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                       AutomationId="Flyout_PrivacyPolicyLink">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrivacyPolicyTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Label x:Name="VersionLabel"
                   FontSize="11"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</shiny:ShinyShell>
