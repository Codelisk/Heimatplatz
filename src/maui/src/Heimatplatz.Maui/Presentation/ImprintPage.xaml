<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Controls"
             xmlns:presentation="clr-namespace:Heimatplatz.Maui.Presentation"
             x:Class="Heimatplatz.Maui.Presentation.ImprintPage"
             x:DataType="presentation:ImprintViewModel"
             controls:DeferredFlyoutLock.IsEnabled="True"
             Title="{Binding Loc.PageTitle}">
    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <Border Style="{StaticResource ErrorBanner}"
                IsVisible="{Binding HasError}"
                Margin="16"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorBannerText}" />
        </Border>

        <ScrollView IsVisible="{Binding IsLoaded}">
            <VerticalStackLayout Padding="16,24"
                                 Spacing="12"
                                 MaximumWidthRequest="700"
                                 HorizontalOptions="Fill">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding CompanyLine}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding OwnerLine}" />
                        <Label Text="{Binding AddressLine}" />
                        <Label Text="{Binding EmailLine}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               AutomationId="Imprint_EmailLink">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenEmailCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{Binding PhoneLine}"
                               IsVisible="{Binding HasPhone}"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                               AutomationId="Imprint_PhoneLink">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPhoneCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Text="{Binding UidLine}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="16"
                                     Margin="0,8,0,0"
                                     BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="api:LegalSectionDto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                <Label controls:AutoLink.Text="{Binding Content}" LineHeight="1.3" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding VersionLine}"
                       Style="{StaticResource Caption}"
                       Margin="0,12,0,24" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
