<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:presentation="clr-namespace:Heimatplatz.Maui.Presentation"
             x:Class="Heimatplatz.Maui.Presentation.PrivacyPolicyPage"
             x:DataType="presentation:PrivacyPolicyViewModel"
             Shell.FlyoutBehavior="Disabled"
             Title="Datenschutz">
    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <Border Style="{StaticResource ErrorBanner}"
                IsVisible="{Binding HasError}"
                Margin="16"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorBannerText}" />
        </Border>

        <ScrollView IsVisible="{Binding IsLoaded}">
            <VerticalStackLayout Padding="16,24"
                                 Spacing="12"
                                 MaximumWidthRequest="700"
                                 HorizontalOptions="Fill">
                <Label Text="{Binding ResponsibleParty}" />

                <VerticalStackLayout Spacing="16"
                                     Margin="0,8,0,0"
                                     BindableLayout.ItemsSource="{Binding Sections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="api:LegalSectionDto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding Content}" LineHeight="1.3" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding VersionLine}"
                       Style="{StaticResource Caption}"
                       Margin="0,12,0,24" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
