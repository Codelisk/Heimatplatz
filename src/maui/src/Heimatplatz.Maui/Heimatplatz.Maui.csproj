<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Heimatplatz.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <!-- XAML-Baume per Source Generator statt zur Laufzeit erzeugen. -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- RelativeSource-Bindings in Karten/Listen ebenfalls kompilieren. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <!-- Shiny MAUI Shell Source Generation -->
    <ShinyMauiShell_GenerateRouteConstants>true</ShinyMauiShell_GenerateRouteConstants>
    <ShinyMauiShell_GenerateNavExtensions>true</ShinyMauiShell_GenerateNavExtensions>
    <ShinyMauiShell_GenerateAiExtensions>false</ShinyMauiShell_GenerateAiExtensions>
    <!-- Warnungen aus generiertem OpenAPI-Client-Code (wie Uno Core.ApiClient) -->
    <!-- CS8669: Nullable annotation context, CS9107: Captured parameter -->
    <WarningsNotAsErrors>CS8669;CS9107</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS8669;CS9107;IL2026</NoWarn>
    <!-- Display name -->
    <ApplicationTitle>Heimatplatz</ApplicationTitle>
    <!-- App Identifier (identisch zur Uno-App) -->
    <ApplicationId>at.heimatplatz.app</ApplicationId>
    <!-- Versionen: werden beim Deploy von der Pipeline gesetzt (siehe Uno-App) -->
    <ApplicationDisplayVersion>1.83.0</ApplicationDisplayVersion>
    <ApplicationVersion>84</ApplicationVersion>
    <!-- Emulator-Screenshot-Builds (Cake AndroidScreenshots): nur die Emulator-ABI.
		     Eigene Property statt globalem RuntimeIdentifiers, weil globale MSBuild-Props
		     in ProjectReferences (ApiClient, plain net10.0) lecken und dort die
		     Output-Pfade brechen (MSB3030). -->
    <RuntimeIdentifiers Condition="'$(ScreenshotRuntimeIdentifier)' != '' AND $(TargetFramework.Contains('-android'))">$(ScreenshotRuntimeIdentifier)</RuntimeIdentifiers>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged nutzt fuer Taskbar/Alt-Tab das im EXE eingebettete Icon; eigenes Multi-Size-ICO
         (16-256px) statt des von MAUI generierten Einzel-64px-Eintrags -->
    <ApplicationIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">Platforms\Windows\appicon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <!-- iOS Push Entitlements: Debug tokens use APNs sandbox, Release/TestFlight production -->
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND '$(Configuration)' == 'Debug'">Platforms\iOS\Entitlements.Debug.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND '$(Configuration)' != 'Debug'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <!-- MAUI DevFlow braucht in Debug-Builds eingehende Netzwerkverbindungen (In-App-HTTP-Server) -->
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' AND '$(Configuration)' == 'Debug'">Platforms\MacCatalyst\Entitlements.Debug.plist</CodesignEntitlements>
    <!-- Android minimum SDK 23 (Firebase-Anforderung, wie Uno-App) -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- iOS-App-Icon per Name aus dem manuellen Asset-Catalog (AppIcon.appiconset).
         Bewusst die AppIcon-Property statt XSAppIconAssets im Info.plist: der Plist-Weg
         braucht den logischen Pfad nach Prefix-Strip - mit falschem Pfad kompiliert actool
         das Icon-Set nicht als App-Icon und CFBundleIconName fehlt (TestFlight-Upload
         schlug mit ITMS-90713 fehl, Build 78). -->
    <AppIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">AppIcon</AppIcon>
  </PropertyGroup>
  <!-- Auslieferungskanal (Development|Internal|Production, siehe Core/Build/AppChannels.cs).
       Steuert, ob die App Entwicklerwerkzeuge (Flyout "Debug", API-Umschalter) freischaltet.
       Debug ist immer Development, Release ohne explizite Angabe immer Production - ein
       versehentlich ohne Parameter gebauter Store-Release kann die Werkzeuge also nie zeigen.
       Interne Android-Builds setzen den Kanal explizit:
         dotnet publish -f net10.0-android -c Release -p:HeimatplatzChannel=Internal
       (macht cake/Tasks/BuildAndroidTask.cs automatisch fuer alle Nicht-Production-Tracks).
       iOS braucht den Schalter NICHT: dort erkennt AppChannels TestFlight zur Laufzeit,
       weil derselbe Build spaeter zur App-Store-Version befoerdert wird. -->
  <PropertyGroup>
    <HeimatplatzChannel Condition="'$(HeimatplatzChannel)' == '' AND '$(Configuration)' == 'Debug'">Development</HeimatplatzChannel>
    <HeimatplatzChannel Condition="'$(HeimatplatzChannel)' == ''">Production</HeimatplatzChannel>
    <DefineConstants Condition="'$(HeimatplatzChannel)' == 'Internal'">$(DefineConstants);HEIMATPLATZ_INTERNAL</DefineConstants>
  </PropertyGroup>
  <Target Name="_HeimatplatzValidateChannel" BeforeTargets="BeforeBuild">
    <Error Condition="'$(HeimatplatzChannel)' != 'Development' AND '$(HeimatplatzChannel)' != 'Internal' AND '$(HeimatplatzChannel)' != 'Production'"
           Text="HeimatplatzChannel muss Development, Internal oder Production sein (ist: '$(HeimatplatzChannel)')." />
    <!-- In Debug gewinnt ohnehin die DEBUG-Konstante: der Kanal waere nur scheinbar gesetzt -->
    <Warning Condition="'$(Configuration)' == 'Debug' AND '$(HeimatplatzChannel)' != 'Development'"
             Text="HeimatplatzChannel='$(HeimatplatzChannel)' wird in Debug-Builds ignoriert - Debug ist immer Development." />
    <Message Importance="high" Text="Heimatplatz-Auslieferungskanal: $(HeimatplatzChannel)" />
  </Target>
  <ItemGroup>
    <!-- App Icon: pro Plattform - es gilt nur das ERSTE passende Item, konditionale muessen vor dem Default stehen -->
    <!-- Android Adaptive Icon: Background full-bleed Markenrot, Badge bleibt in der 66dp-Safe-Zone (66/108, Badge fuellt 97.5% der ViewBox -> 0.62) -->
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#9F1519" ForegroundScale="0.62" />
    <!-- Windows: transparenter Background (Taskbar/Start erwarten Icons ohne Farbplatte), vereinfachtes Badge ohne Textring -->
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" Include="Resources\AppIcon\appiconwin.svg" ForegroundFile="Resources\AppIcon\appiconfgwin.svg" />
    <!-- MacCatalyst: opak (App-Store-Connect-Pflicht), Badge ~75% nach Apple Icon Grid.
         iOS laeuft NICHT mehr ueber MauiIcon: dort kommt das Icon aus dem manuellen
         Asset-Catalog Platforms/iOS/Resources/Assets.xcassets (iOS-18-Dark-/Tinted-Varianten,
         dotnet/maui#25572; PNGs generiert GenerateStoreArt aus den Logo-Mastern).
         Eingesammelt wird das Catalog automatisch (ImageAsset-Default-Glob **\*.xcassets\**),
         verdrahtet ueber die AppIcon-Property oben (Name-basiert, kein Pfad-Gefrickel). -->
    <MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#9F1519" ForegroundScale="0.75" />
    <!-- Splash Screen: iOS nutzt stattdessen Platforms/iOS/LaunchScreen.storyboard mit
         Named Color (Manila/OffBlack) - das generierte Storyboard kann keinen Dark Mode -->
    <MauiSplashScreen Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'" Include="Resources\Splash\splash.svg" Color="#F6ECD8" BaseSize="256,256" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <!-- Logo (quadratisches Abzeichen, 480x480-Quelle) auf sinnvolle Anzeigegroesse skalieren -->
    <MauiImage Update="Resources\Images\logo.svg" BaseSize="120,120" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generierter OpenAPI-Client (eigenes Projekt: Source-Gen-Typen als Assembly-Referenz) -->
    <ProjectReference Include="..\Heimatplatz.Maui.ApiClient\Heimatplatz.Maui.ApiClient.csproj" />
    <!-- Deutsche UI-Texte (eigenes Projekt: *Localized-Typen als Assembly-Referenz, s. dort README) -->
    <ProjectReference Include="..\Heimatplatz.Maui.Localization\Heimatplatz.Maui.Localization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Shiny -->
    <PackageReference Include="Shiny.Maui.Shell" />
    <PackageReference Include="Shiny.Maui.Controls" />
    <PackageReference Include="Shiny.Extensions.MauiHosting" />
    <PackageReference Include="Shiny.Extensions.DependencyInjection" />
    <PackageReference Include="Shiny.Extensions.Stores" />
    <PackageReference Include="Shiny.Extensions.Serialization" />
    <PackageReference Include="Shiny.Mediator" />
    <PackageReference Include="Shiny.Mediator.Maui" />
    <PackageReference Include="Shiny.DocumentDb.Sqlite" />
    <PackageReference Include="Shiny.Hosting.Maui" />
    <PackageReference Include="Shiny.Push" />
    <PackageReference Include="Shiny.Notifications" />
    <!-- Native MapLibre-Karte (Vector-Tiles/PMTiles + Papier-Stil wie im Web);
         Handlers-Paket noetig, das Hauptpaket liefert nur native Libs + Geometry -->
    <PackageReference Include="MapLibreNative.Maui" />
    <PackageReference Include="MapLibreNative.Maui.Handlers" />
  </ItemGroup>
  <!-- MAUI DevFlow (Debug-only Runtime-Automation/-Diagnose) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
  </ItemGroup>
  <!-- Shiny.Speech: Diktat fuer KI-gestuetzte Inseratserstellung (nur Android/iOS Phones) -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) OR $(TargetFramework.Contains('-ios'))">
    <PackageReference Include="Shiny.Speech" />
  </ItemGroup>
  <!-- Android In-App Updates (Google Play Core) -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.Google.Android.Play.App.Update" />
  </ItemGroup>
  <!-- Firebase Push Konfiguration (aus der Uno-App uebernommen) -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('-maccatalyst'))">
    <BundleResource Include="Platforms\iOS\GoogleService-Info.plist" Condition="Exists('Platforms\iOS\GoogleService-Info.plist')" />
  </ItemGroup>
  <!-- 16-KB-Seitengroesse (Play-Warnung "aeltere Android NDK-Version"):
       libdatastore_shared_counter.so aus AndroidX DataStore traegt die NDK-Kennung r20,
       Play verlangt r28+. Ausrichtung stimmt zwar (p_align 0x4000), die Kennung reicht
       Play aber als Warnung. Auch das neueste Paket (Xamarin.AndroidX.DataStore.* 1.2.1.1)
       bringt keine neuere Kennung mit - upstream muss die Lib erst neu bauen.
       Die Lib kommt transitiv ueber Xamarin.Firebase.Common herein, geladen wird sie aber
       ausschliesslich von androidx.datastore.core.MultiProcessCoordinator (einzige Klasse
       mit System.loadLibrary("datastore_shared_counter") ist SharedCounter$Factory, und die
       haengt nur am Multi-Process-Pfad). Der einzige Firebase-Nutzer von
       MultiProcessDataStoreFactory ist firebase-sessions, das nur ueber Crashlytics kommt -
       beides referenziert diese App nicht. Ohne Aufrufer ist die .so toter Ballast.
       Der Error unten bricht den Build, falls Crashlytics/Sessions je dazukommt. -->
  <Target Name="_HeimatplatzStripUnusedDataStoreNativeLib"
          AfterTargets="_GetLibraryImports"
          Condition="$(TargetFramework.Contains('-android'))">
    <Error Condition="'@(ReferencePath->WithMetadataValue('Filename','Xamarin.Firebase.Sessions'))' != ''"
           Text="Xamarin.Firebase.Sessions ist jetzt referenziert und nutzt MultiProcessDataStore. libdatastore_shared_counter.so darf dann NICHT mehr entfernt werden - Target _HeimatplatzStripUnusedDataStoreNativeLib deaktivieren und die Play-16-KB-Warnung neu bewerten." />
    <ItemGroup>
      <AndroidNativeLibrary Remove="@(AndroidNativeLibrary)"
                            Condition="'%(Filename)' == 'libdatastore_shared_counter'" />
    </ItemGroup>
  </Target>
  <!-- Android 13+ Themed Icons: Der Resizetizer (10.0.x) verdrahtet die Monochrome-Ebene der
       generierten Adaptive-Icon-XMLs hart auf das Foreground-Asset (appiconfg = opaker Kreis,
       als Themed Icon also nur ein einfarbiger Blob). Bis dotnet/maui#22543 umgesetzt ist,
       biegen wir die XMLs nach dem Resizetizing auf die echte Silhouette um
       (Resources/drawable/appicon_monochrome.xml). AfterTargets feuert auch wenn
       ResizetizeImages up-to-date uebersprungen wird; WriteOnlyWhenDifferent haelt den
       Patch idempotent (kein Timestamp-Churn -> kein unnoetiger aapt2-Lauf). -->
  <Target Name="_HeimatplatzMonochromeIconPatch"
          AfterTargets="ResizetizeImages"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <ItemGroup>
      <_AdaptiveIconXml Include="$(_MauiIntermediateImages)mipmap-anydpi-v26\appicon*.xml" />
    </ItemGroup>
    <WriteLinesToFile
        Condition="'@(_AdaptiveIconXml)' != ''"
        File="%(_AdaptiveIconXml.Identity)"
        Lines="$([System.IO.File]::ReadAllText('%(_AdaptiveIconXml.Identity)').Replace('&lt;monochrome android:drawable=&quot;@mipmap/appicon_foreground&quot; /&gt;', '&lt;monochrome android:drawable=&quot;@drawable/appicon_monochrome&quot; /&gt;'))"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
  </Target>
</Project>