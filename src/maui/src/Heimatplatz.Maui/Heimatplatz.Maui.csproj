<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Heimatplatz.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>

		<!-- Shiny MAUI Shell Source Generation -->
		<ShinyMauiShell_GenerateRouteConstants>true</ShinyMauiShell_GenerateRouteConstants>
		<ShinyMauiShell_GenerateNavExtensions>true</ShinyMauiShell_GenerateNavExtensions>
		<ShinyMauiShell_GenerateAiExtensions>false</ShinyMauiShell_GenerateAiExtensions>

		<!-- Warnungen aus generiertem OpenAPI-Client-Code (wie Uno Core.ApiClient) -->
		<!-- CS8669: Nullable annotation context, CS9107: Captured parameter -->
		<WarningsNotAsErrors>CS8669;CS9107</WarningsNotAsErrors>
		<NoWarn>$(NoWarn);CS8669;CS9107;IL2026</NoWarn>

		<!-- Display name -->
		<ApplicationTitle>Heimatplatz</ApplicationTitle>

		<!-- App Identifier (identisch zur Uno-App) -->
		<ApplicationId>at.heimatplatz.app</ApplicationId>

		<!-- Versionen: werden beim Deploy von der Pipeline gesetzt (siehe Uno-App) -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<!-- iOS Push Entitlements (aps-environment) -->
		<CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<!-- Android minimum SDK 23 (Firebase-Anforderung, wie Uno-App) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFEFEFE" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FEFEFE" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Generierter OpenAPI-Client (eigenes Projekt: Source-Gen-Typen als Assembly-Referenz) -->
		<ProjectReference Include="..\Heimatplatz.Maui.ApiClient\Heimatplatz.Maui.ApiClient.csproj" />
		<!-- Wiederverwendbare plattformneutrale Contracts aus der Uno-App -->
		<ProjectReference Include="..\..\..\uno\src\Features\Notifications\Heimatplatz.Features.Notifications.Contracts\Heimatplatz.Features.Notifications.Contracts.csproj" />
		<ProjectReference Include="..\..\..\uno\src\Features\AppUpdate\Heimatplatz.Features.AppUpdate.Contracts\Heimatplatz.Features.AppUpdate.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<!-- Shiny -->
		<PackageReference Include="Shiny.Maui.Shell" />
		<PackageReference Include="Shiny.Extensions.MauiHosting" />
		<PackageReference Include="Shiny.Extensions.DependencyInjection" />
		<PackageReference Include="Shiny.Extensions.Stores" />
		<PackageReference Include="Shiny.Extensions.Serialization" />
		<PackageReference Include="Shiny.Mediator" />
		<PackageReference Include="Shiny.Mediator.Maui" />
		<PackageReference Include="Shiny.Hosting.Maui" />
		<PackageReference Include="Shiny.Push" />
		<PackageReference Include="Shiny.Notifications" />
	</ItemGroup>

	<!-- Android In-App Updates (Google Play Core) -->
	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<PackageReference Include="Xamarin.Google.Android.Play.App.Update" />
	</ItemGroup>

	<!-- Firebase Push Konfiguration (aus der Uno-App uebernommen) -->
	<ItemGroup Condition="$(TargetFramework.Contains('-android'))">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" Condition="Exists('Platforms\Android\google-services.json')" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('-maccatalyst'))">
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" Condition="Exists('Platforms\iOS\GoogleService-Info.plist')" />
	</ItemGroup>

</Project>
