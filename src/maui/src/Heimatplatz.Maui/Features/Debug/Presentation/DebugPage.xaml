<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Heimatplatz.Maui.Features.Debug.Presentation.DebugPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation="clr-namespace:Heimatplatz.Maui.Features.Debug.Presentation"
    x:DataType="presentation:DebugViewModel"
    Title="{Binding Loc.PageTitle}">

    <ScrollView>
        <VerticalStackLayout
            Padding="16,24"
            Spacing="24"
            MaximumWidthRequest="600"
            HorizontalOptions="Fill">

            <!-- Kanal des laufenden Builds: beantwortet dem Tester sofort, warum diese
                 Seite ueberhaupt da ist und was in der Store-Version anders laeuft. -->
            <Border Style="{StaticResource Card}" AutomationId="Debug_ChannelCard">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Loc.ChannelCardTitle}" Style="{StaticResource CardTitle}" />

                    <Label Text="{Binding ChannelDisplay}"
                           Style="{StaticResource BodyStrong}"
                           AutomationId="Debug_Channel" />

                    <Label Text="{Binding Loc.ChannelHint}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" AutomationId="Debug_AuthenticationCard">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Loc.AuthCardTitle}" Style="{StaticResource CardTitle}" />

                    <Label Text="{Binding CurrentAuthenticationStateDisplay}"
                           Style="{StaticResource BodyStrong}"
                           AutomationId="Debug_CurrentAuthenticationState" />

                    <Button Text="{Binding Loc.LogoutButton}"
                            Command="{Binding SetLoggedOutCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource SecondaryButton}"
                            AutomationId="Debug_SetLoggedOut" />

                    <!-- Die Testkonten gibt es nur in der Entwicklungs-/Test-Datenbank -->
                    <Label Text="{Binding Loc.TestLoginsUnavailableHint}"
                           IsVisible="{Binding AreTestLoginsUnavailable}"
                           Style="{StaticResource Caption}"
                           AutomationId="Debug_TestLoginsUnavailable" />

                    <Button Text="{Binding Loc.LoginAsSellerButton}"
                            Command="{Binding LoginAsSellerCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            IsVisible="{Binding AreTestLoginsAvailable}"
                            Style="{StaticResource PrimaryButton}"
                            AutomationId="Debug_LoginAsSeller" />
                    <Button Text="{Binding Loc.LoginAsBrokerButton}"
                            Command="{Binding LoginAsBrokerCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            IsVisible="{Binding AreTestLoginsAvailable}"
                            Style="{StaticResource PrimaryButton}"
                            AutomationId="Debug_LoginAsBroker" />
                    <Button Text="{Binding Loc.LoginAsPropertyManagerButton}"
                            Command="{Binding LoginAsPropertyManagerCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            IsVisible="{Binding AreTestLoginsAvailable}"
                            Style="{StaticResource PrimaryButton}"
                            AutomationId="Debug_LoginAsPropertyManager" />
                    <Button Text="{Binding Loc.LoginAsBuyerButton}"
                            Command="{Binding LoginAsBuyerCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            IsVisible="{Binding AreTestLoginsAvailable}"
                            Style="{StaticResource PrimaryButton}"
                            AutomationId="Debug_LoginAsBuyer" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           Style="{StaticResource ErrorBannerText}"
                           AutomationId="Debug_AuthenticationError" />

                    <Label Text="{Binding Loc.AuthHint}"
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" AutomationId="Debug_ApiEndpointCard">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Loc.ApiCardTitle}" Style="{StaticResource CardTitle}" />

                    <!-- Lokale API nur am Entwicklungsrechner: auf einem TestFlight-/
                         Play-Test-Geraet gibt es hinter localhost nichts. -->
                    <RadioButton GroupName="ApiEndpoint"
                                 Content="{Binding DevelopmentLabel}"
                                 IsChecked="{Binding IsDevelopmentSelected, Mode=TwoWay}"
                                 IsVisible="{Binding IsDevelopmentEndpointAvailable}"
                                 AutomationId="Debug_ApiDevelopment" />
                    <RadioButton GroupName="ApiEndpoint"
                                 Content="{Binding TestLabel}"
                                 IsChecked="{Binding IsTestSelected, Mode=TwoWay}"
                                 AutomationId="Debug_ApiTest" />
                    <RadioButton GroupName="ApiEndpoint"
                                 Content="{Binding ProductionLabel}"
                                 IsChecked="{Binding IsProductionSelected, Mode=TwoWay}"
                                 AutomationId="Debug_ApiProduction" />

                    <Label Text="{Binding CurrentUrlDisplay}"
                           Style="{StaticResource Caption}"
                           AutomationId="Debug_CurrentApiUrl" />

                    <Label Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatusMessage}"
                           Style="{StaticResource BodyStrong}"
                           Margin="0,4,0,0"
                           AutomationId="Debug_SwitchStatus" />

                    <Label Text="{Binding Loc.ApiHint}"
                           Style="{StaticResource Caption}"
                           Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
