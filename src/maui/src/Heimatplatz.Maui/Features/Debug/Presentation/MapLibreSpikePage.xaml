<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Heimatplatz.Maui.Features.Debug.Presentation.MapLibreSpikePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maplibre="clr-namespace:MapLibreNative.Maui.Handlers;assembly=MapLibreNative.Maui.Handlers"
    xmlns:presentation="clr-namespace:Heimatplatz.Maui.Features.Debug.Presentation"
    x:DataType="presentation:MapLibreSpikeViewModel"
    Title="MapLibre-Spike">

    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0"
               Text="{Binding Status}"
               Padding="16,8"
               Style="{StaticResource Caption}"
               AutomationId="MapLibreSpike_Status" />

        <maplibre:MapLibreMap Grid.Row="1"
                              x:Name="SpikeMap"
                              MinZoom="6"
                              MaxZoom="17"
                              ShowGpsControl="False"
                              AutomationId="MapLibreSpike_Map" />
    </Grid>
</ContentPage>
