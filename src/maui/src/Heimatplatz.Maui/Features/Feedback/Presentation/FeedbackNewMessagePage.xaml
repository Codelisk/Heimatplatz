<?xml version="1.0" encoding="utf-8" ?>
<!-- Neues Feedback: Kategorie-Hero oben (Icon-Kachel, Kurztitel, Leitfrage), die
     Messenger-Eingabezeile unten angedockt - sie ist das einzige Feld der Seite und
     hebt sich sauber ueber die Tastatur (gleiches Muster wie der Verlauf). -->
<ContentPage
    x:Class="Heimatplatz.Maui.Features.Feedback.Presentation.FeedbackNewMessagePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation="clr-namespace:Heimatplatz.Maui.Features.Feedback.Presentation"
    xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Feedback.Controls"
    x:DataType="presentation:FeedbackNewMessageViewModel"
    Title="{Binding Loc.ComposeTitle}">

    <Grid RowDefinitions="*,Auto">

        <!-- MaximumWidthRequest: auf Tablet/Desktop bleibt der Kopf eine ruhige
             Mittelspalte statt eines fensterbreiten Bandes (Composer unten ebenso) -->
        <VerticalStackLayout Grid.Row="0" Padding="20,26,20,10" Spacing="0" VerticalOptions="Start" MaximumWidthRequest="840">

            <Border BackgroundColor="{Binding CategoryColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="56"
                    HeightRequest="56"
                    HorizontalOptions="Start">
                <Border.Shadow>
                    <Shadow Radius="14" Offset="0,5" />
                </Border.Shadow>
                <Image Source="{Binding CategoryIcon}"
                       WidthRequest="27"
                       HeightRequest="27"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding CategoryTitle}"
                   Style="{StaticResource PageTitle}"
                   Margin="0,16,0,4" />

            <Label Text="{Binding CategoryHint}"
                   Style="{StaticResource PageSubtitle}"
                   FontSize="15"
                   LineBreakMode="WordWrap" />

            <BoxView Style="{StaticResource Divider}" Margin="0,20,0,14" />

            <Label Text="{Binding Composer.ComposeHintText}"
                   Style="{StaticResource Caption}"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <controls:MessageComposer Grid.Row="1"
                                  Composer="{Binding Composer}"
                                  SendCommand="{Binding SendCommand}"
                                  Placeholder="{Binding Loc.MessagePlaceholder}"
                                  MaximumWidthRequest="840"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}" />

    </Grid>
</ContentPage>
