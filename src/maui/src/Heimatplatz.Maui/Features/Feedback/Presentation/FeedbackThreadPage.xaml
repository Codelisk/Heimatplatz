<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Heimatplatz.Maui.Features.Feedback.Presentation.FeedbackThreadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation="clr-namespace:Heimatplatz.Maui.Features.Feedback.Presentation"
    xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Feedback.Models"
    x:DataType="presentation:FeedbackThreadViewModel"
    Title="{Binding Loc.ThreadTitle}">

    <Grid RowDefinitions="*,Auto">

        <!-- Fehler / Laden -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="12"
                             Padding="16,36"
                             HorizontalOptions="Center"
                             VerticalOptions="Start"
                             IsVisible="{Binding HasError}">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource EmptyStateTitle}" />
            <Button Text="{Binding Loc.Retry}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadCommand}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           Margin="0,48,0,0" />

        <!-- Verlauf -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Messages}"
                        SelectionMode="None"
                        IsVisible="{Binding IsContentVisible}"
                        ItemsUpdatingScrollMode="KeepLastItemInView"
                        AutomationId="Feedback_ThreadMessages">
            <CollectionView.Header>
                <VerticalStackLayout Padding="16,16,16,10" Spacing="8">
                    <Label Text="{Binding Subject}" Style="{StaticResource PageTitle}" />
                    <HorizontalStackLayout Spacing="6">
                        <Border Style="{StaticResource PillTag}">
                            <Label Text="{Binding StatusLabel}" Style="{StaticResource PillTagText}" />
                        </Border>
                        <Border Style="{StaticResource PillTag}">
                            <Label Text="{Binding CategoryLabel}" Style="{StaticResource PillTagText}" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FeedbackMessageItem">
                    <!-- Grid als Template-Root: LayoutOptions am Root-Element ignoriert der
                         Item-Container (WinUI streckt es) - die Blase richtet sich IM Grid aus -->
                    <Grid>
                    <!-- Chat-Blase: eigene Nachrichten rechts mit Rot-Tint, Team links auf Karte -->
                    <Border Margin="16,0,16,12"
                            Padding="14,10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            MaximumWidthRequest="480"
                            HorizontalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsUser}" Value="True">
                                <Setter Property="HorizontalOptions" Value="End" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource RedTint}, Dark={StaticResource RedTintDark}}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding AuthorLabel}"
                                       Style="{StaticResource Caption}"
                                       FontFamily="SansSemibold" />
                                <Label Text="{Binding DateText}" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding Body}"
                                   FontSize="14.5"
                                   LineBreakMode="WordWrap"
                                   IsVisible="{Binding HasBody}" />

                            <!-- Bild-Anhaenge -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Images}"
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        IsVisible="{Binding HasImages}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FeedbackImageItem">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource ZettelFrame}, Dark={StaticResource Gray600}}"
                                                StrokeShape="RoundRectangle 6"
                                                WidthRequest="96"
                                                HeightRequest="96"
                                                Margin="0,4,8,4">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenImageCommand, Source={RelativeSource AncestorType={x:Type presentation:FeedbackThreadViewModel}}, x:DataType=presentation:FeedbackThreadViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Source="{Binding ThumbnailUrl}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="96"
                                                   HeightRequest="96" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <!-- Sprachnachrichten -->
                            <VerticalStackLayout Spacing="6"
                                                 IsVisible="{Binding HasAudios}"
                                                 BindableLayout.ItemsSource="{Binding Audios}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:FeedbackAudioItem">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2">
                                            <Button Grid.Column="0"
                                                    Text="▶"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="14,6"
                                                    Command="{Binding ToggleAudioCommand, Source={RelativeSource AncestorType={x:Type presentation:FeedbackThreadViewModel}}, x:DataType=presentation:FeedbackThreadViewModel}"
                                                    CommandParameter="{Binding .}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Text" Value="■" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource Caption}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Antwort-Zeile -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10"
              Padding="16,10,16,14"
              IsVisible="{Binding IsContentVisible}"
              BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">
            <Border Grid.Column="0"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,0">
                <Entry Text="{Binding ReplyText}"
                       Placeholder="{Binding Loc.ReplyPlaceholder}"
                       MaxLength="4000"
                       ReturnCommand="{Binding SendReplyCommand}"
                       StyleClass="borderless"
                       AutomationId="Feedback_ReplyEntry" />
            </Border>
            <Button Grid.Column="1"
                    Text="{Binding Loc.ReplySend}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SendReplyCommand}"
                    IsEnabled="{Binding IsNotSending}"
                    AutomationId="Feedback_ReplySend" />
        </Grid>
    </Grid>
</ContentPage>
