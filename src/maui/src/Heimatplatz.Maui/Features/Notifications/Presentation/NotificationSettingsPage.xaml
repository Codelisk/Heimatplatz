<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Heimatplatz.Maui.Features.Notifications.Presentation.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:presentation="clr-namespace:Heimatplatz.Maui.Features.Notifications.Presentation"
    xmlns:locations="clr-namespace:Heimatplatz.Maui.Features.Properties.Services"
    x:DataType="presentation:NotificationSettingsViewModel"
    Title="Benachrichtigungen">

    <ScrollView>
        <VerticalStackLayout
            Padding="16,24"
            Spacing="24"
            MaximumWidthRequest="600"
            HorizontalOptions="Fill">

            <!-- Nicht angemeldet: Einstellungen sind ohne Login wirkungslos -->
            <VerticalStackLayout Spacing="8"
                                 Padding="8,36"
                                 HorizontalOptions="Center"
                                 IsVisible="{Binding IsLoggedOut}">
                <Label Text="🔒"
                       Style="{StaticResource EmptyStateIcon}"
                       Opacity="0.5" />
                <Label Text="Nicht angemeldet" Style="{StaticResource EmptyStateTitle}" />
                <Label Text="Melden Sie sich an, um Benachrichtigungen zu konfigurieren."
                       Style="{StaticResource EmptyStateHint}" />
                <Button Text="Anmelden"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding GoToLoginCommand}"
                        HorizontalOptions="Center"
                        Margin="0,16,0,0" />
            </VerticalStackLayout>

            <!-- Description with auto-save indicator -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsLoggedIn}">
                <Label
                    Grid.Column="0"
                    Text="Konfigurieren Sie, wann Sie über neue Immobilien benachrichtigt werden möchten."
                    Style="{StaticResource PageSubtitle}"
                    LineBreakMode="WordWrap"
                    AutomationId="NotificationSettings_Description" />

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="6"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsBusy}"
                    AutomationId="NotificationSettings_SavingIndicator">
                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        WidthRequest="16"
                        HeightRequest="16" />
                    <Label
                        Text="Speichern..."
                        Style="{StaticResource Caption}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Enable/Disable Toggle -->
            <Border Style="{StaticResource Card}" AutomationId="NotificationSettings_EnableCard" IsVisible="{Binding IsLoggedIn}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Benachrichtigungen"
                            Style="{StaticResource BodyStrong}"
                            VerticalOptions="Center" />
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                            VerticalOptions="Center"
                            AutomationId="NotificationSettings_EnableToggle" />
                    </Grid>
                    <Label
                        Text="Push-Benachrichtigungen für neue Immobilien"
                        Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Filter & Info (nur sichtbar wenn angemeldet UND Benachrichtigungen aktiviert) -->
            <VerticalStackLayout Spacing="24" IsVisible="{Binding IsFilterSectionVisible}">

                <!-- Filter Mode Selection -->
                <Border Style="{StaticResource Card}" AutomationId="NotificationSettings_FilterModeCard">
                    <VerticalStackLayout Spacing="16" RadioButtonGroup.GroupName="FilterMode">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Filtermodus"
                                Style="{StaticResource CardTitle}" />
                            <Label
                                Text="Wählen Sie, für welche Immobilien Sie benachrichtigt werden möchten."
                                Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- RadioButton: Alle -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <RadioButton
                                Grid.Column="0"
                                IsChecked="{Binding IsFilterModeAll, Mode=TwoWay}"
                                VerticalOptions="Center"
                                AutomationId="NotificationSettings_FilterMode_All" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Alle Immobilien"
                                    Style="{StaticResource BodyStrong}" />
                                <Label
                                    Text="Benachrichtigung bei jeder neuen Immobilie"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- RadioButton: Wie Suchfilter -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <RadioButton
                                Grid.Column="0"
                                IsChecked="{Binding IsFilterModeSameAsSearch, Mode=TwoWay}"
                                VerticalOptions="Center"
                                AutomationId="NotificationSettings_FilterMode_SameAsSearch" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Wie Suchfilter"
                                    Style="{StaticResource BodyStrong}" />
                                <Label
                                    Text="Verwendet automatisch Ihre aktuellen Suchfilter-Einstellungen"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- RadioButton: Benutzerdefiniert -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <RadioButton
                                Grid.Column="0"
                                IsChecked="{Binding IsFilterModeCustom, Mode=TwoWay}"
                                VerticalOptions="Center"
                                AutomationId="NotificationSettings_FilterMode_Custom" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="Benutzerdefiniert"
                                    Style="{StaticResource BodyStrong}" />
                                <Label
                                    Text="Eigene Filterkriterien für Benachrichtigungen festlegen"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Custom Filter Section (only visible when Custom mode is selected) -->
                <VerticalStackLayout Spacing="24" IsVisible="{Binding IsCustomFilterVisible}">

                    <!-- Immobilientyp Filter -->
                    <Border Style="{StaticResource Card}" AutomationId="NotificationSettings_PropertyTypeCard">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="Immobilientyp"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="Wählen Sie die Immobilientypen, für die Sie benachrichtigt werden möchten."
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" AutomationId="NotificationSettings_PropertyTypeChips">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsHausSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Haus" />
                                    <Label Text="Haus" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsGrundstueckSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Grundstueck" />
                                    <Label Text="Grundstück" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsZwangsversteigerungSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Zwangsversteigerung" />
                                    <Label Text="Zwangsversteigerung" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Anbietertyp Filter -->
                    <Border Style="{StaticResource Card}" AutomationId="NotificationSettings_SellerTypeCard">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="Anbietertyp"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="Wählen Sie die Anbietertypen, für die Sie benachrichtigt werden möchten."
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" AutomationId="NotificationSettings_SellerTypeChips">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsPrivateSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Private" />
                                    <Label Text="Privat" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsBrokerSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Broker" />
                                    <Label Text="Makler" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Location Filters -->
                    <Border Style="{StaticResource Card}" AutomationId="NotificationSettings_LocationCard">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="Orte"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="Wählen Sie die Orte aus, für die Sie Benachrichtigungen erhalten möchten. Leer = alle Orte."
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <!-- Ausgewaehlte Orte als Chips mit Entfernen-X -->
                            <FlexLayout
                                BindableLayout.ItemsSource="{Binding SelectedOrte}"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                IsVisible="{Binding HasSelectedOrte}"
                                AutomationId="NotificationSettings_OrtListe">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,5"
                                                Margin="0,0,6,6">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding .}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                       VerticalOptions="Center" />
                                                <Label Text="✕"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding RemoveOrtCommand, Source={RelativeSource AncestorType={x:Type presentation:NotificationSettingsViewModel}}, x:DataType=presentation:NotificationSettingsViewModel}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <!-- Ort-Suche -->
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="🔍"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding OrtSearchText}"
                                           Placeholder="Ort oder PLZ suchen..."
                                           AutomationId="NotificationSettings_OrtSearch" />
                                </Grid>
                            </Border>

                            <!-- Vorschlaege -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrtSuggestions}"
                                                 IsVisible="{Binding HasOrtSuggestions}"
                                                 Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="locations:LocationGemeindeDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="8,10"
                                                Margin="0,0,0,2">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding AddOrtCommand, Source={RelativeSource AncestorType={x:Type presentation:NotificationSettingsViewModel}}, x:DataType=presentation:NotificationSettingsViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} ({1})">
                                                        <Binding Path="Name" />
                                                        <Binding Path="PostalCode" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Info Card -->
                <Border Style="{StaticResource Card}" AutomationId="NotificationSettings_InfoCard">
                    <Label
                        Text="Ihre Einstellungen werden automatisch gespeichert. Sie erhalten eine Benachrichtigung, sobald eine neue Immobilie Ihren Filtereinstellungen entspricht."
                        Style="{StaticResource Caption}" />
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
