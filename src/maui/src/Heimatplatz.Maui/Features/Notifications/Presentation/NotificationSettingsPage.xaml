<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Heimatplatz.Maui.Features.Notifications.Presentation.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
    xmlns:presentation="clr-namespace:Heimatplatz.Maui.Features.Notifications.Presentation"
    xmlns:locations="clr-namespace:Heimatplatz.Maui.Features.Properties.Services"
    x:DataType="presentation:NotificationSettingsViewModel"
    Title="{Binding Loc.PageTitle}">

    <ScrollView>
        <Grid x:Name="NotificationRoot"
              appcontrols:ResponsiveLayout.IsEnabled="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="WindowWidthStates">
                        <VisualState x:Name="Compact" />
                        <VisualState x:Name="Medium">
                            <VisualState.Setters>
                                <Setter TargetName="NotificationContent" Property="MaximumWidthRequest" Value="1100" />
                                <Setter TargetName="NotificationContent" Property="Padding" Value="24,28" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Expanded">
                            <VisualState.Setters>
                                <Setter TargetName="NotificationContent" Property="MaximumWidthRequest" Value="1200" />
                                <Setter TargetName="NotificationContent" Property="Padding" Value="32,32" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>

            <VerticalStackLayout x:Name="NotificationContent"
                                 Padding="16,24"
                                 Spacing="24"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Fill">

            <!-- Nicht angemeldet: Einstellungen sind ohne Login wirkungslos -->
            <VerticalStackLayout Spacing="8"
                                 Padding="8,36"
                                 HorizontalOptions="Center"
                                 IsVisible="{Binding IsLoggedOut}">
                <Label Text="🔒"
                       Style="{StaticResource EmptyStateIcon}"
                       Opacity="0.5" />
                <Label Text="{Binding Loc.LoggedOutTitle}" Style="{StaticResource EmptyStateTitle}" />
                <Label Text="{Binding Loc.LoggedOutHint}"
                       Style="{StaticResource EmptyStateHint}" />
                <Button Text="{Binding Loc.LoginButton}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding GoToLoginCommand}"
                        HorizontalOptions="Center"
                        Margin="0,16,0,0" />
            </VerticalStackLayout>

            <!-- Description with auto-save indicator -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsLoggedIn}">
                <Label
                    Grid.Column="0"
                    Text="{Binding Loc.Description}"
                    Style="{StaticResource PageSubtitle}"
                    LineBreakMode="WordWrap"
                    AutomationId="NotificationSettings_Description" />

                <!-- Auto-Save-Spinner in fest reserviertem Slot: KEIN IsVisible-Toggle
                     und kein "Speichern…"-Label - beides liess die Auto-Spalte wachsen
                     und der Beschreibungstext brach bei jedem Speichern neu um. -->
                <ActivityIndicator
                    Grid.Column="1"
                    IsRunning="{Binding IsBusy}"
                    WidthRequest="18"
                    HeightRequest="18"
                    VerticalOptions="Center"
                    AutomationId="NotificationSettings_SavingIndicator" />
            </Grid>

            <!-- Enable/Disable Toggle -->
            <Border Style="{StaticResource Card}" AutomationId="NotificationSettings_EnableCard" IsVisible="{Binding IsLoggedIn}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{Binding Loc.EnableTitle}"
                            Style="{StaticResource BodyStrong}"
                            VerticalOptions="Center" />
                        <Switch
                            Grid.Column="1"
                            IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                            VerticalOptions="Center"
                            AutomationId="NotificationSettings_EnableToggle" />
                    </Grid>
                    <Label
                        Text="{Binding Loc.EnableCaption}"
                        Style="{StaticResource Caption}" />
                    <Border BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#352A1D}"
                            Stroke="{AppThemeBinding Light=#D98200, Dark=#F2A93B}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12"
                            IsVisible="{Binding HasPushStatusMessage}"
                            AutomationId="NotificationSettings_PushStatus">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding PushStatusMessage}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Button Text="{Binding Loc.OpenSystemSettings}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenSystemSettingsCommand}"
                                    HorizontalOptions="Start"
                                    IsVisible="{Binding CanOpenSystemSettings}"
                                    AutomationId="NotificationSettings_OpenSystemSettings" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Filter & Info (nur sichtbar wenn angemeldet UND Benachrichtigungen aktiviert) -->
            <Grid x:Name="NotificationFilterLayout"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="0"
                  ColumnDefinitions="*"
                  IsVisible="{Binding IsFilterSectionVisible}"
                  appcontrols:ResponsiveLayout.IsEnabled="True">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="FilterWidthStates">
                            <VisualState x:Name="Compact" />
                            <VisualState x:Name="Medium">
                                <VisualState.Setters>
                                    <Setter Property="RowDefinitions" Value="Auto,Auto,Auto" />
                                    <Setter Property="ColumnDefinitions" Value="*,*" />
                                    <Setter Property="ColumnSpacing" Value="20" />
                                    <Setter TargetName="FilterModeCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="FilterModeCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="PropertyTypeCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="PropertyTypeCard" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="SellerTypeCard" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="SellerTypeCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="LocationCard" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="LocationCard" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="NotificationInfoCard" Property="Grid.Row" Value="2" />
                                    <Setter TargetName="NotificationInfoCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="NotificationInfoCard" Property="Grid.ColumnSpan" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Expanded">
                                <VisualState.Setters>
                                    <Setter Property="RowDefinitions" Value="Auto,Auto,Auto" />
                                    <Setter Property="ColumnDefinitions" Value="*,*" />
                                    <Setter Property="ColumnSpacing" Value="24" />
                                    <Setter TargetName="FilterModeCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="FilterModeCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="PropertyTypeCard" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="PropertyTypeCard" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="SellerTypeCard" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="SellerTypeCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="LocationCard" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="LocationCard" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="NotificationInfoCard" Property="Grid.Row" Value="2" />
                                    <Setter TargetName="NotificationInfoCard" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="NotificationInfoCard" Property="Grid.ColumnSpan" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <!-- Filter Mode Selection -->
                <Border x:Name="FilterModeCard"
                        Grid.Row="0"
                        Margin="0,0,0,24"
                        Style="{StaticResource Card}"
                        AutomationId="NotificationSettings_FilterModeCard">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding IsCustomFilterVisible}"
                                     Value="False">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="16" RadioButtonGroup.GroupName="FilterMode">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="{Binding Loc.FilterModeTitle}"
                                Style="{StaticResource CardTitle}" />
                            <Label
                                Text="{Binding Loc.FilterModeCaption}"
                                Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- RadioButton: Alle -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <RadioButton
                                Grid.Column="0"
                                IsChecked="{Binding IsFilterModeAll, Mode=TwoWay}"
                                VerticalOptions="Center"
                                AutomationId="NotificationSettings_FilterMode_All" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="{Binding Loc.FilterModeAllTitle}"
                                    Style="{StaticResource BodyStrong}" />
                                <Label
                                    Text="{Binding Loc.FilterModeAllCaption}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- RadioButton: Wie Suchfilter -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <RadioButton
                                Grid.Column="0"
                                IsChecked="{Binding IsFilterModeSameAsSearch, Mode=TwoWay}"
                                VerticalOptions="Center"
                                AutomationId="NotificationSettings_FilterMode_SameAsSearch" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="{Binding Loc.FilterModeSameAsSearchTitle}"
                                    Style="{StaticResource BodyStrong}" />
                                <Label
                                    Text="{Binding Loc.FilterModeSameAsSearchCaption}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- RadioButton: Benutzerdefiniert -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <RadioButton
                                Grid.Column="0"
                                IsChecked="{Binding IsFilterModeCustom, Mode=TwoWay}"
                                VerticalOptions="Center"
                                AutomationId="NotificationSettings_FilterMode_Custom" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label
                                    Text="{Binding Loc.FilterModeCustomTitle}"
                                    Style="{StaticResource BodyStrong}" />
                                <Label
                                    Text="{Binding Loc.FilterModeCustomCaption}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                    <!-- Immobilientyp Filter -->
                    <Border x:Name="PropertyTypeCard"
                            Grid.Row="1"
                            Margin="0,0,0,24"
                            Style="{StaticResource Card}"
                            IsVisible="{Binding IsCustomFilterVisible}"
                            AutomationId="NotificationSettings_PropertyTypeCard">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding Loc.PropertyTypeTitle}"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="{Binding Loc.PropertyTypeCaption}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" AutomationId="NotificationSettings_PropertyTypeChips">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsHausSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Haus" />
                                    <Label Text="{Binding Loc.PropertyTypeHaus}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsGrundstueckSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Grundstueck" />
                                    <Label Text="{Binding Loc.PropertyTypeGrundstueck}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsZwangsversteigerungSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Zwangsversteigerung" />
                                    <Label Text="{Binding Loc.PropertyTypeZwangsversteigerung}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Text="{Binding PropertyTypeValidationMessage}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                   IsVisible="{Binding HasPropertyTypeValidationMessage}"
                                   AutomationId="NotificationSettings_PropertyTypeValidation" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Anbietertyp Filter -->
                    <Border x:Name="SellerTypeCard"
                            Grid.Row="2"
                            Margin="0,0,0,24"
                            Style="{StaticResource Card}"
                            IsVisible="{Binding IsCustomFilterVisible}"
                            AutomationId="NotificationSettings_SellerTypeCard">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding Loc.SellerTypeTitle}"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="{Binding Loc.SellerTypeCaption}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" AutomationId="NotificationSettings_SellerTypeChips">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsPrivateSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Private" />
                                    <Label Text="{Binding Loc.SellerTypePrivate}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        IsChecked="{Binding IsBrokerSelected, Mode=TwoWay}"
                                        VerticalOptions="Center"
                                        AutomationId="NotificationSettings_Chip_Broker" />
                                    <Label Text="{Binding Loc.SellerTypeBroker}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Text="{Binding SellerTypeValidationMessage}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                   IsVisible="{Binding HasSellerTypeValidationMessage}"
                                   AutomationId="NotificationSettings_SellerTypeValidation" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Location Filters -->
                    <Border x:Name="LocationCard"
                            Grid.Row="3"
                            Margin="0,0,0,24"
                            Style="{StaticResource Card}"
                            IsVisible="{Binding IsCustomFilterVisible}"
                            AutomationId="NotificationSettings_LocationCard">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding Loc.LocationTitle}"
                                    Style="{StaticResource CardTitle}" />
                                <Label
                                    Text="{Binding Loc.LocationCaption}"
                                    Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <!-- Ausgewaehlte Orte als Chips mit Entfernen-X -->
                            <FlexLayout
                                BindableLayout.ItemsSource="{Binding SelectedOrte}"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                IsVisible="{Binding HasSelectedOrte}"
                                AutomationId="NotificationSettings_OrtListe">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="10,5"
                                                Margin="0,0,6,6">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding .}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                       VerticalOptions="Center" />
                                                <Label Text="✕"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                       VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding RemoveOrtCommand, Source={RelativeSource AncestorType={x:Type presentation:NotificationSettingsViewModel}}, x:DataType=presentation:NotificationSettingsViewModel}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <!-- Ort-Suche -->
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="🔍"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding OrtSearchText}"
                                           Placeholder="{Binding Loc.LocationSearchPlaceholder}"
                                           StyleClass="borderless"
                                           AutomationId="NotificationSettings_OrtSearch" />
                                </Grid>
                            </Border>

                            <!-- Vorschlaege -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrtSuggestions}"
                                                 IsVisible="{Binding HasOrtSuggestions}"
                                                 Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="locations:LocationGemeindeDto">
                                        <Border StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="8,10"
                                                Margin="0,0,0,2">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding AddOrtCommand, Source={RelativeSource AncestorType={x:Type presentation:NotificationSettingsViewModel}}, x:DataType=presentation:NotificationSettingsViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} ({1})">
                                                        <Binding Path="Name" />
                                                        <Binding Path="PostalCode" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                <!-- Info Card -->
                <Border x:Name="NotificationInfoCard"
                        Grid.Row="4"
                        Style="{StaticResource Card}"
                        AutomationId="NotificationSettings_InfoCard">
                    <Label
                        Text="{Binding Loc.InfoText}"
                        Style="{StaticResource Caption}" />
                </Border>

            </Grid>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
