<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="HEIMATPLATZ">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sortieren"
                     IconImageSource="icon_sort.png"
                     Order="Primary"
                     Priority="0"
                     Command="{Binding ShowSortOptionsCommand}" />
        <ToolbarItem Text="Filter"
                     IconImageSource="icon_filter.png"
                     Order="Primary"
                     Priority="1"
                     Command="{Binding OpenFilterSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <!-- Liste mit Pull-to-Refresh; die API-Seiten werden explizit gewechselt.
             Count/Seitenzahl stehen im Footer, Sortierung/Filter in der Toolbar -
             die Liste startet dadurch ohne eigene Kopfzeile direkt oben. -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView x:Name="PropertiesCollection"
                            ItemsSource="{Binding Properties}"
                            ItemSizingStrategy="MeasureFirstItem"
                            ItemsUpdatingScrollMode="KeepItemsInView"
                            AutomationId="Home_Properties"
                            controls:ResponsiveGrid.MinItemWidth="320">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Grid Padding="24,60,24,24">
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding HasNoLoadError}">
                            <Label Text="🔍" Style="{StaticResource EmptyStateIcon}" />
                            <Label Text="Keine Treffer" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="Passen Sie Ihre Filter an, um mehr Immobilien zu sehen."
                                   Style="{StaticResource EmptyStateHint}" />
                        </VerticalStackLayout>

                        <!-- Lade-Fehler inline statt als modaler Dialog (blockiert keine Eingaben) -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding HasLoadError}">
                            <Label Text="📡" Style="{StaticResource EmptyStateIcon}" />
                            <Label Text="Laden fehlgeschlagen" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding LoadErrorMessage}"
                                   Style="{StaticResource EmptyStateHint}"
                                   AutomationId="Home_LoadErrorMessage" />
                            <Button Text="Erneut versuchen"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RetryLoadCommand}"
                                    Margin="0,10,0,0"
                                    HorizontalOptions="Center"
                                    AutomationId="Home_RetryLoad" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:PropertyListItemDto">
                        <Grid Padding="12,0">
                            <controls:PropertyCard Property="{Binding .}"
                                                   IsAuthenticated="{Binding IsAuthenticated, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   CardClickedCommand="{Binding PropertySelectedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   FavoriteCommand="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   BlockCommand="{Binding ToggleBlockedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          Padding="12,12,12,20"
                          IsVisible="{Binding HasResults}"
                          AutomationId="Home_Pagination">
                        <Button Grid.Column="0"
                                Text="‹ Zurück"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding GoToPreviousPageCommand}"
                                IsEnabled="{Binding CanGoToPreviousPage}"
                                IsVisible="{Binding HasPagination}"
                                AutomationId="Home_PreviousPage" />
                        <Label Grid.Column="1"
                               Text="{Binding PageNumberText}"
                               FontSize="13"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                               AutomationId="Home_PageNumber" />
                        <Button Grid.Column="2"
                                Text="Weiter ›"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding GoToNextPageCommand}"
                                IsEnabled="{Binding CanGoToNextPage}"
                                IsVisible="{Binding HasPagination}"
                                AutomationId="Home_NextPage" />
                    </Grid>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Busy-Overlay -->
        <Grid Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
