<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:services="clr-namespace:Heimatplatz.Maui.Features.Properties.Services"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="HEIMATPLATZ">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Einklappbare Filterleiste (einzige Filter-UI der App) -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                StrokeThickness="0"
                Padding="0">
            <VerticalStackLayout>

                <!-- Filter-Header: immer sichtbar, ganzer Bereich klickbar -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="10"
                      Padding="14,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterExpandedCommand}" />
                    </Grid.GestureRecognizers>

                    <Image Grid.Column="0"
                           Source="icon_filter.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="Filter"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Text="{Binding FilterSummary}"
                               FontSize="11"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>

                    <Label Grid.Column="2"
                           Text="{Binding FilterToggleGlyph}"
                           FontSize="10"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </Grid>

                <!-- Filter-Body: einklappbar -->
                <VerticalStackLayout Spacing="14"
                                     Padding="14,2,14,16"
                                     IsVisible="{Binding IsFilterExpanded}">

                    <!-- Immobilientyp -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="IMMOBILIENTYP" Style="{StaticResource SectionHeader}" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Button Text="Haus"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,6,6"
                                    Command="{Binding ToggleHausCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsHausSelected}"
                                                 Value="True">
                                        <Setter Property="Text" Value="✓ Haus" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="Grundstück"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,6,6"
                                    Command="{Binding ToggleGrundstueckCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsGrundstueckSelected}"
                                                 Value="True">
                                        <Setter Property="Text" Value="✓ Grundstück" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="Zwangsversteigerung"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,6,6"
                                    Command="{Binding ToggleZwangsversteigerungCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsZwangsversteigerungSelected}"
                                                 Value="True">
                                        <Setter Property="Text" Value="✓ Zwangsversteigerung" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Anbietertyp: bei Zwangsversteigerung (immer Gericht/Edikt) wirkungslos, daher ausgeblendet -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSellerFilterVisible}">
                        <Label Text="ANBIETER" Style="{StaticResource SectionHeader}" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Button Text="Privat"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,6,6"
                                    Command="{Binding TogglePrivateCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsPrivateSelected}"
                                                 Value="True">
                                        <Setter Property="Text" Value="✓ Privat" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="Makler"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,6,6"
                                    Command="{Binding ToggleBrokerCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding IsBrokerSelected}"
                                                 Value="True">
                                        <Setter Property="Text" Value="✓ Makler" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Eingestellt seit -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="EINGESTELLT SEIT" Style="{StaticResource SectionHeader}" />
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,0"
                                HorizontalOptions="Start"
                                MinimumWidthRequest="160">
                            <Picker ItemsSource="{Binding AgeFilterOptions}"
                                    SelectedIndex="{Binding SelectedAgeFilterIndex}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Orte -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ORTE" Style="{StaticResource SectionHeader}" />

                        <!-- Ausgewaehlte Orte als Chips -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding SelectedOrte}"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    IsVisible="{Binding HasSelectedOrte}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="10,5"
                                            Margin="0,0,6,6">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding .}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                                   VerticalOptions="Center" />
                                            <Label Text="✕"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                                   VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding RemoveOrtCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                                          CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Ort-Suche (auf Desktop nicht ueber die volle Breite; Fill+MaximumWidth wuerde zentrieren) -->
                        <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 10"
                                HorizontalOptions="{OnIdiom Default=Fill, Desktop=Start}"
                                WidthRequest="{OnIdiom Default=-1, Desktop=520}"
                                Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="🔍"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Entry Grid.Column="1"
                                       Text="{Binding OrtSearchText}"
                                       Placeholder="Ort oder PLZ suchen..." />
                            </Grid>
                        </Border>

                        <!-- Vorschlaege -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrtSuggestions}"
                                             IsVisible="{Binding HasOrtSuggestions}"
                                             HorizontalOptions="{OnIdiom Default=Fill, Desktop=Start}"
                                             WidthRequest="{OnIdiom Default=-1, Desktop=520}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:LocationGemeindeDto">
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                            StrokeShape="RoundRectangle 4"
                                            Padding="8,10"
                                            Margin="0,0,0,2">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AddOrtCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} ({1})">
                                                    <Binding Path="Name" />
                                                    <Binding Path="PostalCode" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <BoxView Style="{StaticResource Divider}" />
            </VerticalStackLayout>
        </Border>

        <!-- Toolbar-Zeile: Ergebnis-Count + Sortierung -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Padding="12,8">
            <Label Grid.Column="0"
                   Text="{Binding ResultCountText}"
                   FontSize="13"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <Button Grid.Column="1"
                    Text="{Binding SortLabel}"
                    Style="{StaticResource FilterChipStyle}"
                    Command="{Binding ShowSortOptionsCommand}" />
        </Grid>

        <!-- Liste mit Pull-to-Refresh und Infinite Scroll -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Properties}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            ItemSizingStrategy="MeasureFirstItem"
                            controls:ResponsiveGrid.MinItemWidth="320">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Grid Padding="24,60,24,24">
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center">
                            <Label Text="🔍" Style="{StaticResource EmptyStateIcon}" />
                            <Label Text="Keine Treffer" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="Passen Sie Ihre Filter an, um mehr Immobilien zu sehen."
                                   Style="{StaticResource EmptyStateHint}" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:PropertyListItemDto">
                        <Grid Padding="12,0">
                            <controls:PropertyCard Property="{Binding .}"
                                                   IsAuthenticated="{Binding IsAuthenticated, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   CardClickedCommand="{Binding PropertySelectedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   FavoriteCommand="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   BlockCommand="{Binding ToggleBlockedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Margin="0,8,0,16"
                                       HorizontalOptions="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Busy-Overlay -->
        <Grid Grid.Row="2"
              Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
