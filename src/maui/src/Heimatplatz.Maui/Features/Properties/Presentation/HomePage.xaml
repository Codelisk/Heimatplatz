<?xml version="1.0" encoding="utf-8" ?>
<shiny:ShinyContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                        xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
                        xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
                        xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
                        xmlns:shiny="http://shiny.net/maui/controls"
                        xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
                        x:Class="Heimatplatz.Maui.Features.Properties.Presentation.HomePage"
                        x:DataType="vm:HomeViewModel"
                        Title="Heimatplatz">

    <!-- Marken-Kopf statt Standard-Titel: Wordmark + Fahnenband, Hamburger bleibt links.
         Auf Android setzt die Toolbar den TitleView-Inhalt sonst zu weit unten/rechts
         (dotnet/maui#3559) - deshalb ein fuellendes Grid als Wurzel, das die volle
         Toolbar-Hoehe einnimmt, und den Inhalt darin vertikal zentrieren. So sitzen
         Wordmark und Flagge auf einer Linie mit dem Hamburger-Symbol. -->
    <Shell.TitleView>
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                <!-- Androids Label-Zeilenbox hat bei SansBold deutlich mehr Oberraum
                     als Unterraum. Eine asymmetrische Margin ist hier ungeeignet: Sie
                     vergroessert die gemessene HStack-Hoehe und verschiebt den Text beim
                     Zentrieren nur um die halbe Margin. Die minimale vertikale Skalierung
                     macht die sichtbare Versalien-Hoehe gerade (34px wie der Hamburger),
                     TranslationY legt danach beide Pixelmitten exakt uebereinander. -->
                <Label Text="HEIMATPLATZ"
                       FontFamily="SansBold"
                       FontSize="17"
                       CharacterSpacing="4"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       ScaleY="{OnPlatform Android=1.03, Default=1}"
                       TranslationY="{OnPlatform Android=-3, Default=0}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <!-- Gerade Rastermasse bei weiterhin exaktem 3:2-Flaggenverhaeltnis:
                     Rahmen, Farbflaeche und Hamburger teilen dadurch dieselbe
                     halbe Pixelmitte; Translation gleicht nur die Toolbar-Optik aus. -->
                <appcontrols:FlagBand WidthRequest="{OnPlatform Android=21.6, Default=21}"
                                      HeightRequest="{OnPlatform Android=14.4, Default=14}"
                                      VerticalOptions="Center"
                                      TranslationY="{OnPlatform Android=-0.94, Default=0}" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <shiny:ShinyContentPage.PageContent>
        <Grid>

            <!-- Liste mit Pull-to-Refresh; die API-Seiten werden explizit gewechselt.
                 Count/Seitenzahl stehen im Footer, Sortierung/Filter in der Chip-Zeile.
                 Die Chip-Zeile liegt als Overlay darueber und blendet sich beim
                 Runterscrollen aus (siehe OnPropertiesScrolled im Code-Behind);
                 der Header-Spacer haelt ihr am Listenanfang den Platz frei. -->
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView x:Name="PropertiesCollection"
                                ItemsSource="{Binding Properties}"
                                ItemSizingStrategy="MeasureFirstItem"
                                ItemsUpdatingScrollMode="KeepScrollOffset"
                                Scrolled="OnPropertiesScrolled"
                                AutomationId="Home_Properties"
                                controls:ResponsiveGrid.MinItemWidth="320"
                                controls:ResponsiveGrid.ItemHorizontalPadding="24"
                                controls:ResponsiveGrid.HorizontalItemSpacing="12"
                                controls:ResponsiveGrid.MaxColumns="4">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="1"
                                         VerticalItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <VerticalStackLayout Spacing="0"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">
                            <!-- Platzhalter fuer die ueberlagernde Chip-Zeile (scrollt mit weg).
                                 Opak statt transparent: die Header-Supplementary-View des iOS-
                                 CollectionView-Handlers kann sonst hell durchscheinen, sobald der
                                 Platzhalter beim Pull-to-Refresh unter der Chip-Zeile hervorwandert. -->
                            <BoxView HeightRequest="56"
                                     Color="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}" />
                            <!-- Unten ohne Margin: die Liste setzt zwischen Header und
                                 erster Karte bereits VerticalItemSpacing (20) - sonst
                                 klafft die doppelte Luecke. -->
                            <Border Margin="12,4,12,0"
                                    Padding="12,9"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#D98200, Dark={StaticResource PrimaryDark}}"
                                    BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#352A1D}"
                                    StrokeShape="RoundRectangle 8"
                                    IsVisible="{Binding ShowCachedDataNotice}"
                                    AutomationId="Home_CachedDataNotice">
                                <Label Text="{Binding Loc.CachedDataNotice}"
                                       FontSize="12.5"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            </Border>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.EmptyView>
                        <Grid Padding="24,60,24,24">
                            <VerticalStackLayout Spacing="8"
                                                 VerticalOptions="Start"
                                                 HorizontalOptions="Center"
                                                 IsVisible="{Binding ShowRegularEmptyState}">
                                <Label Text="🔍" Style="{StaticResource EmptyStateIcon}" />
                                <Label Text="{Binding Loc.EmptyTitle}" Style="{StaticResource EmptyStateTitle}" />
                                <Label Text="{Binding Loc.EmptyHint}"
                                       Style="{StaticResource EmptyStateHint}" />
                            </VerticalStackLayout>

                            <!-- Lade-Fehler inline statt als modaler Dialog (blockiert keine Eingaben) -->
                            <VerticalStackLayout Spacing="8"
                                                 VerticalOptions="Start"
                                                 HorizontalOptions="Center"
                                                 IsVisible="{Binding HasLoadError}">
                                <Image Source="icon_offline.png" Style="{StaticResource EmptyStateImageIcon}" />
                                <Label Text="{Binding Loc.LoadFailedTitle}" Style="{StaticResource EmptyStateTitle}" />
                                <Label Text="{Binding LoadErrorMessage}"
                                       Style="{StaticResource EmptyStateHint}"
                                       AutomationId="Home_LoadErrorMessage" />
                                <Button Text="{Binding Loc.RetryButton}"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding RetryLoadCommand}"
                                        Margin="0,10,0,0"
                                        HorizontalOptions="Center"
                                        AutomationId="Home_RetryLoad" />
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="api:PropertyListItemDto">
                            <Grid Padding="12,0">
                                <controls:PropertyCard Property="{Binding .}"
                                                       IsAuthenticated="{Binding IsAuthenticated, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                       CardClickedCommand="{Binding PropertySelectedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                       FavoriteCommand="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                       BlockCommand="{Binding ToggleBlockedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <!-- Unterer Freiraum haelt die Trefferzahl frei von der schwebenden
                             Karten-Pille (40 hoch + 20 Abstand): sie stand sonst genau dahinter
                             und war am Listenende nur halb lesbar. -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              Padding="12,12,12,72"
                              IsVisible="{Binding HasResults}"
                              AutomationId="Home_Pagination">
                            <Button Grid.Column="0"
                                    Text="{Binding Loc.PreviousPage}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding GoToPreviousPageCommand}"
                                    IsEnabled="{Binding CanGoToPreviousPage}"
                                    IsVisible="{Binding HasPagination}"
                                    AutomationId="Home_PreviousPage" />
                            <Label Grid.Column="1"
                                   Text="{Binding PageNumberText}"
                                   FontSize="13"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                   AutomationId="Home_PageNumber" />
                            <Button Grid.Column="2"
                                    Text="{Binding Loc.NextPage}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding GoToNextPageCommand}"
                                    IsEnabled="{Binding CanGoToNextPage}"
                                    IsVisible="{Binding HasPagination}"
                                    AutomationId="Home_NextPage" />
                        </Grid>
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>

            <!-- Filter-Chip-Zeile: alle Kernfilter einen Tap entfernt; blendet sich
                 beim Runterscrollen aus und beim Hochwischen wieder ein -->
            <!-- Feste Hoehe (= Header-Spacer der Liste): WinUI ignoriert VerticalOptions=Start
                 bei horizontalen ScrollViews im Grid-Overlay und streckt sie sonst seitenhoch.
                 Clippender Host, weil WinUI das Seiten-Overlay nicht an der Navbar abschneidet:
                 die weggeschobene Zeile parkt sonst sichtbar UEBER der Navbar (deckt den Titel ab);
                 nach dem Slide wird der Host zusaetzlich unsichtbar (Code-Behind HideChipBar). -->
            <Grid x:Name="FilterChipBarHost"
                  VerticalOptions="Start"
                  HeightRequest="56"
                  IsClippedToBounds="True">
                <Grid x:Name="FilterChipBarSurface">
                    <ScrollView x:Name="FilterChipBar"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                Scrolled="OnFilterChipBarScrolled"
                                SizeChanged="OnFilterChipBarMetricsChanged"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">
                        <HorizontalStackLayout x:Name="FilterChipContent"
                                               Spacing="8"
                                               Padding="12,8,12,10"
                                               SizeChanged="OnFilterChipBarMetricsChanged"
                                               HorizontalOptions="{OnIdiom Phone=Start, Default=Center}">

                            <Button Text="{Binding SortChipLabel, StringFormat='↕ {0}'}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding OpenSortSheetCommand}"
                                    AutomationId="Home_Chip_Sort" />

                            <Button Text="{Binding TypeChipLabel}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding OpenTypeSheetCommand}"
                                    AutomationId="Home_Chip_Typ">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsTypeFilterActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="Transparent" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{Binding OrtChipLabel}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding Ort.OpenCommand}"
                                    AutomationId="Home_Chip_Ort">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsOrtFilterActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="Transparent" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{Binding AgeChipLabel}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding OpenAgeSheetCommand}"
                                    AutomationId="Home_Chip_Zeitraum">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsAgeFilterActive}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="Transparent" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button x:Name="MoreFilterChip"
                                    Text="{Binding Loc.ChipMore}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Command="{Binding OpenFilterSettingsCommand}"
                                    AutomationId="Home_Chip_Mehr" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Sichtbarer Hinweis, dass rechts weitere Filter liegen. Ein Tap
                         scrollt direkt bis zum letzten Chip; am Zeilenende verschwindet er. -->
                    <Border x:Name="FilterOverflowHint"
                            WidthRequest="38"
                            HorizontalOptions="End"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}"
                            StrokeThickness="0"
                            IsVisible="False"
                            AutomationId="Home_FilterOverflowHint">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterOverflowHintTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="›"
                               FontFamily="SansBold"
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               SemanticProperties.Description="{Binding Loc.MoreFiltersSemantic}" />
                    </Border>
                </Grid>
            </Grid>

            <!-- "Neue Inserate"-Pille: der Delta-Sync ersetzt die sichtbare Liste nie
                 selbst (das wuerde die Scroll-Position zerstoeren), sondern bietet den
                 Refresh hier an. Sitzt unter der Chip-Zeile; Markenfarbe statt Glas-Optik,
                 damit der Hinweis als Aktion auffaellt. -->
            <Border HorizontalOptions="Center"
                    VerticalOptions="Start"
                    Margin="0,64,0,0"
                    Padding="16,0"
                    HeightRequest="36"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    IsVisible="{Binding HasNewListings}"
                    SemanticProperties.Description="{Binding Loc.NewListingsPillSemantic}"
                    AutomationId="Home_NewListingsPill">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ShowNewListingsCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="↑"
                           FontFamily="SansBold"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    <Label Text="{Binding Loc.NewListingsPill}"
                           FontFamily="SansBold"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Schwebende Karte-Pille: bewusst dezenter als die Web-Pille -
                 Glas-Optik wie die Foto-Action-Buttons der Zettel (X/Blockieren),
                 transparentes Grau + feine Kontur statt Vollton mit Schatten.
                 Oeffnet die Vollbild-Kartenansicht mit den aktuellen Filtern.
                 Faehrt zusammen mit der Filter-Chip-Zeile weg (Code-Behind
                 TransitionChipBar) - beide gehoeren zur Suchoberflaeche und
                 sollen beim Lesen der Liste aus dem Weg sein. -->
            <Border x:Name="MapPill"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,20"
                    Padding="20,0"
                    HeightRequest="40"
                    Stroke="{StaticResource GlassPillStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource GlassPillBackground}, Dark={StaticResource GlassPillBackgroundDark}}"
                    SemanticProperties.Description="{Binding Loc.MapPillSemantic}"
                    AutomationId="Home_MapPill">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <!-- Tabler map-2 (wie im Web) als Vektor-Path, Strichstaerke
                         auf 16px-Rendering angepasst (2 * 16/24) -->
                    <Path Data="M12 18.5l-3 -1.5l-6 3v-13l6 -3l6 3l6 -3v7.5 M9 4v13 M15 7v5.5 M21.121 20.121a3 3 0 1 0 -4.242 0c.418 .419 1.125 1.045 2.121 1.879c1.051 -.89 1.759 -1.516 2.121 -1.879 M19 18v.01"
                          Stroke="{StaticResource White}"
                          StrokeThickness="1.4"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          Aspect="Uniform"
                          WidthRequest="16"
                          HeightRequest="16"
                          VerticalOptions="Center" />
                    <Label Text="{Binding Loc.MapPill}"
                           FontFamily="SansBold"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{StaticResource White}" />
                </HorizontalStackLayout>
            </Border>

            <!-- Busy-Overlay -->
            <Grid Style="{StaticResource BusyOverlay}"
                  IsVisible="{Binding IsBusy}">
                <Border Style="{StaticResource BusyCard}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                        <Label Text="{Binding BusyMessage}"
                               FontSize="13"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </shiny:ShinyContentPage.PageContent>

    <shiny:ShinyContentPage.Panels>

        <!-- Sortier-Sheet -->
        <appcontrols:ReliableFloatingPanel x:Name="SortPanel"
                             RequestedIsOpen="{Binding IsSortSheetOpen, Mode=TwoWay}"
                             MaximumWidthRequest="460"
                             HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
                             PanelCornerRadius="14"
                             PanelBackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <VerticalStackLayout Padding="20,6,20,16" Spacing="0">
                <Label Text="{Binding Loc.SortSectionTitle}"
                       Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,6" />

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortNewestFirst}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="Neueste">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="Neueste" AutomationId="Home_Sort_Neueste" />
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortOldestFirst}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="Aelteste">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="Aelteste" AutomationId="Home_Sort_Aelteste" />
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortPriceAsc}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="PreisAuf">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="PreisAuf" AutomationId="Home_Sort_PreisAuf" />
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortPriceDesc}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="PreisAb">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="PreisAb" AutomationId="Home_Sort_PreisAb" />
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortAreaDesc}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="FlaecheAb">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="FlaecheAb" AutomationId="Home_Sort_FlaecheAb" />
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortAreaAsc}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="FlaecheAuf">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="FlaecheAuf" AutomationId="Home_Sort_FlaecheAuf" />
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortPlzAsc}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="PlzAuf">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="PlzAuf" AutomationId="Home_Sort_PlzAuf" />
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.SortPlzDesc}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedSortName}" Value="PlzAb">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectSortCommand}" CommandParameter="PlzAb" AutomationId="Home_Sort_PlzAb" />
                </Grid>
            </VerticalStackLayout>
        </appcontrols:ReliableFloatingPanel>

        <!-- Typ-Sheet (Mehrfachauswahl, wirkt sofort) -->
        <appcontrols:ReliableFloatingPanel x:Name="TypePanel"
                             RequestedIsOpen="{Binding IsTypeSheetOpen, Mode=TwoWay}"
                             MaximumWidthRequest="560"
                             HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
                             PanelCornerRadius="14"
                             PanelBackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <VerticalStackLayout Padding="20,6,20,16" Spacing="12">
                <Label Text="{Binding Loc.TypeSectionTitle}" Style="{StaticResource SectionHeader}" />

                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                    <Button Text="{Binding Loc.TypeHouse}"
                            Style="{StaticResource FilterChipStyle}"
                            Margin="0,0,8,8"
                            Command="{Binding ToggleHausCommand}"
                            AutomationId="Home_TypSheet_Haus">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsHausSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="BorderColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="{Binding Loc.TypeLand}"
                            Style="{StaticResource FilterChipStyle}"
                            Margin="0,0,8,8"
                            Command="{Binding ToggleGrundstueckCommand}"
                            AutomationId="Home_TypSheet_Grundstueck">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsGrundstueckSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="BorderColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Text="{Binding Loc.TypeForeclosure}"
                            Style="{StaticResource FilterChipStyle}"
                            Margin="0,0,8,8"
                            Command="{Binding ToggleZwangsversteigerungCommand}"
                            AutomationId="Home_TypSheet_Zwangsversteigerung">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsZwangsversteigerungSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="BorderColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </FlexLayout>

                <Label Text="{Binding Loc.TypeSheetHint}"
                       Style="{StaticResource Caption}" />

                <Button Text="{Binding Loc.Done}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding CloseTypeSheetCommand}"
                        AutomationId="Home_TypSheet_Fertig" />
            </VerticalStackLayout>
        </appcontrols:ReliableFloatingPanel>

        <!-- Zeitraum-Sheet -->
        <appcontrols:ReliableFloatingPanel x:Name="AgePanel"
                             RequestedIsOpen="{Binding IsAgeSheetOpen, Mode=TwoWay}"
                             MaximumWidthRequest="460"
                             HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
                             PanelCornerRadius="14"
                             PanelBackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <VerticalStackLayout Padding="20,6,20,16" Spacing="0">
                <Label Text="{Binding Loc.AgeSectionTitle}"
                       Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,6" />

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.AgeAllPeriods}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedAgeFilterIndex}" Value="0">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectAgeFilterCommand}" AutomationId="Home_Age_Alle">
                        <Button.CommandParameter>
                            <x:Int32>0</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.AgeLastDay}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedAgeFilterIndex}" Value="1">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectAgeFilterCommand}" AutomationId="Home_Age_Tag">
                        <Button.CommandParameter>
                            <x:Int32>1</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.AgeLastWeek}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedAgeFilterIndex}" Value="2">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectAgeFilterCommand}" AutomationId="Home_Age_Woche">
                        <Button.CommandParameter>
                            <x:Int32>2</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.AgeLastMonth}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedAgeFilterIndex}" Value="3">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectAgeFilterCommand}" AutomationId="Home_Age_Monat">
                        <Button.CommandParameter>
                            <x:Int32>3</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                </Grid>

                <Grid HeightRequest="46" ColumnDefinitions="*,Auto">
                    <Label Text="{Binding Loc.AgeLastYear}" FontSize="14.5" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="✓" FontFamily="SansBold" FontSize="15" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedAgeFilterIndex}" Value="4">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Button Grid.ColumnSpan="2" BackgroundColor="Transparent" BorderWidth="0" Padding="0" MinimumHeightRequest="0"
                            Command="{Binding SelectAgeFilterCommand}" AutomationId="Home_Age_Jahr">
                        <Button.CommandParameter>
                            <x:Int32>4</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </appcontrols:ReliableFloatingPanel>

        <!-- Ort-Sheet (Bezirk->Gemeinde-Baum, Arbeitskopie mit Uebernehmen) -->
        <controls:OrtAuswahlPanel BindingContext="{Binding Ort}" />
    </shiny:ShinyContentPage.Panels>

</shiny:ShinyContentPage>
