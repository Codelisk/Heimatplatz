<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="clr-namespace:Shiny;assembly=Shiny.Maui.Shell"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="HEIMATPLATZ">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Filter"
                     shiny:Navigate.Route="FilterPreferences" />
        <ToolbarItem Text="Favoriten"
                     Order="Secondary"
                     shiny:Navigate.Route="Favorites" />
        <ToolbarItem Text="Blockierte"
                     Order="Secondary"
                     shiny:Navigate.Route="Blocked" />
        <ToolbarItem Text="Meine Immobilien"
                     Order="Secondary"
                     shiny:Navigate.Route="MyProperties" />
        <!-- Route wird im Code-Behind gesetzt: KI-Flow auf Phones, manuell sonst -->
        <ToolbarItem x:Name="AddPropertyToolbarItem"
                     Text="Immobilie hinzufügen"
                     Order="Secondary"
                     shiny:Navigate.Route="AddProperty" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Einklappbare Filterleiste -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                StrokeThickness="0"
                Padding="0">
            <VerticalStackLayout>

                <!-- Filter-Header: immer sichtbar, ganzer Bereich klickbar -->
                <Grid ColumnDefinitions="Auto,*,Auto"
                      Padding="12,10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterExpandedCommand}" />
                    </Grid.GestureRecognizers>

                    <Label Grid.Column="0"
                           Text="Filter"
                           FontSize="13"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Label Grid.Column="2"
                           Text="{Binding FilterToggleGlyph}"
                           FontSize="10"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </Grid>

                <!-- Filter-Body: einklappbar -->
                <VerticalStackLayout Spacing="8"
                                     Padding="12,0,12,10"
                                     IsVisible="{Binding IsFilterExpanded}">

                    <!-- Filter-Chips: Immobilientyp -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Button Text="Haus"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleHausCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsHausSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Grundstück"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleGrundstueckCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsGrundstueckSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Zwangsversteigerung"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleZwangsversteigerungCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsZwangsversteigerungSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </FlexLayout>

                    <!-- Anbietertyp-Chips -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Button Text="Privat"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding TogglePrivateCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsPrivateSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Makler"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleBrokerCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsBrokerSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </FlexLayout>

                    <!-- Alters-Filter und Orte -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Picker Grid.Column="0"
                                Title="Alter"
                                ItemsSource="{Binding AgeFilterOptions}"
                                SelectedIndex="{Binding SelectedAgeFilterIndex}" />
                        <Button Grid.Column="1"
                                Text="{Binding OrteInfoText}"
                                Style="{StaticResource FilterChipStyle}"
                                shiny:Navigate.Route="FilterPreferences" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Toolbar-Zeile: Ergebnis-Count + Sortierung -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Padding="12,8">
            <Label Grid.Column="0"
                   Text="{Binding ResultCountText}"
                   FontSize="13"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

            <Button Grid.Column="1"
                    Text="{Binding SortLabel}"
                    Style="{StaticResource FilterChipStyle}"
                    Command="{Binding ShowSortOptionsCommand}" />
        </Grid>

        <!-- Liste mit Pull-to-Refresh und Infinite Scroll -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Properties}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            ItemSizingStrategy="MeasureFirstItem"
                            controls:ResponsiveGrid.MinItemWidth="320">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Grid Padding="24,60,24,24">
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center">
                            <Label Text="🔍" Style="{StaticResource EmptyStateIcon}" />
                            <Label Text="Keine Treffer" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="Passen Sie Ihre Filter an, um mehr Immobilien zu sehen."
                                   Style="{StaticResource EmptyStateHint}" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:PropertyListItemDto">
                        <Grid Padding="12,0">
                            <controls:PropertyCard Property="{Binding .}"
                                                   IsAuthenticated="{Binding IsAuthenticated, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   CardClickedCommand="{Binding PropertySelectedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   FavoriteCommand="{Binding ToggleFavoriteCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                   BlockCommand="{Binding ToggleBlockedCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Margin="0,8,0,16"
                                       HorizontalOptions="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Busy-Overlay -->
        <Grid Grid.Row="2"
              Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
