<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wizard="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation.Wizard"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.Wizard.DescribeStepView"
             x:DataType="wizard:PropertyWizardViewModel">

    <VerticalStackLayout Spacing="16">

        <VerticalStackLayout Spacing="6">
            <Label Text="✨ Immobilie beschreiben"
                   Style="{StaticResource PageTitle}" />
            <Label Text="Beschreiben Sie Ihre Immobilie in eigenen Worten – die KI macht daraus Titel, Beschreibung und Eckdaten. Preis und Adresse legen Sie im nächsten Schritt selbst fest."
                   Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">

                <!-- Mikrofon-Button mit Puls-Ring (nur Android/iOS) -->
                <Grid HeightRequest="120"
                      IsVisible="{Binding DictationSupported}">
                    <Ellipse x:Name="PulseRing"
                             WidthRequest="84"
                             HeightRequest="84"
                             Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                             Opacity="0"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             InputTransparent="True" />
                    <Border WidthRequest="84"
                            HeightRequest="84"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 42"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsListening}"
                                         Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleDictationCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding MicButtonText}"
                               FontSize="30"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </Border>
                </Grid>

                <Label Text="{Binding MicHintText}"
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center"
                       IsVisible="{Binding DictationSupported}" />

                <!-- Live-Zwischenstand waehrend des Sprechens -->
                <Label Text="{Binding LivePartial}"
                       FontAttributes="Italic"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       IsVisible="{Binding HasLivePartial}" />

                <Editor Text="{Binding DictatedText}"
                        HeightRequest="140"
                        Placeholder="Oder Beschreibung hier eintippen: Lage, Zimmer, Flächen, Baujahr, Ausstattung…" />

                <Label Text="Diktat ist auf diesem Gerät nicht verfügbar – Beschreibung eintippen oder ohne KI fortfahren."
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding DictationUnsupported}" />
            </VerticalStackLayout>
        </Border>

        <Button Text="Ohne KI fortfahren – Eckdaten selbst eingeben"
                Command="{Binding SkipAiCommand}"
                Style="{StaticResource LinkButton}" />
    </VerticalStackLayout>
</ContentView>
