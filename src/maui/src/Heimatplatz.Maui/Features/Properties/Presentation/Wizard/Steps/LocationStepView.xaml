<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Heimatplatz.Maui.Features.Properties.Services"
             xmlns:wizard="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation.Wizard"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.Wizard.LocationStepView"
             x:DataType="wizard:PropertyWizardViewModel">

    <VerticalStackLayout Spacing="16">

        <VerticalStackLayout Spacing="6">
            <Label Text="Lage &amp; Preis"
                   Style="{StaticResource PageTitle}" />
            <Label Text="Preis und Adresse legen Sie selbst fest – hier entscheidet keine KI."
                   Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>

        <!-- Analyse laeuft im Hintergrund weiter -->
        <Border Style="{StaticResource SuccessBanner}"
                IsVisible="{Binding IsAnalysisRunning}">
            <Label Text="✨ Die KI analysiert Ihre Beschreibung im Hintergrund – füllen Sie inzwischen Lage und Preis aus."
                   Style="{StaticResource SuccessBannerText}" />
        </Border>

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Preis (€)"
                           Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Preis}"
                           Keyboard="Numeric"
                           Placeholder="z.B. 450000" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Straße"
                           Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Adresse}"
                           Placeholder="z.B. Musterstraße 42" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Ort"
                           Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding Ort.SelectedOrtText}"
                           FontSize="13"
                           IsVisible="{Binding Ort.HasSelectedOrt}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Entry Text="{Binding Ort.OrtSearchText}"
                           Placeholder="Ort oder PLZ suchen..." />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ort.OrtSuggestions}"
                                         IsVisible="{Binding Ort.HasOrtSuggestions}"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:LocationGemeindeDto">
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="8,10"
                                        Margin="0,0,0,2">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Ort.SelectGemeindeCommand, Source={RelativeSource AncestorType={x:Type wizard:PropertyWizardViewModel}}, x:DataType=wizard:PropertyWizardViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <Binding Path="Name" />
                                                <Binding Path="PostalCode" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
