<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Heimatplatz.Maui.Features.Properties.Services"
             xmlns:wizard="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation.Wizard"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.Wizard.LocationStepView"
             x:DataType="wizard:PropertyWizardViewModel">

    <VerticalStackLayout Spacing="16">

        <VerticalStackLayout Spacing="6">
            <Label Text="Lage &amp; Preis"
                   Style="{StaticResource PageTitle}" />
            <Label Text="Wo steht Ihre Immobilie, und was soll sie kosten?"
                   Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>

        <Border Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12">

                <VerticalStackLayout Spacing="6">
                    <Label Text="Preis (€)"
                           Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Preis}"
                           Keyboard="Numeric"
                           Placeholder="z.B. 450000" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Straße"
                           Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Adresse}"
                           Placeholder="z.B. Musterstraße 42" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Ort"
                           Style="{StaticResource FieldLabel}" />

                    <!-- Genau EIN Ort waehlbar: Auswahl ersetzt das Suchfeld, ✕ hebt sie zum Aendern auf -->
                    <HorizontalStackLayout IsVisible="{Binding Ort.HasSelectedOrt}">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="12,4,4,4">
                            <HorizontalStackLayout Spacing="2">
                                <Label Text="{Binding Ort.SelectedOrtText}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                       VerticalOptions="Center" />
                                <Label Text="✕"
                                       FontSize="12"
                                       Padding="8,6"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Ort.ClearSelectionCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <Entry Text="{Binding Ort.OrtSearchText}"
                           Placeholder="Ort oder PLZ suchen..."
                           IsVisible="{Binding Ort.HasNoSelectedOrt}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ort.OrtSuggestions}"
                                         IsVisible="{Binding Ort.HasOrtSuggestions}"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:LocationGemeindeDto">
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="8,10"
                                        Margin="0,0,0,2">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Ort.SelectGemeindeCommand, Source={RelativeSource AncestorType={x:Type wizard:PropertyWizardViewModel}}, x:DataType=wizard:PropertyWizardViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <Binding Path="Name" />
                                                <Binding Path="PostalCode" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
