<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:wizard="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation.Wizard"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.Wizard.DescriptionStepView"
             x:DataType="wizard:PropertyWizardViewModel">

    <VerticalStackLayout Spacing="16">

        <VerticalStackLayout Spacing="6">
            <Label Text="Die Beschreibung"
                   Style="{StaticResource PageTitle}" />
            <Label Text="Zum Schluss der Text für Ihr Inserat: Schreiben Sie ihn selbst – oder lassen Sie ihn aus Ihren Stichwörtern und Fotos erstellen."
                   Style="{StaticResource PageSubtitle}" />
        </VerticalStackLayout>

        <!-- Wahlkarten: Selbst schreiben / Erstellen lassen -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

            <Grid Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsManualMode}" Value="True">
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="StrokeThickness" Value="2" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="✍️" FontSize="22" />
                        <Label Text="Selbst schreiben"
                               Style="{StaticResource BodyStrong}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsManualMode}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Sie formulieren den Text Ihres Inserats."
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <!-- Unsichtbarer Button statt TapGestureRecognizer: funktioniert einheitlich
                     auf WinUI (DevFlow-Tap), Android und mit echter Maus -->
                <Button AutomationId="Wizard_ModeManual"
                        Text=""
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="10"
                        Command="{Binding ChooseManualModeCommand}" />
            </Grid>

            <Grid Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsGenerateMode}" Value="True">
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="StrokeThickness" Value="2" />
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="✨" FontSize="22" />
                        <Label Text="Erstellen lassen"
                               Style="{StaticResource BodyStrong}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsGenerateMode}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Aus Stichwörtern und Fotos entsteht Ihr Text."
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
                <Button AutomationId="Wizard_ModeGenerate"
                        Text=""
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="10"
                        Command="{Binding ChooseGenerateModeCommand}" />
            </Grid>
        </Grid>

        <!-- Modus: Selbst schreiben -->
        <Border Style="{StaticResource Card}"
                IsVisible="{Binding IsManualMode}">
            <VerticalStackLayout Spacing="6">
                <Label Text="Beschreibung"
                       Style="{StaticResource FieldLabel}" />
                <Editor Text="{Binding Beschreibung}"
                        AutomationId="Wizard_DescriptionEditor"
                        HeightRequest="200"
                        Placeholder="Lage, Zustand, Raumaufteilung, Besonderheiten … (mind. 50 Zeichen)" />
            </VerticalStackLayout>
        </Border>

        <!-- Modus: Erstellen lassen -->
        <VerticalStackLayout Spacing="16"
                             IsVisible="{Binding IsGenerateMode}">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Stichwörter"
                           Style="{StaticResource FieldLabel}" />

                    <!-- Mikrofon-Button mit Puls-Ring (nur Android/iOS) -->
                    <Grid HeightRequest="110"
                          IsVisible="{Binding DictationSupported}">
                        <Ellipse x:Name="PulseRing"
                                 WidthRequest="76"
                                 HeightRequest="76"
                                 Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                 Opacity="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 InputTransparent="True" />
                        <Border WidthRequest="76"
                                HeightRequest="76"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 38"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsListening}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDictationCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding MicButtonText}"
                                   FontSize="26"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding MicHintText}"
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center"
                           IsVisible="{Binding DictationSupported}" />

                    <!-- Live-Zwischenstand waehrend des Sprechens -->
                    <Label Text="{Binding LivePartial}"
                           FontAttributes="Italic"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           IsVisible="{Binding HasLivePartial}" />

                    <Editor Text="{Binding DescriptionKeywords}"
                            AutomationId="Wizard_KeywordsEditor"
                            HeightRequest="120"
                            Placeholder="z.B. ruhige Lage, 2020 saniert, großer Garten, Blick ins Grüne …" />

                    <Label Text="Diktat ist auf diesem Gerät nicht verfügbar – Stichwörter einfach eintippen."
                           Style="{StaticResource Caption}"
                           IsVisible="{Binding DictationUnsupported}" />

                    <Button Text="Text erstellen lassen"
                            AutomationId="Wizard_RequestGeneration"
                            Command="{Binding RequestGenerationCommand}"
                            IsEnabled="{Binding CanRequestGeneration}"
                            Style="{StaticResource PrimaryButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsGenerationFinished}" Value="True">
                                <Setter Property="Text" Value="Text neu erstellen lassen" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <!-- Status: Text wird erstellt -->
            <Border Style="{StaticResource SuccessBanner}"
                    IsVisible="{Binding IsGenerationRunning}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <ActivityIndicator Grid.Column="0"
                                       IsRunning="{Binding IsGenerationRunning}"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Ihr Text wird erstellt"
                               FontAttributes="Bold"
                               Style="{StaticResource SuccessBannerText}" />
                        <Label Text="Das dauert ein paar Minuten. Machen Sie einfach weiter – der fertige Text wird in Ihrem Entwurf gespeichert."
                               Style="{StaticResource SuccessBannerText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Status: fehlgeschlagen -->
            <VerticalStackLayout Spacing="8"
                                 IsVisible="{Binding HasGenerationFailed}">
                <Border Style="{StaticResource ErrorBanner}">
                    <Label Text="{Binding GenerationFailedMessage}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>
            </VerticalStackLayout>

            <!-- Ergebnis: fertiger Text (direkt bearbeitbar) -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding IsGenerationFinished}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ihr Beschreibungstext"
                           Style="{StaticResource SectionHeader}" />
                    <Editor Text="{Binding Beschreibung}"
                            AutomationId="Wizard_GeneratedDescriptionEditor"
                            HeightRequest="200" />
                    <Label Text="Sie können den Text direkt bearbeiten."
                           Style="{StaticResource Caption}" />
                    <Button Text="Erstellten Text übernehmen"
                            Command="{Binding ApplyGeneratedDescriptionCommand}"
                            Style="{StaticResource LinkButton}"
                            IsVisible="{Binding ShowApplyGeneratedButton}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
