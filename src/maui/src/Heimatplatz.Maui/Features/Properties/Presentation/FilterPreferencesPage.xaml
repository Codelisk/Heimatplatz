<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Heimatplatz.Maui.Features.Properties.Services"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.FilterPreferencesPage"
             x:DataType="vm:FilterPreferencesViewModel"
             Title="Filtereinstellungen">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20"
                                 Padding="16,24"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Fill">

                <!-- Speicher-/Fehler-Status -->
                <Label Text="Wird gespeichert..."
                       Style="{StaticResource Caption}"
                       IsVisible="{Binding IsSaving}" />
                <Border Style="{StaticResource ErrorBanner}"
                        IsVisible="{Binding ShowErrorMessage}">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Immobilientyp -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Immobilientyp" Style="{StaticResource FieldLabel}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Button Text="Haus"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleHausCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsHausSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Grundstück"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleGrundstueckCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsGrundstueckSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Zwangsversteigerung"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleZwangsversteigerungCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsZwangsversteigerungSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Anbietertyp -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Anbietertyp" Style="{StaticResource FieldLabel}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Button Text="Privat"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding TogglePrivateCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsPrivateSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Makler"
                                Style="{StaticResource FilterChipStyle}"
                                Margin="0,0,6,6"
                                Command="{Binding ToggleBrokerCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding IsBrokerSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Alter -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Alter der Einträge" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding AgeFilterOptions}"
                            SelectedIndex="{Binding SelectedAgeFilterIndex}" />
                </VerticalStackLayout>

                <!-- Sortierung -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sortierung" Style="{StaticResource FieldLabel}" />
                    <Picker ItemsSource="{Binding SortOptionLabels}"
                            SelectedIndex="{Binding SelectedSortIndex}" />
                </VerticalStackLayout>

                <!-- Orte -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Orte" Style="{StaticResource FieldLabel}" />

                    <!-- Ausgewaehlte Orte als Chips -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding SelectedOrte}"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                IsVisible="{Binding HasSelectedOrte}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="10,5"
                                        Margin="0,0,6,6">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding .}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                               VerticalOptions="Center" />
                                        <Label Text="✕"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding RemoveOrtCommand, Source={RelativeSource AncestorType={x:Type vm:FilterPreferencesViewModel}}, x:DataType=vm:FilterPreferencesViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Ort-Suche -->
                    <Entry Text="{Binding OrtSearchText}"
                           Placeholder="Ort oder PLZ suchen..." />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrtSuggestions}"
                                         IsVisible="{Binding HasOrtSuggestions}"
                                         Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:LocationGemeindeDto">
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="8,10"
                                        Margin="0,0,0,2">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddOrtCommand, Source={RelativeSource AncestorType={x:Type vm:FilterPreferencesViewModel}}, x:DataType=vm:FilterPreferencesViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} ({1})">
                                                <Binding Path="Name" />
                                                <Binding Path="PostalCode" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="Änderungen werden automatisch gespeichert."
                       Style="{StaticResource Caption}"
                       Margin="0,4,0,24" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy-Overlay -->
        <Grid Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   HorizontalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
