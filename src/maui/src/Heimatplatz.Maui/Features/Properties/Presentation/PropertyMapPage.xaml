<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.PropertyMapPage"
             x:DataType="vm:PropertyMapViewModel"
             Title="{Binding Loc.PageTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}">

    <Grid>
        <!-- Web-Faltkarte (/karte-embed): identische Optik und Interaktion wie im
             Web. Detail-Links faengt OnWebViewNavigating ab -> native Detailseite. -->
        <WebView x:Name="MapWebView"
                 Source="{Binding MapSource}"
                 Navigating="OnWebViewNavigating"
                 Navigated="OnWebViewNavigated"
                 BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}"
                 AutomationId="PropertyMap_WebView" />

        <!-- Offline-Zustand: Karte ist das einzige reine Online-Feature der App -->
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}"
              IsVisible="{Binding IsOffline}"
              Padding="24,60,24,24">
            <VerticalStackLayout Spacing="8"
                                 VerticalOptions="Start"
                                 HorizontalOptions="Center">
                <Image Source="icon_offline.png" Style="{StaticResource EmptyStateImageIcon}" />
                <Label Text="{Binding Loc.OfflineTitle}" Style="{StaticResource EmptyStateTitle}" />
                <Label Text="{Binding Loc.OfflineHint}" Style="{StaticResource EmptyStateHint}" />
                <Button Text="{Binding Loc.Retry}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RetryCommand}"
                        Margin="0,10,0,0"
                        HorizontalOptions="Center"
                        AutomationId="PropertyMap_RetryOffline" />
            </VerticalStackLayout>
        </Grid>

        <!-- Ladefehler (Server/Timeout) -->
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}"
              IsVisible="{Binding HasLoadError}"
              Padding="24,60,24,24">
            <VerticalStackLayout Spacing="8"
                                 VerticalOptions="Start"
                                 HorizontalOptions="Center">
                <Label Text="🗺" Style="{StaticResource EmptyStateIcon}" />
                <Label Text="{Binding Loc.LoadFailedTitle}" Style="{StaticResource EmptyStateTitle}" />
                <Label Text="{Binding Loc.LoadFailedHint}" Style="{StaticResource EmptyStateHint}" />
                <Button Text="{Binding Loc.Retry}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RetryCommand}"
                        Margin="0,10,0,0"
                        HorizontalOptions="Center"
                        AutomationId="PropertyMap_RetryError" />
            </VerticalStackLayout>
        </Grid>

        <!-- Lade-Overlay bis das Embed steht (danach uebernimmt die Falt-Animation) -->
        <Grid Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsLoading}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" HorizontalOptions="Center" />
                    <Label Text="{Binding Loc.LoadingMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
