<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:services="clr-namespace:Heimatplatz.Maui.Features.Properties.Services"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.EditPropertyPage"
             x:DataType="vm:EditPropertyViewModel"
             Title="Immobilie bearbeiten">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="12" Padding="16">

                <!-- Fehlermeldung -->
                <Border BackgroundColor="#FDECEA"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        Padding="12,8"
                        IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="#B22222" />
                </Border>

                <!-- Immobilientyp -->
                <Label Text="Immobilientyp"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Picker ItemsSource="{Binding PropertyTypes}"
                        ItemDisplayBinding="{Binding DisplayName, x:DataType=models:PropertyTypeItem}"
                        SelectedItem="{Binding SelectedPropertyTypeItem}" />

                <!-- Titel -->
                <Label Text="Titel"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Entry Text="{Binding Titel}"
                       Placeholder="z.B. Schönes Einfamilienhaus in ruhiger Lage" />

                <!-- Adresse -->
                <Label Text="Straße"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Entry Text="{Binding Adresse}"
                       Placeholder="z.B. Musterstraße 42" />

                <!-- Ort-Auswahl mit Suche -->
                <Label Text="Ort"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Label Text="{Binding SelectedOrtText}"
                       FontSize="13"
                       IsVisible="{Binding HasSelectedOrt}"
                       TextColor="{StaticResource Primary}" />
                <Entry Text="{Binding OrtSearchText}"
                       Placeholder="Ort oder PLZ suchen..." />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding OrtSuggestions}"
                                     IsVisible="{Binding HasOrtSuggestions}"
                                     Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="services:LocationGemeindeDto">
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                    StrokeShape="RoundRectangle 4"
                                    Padding="8,10"
                                    Margin="0,0,0,2">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectGemeindeCommand, Source={RelativeSource AncestorType={x:Type vm:EditPropertyViewModel}}, x:DataType=vm:EditPropertyViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0} ({1})">
                                            <Binding Path="Name" />
                                            <Binding Path="PostalCode" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Preis -->
                <Label Text="Preis (€)"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Entry Text="{Binding Preis}"
                       Keyboard="Numeric"
                       Placeholder="z.B. 450000" />

                <!-- Typspezifische Felder: Haus -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsHouseType}">
                    <Label Text="Wohnfläche (m²)"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Entry Text="{Binding WohnflaecheM2}"
                           Keyboard="Numeric"
                           Placeholder="z.B. 180" />

                    <Label Text="Zimmer"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Entry Text="{Binding Zimmer}"
                           Keyboard="Numeric"
                           Placeholder="z.B. 5" />

                    <Label Text="Baujahr"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Entry Text="{Binding Baujahr}"
                           Keyboard="Numeric"
                           Placeholder="z.B. 1985" />
                </VerticalStackLayout>

                <!-- Grundstücksfläche (Haus + Grundstück) -->
                <Label Text="Grundstücksfläche (m²)"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Entry Text="{Binding GrundstuecksflaecheM2}"
                       Keyboard="Numeric"
                       Placeholder="z.B. 650" />

                <!-- Beschreibung -->
                <Label Text="Beschreibung"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Editor Text="{Binding Beschreibung}"
                        HeightRequest="120"
                        Placeholder="Beschreiben Sie die Immobilie (mindestens 50 Zeichen)..." />

                <!-- Bilder -->
                <Label Text="Bilder"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Label Text="Noch keine Bilder hinzugefügt"
                       FontSize="12"
                       IsVisible="{Binding HasNoImages}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Images}"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            IsVisible="{Binding HasImages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageItem">
                            <Grid Margin="0,0,8,8">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        WidthRequest="90"
                                        HeightRequest="90">
                                    <Image Source="{Binding DisplaySource}"
                                           Aspect="AspectFill" />
                                </Border>
                                <Button Text="✕"
                                        FontSize="12"
                                        TextColor="White"
                                        BackgroundColor="#B0000000"
                                        WidthRequest="26"
                                        HeightRequest="26"
                                        CornerRadius="13"
                                        Padding="0"
                                        VerticalOptions="Start"
                                        HorizontalOptions="End"
                                        Margin="4"
                                        Command="{Binding RemoveImageCommand, Source={RelativeSource AncestorType={x:Type vm:EditPropertyViewModel}}, x:DataType=vm:EditPropertyViewModel}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
                <Button Text="Bild hinzufügen"
                        Command="{Binding AddPhotoCommand}"
                        BackgroundColor="Transparent"
                        BorderWidth="1"
                        BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <!-- Aktionen -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,24">
                    <Button Grid.Column="0"
                            Text="Abbrechen"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="Transparent"
                            BorderWidth="1"
                            BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Button Grid.Column="1"
                            Text="Speichern"
                            Command="{Binding UpdatePropertyCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy-Overlay -->
        <Grid BackgroundColor="#40000000"
              IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
