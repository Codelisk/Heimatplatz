<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
             xmlns:propcontrols="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.FilterSettingsPage"
             x:DataType="vm:FilterSettingsViewModel"
             appcontrols:DeferredFlyoutLock.IsEnabled="True"
             Title="{Binding Loc.PageTitle}">

    <Grid x:Name="FilterSettingsRoot"
          appcontrols:ResponsiveLayout.IsEnabled="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="WindowWidthStates">
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Medium">
                        <VisualState.Setters>
                            <Setter TargetName="FilterSettingsContent" Property="MaximumWidthRequest" Value="1000" />
                            <Setter TargetName="FilterSettingsContent" Property="Padding" Value="24,24,24,40" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                        <VisualState.Setters>
                            <Setter TargetName="FilterSettingsContent" Property="MaximumWidthRequest" Value="1100" />
                            <Setter TargetName="FilterSettingsContent" Property="Padding" Value="32,28,32,44" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <ScrollView>
            <VerticalStackLayout x:Name="FilterSettingsContent"
                                 Padding="16,16,16,32"
                                 Spacing="12"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Fill">

                <!-- Live-Ergebnis -->
                <Border Style="{StaticResource Card}" AutomationId="FilterSettings_ResultSummary">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding ResultCountText}"
                               Style="{StaticResource CardTitle}"
                               AutomationId="FilterSettings_ResultCount" />
                        <Label Text="{Binding FilterSummary}"
                               Style="{StaticResource Caption}"
                               AutomationId="FilterSettings_FilterSummary" />
                    </VerticalStackLayout>
                </Border>

                <!-- Alle Filtergruppen kompakt in einer Karte -->
                <Border Style="{StaticResource Card}" AutomationId="FilterSettings_FilterCard">
                    <Grid x:Name="FilterColumns"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="10"
                          ColumnDefinitions="*"
                          appcontrols:ResponsiveLayout.IsEnabled="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="FilterColumnWidthStates">
                                    <VisualState x:Name="Compact" />
                                    <VisualState x:Name="Medium">
                                        <VisualState.Setters>
                                            <Setter Property="RowDefinitions" Value="Auto" />
                                            <Setter Property="ColumnDefinitions" Value="*,*" />
                                            <Setter Property="ColumnSpacing" Value="24" />
                                            <Setter TargetName="TypeSellerColumn" Property="Grid.Row" Value="0" />
                                            <Setter TargetName="TypeSellerColumn" Property="Grid.Column" Value="0" />
                                            <Setter TargetName="AgeLocationColumn" Property="Grid.Row" Value="0" />
                                            <Setter TargetName="AgeLocationColumn" Property="Grid.Column" Value="1" />
                                            <Setter TargetName="BetweenFilterColumnsDivider" Property="IsVisible" Value="False" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Expanded">
                                        <VisualState.Setters>
                                            <Setter Property="RowDefinitions" Value="Auto" />
                                            <Setter Property="ColumnDefinitions" Value="*,*" />
                                            <Setter Property="ColumnSpacing" Value="28" />
                                            <Setter TargetName="TypeSellerColumn" Property="Grid.Row" Value="0" />
                                            <Setter TargetName="TypeSellerColumn" Property="Grid.Column" Value="0" />
                                            <Setter TargetName="AgeLocationColumn" Property="Grid.Row" Value="0" />
                                            <Setter TargetName="AgeLocationColumn" Property="Grid.Column" Value="1" />
                                            <Setter TargetName="BetweenFilterColumnsDivider" Property="IsVisible" Value="False" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>

                        <VerticalStackLayout x:Name="TypeSellerColumn"
                                             Grid.Row="0"
                                             Spacing="10">

                        <!-- Immobilientyp -->
                        <Label Text="{Binding Loc.TypeSectionTitle}"
                               Style="{StaticResource SectionHeader}"
                               AutomationId="FilterSettings_TypeCard" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Button Text="{Binding Loc.TypeHouse}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding ToggleHausCommand}"
                                    AutomationId="FilterSettings_Chip_Haus">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsHausSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding Loc.TypeLand}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding ToggleGrundstueckCommand}"
                                    AutomationId="FilterSettings_Chip_Grundstueck">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsGrundstueckSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding Loc.TypeForeclosure}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding ToggleZwangsversteigerungCommand}"
                                    AutomationId="FilterSettings_Chip_Zwangsversteigerung">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsZwangsversteigerungSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>

                        <!-- Anbieter (entfällt, wenn nur Zwangsversteigerungen gewählt sind) -->
                        <VerticalStackLayout Spacing="10"
                                             IsVisible="{Binding IsSellerFilterVisible}"
                                             AutomationId="FilterSettings_SellerCard">
                            <BoxView Style="{StaticResource Divider}" />
                            <Label Text="{Binding Loc.SellerSectionTitle}" Style="{StaticResource SectionHeader}" />
                            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                <Button Text="{Binding Loc.SellerPrivate}"
                                        Style="{StaticResource FilterChipStyle}"
                                        Margin="0,0,8,8"
                                        Command="{Binding TogglePrivateCommand}"
                                        AutomationId="FilterSettings_Chip_Privat">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsPrivateSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="{Binding Loc.SellerBroker}"
                                        Style="{StaticResource FilterChipStyle}"
                                        Margin="0,0,8,8"
                                        Command="{Binding ToggleBrokerCommand}"
                                        AutomationId="FilterSettings_Chip_Makler">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsBrokerSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Neubauprojekte: eigener Toggle, KEIN Objekttyp (ein Neubau-
                             projekt IST ein Haus) - abgewaehlt blendet sie aus -->
                        <BoxView Style="{StaticResource Divider}" />
                        <Label Text="{Binding Loc.NeubauSectionTitle}"
                               Style="{StaticResource SectionHeader}"
                               AutomationId="FilterSettings_NeubauCard" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Button Text="{Binding Loc.NeubauChip}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding ToggleNeubauprojektCommand}"
                                    AutomationId="FilterSettings_Chip_Neubauprojekt">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsNeubauprojektSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>
                        <Label Text="{Binding Loc.NeubauHint}"
                               Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="AgeLocationColumn"
                                             Grid.Row="1"
                                             Spacing="10">
                        <BoxView x:Name="BetweenFilterColumnsDivider"
                                 Style="{StaticResource Divider}" />

                        <!-- Eingestellt seit -->
                        <Label Text="{Binding Loc.AgeSectionTitle}"
                               Style="{StaticResource SectionHeader}"
                               AutomationId="FilterSettings_AgeCard" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <Button Text="{Binding Loc.AgeOptionAll}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding SelectAgeFilterCommand}"
                                    AutomationId="FilterSettings_Chip_AgeAlle">
                                <Button.CommandParameter>
                                    <x:Int32>0</x:Int32>
                                </Button.CommandParameter>
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedAgeFilterIndex}" Value="0">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding Loc.AgeOptionDay}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding SelectAgeFilterCommand}"
                                    AutomationId="FilterSettings_Chip_AgeTag">
                                <Button.CommandParameter>
                                    <x:Int32>1</x:Int32>
                                </Button.CommandParameter>
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedAgeFilterIndex}" Value="1">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding Loc.AgeOptionWeek}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding SelectAgeFilterCommand}"
                                    AutomationId="FilterSettings_Chip_AgeWoche">
                                <Button.CommandParameter>
                                    <x:Int32>2</x:Int32>
                                </Button.CommandParameter>
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedAgeFilterIndex}" Value="2">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding Loc.AgeOptionMonth}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding SelectAgeFilterCommand}"
                                    AutomationId="FilterSettings_Chip_AgeMonat">
                                <Button.CommandParameter>
                                    <x:Int32>3</x:Int32>
                                </Button.CommandParameter>
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedAgeFilterIndex}" Value="3">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="{Binding Loc.AgeOptionYear}"
                                    Style="{StaticResource FilterChipStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding SelectAgeFilterCommand}"
                                    AutomationId="FilterSettings_Chip_AgeJahr">
                                <Button.CommandParameter>
                                    <x:Int32>4</x:Int32>
                                </Button.CommandParameter>
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedAgeFilterIndex}" Value="4">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Orte -->
                        <Label Text="{Binding Loc.OrtSectionTitle}"
                               Style="{StaticResource SectionHeader}"
                               AutomationId="FilterSettings_OrtCard" />

                        <propcontrols:OrtAuswahlFeld BindingContext="{Binding Ort}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Darstellung (Anzeige-Einstellung, kein Filter) -->
                <Border Style="{StaticResource Card}" AutomationId="FilterSettings_DisplayCard">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding Loc.PageSizeLabel}"
                               Style="{StaticResource BodyStrong}"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                                Padding="10,0"
                                MinimumWidthRequest="90">
                            <Picker Title="{Binding Loc.PageSizeLabel}"
                                    ItemsSource="{Binding PageSizeOptions}"
                                    SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}"
                                    HorizontalTextAlignment="Center"
                                    StyleClass="borderless"
                                    AutomationId="FilterSettings_PageSize" />
                        </Border>
                    </Grid>
                </Border>

                <Button Text="{Binding Loc.ResetAllFilters}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ResetFiltersCommand}"
                        HorizontalOptions="Fill"
                        AutomationId="FilterSettings_Reset" />
            </VerticalStackLayout>
        </ScrollView>

        <shiny:OverlayHost>
            <propcontrols:OrtAuswahlPanel BindingContext="{Binding Ort}" />
        </shiny:OverlayHost>
    </Grid>
</ContentPage>
