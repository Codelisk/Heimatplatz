<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title="{Binding Loc.PageTitle}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Properties}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            controls:ResponsiveGrid.MinItemWidth="320">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="20" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Grid Padding="24,60,24,24">
                        <!-- Angemeldet: regulaerer Leer-Zustand -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding ShowRegularEmptyState}">
                            <Label Text="♡" Style="{StaticResource EmptyStateIcon}" />
                            <Label Text="{Binding Loc.EmptyTitle}" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding Loc.EmptyHint}"
                                   Style="{StaticResource EmptyStateHint}" />
                        </VerticalStackLayout>

                        <!-- Lade-Fehler inline statt als modaler Dialog (blockiert keine Eingaben) -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding ShowLoadError}">
                            <Label Text="📡" Style="{StaticResource EmptyStateIcon}" />
                            <Label Text="{Binding Loc.LoadFailedTitle}" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding LoadErrorMessage}" Style="{StaticResource EmptyStateHint}" />
                            <Button Text="{Binding Loc.Retry}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RetryLoadCommand}"
                                    Margin="0,10,0,0"
                                    HorizontalOptions="Center"
                                    AutomationId="Favorites_RetryLoad" />
                        </VerticalStackLayout>

                        <!-- Nicht angemeldet: Anmelde-Hinweis statt irrefuehrendem Leer-Zustand -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding IsLoggedOut}">
                            <Label Text="🔒"
                                   Style="{StaticResource EmptyStateIcon}"
                                   Opacity="0.5" />
                            <Label Text="{Binding Loc.NotLoggedInTitle}" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding Loc.NotLoggedInHint}"
                                   Style="{StaticResource EmptyStateHint}" />
                            <Button Text="{Binding Loc.Login}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GoToLoginCommand}"
                                    HorizontalOptions="Center"
                                    Margin="0,16,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:PropertyListItemDto">
                        <Grid Padding="12,0">
                            <controls:PropertyCard Property="{Binding .}"
                                                   Mode="{x:Static models:CardMode.Favorite}"
                                                   CardClickedCommand="{Binding PropertySelectedCommand, Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, x:DataType=vm:FavoritesViewModel}"
                                                   FavoriteCommand="{Binding RemoveFromCollectionCommand, Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, x:DataType=vm:FavoritesViewModel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Margin="0,8,0,16"
                                       HorizontalOptions="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Busy-Overlay -->
        <Grid Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
