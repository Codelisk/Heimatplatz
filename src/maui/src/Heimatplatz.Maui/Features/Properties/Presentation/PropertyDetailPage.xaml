<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.PropertyDetailPage"
             x:DataType="vm:PropertyDetailViewModel"
             appcontrols:DeferredFlyoutLock.IsEnabled="True"
             Title="{Binding Title}">

    <!-- Single-Cell-Grid: Der Kontakt-Footer liegt als Bottom-Sheet UEBER dem Inhalt.
         Bewusst kein Auto-Row-Resize: dynamisches Zeilenwachstum beim Aufklappen
         loest auf Android keinen Relayout des ScrollViews aus (stale Bounds). -->
    <Grid x:Name="DetailRoot"
          appcontrols:ResponsiveLayout.IsEnabled="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="WindowWidthStates">
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Medium">
                        <VisualState.Setters>
                            <Setter TargetName="DetailLeadGrid" Property="MaximumWidthRequest" Value="1160" />
                            <Setter TargetName="DetailLeadGrid" Property="Margin" Value="24,24,24,0" />
                            <Setter TargetName="DetailLeadGrid" Property="RowDefinitions" Value="420" />
                            <Setter TargetName="DetailLeadGrid" Property="ColumnDefinitions" Value="3*,2*" />
                            <Setter TargetName="DetailLeadGrid" Property="ColumnSpacing" Value="20" />
                            <Setter TargetName="DetailHero" Property="Grid.Row" Value="0" />
                            <Setter TargetName="DetailHero" Property="Grid.Column" Value="0" />
                            <Setter TargetName="DetailHero" Property="HeightRequest" Value="420" />
                            <Setter TargetName="DetailSummary" Property="Grid.Row" Value="0" />
                            <Setter TargetName="DetailSummary" Property="Grid.Column" Value="1" />
                            <Setter TargetName="DetailSummary" Property="Margin" Value="0" />
                            <Setter TargetName="DetailSummary" Property="Padding" Value="4,24" />
                            <Setter TargetName="DetailBody" Property="MaximumWidthRequest" Value="1100" />
                            <Setter TargetName="ContactFooter" Property="MaximumWidthRequest" Value="440" />
                            <Setter TargetName="ContactFooter" Property="HorizontalOptions" Value="End" />
                            <Setter TargetName="ContactFooter" Property="Margin" Value="0,0,24,24" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                        <VisualState.Setters>
                            <Setter TargetName="DetailLeadGrid" Property="MaximumWidthRequest" Value="1200" />
                            <Setter TargetName="DetailLeadGrid" Property="Margin" Value="32,28,32,0" />
                            <Setter TargetName="DetailLeadGrid" Property="RowDefinitions" Value="460" />
                            <Setter TargetName="DetailLeadGrid" Property="ColumnDefinitions" Value="3*,2*" />
                            <Setter TargetName="DetailLeadGrid" Property="ColumnSpacing" Value="24" />
                            <Setter TargetName="DetailHero" Property="Grid.Row" Value="0" />
                            <Setter TargetName="DetailHero" Property="Grid.Column" Value="0" />
                            <Setter TargetName="DetailHero" Property="HeightRequest" Value="460" />
                            <Setter TargetName="DetailSummary" Property="Grid.Row" Value="0" />
                            <Setter TargetName="DetailSummary" Property="Grid.Column" Value="1" />
                            <Setter TargetName="DetailSummary" Property="Margin" Value="0" />
                            <Setter TargetName="DetailSummary" Property="Padding" Value="8,28" />
                            <Setter TargetName="DetailBody" Property="MaximumWidthRequest" Value="1160" />
                            <Setter TargetName="ContactFooter" Property="MaximumWidthRequest" Value="460" />
                            <Setter TargetName="ContactFooter" Property="HorizontalOptions" Value="End" />
                            <Setter TargetName="ContactFooter" Property="Margin" Value="0,0,32,24" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <!-- Fehler-/Offline-Zustand: ersetzt den Inhalt vollflaechig
             (Offline mit Retry bzw. "nicht mehr verfuegbar" bei geloeschten Inseraten) -->
        <Grid IsVisible="{Binding HasLoadError}"
              Padding="32,0">
            <VerticalStackLayout Spacing="8"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="420">
                <Image Source="{Binding LoadErrorIcon}" Style="{StaticResource EmptyStateImageIcon}" />
                <Label Text="{Binding LoadErrorTitle}"
                       Style="{StaticResource EmptyStateTitle}"
                       AutomationId="Detail_LoadErrorTitle" />
                <Label Text="{Binding LoadErrorText}"
                       Style="{StaticResource EmptyStateHint}"
                       AutomationId="Detail_LoadErrorMessage" />
                <Button Text="{Binding Loc.RetryButton}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RetryLoadCommand}"
                        IsVisible="{Binding CanRetryLoad}"
                        Margin="0,10,0,0"
                        HorizontalOptions="Center"
                        AutomationId="Detail_RetryLoad" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView IsVisible="{Binding ShowContent}">
            <!-- Bottom-Padding reserviert Platz fuer die eingeklappte Kontakt-Leiste -->
            <VerticalStackLayout Spacing="0" Padding="0,0,0,96">

                <Border Margin="12,10,12,0"
                        Padding="12,9"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#D98200, Dark=#F2A93B}"
                        BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#352A1D}"
                        StrokeShape="RoundRectangle 8"
                        IsVisible="{Binding IsShowingCachedData}"
                        AutomationId="Detail_CachedDataNotice">
                    <Label Text="{Binding Loc.CachedDataNotice}"
                           FontSize="12.5"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </Border>

                <Grid x:Name="DetailLeadGrid"
                      RowDefinitions="300,Auto"
                      ColumnDefinitions="*"
                      HorizontalOptions="Fill">

                <!-- Hero: Bilder-Carousel, Content-Sheet gleitet darueber -->
                <Grid x:Name="DetailHero"
                      Grid.Row="0"
                      HeightRequest="300">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                            StrokeThickness="0">
                        <Image Source="logo.png"
                               WidthRequest="110"
                               Opacity="0.16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Mobile: Swipe-Carousel. Unter WinUI ausgeblendet, weil der
                         CarouselView-Container Bilder dort verzerrt auf Item-Groesse
                         skaliert (Aspect wird komplett ignoriert) -->
                    <Grid>
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="True">
                                <On Platform="WinUI" Value="False" />
                            </OnPlatform>
                        </Grid.IsVisible>

                        <CarouselView ItemsSource="{Binding ImageUrls}"
                                      IndicatorView="ImageIndicator"
                                      IsVisible="{Binding HasImages}"
                                      Position="{Binding CurrentImagePosition, Mode=TwoWay}"
                                      PositionChanged="OnImagePositionChanged"
                                      Loop="False">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <!-- Tippen oeffnet die Grossansicht. Bewusst ein
                                         TapGestureRecognizer statt einer unsichtbaren
                                         Button-Flaeche: jedes Carousel-Item wuerde sonst
                                         einen MaterialButton inflaten, und die beiden
                                         Items, die beim Seitenaufbau gebunden werden,
                                         hielten damit die Navigationsanimation auf. -->
                                    <Grid>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding OpenImageViewerCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}, x:DataType=vm:PropertyDetailViewModel}" />
                                        </Grid.GestureRecognizers>
                                        <Image Source="{Binding .}"
                                               Aspect="AspectFill"
                                               SemanticProperties.Description="{Binding Loc.OpenImageViewerSemantic, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}, x:DataType=vm:PropertyDetailViewModel}" />
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <IndicatorView x:Name="ImageIndicator"
                                       IndicatorColor="#80FFFFFF"
                                       SelectedIndicatorColor="White"
                                       VerticalOptions="End"
                                       HorizontalOptions="Center"
                                       Margin="0,0,0,36"
                                       IsVisible="{Binding HasImages}" />
                    </Grid>

                    <!-- Windows: Einzelbild + Pfeil-Navigation (Desktop hat kein Swipe) -->
                    <Grid>
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                                <On Platform="WinUI" Value="True" />
                            </OnPlatform>
                        </Grid.IsVisible>

                        <Grid IsVisible="{Binding HasImages}">
                            <!-- AspectFit statt Fill: bei Desktop-Breite wuerde der Crop nur
                                 einen schmalen Bildstreifen zeigen; ganzes Foto zentriert -->
                            <Image Source="{Binding CurrentImageUrl}"
                                   Aspect="AspectFit" />

                            <!-- Unsichtbare Tap-Flaeche: oeffnet die Grossansicht (unter den Pfeilen) -->
                            <Button BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    BorderWidth="0"
                                    Padding="0"
                                    MinimumHeightRequest="0"
                                    Command="{Binding OpenImageViewerCommand}"
                                    SemanticProperties.Description="{Binding Loc.OpenImageViewerSemantic}"
                                    AutomationId="Detail_OpenImageViewer" />

                            <!-- Pfeile als Geometrie statt Font-Glyph (siehe Schliessen-X) -->
                            <Grid IsVisible="{Binding HasMultipleImages}"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Center"
                                  Margin="14,0,0,0">
                                <Button Command="{Binding ShowPreviousImageCommand}"
                                        Padding="0"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        BorderWidth="1"
                                        BackgroundColor="{StaticResource GlassPillBackground}"
                                        BorderColor="{StaticResource GlassPillStroke}"
                                        AutomationId="Detail_PreviousImage" />
                                <Path Data="M10,1 L4,7 L10,13"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      WidthRequest="14"
                                      HeightRequest="14"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
                            </Grid>

                            <Grid IsVisible="{Binding HasMultipleImages}"
                                  HorizontalOptions="End"
                                  VerticalOptions="Center"
                                  Margin="0,0,14,0">
                                <Button Command="{Binding ShowNextImageCommand}"
                                        Padding="0"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        BorderWidth="1"
                                        BackgroundColor="{StaticResource GlassPillBackground}"
                                        BorderColor="{StaticResource GlassPillStroke}"
                                        AutomationId="Detail_NextImage" />
                                <Path Data="M4,1 L10,7 L4,13"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      WidthRequest="14"
                                      HeightRequest="14"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Typ-Badge (Farbe im ViewModel: ZV Rot, Grund Gruen, Haus Blau), eckig wie die Karten-Badges -->
                    <Border BackgroundColor="{Binding TypeBadgeColor}"
                            Stroke="{StaticResource GlassPillStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 2"
                            Padding="12,5"
                            Margin="14"
                            VerticalOptions="Start"
                            HorizontalOptions="Start">
                        <Label Text="{Binding TypeBadgeText}"
                               FontFamily="SansBold"
                               FontSize="10"
                               CharacterSpacing="1.4"
                               TextColor="White" />
                    </Border>

                    <!-- Teilen als kontextuelle Bildaktion (weisses Icon auf Glas);
                         Icon als zentriertes Overlay: ImageButton platziert sein Bild
                         auf WinUI nicht mittig -->
                    <Grid Margin="14"
                          VerticalOptions="Start"
                          HorizontalOptions="End">
                        <Button Command="{Binding SharePropertyCommand}"
                                Padding="0"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                CornerRadius="22"
                                BorderWidth="1"
                                BackgroundColor="{StaticResource GlassPillBackground}"
                                BorderColor="{StaticResource GlassPillStroke}"
                                SemanticProperties.Description="{Binding Loc.ShareSemantic}" />
                        <Image Source="icon_share_white.png"
                               WidthRequest="22"
                               HeightRequest="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>

                    <!-- Bild-Zaehler (oberhalb der Sheet-Kante) -->
                    <Border Style="{StaticResource GlassPill}"
                            Padding="8,3"
                            Margin="14,0,14,38"
                            VerticalOptions="End"
                            HorizontalOptions="Start"
                            IsVisible="{Binding HasImages}">
                        <Label Text="{Binding ImageCounterText}"
                               FontSize="11"
                               FontFamily="SansMedium"
                               TextColor="White" />
                    </Border>
                </Grid>

                <!-- Content-Sheet: rundet ueber das Foto (edler Ueberlapp) -->
                <Border x:Name="DetailSummary"
                        Grid.Row="1"
                        Margin="0,-26,0,0"
                        Padding="0,20,0,0"
                        StrokeThickness="0"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}"
                        StrokeShape="RoundRectangle 14,14,0,0"
                        appcontrols:ResponsiveLayout.IsEnabled="True"
                        appcontrols:ResponsiveLayout.UseWindowWidth="True">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="SummaryCornerStates">
                                <VisualState x:Name="Compact" />
                                <VisualState x:Name="Medium">
                                    <VisualState.Setters>
                                        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <VerticalStackLayout Spacing="16">

                        <!-- Kopf: Preis (Serif, Markenrot), Titel, Adresse, Merken -->
                        <VerticalStackLayout Spacing="6"
                                             Padding="16,0"
                                             MaximumWidthRequest="800"
                                             HorizontalOptions="Fill">
                            <Label Text="{Binding FormattedPrice}"
                                   FontFamily="Display"
                                   FontSize="30"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PriceDark}}" />

                            <Label Text="{Binding Title}"
                                   FontFamily="Display"
                                   FontSize="20"
                                   MaxLines="4"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                            <Label Text="{Binding AddressText}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                            <!-- Merken bleibt beim Objekt; Teilen liegt direkt auf dem Bild -->
                            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                                <Button Command="{Binding ToggleFavoriteCommand}"
                                        IsVisible="{Binding IsAuthenticated}"
                                        Style="{StaticResource FilterChipStyle}">
                                    <Button.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FavoriteButtonIcon" />
                                            <Binding Path="FavoriteButtonText" />
                                        </MultiBinding>
                                    </Button.Text>
                                </Button>
                            </HorizontalStackLayout>

                            <Label Text="{Binding CopyFeedback}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   IsVisible="{Binding HasCopyFeedback}" />
                        </VerticalStackLayout>

                        <!-- Kernfakten auf einen Blick -->
                        <FlexLayout Wrap="Wrap"
                                    JustifyContent="Start"
                                    Padding="16,0,8,0"
                                    MaximumWidthRequest="800"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding HasStatTiles}"
                                    BindableLayout.ItemsSource="{Binding StatTiles}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:StatTileItem">
                                    <Border Style="{StaticResource StatTile}"
                                            FlexLayout.Basis="30%"
                                            FlexLayout.Grow="1"
                                            Margin="0,0,8,8">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Value}" Style="{StaticResource StatTileValue}" />
                                            <Label Text="{Binding Label}" Style="{StaticResource StatTileLabel}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
                </Grid>

                <VerticalStackLayout x:Name="DetailBody"
                                     Spacing="16"
                                     Padding="0,16,0,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill">

                        <!-- Quellenkarte: klar getrennt von Objekt- und Kontaktaktionen -->
                        <Border Style="{StaticResource Card}"
                                Padding="14"
                                Margin="16,2"
                                MaximumWidthRequest="900"
                                HorizontalOptions="Fill"
                                IsVisible="{Binding HasOriginalListingUrl}">
                            <Grid ColumnDefinitions="44,*,Auto"
                                  ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        Padding="11"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        VerticalOptions="Center">
                                    <Image Source="{AppThemeBinding Light=icon_external_link.png, Dark=icon_external_link_white.png}"
                                           Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="1"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Loc.SourceLabel}"
                                           Style="{StaticResource StatTileLabel}" />
                                    <Label Text="{Binding Loc.OpenOriginalListingTitle}"
                                           FontFamily="SansSemibold"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding Loc.OpenOriginalListingSubtitle}"
                                           FontSize="11"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="28"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                                <Button Grid.ColumnSpan="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="Transparent"
                                        BorderWidth="0"
                                        Padding="0"
                                        MinimumHeightRequest="0"
                                        Command="{Binding OpenOriginalListingCommand}"
                                        SemanticProperties.Description="{Binding Loc.OpenOriginalListingSemantic}" />
                            </Grid>
                        </Border>

                        <!-- Beschreibung -->
                        <VerticalStackLayout Spacing="6"
                                             Padding="16,0"
                                             MaximumWidthRequest="900"
                                             HorizontalOptions="Fill"
                                             IsVisible="{Binding HasDescription}">
                            <Label Text="{Binding Loc.DescriptionHeader}"
                                   Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   LineHeight="1.25"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </VerticalStackLayout>

                        <!-- Datentabelle: gruppierte Sektionen als Karten -->
                        <VerticalStackLayout Spacing="12"
                                             Padding="16,0"
                                             MaximumWidthRequest="1100"
                                             HorizontalOptions="Fill"
                                             BindableLayout.ItemsSource="{Binding DetailSections}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PropertyDetailSection">
                                    <Border Style="{StaticResource Card}" Padding="16,12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}"
                                                   Style="{StaticResource SectionHeader}"
                                                   Margin="0,2,0,4" />
                                            <VerticalStackLayout Spacing="0"
                                                                 BindableLayout.ItemsSource="{Binding Items}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PropertyDetailItem">
                                                        <Grid ColumnDefinitions="*,*"
                                                              Padding="0,6">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding Value}"
                                                                   FontSize="13"
                                                                   FontFamily="SansMedium"
                                                                   HorizontalOptions="End"
                                                                   HorizontalTextAlignment="End"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Kontakt-Footer als Bottom-Sheet: liegt ueber dem Inhalt, hebt sich per Karte+Schatten ab.
             Zwei getrennte Borders mit konstanter Groesse: ein Border, der beim Aufklappen selbst
             waechst, behaelt auf Android seinen alten Clip-Pfad (StrokeShape) und schneidet
             Hintergrund + Inhalt ab. Hier waechst nur der aeussere Stack (ohne Clip). -->
        <VerticalStackLayout x:Name="ContactFooter"
                             VerticalOptions="End"
                             Spacing="0"
                             IsVisible="{Binding ShowContactFooter}">

            <!-- Kopfzeile: immer sichtbar, Tippen klappt Details auf/zu -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}"
                            Opacity="0.3"
                            Radius="14"
                            Offset="0,-4" />
                </Border.Shadow>
                <Grid MaximumWidthRequest="800"
                      HorizontalOptions="Fill"
                      AutomationId="Detail_ContactHeader">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Loc.SellerLabel}"
                                   Style="{StaticResource StatTileLabel}" />
                            <Label Text="{Binding SellerName}"
                                   FontFamily="SansSemibold"
                                   FontSize="14"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Text="{Binding ContactPersonText}"
                                   FontSize="12"
                                   IsVisible="{Binding HasContactPerson}"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="6"
                                               VerticalOptions="Center">
                            <Label Text="{Binding Loc.ContactLabel}"
                                   FontFamily="SansSemibold"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{Binding ContactExpandIcon}"
                                   FontSize="10"
                                   VerticalOptions="Center"
                                   AutomationId="Detail_ContactChevron"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Unsichtbarer vollflaechiger Button statt TapGestureRecognizer:
                         loest zuverlaessig genau einmal aus (Android) und ist auch unter
                         WinUI per DevFlow tapbar -->
                    <Button BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            BorderWidth="0"
                            Padding="0"
                            MinimumHeightRequest="0"
                            Command="{Binding ToggleContactExpandedCommand}"
                            AutomationId="Detail_ContactToggle" />
                </Grid>
            </Border>

            <!-- Aufklappbarer Bereich: eigener Border konstanter Groesse (nur Sichtbarkeit toggelt),
                 Hoehe gedeckelt, viele Kontakte scrollen intern -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    StrokeThickness="0"
                    Padding="0"
                    IsVisible="{Binding IsContactExpanded}"
                    AutomationId="Detail_ContactPanel">
                <VerticalStackLayout Padding="16,0,16,16"
                                     Spacing="12"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill">
                    <BoxView Style="{StaticResource Divider}" />

                    <ScrollView MaximumHeightRequest="240"
                                VerticalScrollBarVisibility="Default">
                        <VerticalStackLayout Spacing="14"
                                             BindableLayout.ItemsSource="{Binding Contacts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ContactDisplayItem">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Name}"
                                               FontFamily="SansSemibold"
                                               FontSize="13"
                                               IsVisible="{Binding HasName}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                                        <!-- E-Mail: Tippen oeffnet Mail-App, Button kopiert -->
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8"
                                              IsVisible="{Binding HasEmail}">
                                            <Label Grid.Column="0"
                                                   Text="✉️"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Email}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ContactByEmailCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                                          CommandParameter="{Binding Email}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Button Grid.Column="2"
                                                    Text="{Binding Loc.CopyButton, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}, x:DataType=vm:PropertyDetailViewModel}"
                                                    Style="{StaticResource LinkButton}"
                                                    FontSize="11"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                                    Command="{Binding CopyToClipboardCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                    CommandParameter="{Binding Email}" />
                                        </Grid>

                                        <!-- Telefon: Tippen oeffnet Telefon-App, Button kopiert -->
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8"
                                              IsVisible="{Binding HasPhone}">
                                            <Label Grid.Column="0"
                                                   Text="📞"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Phone}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding CallPhoneCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                                          CommandParameter="{Binding Phone}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Button Grid.Column="2"
                                                    Text="{Binding Loc.CopyButton, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}, x:DataType=vm:PropertyDetailViewModel}"
                                                    Style="{StaticResource LinkButton}"
                                                    FontSize="11"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                                    Command="{Binding CopyToClipboardCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                    CommandParameter="{Binding Phone}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Kopiert-Feedback: feste Hoehe, damit der Panel-Border beim Einblenden
                         nicht resized (Android-Clip-Problem bei dynamischer Border-Groesse) -->
                    <Label Text="{Binding CopyFeedback}"
                           FontSize="12"
                           FontFamily="SansSemibold"
                           HeightRequest="16"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Busy-Overlay -->
        <Grid Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Vollbild-Bildviewer (Lightbox wie im Web): Pinch/Zoom, Doppeltipp,
             eingebauter Schliessen-Button. IsVisible zwingend: geschlossen rendert
             der Viewer sein Source-Bild sonst inline ueber der Seite -->
        <shiny:ImageViewer Source="{Binding CurrentFullImageUrl}"
                           IsOpen="{Binding IsImageViewerOpen, Mode=TwoWay}"
                           IsVisible="{Binding IsImageViewerOpen}"
                           OpenViewerOnTap="False" />

        <!-- Blaettern im Vollbild: kleine content-grosse Container statt vollflaechiger
             Overlays, damit echte Klicks den Schliessen-Button und die Gesten des
             Viewers erreichen. IsVisible NUR am Grid (WinUI malt Kinder mit eigenem
             IsVisible-Binding hier nicht); hoher ZIndex, weil der ImageViewer sein
             Overlay sonst darueber legt -->
        <Grid IsVisible="{Binding ShowViewerNavigation}"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              Margin="14,0,0,0"
              ZIndex="9999">
            <Button Command="{Binding ShowPreviousImageCommand}"
                    Padding="0"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BorderWidth="1"
                    BackgroundColor="{StaticResource GlassPillBackground}"
                    BorderColor="{StaticResource GlassPillStroke}"
                    AutomationId="Detail_Viewer_Previous" />
            <Path Data="M10,1 L4,7 L10,13"
                  Stroke="White"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  WidthRequest="14"
                  HeightRequest="14"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  InputTransparent="True" />
        </Grid>

        <Grid IsVisible="{Binding ShowViewerNavigation}"
              HorizontalOptions="End"
              VerticalOptions="Center"
              Margin="0,0,14,0"
              ZIndex="9999">
            <Button Command="{Binding ShowNextImageCommand}"
                    Padding="0"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BorderWidth="1"
                    BackgroundColor="{StaticResource GlassPillBackground}"
                    BorderColor="{StaticResource GlassPillStroke}"
                    AutomationId="Detail_Viewer_Next" />
            <Path Data="M4,1 L10,7 L4,13"
                  Stroke="White"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  WidthRequest="14"
                  HeightRequest="14"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  InputTransparent="True" />
        </Grid>

        <!-- Deutliches Schliessen-X: liegt exakt ueber dem kaum sichtbaren
             eingebauten X des Viewers (Position 16/50 von rechts oben) -->
        <Grid IsVisible="{Binding IsImageViewerOpen}"
              HorizontalOptions="End"
              VerticalOptions="Start"
              Margin="0,50,16,0"
              ZIndex="9999">
            <Button Command="{Binding CloseImageViewerCommand}"
                    Padding="0"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BorderWidth="1"
                    BackgroundColor="{StaticResource GlassPillBackground}"
                    BorderColor="{StaticResource GlassPillStroke}"
                    SemanticProperties.Description="{Binding Loc.CloseViewerSemantic}"
                    AutomationId="Detail_Viewer_Close" />
            <!-- X als Geometrie statt Font-Glyph: Buttons zentrieren Text ueber
                 Baseline-Metriken, das Glyph sitzt dadurch nie exakt mittig -->
            <Path Data="M1,1 L13,13 M13,1 L1,13"
                  Stroke="White"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  WidthRequest="14"
                  HeightRequest="14"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  InputTransparent="True" />
        </Grid>

        <!-- Zaehler im Vollbild (eigenes Grid: eigenes Sichtbarkeits-Kriterium) -->
        <Grid IsVisible="{Binding IsImageViewerOpen}"
              HorizontalOptions="Center"
              VerticalOptions="End"
              Margin="0,0,0,24"
              InputTransparent="True"
              ZIndex="9999">
            <Border Style="{StaticResource GlassPill}"
                    Padding="10,4">
                <Label Text="{Binding ImageCounterText}"
                       FontSize="12"
                       FontFamily="SansMedium"
                       TextColor="White" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
