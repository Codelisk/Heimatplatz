<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.PropertyDetailPage"
             x:DataType="vm:PropertyDetailViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,16">

                <!-- Bilder-Carousel -->
                <Grid HeightRequest="260">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0">
                        <Label Text="🏠"
                               FontSize="48"
                               Opacity="0.4"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <CarouselView ItemsSource="{Binding ImageUrls}"
                                  IndicatorView="ImageIndicator"
                                  IsVisible="{Binding HasImages}"
                                  Loop="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Image Source="{Binding .}"
                                       Aspect="AspectFill" />
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="ImageIndicator"
                                   IndicatorColor="#80FFFFFF"
                                   SelectedIndicatorColor="White"
                                   VerticalOptions="End"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,10"
                                   IsVisible="{Binding HasImages}" />

                    <!-- Typ-Badge -->
                    <Border BackgroundColor="{Binding TypeBadgeColor}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,6"
                            Margin="12"
                            VerticalOptions="Start"
                            HorizontalOptions="Start">
                        <Label Text="{Binding TypeBadgeText}"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="White" />
                    </Border>
                </Grid>

                <!-- Kopf: Titel, Preis, Adresse, Aktionen -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill">
                    <Label Text="{Binding Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           MaxLines="4"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Label Text="{Binding FormattedPrice}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

                    <Label Text="{Binding AddressText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <!-- Aktionen: Merken + Teilen -->
                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                        <Button Command="{Binding ToggleFavoriteCommand}"
                                IsVisible="{Binding IsAuthenticated}"
                                Style="{StaticResource FilterChipStyle}">
                            <Button.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="FavoriteButtonIcon" />
                                    <Binding Path="FavoriteButtonText" />
                                </MultiBinding>
                            </Button.Text>
                        </Button>

                        <Button Text="Teilen"
                                Command="{Binding SharePropertyCommand}"
                                Style="{StaticResource FilterChipStyle}" />

                        <Button Text="Zum Original-Inserat"
                                Command="{Binding OpenOriginalListingCommand}"
                                IsVisible="{Binding HasOriginalListingUrl}"
                                Style="{StaticResource FilterChipStyle}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding CopyFeedback}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                           IsVisible="{Binding HasCopyFeedback}" />
                </VerticalStackLayout>

                <!-- Beschreibung -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     IsVisible="{Binding HasDescription}">
                    <Label Text="BESCHREIBUNG"
                           Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding Description}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>

                <!-- Ausstattung -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     IsVisible="{Binding HasFeatures}">
                    <Label Text="AUSSTATTUNG"
                           Style="{StaticResource SectionHeader}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding FeaturesList}"
                                Wrap="Wrap"
                                JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 4"
                                        Padding="8,4"
                                        Margin="0,0,6,6">
                                    <Label Text="{Binding .}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Datentabelle: gruppierte Sektionen -->
                <VerticalStackLayout Spacing="12"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     BindableLayout.ItemsSource="{Binding DetailSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PropertyDetailSection">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,8,0,4" />
                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyDetailItem">
                                            <Grid ColumnDefinitions="*,*"
                                                  Padding="0,6">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="13"
                                                       HorizontalOptions="End"
                                                       HorizontalTextAlignment="End"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Kontakt-Footer -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                StrokeThickness="0"
                Padding="16,10"
                IsVisible="{Binding HasContactPerson}">
            <VerticalStackLayout Spacing="4"
                                 MaximumWidthRequest="800"
                                 HorizontalOptions="Fill">
                <Label Text="{Binding ContactPersonText}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <HorizontalStackLayout Spacing="12">
                    <Label Text="{Binding PrimaryContactEmail}"
                           FontSize="12"
                           IsVisible="{Binding HasPrimaryEmail}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CopyToClipboardCommand}"
                                                  CommandParameter="{Binding PrimaryContactEmail}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="{Binding PrimaryContactPhone}"
                           FontSize="12"
                           IsVisible="{Binding HasPrimaryPhone}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CopyToClipboardCommand}"
                                                  CommandParameter="{Binding PrimaryContactPhone}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Busy-Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
