<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.PropertyDetailPage"
             x:DataType="vm:PropertyDetailViewModel"
             Title="{Binding Title}">

    <!-- Single-Cell-Grid: Der Kontakt-Footer liegt als Bottom-Sheet UEBER dem Inhalt.
         Bewusst kein Auto-Row-Resize: dynamisches Zeilenwachstum beim Aufklappen
         loest auf Android keinen Relayout des ScrollViews aus (stale Bounds). -->
    <Grid>

        <ScrollView>
            <!-- Bottom-Padding reserviert Platz fuer die eingeklappte Kontakt-Leiste -->
            <VerticalStackLayout Spacing="16" Padding="0,0,0,96">

                <!-- Fehler-/Nicht-mehr-verfuegbar-Hinweis -->
                <Border IsVisible="{Binding HasLoadError}"
                        Style="{StaticResource ErrorBanner}"
                        Margin="16,16,16,0">
                    <Label Text="{Binding LoadErrorText}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Bilder-Carousel -->
                <Grid HeightRequest="260">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0">
                        <Label Text="🏠"
                               FontSize="48"
                               Opacity="0.4"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <CarouselView ItemsSource="{Binding ImageUrls}"
                                  IndicatorView="ImageIndicator"
                                  IsVisible="{Binding HasImages}"
                                  Position="{Binding CurrentImagePosition}"
                                  Loop="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Image Source="{Binding .}"
                                       Aspect="AspectFill" />
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="ImageIndicator"
                                   IndicatorColor="#80FFFFFF"
                                   SelectedIndicatorColor="White"
                                   VerticalOptions="End"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,10"
                                   IsVisible="{Binding HasImages}" />

                    <!-- Typ-Badge -->
                    <Border BackgroundColor="{Binding TypeBadgeColor}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,6"
                            Margin="12"
                            VerticalOptions="Start"
                            HorizontalOptions="Start">
                        <Label Text="{Binding TypeBadgeText}"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="White" />
                    </Border>

                    <!-- Teilen als kontextuelle Bildaktion -->
                    <ImageButton Source="icon_share.png"
                                 Command="{Binding SharePropertyCommand}"
                                 BackgroundColor="White"
                                 BorderColor="#22000000"
                                 BorderWidth="1"
                                 CornerRadius="22"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Padding="11"
                                 Margin="12"
                                 VerticalOptions="Start"
                                 HorizontalOptions="End"
                                 SemanticProperties.Description="Immobilie teilen">
                        <ImageButton.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.22"
                                    Radius="8"
                                    Offset="0,3" />
                        </ImageButton.Shadow>
                    </ImageButton>

                    <!-- Bild-Zaehler (unten links) -->
                    <Border BackgroundColor="#80000000"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,4"
                            Margin="12"
                            VerticalOptions="End"
                            HorizontalOptions="Start"
                            IsVisible="{Binding HasImages}">
                        <Label Text="{Binding ImageCounterText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                </Grid>

                <!-- Kopf: Titel, Preis, Adresse, Merken -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill">
                    <Label Text="{Binding Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           MaxLines="4"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Label Text="{Binding FormattedPrice}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

                    <Label Text="{Binding AddressText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <!-- Merken bleibt beim Objekt; Teilen liegt direkt auf dem Bild -->
                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                        <Button Command="{Binding ToggleFavoriteCommand}"
                                IsVisible="{Binding IsAuthenticated}"
                                Style="{StaticResource FilterChipStyle}">
                            <Button.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="FavoriteButtonIcon" />
                                    <Binding Path="FavoriteButtonText" />
                                </MultiBinding>
                            </Button.Text>
                        </Button>
                    </HorizontalStackLayout>

                    <Label Text="{Binding CopyFeedback}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                           IsVisible="{Binding HasCopyFeedback}" />
                </VerticalStackLayout>

                <!-- Quellenkarte: klar getrennt von Objekt- und Kontaktaktionen -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14"
                        Margin="16,2"
                        MaximumWidthRequest="768"
                        HorizontalOptions="Fill"
                        IsVisible="{Binding HasOriginalListingUrl}">
                    <Grid ColumnDefinitions="44,*,Auto"
                          ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="11"
                                BackgroundColor="White"
                                Stroke="#16000000"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="Center">
                            <Image Source="icon_external_link.png"
                                   Aspect="AspectFit" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="1"
                                             VerticalOptions="Center">
                            <Label Text="QUELLE"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <Label Text="Original-Inserat öffnen"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Text="Alle Angaben direkt beim Anbieter ansehen"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                        <Button Grid.ColumnSpan="3"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                BorderWidth="0"
                                Padding="0"
                                MinimumHeightRequest="0"
                                Command="{Binding OpenOriginalListingCommand}"
                                SemanticProperties.Description="Original-Inserat beim Anbieter öffnen" />
                    </Grid>
                </Border>

                <!-- Beschreibung -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     IsVisible="{Binding HasDescription}">
                    <Label Text="BESCHREIBUNG"
                           Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding Description}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>

                <!-- Datentabelle: gruppierte Sektionen -->
                <VerticalStackLayout Spacing="12"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     BindableLayout.ItemsSource="{Binding DetailSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PropertyDetailSection">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,8,0,4" />
                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyDetailItem">
                                            <Grid ColumnDefinitions="*,*"
                                                  Padding="0,6">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="13"
                                                       HorizontalOptions="End"
                                                       HorizontalTextAlignment="End"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Kontakt-Footer als Bottom-Sheet: liegt ueber dem Inhalt, hebt sich per Karte+Schatten ab.
             Zwei getrennte Borders mit konstanter Groesse: ein Border, der beim Aufklappen selbst
             waechst, behaelt auf Android seinen alten Clip-Pfad (StrokeShape) und schneidet
             Hintergrund + Inhalt ab. Hier waechst nur der aeussere Stack (ohne Clip). -->
        <VerticalStackLayout x:Name="ContactFooter"
                             VerticalOptions="End"
                             Spacing="0"
                             IsVisible="{Binding HasContactFooter}">

            <!-- Kopfzeile: immer sichtbar, Tippen klappt Details auf/zu -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16,16,0,0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}"
                            Opacity="0.3"
                            Radius="14"
                            Offset="0,-4" />
                </Border.Shadow>
                <Grid MaximumWidthRequest="800"
                      HorizontalOptions="Fill"
                      AutomationId="Detail_ContactHeader">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Padding="16,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="ANBIETER"
                                   FontSize="10"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <Label Text="{Binding SellerName}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Text="{Binding ContactPersonText}"
                                   FontSize="12"
                                   IsVisible="{Binding HasContactPerson}"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="6"
                                               VerticalOptions="Center">
                            <Label Text="Kontakt"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                            <Label Text="{Binding ContactExpandIcon}"
                                   FontSize="10"
                                   VerticalOptions="Center"
                                   AutomationId="Detail_ContactChevron"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Unsichtbarer vollflaechiger Button statt TapGestureRecognizer:
                         loest zuverlaessig genau einmal aus (Android) und ist auch unter
                         WinUI per DevFlow tapbar -->
                    <Button BackgroundColor="Transparent"
                            BorderColor="Transparent"
                            BorderWidth="0"
                            Padding="0"
                            MinimumHeightRequest="0"
                            Command="{Binding ToggleContactExpandedCommand}"
                            AutomationId="Detail_ContactToggle" />
                </Grid>
            </Border>

            <!-- Aufklappbarer Bereich: eigener Border konstanter Groesse (nur Sichtbarkeit toggelt),
                 Hoehe gedeckelt, viele Kontakte scrollen intern -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                    StrokeThickness="0"
                    Padding="0"
                    IsVisible="{Binding IsContactExpanded}"
                    AutomationId="Detail_ContactPanel">
                <VerticalStackLayout Padding="16,0,16,16"
                                     Spacing="12"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill">
                    <BoxView Style="{StaticResource Divider}" />

                    <ScrollView MaximumHeightRequest="240"
                                VerticalScrollBarVisibility="Default">
                        <VerticalStackLayout Spacing="14"
                                             BindableLayout.ItemsSource="{Binding Contacts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ContactDisplayItem">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Name}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               IsVisible="{Binding HasName}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                                        <!-- E-Mail: Tippen oeffnet Mail-App, Button kopiert -->
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8"
                                              IsVisible="{Binding HasEmail}">
                                            <Label Grid.Column="0"
                                                   Text="✉️"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Email}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ContactByEmailCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                                          CommandParameter="{Binding Email}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Button Grid.Column="2"
                                                    Text="Kopieren"
                                                    Style="{StaticResource LinkButton}"
                                                    FontSize="11"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                                    Command="{Binding CopyToClipboardCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                    CommandParameter="{Binding Email}" />
                                        </Grid>

                                        <!-- Telefon: Tippen oeffnet Telefon-App, Button kopiert -->
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="8"
                                              IsVisible="{Binding HasPhone}">
                                            <Label Grid.Column="0"
                                                   Text="📞"
                                                   FontSize="13"
                                                   VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Phone}"
                                                   FontSize="13"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding CallPhoneCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                                          CommandParameter="{Binding Phone}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Button Grid.Column="2"
                                                    Text="Kopieren"
                                                    Style="{StaticResource LinkButton}"
                                                    FontSize="11"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                                                    Command="{Binding CopyToClipboardCommand, Source={RelativeSource AncestorType={x:Type vm:PropertyDetailViewModel}}}"
                                                    CommandParameter="{Binding Phone}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Kopiert-Feedback: feste Hoehe, damit der Panel-Border beim Einblenden
                         nicht resized (Android-Clip-Problem bei dynamischer Border-Groesse) -->
                    <Label Text="{Binding CopyFeedback}"
                           FontSize="12"
                           FontAttributes="Bold"
                           HeightRequest="16"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Busy-Overlay -->
        <Grid Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
