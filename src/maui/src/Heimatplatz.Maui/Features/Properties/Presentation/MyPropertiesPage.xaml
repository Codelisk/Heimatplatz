<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.MyPropertiesPage"
             x:DataType="vm:MyPropertiesViewModel"
             Title="Meine Immobilien">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Neu"
                     Command="{Binding NavigateToAddPropertyCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Properties}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            controls:ResponsiveGrid.MinItemWidth="320">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Grid Padding="24,60,24,24">
                        <!-- Angemeldet: regulaerer Leer-Zustand mit direktem Hinzufuegen-Button -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding ShowRegularEmptyState}">
                            <Label Text="🏠"
                                   Style="{StaticResource EmptyStateIcon}"
                                   Opacity="0.5" />
                            <Label Text="Noch keine Immobilien" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="Fügen Sie Ihre erste Immobilie hinzu."
                                   Style="{StaticResource EmptyStateHint}" />
                            <Button Text="Immobilie hinzufügen"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NavigateToAddPropertyCommand}"
                                    HorizontalOptions="Center"
                                    Margin="0,16,0,0" />
                        </VerticalStackLayout>

                        <!-- Nicht angemeldet: Anmelde-Hinweis statt irrefuehrendem Leer-Zustand -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding IsLoggedOut}">
                            <Label Text="🔒"
                                   Style="{StaticResource EmptyStateIcon}"
                                   Opacity="0.5" />
                            <Label Text="Nicht angemeldet" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="Melden Sie sich an, um Ihre Immobilien zu verwalten."
                                   Style="{StaticResource EmptyStateHint}" />
                            <Button Text="Anmelden"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GoToLoginCommand}"
                                    HorizontalOptions="Center"
                                    Margin="0,16,0,0" />
                        </VerticalStackLayout>

                        <!-- Angemeldet, aber keine Verkaeufer-Rolle: Hinweis statt 403-Fehler -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding IsSellerBlocked}">
                            <Label Text="🏠"
                                   Style="{StaticResource EmptyStateIcon}"
                                   Opacity="0.5" />
                            <Label Text="Nur für Verkäufer" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="Eigene Inserate sind nur mit einem Verkäufer-Konto möglich. Ihr Konto ist als Käufer registriert."
                                   Style="{StaticResource EmptyStateHint}" />
                        </VerticalStackLayout>

                        <!-- Lade-Fehler inline statt als modaler Dialog (blockiert keine Eingaben) -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding HasLoadError}">
                            <Label Text="📡" Style="{StaticResource EmptyStateIcon}" />
                            <Label Text="Laden fehlgeschlagen" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding LoadErrorMessage}" Style="{StaticResource EmptyStateHint}" />
                            <Button Text="Erneut versuchen"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RetryLoadCommand}"
                                    Margin="0,10,0,0"
                                    HorizontalOptions="Center"
                                    AutomationId="MyProperties_RetryLoad" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:PropertyListItemDto">
                        <Grid Padding="12,0">
                            <controls:PropertyCard Property="{Binding .}"
                                                   Mode="{x:Static models:CardMode.Owner}"
                                                   CardClickedCommand="{Binding EditPropertyCommand, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}"
                                                   DeleteCommand="{Binding RemoveFromCollectionCommand, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Margin="0,8,0,16"
                                       HorizontalOptions="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Busy-Overlay -->
        <Grid Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
