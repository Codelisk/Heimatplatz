<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated;assembly=Heimatplatz.Maui.ApiClient"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.MyPropertiesPage"
             x:DataType="vm:MyPropertiesViewModel"
             Title="{Binding Loc.PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding Loc.NewToolbarItem}"
                     Command="{Binding NavigateToAddPropertyCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- Entwuerfe des Inserat-Wizards: bewusst NICHT als CollectionView.Header -
             WinUI vermisst den Header nach IsVisible-Toggle nicht neu (Bounds bleiben leer) -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="12,8,12,0"
                             Spacing="8"
                             IsVisible="{Binding HasDrafts}">
            <Label Text="{Binding Loc.DraftsSectionTitle}"
                   Style="{StaticResource SectionHeader}" />
            <ScrollView MaximumHeightRequest="300">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Drafts}"
                                     Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:DraftListItem">
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnDefinitions="64,*,Auto"
                                      ColumnSpacing="12">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ResumeDraftCommand, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <!-- Thumbnail bzw. Platzhalter -->
                                    <Border Grid.Column="0"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            WidthRequest="64"
                                            HeightRequest="64"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                            VerticalOptions="Center">
                                        <Grid>
                                            <Label Text="📝"
                                                   FontSize="24"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                            <Image Source="{Binding Thumbnail}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding HasImage}" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="4"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding DisplayTitle}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding StepText}"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="6"
                                                         VerticalOptions="Center">
                                        <Button Text="{Binding Loc.ResumeDraft, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}"
                                                FontSize="12"
                                                Padding="10,6"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding ResumeDraftCommand, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="{Binding Loc.DeleteDraft, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}"
                                                FontSize="12"
                                                Padding="10,6"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DeleteDraftCommand, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
            <Label Text="{Binding Loc.PublishedSectionTitle}"
                   Style="{StaticResource SectionHeader}"
                   Margin="0,8,0,0"
                   IsVisible="{Binding IsNotEmpty}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Properties}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            controls:ResponsiveGrid.MinItemWidth="320"
                            controls:ResponsiveGrid.ItemHorizontalPadding="24"
                            controls:ResponsiveGrid.HorizontalItemSpacing="12"
                            controls:ResponsiveGrid.MaxColumns="4">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="1"
                                     VerticalItemSpacing="20" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Grid Padding="24,60,24,24">
                        <!-- Angemeldet: regulaerer Leer-Zustand mit direktem Hinzufuegen-Button -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding ShowRegularEmptyState}">
                            <Label Text="🏠"
                                   Style="{StaticResource EmptyStateIcon}"
                                   Opacity="0.5" />
                            <Label Text="{Binding Loc.EmptyTitle}" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding Loc.EmptyHint}"
                                   Style="{StaticResource EmptyStateHint}" />
                            <Button Text="{Binding Loc.AddProperty}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NavigateToAddPropertyCommand}"
                                    HorizontalOptions="Center"
                                    Margin="0,16,0,0" />
                        </VerticalStackLayout>

                        <!-- Nicht angemeldet: Anmelde-Hinweis statt irrefuehrendem Leer-Zustand -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding IsLoggedOut}">
                            <Label Text="🔒"
                                   Style="{StaticResource EmptyStateIcon}"
                                   Opacity="0.5" />
                            <Label Text="{Binding Loc.NotLoggedInTitle}" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding Loc.NotLoggedInHint}"
                                   Style="{StaticResource EmptyStateHint}" />
                            <Button Text="{Binding Loc.Login}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding GoToLoginCommand}"
                                    HorizontalOptions="Center"
                                    Margin="0,16,0,0" />
                        </VerticalStackLayout>

                        <!-- Angemeldet, aber keine Verkaeufer-Rolle: Hinweis statt 403-Fehler -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding IsSellerBlocked}">
                            <Label Text="🏠"
                                   Style="{StaticResource EmptyStateIcon}"
                                   Opacity="0.5" />
                            <Label Text="{Binding Loc.SellerOnlyTitle}" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding Loc.SellerOnlyHint}"
                                   Style="{StaticResource EmptyStateHint}" />
                        </VerticalStackLayout>

                        <!-- Lade-Fehler inline statt als modaler Dialog (blockiert keine Eingaben) -->
                        <VerticalStackLayout Spacing="8"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             IsVisible="{Binding ShowLoadError}">
                            <Image Source="icon_offline.png" Style="{StaticResource EmptyStateImageIcon}" />
                            <Label Text="{Binding Loc.LoadFailedTitle}" Style="{StaticResource EmptyStateTitle}" />
                            <Label Text="{Binding LoadErrorMessage}" Style="{StaticResource EmptyStateHint}" />
                            <Button Text="{Binding Loc.Retry}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RetryLoadCommand}"
                                    Margin="0,10,0,0"
                                    HorizontalOptions="Center"
                                    AutomationId="MyProperties_RetryLoad" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:PropertyListItemDto">
                        <Grid Padding="12,0">
                            <controls:PropertyCard Property="{Binding .}"
                                                   Mode="{x:Static models:CardMode.Owner}"
                                                   CardClickedCommand="{Binding EditPropertyCommand, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}"
                                                   DeleteCommand="{Binding RemoveFromCollectionCommand, Source={RelativeSource AncestorType={x:Type vm:MyPropertiesViewModel}}, x:DataType=vm:MyPropertiesViewModel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Margin="0,8,0,16"
                                       HorizontalOptions="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Busy-Overlay -->
        <Grid Grid.RowSpan="2"
              Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
