<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.ForeclosureDetailPage"
             x:DataType="vm:ForeclosureDetailViewModel"
             Shell.FlyoutBehavior="Disabled"
             Title="{Binding Loc.PageTitle}">

    <Grid x:Name="ForeclosureRoot"
          RowDefinitions="*,Auto"
          appcontrols:ResponsiveLayout.IsEnabled="True">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroupList>
                <VisualStateGroup x:Name="WindowWidthStates">
                    <VisualState x:Name="Compact" />
                    <VisualState x:Name="Medium">
                        <VisualState.Setters>
                            <Setter TargetName="ForeclosureLeadGrid" Property="MaximumWidthRequest" Value="1160" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="Margin" Value="24,24,24,0" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="RowDefinitions" Value="420" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="ColumnDefinitions" Value="3*,2*" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="ColumnSpacing" Value="20" />
                            <Setter TargetName="ForeclosureHero" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ForeclosureHero" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ForeclosureHero" Property="HeightRequest" Value="420" />
                            <Setter TargetName="ForeclosureSummary" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ForeclosureSummary" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ForeclosureSummary" Property="Margin" Value="0" />
                            <Setter TargetName="ForeclosureSummary" Property="Padding" Value="4,24" />
                            <Setter TargetName="ForeclosureBody" Property="MaximumWidthRequest" Value="1100" />
                            <Setter TargetName="ForeclosureScrollContent" Property="Padding" Value="0,0,0,96" />
                            <Setter TargetName="CourtFooter" Property="Grid.Row" Value="0" />
                            <Setter TargetName="CourtFooter" Property="MaximumWidthRequest" Value="440" />
                            <Setter TargetName="CourtFooter" Property="HorizontalOptions" Value="End" />
                            <Setter TargetName="CourtFooter" Property="VerticalOptions" Value="End" />
                            <Setter TargetName="CourtFooter" Property="Margin" Value="0,0,24,24" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Expanded">
                        <VisualState.Setters>
                            <Setter TargetName="ForeclosureLeadGrid" Property="MaximumWidthRequest" Value="1200" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="Margin" Value="32,28,32,0" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="RowDefinitions" Value="460" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="ColumnDefinitions" Value="3*,2*" />
                            <Setter TargetName="ForeclosureLeadGrid" Property="ColumnSpacing" Value="24" />
                            <Setter TargetName="ForeclosureHero" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ForeclosureHero" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ForeclosureHero" Property="HeightRequest" Value="460" />
                            <Setter TargetName="ForeclosureSummary" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ForeclosureSummary" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ForeclosureSummary" Property="Margin" Value="0" />
                            <Setter TargetName="ForeclosureSummary" Property="Padding" Value="8,28" />
                            <Setter TargetName="ForeclosureBody" Property="MaximumWidthRequest" Value="1160" />
                            <Setter TargetName="ForeclosureScrollContent" Property="Padding" Value="0,0,0,96" />
                            <Setter TargetName="CourtFooter" Property="Grid.Row" Value="0" />
                            <Setter TargetName="CourtFooter" Property="MaximumWidthRequest" Value="460" />
                            <Setter TargetName="CourtFooter" Property="HorizontalOptions" Value="End" />
                            <Setter TargetName="CourtFooter" Property="VerticalOptions" Value="End" />
                            <Setter TargetName="CourtFooter" Property="Margin" Value="0,0,32,24" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </VisualStateManager.VisualStateGroups>

        <!-- Fehler-/Offline-Zustand: ersetzt den Inhalt vollflaechig
             (Offline mit Retry bzw. "nicht mehr verfuegbar" bei entfernten Versteigerungen) -->
        <Grid Grid.Row="0"
              IsVisible="{Binding HasLoadError}"
              Padding="32,0">
            <VerticalStackLayout Spacing="8"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="420">
                <Label Text="{Binding LoadErrorIcon}"
                       Style="{StaticResource EmptyStateIcon}" />
                <Label Text="{Binding LoadErrorTitle}"
                       Style="{StaticResource EmptyStateTitle}"
                       AutomationId="ForeclosureDetail_LoadErrorTitle" />
                <Label Text="{Binding LoadErrorText}"
                       Style="{StaticResource EmptyStateHint}"
                       AutomationId="ForeclosureDetail_LoadErrorMessage" />
                <Button Text="{Binding Loc.RetryButton}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RetryLoadCommand}"
                        IsVisible="{Binding CanRetryLoad}"
                        Margin="0,10,0,0"
                        HorizontalOptions="Center"
                        AutomationId="ForeclosureDetail_RetryLoad" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="0"
                    IsVisible="{Binding ShowContent}">
            <VerticalStackLayout x:Name="ForeclosureScrollContent"
                                 Spacing="0"
                                 Padding="0,0,0,16">

                <Border Margin="12,10,12,0"
                        Padding="12,9"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#D98200, Dark=#F2A93B}"
                        BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#352A1D}"
                        StrokeShape="RoundRectangle 8"
                        IsVisible="{Binding IsShowingCachedData}"
                        AutomationId="ForeclosureDetail_CachedDataNotice">
                    <Label Text="{Binding Loc.CachedDataNotice}"
                           FontSize="12.5"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </Border>

                <Grid x:Name="ForeclosureLeadGrid"
                      RowDefinitions="300,Auto"
                      ColumnDefinitions="*"
                      HorizontalOptions="Fill">

                <!-- Hero: Bilder-Carousel, Content-Sheet gleitet darueber -->
                <Grid x:Name="ForeclosureHero"
                      Grid.Row="0"
                      HeightRequest="300">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                            StrokeThickness="0">
                        <Image Source="logo.png"
                               WidthRequest="110"
                               Opacity="0.16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Mobile: Swipe-Carousel. Unter WinUI ausgeblendet, weil der
                         CarouselView-Container Bilder dort verzerrt auf Item-Groesse
                         skaliert (Aspect wird komplett ignoriert) -->
                    <Grid>
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="True">
                                <On Platform="WinUI" Value="False" />
                            </OnPlatform>
                        </Grid.IsVisible>

                        <CarouselView ItemsSource="{Binding ImageUrls}"
                                      IndicatorView="ImageIndicator"
                                      IsVisible="{Binding HasImages}"
                                      Position="{Binding CurrentImagePosition, Mode=TwoWay}"
                                      PositionChanged="OnImagePositionChanged"
                                      Loop="False">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid>
                                        <Image Source="{Binding .}"
                                               Aspect="AspectFill" />
                                        <!-- Unsichtbare Tap-Flaeche: oeffnet die Grossansicht
                                             (Button statt TapGestureRecognizer, wirkt ueberall) -->
                                        <Button BackgroundColor="Transparent"
                                                BorderColor="Transparent"
                                                BorderWidth="0"
                                                Padding="0"
                                                MinimumHeightRequest="0"
                                                Command="{Binding OpenImageViewerCommand, Source={RelativeSource AncestorType={x:Type vm:ForeclosureDetailViewModel}}, x:DataType=vm:ForeclosureDetailViewModel}"
                                                SemanticProperties.Description="{Binding Loc.OpenImageViewerSemantic, Source={RelativeSource AncestorType={x:Type vm:ForeclosureDetailViewModel}}, x:DataType=vm:ForeclosureDetailViewModel}" />
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <IndicatorView x:Name="ImageIndicator"
                                       IndicatorColor="#80FFFFFF"
                                       SelectedIndicatorColor="White"
                                       VerticalOptions="End"
                                       HorizontalOptions="Center"
                                       Margin="0,0,0,36"
                                       IsVisible="{Binding HasImages}" />
                    </Grid>

                    <!-- Windows: Einzelbild + Pfeil-Navigation (Desktop hat kein Swipe) -->
                    <Grid>
                        <Grid.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="False">
                                <On Platform="WinUI" Value="True" />
                            </OnPlatform>
                        </Grid.IsVisible>

                        <Grid IsVisible="{Binding HasImages}">
                            <!-- AspectFit statt Fill: bei Desktop-Breite wuerde der Crop nur
                                 einen schmalen Bildstreifen zeigen; ganzes Foto zentriert -->
                            <Image Source="{Binding CurrentImageUrl}"
                                   Aspect="AspectFit" />

                            <!-- Unsichtbare Tap-Flaeche: oeffnet die Grossansicht (unter den Pfeilen) -->
                            <Button BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    BorderWidth="0"
                                    Padding="0"
                                    MinimumHeightRequest="0"
                                    Command="{Binding OpenImageViewerCommand}"
                                    SemanticProperties.Description="{Binding Loc.OpenImageViewerSemantic}"
                                    AutomationId="Foreclosure_OpenImageViewer" />

                            <!-- Pfeile als Geometrie statt Font-Glyph (siehe Schliessen-X) -->
                            <Grid IsVisible="{Binding HasMultipleImages}"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Center"
                                  Margin="14,0,0,0">
                                <Button Command="{Binding ShowPreviousImageCommand}"
                                        Padding="0"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        BorderWidth="1"
                                        BackgroundColor="{StaticResource GlassPillBackground}"
                                        BorderColor="{StaticResource GlassPillStroke}"
                                        AutomationId="Foreclosure_PreviousImage" />
                                <Path Data="M10,1 L4,7 L10,13"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      WidthRequest="14"
                                      HeightRequest="14"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
                            </Grid>

                            <Grid IsVisible="{Binding HasMultipleImages}"
                                  HorizontalOptions="End"
                                  VerticalOptions="Center"
                                  Margin="0,0,14,0">
                                <Button Command="{Binding ShowNextImageCommand}"
                                        Padding="0"
                                        MinimumHeightRequest="0"
                                        MinimumWidthRequest="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        CornerRadius="22"
                                        BorderWidth="1"
                                        BackgroundColor="{StaticResource GlassPillBackground}"
                                        BorderColor="{StaticResource GlassPillStroke}"
                                        AutomationId="Foreclosure_NextImage" />
                                <Path Data="M4,1 L10,7 L4,13"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      WidthRequest="14"
                                      HeightRequest="14"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Typ-Badge (Signal-Rot), eckig wie die Karten-Badges -->
                    <Border BackgroundColor="{Binding TypeBadgeColor}"
                            Stroke="{StaticResource GlassPillStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 2"
                            Padding="12,5"
                            Margin="14"
                            VerticalOptions="Start"
                            HorizontalOptions="Start">
                        <Label Text="{Binding TypeBadgeText}"
                               FontFamily="SansBold"
                               FontSize="10"
                               CharacterSpacing="1.4"
                               TextColor="White" />
                    </Border>

                    <!-- Teilen als kontextuelle Bildaktion (weisses Icon auf Glas);
                         Icon als zentriertes Overlay: ImageButton platziert sein Bild
                         auf WinUI nicht mittig -->
                    <Grid Margin="14"
                          VerticalOptions="Start"
                          HorizontalOptions="End">
                        <Button Command="{Binding SharePropertyCommand}"
                                Padding="0"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                CornerRadius="22"
                                BorderWidth="1"
                                BackgroundColor="{StaticResource GlassPillBackground}"
                                BorderColor="{StaticResource GlassPillStroke}"
                                SemanticProperties.Description="{Binding Loc.ShareSemantic}" />
                        <Image Source="icon_share_white.png"
                               WidthRequest="22"
                               HeightRequest="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>

                    <!-- Bild-Zaehler (oberhalb der Sheet-Kante) -->
                    <Border Style="{StaticResource GlassPill}"
                            Padding="8,3"
                            Margin="14,0,14,38"
                            VerticalOptions="End"
                            HorizontalOptions="Start"
                            IsVisible="{Binding HasImages}">
                        <Label Text="{Binding ImageCounterText}"
                               FontSize="11"
                               FontFamily="SansMedium"
                               TextColor="White" />
                    </Border>
                </Grid>

                <!-- Content-Sheet: rundet ueber das Foto (edler Ueberlapp) -->
                <Border x:Name="ForeclosureSummary"
                        Grid.Row="1"
                        Margin="0,-26,0,0"
                        Padding="0,20,0,0"
                        StrokeThickness="0"
                        Stroke="Transparent"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Paper}, Dark={StaticResource OffBlack}}"
                        StrokeShape="RoundRectangle 14,14,0,0"
                        appcontrols:ResponsiveLayout.IsEnabled="True"
                        appcontrols:ResponsiveLayout.UseWindowWidth="True">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="SummaryCornerStates">
                                <VisualState x:Name="Compact" />
                                <VisualState x:Name="Medium">
                                    <VisualState.Setters>
                                        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <VerticalStackLayout Spacing="16">

                        <!-- Kopf: Mindestgebot/Schaetzwert (Serif, Markenrot), Titel, Adresse, Merken -->
                        <VerticalStackLayout Spacing="6"
                                             Padding="16,0"
                                             MaximumWidthRequest="800"
                                             HorizontalOptions="Fill">
                            <!-- Price ist Mindestgebot bzw. Schaetzwert (nie Kaufpreis) - Caption stellt das klar.
                                 Ohne Wert (0) wird beides ausgeblendet statt "0 €" zu zeigen. -->
                            <Label Text="{Binding PriceCaption}"
                                   Style="{StaticResource StatTileLabel}"
                                   IsVisible="{Binding HasPrice}" />
                            <Label Text="{Binding FormattedPrice}"
                                   FontFamily="Display"
                                   FontSize="30"
                                   Margin="0,-2,0,0"
                                   IsVisible="{Binding HasPrice}"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PriceDark}}" />

                            <Label Text="{Binding Title}"
                                   FontFamily="Display"
                                   FontSize="20"
                                   MaxLines="4"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                            <Label Text="{Binding AddressText}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                            <!-- Merken bleibt beim Objekt; Teilen liegt direkt auf dem Bild -->
                            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                                <Button Command="{Binding ToggleFavoriteCommand}"
                                        IsVisible="{Binding IsAuthenticated}"
                                        Style="{StaticResource FilterChipStyle}">
                                    <Button.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="FavoriteButtonIcon" />
                                            <Binding Path="FavoriteButtonText" />
                                        </MultiBinding>
                                    </Button.Text>
                                </Button>
                            </HorizontalStackLayout>

                            <Label Text="{Binding CopyFeedback}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                   IsVisible="{Binding HasCopyFeedback}" />
                        </VerticalStackLayout>

                        <!-- Kernfakten auf einen Blick: Termin, Schaetzwert, Gesamtflaeche -->
                        <FlexLayout Wrap="Wrap"
                                    JustifyContent="Start"
                                    Padding="16,0,8,0"
                                    MaximumWidthRequest="800"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding HasStatTiles}"
                                    BindableLayout.ItemsSource="{Binding StatTiles}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:StatTileItem">
                                    <Border Style="{StaticResource StatTile}"
                                            FlexLayout.Basis="30%"
                                            FlexLayout.Grow="1"
                                            Margin="0,0,8,8">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Value}" Style="{StaticResource StatTileValue}" />
                                            <Label Text="{Binding Label}" Style="{StaticResource StatTileLabel}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
                </Grid>

                <VerticalStackLayout x:Name="ForeclosureBody"
                                     Spacing="16"
                                     Padding="0,16,0,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill">

                        <!-- Quellenkarte: klar getrennt von Objekt- und Dokumentaktionen -->
                        <Border Style="{StaticResource Card}"
                                Padding="14"
                                Margin="16,2"
                                MaximumWidthRequest="900"
                                HorizontalOptions="Fill"
                                IsVisible="{Binding HasEdictUrl}">
                            <Grid ColumnDefinitions="44,*,Auto"
                                  ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        Padding="11"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                                        Stroke="Transparent"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        VerticalOptions="Center">
                                    <Image Source="{AppThemeBinding Light=icon_external_link.png, Dark=icon_external_link_white.png}"
                                           Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="1"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Loc.OfficialDocumentLabel}"
                                           Style="{StaticResource StatTileLabel}" />
                                    <Label Text="{Binding Loc.OpenEdictTitle}"
                                           FontFamily="SansSemibold"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding Loc.OpenEdictSubtitle}"
                                           FontSize="11"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="28"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                                <Button Grid.ColumnSpan="3"
                                        BackgroundColor="Transparent"
                                        BorderColor="Transparent"
                                        BorderWidth="0"
                                        Padding="0"
                                        MinimumHeightRequest="0"
                                        Command="{Binding OpenEdictCommand}"
                                        SemanticProperties.Description="{Binding Loc.OpenEdictTitle}" />
                            </Grid>
                        </Border>

                        <!-- Beschreibung -->
                        <VerticalStackLayout Spacing="6"
                                             Padding="16,0"
                                             MaximumWidthRequest="900"
                                             HorizontalOptions="Fill"
                                             IsVisible="{Binding HasDescription}">
                            <Label Text="{Binding Loc.DescriptionHeader}"
                                   Style="{StaticResource SectionHeader}" />
                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   LineHeight="1.25"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        </VerticalStackLayout>

                        <!-- Dokumente -->
                        <VerticalStackLayout Spacing="6"
                                             Padding="16,0"
                                             MaximumWidthRequest="900"
                                             HorizontalOptions="Fill"
                                             IsVisible="{Binding HasDocuments}">
                            <Label Text="{Binding Loc.DocumentsHeader}"
                                   Style="{StaticResource SectionHeader}" />
                            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                                <Button Text="{Binding Loc.DocumentFloorPlan}"
                                        Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="{Binding FloorPlanUrl}"
                                        IsVisible="{Binding HasFloorPlanUrl}"
                                        Style="{StaticResource DocumentChipButton}" />
                                <Button Text="{Binding Loc.DocumentSitePlan}"
                                        Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="{Binding SitePlanUrl}"
                                        IsVisible="{Binding HasSitePlanUrl}"
                                        Style="{StaticResource DocumentChipButton}" />
                                <Button Text="{Binding Loc.DocumentLongAppraisal}"
                                        Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="{Binding LongAppraisalUrl}"
                                        IsVisible="{Binding HasLongAppraisalUrl}"
                                        Style="{StaticResource DocumentChipButton}" />
                                <Button Text="{Binding Loc.DocumentShortAppraisal}"
                                        Command="{Binding OpenDocumentCommand}"
                                        CommandParameter="{Binding ShortAppraisalUrl}"
                                        IsVisible="{Binding HasShortAppraisalUrl}"
                                        Style="{StaticResource DocumentChipButton}" />
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Datentabelle: gruppierte Sektionen als Karten -->
                        <VerticalStackLayout Spacing="12"
                                             Padding="16,0"
                                             MaximumWidthRequest="1100"
                                             HorizontalOptions="Fill"
                                             BindableLayout.ItemsSource="{Binding DetailSections}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PropertyDetailSection">
                                    <Border Style="{StaticResource Card}" Padding="16,12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}"
                                                   Style="{StaticResource SectionHeader}"
                                                   Margin="0,2,0,4" />
                                            <VerticalStackLayout Spacing="0"
                                                                 BindableLayout.ItemsSource="{Binding Items}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:PropertyDetailItem">
                                                        <Grid ColumnDefinitions="*,*"
                                                              Padding="0,6">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding Value}"
                                                                   FontSize="13"
                                                                   FontFamily="SansMedium"
                                                                   HorizontalOptions="End"
                                                                   HorizontalTextAlignment="End"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Gericht-Footer: gleiche Bottom-Sheet-Optik wie der Kontakt-Footer bei Immobilien -->
        <Border x:Name="CourtFooter"
                Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24,24,0,0"
                Padding="0"
                IsVisible="{Binding ShowCourtFooter}"
                appcontrols:ResponsiveLayout.IsEnabled="True"
                appcontrols:ResponsiveLayout.UseWindowWidth="True">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CourtCornerStates">
                        <VisualState x:Name="Compact" />
                        <VisualState x:Name="Medium">
                            <VisualState.Setters>
                                <Setter Property="StrokeShape" Value="RoundRectangle 24" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Expanded">
                            <VisualState.Setters>
                                <Setter Property="StrokeShape" Value="RoundRectangle 24" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}"
                        Opacity="0.3"
                        Radius="14"
                        Offset="0,-4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="2"
                                 Padding="16,12"
                                 MaximumWidthRequest="800"
                                 HorizontalOptions="Fill">
                <Label Text="{Binding Loc.CourtFooterLabel}"
                       Style="{StaticResource StatTileLabel}" />
                <Label Text="{Binding CourtName}"
                       FontFamily="SansSemibold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Busy-Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
