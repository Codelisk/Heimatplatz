<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.ForeclosureDetailPage"
             x:DataType="vm:ForeclosureDetailViewModel"
             Title="Zwangsversteigerung">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,16">

                <!-- Bilder-Carousel -->
                <Grid HeightRequest="260">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0">
                        <Label Text="🏛"
                               FontSize="48"
                               Opacity="0.4"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <CarouselView ItemsSource="{Binding ImageUrls}"
                                  IndicatorView="ImageIndicator"
                                  IsVisible="{Binding HasImages}"
                                  Loop="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Image Source="{Binding .}"
                                       Aspect="AspectFill" />
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="ImageIndicator"
                                   IndicatorColor="#80FFFFFF"
                                   SelectedIndicatorColor="White"
                                   VerticalOptions="End"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,10"
                                   IsVisible="{Binding HasImages}" />

                    <!-- Typ-Badge -->
                    <Border BackgroundColor="{Binding TypeBadgeColor}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,6"
                            Margin="12"
                            VerticalOptions="Start"
                            HorizontalOptions="Start">
                        <Label Text="{Binding TypeBadgeText}"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                </Grid>

                <!-- Kopf: Titel, Preis, Adresse, Aktionen -->
                <VerticalStackLayout Spacing="6" Padding="16,0">
                    <Label Text="{Binding Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Label Text="{Binding FormattedPrice}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{Binding AddressText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <!-- Aktionen: Merken + Teilen + Edikt -->
                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                        <Button Command="{Binding ToggleFavoriteCommand}"
                                IsVisible="{Binding IsAuthenticated}"
                                FontSize="13"
                                Padding="14,8"
                                CornerRadius="18"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}">
                            <Button.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="FavoriteButtonIcon" />
                                    <Binding Path="FavoriteButtonText" />
                                </MultiBinding>
                            </Button.Text>
                        </Button>

                        <Button Text="Teilen"
                                Command="{Binding SharePropertyCommand}"
                                FontSize="13"
                                Padding="14,8"
                                CornerRadius="18"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                        <Button Text="Zum Edikt"
                                Command="{Binding OpenEdictCommand}"
                                IsVisible="{Binding HasEdictUrl}"
                                FontSize="13"
                                Padding="14,8"
                                CornerRadius="18"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding CopyFeedback}"
                           FontSize="12"
                           TextColor="{StaticResource Primary}"
                           IsVisible="{Binding HasCopyFeedback}" />
                </VerticalStackLayout>

                <!-- Beschreibung -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     IsVisible="{Binding HasDescription}">
                    <Label Text="BESCHREIBUNG"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Label Text="{Binding Description}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>

                <!-- Dokumente -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     IsVisible="{Binding HasDocuments}">
                    <Label Text="DOKUMENTE"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Button Text="Edikt"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding EdictUrl}"
                                IsVisible="{Binding HasEdictUrl}"
                                FontSize="12"
                                Padding="10,6"
                                Margin="0,0,6,6"
                                CornerRadius="6"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{StaticResource Primary}" />
                        <Button Text="Grundriss"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding FloorPlanUrl}"
                                IsVisible="{Binding HasFloorPlanUrl}"
                                FontSize="12"
                                Padding="10,6"
                                Margin="0,0,6,6"
                                CornerRadius="6"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{StaticResource Primary}" />
                        <Button Text="Lageplan"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding SitePlanUrl}"
                                IsVisible="{Binding HasSitePlanUrl}"
                                FontSize="12"
                                Padding="10,6"
                                Margin="0,0,6,6"
                                CornerRadius="6"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{StaticResource Primary}" />
                        <Button Text="Langgutachten"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding LongAppraisalUrl}"
                                IsVisible="{Binding HasLongAppraisalUrl}"
                                FontSize="12"
                                Padding="10,6"
                                Margin="0,0,6,6"
                                CornerRadius="6"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{StaticResource Primary}" />
                        <Button Text="Kurzgutachten"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding ShortAppraisalUrl}"
                                IsVisible="{Binding HasShortAppraisalUrl}"
                                FontSize="12"
                                Padding="10,6"
                                Margin="0,0,6,6"
                                CornerRadius="6"
                                BackgroundColor="Transparent"
                                BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                TextColor="{StaticResource Primary}" />
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Datentabelle: gruppierte Sektionen -->
                <VerticalStackLayout Spacing="12"
                                     Padding="16,0"
                                     BindableLayout.ItemsSource="{Binding DetailSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PropertyDetailSection">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       Margin="0,8,0,4"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyDetailItem">
                                            <Grid ColumnDefinitions="*,*"
                                                  Padding="0,6">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="13"
                                                       HorizontalOptions="End"
                                                       HorizontalTextAlignment="End"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Gericht-Footer -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                StrokeThickness="0"
                Padding="16,10"
                IsVisible="{Binding HasCourtName}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Zuständiges Gericht"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding CourtName}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Busy-Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              BackgroundColor="#40000000"
              IsVisible="{Binding IsBusy}">
            <VerticalStackLayout Spacing="8"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Text="{Binding BusyMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
