<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.ForeclosureDetailPage"
             x:DataType="vm:ForeclosureDetailViewModel"
             Title="Zwangsversteigerung">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,16">

                <!-- Fehler-/Nicht-mehr-verfuegbar-Hinweis -->
                <Border IsVisible="{Binding HasLoadError}"
                        Style="{StaticResource ErrorBanner}"
                        Margin="16,16,16,0">
                    <Label Text="{Binding LoadErrorText}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Bilder-Carousel -->
                <Grid HeightRequest="260">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                            StrokeThickness="0">
                        <Label Text="🏛"
                               FontSize="48"
                               Opacity="0.4"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <CarouselView ItemsSource="{Binding ImageUrls}"
                                  IndicatorView="ImageIndicator"
                                  IsVisible="{Binding HasImages}"
                                  Position="{Binding CurrentImagePosition}"
                                  Loop="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Image Source="{Binding .}"
                                       Aspect="AspectFill" />
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <IndicatorView x:Name="ImageIndicator"
                                   IndicatorColor="#80FFFFFF"
                                   SelectedIndicatorColor="White"
                                   VerticalOptions="End"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,10"
                                   IsVisible="{Binding HasImages}" />

                    <!-- Typ-Badge -->
                    <Border BackgroundColor="{Binding TypeBadgeColor}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,6"
                            Margin="12"
                            VerticalOptions="Start"
                            HorizontalOptions="Start">
                        <Label Text="{Binding TypeBadgeText}"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="0.8"
                               TextColor="White" />
                    </Border>

                    <!-- Teilen als kontextuelle Bildaktion -->
                    <ImageButton Source="icon_share.png"
                                 Command="{Binding SharePropertyCommand}"
                                 BackgroundColor="White"
                                 BorderColor="#22000000"
                                 BorderWidth="1"
                                 CornerRadius="22"
                                 WidthRequest="44"
                                 HeightRequest="44"
                                 Padding="11"
                                 Margin="12"
                                 VerticalOptions="Start"
                                 HorizontalOptions="End"
                                 SemanticProperties.Description="Zwangsversteigerung teilen">
                        <ImageButton.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.22"
                                    Radius="8"
                                    Offset="0,3" />
                        </ImageButton.Shadow>
                    </ImageButton>

                    <!-- Bild-Zaehler (unten links) -->
                    <Border BackgroundColor="#80000000"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,4"
                            Margin="12"
                            VerticalOptions="End"
                            HorizontalOptions="Start"
                            IsVisible="{Binding HasImages}">
                        <Label Text="{Binding ImageCounterText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                </Grid>

                <!-- Kopf: Titel, Preis, Adresse, Merken -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill">
                    <Label Text="{Binding Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           MaxLines="4"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <!-- Bei ZV oft kein Kaufpreis (0) - dann ausblenden statt "0 €" -->
                    <Label Text="{Binding FormattedPrice}"
                           FontSize="24"
                           FontAttributes="Bold"
                           IsVisible="{Binding HasPrice}"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}" />

                    <Label Text="{Binding AddressText}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <!-- Merken bleibt beim Objekt; Teilen liegt direkt auf dem Bild -->
                    <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                        <Button Command="{Binding ToggleFavoriteCommand}"
                                IsVisible="{Binding IsAuthenticated}"
                                Style="{StaticResource FilterChipStyle}">
                            <Button.Text>
                                <MultiBinding StringFormat="{}{0} {1}">
                                    <Binding Path="FavoriteButtonIcon" />
                                    <Binding Path="FavoriteButtonText" />
                                </MultiBinding>
                            </Button.Text>
                        </Button>
                    </HorizontalStackLayout>

                    <Label Text="{Binding CopyFeedback}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                           IsVisible="{Binding HasCopyFeedback}" />
                </VerticalStackLayout>

                <!-- Quellenkarte: klar getrennt von Objekt- und Dokumentaktionen -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="14"
                        Margin="16,2"
                        MaximumWidthRequest="768"
                        HorizontalOptions="Fill"
                        IsVisible="{Binding HasEdictUrl}">
                    <Grid ColumnDefinitions="44,*,Auto"
                          ColumnSpacing="12">
                        <Border Grid.Column="0"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="11"
                                BackgroundColor="White"
                                Stroke="#16000000"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                VerticalOptions="Center">
                            <Image Source="icon_external_link.png"
                                   Aspect="AspectFit" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="1"
                                             VerticalOptions="Center">
                            <Label Text="AMTLICHES DOKUMENT"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <Label Text="Edikt öffnen"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Text="Alle Angaben im Original-Edikt ansehen"
                                   FontSize="11"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                        <Button Grid.ColumnSpan="3"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                BorderWidth="0"
                                Padding="0"
                                MinimumHeightRequest="0"
                                Command="{Binding OpenEdictCommand}"
                                SemanticProperties.Description="Edikt öffnen" />
                    </Grid>
                </Border>

                <!-- Beschreibung -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     IsVisible="{Binding HasDescription}">
                    <Label Text="BESCHREIBUNG"
                           Style="{StaticResource SectionHeader}" />
                    <Label Text="{Binding Description}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>

                <!-- Dokumente -->
                <VerticalStackLayout Spacing="6"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     IsVisible="{Binding HasDocuments}">
                    <Label Text="DOKUMENTE"
                           Style="{StaticResource SectionHeader}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start">
                        <Button Text="Grundriss"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding FloorPlanUrl}"
                                IsVisible="{Binding HasFloorPlanUrl}"
                                Style="{StaticResource DocumentChipButton}" />
                        <Button Text="Lageplan"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding SitePlanUrl}"
                                IsVisible="{Binding HasSitePlanUrl}"
                                Style="{StaticResource DocumentChipButton}" />
                        <Button Text="Langgutachten"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding LongAppraisalUrl}"
                                IsVisible="{Binding HasLongAppraisalUrl}"
                                Style="{StaticResource DocumentChipButton}" />
                        <Button Text="Kurzgutachten"
                                Command="{Binding OpenDocumentCommand}"
                                CommandParameter="{Binding ShortAppraisalUrl}"
                                IsVisible="{Binding HasShortAppraisalUrl}"
                                Style="{StaticResource DocumentChipButton}" />
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- Datentabelle: gruppierte Sektionen -->
                <VerticalStackLayout Spacing="12"
                                     Padding="16,0"
                                     MaximumWidthRequest="800"
                                     HorizontalOptions="Fill"
                                     BindableLayout.ItemsSource="{Binding DetailSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PropertyDetailSection">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,8,0,4" />
                                <VerticalStackLayout Spacing="0"
                                                     BindableLayout.ItemsSource="{Binding Items}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyDetailItem">
                                            <Grid ColumnDefinitions="*,*"
                                                  Padding="0,6">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       FontSize="13"
                                                       HorizontalOptions="End"
                                                       HorizontalTextAlignment="End"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Gericht-Footer: gleiche Bottom-Sheet-Optik wie der Kontakt-Footer bei Immobilien -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16,16,0,0"
                Padding="0"
                IsVisible="{Binding HasCourtName}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}"
                        Opacity="0.3"
                        Radius="14"
                        Offset="0,-4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="2"
                                 Padding="16,12"
                                 MaximumWidthRequest="800"
                                 HorizontalOptions="Fill">
                <Label Text="ZUSTÄNDIGES GERICHT"
                       FontSize="10"
                       CharacterSpacing="1"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Label Text="{Binding CourtName}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Busy-Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Style="{StaticResource BusyOverlay}"
              IsVisible="{Binding IsBusy}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
