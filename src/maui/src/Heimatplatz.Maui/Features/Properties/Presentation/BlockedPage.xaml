<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:api="clr-namespace:Heimatplatz.Maui.ApiClient.Generated"
             xmlns:controls="clr-namespace:Heimatplatz.Maui.Features.Properties.Controls"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Presentation.BlockedPage"
             x:DataType="vm:BlockedViewModel"
             Title="Blockierte Immobilien">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Properties}"
                            RemainingItemsThreshold="4"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                            controls:ResponsiveGrid.MinItemWidth="320">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="8"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="24,60,24,0">
                        <Label Text="⊘"
                               FontSize="40"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                        <Label Text="Keine blockierten Immobilien"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Text="Immobilien, die Sie blockieren, werden hier angezeigt und aus der Hauptliste ausgeblendet."
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="api:PropertyListItemDto">
                        <Grid Padding="12,0">
                            <controls:PropertyCard Property="{Binding .}"
                                                   Mode="{x:Static models:CardMode.Blocked}"
                                                   CardClickedCommand="{Binding PropertySelectedCommand, Source={RelativeSource AncestorType={x:Type vm:BlockedViewModel}}, x:DataType=vm:BlockedViewModel}"
                                                   BlockCommand="{Binding RemoveFromCollectionCommand, Source={RelativeSource AncestorType={x:Type vm:BlockedViewModel}}, x:DataType=vm:BlockedViewModel}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                       IsVisible="{Binding IsLoadingMore}"
                                       Margin="0,8,0,16"
                                       HorizontalOptions="Center" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Busy-Overlay -->
        <Grid BackgroundColor="#40000000"
              IsVisible="{Binding IsBusy}">
            <VerticalStackLayout Spacing="8"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Text="{Binding BusyMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
