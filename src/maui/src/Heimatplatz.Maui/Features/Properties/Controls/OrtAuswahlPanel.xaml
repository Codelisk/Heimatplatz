<?xml version="1.0" encoding="utf-8" ?>
<appcontrols:ReliableFloatingPanel
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
    xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
    xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
    x:Class="Heimatplatz.Maui.Features.Properties.Controls.OrtAuswahlPanel"
    x:DataType="vm:OrtAuswahlViewModel"
    RequestedIsOpen="{Binding IsOpen, Mode=TwoWay}"
    IsContentScrollEnabled="False"
    MaximumWidthRequest="640"
    HorizontalOptions="{OnIdiom Phone=Fill, Default=Center}"
    PanelCornerRadius="14"
    PanelBackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">

    <!--
    Gemeinsames Ort-Auswahl-Panel (BindingContext: OrtAuswahlViewModel):
    Suche + Bezirk-Akkordeon (nur ein Bezirk offen, Gemeinden auf breiten
    Fenstern zweispaltig) + Übernehmen-Button mit Auswahl-/Treffer-Text.
    Verwendet von HomePage, Filtereinstellungen und Benachrichtigungen.
    -->

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="10"
          Padding="16,4,16,12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="{Binding Loc.PanelTitle}"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Button Grid.Column="1"
                    Text="{Binding Loc.ResetButton}"
                    FontSize="13"
                    Padding="8,6"
                    MinimumHeightRequest="0"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    BorderWidth="0"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                    Command="{Binding ResetCommand}"
                    AutomationId="OrtPanel_Reset" />
        </Grid>

        <Border Grid.Row="1"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 10"
                Padding="10,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="⌕"
                       FontSize="18"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Entry Grid.Column="1"
                       Placeholder="{Binding Loc.SearchPlaceholder}"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       BackgroundColor="Transparent"
                       StyleClass="borderless"
                       AutomationId="OrtPanel_Search" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="2"
                    x:Name="OrtBrowseScroll"
                    IsVisible="{Binding IsBrowseVisible}">
            <VerticalStackLayout x:Name="OrtBezirkeStack"
                                 BindableLayout.ItemsSource="{Binding OrtBezirke}"
                                 Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:OrtBezirkItem">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" HeightRequest="48">
                                <Grid Grid.Column="0" WidthRequest="40">
                                    <Border WidthRequest="22"
                                            HeightRequest="22"
                                            StrokeShape="RoundRectangle 6"
                                            StrokeThickness="1.5"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding HasSelection}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="Stroke" Value="Transparent" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding CheckGlyph}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </Border>
                                    <Button BackgroundColor="Transparent"
                                            BorderColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0"
                                            MinimumHeightRequest="0"
                                            Command="{Binding ToggleBezirkSelectionCommand, Source={RelativeSource AncestorType={x:Type vm:OrtAuswahlViewModel}}, x:DataType=vm:OrtAuswahlViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding CountLabel}"
                                           FontSize="11"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    <Label Grid.Column="2"
                                           Text="{Binding ExpandGlyph}"
                                           FontSize="13"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                    <Button Grid.ColumnSpan="3"
                                            BackgroundColor="Transparent"
                                            BorderColor="Transparent"
                                            BorderWidth="0"
                                            Padding="0"
                                            MinimumHeightRequest="0"
                                            Command="{Binding ToggleBezirkExpandedCommand, Source={RelativeSource AncestorType={x:Type vm:OrtAuswahlViewModel}}, x:DataType=vm:OrtAuswahlViewModel}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>

                            <!-- Auf breiten Fenstern zwei Spalten: halbiert die Scrollstrecke
                                 eines grossen Bezirks. Am Telefon bleibt es einspaltig,
                                 sonst brechen lange Gemeindenamen ab. -->
                            <FlexLayout IsVisible="{Binding IsExpanded}"
                                        BindableLayout.ItemsSource="{Binding VisibleGemeinden}"
                                        Direction="Row"
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        Padding="24,0,0,6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:OrtGemeindeItem">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="6"
                                              HeightRequest="44"
                                              FlexLayout.Basis="{OnIdiom Phone='100%', Default='50%'}">
                                            <Grid Grid.Column="0" WidthRequest="40">
                                                <Border WidthRequest="22"
                                                        HeightRequest="22"
                                                        StrokeShape="RoundRectangle 6"
                                                        StrokeThickness="1.5"
                                                        Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                        BackgroundColor="Transparent"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                            <Setter Property="Stroke" Value="Transparent" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="✓"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           IsVisible="{Binding IsSelected}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                                </Border>
                                            </Grid>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                            <Button Grid.ColumnSpan="2"
                                                    BackgroundColor="Transparent"
                                                    BorderColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    MinimumHeightRequest="0"
                                                    Command="{Binding ToggleOrtGemeindeCommand, Source={RelativeSource AncestorType={x:Type vm:OrtAuswahlViewModel}}, x:DataType=vm:OrtAuswahlViewModel}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView Grid.Row="2" IsVisible="{Binding IsSearchActive}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SearchResults}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:OrtGemeindeItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" HeightRequest="44">
                            <Grid Grid.Column="0" WidthRequest="40">
                                <Border WidthRequest="22"
                                        HeightRequest="22"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="1.5"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Setter Property="Stroke" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="✓"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           IsVisible="{Binding IsSelected}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                </Border>
                            </Grid>
                            <Label Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                            <Label Grid.Column="2"
                                   Text="{Binding BezirkName}"
                                   FontSize="11"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                            <Button Grid.ColumnSpan="3"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    BorderWidth="0"
                                    Padding="0"
                                    MinimumHeightRequest="0"
                                    Command="{Binding ToggleOrtGemeindeCommand, Source={RelativeSource AncestorType={x:Type vm:OrtAuswahlViewModel}}, x:DataType=vm:OrtAuswahlViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="3"
                Text="{Binding ApplyText}"
                Command="{Binding ApplyCommand}"
                AutomationId="OrtPanel_Apply"
                HeightRequest="46"
                CornerRadius="12"
                FontAttributes="Bold"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
    </Grid>
</appcontrols:ReliableFloatingPanel>
