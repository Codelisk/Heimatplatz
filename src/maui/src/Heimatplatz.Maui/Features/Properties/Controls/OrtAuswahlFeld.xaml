<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Heimatplatz.Maui.Features.Properties.Models"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Controls.OrtAuswahlFeld"
             x:DataType="vm:OrtAuswahlViewModel">

    <!--
    Zugeklappte Ort-Auswahl (BindingContext: OrtAuswahlViewModel): verdichtete
    Chip-Zeile (ein Chip je Bezirk, "+N weitere"-Deckel) plus das Feld, das das
    OrtAuswahlPanel oeffnet. Verwendet von Filtereinstellungen und Benachrichtigungen.
    -->

    <VerticalStackLayout Spacing="10">
        <FlexLayout BindableLayout.ItemsSource="{Binding Chips}"
                    Wrap="Wrap"
                    JustifyContent="Start"
                    IsVisible="{Binding HasSelection}"
                    AutomationId="OrtFeld_Chips">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:OrtChip">
                    <!-- Ueberlauf-Chip ("+N weitere") ist kein Filterwert und
                         bleibt daher unausgefuellt mit Kontur. -->
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="12,4,4,4"
                            Margin="0,0,8,8">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsOverflow}" Value="True">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="1" />
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                                <Setter Property="Padding" Value="12,4,12,4" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="2">
                            <Label Text="{Binding Label}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOverflow}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                                <Label.GestureRecognizers>
                                    <!-- Tap auf den Text springt ins Panel zum passenden Bezirk -->
                                    <TapGestureRecognizer Command="{Binding OpenChipCommand, Source={RelativeSource AncestorType={x:Type vm:OrtAuswahlViewModel}}, x:DataType=vm:OrtAuswahlViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Text="✕"
                                   FontSize="12"
                                   Padding="8,6"
                                   IsVisible="{Binding CanRemove}"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveChipCommand, Source={RelativeSource AncestorType={x:Type vm:OrtAuswahlViewModel}}, x:DataType=vm:OrtAuswahlViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </FlexLayout>

        <Border StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                Padding="0">
            <Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="12,12">
                    <Label Grid.Column="0" Text="📍" FontSize="13" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding FieldLabel}"
                           FontSize="13"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label Grid.Column="2"
                           Text="▼"
                           FontSize="10"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </Grid>
                <Button BackgroundColor="Transparent"
                        BorderColor="Transparent"
                        BorderWidth="0"
                        Padding="0"
                        MinimumHeightRequest="0"
                        Command="{Binding OpenCommand}"
                        AutomationId="OrtFeld_Button" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
