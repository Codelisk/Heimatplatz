<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Heimatplatz.Maui.Features.Properties.Controls.PropertyCard">

    <!--
    PropertyCard - Vertikales Card Design
    Bild oben, Content darunter - optimiert fuer Listen-Layout
    -->

    <Border StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
            StrokeShape="RoundRectangle 12"
            Padding="0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="200,Auto">

            <!-- Bild-Bereich -->
            <Grid Grid.Row="0">

                <!-- Placeholder -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12,12,0,0">
                    <Label Text="🏠"
                           FontSize="40"
                           Opacity="0.4"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Hauptbild (erstes Bild) -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 12,12,0,0">
                    <Image x:Name="MainImage"
                           Aspect="AspectFill"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                </Border>

                <!-- Bild-Counter unten links -->
                <Border x:Name="ImageCounterBadge"
                        BackgroundColor="#80000000"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 4"
                        Padding="8,4"
                        Margin="12"
                        VerticalOptions="End"
                        HorizontalOptions="Start"
                        IsVisible="False">
                    <Label x:Name="ImageCounterText"
                           FontSize="11"
                           TextColor="White" />
                </Border>

                <!-- Typ-Badge oben links -->
                <Border x:Name="TypeBadge"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,6"
                        Margin="12"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        IsVisible="False">
                    <Label x:Name="TypeBadgeText"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="0.8"
                           TextColor="White" />
                </Border>

                <!-- Preis unten rechts -->
                <Border x:Name="PriceOverlay"
                        BackgroundColor="#E8000000"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        Padding="14,8"
                        Margin="12"
                        VerticalOptions="End"
                        HorizontalOptions="End"
                        IsVisible="False">
                    <Label x:Name="PriceText"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                </Border>

                <!-- Action-Buttons oben rechts (je nach CardMode) -->
                <HorizontalStackLayout VerticalOptions="Start"
                                       HorizontalOptions="End"
                                       Margin="12"
                                       Spacing="8">

                    <!-- Default: Favorisieren -->
                    <Button x:Name="FavoriteButton"
                            Text="♡"
                            FontSize="18"
                            TextColor="White"
                            BackgroundColor="#70000000"
                            WidthRequest="38"
                            HeightRequest="38"
                            CornerRadius="19"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnFavoriteClicked" />

                    <!-- Default: Blockieren -->
                    <Button x:Name="BlockButton"
                            Text="⊘"
                            FontSize="18"
                            TextColor="White"
                            BackgroundColor="#70000000"
                            WidthRequest="38"
                            HeightRequest="38"
                            CornerRadius="19"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnBlockClicked" />

                    <!-- Favorite-Modus: Herz zum Entfavorisieren -->
                    <Button x:Name="FavoriteActionButton"
                            Text="♥"
                            FontSize="18"
                            TextColor="#FF6B6B"
                            BackgroundColor="#70000000"
                            WidthRequest="38"
                            HeightRequest="38"
                            CornerRadius="19"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnFavoriteClicked" />

                    <!-- Blocked-Modus: X zum Entblockieren -->
                    <Button x:Name="BlockedActionButton"
                            Text="✕"
                            FontSize="16"
                            TextColor="White"
                            BackgroundColor="#70000000"
                            WidthRequest="38"
                            HeightRequest="38"
                            CornerRadius="19"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnBlockClicked" />

                    <!-- Owner-Modus: X zum Loeschen -->
                    <Button x:Name="OwnerDeleteButton"
                            Text="✕"
                            FontSize="16"
                            TextColor="White"
                            BackgroundColor="#70000000"
                            WidthRequest="38"
                            HeightRequest="38"
                            CornerRadius="19"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnOwnerDeleteClicked" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Content: Zwei-Spalten Layout -->
            <Grid Grid.Row="1"
                  Padding="14,12"
                  ColumnDefinitions="*,Auto">

                <!-- Links: Ort, Adresse, Titel, Anbieter, Datum -->
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="2"
                                     VerticalOptions="Center">

                    <Label x:Name="OrtText"
                           FontSize="15"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                    <Label x:Name="AddressText"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                    <Label x:Name="TitleText"
                           FontSize="11"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           Margin="0,2,0,0"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />

                    <Label x:Name="SellerBadgeText"
                           FontSize="10"
                           Margin="0,2,0,0"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />

                    <Label x:Name="CreatedAtText"
                           FontSize="10"
                           Margin="0,2,0,0"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <!-- Rechts: Flaechen und Zimmer -->
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     VerticalOptions="Center"
                                     HorizontalOptions="End"
                                     Margin="12,0,0,0">

                    <!-- Grundstuecksflaeche prominent -->
                    <VerticalStackLayout x:Name="GrundstueckPanel"
                                         HorizontalOptions="End">
                        <Label x:Name="GrundstueckText"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="End"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                        <Label Text="m² Grund"
                               FontSize="10"
                               HorizontalOptions="End"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </VerticalStackLayout>

                    <!-- Tags: Wohnflaeche und Zimmer -->
                    <HorizontalStackLayout Spacing="4"
                                           HorizontalOptions="End">
                        <Border x:Name="WohnflaechePanel"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 3"
                                Padding="6,2">
                            <Label x:Name="WohnflaecheText"
                                   FontSize="10"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </Border>

                        <Border x:Name="RoomsPanel"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 3"
                                Padding="6,2">
                            <Label x:Name="RoomsText"
                                   FontSize="10"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>
