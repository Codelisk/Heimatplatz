<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Heimatplatz.Maui.Features.Properties.Controls.PropertyCard">

    <!--
    PropertyCard - Zettel auf der Anschlagtafel (Split-Design, Lesbarkeit vor Optik):
    Ruhige Papier-Karte mit feiner Kontur statt umlaufendem Schlagschatten,
    Foto mit Papierrand eingefasst
    (nur Badges/Aktionen als Glas-Pills). Info-Block zweispaltig wie am Web-Zettel:
    links Titel (Kopfzeile), "PLZ Ort" kraeftig und Strasse klein, rechts Preis
    (Serif, Rot), Flaeche und Fakten-Chips. Fusszeile mit Anbieter/Datum ist an
    den Kartenboden gepinnt (Sternzeile dazwischen) - Karten in einer Zeile sind
    gleich hoch, auch wenn z.B. die Chips fehlen.
    Struktur/Deko in beiden Themes identisch, nur Farbtokens wechseln.
    -->

    <Border StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
            StrokeShape="RoundRectangle 6"
            Padding="0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="190,*,Auto">

            <!-- Bild-Bereich: als Foto-Abzug mit Papierrand in den Zettel eingefasst -->
            <Border Grid.Row="0"
                    Margin="12,12,12,0"
                    StrokeShape="RoundRectangle 2"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource ZettelFrame}, Dark={StaticResource ZettelFrameDark}}"
                    Padding="0">
            <Grid>

                <!-- Placeholder: Marke als Wasserzeichen; wird nach erfolgreichem
                     Foto-Load ausgeblendet (sonst Overdraw unter jedem Bild) -->
                <Border x:Name="PlaceholderPanel"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                        StrokeThickness="0">
                    <Image Source="logo.png"
                           WidthRequest="88"
                           Opacity="0.18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Hauptbild (erstes Bild) -->
                <Image x:Name="MainImage"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill" />

                <!-- Typ-Badge oben links, eckig wie am Web-Zettel
                     (ZV = Rot, Grund = Gruen, Haus = Blau; Farben im Code-Behind) -->
                <Border x:Name="TypeBadge"
                        BackgroundColor="{StaticResource SignalRed}"
                        Stroke="{StaticResource GlassPillStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 2"
                        Padding="12,5"
                        Margin="12"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        IsVisible="False">
                    <Label x:Name="TypeBadgeText"
                           FontFamily="SansBold"
                           FontSize="10"
                           CharacterSpacing="1.4"
                           TextColor="White" />
                </Border>

                <!-- Action-Buttons oben rechts: zwei wiederverwendete Buttons statt fuenf -
                     native Buttons sind teuer und unsichtbare werden trotzdem inflatet.
                     Icon/Command wechseln je CardMode im Code-Behind:
                     FavoriteButton = Favorisieren (Default) bzw. Entfavorisieren (Favorite),
                     BlockButton = Blockieren (Default), Entblockieren (Blocked), Loeschen (Owner).
                     Icon als zentriertes Overlay wie auf den Detailseiten: ImageButton
                     platziert sein Bild auf WinUI nicht mittig -->
                <HorizontalStackLayout VerticalOptions="Start"
                                       HorizontalOptions="End"
                                       Margin="12"
                                       Spacing="8">

                    <Grid x:Name="FavoritePanel" IsVisible="False">
                        <Button x:Name="FavoriteButton"
                                Padding="0"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="20"
                                BorderWidth="1"
                                BackgroundColor="{StaticResource GlassPillBackground}"
                                BorderColor="{StaticResource GlassPillStroke}"
                                Clicked="OnFavoriteClicked" />
                        <Image x:Name="FavoriteIcon"
                               Source="icon_heart_white.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>

                    <Grid x:Name="BlockPanel" IsVisible="False">
                        <Button x:Name="BlockButton"
                                Padding="0"
                                MinimumHeightRequest="0"
                                MinimumWidthRequest="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="20"
                                BorderWidth="1"
                                BackgroundColor="{StaticResource GlassPillBackground}"
                                BorderColor="{StaticResource GlassPillStroke}"
                                Clicked="OnBlockClicked" />
                        <Image x:Name="BlockIcon"
                               Source="icon_block_white.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>
                </HorizontalStackLayout>

                <!-- Bild-Counter unten rechts -->
                <Border x:Name="ImageCounterBadge"
                        Style="{StaticResource GlassPill}"
                        Padding="8,3"
                        Margin="12"
                        VerticalOptions="End"
                        HorizontalOptions="End"
                        IsVisible="False">
                    <Label x:Name="ImageCounterText"
                           FontSize="10.5"
                           FontFamily="SansMedium"
                           TextColor="White" />
                </Border>
            </Grid>
            </Border>

            <!-- Info-Block zweispaltig: links Kopf (Titel/Ort/Strasse), rechts Preisspalte -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Start"
                  Padding="14,10,14,14">

                <!-- Gestaffelte Adresse: Titel als Kopfzeile, "PLZ Ort" kraeftig,
                     Strasse klein und grau - zwei gleich graue Zeilen wirkten plump -->
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label x:Name="TitleText"
                           FontFamily="SansBold"
                           FontSize="15"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label x:Name="LocationText"
                           FontFamily="SansMedium"
                           FontSize="13"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label x:Name="StreetText"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </VerticalStackLayout>

                <!-- Preisspalte rechtsbuendig: Preis (Serif, Rot; Dark = aufgehelltes
                     Preis-Rot, Web-Token price), darunter Flaeche und Fakten-Chips -->
                <VerticalStackLayout Grid.Column="1">
                    <Label x:Name="PriceText"
                           FontFamily="Display"
                           FontSize="20"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PriceDark}}" />
                    <Label x:Name="AreaText"
                           FontFamily="SansSemibold"
                           FontSize="12.5"
                           Margin="0,3,0,0"
                           HorizontalTextAlignment="End"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <HorizontalStackLayout x:Name="ChipsRow"
                                           Spacing="5"
                                           Margin="0,6,0,0"
                                           HorizontalOptions="End">
                        <Border x:Name="WohnflaechePanel"
                                Style="{StaticResource PillTag}"
                                IsVisible="False">
                            <Label x:Name="WohnflaecheText"
                                   Style="{StaticResource PillTagText}" />
                        </Border>

                        <Border x:Name="RoomsPanel"
                                Style="{StaticResource PillTag}"
                                IsVisible="False">
                            <Label x:Name="RoomsText"
                                   Style="{StaticResource PillTagText}" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!-- Fusszeile am Kartenboden: Die Kartenflaeche laeuft bis unten
                 durch; nur die Haarlinie trennt Metadaten vom Inhalt. Dadurch
                 entstehen zwischen aufeinanderfolgenden Karten keine harten
                 Farbbalken. Anbieter links (truncat), Datum rechts. -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
                <BoxView Grid.Row="0"
                         HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}" />
                <Grid Grid.Row="1"
                      BackgroundColor="Transparent"
                      ColumnDefinitions="*,Auto"
                      Padding="14,8">
                    <HorizontalStackLayout Grid.Column="0"
                                           Spacing="6"
                                           VerticalOptions="Center">
                        <Image Source="icon_user.png"
                               WidthRequest="14"
                               HeightRequest="14"
                               Margin="0,1,0,0"
                               VerticalOptions="Center" />
                        <Label x:Name="SellerLineText"
                               FontSize="11"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               VerticalOptions="Center"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="6"
                                           Margin="12,0,0,0"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center">
                        <Image Source="icon_calendar.png"
                               WidthRequest="14"
                               HeightRequest="14"
                               Margin="0,1,0,0"
                               VerticalOptions="Center" />
                        <Label x:Name="CreatedAtText"
                               FontSize="11"
                               VerticalOptions="Center"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>
