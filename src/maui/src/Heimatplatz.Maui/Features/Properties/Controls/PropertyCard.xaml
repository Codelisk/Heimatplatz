<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Heimatplatz.Maui.Features.Properties.Controls.PropertyCard">

    <!--
    PropertyCard - Split-Design (Lesbarkeit vor Optik):
    Foto oben unverdeckt (nur Badges/Aktionen als Glas-Pills), darunter ein
    strukturierter Info-Block auf fester Kartenflaeche - Preis (Serif, Markenrot),
    Ort/Adresse, Titel, Fakten-Pills und Meta-Zeile.
    -->

    <Border StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
            StrokeShape="RoundRectangle 20"
            Padding="0">
        <Border.Shadow>
            <Shadow />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnCardTapped" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="190,Auto">

            <!-- Bild-Bereich: unverdeckt bis auf Badges -->
            <Grid Grid.Row="0">

                <!-- Placeholder: Marke als Wasserzeichen -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceAlt}, Dark={StaticResource SurfaceAltDark}}"
                        StrokeThickness="0">
                    <Image Source="logo.png"
                           WidthRequest="88"
                           Opacity="0.18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Hauptbild (erstes Bild) -->
                <Image x:Name="MainImage"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill" />

                <!-- Typ-Badge oben links (ZV = Signal-Rot, sonst warmes Glas; Farbe im Code-Behind) -->
                <Border x:Name="TypeBadge"
                        BackgroundColor="{StaticResource SignalRed}"
                        Stroke="{StaticResource GlassPillStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12,5"
                        Margin="12"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        IsVisible="False">
                    <Label x:Name="TypeBadgeText"
                           FontFamily="SansBold"
                           FontSize="10"
                           CharacterSpacing="1.4"
                           TextColor="White" />
                </Border>

                <!-- Action-Buttons oben rechts (je nach CardMode) -->
                <HorizontalStackLayout VerticalOptions="Start"
                                       HorizontalOptions="End"
                                       Margin="12"
                                       Spacing="8">

                    <!-- Default: Favorisieren -->
                    <Button x:Name="FavoriteButton"
                            Text="♡"
                            FontSize="18"
                            TextColor="White"
                            BackgroundColor="{StaticResource GlassPillBackground}"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnFavoriteClicked" />

                    <!-- Default: Blockieren -->
                    <Button x:Name="BlockButton"
                            Text="⊘"
                            FontSize="18"
                            TextColor="White"
                            BackgroundColor="{StaticResource GlassPillBackground}"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnBlockClicked" />

                    <!-- Favorite-Modus: Herz zum Entfavorisieren -->
                    <Button x:Name="FavoriteActionButton"
                            Text="♥"
                            FontSize="18"
                            TextColor="{StaticResource SignalRed}"
                            BackgroundColor="{StaticResource GlassPillBackground}"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnFavoriteClicked" />

                    <!-- Blocked-Modus: X zum Entblockieren -->
                    <Button x:Name="BlockedActionButton"
                            Text="✕"
                            FontSize="16"
                            TextColor="White"
                            BackgroundColor="{StaticResource GlassPillBackground}"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnBlockClicked" />

                    <!-- Owner-Modus: X zum Loeschen -->
                    <Button x:Name="OwnerDeleteButton"
                            Text="✕"
                            FontSize="16"
                            TextColor="White"
                            BackgroundColor="{StaticResource GlassPillBackground}"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            Padding="0"
                            IsVisible="False"
                            Clicked="OnOwnerDeleteClicked" />
                </HorizontalStackLayout>

                <!-- Bild-Counter unten rechts -->
                <Border x:Name="ImageCounterBadge"
                        Style="{StaticResource GlassPill}"
                        Padding="8,3"
                        Margin="12"
                        VerticalOptions="End"
                        HorizontalOptions="End"
                        IsVisible="False">
                    <Label x:Name="ImageCounterText"
                           FontSize="10.5"
                           FontFamily="SansMedium"
                           TextColor="White" />
                </Border>
            </Grid>

            <!-- Info-Block: alle Texte auf fester Flaeche -->
            <VerticalStackLayout Grid.Row="1"
                                 Padding="14,10,14,12"
                                 Spacing="3">

                <!-- Preis im Serif-Schnitt, Markenrot -->
                <HorizontalStackLayout x:Name="PriceOverlay" IsVisible="False">
                    <Label x:Name="PriceText"
                           FontFamily="Display"
                           FontSize="23"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </HorizontalStackLayout>

                <!-- Ort · Adresse in einer Zeile -->
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                    <Label x:Name="OrtText"
                           Grid.Column="0"
                           FontFamily="SansBold"
                           FontSize="15"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Label x:Name="OrtAddressSeparator"
                           Grid.Column="1"
                           Text="·"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    <Label x:Name="AddressText"
                           Grid.Column="2"
                           FontSize="13"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                </Grid>

                <Label x:Name="TitleText"
                       FontSize="12"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />

                <!-- Fakten-Pills -->
                <HorizontalStackLayout Spacing="6" Margin="0,6,0,0">
                    <Border x:Name="GrundstueckPanel"
                            Style="{StaticResource PillTag}"
                            IsVisible="False">
                        <Label x:Name="GrundstueckText"
                               Style="{StaticResource PillTagText}" />
                    </Border>

                    <Border x:Name="WohnflaechePanel"
                            Style="{StaticResource PillTag}"
                            IsVisible="False">
                        <Label x:Name="WohnflaecheText"
                               Style="{StaticResource PillTagText}" />
                    </Border>

                    <Border x:Name="RoomsPanel"
                            Style="{StaticResource PillTag}"
                            IsVisible="False">
                        <Label x:Name="RoomsText"
                               Style="{StaticResource PillTagText}" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Anbieter und Datum dezent -->
                <HorizontalStackLayout Spacing="5" Margin="0,5,0,0">
                    <Label x:Name="SellerBadgeText"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                    <Label x:Name="SellerDateSeparator"
                           Text="·"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                    <Label x:Name="CreatedAtText"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
