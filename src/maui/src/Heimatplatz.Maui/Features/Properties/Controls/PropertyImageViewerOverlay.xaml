<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shiny="http://shiny.net/maui/controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Properties.Presentation"
             x:Class="Heimatplatz.Maui.Features.Properties.Controls.PropertyImageViewerOverlay"
             x:DataType="vm:IImageViewerHost"
             IsVisible="{Binding IsImageViewerOpen}">

    <!-- Vollbild-Bildviewer (Lightbox wie im Web): Pinch/Zoom, Doppeltipp, eingebauter
         Schliessen-Button. Wird von den Detailseiten erst beim ersten Oeffnen erzeugt -
         geschlossen kostet er dadurch weder Aufbau noch Layout. -->
    <Grid>
        <!-- IsVisible zwingend: geschlossen rendert der Viewer sein Source-Bild
             sonst inline ueber der Seite -->
        <shiny:ImageViewer Source="{Binding CurrentFullImageUrl}"
                           IsOpen="{Binding IsImageViewerOpen, Mode=TwoWay}"
                           IsVisible="{Binding IsImageViewerOpen}"
                           OpenViewerOnTap="False" />

        <!-- Blaettern im Vollbild: kleine content-grosse Container statt vollflaechiger
             Overlays, damit echte Klicks den Schliessen-Button und die Gesten des
             Viewers erreichen. IsVisible NUR am Grid (WinUI malt Kinder mit eigenem
             IsVisible-Binding hier nicht); hoher ZIndex, weil der ImageViewer sein
             Overlay sonst darueber legt -->
        <Grid IsVisible="{Binding ShowViewerNavigation}"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              Margin="14,0,0,0"
              ZIndex="9999">
            <Button x:Name="PreviousButton"
                    Command="{Binding ShowPreviousImageCommand}"
                    Padding="0"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BorderWidth="1"
                    BackgroundColor="{StaticResource GlassPillBackground}"
                    BorderColor="{StaticResource GlassPillStroke}" />
            <Path Data="M10,1 L4,7 L10,13"
                  Stroke="White"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  WidthRequest="14"
                  HeightRequest="14"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  InputTransparent="True" />
        </Grid>

        <Grid IsVisible="{Binding ShowViewerNavigation}"
              HorizontalOptions="End"
              VerticalOptions="Center"
              Margin="0,0,14,0"
              ZIndex="9999">
            <Button x:Name="NextButton"
                    Command="{Binding ShowNextImageCommand}"
                    Padding="0"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BorderWidth="1"
                    BackgroundColor="{StaticResource GlassPillBackground}"
                    BorderColor="{StaticResource GlassPillStroke}" />
            <Path Data="M4,1 L10,7 L4,13"
                  Stroke="White"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  WidthRequest="14"
                  HeightRequest="14"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  InputTransparent="True" />
        </Grid>

        <!-- Deutliches Schliessen-X: liegt exakt ueber dem kaum sichtbaren
             eingebauten X des Viewers (Position 16/50 von rechts oben) -->
        <Grid IsVisible="{Binding IsImageViewerOpen}"
              HorizontalOptions="End"
              VerticalOptions="Start"
              Margin="0,50,16,0"
              ZIndex="9999">
            <Button x:Name="CloseButton"
                    Command="{Binding CloseImageViewerCommand}"
                    Padding="0"
                    MinimumHeightRequest="0"
                    MinimumWidthRequest="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    CornerRadius="22"
                    BorderWidth="1"
                    BackgroundColor="{StaticResource GlassPillBackground}"
                    BorderColor="{StaticResource GlassPillStroke}"
                    SemanticProperties.Description="{Binding CloseViewerSemantic}" />
            <!-- X als Geometrie statt Font-Glyph: Buttons zentrieren Text ueber
                 Baseline-Metriken, das Glyph sitzt dadurch nie exakt mittig -->
            <Path Data="M1,1 L13,13 M13,1 L1,13"
                  Stroke="White"
                  StrokeThickness="1.8"
                  StrokeLineCap="Round"
                  WidthRequest="14"
                  HeightRequest="14"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  InputTransparent="True" />
        </Grid>

        <!-- Zaehler im Vollbild (eigenes Grid: eigenes Sichtbarkeits-Kriterium) -->
        <Grid IsVisible="{Binding IsImageViewerOpen}"
              HorizontalOptions="Center"
              VerticalOptions="End"
              Margin="0,0,0,24"
              InputTransparent="True"
              ZIndex="9999">
            <Border Style="{StaticResource GlassPill}"
                    Padding="10,4">
                <Label Text="{Binding ImageCounterText}"
                       FontSize="12"
                       FontFamily="SansMedium"
                       TextColor="White" />
            </Border>
        </Grid>
    </Grid>
</ContentView>
