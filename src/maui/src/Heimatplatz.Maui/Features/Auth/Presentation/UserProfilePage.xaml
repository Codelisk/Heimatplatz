<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.UserProfilePage"
             x:DataType="vm:UserProfileViewModel"
             Title="Mein Profil">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero Header mit Avatar -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Black}}"
                    StrokeThickness="0"
                    Padding="24,48,24,32">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="16">

                    <!-- Avatar Circle -->
                    <Border WidthRequest="96"
                            HeightRequest="96"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 48"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Center">
                        <Label Text="{Binding UserInitials}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <!-- Name -->
                    <Label Text="{Binding UserFullName}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <!-- Rollen-Badge -->
                    <Border BackgroundColor="{StaticResource White}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="16,8"
                            HorizontalOptions="Center">
                        <Label Text="{Binding RoleBadgeText}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}"
                               HorizontalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Info-Karten -->
            <VerticalStackLayout Padding="16,24"
                                 Spacing="16"
                                 MaximumWidthRequest="600"
                                 HorizontalOptions="Fill">

                <!-- E-Mail Karte -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="E-Mail"
                               Style="{StaticResource Caption}" />
                        <Label Text="{Binding UserEmail}"
                               Style="{StaticResource BodyStrong}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Käufer: gilt fuer jedes Konto -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Suchen &amp; Favorisieren"
                               Style="{StaticResource Caption}" />
                        <Label Text="Käufer"
                               Style="{StaticResource BodyStrong}" />
                        <Label Text="Immobilien suchen, favorisieren und Suchprofile speichern - in jedem Konto enthalten"
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Verkäufer mit Anbietertyp (nur wenn SellerType gesetzt) -->
                <Border Style="{StaticResource Card}"
                        IsVisible="{Binding IsSeller}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Inserieren"
                               Style="{StaticResource Caption}" />
                        <Label Text="{Binding SellerTypeLabel}"
                               Style="{StaticResource BodyStrong}" />
                        <Label Text="Immobilien anbieten und verwalten"
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Profil & Verkaeufer-Einstellungen (nachtraeglich aenderbar) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Profil &amp; Verkäufer-Einstellungen"
                               Style="{StaticResource BodyStrong}" />
                        <Label Text="Sie können jederzeit Verkäufer werden, den Anbietertyp wechseln oder das Anbieten deaktivieren. Bestehende Inserate behalten ihre bisherigen Angaben."
                               Style="{StaticResource Caption}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Vorname" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding EditFirstName}" Placeholder="Max" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Nachname" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding EditLastName}" Placeholder="Mustermann" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="Ich möchte Immobilien anbieten"
                                   Style="{StaticResource BodyStrong}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding EditWantsToSell, Mode=TwoWay}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding EditWantsToSell}">
                            <RadioButton Content="Privatperson"
                                         IsChecked="{Binding EditIsPrivate, Mode=TwoWay}"
                                         GroupName="ProfileSellerType" />
                            <RadioButton Content="Makler / Agentur"
                                         IsChecked="{Binding EditIsBroker, Mode=TwoWay}"
                                         GroupName="ProfileSellerType" />
                            <RadioButton Content="Hausverwaltung"
                                         IsChecked="{Binding EditIsPropertyManager, Mode=TwoWay}"
                                         GroupName="ProfileSellerType" />

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding EditNeedsCompanyName}">
                                <Label Text="Firmenname" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding EditCompanyName}" Placeholder="z.B. RE/MAX Premium" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ProfileStatusMessage}"
                               IsVisible="{Binding HasProfileStatus}"
                               Style="{StaticResource Caption}" />

                        <Button Text="Profil speichern"
                                Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding IsNotDeletingAccount}"
                                Style="{StaticResource PrimaryButton}" />
                        <ActivityIndicator IsRunning="{Binding IsSavingProfile}"
                                           IsVisible="{Binding IsSavingProfile}"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Passwort aendern (widerruft alle anderen Sitzungen) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Passwort ändern"
                               Style="{StaticResource BodyStrong}" />
                        <Label Text="Nach der Änderung werden alle anderen angemeldeten Geräte abgemeldet."
                               Style="{StaticResource Caption}" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Aktuelles Passwort" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding CurrentPassword}" IsPassword="True" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Neues Passwort" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Mindestens 8 Zeichen" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Neues Passwort bestätigen" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding NewPasswordConfirm}" IsPassword="True" />
                        </VerticalStackLayout>

                        <Label Text="{Binding PasswordStatusMessage}"
                               IsVisible="{Binding HasPasswordStatus}"
                               Style="{StaticResource Caption}" />

                        <Button Text="Passwort ändern"
                                Command="{Binding ChangePasswordCommand}"
                                IsEnabled="{Binding IsNotDeletingAccount}"
                                Style="{StaticResource SecondaryButton}" />
                        <ActivityIndicator IsRunning="{Binding IsChangingPassword}"
                                           IsVisible="{Binding IsChangingPassword}"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Abmelden (waehrend der Konto-Loeschung gesperrt) -->
                <Button Text="Abmelden"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding IsNotDeletingAccount}"
                        Style="{StaticResource SecondaryButton}"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="52"
                        Margin="0,8,0,0" />

                <!-- Gefahrenzone: Konto löschen -->
                <Border Style="{StaticResource Card}"
                        Margin="0,8,0,40">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Konto löschen"
                               Style="{StaticResource CardTitle}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        <Label Text="Wenn Sie Ihr Konto löschen, werden Ihr Profil, Ihre Inserate, Favoriten, Blockierungen und Benachrichtigungs-Einstellungen unwiderruflich entfernt. Diese Aktion kann nicht rückgängig gemacht werden."
                               Style="{StaticResource Caption}" />

                        <HorizontalStackLayout Spacing="12">
                            <Button Text="Konto löschen"
                                    Command="{Binding DeleteAccountCommand}"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalOptions="Start" />

                            <ActivityIndicator IsRunning="{Binding IsDeletingAccount}"
                                               IsVisible="{Binding IsDeletingAccount}"
                                               WidthRequest="24"
                                               HeightRequest="24"
                                               VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
