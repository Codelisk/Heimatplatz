<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.UserProfilePage"
             x:DataType="vm:UserProfileViewModel"
             Title="{Binding Loc.PageTitle}">

    <!-- Design-Umschalter in der Titelbar (wie der Theme-Toggle im Web-Header):
         Titel links, Pille rechts. Fuellendes Grid als Wurzel + Inhalt vertikal
         zentriert, sonst sitzt der TitleView-Inhalt auf Android zu tief
         (dotnet/maui#3559). Die dunkle Glass-Pille mit weissem Icon bleibt in
         beiden Themes lesbar: auf hellem Manila als dezenter dunkler Kreis, auf
         dunklem Grund direkt das weisse Icon. -->
    <Shell.TitleView>
        <Grid HorizontalOptions="Fill"
              VerticalOptions="Fill"
              ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="{Binding Loc.PageTitle}"
                   FontFamily="SansSemibold"
                   FontSize="19"
                   VerticalOptions="Center"
                   VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Border Grid.Column="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    WidthRequest="36"
                    HeightRequest="36"
                    BackgroundColor="{StaticResource GlassPillBackground}"
                    Stroke="{StaticResource GlassPillStroke}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    SemanticProperties.Description="{Binding ThemeModeLabel}"
                    ToolTipProperties.Text="{Binding ThemeModeLabel}"
                    AutomationId="Profile_ThemeToggle">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleThemeCommand}" />
                </Border.GestureRecognizers>
                <Image Source="{Binding ThemeIcon}"
                       WidthRequest="18"
                       HeightRequest="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout x:Name="ProfilePageLayout"
                             Spacing="0">

            <!-- Hero: Markenverlauf wie Web-Profil - Light wird zur Sonne hin heller
                 (tiefes Rot -> sonniges Koralle), Dark im Rot-Schwarz-Verlauf -->
            <Border StrokeThickness="0"
                    Padding="24,40,24,28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="{AppThemeBinding Light=#C9161C, Dark=#BB0916}" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light=#EE6A50, Dark=#1A0508}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="14">

                    <!-- Avatar: heller Kreis mit roten Initialen und rotem Rand (wie Web) -->
                    <Border WidthRequest="96"
                            HeightRequest="96"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 48"
                            BackgroundColor="{StaticResource White}"
                            HorizontalOptions="Center">
                        <Label Text="{Binding UserInitials}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding UserFullName}"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                        <Label Text="{Binding UserEmail}"
                               FontSize="13"
                               TextColor="#B3FFFFFF"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <!-- Rollen- und Verifikations-Badges -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Border BackgroundColor="{StaticResource White}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,6">
                            <Label Text="{Binding RoleBadgeText}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" />
                        </Border>
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource SuccessBannerBackground}, Dark={StaticResource SuccessBannerBackgroundDark}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="14,6"
                                IsVisible="{Binding ShowVerifiedBadge}">
                            <Label Text="{Binding Loc.VerifiedBadge}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource SuccessBannerForeground}, Dark={StaticResource SuccessBannerForegroundDark}}" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid x:Name="ProfileContent"
                  Padding="16,20,16,0"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="14"
                  ColumnDefinitions="*"
                  MaximumWidthRequest="600"
                  HorizontalOptions="Fill"
                  appcontrols:ResponsiveLayout.IsEnabled="True"
                  appcontrols:ResponsiveLayout.UseWindowWidth="True">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="WindowWidthStates">
                            <VisualState x:Name="Compact" />
                            <VisualState x:Name="Medium">
                                <VisualState.Setters>
                                    <Setter TargetName="ProfileContent" Property="MaximumWidthRequest" Value="1100" />
                                    <Setter TargetName="ProfileContent" Property="Padding" Value="24,24,24,36" />
                                    <Setter TargetName="ProfileContent" Property="RowDefinitions" Value="Auto" />
                                    <Setter TargetName="ProfileContent" Property="ColumnDefinitions" Value="2*,3*" />
                                    <Setter TargetName="ProfileContent" Property="ColumnSpacing" Value="20" />
                                    <Setter TargetName="ProfileOverviewColumn" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="ProfileOverviewColumn" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="ProfileAccountColumn" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="ProfileAccountColumn" Property="Grid.Column" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Expanded">
                                <VisualState.Setters>
                                    <Setter TargetName="ProfileContent" Property="MaximumWidthRequest" Value="1200" />
                                    <Setter TargetName="ProfileContent" Property="Padding" Value="32,28,32,40" />
                                    <Setter TargetName="ProfileContent" Property="RowDefinitions" Value="Auto" />
                                    <Setter TargetName="ProfileContent" Property="ColumnDefinitions" Value="2*,3*" />
                                    <Setter TargetName="ProfileContent" Property="ColumnSpacing" Value="24" />
                                    <Setter TargetName="ProfileOverviewColumn" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="ProfileOverviewColumn" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="ProfileAccountColumn" Property="Grid.Row" Value="0" />
                                    <Setter TargetName="ProfileAccountColumn" Property="Grid.Column" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <VerticalStackLayout x:Name="ProfileOverviewColumn"
                                     Grid.Row="0"
                                     Spacing="14">

                <!-- Hinweis-Banner: nur solange die E-Mail-Adresse unbestaetigt ist -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource WarningBannerBackground}, Dark={StaticResource WarningBannerBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource WarningBannerForeground}, Dark={StaticResource WarningBannerForegroundDark}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Padding="16"
                        IsVisible="{Binding IsEmailNotVerified}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Loc.VerifyEmailTitle}"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource WarningBannerForeground}, Dark={StaticResource WarningBannerForegroundDark}}" />
                        <Label Text="{Binding Loc.VerifyEmailText}"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource WarningBannerForeground}, Dark={StaticResource WarningBannerForegroundDark}}" />
                        <Button Text="{Binding Loc.ResendVerificationButton}"
                                Command="{Binding ResendVerificationEmailCommand}"
                                IsEnabled="{Binding IsNotDeletingAccount}"
                                Style="{StaticResource SecondaryButton}" />
                        <ActivityIndicator IsRunning="{Binding IsResendingVerification}"
                                           IsVisible="{Binding IsResendingVerification}"
                                           HorizontalOptions="Center" />
                        <Label Text="{Binding VerificationStatusMessage}"
                               IsVisible="{Binding HasVerificationStatus}"
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Konto-Ueberblick: Zaehler-Kacheln mit Direkteinstieg.
                     Verkaeufer sehen 3 Kacheln, Kaeufer 2 (eigene Grids, damit
                     keine leere Spalte bleibt). -->
                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10"
                      IsVisible="{Binding IsSeller}">
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,9">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToFavoritesCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding FavoritesCountText}" Style="{StaticResource PriceLabel}" FontSize="19" />
                            <Label Text="{Binding Loc.FavoritesTile}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,9">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToBlockedCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding BlockedCountText}" Style="{StaticResource PriceLabel}" FontSize="19" />
                            <Label Text="{Binding Loc.BlockedTile}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,9">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToMyPropertiesCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding MyPropertiesCountText}" Style="{StaticResource PriceLabel}" FontSize="19" />
                            <Label Text="{Binding Loc.MyPropertiesTile}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10"
                      IsVisible="{Binding IsBuyerOnly}">
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,9">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToFavoritesCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding FavoritesCountText}" Style="{StaticResource PriceLabel}" FontSize="19" />
                            <Label Text="{Binding Loc.FavoritesTile}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,9">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToBlockedCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding BlockedCountText}" Style="{StaticResource PriceLabel}" FontSize="19" />
                            <Label Text="{Binding Loc.BlockedTile}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Schnellzugriff: Ziele ohne eigene Kachel (wie Web-Profil) -->
                <Border Style="{StaticResource Card}" Padding="6">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="12,12"
                              IsVisible="{Binding IsSeller}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToAddPropertyCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Loc.AddPropertyTitle}" Style="{StaticResource BodyStrong}" />
                                <Label Text="{Binding Loc.AddPropertySubtitle}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="20" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" IsVisible="{Binding IsSeller}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="12,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToNotificationSettingsCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Loc.NotificationsTitle}" Style="{StaticResource BodyStrong}" />
                                <Label Text="{Binding Loc.NotificationsSubtitle}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="20" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="12,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToFilterSettingsCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Loc.FilterSettingsTitle}" Style="{StaticResource BodyStrong}" />
                                <Label Text="{Binding Loc.FilterSettingsSubtitle}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="20" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ProfileAccountColumn"
                                     Grid.Row="1"
                                     Spacing="14">
                <!-- Profil & Verkaeufer-Einstellungen (nachtraeglich aenderbar) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Loc.ProfileSectionTitle}"
                                   Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding Loc.ProfileSectionSubtitle}"
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="{Binding Loc.FirstNameLabel}" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding EditFirstName}" Placeholder="{Binding Loc.FirstNamePlaceholder}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{Binding Loc.LastNameLabel}" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding EditLastName}" Placeholder="{Binding Loc.LastNamePlaceholder}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Loc.PhoneLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding EditPhone}"
                                   Keyboard="Telephone"
                                   Placeholder="{Binding Loc.PhonePlaceholder}"
                                   AutomationId="Profile_PhoneEntry" />
                            <Label Text="{Binding Loc.PhoneHint}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Loc.WantsToSellLabel}"
                                       Style="{StaticResource BodyStrong}" />
                                <Label Text="{Binding Loc.WantsToSellHint}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding EditWantsToSell, Mode=TwoWay}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding EditWantsToSell}">
                            <Label Text="{Binding Loc.SellerTypeLabel}" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="{Binding Loc.SellerTypePrivate}"
                                         IsChecked="{Binding EditIsPrivate, Mode=TwoWay}"
                                         GroupName="ProfileSellerType" />
                            <RadioButton Content="{Binding Loc.SellerTypeBroker}"
                                         IsChecked="{Binding EditIsBroker, Mode=TwoWay}"
                                         GroupName="ProfileSellerType" />
                            <RadioButton Content="{Binding Loc.SellerTypePropertyManager}"
                                         IsChecked="{Binding EditIsPropertyManager, Mode=TwoWay}"
                                         GroupName="ProfileSellerType" />

                            <VerticalStackLayout Spacing="6" IsVisible="{Binding EditNeedsCompanyName}">
                                <Label Text="{Binding Loc.CompanyNameLabel}" Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding EditCompanyName}" Placeholder="{Binding Loc.CompanyNamePlaceholder}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Label Text="{Binding ProfileStatusMessage}"
                               IsVisible="{Binding HasProfileStatus}"
                               Style="{StaticResource Caption}" />

                        <Button Text="{Binding Loc.SaveProfileButton}"
                                Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding IsNotDeletingAccount}"
                                Style="{StaticResource PrimaryButton}" />
                        <ActivityIndicator IsRunning="{Binding IsSavingProfile}"
                                           IsVisible="{Binding IsSavingProfile}"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Sicherheit: Passwort aendern (widerruft alle anderen Sitzungen) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Loc.SecuritySectionTitle}"
                                   Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding Loc.SecuritySectionSubtitle}"
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding Loc.CurrentPasswordLabel}" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="{Binding Loc.ForgotPasswordLink}"
                                    Command="{Binding GoToForgotPasswordCommand}"
                                    Style="{StaticResource LinkButton}"
                                    FontSize="12" />
                        </Grid>
                        <Entry Text="{Binding CurrentPassword}" IsPassword="True" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Loc.NewPasswordLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="{Binding Loc.NewPasswordPlaceholder}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Loc.NewPasswordConfirmLabel}" Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding NewPasswordConfirm}" IsPassword="True" />
                        </VerticalStackLayout>

                        <Label Text="{Binding PasswordStatusMessage}"
                               IsVisible="{Binding HasPasswordStatus}"
                               Style="{StaticResource Caption}" />

                        <Button Text="{Binding Loc.ChangePasswordButton}"
                                Command="{Binding ChangePasswordCommand}"
                                IsEnabled="{Binding IsNotDeletingAccount}"
                                Style="{StaticResource SecondaryButton}" />
                        <ActivityIndicator IsRunning="{Binding IsChangingPassword}"
                                           IsVisible="{Binding IsChangingPassword}"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Abmelden (waehrend der Konto-Loeschung gesperrt) -->
                <Button Text="{Binding Loc.LogoutButton}"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding IsNotDeletingAccount}"
                        Style="{StaticResource SecondaryButton}"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="52"
                        Margin="0,4,0,0" />

                <!-- Gefahrenzone: Konto löschen -->
                <Border Style="{StaticResource Card}"
                        Stroke="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                        Margin="0,4,0,40">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Loc.DeleteAccountTitle}"
                               Style="{StaticResource CardTitle}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                        <Label Text="{Binding Loc.DeleteAccountWarning}"
                               Style="{StaticResource Caption}" />

                        <HorizontalStackLayout Spacing="12">
                            <Button Text="{Binding Loc.DeleteAccountButton}"
                                    Command="{Binding DeleteAccountCommand}"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalOptions="Start" />

                            <ActivityIndicator IsRunning="{Binding IsDeletingAccount}"
                                               IsVisible="{Binding IsDeletingAccount}"
                                               WidthRequest="24"
                                               HeightRequest="24"
                                               VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                </VerticalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
