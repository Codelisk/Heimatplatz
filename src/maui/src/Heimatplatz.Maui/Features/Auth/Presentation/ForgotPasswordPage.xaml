<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.FlyoutBehavior="Disabled"
             Title="Passwort vergessen">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="24,32"
                                 Spacing="28"
                                 MaximumWidthRequest="440"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center">

                <!-- Brand Header -->
                <Label Text="HEIMATPLATZ"
                       Style="{StaticResource BrandWordmark}" />

                <!-- Title Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Passwort vergessen?"
                           Style="{StaticResource PageTitle}" />
                    <Label Text="Geben Sie Ihre E-Mail-Adresse ein. Wenn ein Konto existiert, senden wir Ihnen einen Link zum Zurücksetzen."
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Error Message -->
                <Border IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorBanner}">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Success Message (generische Antwort, kein Konto-Rueckschluss) -->
                <Label Text="{Binding SuccessMessage}"
                       IsVisible="{Binding HasSuccess}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <!-- E-Mail -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-Mail-Adresse"
                           Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding Email}"
                           Placeholder="max@beispiel.at"
                           Keyboard="Email"
                           ReturnType="Go"
                           ReturnCommand="{Binding SendResetLinkCommand}" />
                </VerticalStackLayout>

                <!-- Senden -->
                <Button Text="Link zum Zurücksetzen anfordern"
                        Command="{Binding SendResetLinkCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Zurueck zur Anmeldung -->
                <Button Text="Zurück zur Anmeldung"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource LinkButton}"
                        FontSize="14"
                        HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              Style="{StaticResource BusyOverlay}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="Anfrage wird gesendet..."
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
