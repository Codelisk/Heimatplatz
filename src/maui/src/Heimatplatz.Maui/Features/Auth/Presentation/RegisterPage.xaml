<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:appcontrols="clr-namespace:Heimatplatz.Maui.Controls"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             appcontrols:DeferredFlyoutLock.IsEnabled="True"
             Title="{Binding Loc.PageTitle}">

    <Grid>

        <ScrollView x:Name="RegisterScroll">
            <VerticalStackLayout Padding="24,32"
                                 Spacing="24"
                                 MaximumWidthRequest="440"
                                 HorizontalOptions="Fill">

                <!-- Brand Header -->
                <Label Text="HEIMATPLATZ"
                       Style="{StaticResource BrandWordmark}" />

                <!-- Title Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Loc.HeaderTitle}"
                           Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding Loc.HeaderSubtitle}"
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Error Message -->
                <Border IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorBanner}">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorBannerText}"
                           AutomationId="Register_ErrorMessage" />
                </Border>

                <!-- Form Fields -->
                <VerticalStackLayout Spacing="18">

                    <!-- Name Row (Two Columns) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <!-- Vorname -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="{Binding Loc.FirstNameLabel}"
                                   Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource BoxedField}">
                                <Entry x:Name="VornameEntry"
                                       AutomationId="Register_FirstName"
                                       Style="{StaticResource BoxedFieldEntry}"
                                       StyleClass="borderless"
                                       Text="{Binding Vorname}"
                                       Placeholder="{Binding Loc.FirstNamePlaceholder}"
                                       ReturnType="Next"
                                       Completed="OnVornameCompleted" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Nachname -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{Binding Loc.LastNameLabel}"
                                   Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource BoxedField}">
                                <Entry x:Name="NachnameEntry"
                                       AutomationId="Register_LastName"
                                       Style="{StaticResource BoxedFieldEntry}"
                                       StyleClass="borderless"
                                       Text="{Binding Nachname}"
                                       Placeholder="{Binding Loc.LastNamePlaceholder}"
                                       ReturnType="Next"
                                       Completed="OnNachnameCompleted" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- E-Mail -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Loc.EmailLabel}"
                               Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource BoxedField}">
                            <Entry x:Name="EmailEntry"
                                   AutomationId="Register_Email"
                                   Style="{StaticResource BoxedFieldEntry}"
                                   StyleClass="borderless"
                                   Text="{Binding Email}"
                                   Placeholder="{Binding Loc.EmailPlaceholder}"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   Completed="OnEmailCompleted" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Passwort -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Loc.PasswordLabel}"
                               Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource BoxedField}">
                            <Entry x:Name="PasswortEntry"
                                   AutomationId="Register_Password"
                                   Style="{StaticResource BoxedFieldEntry}"
                                   StyleClass="borderless"
                                   Text="{Binding Passwort}"
                                   Placeholder="{Binding Loc.PasswordPlaceholder}"
                                   IsPassword="True"
                                   ReturnType="Next"
                                   Completed="OnPasswortCompleted" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Passwort bestaetigen -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Loc.PasswordConfirmLabel}"
                               Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource BoxedField}">
                            <Entry x:Name="PasswortBestaetigungEntry"
                                   AutomationId="Register_PasswordConfirm"
                                   Style="{StaticResource BoxedFieldEntry}"
                                   StyleClass="borderless"
                                   Text="{Binding PasswortBestaetigung}"
                                   Placeholder="{Binding Loc.PasswordConfirmPlaceholder}"
                                   IsPassword="True"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding RegisterCommand}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Verkäufer-Sektion: Suchen kann jeder Account, nur Anbieten ist optional -->
                    <VerticalStackLayout Spacing="10" Margin="0,6,0,0">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Loc.WantsToSellLabel}"
                                       Style="{StaticResource BodyStrong}" />
                                <Label Text="{Binding Loc.WantsToSellHint}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    AutomationId="Register_WantsToSell"
                                    IsToggled="{Binding WantsToSell, Mode=TwoWay}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <!-- Anbietertyp-Auswahl (nur wenn Verkäufer) -->
                        <VerticalStackLayout Spacing="10"
                                             Margin="0,6,0,0"
                                             IsVisible="{Binding WantsToSell}">
                            <Label Text="{Binding Loc.OfferAsLabel}"
                                   Style="{StaticResource FieldLabel}" />

                            <!-- Explizite Labels ausserhalb des RadioButton.Content:
                                 View-Content verschwindet bei WinUI/Android in nativen
                                 RadioButton-Handlern. Die ganze Zeile bleibt antippbar. -->
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  Padding="0,4"
                                  AutomationId="Register_SellerType_Private"
                                  SemanticProperties.Description="{Binding Loc.SellerTypePrivateSemantic}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSellerTypeTapped"
                                                          CommandParameter="Private" />
                                </Grid.GestureRecognizers>
                                <RadioButton IsChecked="{Binding IsPrivateSeller, Mode=TwoWay}"
                                             GroupName="SellerType"
                                             VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     InputTransparent="True">
                                    <Label Text="{Binding Loc.SellerTypePrivate}"
                                           Style="{StaticResource BodyStrong}" />
                                    <Label Text="{Binding Loc.SellerTypePrivateHint}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  Padding="0,4"
                                  AutomationId="Register_SellerType_Broker"
                                  SemanticProperties.Description="{Binding Loc.SellerTypeBrokerSemantic}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSellerTypeTapped"
                                                          CommandParameter="Broker" />
                                </Grid.GestureRecognizers>
                                <RadioButton IsChecked="{Binding IsBrokerSeller, Mode=TwoWay}"
                                             GroupName="SellerType"
                                             VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     InputTransparent="True">
                                    <Label Text="{Binding Loc.SellerTypeBroker}"
                                           Style="{StaticResource BodyStrong}" />
                                    <Label Text="{Binding Loc.SellerTypeBrokerHint}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  Padding="0,4"
                                  AutomationId="Register_SellerType_PropertyManager"
                                  SemanticProperties.Description="{Binding Loc.SellerTypePropertyManagerSemantic}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSellerTypeTapped"
                                                          CommandParameter="PropertyManager" />
                                </Grid.GestureRecognizers>
                                <RadioButton IsChecked="{Binding IsPropertyManagerSeller, Mode=TwoWay}"
                                             GroupName="SellerType"
                                             VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="2"
                                                     InputTransparent="True">
                                    <Label Text="{Binding Loc.SellerTypePropertyManager}"
                                           Style="{StaticResource BodyStrong}" />
                                    <Label Text="{Binding Loc.SellerTypePropertyManagerHint}"
                                           Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Firmenname (bei Makler und Verwaltung) -->
                            <VerticalStackLayout Spacing="6"
                                                 Margin="0,6,0,0"
                                                 IsVisible="{Binding NeedsCompanyName}">
                                <Label Text="{Binding Loc.CompanyNameLabel}"
                                       Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource BoxedField}">
                                    <Entry Style="{StaticResource BoxedFieldEntry}"
                                           AutomationId="Register_CompanyName"
                                           StyleClass="borderless"
                                           Text="{Binding CompanyName}"
                                           Placeholder="{Binding Loc.CompanyNamePlaceholder}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Register Button -->
                <Button Text="{Binding Loc.RegisterButton}"
                        AutomationId="Register_Submit"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Login Link -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="{Binding Loc.AlreadyHaveAccount}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" />
                    <Button Text="{Binding Loc.LoginLink}"
                            AutomationId="Register_GoToLogin"
                            Command="{Binding GoToLoginCommand}"
                            Style="{StaticResource LinkButton}"
                            FontSize="14" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              Style="{StaticResource BusyOverlay}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
