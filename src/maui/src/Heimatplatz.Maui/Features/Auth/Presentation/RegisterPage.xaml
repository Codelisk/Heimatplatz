<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Registrieren">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="24,32"
                                 Spacing="24"
                                 MaximumWidthRequest="440"
                                 HorizontalOptions="Fill">

                <!-- Brand Header -->
                <Label Text="HEIMATPLATZ"
                       Style="{StaticResource BrandWordmark}" />

                <!-- Title Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Konto erstellen"
                           Style="{StaticResource PageTitle}" />
                    <Label Text="Registrieren Sie sich für exklusive Angebote"
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Error Message -->
                <Border IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorBanner}">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Success Message -->
                <Border IsVisible="{Binding IsSuccess}"
                        Style="{StaticResource SuccessBanner}">
                    <Label Text="{Binding SuccessMessage}"
                           Style="{StaticResource SuccessBannerText}" />
                </Border>

                <!-- Form Fields -->
                <VerticalStackLayout Spacing="18">

                    <!-- Name Row (Two Columns) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <!-- Vorname -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Vorname"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Vorname}"
                                   Placeholder="Max" />
                        </VerticalStackLayout>

                        <!-- Nachname -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Nachname"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry Text="{Binding Nachname}"
                                   Placeholder="Mustermann" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- E-Mail -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-Mail Adresse"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Email}"
                               Placeholder="max@beispiel.at"
                               Keyboard="Email" />
                    </VerticalStackLayout>

                    <!-- Passwort -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Passwort"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Passwort}"
                               Placeholder="Mindestens 8 Zeichen"
                               IsPassword="True" />
                    </VerticalStackLayout>

                    <!-- Passwort bestaetigen -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Passwort bestätigen"
                               Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding PasswortBestaetigung}"
                               Placeholder="Passwort wiederholen"
                               IsPassword="True"
                               ReturnCommand="{Binding RegisterCommand}" />
                    </VerticalStackLayout>

                    <!-- Rollenauswahl -->
                    <VerticalStackLayout Spacing="10" Margin="0,6,0,0">
                        <Label Text="Ich möchte..."
                               Style="{StaticResource FieldLabel}" />
                        <Label Text="Wählen Sie mindestens eine Option"
                               Style="{StaticResource Caption}"
                               Margin="0,-4,0,4" />

                        <!-- Käufer Checkbox -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsBuyer, Mode=TwoWay}"
                                      VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Immobilien suchen"
                                       Style="{StaticResource BodyStrong}" />
                                <Label Text="Als Käufer Angebote entdecken"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Verkäufer Checkbox -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSeller, Mode=TwoWay}"
                                      VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Immobilien anbieten"
                                       Style="{StaticResource BodyStrong}" />
                                <Label Text="Als Verkäufer Objekte inserieren"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Verkäufertyp-Auswahl (nur wenn Seller) -->
                        <VerticalStackLayout Spacing="10"
                                             Margin="28,6,0,0"
                                             IsVisible="{Binding IsSeller}">
                            <Label Text="Ich biete an als:"
                                   Style="{StaticResource FieldLabel}" />

                            <!-- Privatperson -->
                            <RadioButton IsChecked="{Binding IsPrivateSeller, Mode=TwoWay}"
                                         GroupName="SellerType">
                                <RadioButton.Content>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Privatperson"
                                               Style="{StaticResource BodyStrong}" />
                                        <Label Text="Eigene Immobilie verkaufen"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Makler/Agentur -->
                            <RadioButton IsChecked="{Binding IsBrokerSeller, Mode=TwoWay}"
                                         GroupName="SellerType">
                                <RadioButton.Content>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Makler / Agentur"
                                               Style="{StaticResource BodyStrong}" />
                                        <Label Text="Als Immobilienmakler tätig"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Firmenname (nur bei Broker) -->
                            <VerticalStackLayout Spacing="6"
                                                 Margin="0,6,0,0"
                                                 IsVisible="{Binding IsBrokerSeller}">
                                <Label Text="Firmenname"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding CompanyName}"
                                       Placeholder="z.B. RE/MAX Premium" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Register Button -->
                <Button Text="Konto erstellen"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Login Link -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="Bereits ein Konto?"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" />
                    <Button Text="Anmelden"
                            Command="{Binding GoToLoginCommand}"
                            Style="{StaticResource LinkButton}"
                            FontSize="14" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              Style="{StaticResource BusyOverlay}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
