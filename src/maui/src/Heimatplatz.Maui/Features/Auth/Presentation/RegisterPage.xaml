<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Shell.FlyoutBehavior="Disabled"
             Title="Registrieren">

    <ContentPage.Resources>
        <!-- Native RadioButtons rendern View-Content auf Windows/Android nur als
             ToString(); erst ein ControlTemplate zeichnet den zweizeiligen Inhalt -->
        <ControlTemplate x:Key="SellerTypeRadioTemplate">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  Padding="0,4">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CheckedStates">
                            <VisualState x:Name="Checked">
                                <VisualState.Setters>
                                    <Setter TargetName="RadioRing"
                                            Property="Ellipse.Stroke"
                                            Value="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource PrimaryDarkBrush}}" />
                                    <Setter TargetName="RadioDot"
                                            Property="Opacity"
                                            Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Unchecked">
                                <VisualState.Setters>
                                    <Setter TargetName="RadioRing"
                                            Property="Ellipse.Stroke"
                                            Value="{AppThemeBinding Light={StaticResource Gray500Brush}, Dark={StaticResource Gray400Brush}}" />
                                    <Setter TargetName="RadioDot"
                                            Property="Opacity"
                                            Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>
                <Grid WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                    <Ellipse x:Name="RadioRing"
                             Stroke="{AppThemeBinding Light={StaticResource Gray500Brush}, Dark={StaticResource Gray400Brush}}"
                             StrokeThickness="2"
                             Fill="Transparent"
                             WidthRequest="20"
                             HeightRequest="20" />
                    <Ellipse x:Name="RadioDot"
                             Fill="{AppThemeBinding Light={StaticResource PrimaryBrush}, Dark={StaticResource PrimaryDarkBrush}}"
                             Opacity="0"
                             WidthRequest="10"
                             HeightRequest="10"
                             HorizontalOptions="Center"
                             VerticalOptions="Center" />
                </Grid>
                <ContentPresenter Grid.Column="1" VerticalOptions="Center" />
            </Grid>
        </ControlTemplate>
    </ContentPage.Resources>

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="24,32"
                                 Spacing="24"
                                 MaximumWidthRequest="440"
                                 HorizontalOptions="Fill">

                <!-- Brand Header -->
                <Label Text="HEIMATPLATZ"
                       Style="{StaticResource BrandWordmark}" />

                <!-- Title Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Konto erstellen"
                           Style="{StaticResource PageTitle}" />
                    <Label Text="Registrieren Sie sich für exklusive Angebote"
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Error Message -->
                <Border IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorBanner}">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Form Fields -->
                <VerticalStackLayout Spacing="18">

                    <!-- Name Row (Two Columns) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <!-- Vorname -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Vorname"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="VornameEntry"
                                   Text="{Binding Vorname}"
                                   Placeholder="Max"
                                   ReturnType="Next"
                                   Completed="OnVornameCompleted" />
                        </VerticalStackLayout>

                        <!-- Nachname -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Nachname"
                                   Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NachnameEntry"
                                   Text="{Binding Nachname}"
                                   Placeholder="Mustermann"
                                   ReturnType="Next"
                                   Completed="OnNachnameCompleted" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- E-Mail -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-Mail-Adresse"
                               Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="EmailEntry"
                               Text="{Binding Email}"
                               Placeholder="max@beispiel.at"
                               Keyboard="Email"
                               ReturnType="Next"
                               Completed="OnEmailCompleted" />
                    </VerticalStackLayout>

                    <!-- Passwort -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Passwort"
                               Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="PasswortEntry"
                               Text="{Binding Passwort}"
                               Placeholder="Mindestens 8 Zeichen"
                               IsPassword="True"
                               ReturnType="Next"
                               Completed="OnPasswortCompleted" />
                    </VerticalStackLayout>

                    <!-- Passwort bestaetigen -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Passwort bestätigen"
                               Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="PasswortBestaetigungEntry"
                               Text="{Binding PasswortBestaetigung}"
                               Placeholder="Passwort wiederholen"
                               IsPassword="True"
                               ReturnType="Done"
                               ReturnCommand="{Binding RegisterCommand}" />
                    </VerticalStackLayout>

                    <!-- Verkäufer-Sektion: Suchen kann jeder Account, nur Anbieten ist optional -->
                    <VerticalStackLayout Spacing="10" Margin="0,6,0,0">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Ich möchte auch Immobilien anbieten"
                                       Style="{StaticResource BodyStrong}" />
                                <Label Text="Suchen und Favorisieren kann jedes Konto"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding WantsToSell, Mode=TwoWay}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <!-- Anbietertyp-Auswahl (nur wenn Verkäufer) -->
                        <VerticalStackLayout Spacing="10"
                                             Margin="0,6,0,0"
                                             IsVisible="{Binding WantsToSell}">
                            <Label Text="Ich biete an als:"
                                   Style="{StaticResource FieldLabel}" />

                            <!-- Privatperson -->
                            <RadioButton IsChecked="{Binding IsPrivateSeller, Mode=TwoWay}"
                                         GroupName="SellerType"
                                         ControlTemplate="{StaticResource SellerTypeRadioTemplate}"
                                         SemanticProperties.Description="Privatperson – Eigene Immobilie verkaufen">
                                <RadioButton.Content>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Privatperson"
                                               Style="{StaticResource BodyStrong}" />
                                        <Label Text="Eigene Immobilie verkaufen"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Makler/Agentur -->
                            <RadioButton IsChecked="{Binding IsBrokerSeller, Mode=TwoWay}"
                                         GroupName="SellerType"
                                         ControlTemplate="{StaticResource SellerTypeRadioTemplate}"
                                         SemanticProperties.Description="Makler / Agentur – Als Immobilienmakler tätig">
                                <RadioButton.Content>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Makler / Agentur"
                                               Style="{StaticResource BodyStrong}" />
                                        <Label Text="Als Immobilienmakler tätig"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Hausverwaltung -->
                            <RadioButton IsChecked="{Binding IsPropertyManagerSeller, Mode=TwoWay}"
                                         GroupName="SellerType"
                                         ControlTemplate="{StaticResource SellerTypeRadioTemplate}"
                                         SemanticProperties.Description="Hausverwaltung – Objekte im Auftrag von Eigentümern verwalten">
                                <RadioButton.Content>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Hausverwaltung"
                                               Style="{StaticResource BodyStrong}" />
                                        <Label Text="Objekte im Auftrag von Eigentümern verwalten"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                </RadioButton.Content>
                            </RadioButton>

                            <!-- Firmenname (bei Makler und Verwaltung) -->
                            <VerticalStackLayout Spacing="6"
                                                 Margin="0,6,0,0"
                                                 IsVisible="{Binding NeedsCompanyName}">
                                <Label Text="Firmenname"
                                       Style="{StaticResource FieldLabel}" />
                                <Entry Text="{Binding CompanyName}"
                                       Placeholder="z.B. RE/MAX Premium" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Register Button -->
                <Button Text="Konto erstellen"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Login Link -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="Bereits ein Konto?"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" />
                    <Button Text="Anmelden"
                            Command="{Binding GoToLoginCommand}"
                            Style="{StaticResource LinkButton}"
                            FontSize="14" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              Style="{StaticResource BusyOverlay}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
