<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Loc.PageTitle}">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="24,32"
                                 Spacing="28"
                                 MaximumWidthRequest="440"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center">

                <!-- Brand Header -->
                <Label Text="HEIMATPLATZ"
                       Style="{StaticResource BrandWordmark}" />

                <!-- Title Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Loc.WelcomeTitle}"
                           Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding Loc.WelcomeSubtitle}"
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Error Message -->
                <Border IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorBanner}">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Form Fields -->
                <VerticalStackLayout Spacing="18">

                    <!-- E-Mail -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Loc.EmailLabel}"
                               Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource BoxedField}">
                            <Entry x:Name="EmailEntry"
                                   Style="{StaticResource BoxedFieldEntry}"
                                   StyleClass="borderless"
                                   Text="{Binding Email}"
                                   Placeholder="{Binding Loc.EmailPlaceholder}"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   Completed="OnEmailCompleted" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Passwort -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Loc.PasswordLabel}"
                               Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource BoxedField}">
                            <Entry x:Name="PasswortEntry"
                                   Style="{StaticResource BoxedFieldEntry}"
                                   StyleClass="borderless"
                                   Text="{Binding Passwort}"
                                   Placeholder="{Binding Loc.PasswordPlaceholder}"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   ReturnCommand="{Binding LoginCommand}" />
                        </Border>
                        <Button Text="{Binding Loc.ForgotPasswordLink}"
                                Command="{Binding GoToForgotPasswordCommand}"
                                Style="{StaticResource LinkButton}"
                                FontSize="13"
                                HorizontalOptions="End" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Login Button -->
                <Button Text="{Binding Loc.LoginButton}"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Register Link -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="{Binding Loc.NoAccountYet}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" />
                    <Button Text="{Binding Loc.RegisterLink}"
                            Command="{Binding GoToRegisterCommand}"
                            Style="{StaticResource LinkButton}"
                            FontSize="14" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              Style="{StaticResource BusyOverlay}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
