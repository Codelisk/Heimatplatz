<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Heimatplatz.Maui.Features.Auth.Presentation"
             x:Class="Heimatplatz.Maui.Features.Auth.Presentation.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Anmelden">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="24,32"
                                 Spacing="28"
                                 MaximumWidthRequest="440"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Center">

                <!-- Brand Header -->
                <Label Text="HEIMATPLATZ"
                       Style="{StaticResource BrandWordmark}" />

                <!-- Title Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Willkommen zurück"
                           Style="{StaticResource PageTitle}" />
                    <Label Text="Melden Sie sich an, um fortzufahren"
                           Style="{StaticResource PageSubtitle}" />
                </VerticalStackLayout>

                <!-- Error Message -->
                <Border IsVisible="{Binding HasError}"
                        Style="{StaticResource ErrorBanner}">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorBannerText}" />
                </Border>

                <!-- Form Fields -->
                <VerticalStackLayout Spacing="18">

                    <!-- E-Mail -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-Mail-Adresse"
                               Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="EmailEntry"
                               Text="{Binding Email}"
                               Placeholder="max@beispiel.at"
                               Keyboard="Email"
                               ReturnType="Next"
                               Completed="OnEmailCompleted" />
                    </VerticalStackLayout>

                    <!-- Passwort ("Vergessen?"-Link entfernt: es gibt noch keinen Passwort-Reset-Flow) -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Passwort"
                               Style="{StaticResource FieldLabel}" />
                        <Entry x:Name="PasswortEntry"
                               Text="{Binding Passwort}"
                               Placeholder="Ihr Passwort"
                               IsPassword="True"
                               ReturnType="Go"
                               ReturnCommand="{Binding LoginCommand}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Login Button -->
                <Button Text="Anmelden"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <!-- Register Link -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="Noch kein Konto?"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                           VerticalOptions="Center" />
                    <Button Text="Registrieren"
                            Command="{Binding GoToRegisterCommand}"
                            Style="{StaticResource LinkButton}"
                            FontSize="14" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Busy Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              Style="{StaticResource BusyOverlay}">
            <Border Style="{StaticResource BusyCard}">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" HorizontalOptions="Center" />
                    <Label Text="{Binding BusyMessage}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
