<maui:MauiWinUIApplication
    x:Class="Heimatplatz.Maui.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:Heimatplatz.Maui.WinUI">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- Titelleiste in Markenfarben (Paper/OffBlack aus Resources/Styles/Colors.xaml)
                 statt WinUI-Standard. Welche Variante zieht, steuert das RequestedTheme des
                 Fensters - das haelt der ThemeService mit dem App-Theme synchron (dort auch
                 die Begruendung: ohne Sync malt WinUI die Leiste nach dem SYSTEM-Theme). -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowCaptionBackground" Color="#F6ECD8" />
                    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="#F6ECD8" />
                    <SolidColorBrush x:Key="WindowCaptionForeground" Color="#211816" />
                    <SolidColorBrush x:Key="WindowCaptionForegroundDisabled" Color="#8A7A66" />

                    <!-- RadioButton-Akzent: WinUI faerbt den Kreis mit der SYSTEM-Akzentfarbe
                         (blau) - im Rot/Creme-Design ein Fremdkoerper. Auf Markenrot umlegen
                         (Primary #C11F27 aus Resources/Styles/Colors.xaml). -->
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#C11F27" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#A81B22" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#8F171D" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#C11F27" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#A81B22" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#8F171D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowCaptionBackground" Color="#16100D" />
                    <SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="#16100D" />
                    <SolidColorBrush x:Key="WindowCaptionForeground" Color="#F3EADF" />
                    <SolidColorBrush x:Key="WindowCaptionForegroundDisabled" Color="#7A6E60" />

                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#E04B52" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#E8666C" />
                    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#C43F45" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#E04B52" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPointerOver" Color="#E8666C" />
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFillPressed" Color="#C43F45" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
