<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- App-Icon kommt aus dem manuellen Asset-Catalog (Platforms/iOS/Resources/Assets.xcassets),
	     verdrahtet ueber die AppIcon-MSBuild-Property in der csproj (nicht XSAppIconAssets:
	     der Pfad-basierte Plist-Weg lieferte kein CFBundleIconName -> ITMS-90713 beim Upload) -->

	<!-- Eigenes Launch-Storyboard mit Named Color (Dark-Mode-Splash), ersetzt MauiSplashScreen -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- Background Modes for Push Notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Usage-Beschreibungen fuer die KI-gestuetzte Inseratserstellung -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Heimatplatz nutzt das Mikrofon, damit Sie die Beschreibung Ihrer Immobilie diktieren können.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Heimatplatz wandelt Ihr Diktat in Text um, um daraus Ihr Inserat zu erstellen.</string>
	<key>NSCameraUsageDescription</key>
	<string>Heimatplatz nutzt die Kamera, um Fotos und Videos Ihrer Immobilie aufzunehmen.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Heimatplatz greift auf Ihre Fotos zu, um Bilder und Videos Ihrer Immobilie auszuwählen.</string>

	<!-- Von referenzierten SDKs benoetigte Purpose-Strings (ITMS-90683), auch ohne aktive Nutzung Pflicht -->
	<key>NSCalendarsUsageDescription</key>
	<string>Heimatplatz nutzt Ihren Kalender, um Besichtigungstermine für Sie einzutragen.</string>
	<key>NSContactsUsageDescription</key>
	<string>Heimatplatz greift auf Ihre Kontakte zu, um Kontaktdaten bei Anfragen bequem auszufüllen.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Heimatplatz nutzt Ihren Standort, um Immobilien in Ihrer Nähe anzuzeigen.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Heimatplatz nutzt Ihren Standort, um Immobilien in Ihrer Nähe anzuzeigen.</string>

	<!-- Lokales HTTP erlauben (Simulator-Screenshots gegen die lokale Test-API auf localhost);
	     betrifft nur localhost/lokales Netz - Remote-Verbindungen bleiben HTTPS-only -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Export-Compliance: nur HTTPS/Standard-Krypto - erspart die manuelle
	     "Missing Compliance"-Erklaerung pro TestFlight-Build in App Store Connect -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- iOS 26 "Liquid Glass" abschalten: legt sonst runde Glas-Kapseln hinter jeden
	     Navbar-Button (Hamburger/Zurueck/Filter) und passt nicht zum flachen App-Design.
	     ACHTUNG: Uebergangs-Schluessel - Apple ignoriert ihn ab dem uebernaechsten
	     SDK (Xcode 27); dann braucht es echtes Liquid-Glass-Styling. -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>

	<!-- Deep Link URL Schema -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Heimatplatz Deep Link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>heimatplatz</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
