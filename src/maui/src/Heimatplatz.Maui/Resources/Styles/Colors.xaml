<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ============================================================================
         Heimatplatz Design: "Galerie & Papier" - dark-first Schwarz/Rot/Weiss.
         Buntton am Logo-Rot (#DE2A2F) verankert, alle Neutralen warm getoent
         (kein kuehles Slate-Grau), Papierweiss statt Reinweiss, warmes Fast-Schwarz
         statt #000. Abgestimmt auf die Web-Palette (src/web/src/styles/starwind.css).
         ============================================================================ -->

    <!-- Marke -->
    <Color x:Key="Primary">#C11F27</Color>              <!-- Markenrot (Light-CTA) -->
    <Color x:Key="PrimaryDark">#D8443E</Color>          <!-- Markenrot aufgehellt (Dark-CTA) -->
    <Color x:Key="PrimaryDarkText">#FBF3EC</Color>      <!-- Text auf Dark-CTA -->
    <Color x:Key="PrimaryPressed">#A5121C</Color>
    <Color x:Key="SignalRed">#DE2A2F</Color>            <!-- Logo-Rot: Badges/Signale auf Fotos, themenunabhaengig -->
    <Color x:Key="RedTint">#F7E5E1</Color>              <!-- zarte Rot-Flaeche (Light) -->
    <Color x:Key="RedTintDark">#38201C</Color>          <!-- zarte Rot-Flaeche (Dark) -->

    <!-- Flaechen -->
    <Color x:Key="Paper">#F6F3EE</Color>                <!-- Seiten-Hintergrund Light -->
    <Color x:Key="OffBlack">#161210</Color>             <!-- Seiten-Hintergrund Dark (warmes Fast-Schwarz) -->
    <Color x:Key="CardBackground">#FCFAF7</Color>
    <Color x:Key="CardBackgroundDark">#1F1A16</Color>
    <Color x:Key="SurfaceAlt">#EFE9E1</Color>           <!-- Sekundaerflaeche/Tags Light -->
    <Color x:Key="SurfaceAltDark">#29221D</Color>       <!-- Sekundaerflaeche/Tags Dark -->
    <Color x:Key="DividerColor">#E7E0D6</Color>
    <Color x:Key="DividerColorDark">#322B24</Color>
    <Color x:Key="ScrimColor">#661E1712</Color>

    <!-- Foto-Overlays (immersive Karten/Detail-Hero) -->
    <Color x:Key="GlassPillBackground">#66171310</Color>
    <Color x:Key="GlassPillStroke">#33FFFFFF</Color>
    <Color x:Key="PhotoScrimEnd">#D9171008</Color>      <!-- unterer Gradient-Stop auf Fotos -->

    <!-- Kompatibilitaets-Aliase (Bestandsseiten) -->
    <Color x:Key="Secondary">#EFE9E1</Color>
    <Color x:Key="SecondaryDarkText">#6E645B</Color>
    <Color x:Key="Tertiary">#4B4238</Color>
    <Color x:Key="HeaderBorder">#E0D9CF</Color>
    <Color x:Key="SlateText">#4B4238</Color>
    <Color x:Key="AddressText">#6E645B</Color>
    <Color x:Key="DetailsText">#9A9088</Color>
    <Color x:Key="BadgeBackground">#EFE9E1</Color>
    <Color x:Key="BadgeForeground">#6E645B</Color>
    <Color x:Key="Placeholder">#D8D0C6</Color>

    <!-- Semantische Statusfarben (Fehler-Weinrot Hue ~15, bewusst vom Markenrot abgesetzt) -->
    <Color x:Key="Danger">#9B2A22</Color>
    <Color x:Key="DangerDark">#C25048</Color>
    <Color x:Key="ErrorBackground">#F8E4E0</Color>
    <Color x:Key="ErrorForeground">#8E2A23</Color>
    <Color x:Key="ErrorBannerBackground">#F8E4E0</Color>
    <Color x:Key="ErrorBannerBackgroundDark">#3B211D</Color>
    <Color x:Key="ErrorBannerForeground">#8E2A23</Color>
    <Color x:Key="ErrorBannerForegroundDark">#EBAFA5</Color>
    <Color x:Key="SuccessBannerBackground">#E5F0E3</Color>
    <Color x:Key="SuccessBannerBackgroundDark">#22331F</Color>
    <Color x:Key="SuccessBannerForeground">#396B33</Color>
    <Color x:Key="SuccessBannerForegroundDark">#ABCFA0</Color>
    <Color x:Key="FavoriteRed">#DE2A2F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- Warme Neutralskala (ersetzt kuehles Grau; Keys bleiben fuer Bestandscode) -->
    <Color x:Key="Gray100">#EAE3DA</Color>
    <Color x:Key="Gray200">#D8D0C6</Color>
    <Color x:Key="Gray300">#B5AB9F</Color>
    <Color x:Key="Gray400">#9A9088</Color>
    <Color x:Key="Gray500">#7C7268</Color>
    <Color x:Key="Gray600">#453D34</Color>
    <Color x:Key="Gray900">#241E19</Color>
    <Color x:Key="Gray950">#161210</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
