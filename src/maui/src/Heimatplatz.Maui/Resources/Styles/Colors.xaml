<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ============================================================================
         Heimatplatz Design: "Anschlagtafel" - dark-first Schwarz/Rot/Weiss.
         Buntton am Logo-Rot (#DE2A2F) verankert, alle Neutralen warm getoent
         (kein kuehles Slate-Grau). Light = warmes Manila-Papier mit DEUTLICHEM
         Gelbton (Kundenwunsch 16.07.: Reinweiss sticht in den Augen), Dark =
         warmes Fast-Schwarz mit dunklen Karten und Rot/Weiss-Akzenten ("zuviel
         Weiss" -> keine hellen Zettel im Dark Mode). 1:1 abgestimmt auf die
         finalen Web-Tokens (src/web/src/styles/starwind.css, Commit 27a360b).
         ============================================================================ -->

    <!-- Marke -->
    <Color x:Key="Primary">#C11F27</Color>              <!-- Markenrot (Light-CTA) -->
    <Color x:Key="PrimaryDark">#CD2025</Color>          <!-- Markenrot aufgehellt (Dark-CTA, Web-Token primary/dark) -->
    <Color x:Key="PrimaryDarkText">#FCFAF6</Color>      <!-- Text auf Dark-CTA -->
    <Color x:Key="PrimaryPressed">#A5121C</Color>
    <Color x:Key="SignalRed">#DE2A2F</Color>            <!-- Logo-Rot: Badges/Signale auf Fotos, themenunabhaengig -->
    <Color x:Key="RedTint">#F7D6CA</Color>              <!-- zarte Rot-Flaeche (Light, Web-Token accent) -->
    <Color x:Key="RedTintDark">#332923</Color>          <!-- Akzent-Flaeche Dark (neutralisiert: "schwarz statt braun") -->

    <!-- Preis-Auszeichnung: im Dark Mode eigenes, aufgehelltes Rot (Web-Token price),
         CTA-Rot als Text auf dunkler Karte wirkt sonst ziegelig -->
    <Color x:Key="PriceDark">#ED4B45</Color>

    <!-- Flaechen -->
    <Color x:Key="Paper">#F6ECD8</Color>                <!-- Seiten-Hintergrund Light (Manila-Creme) -->
    <Color x:Key="OffBlack">#16100D</Color>             <!-- Seiten-Hintergrund Dark (warmes Fast-Schwarz) -->
    <Color x:Key="CardBackground">#FAF4E9</Color>       <!-- Zettel: weiches Papier knapp ueber dem Grund -->
    <Color x:Key="CardBackgroundDark">#211A16</Color>   <!-- Zettel Dark: dunkle Flaeche knapp ueber dem Grund -->
    <Color x:Key="SurfaceAlt">#EDE1CD</Color>           <!-- Sekundaerflaeche/Tags Light -->
    <Color x:Key="SurfaceAltDark">#2A221D</Color>       <!-- Sekundaerflaeche/Tags Dark -->
    <Color x:Key="DividerColor">#D8CAB7</Color>
    <Color x:Key="DividerColorDark">#3E3733</Color>
    <Color x:Key="ScrimColor">#661E1712</Color>

    <!-- Anschlagtafel-Deko (PropertyCard-Zettel): Foto-Papierrand als Tinte (Light)
         bzw. Weisston (Dark) -->
    <Color x:Key="ZettelFrame">#2E362B24</Color>
    <Color x:Key="ZettelFrameDark">#29F3EDE7</Color>
    <Color x:Key="ZettelShadow">#382315</Color>         <!-- Zettel-Schlagschatten Light (Dark = Schwarz) -->

    <!-- Typ-Farben fuer die Foto-Badges (Kundenwunsch 16.07.): ZV = SignalRed,
         Grund = Gruen, Haus = Alpen-Blau; liegen auf Fotos, themenunabhaengig
         (Web-Tokens type-grund/type-haus in starwind.css) -->
    <Color x:Key="TypeLand">#33854A</Color>
    <Color x:Key="TypeHouse">#2F6E9E</Color>

    <!-- Feedback-Kategorie-Kacheln (weisses Icon auf Farbflaeche): Mitteltoene, die
         wie die Typ-Badges auf Manila UND Fast-Schwarz funktionieren - Werte auch in
         FeedbackDisplay.CategoryColor gespiegelt (Items kommen aus Code) -->
    <Color x:Key="FeedbackIdea">#BE8A26</Color>
    <Color x:Key="FeedbackProblem">#C25048</Color>
    <Color x:Key="FeedbackQuestion">#2F6E9E</Color>
    <Color x:Key="FeedbackPraise">#33854A</Color>
    <Color x:Key="FeedbackOther">#7C7268</Color>


    <!-- Foto-Overlays (immersive Karten/Detail-Hero) -->
    <Color x:Key="GlassPillBackground">#66171310</Color>
    <Color x:Key="GlassPillStroke">#33FFFFFF</Color>
    <!-- Glas ueber dunklen Seitenflaechen (z.B. Karte-Pille im Dark Mode):
         dunkles Glas verschwindet auf OffBlack, daher heller Warmton -->
    <Color x:Key="GlassPillBackgroundDark">#33F3EDE7</Color>
    <Color x:Key="PhotoScrimEnd">#D9171008</Color>      <!-- unterer Gradient-Stop auf Fotos -->

    <!-- Kompatibilitaets-Aliase (Bestandsseiten) -->
    <Color x:Key="Secondary">#EDE1CD</Color>
    <Color x:Key="SecondaryDarkText">#6E645B</Color>
    <Color x:Key="Tertiary">#4B4238</Color>
    <Color x:Key="HeaderBorder">#D8CAB7</Color>
    <Color x:Key="SlateText">#4B4238</Color>
    <Color x:Key="AddressText">#6E645B</Color>
    <Color x:Key="DetailsText">#9A9088</Color>
    <Color x:Key="BadgeBackground">#EDE1CD</Color>
    <Color x:Key="BadgeForeground">#6E645B</Color>
    <Color x:Key="Placeholder">#D8CAB7</Color>

    <!-- Semantische Statusfarben (Fehler-Weinrot Hue ~15, bewusst vom Markenrot abgesetzt) -->
    <Color x:Key="Danger">#9B2A22</Color>
    <Color x:Key="DangerDark">#C25048</Color>
    <Color x:Key="ErrorBackground">#F8E4E0</Color>
    <Color x:Key="ErrorForeground">#8E2A23</Color>
    <Color x:Key="ErrorBannerBackground">#F8E4E0</Color>
    <Color x:Key="ErrorBannerBackgroundDark">#3B211D</Color>
    <Color x:Key="ErrorBannerForeground">#8E2A23</Color>
    <Color x:Key="ErrorBannerForegroundDark">#EBAFA5</Color>
    <Color x:Key="SuccessBannerBackground">#E5F0E3</Color>
    <Color x:Key="SuccessBannerBackgroundDark">#22331F</Color>
    <Color x:Key="SuccessBannerForeground">#396B33</Color>
    <Color x:Key="SuccessBannerForegroundDark">#ABCFA0</Color>
    <!-- Hinweis-Banner (z.B. unbestaetigte E-Mail), analog Web-Token warning -->
    <Color x:Key="WarningBannerBackground">#F7E9C8</Color>
    <Color x:Key="WarningBannerBackgroundDark">#332B1B</Color>
    <Color x:Key="WarningBannerForeground">#6B5320</Color>
    <Color x:Key="WarningBannerForegroundDark">#E5C687</Color>
    <!-- Offline-Hinweis ("zuletzt gespeicherter Stand"): eigene Keys, damit der
         Hinweis nicht an den Fehler-Tokens haengt - offline ist kein Fehler.
         Dark liegt in der Rot-Familie (Kundenwunsch 29.07.) und folgt der
         Banner-Staffelung Flaeche -> Rand -> Text ueber die Helligkeit
         (L* ~17 / 53 / 79, gleicher Buntton) statt ueber die Saettigung.
         Das CTA-Rot bleibt hier bewusst aussen vor: vollgesaettigt als
         1px-Kontur wirkt der Hinweis wie ein Button. -->
    <Color x:Key="OfflineNoticeBackground">#FFF4E5</Color>
    <Color x:Key="OfflineNoticeBackgroundDark">#3B211D</Color>
    <Color x:Key="OfflineNoticeStroke">#D98200</Color>
    <Color x:Key="OfflineNoticeStrokeDark">#C25048</Color>
    <Color x:Key="OfflineNoticeForeground">#211816</Color>
    <Color x:Key="OfflineNoticeForegroundDark">#EBAFA5</Color>
    <Color x:Key="FavoriteRed">#DE2A2F</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>

    <!-- Warme Neutralskala (ersetzt kuehles Grau; Keys bleiben fuer Bestandscode).
         An die Manila-Flaechen angeglichen ueber die Web-Tokens: 100 = muted,
         200 = border, 300 = dark muted-foreground, 600 = dark border (gemischt) -->
    <Color x:Key="Gray100">#EADECA</Color>
    <Color x:Key="Gray200">#D8CAB7</Color>
    <Color x:Key="Gray300">#B2A9A1</Color>
    <Color x:Key="Gray400">#9A9088</Color>
    <Color x:Key="Gray500">#7C7268</Color>
    <Color x:Key="Gray600">#3E3733</Color>
    <Color x:Key="Gray900">#211816</Color>
    <Color x:Key="Gray950">#16100D</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
