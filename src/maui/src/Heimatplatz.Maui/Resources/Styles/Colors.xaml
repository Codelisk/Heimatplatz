<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Heimatplatz Design: monochrom Schwarz/Weiss/Slate (aus Uno Core.Styles/ThemeOverrides.xaml) -->
    <Color x:Key="Primary">#000000</Color>
    <Color x:Key="PrimaryDark">#FFFFFF</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#F1F5F9</Color>
    <Color x:Key="SecondaryDarkText">#64748B</Color>
    <Color x:Key="Tertiary">#334155</Color>

    <!-- Heimatplatz-spezifische Farben -->
    <Color x:Key="HeaderBorder">#E2E8F0</Color>
    <Color x:Key="SlateText">#334155</Color>
    <Color x:Key="AddressText">#666666</Color>
    <Color x:Key="DetailsText">#999999</Color>
    <Color x:Key="ErrorBackground">#F8D7DA</Color>
    <Color x:Key="ErrorForeground">#721C24</Color>
    <Color x:Key="BadgeBackground">#F1F5F9</Color>
    <Color x:Key="BadgeForeground">#64748B</Color>
    <Color x:Key="Placeholder">#E0E0E0</Color>

    <!-- Semantische Statusfarben (Light/Dark) -->
    <Color x:Key="Danger">#D32F2F</Color>
    <Color x:Key="DangerDark">#EF5350</Color>
    <Color x:Key="ErrorBannerBackground">#FDECEA</Color>
    <Color x:Key="ErrorBannerBackgroundDark">#3B1F1F</Color>
    <Color x:Key="ErrorBannerForeground">#B22222</Color>
    <Color x:Key="ErrorBannerForegroundDark">#F2B8B5</Color>
    <Color x:Key="SuccessBannerBackground">#E8F5E9</Color>
    <Color x:Key="SuccessBannerBackgroundDark">#1E3B24</Color>
    <Color x:Key="SuccessBannerForeground">#2E7D32</Color>
    <Color x:Key="SuccessBannerForegroundDark">#A5D6A7</Color>
    <Color x:Key="FavoriteRed">#FF6B6B</Color>

    <!-- Flaechen fuer Karten/Overlays -->
    <Color x:Key="CardBackground">#F7F7F9</Color>
    <Color x:Key="CardBackgroundDark">#2B2B33</Color>
    <Color x:Key="DividerColor">#E5E5EA</Color>
    <Color x:Key="DividerColorDark">#3F3F49</Color>
    <Color x:Key="ScrimColor">#66000000</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>