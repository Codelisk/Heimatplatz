<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Localizer-Klassen werden per Reflection ueber ResourceManager aufgeloest -->
		<IsTrimmable>false</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Localization" />
		<!-- Erzeugt pro .resx eine strongly-typed *Localized-Klasse + AddStronglyTypedLocalizations() -->
		<PackageReference Include="Shiny.Extensions.Localization.Generator" PrivateAssets="all" />
	</ItemGroup>

</Project>
