<Project>
  <!-- Inherit from root Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <!-- Fix für AAPT2 Pfadlängen-Problem auf Windows -->
    <BaseIntermediateOutputPath Condition="'$(OS)' == 'Windows_NT'">C:\i\$(MSBuildProjectName)\</BaseIntermediateOutputPath>

    <!--
      NU1507: mehrere Package-Sources mit CPM ohne Source-Mapping
      NU1608: AndroidX-Pins (zentral fuer Uno/Shiny) liegen ausserhalb der MAUI-Constraints - gewollt
      SHINY002: Bug im Shiny.Maui.Shell 6.3.1 Generator - Warnung feuert faelschlich,
                sobald die (standardmaessig deaktivierten) AI-Extensions aus sind
    -->
    <NoWarn>$(NoWarn);NU1507;NU1608;SHINY002</NoWarn>

    <!-- Define MAUI for platform-specific code -->
    <DefineConstants>$(DefineConstants);MAUIAPP</DefineConstants>
  </PropertyGroup>
</Project>
