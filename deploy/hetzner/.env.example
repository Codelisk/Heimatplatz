# Kopieren nach .env und mit echten Werten fuellen. .env NICHT committen (siehe .gitignore).

# Domain, unter der die API erreichbar sein soll (Caddy holt automatisch ein Let's-Encrypt-Zertifikat)
API_DOMAIN=api.heimatplatz.at

# Domain des statischen Astro-Webs (www.* leitet auf die Apex-Domain um)
WEB_DOMAIN=heimatplatz.at

# Domain des Test-Webs (Container web-test, haengt an der Test-API/Test-DB).
# Oeffentlich erreichbar, aber per X-Robots-Tag noindex (siehe Caddyfile).
WEB_TEST_DOMAIN=test.heimatplatz.at

# Erlaubte IP(s) fuer den internen Bereich (/intern auf WEB_DOMAIN, manueller Edikte-Sync-
# Trigger auf API_DOMAIN). Leerzeichen-getrennt, IPs oder CIDR-Ranges (z.B. bei mehreren
# Standorten oder als Puffer gegen eine wechselnde Heim-IP). Alles andere bekommt 403.
HOME_IP=203.0.113.42

# Postgres-Zugangsdaten (nur intern im Docker-Netzwerk erreichbar, kein Host-Port-Mapping)
POSTGRES_DB=heimatplatz
POSTGRES_USER=heimatplatz
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# JWT-Signaturschluessel: zufaelliger Wert, mindestens 64 Zeichen, z.B. per
#   openssl rand -base64 64
# NIEMALS den alten kompromittierten oder den git-getrackten Dev-Key verwenden - siehe
# Authentication__Jwt__Key Guard in src/api/src/Heimatplatz.Api/Program.cs.
Authentication__Jwt__Key=change-me-generate-with-openssl-rand-base64-64
Authentication__Jwt__Issuer=Heimatplatz
Authentication__Jwt__Audience=Heimatplatz.App

# Shared-Key fuer den manuellen Edikte-Sync-Trigger (POST /api/foreclosure-auctions/sync).
# Der Web-Container schickt ihn als X-Sync-Key-Header mit (/intern/sync.ts), die API
# vergleicht timing-sicher. Ohne gesetzten Key ist der Endpoint gesperrt (fail-closed).
# Zufaelligen Wert erzeugen, z.B. per: openssl rand -hex 32
SYNC_TRIGGER_KEY=change-me-generate-with-openssl-rand-hex-32

# API-Key des AiConnector-Backends (ai.danielhufnagl.at) fuer die KI-Inseratserstellung.
# Liegt auf dem aiconnector-Server in /etc/aiconnector/aiconnector.env (Api__ApiKey).
# Die Server-IP muss dort zusaetzlich in /etc/caddy/aiconnector.env whitelisted sein.
AICONNECTOR_API_KEY=change-me

# E-Mail-Versand (Verifikations- und Passwort-Reset-Mails) ueber die Hetzner-Webhosting-
# Mailbox info@heimatplatz.at (Mail-Server des Webhosting-Pakets, MX www728.your-server.de).
# Das Passwort ist das Mailbox-Passwort aus der konsoleH. Solange EMAIL_SMTP_HOST leer/
# nicht gesetzt ist, verschickt die API nichts und loggt die Mails nur (Startup-Warnung).
EMAIL_SMTP_HOST=mail.your-server.de
EMAIL_SMTP_USERNAME=info@heimatplatz.at
EMAIL_SMTP_PASSWORD=change-me-mailbox-passwort

# APNs fuer die Test-API. Der private Key liegt separat unter
# deploy/hetzner/secrets/apns-auth-key.p8 und wird read-only in den Container gemountet.
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_BUNDLE_ID=at.heimatplatz.app
