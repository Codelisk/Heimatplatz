{$API_DOMAIN} {
	# Automatisches HTTPS via Let's Encrypt (Caddy-Standardverhalten)

	# Interner Admin-Endpunkt (Edikte-Sync manuell auslösen): nur von HOME_IP erreichbar.
	# HOME_IP kann mehrere Werte enthalten (Leerzeichen-getrennt, IPs oder CIDR-Ranges),
	# z.B. als Puffer bei wechselnder Heim-IP. Siehe deploy/hetzner/.env.example.
	@syncBlocked {
		path /api/foreclosure-auctions/sync
		not remote_ip {$HOME_IP}
	}
	respond @syncBlocked "Forbidden" 403

	# Admin-Endpoints (Intern-Bereich: Nutzer-/Immobilienverwaltung): nur von HOME_IP
	# erreichbar. Der Astro-SSR-Server umgeht Caddy ueber das interne Docker-Netz
	# (http://api:8080) und authentifiziert sich per X-Admin-Key (ADMIN_API_KEY).
	@adminBlocked {
		path /api/admin*
		not remote_ip {$HOME_IP}
	}
	respond @adminBlocked "Forbidden" 403

	reverse_proxy api:8080
}

# Test-API (haengt an der Testdatenbank, siehe api-test in docker-compose.yml)
{$TEST_API_DOMAIN} {
	# Admin-Endpoints wie auf der Prod-API IP-sperren (der Key-Check der API gilt zusaetzlich)
	@adminBlocked {
		path /api/admin*
		not remote_ip {$HOME_IP}
	}
	respond @adminBlocked "Forbidden" 403

	reverse_proxy api-test:8080
}

# Astro-Web als SSR (Node-Container "web", seit 15.7.2026 - vorher statisches
# file_server-Hosting). Der Node-Server rendert Seiten pro Request und liefert
# auch die Client-Assets (dist/client) inkl. Immutable-Cache-Headern; 404s
# rendert Astro selbst (src/pages/404.astro).
{$WEB_DOMAIN} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# CSP enforcing (17.7.2026, vorher Report-Only): Live-Seiten geprueft, alle
		# Ressourcen kommen von self bzw. der API-Domain, Formulare posten auf self.
		# 'unsafe-inline' ist fuer Astros Inline-Scripts/-Styles (Theme-Init, Islands) noetig.
		# blob: in img-src fuer die lokale Foto-Vorschau beim Inserieren (URL.createObjectURL).
		# analytics.heimatplatz.at (21.7.2026): selbstgehostetes Rybbit-Tracking-Snippet,
		# nur auf Prod eingebunden (Test-Web baut ohne PUBLIC_RYBBIT_SITE_ID, s. BaseLayout.astro).
		# media-src (22.7.2026): Sprachnachrichten-Wiedergabe (Feedback) laedt Audio von der API;
		# blob: fuer die Vorschau der im Browser aufgenommenen Sprachnachricht (MediaRecorder).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.heimatplatz.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{$API_DOMAIN}; media-src 'self' blob: https://{$API_DOMAIN}; connect-src 'self' https://{$API_DOMAIN} https://analytics.heimatplatz.at; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Interner Bereich (/intern) - Admin-UI fuer den Edikte-Sync, nur von HOME_IP erreichbar.
	@internBlocked {
		path /intern*
		not remote_ip {$HOME_IP}
	}
	respond @internBlocked "Forbidden" 403

	reverse_proxy web:8080
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

# Test-Web (Node-Container "web-test", haengt an der Test-API/Test-DB). Oeffentlich
# erreichbar, aber per X-Robots-Tag von der Suchmaschinen-Indexierung ausgenommen -
# gleiche Inserate wie Prod, darf nicht als Duplicate-Content gelistet werden.
{$WEB_TEST_DOMAIN} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		# Enforcing wie Prod-Web; zusaetzlich TEST_API_DOMAIN, weil das Test-Web
		# gegen die Test-API laeuft. (Der Debug-API-Umschalter auf localhost/LAN
		# waere auf HTTPS-Seiten ohnehin schon als Mixed Content geblockt.)
		# blob: in img-src fuer die lokale Foto-Vorschau beim Inserieren (URL.createObjectURL).
		# media-src (22.7.2026): Sprachnachrichten-Wiedergabe (Feedback) laedt Audio von der API;
		# blob: fuer die Vorschau der im Browser aufgenommenen Sprachnachricht (MediaRecorder).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{$API_DOMAIN} https://{$TEST_API_DOMAIN}; media-src 'self' blob: https://{$API_DOMAIN} https://{$TEST_API_DOMAIN}; connect-src 'self' https://{$API_DOMAIN} https://{$TEST_API_DOMAIN}; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Interner Bereich (/intern) - Admin-UI, nur von HOME_IP erreichbar (wie Prod-Web).
	@internBlocked {
		path /intern*
		not remote_ip {$HOME_IP}
	}
	respond @internBlocked "Forbidden" 403

	reverse_proxy web-test:8080
}
