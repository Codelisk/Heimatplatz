{$API_DOMAIN} {
	# Automatisches HTTPS via Let's Encrypt (Caddy-Standardverhalten)
	reverse_proxy api:8080
}

# Test-API (haengt an der Testdatenbank, siehe api-test in docker-compose.yml)
{$TEST_API_DOMAIN} {
	reverse_proxy api-test:8080
}

# Astro-Web als SSR (Node-Container "web", seit 15.7.2026 - vorher statisches
# file_server-Hosting). Der Node-Server rendert Seiten pro Request und liefert
# auch die Client-Assets (dist/client) inkl. Immutable-Cache-Headern; 404s
# rendert Astro selbst (src/pages/404.astro).
{$WEB_DOMAIN} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy web:8080
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
